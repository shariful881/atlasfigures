# Cloudflare Pages response headers (task 22). GitHub Pages ignores this file.

# Hashed build files never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Basic safety headers for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The *.pages.dev copies (production and previews) must never compete with atlasfigures.com.
https://atlasfigures.pages.dev/*
  X-Robots-Tag: noindex
https://:hash.atlasfigures.pages.dev/*
  X-Robots-Tag: noindex
