---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import fontUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Search from '../components/Search.astro';
import { SITE_NAME, abs, path, organization, website, breadcrumbList, INFO_LINKS, ISSUES_URL, type Crumb } from '../site';

type Section = 'home' | 'population' | 'time' | 'economy' | 'rankings' | 'about';
interface Props {
  title: string;              // <title>, ~60 characters
  description: string;        // meta description: the direct answer
  section?: Section;
  appTitle?: string;          // mobile app bar title
  back?: string;              // mobile back button target (site path, e.g. "/population/")
  miniCounter?: boolean;      // compact live number in the mobile app bar
  breadcrumbs?: Crumb[];      // visible breadcrumb + BreadcrumbList (include Home)
  schema?: object[];          // extra JSON-LD nodes for this page
  noindex?: boolean;          // thin / coming-soon pages
  ogType?: 'website' | 'article';
}
const {
  title, description, section = 'home', appTitle, back, miniCounter = false,
  breadcrumbs = [], schema = [], noindex = false, ogType = 'website',
} = Astro.props;

const sitePath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const canonical = abs(sitePath);
// Staging stays out of search until launch on atlasfigures.com; thin pages stay out always.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization(), website(), ...(breadcrumbs.length > 1 ? [breadcrumbList(breadcrumbs)] : []), ...schema],
};

const sections: { key: Section; label: string; href: string }[] = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'population', label: 'Population', href: '/population/' },
  { key: 'time', label: 'Time', href: '/time/' },
  { key: 'economy', label: 'Economy', href: '/economy/' },
  { key: 'rankings', label: 'Rankings', href: '/rankings/' },
];
const mark = `<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6.5 11.5c4 2 6 .5 9.5-1.5s6-1.5 9.5 1M5 18c4 2.5 7 1 11-1s7-1 11 1.5M9 24c3 1.5 5 .5 7.5-.8s4.5-1 6.5.3" fill="none" stroke="#5fc39b" stroke-width="1.6" stroke-linecap="round"/></svg>`;
---
<!doctype html>
<html lang="en" data-page-noindex={noindex ? "true" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f7f9f9" media="(max-width: 767px)" />
    <meta name="theme-color" content="#123b5a" media="(min-width: 768px)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <link rel="manifest" href={path('/manifest.webmanifest')} />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
    <link rel="apple-touch-icon" href={path('/icon-192.png')} />
    <link rel="sitemap" type="application/xml" href={path('/sitemap.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/icon-512.png')} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>

    <!-- Mobile app bar (< 768px) -->
    <div class="appbar" id="appbar">
      {back ? (
        <a class="icon-btn" href={path(back)} aria-label="Back"><Icon name="back" /></a>
      ) : (
        <a class="brand-sm" href={path('/')} set:html={`${mark}<span>${SITE_NAME}</span>`} />
      )}
      {back && <div class="title">{appTitle ?? title}</div>}
      {miniCounter && <div class="mini num" id="mini-counter" aria-hidden="true"></div>}
      <Search mode="mobile-button" />
      {sitePath !== '/more/' && <a class="icon-btn" href={path('/more/')} aria-label="More: about, sources, corrections, contact"><Icon name="more" /></a>}
      <button class="icon-btn" type="button" id="share-btn" aria-label="Share this page"><Icon name="share" /></button>
    </div>

    <!-- Website header (>= 768px) -->
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={path('/')} set:html={`${mark}<span>${SITE_NAME}</span>`} />
        <nav class="nav" aria-label="Sections">
          {sections.filter((s) => s.key !== 'home').map((s) => (
            <a href={path(s.href)} aria-current={section === s.key ? 'page' : undefined}>{s.label}</a>
          ))}
        </nav>
        <Search mode="desktop" />
      </div>
    </header>

    <main class="wrap" id="main">
      {breadcrumbs.length > 1 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {breadcrumbs.map((c, i) => i < breadcrumbs.length - 1
            ? <><a href={path(c.href)}>{c.name}</a> / </>
            : <span aria-current="page">{c.name}</span>)}
        </nav>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <a class="brand" href={path('/')} set:html={`${mark}<span>${SITE_NAME}</span>`} />
          <p>Every country, told on its own terms. Figures come from the UN, World Bank and national statistics offices, and every page names its sources.</p>
          <p>© {new Date().getFullYear()} {SITE_NAME}</p>
        </div>
        <div>
          <h2 class="foot-h">Sections</h2>
          <ul>{sections.filter((s) => s.key !== 'home').map((s) => <li><a href={path(s.href)}>{s.label}</a></li>)}</ul>
        </div>
        <div>
          <h2 class="foot-h">About</h2>
          <ul>
            {INFO_LINKS.map((l) => <li><a href={path(l.href)}>{l.label}</a></li>)}
            <li><a href={`${ISSUES_URL}/new`}>Report an error</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <Search mode="overlay" />

    <!-- Mobile tab bar (< 768px) -->
    <nav class="tabbar" aria-label="App sections">
      {sections.map((s) => (
        <a href={path(s.href)} aria-current={section === s.key ? 'page' : undefined}>
          <span class="ico"><Icon name={s.key as any} /></span>
          {s.label}
        </a>
      ))}
    </nav>

    <script is:inline define:vars={{ swUrl: path('/sw.js'), scope: path('/') }}>
      (function () {
        var bar = document.getElementById('appbar');
        var onScroll = function () { bar && bar.classList.toggle('scrolled', window.scrollY > 120); };
        window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
        var share = document.getElementById('share-btn');
        if (share) share.addEventListener('click', function () {
          if (navigator.share) navigator.share({ title: document.title, url: location.href }).catch(function () {});
          else if (navigator.clipboard) navigator.clipboard.writeText(location.href);
        });
        if ('serviceWorker' in navigator) navigator.serviceWorker.register(swUrl, { scope: scope }).catch(function () {});
      })();
    </script>
  </body>
</html>
