---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

type Section = 'home' | 'population' | 'time' | 'economy' | 'rankings';
interface Props {
  title: string;          // <title>
  description: string;
  section?: Section;
  appTitle?: string;      // title in the mobile app bar
  back?: string;          // href for the app bar back button (omit on top-level pages)
  miniCounter?: boolean;  // show a compact live number in the app bar after scrolling
}
const { title, description, section = 'home', appTitle, back, miniCounter = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const sections: { key: Section; label: string; href: string }[] = [
  { key: 'home', label: 'Home', href: `${base}/` },
  { key: 'population', label: 'Population', href: `${base}/population/` },
  { key: 'time', label: 'Time', href: `${base}/time/` },
  { key: 'economy', label: 'Economy', href: `${base}/economy/` },
  { key: 'rankings', label: 'Rankings', href: `${base}/rankings/` },
];
const mark = `<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6.5 11.5c4 2 6 .5 9.5-1.5s6-1.5 9.5 1M5 18c4 2.5 7 1 11-1s7-1 11 1.5M9 24c3 1.5 5 .5 7.5-.8s4.5-1 6.5.3" fill="none" stroke="#5fc39b" stroke-width="1.6" stroke-linecap="round"/></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f9f9" media="(max-width: 767px)" />
    <meta name="theme-color" content="#123b5a" media="(min-width: 768px)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AtlasFigures" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/icon-192.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AtlasFigures" />
    <slot name="head" />
  </head>
  <body>
    <!-- Mobile app bar (shown < 768px) -->
    <div class="appbar" id="appbar">
      {back ? (
        <a class="icon-btn" href={back} aria-label="Back"><Icon name="back" /></a>
      ) : (
        <a class="brand-sm" href={`${base}/`} set:html={`${mark}<span>AtlasFigures</span>`} />
      )}
      {back && <div class="title">{appTitle ?? title}</div>}
      {miniCounter && <div class="mini num" id="mini-counter"></div>}
      <button class="icon-btn" type="button" id="share-btn" aria-label="Share this page"><Icon name="share" /></button>
    </div>

    <!-- Website header (shown >= 768px) -->
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}/`} set:html={`${mark}<span>AtlasFigures</span>`} />
        <nav class="nav" aria-label="Sections">
          {sections.filter((s) => s.key !== 'home').map((s) => (
            <a href={s.href} aria-current={section === s.key ? 'page' : undefined}>{s.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <a class="brand" href={`${base}/`} set:html={`${mark}<span>AtlasFigures</span>`} />
          <p>Every country, told on its own terms. Figures come from the UN, World Bank and national statistics offices, and every page names its sources.</p>
          <p>© {new Date().getFullYear()} AtlasFigures</p>
        </div>
        <div>
          <h3>Sections</h3>
          <ul>{sections.filter((s) => s.key !== 'home').map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
        </div>
        <div>
          <h3>Featured</h3>
          <ul><li><a href={`${base}/population/bangladesh/`}>Bangladesh population</a></li></ul>
        </div>
      </div>
    </footer>

    <!-- Mobile tab bar (shown < 768px) -->
    <nav class="tabbar" aria-label="App sections">
      {sections.map((s) => (
        <a href={s.href} aria-current={section === s.key ? 'page' : undefined}>
          <span class="ico"><Icon name={s.key} /></span>
          {s.label}
        </a>
      ))}
    </nav>

    <script is:inline define:vars={{ swUrl: `${base}/sw.js`, scope: `${base}/` }}>
      (function () {
        var bar = document.getElementById('appbar');
        var onScroll = function () { bar && bar.classList.toggle('scrolled', window.scrollY > 120); };
        window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
        var share = document.getElementById('share-btn');
        if (share) share.addEventListener('click', function () {
          if (navigator.share) navigator.share({ title: document.title, url: location.href }).catch(function () {});
          else if (navigator.clipboard) navigator.clipboard.writeText(location.href);
        });
        if ('serviceWorker' in navigator) navigator.serviceWorker.register(swUrl, { scope: scope }).catch(function () {});
      })();
    </script>
  </body>
</html>
