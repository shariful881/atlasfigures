---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  section?: 'population' | 'time' | 'economy' | 'rankings' | 'home';
}
const { title, description, section = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Staging stays out of search engines until we launch on atlasfigures.com.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@500;600&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AtlasFigures" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="#5fd0bc" stroke-width="2"/><path d="M3 16h26M16 3c4 4 4 22 0 26M16 3c-4 4-4 22 0 26" fill="none" stroke="#5fd0bc" stroke-width="1.5"/><rect x="19" y="17" width="3" height="7" fill="#fff"/><rect x="23.5" y="13" width="3" height="11" fill="#fff"/></svg>
          AtlasFigures
        </a>
        <nav class="nav" aria-label="Sections">
          <a href={`${base}/population/`} aria-current={section === 'population' ? 'page' : undefined}>Population</a>
          <span class="soon" title="Coming soon">Time</span>
          <span class="soon" title="Coming soon">Economy</span>
          <span class="soon" title="Coming soon">Rankings</span>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>AtlasFigures — every country, told on its own terms. Figures come from the UN, World Bank and national statistics offices; each page names its sources.</p>
        <p>© {new Date().getFullYear()} AtlasFigures</p>
      </div>
    </footer>
  </body>
</html>
