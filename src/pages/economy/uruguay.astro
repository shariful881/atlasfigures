---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/uruguay.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';
import { latest } from '../../lib/econ';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/uruguay/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const iLoSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x <= infl.value).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const iRank = rankBy('inflationPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const crisis = [1999, 2000, 2001, 2002].every((y) => g(y) < 0);
const drop02 = Math.round((1 - v('gdp', 2002)! / v('gdp', 2001)!) * 100);
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const lit = latest(s.literacyPct)!;
const pcRank = rankBy('gdpPerCapita', L).find((r) => r.iso3 === c.iso3)!.rank;

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && isMax(s.gdpPerCapitaPpp!) && pcRank === 51, 'records; per head 51st');
assertClaim(iLoSince === 2001 && iMax[0] === 1968 && iMax[1] > 125 && s.inflationPct[0][0] === 1960 && i(2022) > 9, 'inflation 4.7% lowest since 2001; peak 125.3% in 1968; 9.1% in 2022');
assertClaim(crisis && g(2002) < -7.6 && drop02 === 35 && g(1998) > 0, 'four contractions 1999-2002; 2002 -7.7%; dollar GDP -35%');
assertClaim(worst[0] === 1983 && g(2020) < -7.3 && g(2021) > 5.7, 'worst 1983; 2020 -7.4%; 2021 +5.8%');
assertClaim(lit.year === 2024 && lit.value > 98.9 && isMax(s.remittances), 'literacy 98.9% in 2024; record remittances');

const title = `Uruguay Economy ${L}: Inflation Slows to ${pct(infl.value)} as Incomes Peak | AtlasFigures`;
const description = `Price rises in Uruguay slowed to ${pct(infl.value)} in ${L} (gentlest since 2001), while output reached ${usd(gdp)} (${usdWhole(perHead)} a head) after ${pct(growth)} growth.`;

const faq = [
  { q: 'How much output does each Uruguayan produce?', a: `${usdWhole(perHead)} of GDP per Uruguayan for ${L} — a peak, ranking ${ord(pcRank)} globally — with ${intDollars(ppp!)} as the PPP equivalent.` },
  { q: 'Is Uruguay\'s inflation coming down?', a: `Steadily: ${pct(i(2022))} in 2022, ${pct(i(2024))} in 2024 and ${pct(infl.value)} in ${L}, the lowest reading since 2001.` },
  { q: 'How bad was Uruguay\'s 2002 crisis?', a: `Real GDP fell ${pct(Math.abs(g(2002)))}, the fourth straight contraction, and output measured in dollars dropped by about ${drop02}% in a single year.` },
  { q: 'Did Uruguay ever have triple-digit inflation?', a: `Yes, in 1968, when prices rose ${pct(iMax[1])}; the data go back to 1960.` },
  { q: 'How did the pandemic affect Uruguay?', a: `Real GDP dropped ${pct(Math.abs(g(2020)))} in 2020, then recovered ${pct(g(2021))} a year later. The deepest decline remains 1983's ${pct(Math.abs(worst[1]))}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Uruguay's economy in ${L}: record output and the lowest inflation since 2001`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Uruguayan economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Uruguay', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Uruguay's economy: record output, inflation at a 24-year low</h1>
        <p class="answer">
          In {L} Uruguay's GDP reached an unprecedented <strong>{usd(gdp)}</strong>, while consumer prices rose just <strong>{pct(infl.value)}</strong>, the mildest since 2001.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Uruguay economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Uruguay" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Output per head is at a high, and prices are rising more slowly than in any year this century.</p>

        <div class="story-block prose">
          <h2>How rich is Uruguay today?</h2>
          <p>Richer than ever in dollar terms. Real growth of {pct(growth)} took output to {usd(gdp)} for {L}; that is {usdWhole(perHead)} a head, {ord(pcRank)} worldwide ({intDollars(ppp!)} at PPP). Adult literacy, per UNESCO, was {pct(lit.value)} in {lit.year}.</p>
        </div>
        <div class="story-block prose">
          <h2>Has Uruguay brought inflation under control?</h2>
          <p>More than at any time this century. At {pct(infl.value)}, the {L} rate was lower than any since 2001, though it still ranks {ord(iRank)} highest of 169 economies; in 2022 it was {pct(i(2022))}, and in 1968 a staggering {pct(iMax[1])}.</p>
        </div>
        <LineChart
          title={`Uruguayan inflation, ${s.inflationPct[0][0]}–${L}`}
          subtitle="Year-on-year change in consumer prices, %."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What did the 1999–2002 slump do to Uruguay?</h2>
          <p>The four-year contraction hit bottom in 2002, when real GDP sank {pct(Math.abs(g(2002)))} and its dollar value lost around {drop02}%. The 2020 slump ({pct(g(2020))}) was briefer, with a {pct(g(2021))} rebound in 2021. Modelled unemployment is now {pct(unemp!)}, and remittances received reached {usd(rem!.value)}, the most yet.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Uruguay and South America: related pages</h2>
          <ul>
            <li><a href={path('/population/uruguay/')}>Uruguay's population</a></li>
            <li><a href={path('/economy/argentina/')}>Argentina's economy</a></li>
            <li><a href={path('/economy/brazil/')}>Brazil's economy</a></li>
            <li><a href={path('/economy/chile/')}>Chile's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Uruguay: GDP, prices and remittances by year`}
          subtitle="From 1960, with 1968, 1983 and 2001–02 picked out, plus 2015 onward year by year. Other years: see the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/uruguay-economy.csv')} csvName="uruguay-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Uruguay's economy in short answers</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Literacy: SE.ADT.LITR.ZS (UNESCO), via the World Bank. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Uruguayan economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Uruguay" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
