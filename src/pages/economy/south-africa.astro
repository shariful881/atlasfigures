---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/south-africa.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/south-africa/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const ranked = rankBy('gdp', L);
// Africa = World Bank Sub-Saharan Africa plus the North African economies of its Middle East region.
const NORTH_AFRICA = ['DZA', 'EGY', 'LBY', 'MAR', 'TUN'];
const africa = ranked.filter((r) => r.region === 'Sub-Saharan Africa' || NORTH_AFRICA.includes(r.iso3));
const uDesc = rankBy('unemploymentPct', L);
const uPos = uDesc.findIndex((r) => r.iso3 === c.iso3) + 1;
const peak = s.gdp.reduce((a, b) => (b[1] > a[1] ? b : a));
const pcPeak = s.gdpPerCapita.reduce((a, b) => (b[1] > a[1] ? b : a));
const uMax = s.unemploymentPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const uMin = s.unemploymentPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));

assertClaim(africa[0].iso3 === c.iso3 && africa[1].iso3 === 'EGY' && africa[2].iso3 === 'NGA', 'largest in Africa, ahead of Egypt and Nigeria');
assertClaim(peak[0] === 2011 && pcPeak[0] === 2011 && gdp < peak[1] && perHead < pcPeak[1], 'GDP and GDP per person below 2011 peaks');
assertClaim(uPos === 2 && uDesc[0].iso3 === 'SWZ', 'second-highest unemployment, after Eswatini');
assertClaim(uMax[0] === 2021 && uMin[0] === 2007 && s.unemploymentPct[0][0] === 1991, 'unemployment peak 2021, low 2007, series from 1991');
assertClaim(g(2023) < 1 && g(2024) < 1 && growth > 1 && hiGrowSince === 2022, 'growth under 1% in 2023 and 2024, latest highest since 2022');
assertClaim(worst[0] === 2020 && s.gdpGrowthPct[0][0] === 1961, '2020 the worst year since 1961');
assertClaim(infl.year === L && lowInflSince === 2005, 'inflation lowest since 2005');
assertClaim(unemp! > 30, 'more than three in ten unemployed');

const title = `South Africa Economy ${L}: Africa's Largest, Jobs Crisis | AtlasFigures`;
const description = `At ${usd(gdp)} in ${L}, South Africa remains Africa's biggest economy but has not regained its 2011 dollar peak. Its ${pct(unemp!)} jobless rate trails only Eswatini's; growth reached ${pct(growth)}.`;

const faq = [
  { q: 'Is South Africa still the biggest economy in Africa?', a: `It is. World Bank data for ${L} put it at ${usd(gdp)}, with Egypt second on ${usd(africa[1].value)} and Nigeria third on ${usd(africa[2].value)}.` },
  { q: 'Why is unemployment in South Africa so high?', a: `The data measure how many are out of work, not why: ${pct(unemp!)} in ${L} under the International Labour Organization's model, a rate exceeded only in Eswatini (${pct(uDesc[0].value)}). The worst year was 2021 at ${pct(uMax[1])}; the best, 2007 at ${pct(uMin[1])}.` },
  { q: 'Is the South African economy smaller than it was in 2011?', a: `In current dollars, yes. The 2011 figure was ${usd(peak[1])}; in ${L} it was ${usd(gdp)}, and output per person has fallen from ${usdWhole(pcPeak[1])} to ${usdWhole(perHead)}.` },
  { q: 'How fast are South African prices rising?', a: `By ${pct(infl.value)} over ${L}, the gentlest annual increase since 2005.` },
  { q: 'How badly did 2020 hit South Africa?', a: `Real output shrank ${pct(Math.abs(worst[1]))}, the sharpest one-year contraction in South African figures going back to 1961.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `South Africa's economy ${L}: Africa's largest, below its 2011 peak, with the world's second-highest jobless rate`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="South African economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'South Africa', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>South Africa's economy: Africa's largest, with a jobs gap</h1>
        <p class="answer">
          Producing <strong>{usd(gdp)}</strong> in {L}, South Africa is still Africa's largest economy. Its unemployment rate, <strong>{pct(unemp!)}</strong>, was second-highest worldwide, and growth reached {pct(growth)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`South Africa economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="South Africa" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">South Africa leads the continent by output, but more than three in ten people in its labour force are counted as unemployed.</p>

        <div class="story-block prose">
          <h2>How high is unemployment in South Africa?</h2>
          <p>Close to one worker in three was jobless in {L} — {pct(unemp!)} by the ILO's model, a share topped only in Eswatini. Records begin in 1991, and the rate has swung between {pct(uMin[1])} (2007) and {pct(uMax[1])} (2021).</p>
        </div>
        <LineChart
          title={`South African unemployment, 1991–${L}`}
          subtitle="Jobless South Africans as a share of all workers and job-seekers, ILO model, %."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Does South Africa still lead Africa's economies?</h2>
          <p>It does. Output of {usd(gdp)} in {L} ranks {ord(B.gdpRank!)} globally and first on the continent, with Egypt and Nigeria behind. Yet in dollars it has not climbed back to its 2011 level of {usd(peak[1])}.</p>
        </div>
        <LineChart
          title={`GDP of South Africa, 1960–${L}`}
          subtitle="Current US dollars; the 2011 high has not been regained."
          points={s.gdp.map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why has South African income per person fallen since 2011?</h2>
          <p>Measured in dollars, output per inhabitant peaked at {usdWhole(pcPeak[1])} in 2011 and had slipped to {usdWhole(perHead)} by {L}, ranking {ord(B.pcRank!)}; corrected for price differences (PPP) it comes to {intDollars(ppp!)}. Real growth was below 1% in both 2023 and 2024 before {pct(growth)} in {L}.</p>
        </div>
        <div class="story-block prose">
          <h2>What happened to prices in South Africa?</h2>
          <p>Inflation cooled to {pct(infl.value)} in {L}; no year since 2005 saw a smaller rise. And the {pct(Math.abs(worst[1]))} slump of 2020 still marks the deepest yearly fall in output on record.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>South Africa and the region: related pages</h2>
          <ul>
            <li><a href={path('/population/south-africa/')}>South Africa's population</a></li>
            <li><a href={path('/economy/nigeria/')}>Nigeria's economy</a></li>
            <li><a href={path('/economy/egypt/')}>Egypt's economy</a></li>
            <li><a href={path('/economy/kenya/')}>Kenya's economy</a></li>
            <li><a href={path('/rankings/unemployment-rate-by-country/')}>Unemployment rates by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`South African GDP, jobs and prices: chosen years 1960–${L}`}
          subtitle="Rows for 2007 (lowest unemployment), 2011 (dollar peak) and 2021 sit beside the latest years; the CSV file contains the rest."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/south-africa-economy.csv')} csvName="south-africa-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common questions on South Africa's economy</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Africa" here means the World Bank's Sub-Saharan Africa region plus Algeria, Egypt, Libya, Morocco and Tunisia. The World Bank notes South Africa's fiscal year ends on 31 March; national accounts are calendar-year. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("South African economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="South Africa" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
