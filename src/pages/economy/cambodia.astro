---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/cambodia.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/cambodia/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const onlyNeg = s.gdpGrowthPct.filter(([y, x]) => y >= 1995 && x < 0).map(([y]) => y);
const avg = s.gdpGrowthPct.filter(([y]) => y >= 2000).reduce((a, [, x], _, arr) => a + x / arr.length, 0);
const uAsc = rankBy('unemploymentPct', L).slice().reverse();
const uPos = uAsc.findIndex((r) => r.iso3 === c.iso3) + 1;
const remPeak = s.remittances.reduce((a, b) => (b[1] > a[1] ? b : a));
const remDrop = Math.round((1 - rem!.value / remPeak[1]) * 100);
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const gdpX = Math.round(gdp / v('gdp', 2000)!);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 94 && gdp > 5e10, 'record GDP above $50bn; 94th');
assertClaim(onlyNeg.join() === '2020' && avg > 7.1 && avg < 7.2 && growth > 5.3 && g(L - 1) > 5.9, 'only 2020 negative since 1995; average 7.2% since 2000');
assertClaim(g(2018) > growth && g(2019) > growth, 'below pre-2020 pace');
assertClaim(uPos === 2 && uAsc[0].iso3 === 'QAT' && unemp! < 0.3, 'second-lowest unemployment after Qatar');
assertClaim(remPeak[0] === L - 1 && remDrop === 22, 'remittances fell 22% from 2024 peak');
assertClaim(iMax[0] === 2008 && iMax[1] > 24 && s.inflationPct[0][0] === 1995 && gdpX === 14 && s.gdp[0][0] === 1975, 'inflation peak 2008, series from 1995; GDP 14x 2000; GDP from 1975');

const title = `Cambodia Economy ${L}: GDP Passes Fifty Billion Dollars | AtlasFigures`;
const description = `Growth of ${pct(growth)} in ${L} took Cambodian output to ${usd(gdp)} — about ${gdpX} times as much as in 2000, in dollars. Inflation was ${pct(infl.value)}; remittances fell back.`;

const faq = [
  { q: 'How fast has Cambodia\'s economy grown?', a: `Real growth averaged about ${pct(avg)} a year from 2000 to ${L}. The only year of contraction since 1995 was 2020 (${signedPct(g(2020))}); ${L} brought ${pct(growth)}.` },
  { q: 'How large is Cambodia\'s GDP now?', a: `${usd(gdp)} for ${L}, Cambodia\'s highest and ${ord(B.gdpRank!)} on the world table. Divided by population that comes to ${usdWhole(perHead)} (${intDollars(ppp!)} in PPP terms).` },
  { q: 'Why is Cambodia\'s unemployment rate so low?', a: `Its ${L} rate of ${pct(unemp!)}, an ILO modelled figure, is the world\'s second-lowest, behind Qatar. In that measure anyone who did any work for pay or profit, informal work included, counts as employed.` },
  { q: 'Did remittances to Cambodia fall?', a: `Yes, by ${remDrop}%: inflows dropped from a ${L - 1} record of ${usd(remPeak[1])} to ${usd(rem!.value)}.` },
  { q: 'When did Cambodian prices rise fastest?', a: `In 2008, by ${pct(iMax[1])}; the World Bank\'s Cambodian inflation series opens in 1995. The ${L} rate was ${pct(infl.value)}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Cambodia's economy in ${L}: past fifty billion dollars after decades of rapid growth`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Cambodian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Cambodia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Cambodia's economy: three decades of near-unbroken growth</h1>
        <p class="answer">
          Expanding <strong>{pct(growth)}</strong> in {L}, Cambodian GDP topped fifty billion dollars for the first time, reaching <strong>{usd(gdp)}</strong>; prices rose {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Cambodia economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Cambodia" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Since 1995 only the pandemic year has interrupted Cambodia's expansion.</p>

        <div class="story-block prose">
          <h2>How much has Cambodia's economy expanded since 2000?</h2>
          <p>Fast and almost without interruption. Real GDP rose about {pct(avg)} a year on average between 2000 and {L}; since 1995 it has shrunk only once, in 2020. In current dollars GDP is now {usd(gdp)}, some {gdpX} times the 2000 level.</p>
        </div>
        <LineChart
          title={`Cambodia's GDP, ${s.gdp[0][0]}–${L}`}
          subtitle="Current US dollars, World Bank series from 1975."
          points={s.gdp.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Cambodia still growing quickly?</h2>
          <p>Yes, though below its pre-2020 pace: {pct(growth)} in {L} after {pct(g(L - 1))} in {L - 1}, compared with {pct(g(2018))} in 2018 and {pct(g(2019))} in 2019.</p>
        </div>
        <LineChart
          title={`How fast Cambodia's real output grew, 1995–${L}`}
          subtitle="Annual % change, constant prices."
          points={s.gdpGrowthPct.filter(([y]) => y >= 1995).map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Does Cambodia really have almost no unemployment?</h2>
          <p>On the ILO's modelled measure, {pct(unemp!)} — the second-lowest of any economy, after Qatar. The measure treats any paid or self-employed work, including informal work, as a job, so a low figure does not show how secure or well paid that work is.</p>
        </div>
        <div class="story-block prose">
          <h2>What about prices and remittances?</h2>
          <p>Inflation was {pct(infl.value)} in {L}; the highest in the series, which starts in 1995, was {pct(iMax[1])} in 2008. Remittances fell {remDrop}% from {L - 1}'s peak to {usd(rem!.value)}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Cambodia and Southeast Asia: related pages</h2>
          <ul>
            <li><a href={path('/population/cambodia/')}>Cambodia's population</a></li>
            <li><a href={path('/economy/vietnam/')}>Vietnam's economy</a></li>
            <li><a href={path('/economy/thailand/')}>Thailand's economy</a></li>
            <li><a href={path('/economy/myanmar/')}>Myanmar's economy</a></li>
            <li><a href={path('/rankings/unemployment-rate-by-country/')}>Unemployment league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Cambodia's main indicators by year`}
          subtitle="Begins with 1975, the earliest GDP year; adds 1995, 2000, 2008 and 2010; annual from 2015. Remaining years are downloadable."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/cambodia-economy.csv')} csvName="cambodia-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Cambodia's economy: quick questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank notes that for 1963–2004 multiple exchange rates in Cambodia are combined into an alternative conversion factor. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Cambodian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Cambodia" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
