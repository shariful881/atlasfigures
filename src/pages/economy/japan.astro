---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/japan.json';
import { econData, econMeta, valueIn, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/japan/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, share } = B;
const kr = econData('KOR').series;
const de = econData('DEU').series.gdp;
const i = (y: number) => v('inflationPct', y)!;
const peak = s.gdp.reduce((a, b) => (b[1] > a[1] ? b : a));
const fallPct = (1 - gdp / peak[1]) * 100;
const deflationYears = s.inflationPct.filter(([y, x]) => y >= 1995 && y <= 2021 && x < 0).length;
const krAheadPc = s.gdpPerCapita.filter(([y, x]) => (valueIn(kr.gdpPerCapita, y) ?? 0) > x).map(([y]) => y);
const krAheadPpp = s.gdpPerCapitaPpp.filter(([y, x]) => (valueIn(kr.gdpPerCapitaPpp, y) ?? 0) > x).map(([y]) => y);
const G7 = ['USA', 'GBR', 'DEU', 'JPN', 'FRA', 'ITA', 'CAN'];

assertClaim(B.gdpRank === 4 && valueIn(de, L)! > gdp, 'fourth, behind Germany');
assertClaim(peak[0] === 2012 && fallPct > 25 && fallPct < 35, 'dollar GDP peaked in 2012 and is roughly 30% lower');
assertClaim(deflationYears === 15, 'prices fell in 15 years between 1995 and 2021');
assertClaim([2022, 2023, 2024, L].every((y) => i(y) > 2) && s.inflationPct.filter(([y]) => y > 1981 && y !== 2023).every(([, x]) => x < i(2023)) && i(1981) > i(2023), 'four years above 2%, 2023 highest since 1981');
assertClaim(krAheadPc.join() === '2023,2024,2025' && krAheadPpp[0] === 2016, 'South Korea ahead per person since 2023 (PPP since 2016)');
assertClaim(G7.every((x) => x === c.iso3 || valueIn(econData(x).series.unemploymentPct, L)! > unemp!), 'lowest unemployment in the G7');
assertClaim(s.gdpGrowthPct.filter(([y, x]) => y >= 2008 && x < 0).length >= 6 && s.gdpGrowthPct.filter(([, x]) => x < 0).at(-1)![0] === 2024, 'several contractions since 2008, the latest in 2024');
const since2012 = s.gdpGrowthPct.filter(([y]) => y > 2012);
assertClaim(since2012.filter(([, x]) => x > 0).length > since2012.length / 2 && since2012.reduce((a, [, x]) => a * (1 + x / 100), 1) > 1, 'real output since 2012 mostly growing and higher overall');

const title = `Japan Economy ${L}: GDP, Prices and Income | AtlasFigures`;
const description = `Japan's GDP was ${usd(gdp)} in ${L}, fourth in the world and about ${Math.round(fallPct)}% below its 2012 dollar peak. Prices are rising again after years of deflation, and South Korea now leads on income per person.`;

const faq = [
  { q: 'Why has Japan\'s GDP fallen in dollars?', a: `In current US dollars it peaked at ${usd(peak[1])} in ${peak[0]} and was ${usd(gdp)} in ${L}. A weaker yen shrinks the total once it is converted into dollars, even when real output holds steady.` },
  { q: 'Is Japan still in deflation?', a: `No. Consumer prices have risen by more than 2% a year since 2022, reaching ${pct(i(2023))} in 2023, the most since 1981. In ${deflationYears} separate years from 1995 to 2021, the price level dropped.` },
  { q: 'Is South Korea richer than Japan?', a: `Per person, yes, since 2023: ${usdWhole(valueIn(kr.gdpPerCapita, L)!)} in South Korea against ${usdWhole(perHead)} in Japan in ${L}. Once price levels are adjusted for (PPP), Korea moved ahead earlier, in 2016.` },
  { q: 'Which G7 country has the lowest unemployment?', a: `Japan: just ${pct(unemp!)} of its workers were jobless in ${L}, per the modelled ILO series.` },
  { q: 'Where does Japan rank in world GDP?', a: `${ord(B.gdpRank!)}, behind the United States, China and Germany, with ${pct(share)} of the world total.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Japan's economy ${L}: GDP of ${usd(gdp)}, the end of deflation and a shrinking dollar total`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Japan's economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Japan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Japan's economy today</h1>
        <p class="answer">
          In {L} Japan turned out <strong>{usd(gdp)}</strong> of goods and services, the {ord(B.gdpRank!)} largest total in the world, worth <strong>{usdWhole(perHead)} per resident</strong>. Measured in dollars, that is about {Math.round(fallPct)}% below the {peak[0]} peak.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Japan economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Japan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">For a generation Japan's prices drifted down. Now they are rising, its dollar GDP has shrunk, Germany has moved ahead of it, and its neighbour South Korea produces more per head.</p>

        <div class="story-block prose">
          <h2>Why is Japan's GDP smaller than it used to be?</h2>
          <p>The dollar total topped out at {usd(peak[1])} in {peak[0]} and stood at {usd(gdp)} in {L}, a drop of about {Math.round(fallPct)}%. Real output did not fall anything like that much: dollar figures also follow the yen's exchange rate. In 2023 Germany's dollar GDP passed Japan's, pushing it to {ord(B.gdpRank!)} place; see the <a href={path('/economy/germany/')}>German economy</a> page.</p>
        </div>
        <LineChart
          title={`Japan's GDP in dollars, 1960–${L}`}
          subtitle="Current US dollars; the 2012 peak and the decline since are both visible."
          points={s.gdp.filter(([y]) => y % 5 === 0 || y === 2012 || y >= 2019).map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Japan's deflation ended?</h2>
          <p>On the World Bank's yearly numbers, yes. Between 1995 and 2021 consumer prices fell in {deflationYears} separate years. Since 2022 they have gone up by more than 2% every year, peaking at {pct(i(2023))} in 2023, a pace last seen in 1981. The {L} rate was {pct(infl.value)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Is South Korea now richer than Japan?</h2>
          <p>By output per person in current dollars, it has been since 2023: in {L} South Korea recorded {usdWhole(valueIn(kr.gdpPerCapita, L)!)} and Japan {usdWhole(perHead)}. Adjusted for living costs, Korea moved ahead earlier, in 2016; Japan's PPP figure is now {intDollars(ppp!)}. More on the <a href={path('/economy/south-korea/')}>South Korea economy page</a>.</p>
        </div>

        <div class="story-block prose">
          <h2>How many Japanese are unemployed?</h2>
          <p>Very few: {pct(unemp!)} of people in the Japanese labour market were out of work in {L}, the lowest share in the G7. Growth itself was {pct(growth)}; since 2008 the economy has shrunk in several years, most recently in 2024.</p>
        </div>
        <LineChart
          title={`Japan's jobless rate, 1991–${L}`}
          subtitle="Out-of-work share of the labour force, ILO modelled estimates."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <nav class="related" aria-label="Related pages">
          <h2>More about Japan and East Asia</h2>
          <ul>
            <li><a href={path('/population/japan/')}>Japan's population</a></li>
            <li><a href={path('/economy/south-korea/')}>South Korea's economy</a></li>
            <li><a href={path('/economy/china/')}>China's economy</a></li>
            <li><a href={path('/population/philippines/')}>The Philippines' population</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation in every country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Japan's economy, decade by decade, 1960–${L}`}
          subtitle="From 1991 through the 2012 dollar peak to today; the CSV lists every year."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/japan-economy.csv')} csvName="japan-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Japan's economy: common questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), remittances, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Japan's national accounts are reported on a calendar-year basis (World Bank country notes). "G7" means Canada, France, Germany, Italy, Japan, the United Kingdom and the United States. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Japan's economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Japan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
