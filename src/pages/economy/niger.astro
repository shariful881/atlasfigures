---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/niger.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';
import { rankLatest, latest } from '../../lib/econ';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/niger/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const falling = rankBy('inflationPct', L).filter((r) => r.value < 0);
const fPos = rankBy('inflationPct', L).length - rankBy('inflationPct', L).findIndex((r) => r.iso3 === c.iso3);
const pcList = rankBy('gdpPerCapita', L); const pcLow = pcList.length - pcList.findIndex((r) => r.iso3 === c.iso3);
const gRank = rankBy('gdpGrowthPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const lit = rankLatest('literacyPct', 2015); const litMe = lit.find((r) => r.iso3 === c.iso3)!; const litLow = lit.length - litMe.rank + 1;
const u5 = latest(s.under5Mortality)!; const u5Rank = rankBy('under5Mortality', u5.year).find((r) => r.iso3 === c.iso3)!.rank;
const agri = valueIn(s.empAgriPct, L)!;
const gMax = s.gdpGrowthPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const remMax = s.remittances.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(infl.value < -4 && falling.length === 12 && fPos === 2 && falling.at(-1)!.iso3 === 'LKA', 'prices fell 4.5%, second-steepest after Sri Lanka');
assertClaim(i(L - 1) > 9 && isMax(s.gdp) && isMax(s.gdpPerCapita) && pcLow === 7, '9.1% in 2024; record GDP; 7th lowest per head');
assertClaim(gRank === 17 && g(2022) > 12.2 && gMax[0] === 1978 && g(2021) < 1.2, '7.0% 17th; 2022 12.2%; record 1978; 2021 1.1%');
assertClaim(litMe.year === 2022 && litLow === 2 && u5Rank === 2 && Math.round(agri) === 73, 'literacy 2nd lowest; under-5 2nd highest; 73% in farming');
assertClaim(remMax[0] === 2022 && rem!.year === 2024, 'remittances peaked 2022; data to 2024');

const title = `Niger Economy ${L}: ${pct(growth)} Growth as Prices Fall ${pct(Math.abs(infl.value))} | AtlasFigures`;
const description = `Real GDP in Niger was up ${pct(growth)} in ${L}, to ${usd(gdp)}, as the price level dropped ${pct(Math.abs(infl.value))}; only Sri Lanka saw a bigger drop.`;

const faq = [
  { q: 'Are prices in Niger falling?', a: `In ${L}, yes: prices dropped ${pct(Math.abs(infl.value))}, a decline exceeded only by Sri Lanka's. A year earlier, in ${L - 1}, inflation had been ${pct(i(L - 1))}.` },
  { q: 'Did Niger keep up fast growth in 2025?', a: `Yes — ${pct(growth)}, ranking ${ord(gRank)} worldwide, following ${pct(g(L - 1))} in ${L - 1}; growth peaked recently at ${pct(g(2022))} in 2022, straight after a weak ${pct(g(2021))}.` },
  { q: 'How does Niger\'s income per person compare?', a: `Near the bottom: ${usdWhole(perHead)} per Nigerien in ${L} — a record for Niger, yet the ${ord(pcLow)}-lowest in the world.` },
  { q: 'What share of Nigeriens are literate?', a: `${pct(litMe.value)} of adults at the ${litMe.year} measurement (UNESCO), below every country in the World Bank data except Chad.` },
  { q: 'How many Nigerien children die young?', a: `${u5.value.toFixed(1)} of every 1,000 born in ${u5.year} died before age five, on UN IGME estimates — the second-highest rate in the world.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Niger's economy in ${L}: fast growth, falling prices, very low incomes`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Nigerien economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Niger', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Niger's economy: growth on a very low base</h1>
        <p class="answer">
          Nigerien GDP stands at <strong>{usd(gdp)}</strong> following a <strong>{pct(growth)}</strong> expansion in {L}; the consumer price index went down {pct(Math.abs(infl.value))}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Niger economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Niger" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Output is growing quickly, yet on income, literacy and child survival Niger sits close to the bottom of world tables.</p>

        <div class="story-block prose">
          <h2>By how much did Nigerien prices drop in {L}?</h2>
          <p>By {pct(Math.abs(infl.value))} over the year, a swing from {pct(i(L - 1))} inflation in {L - 1}. Sri Lanka alone recorded a sharper decline that year.</p>
        </div>
        <LineChart
          title={`Niger's inflation rate, ${s.inflationPct[0][0]}–${L}`}
          subtitle="Consumer prices, % change per year; negative values mean prices fell."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Niger's output expanding?</h2>
          <p>Quickly: {pct(growth)} in {L} after {pct(g(L - 1))} in {L - 1}, and {ord(gRank)} worldwide. The pace has swung widely — {pct(g(2021))} in 2021, then {pct(g(2022))} in 2022. Valued in dollars, GDP reached an all-time {usd(gdp)}.</p>
        </div>
        <div class="story-block prose">
          <h2>How do incomes, schooling and health compare?</h2>
          <p>All rank near the bottom. Output per head ({usdWhole(perHead)}) ranks {ord(pcLow)} from the bottom; adult literacy was {pct(litMe.value)} in {litMe.year} (UNESCO), second-lowest after Chad; and the UN IGME estimates {u5.value.toFixed(1)} under-five deaths per 1,000 births for {u5.year}, second only to Nigeria. About {Math.round(agri)}% of workers are in farming.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Niger and the Sahel: related pages</h2>
          <ul>
            <li><a href={path('/population/niger/')}>Niger's population</a></li>
            <li><a href={path('/economy/mali/')}>Mali's economy</a></li>
            <li><a href={path('/economy/burkina-faso/')}>Burkina Faso's economy</a></li>
            <li><a href={path('/economy/nigeria/')}>Nigeria's economy</a></li>
            <li><a href={path('/rankings/literacy-rate-by-country/')}>Literacy rate by country</a></li>
            <li><a href={path('/rankings/child-mortality-by-country/')}>Child mortality by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Niger: annual data`}
          subtitle="Decades since 1960 plus 1973, 1978 and 1994, then 2015 onward; see the CSV for every year."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/niger-economy.csv')} csvName="niger-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Niger's economy: things people ask</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Literacy: SE.ADT.LITR.ZS (UNESCO); child mortality: SH.DYN.MORT (UN IGME); farm jobs: SL.AGR.EMPL.ZS (ILO), via the World Bank. Remittances are published to 2024. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Nigerien economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Niger" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
