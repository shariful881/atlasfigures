---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/burkina-faso.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';
import { rankLatest } from '../../lib/econ';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/burkina-faso/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const jump = (gdp / v('gdp', L - 1)! - 1) * 100;
const falling = rankBy('inflationPct', L).filter((r) => r.value < 0);
const fPos = rankBy('inflationPct', L).length - rankBy('inflationPct', L).findIndex((r) => r.iso3 === c.iso3);
const lit = rankLatest('literacyPct', 2015); const litMe = lit.find((r) => r.iso3 === c.iso3)!; const litLow = lit.length - litMe.rank + 1;
const remMax = s.remittances.reduce((a, b) => (b[1] > a[1] ? b : a));
const lastFall = Math.max(...s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const pcX = (perHead / v('gdpPerCapita', 2000)!).toFixed(1);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && Math.round(jump) === 19 && B.gdpRank === 118, 'record GDP +19% in dollars; 118th');
assertClaim(infl.value < 0 && falling.length === 12 && fPos === 5, 'prices fell; one of 12 economies with falling prices, 5th steepest');
assertClaim(i(2022) > 14 && iMax[0] === 1977 && iMax[1] > 29.9, '2022 14.3%; peak 1977');
assertClaim(litMe.year === 2023 && litLow === 6, 'literacy 41.6% (2023), 6th lowest');
assertClaim(remMax[0] === 2024 && rem!.year === 2024 && lastFall === 1990 && Number(pcX) === 4.6, 'record remittances 2024; last fall 1990; per head 4.6x 2000');
assertClaim(growth > g(L - 1) && g(L - 1) > g(2023) && g(2022) < 2, 'growth up two years after 2022 dip');

const title = `Burkina Faso Economy ${L}: GDP Up ${Math.round(jump)}% in Dollars as Prices Fall | AtlasFigures`;
const description = `In ${L} Burkina Faso's GDP rose about ${Math.round(jump)}% in dollar terms (to ${usd(gdp)}), real output ${pct(growth)}, and consumer prices fell ${pct(Math.abs(infl.value))} — among the steepest declines in the world.`;

const faq = [
  { q: 'Did prices fall in Burkina Faso in 2025?', a: `Yes, by ${pct(Math.abs(infl.value))}. That was the fifth-steepest fall of the ${falling.length} economies where prices dropped in ${L}. Three years earlier, in 2022, inflation was ${pct(i(2022))}.` },
  { q: 'How much did Burkina Faso\'s GDP rise?', a: `About ${Math.round(jump)}% in dollars, to a record ${usd(gdp)}; in real terms output grew ${pct(growth)}.` },
  { q: 'How many adults in Burkina Faso can read?', a: `${pct(litMe.value)} of adults (UNESCO, ${litMe.year}), the ${ord(litLow)}-lowest of ${lit.length} countries with figures from 2015 on.` },
  { q: 'Do remittances matter to Burkina Faso?', a: `Somewhat: a record ${usd(rem!.value)} arrived in ${rem!.year} (the newest figure), about ${pct(remPct!.value)} of GDP.` },
  { q: 'When did Burkina Faso\'s economy last contract?', a: `In 1990. The 2022 slowdown, to ${pct(g(2022))}, was followed by three faster years ending at ${pct(growth)}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Burkina Faso's economy in ${L}: a dollar GDP jump and falling prices`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Burkinabè economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Burkina Faso', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Burkina Faso's economy: record GDP, falling prices</h1>
        <p class="answer">
          Burkina Faso's economy was worth <strong>{usd(gdp)}</strong> in {L} after <strong>{pct(growth)}</strong> real growth, while the consumer price level fell {pct(Math.abs(infl.value))}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Burkina Faso economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Burkina Faso" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Only a dozen economies saw prices drop in {L}; Burkina Faso had the fifth-largest fall.</p>

        <div class="story-block prose">
          <h2>Why did Burkina Faso's dollar GDP jump in {L}?</h2>
          <p>Valued in current dollars it climbed roughly {Math.round(jump)}% — to {usd(gdp)}, never higher — whereas the volume of output grew {pct(growth)} — the gap is down to prices and currency movements. Per inhabitant, {usdWhole(perHead)} is {pcX}-fold the 2000 figure in dollars.</p>
        </div>
        <div class="story-block prose">
          <h2>Why are prices dropping in Burkina Faso?</h2>
          <p>By {pct(Math.abs(infl.value))} over {L} — the fifth-largest drop among the {falling.length} economies where prices fell. That reverses 2022's {pct(i(2022))} rise; the record, {pct(iMax[1])}, goes back to 1977.</p>
        </div>
        <LineChart
          title={`Burkina Faso's consumer price inflation, ${s.inflationPct[0][0]}–${L}`}
          subtitle="Change in consumer prices, % per year; values below zero mean prices fell."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Has Burkinabè growth recovered?</h2>
          <p>Gradually: from a 2022 low of {pct(g(2022))}, the real rate went to {pct(g(2023))}, {pct(g(2024))} and then {pct(growth)}. 1990 remains the last year of contraction.</p>
        </div>
        <LineChart
          title={`Burkinabè output growth, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Annual % change in output at constant prices."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What do literacy and remittance figures show?</h2>
          <p>UNESCO put adult literacy at {pct(litMe.value)} in {litMe.year}, the {ord(litLow)}-lowest of {lit.length} countries with recent figures. Burkinabè abroad sent a record {usd(rem!.value)} home in {rem!.year} ({pct(remPct!.value)} of GDP); later years are not yet out.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Burkina Faso and the Sahel: related pages</h2>
          <ul>
            <li><a href={path('/population/burkina-faso/')}>Burkina Faso's population</a></li>
            <li><a href={path('/economy/mali/')}>Mali's economy</a></li>
            <li><a href={path('/economy/benin/')}>Benin's economy</a></li>
            <li><a href={path('/economy/ghana/')}>Ghana's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation rates compared</a></li>
            <li><a href={path('/rankings/literacy-rate-by-country/')}>Literacy rate by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Burkina Faso by year`}
          subtitle="Decades from 1960 plus 1977, then the years 2015 through 2025; the CSV includes all other years."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/burkina-faso-economy.csv')} csvName="burkina-faso-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Burkina Faso's economy: ask and answer</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Literacy: SE.ADT.LITR.ZS (UNESCO), via the World Bank. Remittances are published to 2024. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Burkinabè economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Burkina Faso" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
