---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/guatemala.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/guatemala/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const lac = rankBy('gdp', L).filter((r) => r.region === 'Latin America & Caribbean');
const lPos = lac.findIndex((r) => r.iso3 === c.iso3);
const lacRem = rankBy('remittances', L).filter((r) => r.region === 'Latin America & Caribbean');
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const negYears = s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y);
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const remRank = rankBy('remittances', L).find((r) => r.iso3 === c.iso3)!.rank;
const pctRank = rankBy('remittancesPctGdp', L).find((r) => r.iso3 === c.iso3)!.rank;
const remX = Math.round(rem!.value / v('remittances', 2015)!);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && lPos === 9 && B.gdpRank === 67, 'record GDP; 10th in LAC; 67th');
assertClaim(isMax(s.remittances) && isMax(s.remittancesPctGdp) && remPct!.value > 20 && remRank === 9 && lacRem[0].iso3 === 'MEX' && lacRem[1].iso3 === 'GTM' && remX === 4, 'record remittances, over a fifth of GDP, 9th, second in LAC after Mexico, 4x 2015');
assertClaim(hiGrowSince === 2021 && lowInflSince === 1982 && iMax[0] === 1990 && iMax[1] > 41, 'growth fastest since 2021; inflation lowest since 1982; peak 1990');
assertClaim(negYears.join() === '1982,1983,1985,2020', 'only four contractions since 1961');
assertClaim(pctRank === 8, 'eighth-largest remittance share of GDP');

const title = `Guatemala Economy ${L}: Remittances Pass a Fifth of GDP | AtlasFigures`;
const description = `Remittances worth ${usd(rem!.value)} reached Guatemala in ${L}, its most ever and ${pct(remPct!.value)} of GDP, while output grew ${pct(growth)} to ${usd(gdp)}, with inflation at just ${pct(infl.value)}.`;

const faq = [
  { q: 'What share of Guatemala\'s GDP comes from remittances?', a: `More than a fifth: inflows of ${usd(rem!.value)} in ${L} equalled ${pct(remPct!.value)} of GDP, the highest share on record. By value it trails only Mexico across the region and ranks ${ord(remRank)} worldwide.` },
  { q: 'How much have remittances to Guatemala grown?', a: `About fourfold since 2015, when inflows totalled ${usd(v('remittances', 2015)!)}.` },
  { q: `Did Guatemala\'s growth pick up in ${L}?`, a: `It did: ${pct(growth)} after ${pct(g(L - 1))}, faster than any year since 2021, with GDP at a record ${usd(gdp)}.` },
  { q: 'Has Guatemala often been in recession?', a: `Rarely. Out of more than six decades of World Bank growth figures, just 1982, 1983, 1985 and 2020 were negative.` },
  { q: 'How high is Guatemalan inflation?', a: `Not high: ${pct(infl.value)} for ${L}, the least since 1982. The 1990 high was ${pct(iMax[1])}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Guatemala's economy in ${L}: remittances worth a fifth of output`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Guatemalan economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Guatemala', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Guatemala's economy: steady growth, carried from abroad</h1>
        <p class="answer">
          In {L} Guatemala received <strong>{usd(rem!.value)}</strong> from its people abroad — <strong>{pct(remPct!.value)}</strong> of GDP — while output rose {pct(growth)}, to {usd(gdp)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Guatemala economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Guatemala" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Only {pctRank - 1} economies took in a bigger share of GDP from remittances in {L}; Guatemala's own output has contracted in just four years on record.</p>

        <div class="story-block prose">
          <h2>How big are remittances compared with Guatemala's economy?</h2>
          <p>Huge. Guatemalans living abroad transferred {usd(rem!.value)} during {L}, which matches {pct(remPct!.value)} of GDP — more than a fifth, and the highest share on record. That is roughly {remX} times the 2015 inflow, and in the region only Mexico takes in more.</p>
        </div>
        <LineChart
          title={`Money sent to Guatemala from abroad, ${s.remittances[0][0]}–${L}`}
          subtitle="Personal remittances received, current US$."
          points={s.remittances.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Guatemala's economy growing steadily?</h2>
          <p>Remarkably so over the long run: the only negative years on record are 1982, 1983, 1985 and 2020. Growth was {pct(growth)} in {L}, the fastest since 2021, and dollar GDP set a record at {usd(gdp)}, {ord(lPos + 1)} in the region.</p>
        </div>
        <LineChart
          title={`Guatemala's real growth rate, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Inflation-adjusted output, % rise or fall per year."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Are prices rising fast in Guatemala?</h2>
          <p>No. Inflation slowed to {pct(infl.value)} in {L}, from {pct(i(2022))} in 2022, its gentlest pace since 1982. In 1990 the rate had reached {pct(iMax[1])}.</p>
        </div>
        <div class="story-block prose">
          <h2>How has income per person changed in Guatemala?</h2>
          <p>GDP per Guatemalan, {usdWhole(perHead)} for {L}, has never been higher; it ranks {ord(B.pcRank!)} globally ({intDollars(ppp!)} adjusted for prices). The ILO's modelled unemployment rate was {pct(unemp!)}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Guatemala and Central America: related pages</h2>
          <ul>
            <li><a href={path('/population/guatemala/')}>Guatemala's population</a></li>
            <li><a href={path('/economy/mexico/')}>Mexico's economy</a></li>
            <li><a href={path('/economy/colombia/')}>Colombia's economy</a></li>
            <li><a href={path('/economy/ecuador/')}>Ecuador's economy</a></li>
            <li><a href={path('/rankings/remittances-by-country/')}>Remittances league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Guatemala's key economic numbers`}
          subtitle="Decades since 1960, the 1982–85 contractions and 1990 inflation peak, then annually from 2015; every year is downloadable."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/guatemala-economy.csv')} csvName="guatemala-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Guatemala's economy: what to know</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank notes that for 1985–2003 multiple exchange rates in Guatemala are combined into an alternative conversion factor. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Guatemalan economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Guatemala" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
