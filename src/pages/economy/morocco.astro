---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/morocco.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/morocco/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const mena = rankBy('gdp', L).filter((r) => r.region === 'Middle East & North Africa');
const mPos = mena.findIndex((r) => r.iso3 === c.iso3);
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const uMax = s.unemploymentPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const remRank = rankBy('remittances', L).find((r) => r.iso3 === c.iso3)!.rank;
const remX = (rem!.value / v('remittances', 2015)!).toFixed(1);
const remUp = s.remittances.filter(([y]) => y >= 2017 && y <= L).every(([y, x]) => x > v('remittances', y - 1)!);
const gdpX = (gdp / v('gdp', 2000)!).toFixed(1);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && mPos === 8 && B.gdpRank === 57, 'record GDP and per person; ninth in MENA; 57th');
assertClaim(hiGrowSince === 2021 && growth > 4.5, 'growth fastest since 2021');
assertClaim(lowInflSince === 2019 && infl.year === L && i(2022) > 6 && i(2023) > 6 && iMax[0] === 1974 && iMax[1] > 17, 'inflation lowest since 2019 after 6%+ in 2022-23; peak 1974');
const hi22 = Math.max(...s.inflationPct.filter(([y, x]) => y < 2022 && x > i(2022)).map(([y]) => y));
assertClaim(hi22 === 1991 && i(2023) < i(2022), '2022 inflation highest since 1991');
assertClaim(worst[0] === 2020 && worst[1] < -7, '2020 deepest contraction on record');
assertClaim(uMax[0] === 1995 && uMax[1] > 14 && unemp! < 9.1, 'unemployment peak 1995');
assertClaim(isMax(s.remittances) && remUp && v('remittances', 2016)! < v('remittances', 2015)! && remRank === 16 && Number(remX) === 2.0 && remPct!.value > 7, 'record remittances, rising every year from 2017; 16th; doubled since 2015');
assertClaim(Number(gdpX) === 4.2, 'GDP 4.2 times 2000');

const title = `Morocco Economy ${L}: ${usd(gdp)} GDP, Inflation Down to ${pct(infl.value)} | AtlasFigures`;
const description = `Morocco\'s ${pct(growth)} growth in ${L} beat every year since 2021, and inflation eased to ${pct(infl.value)}. Money from Moroccans abroad reached a record ${usd(rem!.value)}, ${pct(remPct!.value)} of GDP.`;

const faq = [
  { q: 'How large is Morocco\'s economy?', a: `Bigger than ever, at ${usd(gdp)} for ${L}. It ranks ${ord(mPos + 1)} among Middle East and North Africa economies as the World Bank groups them, and ${ord(B.gdpRank!)} on Earth.` },
  { q: 'Has inflation in Morocco faded?', a: `Almost entirely: ${pct(infl.value)} in ${L}, Morocco\'s gentlest rate since 2019, following ${pct(i(2022))} in 2022 and ${pct(i(2023))} in 2023. The series high, ${pct(iMax[1])}, came in 1974.` },
  { q: 'How important are remittances for Morocco?', a: `Very. Inflows reached ${usd(rem!.value)} in ${L} — ${pct(remPct!.value)} of GDP, ${ord(remRank)} by value worldwide and about ${remX} times the 2015 amount. They have climbed each year since a dip in 2016.` },
  { q: 'How many Moroccans lack a job?', a: `Roughly ${pct(unemp!)} of Moroccans in the labour market were jobless in ${L} (modelled ILO estimate), well below 1995\'s ${pct(uMax[1])}.` },
  { q: 'When did Morocco\'s output last fall?', a: `The last one was 2020: output fell ${pct(Math.abs(worst[1]))}, the deepest drop in World Bank data for Morocco, then rebounded ${pct(g(2021))} in 2021.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Morocco's economy in ${L}: stronger growth, sub-1% inflation, record money from abroad`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Moroccan economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Morocco', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Morocco's economy: growth picks up as prices settle</h1>
        <p class="answer">
          Morocco's GDP rose <strong>{pct(growth)}</strong> in {L} to <strong>{usd(gdp)}</strong>, and consumer price inflation slowed to just {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Morocco economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Morocco" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Faster growth, near-flat prices and a ninth straight rise in money sent home by Moroccans abroad.</p>

        <div class="story-block prose">
          <h2>Is Morocco's economy growing faster?</h2>
          <p>It is: {pct(growth)} in {L}, a pace not matched since 2021, taking GDP to a record {usd(gdp)} — roughly {gdpX}-fold its 2000 level in current dollars. That puts Morocco {ord(mPos + 1)} among Middle East and North Africa economies and {ord(B.gdpRank!)} globally.</p>
        </div>
        <LineChart
          title={`Morocco's annual GDP growth, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Change in real (constant-price) GDP from the year before, %."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Has inflation in Morocco come back down?</h2>
          <p>Yes. After {pct(i(2022))} in 2022 and {pct(i(2023))} in 2023, Morocco's fastest price rises since 1991, the rate dropped to {pct(i(2024))} and then {pct(infl.value)} in {L}, Morocco's lowest reading since 2019.</p>
        </div>
        <div class="story-block prose">
          <h2>Why do remittances matter so much to Morocco?</h2>
          <p>Because of their size: {usd(rem!.value)} arrived in {L}, about {remX} times the 2015 total, after growth in every year since 2016's dip. That sum is worth {pct(remPct!.value)} of GDP, and only {remRank - 1} countries received more.</p>
        </div>
        <LineChart
          title={`Transfers from Moroccans abroad, ${s.remittances[0][0]}–${L}`}
          subtitle="Personal remittances received (transfers plus employee pay), current US$."
          points={s.remittances.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Morocco's income per head rising?</h2>
          <p>Yes — each Moroccan's share of GDP came to {usdWhole(perHead)} in {L}, the best yet; adjusted for purchasing power it equals {intDollars(ppp!)}. Joblessness on the ILO model was {pct(unemp!)}, down from 1995's peak of {pct(uMax[1])}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Morocco and North Africa: related pages</h2>
          <ul>
            <li><a href={path('/population/morocco/')}>Morocco's population</a></li>
            <li><a href={path('/economy/algeria/')}>Algeria's economy</a></li>
            <li><a href={path('/economy/egypt/')}>Egypt's economy</a></li>
            <li><a href={path('/economy/spain/')}>Spain's economy</a></li>
            <li><a href={path('/rankings/remittances-by-country/')}>Remittances league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Morocco's GDP, inflation and remittances in selected years`}
          subtitle="1960–2010 by decade, plus 1974 and 1995, then 2015 to 2025 year by year; the CSV file holds the rest."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/morocco-economy.csv')} csvName="morocco-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Morocco's economy: what readers ask</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Middle East and North Africa" follows the World Bank region of that name. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Moroccan economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Morocco" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
