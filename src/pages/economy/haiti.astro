---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/haiti.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/haiti/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const run = [2019, 2020, 2021, 2022, 2023, 2024, L].every((y) => g(y) < 0) && g(2018) > 0;
const gList = rankBy('gdpGrowthPct', L); const gLow = gList.length - gList.findIndex((r) => r.iso3 === c.iso3);
const iRank = rankBy('inflationPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const uRank = rankBy('unemploymentPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const pppPeak = s.gdpPerCapitaPpp.reduce((a, b) => (b[1] > a[1] ? b : a));
const jump = (gdp / v('gdp', L - 1)! - 1) * 100;
const remRank = rankBy('remittancesPctGdp', rem!.year).find((r) => r.iso3 === c.iso3)!.rank;
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const double = [2019, 2020, 2021, 2022, 2023, 2024, L].every((y) => i(y) > 15);

assertClaim(run && gLow === 3 && [2019, 2020, 2021, 2022, 2023, L].every((y) => g(y) > g(2024)), 'seven straight contractions 2019-2025; third-weakest growth in 2025');
assertClaim(isMax(s.gdp) && Math.round(jump) === 32 && pppPeak[0] === 2017 && ppp! < pppPeak[1], 'dollar GDP record, +32%, but PPP per head below 2017 peak');
assertClaim(iRank === 4 && double && iMax[0] === 1994, 'inflation 4th highest, above 15% since 2019; peak 1994');
assertClaim(uRank === 16 && rem!.year === 2024 && remRank === 16, 'unemployment 16th highest; remittances 2024, 16th by share');

const title = `Haiti Economy ${L}: Seventh Straight Year of Contraction | AtlasFigures`;
const description = `For a seventh straight year Haiti's output fell — by ${pct(Math.abs(growth))} in ${L} — while inflation ran at ${pct(infl.value)}, fourth-highest in the world. Dollar GDP still hit ${usd(gdp)}.`;

const faq = [
  { q: 'Is Haiti\'s economy still contracting?', a: `Yes, for a seventh year. Real GDP has fallen every year from 2019 to ${L}; the ${L} drop was ${pct(Math.abs(growth))}, the ${ord(gLow)}-weakest result of any economy.` },
  { q: 'Why did Haiti\'s dollar GDP rise if the economy shrank?', a: `GDP in current dollars jumped about ${Math.round(jump)}% to ${usd(gdp)} because of prices and the exchange rate, not more output. Measured at purchasing-power parity, income per person (${intDollars(ppp!)}) is below its 2017 level.` },
  { q: 'How does Haiti\'s inflation compare worldwide?', a: `It ranks ${ord(iRank)} of ${rankBy('inflationPct', L).length}: ${pct(infl.value)} in ${L}, and over 15% each year from 2019 on.` },
  { q: 'How much do Haitians living abroad send back?', a: `Haiti's ${rem!.year} inflow from emigrants, the most recent on record, was ${usd(rem!.value)}. That sum matched ${pct(remPct!.value)} of Haitian output, ${ord(remRank)} worldwide by share.` },
  { q: 'How high is joblessness in Haiti?', a: `The ILO models ${pct(unemp!)} for ${L}, ${ord(uRank)}-highest worldwide.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Haiti's economy in ${L}: seven years of decline and high inflation`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Haitian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Haiti', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Haiti's economy: seven years of contraction</h1>
        <p class="answer">
          Haiti's economy shrank by <strong>{pct(Math.abs(growth))}</strong> in {L} — a seventh consecutive decline — while prices climbed <strong>{pct(infl.value)}</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Haiti economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Haiti" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Output has declined every year since 2019, while inflation has stayed above 15%.</p>

        <div class="story-block prose">
          <h2>How long has Haiti's economy been shrinking?</h2>
          <p>Since 2019 without a break. Real GDP fell in each of the seven years from 2019 to {L}, most sharply in 2024 ({pct(Math.abs(g(2024)))}); the {L} decline of {pct(Math.abs(growth))} was the {ord(gLow)}-weakest result among {gList.length} economies.</p>
        </div>
        <LineChart
          title={`Growth or shrinkage of Haiti's economy, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Real GDP, % change from the year before."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>How can Haiti's dollar GDP rise while output falls?</h2>
          <p>Because prices and the exchange rate moved, not because output grew. Measured in current US dollars, GDP rose about {Math.round(jump)}% in {L} to {usd(gdp)}. At purchasing-power parity, which removes price differences, GDP per person was {intDollars(ppp!)} — below its 2017 peak of {intDollars(pppPeak[1])}.</p>
        </div>
        <div class="story-block prose">
          <h2>How high are prices and unemployment in Haiti?</h2>
          <p>Haitian inflation, {pct(infl.value)} for {L}, ranked {ord(iRank)} in the world and has topped 15% annually from 2019; the record is {pct(iMax[1])}, in 1994. The ILO's modelled unemployment rate is {pct(unemp!)}, {ord(uRank)}-highest worldwide.</p>
        </div>
        <LineChart
          title={`Haitian inflation, ${s.inflationPct[0][0]}–${L}`}
          subtitle="How much Haitian consumer prices rose each year, %."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What role do remittances play in Haiti?</h2>
          <p>A large one: the Haitian diaspora transferred {usd(rem!.value)} in {rem!.year} (most recent data); measured against GDP ({pct(remPct!.value)}) Haiti places {ord(remRank)} globally.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Haiti and the Caribbean: related pages</h2>
          <ul>
            <li><a href={path('/population/haiti/')}>Haiti's population</a></li>
            <li><a href={path('/economy/dominican-republic/')}>Dominican Republic's economy</a></li>
            <li><a href={path('/economy/honduras/')}>Honduras's economy</a></li>
            <li><a href={path('/economy/guatemala/')}>Guatemala's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation rates compared</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Haiti in figures`}
          subtitle="1960 to 2010 in ten-year steps, with 1994–95, then 2015–2025. More in the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/haiti-economy.csv')} csvName="haiti-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Haiti's economy: questions answered</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Remittances are published to 2024. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Haitian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Haiti" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
