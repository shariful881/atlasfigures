---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/switzerland.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/switzerland/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const top = rankBy('gdpPerCapita', L);
const eca = rankBy('inflationPct', L).filter((r) => r.region === 'Europe & Central Asia').sort((a, b) => a.value - b.value);
const deflation = s.inflationPct.filter(([y, x]) => y >= 2010 && x < 0).map(([y]) => y);
const uHiSince = Math.max(...s.unemploymentPct.filter(([y, x]) => y < L && x > unemp!).map(([y]) => y));
const uLow = s.unemploymentPct.reduce((a, b) => (b[1] < a[1] ? b : a));

assertClaim(B.pcRank === 3 && top[0].iso3 === 'LUX' && top[1].iso3 === 'IRL', 'third per person after Luxembourg and Ireland');
assertClaim(gdp >= 1e12 && s.gdp.every(([y, x]) => y === L || x < 1e12) && B.gdpRank === 20, 'GDP above $1 trillion for the first time; 20th');
assertClaim(infl.year === L && infl.value < 0.5 && eca[0].iso3 === 'CYP' && eca[1].iso3 === c.iso3, 'inflation 0.2%, second-lowest in Europe & Central Asia after Cyprus');
assertClaim(deflation.join() === '2012,2013,2014,2015,2016,2020', 'prices fell in six years since 2010');
assertClaim(Math.max(...s.inflationPct.filter(([y, x]) => y < 2022 && x > i(2022)).map(([y]) => y)) === 1993 && i(2022) < 3, '2022 peak under 3%, highest since 1993');
assertClaim(uHiSince === 2021 && unemp! < 5 && uLow[0] === 1991 && unemp! > u(2024), 'unemployment highest since 2021, still under 5%');
assertClaim(ppp! < perHead, 'PPP figure below the dollar figure');

const title = `Switzerland Economy ${L}: $1 Trillion GDP, Prices Nearly Flat | AtlasFigures`;
const description = `Swiss GDP crossed one trillion dollars in ${L}, a first, reaching ${usd(gdp)}. At ${usdWhole(perHead)} per person it ranks third in the world, and consumer prices rose only ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Switzerland the richest country per person?', a: `Third on ${L} World Bank figures, at ${usdWhole(perHead)} per person, behind Luxembourg (${usdWhole(top[0].value)}) and Ireland (${usdWhole(top[1].value)}).` },
  { q: 'Why is Swiss inflation so low?', a: `The World Bank figures do not explain it; they show ${pct(infl.value)} in ${L}, the second-lowest rate in its Europe & Central Asia region after Cyprus. Even the 2022 peak was only ${pct(i(2022))}.` },
  { q: 'When did Switzerland\'s GDP pass $1 trillion?', a: `In ${L}, at ${usd(gdp)}, ranking ${ord(B.gdpRank!)} in the world.` },
  { q: 'Have prices in Switzerland ever fallen?', a: `Yes. Consumer prices were lower than a year earlier in six years since 2010: 2012 to 2016 and 2020.` },
  { q: 'Why is Swiss GDP per person lower at PPP?', a: `High Swiss prices pull the PPP number down: ${intDollars(ppp!)} at PPP against ${usdWhole(perHead)} at market exchange rates.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Switzerland's economy ${L}: a trillion-dollar GDP, third-highest income per head, inflation near zero`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Swiss economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Switzerland', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Switzerland's economy: a trillion dollars, near-zero inflation</h1>
        <p class="answer">
          In {L} the Swiss economy topped a trillion dollars for the first time, at <strong>{usd(gdp)}</strong>. Output per person, <strong>{usdWhole(perHead)}</strong>, is the third highest in the world, and inflation was just {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Switzerland economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Switzerland" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">High incomes and remarkably stable prices define the Swiss economy; {L} added a new milestone in dollar terms.</p>

        <div class="story-block prose">
          <h2>Is Switzerland among the richest countries?</h2>
          <p>Yes: {usdWhole(perHead)} per resident in {L}, behind only Luxembourg ({usdWhole(top[0].value)}) and Ireland ({usdWhole(top[1].value)}). Adjusted for purchasing power it drops to {intDollars(ppp!)}, below the dollar number, because Swiss prices are high.</p>
        </div>
        <LineChart
          title={`Switzerland's income per head in dollars since 1960`}
          subtitle="Current US dollars per resident; five-year steps, then annual from 2019."
          points={s.gdpPerCapita.filter(([y]) => y % 5 === 0 || y >= 2019).map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>When did Swiss GDP pass one trillion dollars?</h2>
          <p>In {L}. Output reached {usd(gdp)}, crossing that line for the first time and placing Switzerland {ord(B.gdpRank!)} in the world. The economy grew {pct(growth)} after inflation, versus {pct(g(2024))} in 2024.</p>
        </div>
        <div class="story-block prose">
          <h2>How low is inflation in Switzerland?</h2>
          <p>Very low: {pct(infl.value)} in {L}. In the World Bank's Europe &amp; Central Asia region only Cyprus had a smaller rise. Even at its 2022 peak, the highest since 1993, Swiss inflation was {pct(i(2022))}, and prices actually fell in 2012–2016 and 2020.</p>
        </div>
        <LineChart
          title={`Swiss consumer price inflation, 1960–${L}`}
          subtitle="Annual change, per cent; years below zero mean prices fell."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Are more Swiss workers out of a job?</h2>
          <p>A few more. Switzerland's ILO-modelled jobless rate went up from {pct(u(2024))} to {pct(unemp!)} in {L}, higher than any year since 2021 though below 5%. In 1991 it was {pct(uLow[1])}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Switzerland and Europe: related pages</h2>
          <ul>
            <li><a href={path('/population/switzerland/')}>Switzerland's population</a></li>
            <li><a href={path('/economy/germany/')}>Germany's economy</a></li>
            <li><a href={path('/economy/italy/')}>Italy's economy</a></li>
            <li><a href={path('/economy/france/')}>France's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>Richest countries per person</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Swiss output, prices and jobs since 1960`}
          subtitle="With 1991, 2009, 2015 and the latest years; the CSV includes all of them."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/switzerland-economy.csv')} csvName="switzerland-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Switzerland's economy: questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Comparisons across Europe use the World Bank's Europe &amp; Central Asia region. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Swiss economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Switzerland" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
