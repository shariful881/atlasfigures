---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/peru.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/peru/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const lac = rankBy('gdp', L).filter((r) => r.region === 'Latin America & Caribbean');
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const best = s.gdpGrowthPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const remRank = rankBy('remittances', L).find((r) => r.iso3 === c.iso3)!.rank;
const remX = (rem!.value / v('remittances', 2015)!).toFixed(1);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && lac.findIndex((r) => r.iso3 === c.iso3) === 5 && B.gdpRank === 46, 'record GDP and per person; sixth in LAC; 46th');
assertClaim(best[0] === 2021 && g(2020) < -10, '2021 fastest growth on record after 2020 slump');
assertClaim(iMax[0] === 1990 && iMax[1] > 7000 && i(1989) > 1000, 'hyperinflation 1989-90');
assertClaim(infl.year === L && lowInflSince === 2018 && i(2022) > 8, 'inflation lowest since 2018');
assertClaim(isMax(s.remittances) && remRank === 38 && Number(remX) > 1.8, 'record remittances; 38th');

const title = `Peru Economy ${L}: Record Output, Inflation at 1.5% | AtlasFigures`;
const description = `At ${usd(gdp)}, Peru\'s ${L} GDP was its largest ever, sixth in Latin America, after growth of ${pct(growth)}. Inflation fell to ${pct(infl.value)}, a far cry from the hyperinflation of 1989–90.`;

const faq = [
  { q: 'Is Peru one of Latin America\'s big economies?', a: `It is the region\'s sixth-largest: ${usd(gdp)} for ${L}, Peru\'s biggest total yet, and ${ord(B.gdpRank!)} worldwide.` },
  { q: 'Is Peruvian inflation low?', a: `Very: the ${L} rate of ${pct(infl.value)} was the gentlest since 2018 and well down on 2022\'s ${pct(i(2022))}.` },
  { q: 'Did Peru have hyperinflation?', a: `Yes. Consumer prices rose more than 1,000% in 1989 and peaked at more than 7,000% in 1990.` },
  { q: 'How did Peru recover from 2020?', a: `A ${pct(Math.abs(g(2020)))} slump in 2020 gave way to growth of ${pct(best[1])} in 2021, the fastest in the World Bank record.` },
  { q: 'How much money reaches Peru from emigrants?', a: `Peru received ${usd(rem!.value)} in ${L}, more than ever and some ${remX} times the 2015 sum; that ranks ${ord(remRank)} worldwide.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Peru's economy ${L}: record output, low inflation and record remittances`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Peruvian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Peru', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Peru's economy: record size, tame prices</h1>
        <p class="answer">
          Peru's economy expanded <strong>{pct(growth)}</strong> in {L}, to a peak of <strong>{usd(gdp)}</strong>, while price rises cooled to {pct(infl.value)} — a 2018-style calm.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Peru economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Peru" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Three decades after hyperinflation, Peru now pairs record output with its slowest price rises since 2018.</p>

        <div class="story-block prose">
          <h2>Is Peru's economy still expanding?</h2>
          <p>Yes — {pct(growth)} in {L}, lifting output to {usd(gdp)}, a new high, sixth-largest in Latin America and {ord(B.gdpRank!)} globally. The swing around the pandemic was extreme: {signedPct(g(2020))} in 2020, then {signedPct(best[1])} in 2021, the highest growth on record.</p>
        </div>
        <LineChart
          title={`Peru's real growth, 1961–${L}`}
          subtitle="Year-on-year % change in constant-price GDP."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Has Peru beaten inflation?</h2>
          <p>{pct(infl.value)} in {L}, the calmest since 2018 — a long way from the hyperinflation of 1989 and 1990, when annual inflation first passed 1,000% and then topped 7,000%.</p>
        </div>
        <div class="story-block prose">
          <h2>What is Peru's output per inhabitant?</h2>
          <p>GDP per Peruvian hit a record {usdWhole(perHead)} in {L} ({intDollars(ppp!)} after adjusting for prices), and ILO-modelled joblessness stood at {pct(unemp!)}.</p>
        </div>
        <div class="story-block prose">
          <h2>How much reaches Peru from abroad?</h2>
          <p>More than ever before: {L} inflows set a record and were roughly {remX}-fold the 2015 level, {ord(remRank)} by value worldwide.</p>
        </div>
        <LineChart
          title={`Remittances to Peru, 1990–${L}`}
          subtitle="Inflows from Peruvians abroad, US$."
          points={s.remittances.filter(([y]) => y >= 1990).map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <nav class="related" aria-label="Related pages">
          <h2>Peru and South America: related pages</h2>
          <ul>
            <li><a href={path('/population/peru/')}>Peru's population</a></li>
            <li><a href={path('/economy/colombia/')}>Colombia's economy</a></li>
            <li><a href={path('/economy/brazil/')}>Brazil's economy</a></li>
            <li><a href={path('/economy/argentina/')}>Argentina's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Peru's GDP, prices and remittances in chosen years`}
          subtitle="Starts in 1960; adds 1983 and 1989–90 and then runs 2019 onward. Download the file for the rest."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/peru-economy.csv')} csvName="peru-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Peru's economy, briefly explained</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Latin America" here means the World Bank's Latin America &amp; Caribbean region. The World Bank notes that multiple exchange rates in Peru are combined into an alternative conversion factor. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Peruvian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Peru" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
