---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/ghana.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/ghana/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const ssa = rankBy('gdp', L).filter((r) => r.region === 'Sub-Saharan Africa');
const sPos = ssa.findIndex((r) => r.iso3 === c.iso3);
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const hi23Since = Math.max(...s.inflationPct.filter(([y, x]) => y < 2023 && x > i(2023)).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const best = s.gdpGrowthPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const jump = Math.round((gdp / v('gdp', L - 1)! - 1) * 100);
const gdpX = Math.round(gdp / v('gdp', 2000)!);
const remPeak = s.remittances.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && sPos === 5 && ssa[sPos - 1].iso3 === 'AGO' && ssa[sPos + 1].iso3 === 'CIV' && B.gdpRank === 69, 'record GDP; sixth in SSA between Angola and Cote dIvoire; 69th');
assertClaim(jump === 37 && growth < 6.1, 'dollar GDP up 37% while real growth 6%');
assertClaim(hiGrowSince === 2019, 'growth fastest since 2019');
assertClaim(lowInflSince === 2021 && hi23Since === 2001 && i(2023) > 38 && i(2022) > 31, 'inflation lowest since 2021; 2023 highest since 2001');
assertClaim(iMax[0] === 1983 && iMax[1] > 120, 'inflation peak 1983');
assertClaim(best[0] === 2011 && best[1] > 14, 'fastest growth 2011');
assertClaim(gdpX === 23, 'GDP about 23 times 2000');
assertClaim(remPeak[0] === 2015 && rem!.year === L && rem!.value < remPeak[1] / 2, 'remittances peaked 2015, now under half');

const title = `Ghana Economy ${L}: GDP Jumps to ${usd(gdp)}, Inflation Cools | AtlasFigures`;
const description = `Counted in US dollars, Ghanaian GDP climbed ${jump}% in ${L}, to ${usd(gdp)}. Real growth was ${pct(growth)}, and price rises slowed to ${pct(infl.value)} after 2023\'s ${pct(i(2023))}.`;

const faq = [
  { q: 'Why did Ghana\'s GDP jump so much in dollars?', a: `Measured in current US dollars it rose ${jump}% in ${L}, far more than the ${pct(growth)} real growth rate. The dollar total also moves with prices and the cedi\'s exchange rate, so it can change much faster than output.` },
  { q: 'Has Ghana\'s inflation come down?', a: `Yes, sharply. Following 2023\'s ${pct(i(2023))} — no year since 2001 had been worse — it eased to ${pct(i(2024))} in 2024 and ${pct(infl.value)} in ${L}, the lowest figure since 2021.` },
  { q: 'Where does Ghana\'s economy sit within sub-Saharan Africa?', a: `${ord(sPos + 1)}, ranked between Angola above and Côte d\'Ivoire below, on ${L} output of ${usd(gdp)}.` },
  { q: 'What was Ghana\'s worst inflation?', a: `${pct(iMax[1])} in 1983, the peak in a series that starts in ${s.inflationPct[0][0]}.` },
  { q: 'Are remittances to Ghana rising?', a: `Not compared with their peak: ${usd(rem!.value)} in ${L}, not even half of the ${usd(remPeak[1])} that arrived in 2015.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Ghana's economy in ${L}: a dollar-terms leap and the end of a price surge`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Ghanaian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Ghana', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Ghana's economy: record output after the price shock</h1>
        <p class="answer">
          In {L} Ghana posted <strong>{pct(growth)}</strong> real growth and a dollar GDP of <strong>{usd(gdp)}</strong>; price growth cooled to {pct(infl.value)} after the 2023 spike.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Ghana economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Ghana" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Two years after its worst price surge since 2001, Ghana combines its fastest growth since 2019 with a record dollar GDP.</p>

        <div class="story-block prose">
          <h2>How large did Ghana's GDP get in {L}?</h2>
          <p>{usd(gdp)} in {L}, Ghana's largest ever and {jump}% above the year before in dollar terms. That places it {ord(sPos + 1)} in sub-Saharan Africa, between Angola and Côte d'Ivoire, and {ord(B.gdpRank!)} in the world. In current dollars GDP is about {gdpX} times what it was in 2000.</p>
        </div>
        <div class="story-block prose">
          <h2>Is Ghana growing quickly in real terms?</h2>
          <p>In constant prices the economy grew {pct(growth)} in {L}, the strongest rate since 2019; Ghana's best year on record was 2011, at {pct(best[1])}.</p>
        </div>
        <LineChart
          title={`Growth of Ghana's economy after inflation, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Annual increase or fall in real output, %."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Has Ghana's inflation surge ended?</h2>
          <p>Prices are still rising, but far more slowly. The 2023 rate of {pct(i(2023))} was the steepest since 2001; by {L} it was down to {pct(infl.value)}, Ghana's mildest since 2021. Ghana's worst year for prices was 1983, at {pct(iMax[1])}.</p>
        </div>
        <LineChart
          title={`Ghana's inflation rate, 2000–${L}`}
          subtitle="Annual % change in consumer prices."
          points={s.inflationPct.filter(([y]) => y >= 2000).map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Ghana richer per person than before?</h2>
          <p>Yes. Output per Ghanaian reached {usdWhole(perHead)} in {L}, the most yet, equal to {intDollars(ppp!)} once differences in price levels are allowed for. Joblessness measured just {pct(unemp!)}, an ILO estimate that counts informal work as a job.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Ghana and West Africa: related pages</h2>
          <ul>
            <li><a href={path('/population/ghana/')}>Ghana's population</a></li>
            <li><a href={path('/economy/nigeria/')}>Nigeria's economy</a></li>
            <li><a href={path('/economy/kenya/')}>Kenya's economy</a></li>
            <li><a href={path('/economy/south-africa/')}>South Africa's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Ghana's GDP, inflation and growth in selected years`}
          subtitle="Decades from 1960, the 1983 inflation peak, 2011, then each year from 2015 — look in the CSV for everything else."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/ghana-economy.csv')} csvName="ghana-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Ghana's economy, question by question</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Sub-Saharan Africa" is the World Bank region. The World Bank notes that for 1974–1987 multiple exchange rates in Ghana are combined into an alternative conversion factor. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Ghanaian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Ghana" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
