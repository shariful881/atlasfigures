---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/netherlands.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/netherlands/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const hi22 = Math.max(...s.inflationPct.filter(([y, x]) => y < 2022 && x > i(2022)).map(([y]) => y));
const netRank = rankBy('internetPct', net!.year).find((r) => r.iso3 === c.iso3)!.rank;

assertClaim(B.gdpRank === 18 && B.pcRank === 10 && s.gdp.every(([y, x]) => y === L || x < gdp), '18th by GDP, 10th per person, record GDP');
assertClaim(hi22 === 1975 && i(2022) > 9.95, '2022 inflation 10.0%, highest since 1975');
assertClaim(infl.year === L && infl.value > 3 && infl.value < i(2024) && Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y)) === 2021, 'inflation above 3%, lowest since 2021');
assertClaim(g(2023) < 0 && g(2024) > 0 && growth > g(2024) && Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y)) === 2022, '2023 contraction, recovery since; fastest since 2022');
assertClaim(unemp! < 4 && u(2024) < unemp! && u(2023) < u(2024), 'unemployment under 4%, up two years running');
assertClaim(net!.value > 96, 'internet use above 96%');

const title = `Dutch Economy ${L}: GDP, Income per Head, Inflation | AtlasFigures`;
const description = `With ${usd(gdp)} produced in ${L}, the Netherlands ranks 18th, and its ${usdWhole(perHead)} per person ranks 10th. Growth picked up to ${pct(growth)} after a 2023 dip, while inflation was ${pct(infl.value)}.`;

const faq = [
  { q: 'How rich is the Netherlands per person?', a: `${usdWhole(perHead)} of output per head in ${L}; only nine economies had more. The PPP version: ${intDollars(ppp!)}.` },
  { q: 'Did the Dutch economy shrink in 2023?', a: `Slightly: real GDP fell ${pct(Math.abs(g(2023)))} that year, then grew ${pct(g(2024))} in 2024 and ${pct(growth)} in ${L}.` },
  { q: 'What was the peak of Dutch inflation?', a: `${pct(i(2022))}, reached in 2022 and unmatched since 1975. By ${L} it had eased to ${pct(infl.value)}.` },
  { q: 'Is unemployment rising in the Netherlands?', a: `A little, from a low base: ${pct(u(2023))} in 2023, ${pct(u(2024))} in 2024 and ${pct(unemp!)} in ${L} (ILO model).` },
  { q: 'What share of Dutch people use the internet?', a: `Almost all: ${pct(net!.value)} in ${net!.year}, placing the Netherlands ${ord(netRank)} in the ITU's data for that year.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `The Netherlands' economy ${L}: tenth-richest per person, growth back after a 2023 dip`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Dutch economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Netherlands', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>The Dutch economy: rich per head, growing again</h1>
        <p class="answer">
          In {L} the Netherlands generated <strong>{usd(gdp)}</strong>: <strong>{usdWhole(perHead)}</strong> for every resident, 10th in the world. Growth recovered to {pct(growth)} after a small contraction in 2023.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Netherlands economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Netherlands" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">With one of the world's highest outputs per head, the Netherlands is back to growth after a brief dip.</p>

        <div class="story-block prose">
          <h2>How wealthy are the Dutch?</h2>
          <p>Very, measured per person: each Dutch resident accounted for {usdWhole(perHead)} in {L}, ranking {ord(B.pcRank!)} worldwide ({intDollars(ppp!)} with prices equalised). The whole economy, {usd(gdp)}, ranks {ord(B.gdpRank!)} and has never been bigger in dollars.</p>
        </div>
        <LineChart
          title={`Output per Dutch resident in dollars since 1960`}
          subtitle="Current-price dollars per head; five-year intervals to 2015, annual afterwards."
          points={s.gdpPerCapita.filter(([y]) => y % 5 === 0 || y >= 2019).map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is the Dutch economy growing again?</h2>
          <p>Yes. After a {pct(Math.abs(g(2023)))} contraction in 2023, Dutch output expanded {pct(g(2024))} in 2024 and {pct(growth)} in {L}, the best result since 2022.</p>
        </div>
        <div class="story-block prose">
          <h2>Is Dutch inflation back to normal?</h2>
          <p>Not quite. From {pct(i(2022))} in 2022, the steepest rise since 1975, Dutch inflation eased to {pct(i(2024))} in 2024 and {pct(infl.value)} in {L}, its lowest since 2021 though still above 3%.</p>
        </div>
        <div class="story-block prose">
          <h2>How tight is the Dutch job market?</h2>
          <p>Unemployment is low but edging up: {pct(unemp!)} in {L} by the ILO's estimate, from {pct(u(2023))} two years earlier. Nearly everyone is online, with internet use at {pct(net!.value)}.</p>
        </div>
        <LineChart
          title={`Netherlands unemployment, 1991–${L}`}
          subtitle="ILO-modelled jobless rate in the Netherlands, per cent."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <nav class="related" aria-label="Related pages">
          <h2>The Netherlands and Europe: related pages</h2>
          <ul>
            <li><a href={path('/population/netherlands/')}>The Netherlands' population</a></li>
            <li><a href={path('/economy/germany/')}>Germany's economy</a></li>
            <li><a href={path('/economy/france/')}>France's economy</a></li>
            <li><a href={path('/economy/sweden/')}>Sweden's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person worldwide</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`The Dutch economic record, selected years`}
          subtitle="Includes 1975, 2009 and 2014 with each year from 2019; get all years in the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/netherlands-economy.csv')} csvName="netherlands-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Dutch economy: quick questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Comparisons over time use the same World Bank indicators throughout. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Dutch economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Netherlands" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
