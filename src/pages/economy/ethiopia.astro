---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LineChart from '../../components/LineChart.astro';
import EconTable from '../../components/EconTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import c from '../../data/economy/ethiopia.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../lib/econ';
import { econBasics, econSchema } from '../../lib/econPage';
import { assertClaim, pct, ord } from '../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/economy/ethiopia/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const remRank = rankBy('remittances', rem!.year).find((r) => r.iso3 === c.iso3)!.rank;
const peak = s.gdp.reduce((a, b) => (b[1] > a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const negs = s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y);
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));

assertClaim(hiGrowSince === 2015 && s.gdpGrowthPct[0][0] === 1962, 'growth the fastest since 2015; series from 1962');
assertClaim(negs.at(-1) === 2003 && s.gdpGrowthPct.filter(([y]) => y >= 2004).every(([, x]) => x > 0), 'growth every year since 2004');
assertClaim(peak[0] === 2024 && gdp < peak[1], 'dollar GDP below its 2024 peak');
assertClaim(infl.year === L && lowInflSince === 2017 && [2020, 2021, 2022, 2023, 2024].every((y) => i(y) > 20) && iMax[0] === 2008, 'inflation lowest since 2017; above 20% 2020-2024; peak 2008');
assertClaim(rem!.year === 2024 && remRank === 29, 'remittances 29th in 2024');
assertClaim(B.pcRank! >= 170 && B.pcRank === 175 && net!.value < 25, '175th per person; under a quarter online');

const title = `Ethiopia Economy ${L}: Fast Growth, Smaller in Dollars | AtlasFigures`;
const description = `Adjusted for inflation, Ethiopia's ${L} output was up ${pct(growth)}, its fastest since 2015 — yet in dollars the economy shrank to ${usd(gdp)} from ${usd(peak[1])}. Inflation eased to ${pct(infl.value)}.`;

const faq = [
  { q: 'How quickly did Ethiopia grow in ' + L + '?', a: `${pct(growth)} after inflation, the quickest since 2015; there has been no year of contraction since 2003.` },
  { q: 'Why did Ethiopia\'s GDP in dollars fall in ' + L + '?', a: `The 2024 total of ${usd(peak[1])} fell to ${usd(gdp)} a year later, although real output grew ${pct(growth)}. Converting birr into dollars at a different rate can move the total on its own.` },
  { q: 'Has Ethiopian inflation eased?', a: `Yes. The ${L} increase of ${pct(infl.value)} was Ethiopia\'s lowest since 2017, following five straight years (2020–2024) above 20%. The all-time high, ${pct(iMax[1])}, came in 2008.` },
  { q: 'How poor is Ethiopia per person?', a: `Output per inhabitant came to ${usdWhole(perHead)} in ${L}, placing Ethiopia ${ord(B.pcRank!)} of ranked economies; in PPP terms, ${intDollars(ppp!)}.` },
  { q: 'How large are remittances to Ethiopia?', a: `${usd(rem!.value)} in ${rem!.year} (no ${L} figure yet), ${ord(remRank)} worldwide.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Ethiopia's economy ${L}: growth at its fastest since 2015 alongside a lower dollar total and easing inflation`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Ethiopian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Ethiopia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Ethiopia's economy: fast growth, fewer dollars</h1>
        <p class="answer">
          In {L} Ethiopia's real output grew <strong>{pct(growth)}</strong> — no year since 2015 was stronger — while GDP counted in dollars fell to <strong>{usd(gdp)}</strong>. Price rises slowed to {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Ethiopia economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Ethiopia" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Two decades of uninterrupted growth have not yet lifted Ethiopia's output per person far from the bottom of the world table.</p>

        <div class="story-block prose">
          <h2>Why is Ethiopia growing fast but shrinking in dollars?</h2>
          <p>Both hold for {L}. Measured at constant prices, output climbed {pct(growth)}, the strongest showing since 2015. Converted to dollars, though, GDP dropped to {usd(gdp)} from {usd(peak[1])} the year before, leaving Ethiopia {ord(B.gdpRank!)} globally — the dollar figure also reflects the rate used to convert birr.</p>
        </div>
        <LineChart
          title={`Ethiopian GDP measured in US dollars, ${s.gdp[0][0]}–${L}`}
          subtitle="Nominal dollars; the line peaks in 2024."
          points={s.gdp.map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Has Ethiopia had a recession recently?</h2>
          <p>Not for two decades. Output last fell in 2003; each year from 2004 onward shows growth, in a record that opens in 1962.</p>
        </div>
        <LineChart
          title={`Real growth in Ethiopia, 1962–${L}`}
          subtitle="Year-on-year change in real output, %."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Ethiopian inflation falling?</h2>
          <p>It has eased sharply. The {L} rate of {pct(infl.value)} was Ethiopia's lowest since 2017, coming after five years in a row above 20%. The peak, {pct(iMax[1])}, was reached in 2008.</p>
        </div>
        <div class="story-block prose">
          <h2>What is Ethiopia's income per person?</h2>
          <p>Very low: {usdWhole(perHead)} a head in {L}, {ord(B.pcRank!)} of the economies ranked; in PPP dollars, {intDollars(ppp!)}. Ethiopians working abroad sent {usd(rem!.value)} home in {rem!.year}, and internet users made up {pct(net!.value)} of the population.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Ethiopia and other African economies: related pages</h2>
          <ul>
            <li><a href={path('/population/ethiopia/')}>Ethiopia's population</a></li>
            <li><a href={path('/economy/kenya/')}>Kenya's economy</a></li>
            <li><a href={path('/economy/egypt/')}>Egypt's economy</a></li>
            <li><a href={path('/economy/nigeria/')}>Nigeria's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Ethiopia year by year: growth, prices and income since 1962`}
          subtitle="Covers 1985, 2003 and 2015 next to the latest years; all other years are in the CSV file."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/ethiopia-economy.csv')} csvName="ethiopia-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Ethiopian growth and prices: quick answers</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank notes Ethiopia's fiscal year ends on 7 July and that multiple or dual exchange rates existed, so its Atlas income figures use an alternative conversion factor for 2015–2024. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Ethiopian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Ethiopia" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
