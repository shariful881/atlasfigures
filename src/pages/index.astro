---
import Base from '../layouts/Base.astro';
import LiveCounter from '../components/LiveCounter.astro';
import Contours from '../components/Contours.astro';
import Icon from '../components/Icon.astro';
import bd from '../data/countries/bangladesh.json';
import { worldData, countryData, countryIndex, byYear, billions, millions, int, CURRENT_YEAR, assertClaim } from '../lib/figures';

const w = byYear(worldData.years)[CURRENT_YEAR];
const bdNow = byYear(countryData(bd.iso3).years)[CURRENT_YEAR];
const bdFertility1970 = byYear(countryData(bd.iso3).years)[1970].fertility;
const densest = countryIndex.countries.filter((x) => x.population > 10e6).sort((a, b) => b.densityPerKm2 - a.densityPerKm2)[0];
assertClaim(densest.iso3 === bd.iso3, 'Bangladesh is the most densely populated country of more than 10 million people');
assertClaim(bdFertility1970 > 6.5 && bdNow.fertility < 2.2, 'Bangladesh went from almost seven births per woman to about two');
import { path } from '../site';

const tiles = [
  { key: 'population' as const, title: 'Population', text: 'Every country: how many people, how crowded, and where it is heading by 2050.', live: true },
  { key: 'time' as const, title: 'Time', text: 'Local time in every city, time differences and a meeting planner.', live: false },
  { key: 'economy' as const, title: 'Economy', text: 'GDP, income and inflation, with long-run charts and country comparisons.', live: false },
  { key: 'rankings' as const, title: 'Rankings', text: 'Countries ranked on hundreds of measures, each list sourced and explained.', live: false },
];
---
<Base
  title="World Population Live & Country Statistics | AtlasFigures"
  description="Live world population and the story behind the numbers for every country: population, time, economy and rankings, with every figure sourced."
>
  <section class="hero">
    <h1>Every country, told on its own terms.</h1>
    <p class="intro">There are about <strong>{billions(w.population)} people</strong> on Earth in {CURRENT_YEAR}, and the UN expects about {millions(w.change)} more this year. AtlasFigures gives every country its own page, written around what makes its figures different, with every number sourced.</p>
    <LiveCounter
      label="People on Earth right now"
      anchorValue={w.population}
      anchorDate={`${CURRENT_YEAR}-07-01`}
      perYear={w.change}
      note={`UN World Population Prospects 2024: figure for 1 July ${CURRENT_YEAR} plus about ${int(w.change / 365)} people a day`}
    />
  </section>

  <h2>Explore</h2>
  <div class="section-grid swipe">
    {tiles.map((t) => (
      <a class="tile" href={path(`/${t.key}/`)}>
        <span class="ico"><Icon name={t.key} /></span>
        <h3>{t.title}</h3>
        <p>{t.text}</p>
        <span class={t.live ? 'state on' : 'state'}>{t.live ? 'Open now' : 'Coming soon'}</span>
      </a>
    ))}
  </div>

  <h2>Featured country</h2>
  <a class="feature" href={path('/population/bangladesh/')}>
    <div class="body">
      <h3>Bangladesh</h3>
      <div class="big num">{millions(bdNow.population)}</div>
      <p>The most densely populated country of more than 10 million people, and how it went from almost seven births per woman to about two.</p>
    </div>
    <div class="side"><Contours /></div>
  </a>
</Base>
