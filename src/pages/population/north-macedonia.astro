---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import mkd from '../../data/countries/north-macedonia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peak 2005 (2.09 million); falls 1991–1994
// and in every year from 2006 to 2100; net departures every year from 1982 through 2100, the most in 1993; births
// from a 1954 high to the fewest of the series in 2026; life expectancy dip to 73.3 in 2021; natural decrease every
// year from 2020; urban majority since 1974; fertility under 2.1 since 1996.
const PAGE = '/population/north-macedonia/';
const un = countryData(mkd.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (mkd.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2005, 'peak 2005');
assertClaim(un.years.filter((r) => r.year >= 1991 && r.year <= 1994).every((r) => r.population < y[r.year - 1].population) && un.years.filter((r) => r.year >= 2006).every((r) => r.population < y[r.year - 1].population), 'falls 1991–1994 and from 2006');
assertClaim(un.years.filter((r) => r.year >= 1982).every((r) => r.netMigrants < 0) && y[1981].netMigrants >= 0, 'net departures from 1982');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1993, 'largest outflow 1993');
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(bTop.year === 1954 && bLow.year === CURRENT_YEAR, 'births 1954 to now');
assertClaim(y[2021].lifeExpectancy < 74 && y[2019].lifeExpectancy > 76 && y[2022].lifeExpectancy > 76, '2021 lifespan dip');
assertClaim(un.years.filter((r) => r.year >= 2020).every((r) => r.naturalChange < 0) && y[2019].naturalChange >= 0, 'natural decrease from 2020');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1974 && un.years.filter((r) => r.year >= 1996).every((r) => r.fertility < 2.1), 'urban 1974, fertility under 2.1 from 1996');

const title = `North Macedonia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Peak in 2005, Lower in Every Year Since | AtlasFigures`;
const description = `For ${CURRENT_YEAR} the UN gives North Macedonia ${millions(c.population)}, shy of its 2005 high (${millions(peak.population)}) and lower with each passing year. Emigrants have outnumbered immigrants annually from 1982, and ${CURRENT_YEAR} is the year with the smallest birth cohort on record.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: mkd.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, mkd.tableYears);

const faq = [
  { q: "Which year marks North Macedonia's highest headcount?", a: `2005, with ${millions(peak.population)}. From 2006 every year comes in lower, through 2100 in the projection.` },
  { q: 'How long has North Macedonia been losing people through migration?', a: `Without interruption since 1982, and UN assumptions extend it to 2100. Peak net loss: ${int(-outTop.netMigrants)}, in 1993. Motives go unlisted in the UN files.` },
  { q: 'Are births in North Macedonia at a record low?', a: `Yes; roughly ${int(c.births)} for ${CURRENT_YEAR}, smallest since 1950, whereas 1954 had ${int(bTop.births)}.` },
  { q: 'Did life expectancy in North Macedonia drop recently?', a: `Yes, from ${dec(y[2019].lifeExpectancy, 1)} in 2019 down to ${dec(y[2021].lifeExpectancy, 1)} by 2021; 2022 was back at ${dec(y[2022].lifeExpectancy, 1)}. No explanation accompanies the series.` },
  { q: "What size will North Macedonia shrink to by 2100?", a: `About ${int(Math.round(y[2100].population / 1e3))} thousand on the UN medium path, slightly less than half the present number.` },
];

const schema = countrySchema({
  page: PAGE, slug: mkd.slug, name: mkd.name, wikipedia: mkd.wikipedia,
  headline: `North Macedonia's ${millions(c.population)}: a 2005 peak; decline every year since; net emigration every year from 1982`,
  description,
  datasetName: 'North Macedonia population, net migration and births, 1950–2100',
  datasetDescription: `Mid-year population of North Macedonia for selected years from 1950 to ${CURRENT_YEAR}, including 1954, 1981–1982, 1991, 1993–1994, 2005–2006 and 2019–2022, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: mkd.published, updated: mkd.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="North Macedonia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "North Macedonia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>North Macedonia: a 2005 high, then year after year of decline</h1>
        <LiveCounter
          label="North Macedonia: estimated residents now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Steps forward from UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), shedding roughly ${int(-c.change / 365)} daily`}
        />
        <p class="answer">
          UN reckoning has North Macedonia on <strong>{millions(c.population)}</strong> this year ({CURRENT_YEAR}), down from <strong>{millions(peak.population)}</strong> in 2005, with each year since lower than its predecessor.
        </p>
        <div class="dates"><span>Updated <time datetime={mkd.updated}>{longDate(mkd.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="North Macedonia" code="mk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>When were there most people in North Macedonia?</h2>
          <p>2005, with {millions(peak.population)}. Each later year comes in under the previous one, and the UN carries that pattern all the way to 2100, which closes on {int(Math.round(y[2100].population / 1e3))} thousand. A briefer contraction had already occurred over 1991–1994.</p>
        </div>
        <LineChart
          title="North Macedonia, 1950–2100: high point 2005"
          subtitle="Mid-year count; dashes show what the UN projects."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has North Macedonia lost people to migration every year?</h2>
          <p>Yes, from 1982 onward in net terms. The heaviest single year, 1993, lost {int(-outTop.netMigrants)}; the {CURRENT_YEAR} estimate is {int(-c.netMigrants)}. The tables stop at counts.</p>
        </div>

        <div class="story-block prose">
          <h2>How have births and lifespans changed in North Macedonia?</h2>
          <p>Yearly births were highest in 1954 ({int(bTop.births)}) and bottom out now, {int(c.births)}. The fertility rate has sat beneath 2.1 since 1996; today's rate is {dec(c.fertility, 2)}. Since 2020 the death toll has exceeded births every year. Lifespans dipped between 2019 ({dec(y[2019].lifeExpectancy, 1)}) and 2021 ({dec(y[2021].lifeExpectancy, 1)}) before recovering to {dec(c.lifeExpectancy, 1)}. Urban areas have housed a majority since 1974.</p>
        </div>
        <RelatedPages iso3={mkd.iso3} name={mkd.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="North Macedonia rows for 1954, 1981–1982, 1991–1994, 2005–2006"
          subtitle="The 2005 row is the highest; migration minus signs start in 1982."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${mkd.slug}-population.csv`)}
          csvName={`${mkd.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">North Macedonia: answers from the UN series</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{mkd.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={mkd.published}>{longDate(mkd.published)}</time> · Updated <time datetime={mkd.updated}>{longDate(mkd.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("North Macedonia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="North Macedonia" code="mk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
