---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import irl from '../../data/countries/ireland.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: falls every year 1953–1961
// and 1987–1989, with the 1950 total regained only in 1968; net outflow largest in 1953; net inflows peaking in 2006
// and 2022; fastest growth since 2000 in Northern Europe; fertility fifth-highest in Europe; deaths above births only
// from 2051; a 2053 peak.
const PAGE = '/population/ireland/';
const un = countryData(irl.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (irl.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1953,1954,1955,1956,1957,1958,1959,1960,1961,1987,1988,1989', 'falls 1953–1961 and 1987–1989');
const back = un.years.find((r) => r.year > 1961 && r.population > y[1950].population)!.year;
assertClaim(back === 1968, '1950 level regained in 1968');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 1953 && inTop.year === 2006 && y[2022].netMigrants > 9e4, 'largest outflow 1953, inflow 2006, 2022 above 90,000');
const ne1 = wpp.filter((d: any) => d.subregion === 'Northern Europe' && at(d).population >= 1e6);
assertClaim([...ne1].sort((a: any, b: any) => at(b).population / at(b, 2000).population - at(a).population / at(a, 2000).population)[0].iso3 === 'IRL', 'fastest growth since 2000 in Northern Europe');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3).indexOf('IRL') === 4, 'fifth-highest fertility in Europe');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2051, 'deaths above births from 2051');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2053, 'peak 2053');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2009, 'births peak 2009');

const title = `Ireland Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Nine Lean Years in the 1950s, Then Northern Europe's Quickest Climb | AtlasFigures`;
const description = `UN figures show Ireland's count slipping in each year from 1953 to 1961 and only regaining its 1950 level in 1968. Since 2000 no Northern European country has grown faster; the ${CURRENT_YEAR} total is ${millions(c.population)}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: irl.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, irl.tableYears);

const faq = [
  { q: 'Was Ireland shrinking in the 1950s?', a: `Yes. Each July total between 1953 and 1961 came in below its predecessor, and 1953 had the series' biggest net outflow, ${int(-outTop.netMigrants)}. The 1950 level returned only in 1968.` },
  { q: 'Which Northern European country has grown most since 2000?', a: `Ireland, up by roughly two fifths, which takes ${millions(y[2000].population)} in 2000 to today's ${millions(c.population)}.` },
  { q: 'In which year did Ireland gain the most through migration?', a: `2006, at ${int(inTop.netMigrants)} net; 2022 nearly matched it with ${int(y[2022].netMigrants)}.` },
  { q: 'Will Irish deaths ever outnumber births?', a: `Only from 2051, per the UN projection. For ${CURRENT_YEAR}: ${int(c.births)} births, ${int(c.deaths)} deaths.` },
  { q: "What is the highest Ireland's population will reach?", a: `${millions(peak.population)}, in ${peak.year}; by 2100 the figure eases to ${millions(y[2100].population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: irl.slug, name: irl.name, wikipedia: irl.wikipedia,
  headline: `Ireland's ${millions(c.population)}: nine years of decline from 1953; a late-1980s setback; Northern Europe's quickest growth since 2000`,
  description,
  datasetName: 'Ireland population, net migration and births, 1950–2100',
  datasetDescription: `Mid-year population of Ireland for selected years from 1950 to ${CURRENT_YEAR}, including 1953, 1961, 1968, 1986–1990, 2006, 2009 and 2022, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: irl.published, updated: irl.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Ireland"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Ireland", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Ireland: from a shrinking 1950s to rapid growth</h1>
        <LiveCounter
          label="Ireland: estimated population, ticking up"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Anchored on UN World Population Prospects 2024 (mid-${CURRENT_YEAR}); roughly ${int(c.change / 365)} added a day`}
        />
        <p class="answer">
          Ireland's {CURRENT_YEAR} count stands at <strong>{millions(c.population)}</strong> in UN figures, against <strong>{millions(y[1950].population)}</strong> in 1950. Between the two: nine lean years in the 1950s, a setback in the late 1980s, then a fast climb.
        </p>
        <div class="dates"><span>Updated <time datetime={irl.updated}>{longDate(irl.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Ireland" code="ie" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why was Ireland smaller in 1961 than in 1950?</h2>
          <p>Departures outweighed arrivals. The 1953 net outflow alone was {int(-outTop.netMigrants)}, and the count dropped year after year until 1961, reaching {millions(y[1961].population)}. Not until 1968 did Ireland top its 1950 figure again. Another loss came in 1987–1989; 1988 alone saw {int(-y[1988].netMigrants)} more leave than arrive. The UN files hold no explanation.</p>
        </div>
        <LineChart
          title="Irish net migration, 1950–2100"
          subtitle="Negative for most of 1950–1990, then large positive spikes; projection dashed."
          points={rows.map((r) => ({ x: r.year, y: r.netMigrants, projection: r.projection }))}
          format="plain"
          unit="people"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How quickly has Ireland grown this century?</h2>
          <p>By about two fifths since 2000, when the count was {millions(y[2000].population)}, quicker than anywhere else in Northern Europe. Net migration added {int(inTop.netMigrants)} in 2006 and {int(y[2022].netMigrants)} in 2022; {birthTop.year} brought the most Irish births of any year, {int(birthTop.births)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Ireland younger than most of Europe?</h2>
          <p>Somewhat: with {dec(c.fertility, 2)} births per woman it ranks fifth in Europe for fertility (states over a million people), and half of the Irish are under {dec(c.medianAge, 1)}. Births stay ahead of deaths until 2051; the projection crests at {millions(peak.population)} ({peak.year}) and leaves {millions(y[2100].population)} for 2100.</p>
        </div>
        <RelatedPages iso3={irl.iso3} name={irl.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Irish rows from 1953 to 2053, including 1968 and 2006"
          subtitle="The 1950s rows fall year after year; 1968 is back above 1950."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${irl.slug}-population.csv`)}
          csvName={`${irl.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Ireland: what people look up</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{irl.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={irl.published}>{longDate(irl.published)}</time> · Updated <time datetime={irl.updated}>{longDate(irl.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Ireland population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Ireland" code="ie" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
