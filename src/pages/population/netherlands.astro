---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import nl from '../../data/countries/netherlands.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: Europe's most crowded large country, growing almost only through migration, peaking around 2041.
const PAGE = '/population/netherlands/';
const un = countryData(nl.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (nl.verification as any).checkedOn as string | undefined;
const HAGUE_URL = 'https://www.britannica.com/place/The-Hague';

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const denseEu = wpp.filter((d: any) => d.region === 'Europe' && at(d).population > 10e6).sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).map((d: any) => d.iso3);
assertClaim(denseEu[0] === 'NLD', 'densest European country with over 10 million people');
const denseW = wpp.filter((d: any) => at(d).population > 10e6).sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).map((d: any) => d.iso3);
assertClaim(denseW.indexOf('NLD') === 4, 'fifth-densest of all countries or areas over 10 million');
const migShare = c.netMigrants / c.change;
assertClaim(migShare > 0.9 && migShare < 1 && c.naturalChange > 0, 'more than nine-tenths of growth from net migration');
const est = un.years.filter((r) => !r.projection);
const migTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(migTop.year === 2022 && migTop.netMigrants > 200e3, 'record net migration in 2022, over 200 thousand');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2041 && natLoss === 2030, 'deaths above births from 2030, peak in 2041');
const pass18 = un.years.find((r) => r.population >= 18e6)!.year;
assertClaim(pass18 === 2023, 'passed 18 million in 2023');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrMax.year === 1961 && c.fertility < tfrMax.fertility / 2, 'fertility less than half its 1961 high');
const urbW = wpp.filter((d: any) => at(d).population > 10e6 && at(d).urbanPct != null).sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct).map((d: any) => d.iso3);
assertClaim(urbW.indexOf('NLD') < 10 && c.urbanPct! > 95, 'urban share above 95%, among the ten highest of countries over 10 million');
const west = wpp.filter((d: any) => d.subregion === 'Western Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(west.slice(0, 3).join(',') === 'DEU,FRA,NLD' && un.subregion === 'Western Europe', 'third in Western Europe after Germany and France');
assertClaim(pass18 === migTop.year + 1, '18 million the year after the migration record');
assertClaim(y[2100].population > c.population * 0.94 && y[2100].population < c.population, '2100 slightly below today (less than 6% down)');

const title = `Netherlands Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million on ${int(un.landAreaKm2)} km² of Land | AtlasFigures`;
const description = `The Netherlands packs ${millions(c.population)} people (mid-${CURRENT_YEAR}) into Europe's densest large country, ${int(c.densityPerKm2)} per km². Migration drives growth to a projected ${peak.year} peak.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: nl.capital, note: 'seat of government: The Hague' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, nl.tableYears);

const faq = [
  { q: 'How many people does the Netherlands count today?', a: `By the UN's reckoning, ${millions(c.population)} in the middle of ${CURRENT_YEAR}, ${ord(c.worldRank!)} in the world. The Netherlands crossed 18 million in ${pass18}.` },
  { q: 'Is the Netherlands the most densely populated country in Europe?', a: `Of Europe's countries above 10 million inhabitants, yes: ${int(c.densityPerKm2)} for each km². Worldwide it is fifth in that size group.` },
  { q: 'Is the Dutch population still rising?', a: `Yes, by ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, and more than nine-tenths of that gain is net migration. The UN projects growth to continue until ${peak.year}.` },
  { q: 'How high will the Netherlands\' population go?', a: `About ${millions(peak.population)} at its projected ${peak.year} high, after which deaths outweigh births and the total eases to ${millions(y[2100].population)} by 2100.` },
  { q: 'Is The Hague or Amsterdam the Dutch capital?', a: `Amsterdam is the official capital; The Hague is the seat of government and the courts (Encyclopaedia Britannica).` },
];

const schema = countrySchema({
  page: PAGE, slug: nl.slug, name: nl.name, wikipedia: nl.wikipedia,
  headline: `The Netherlands in ${CURRENT_YEAR}: ${millions(c.population)} people at ${int(c.densityPerKm2)} per km²`,
  description,
  datasetName: 'Netherlands population, density, migration, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of the Netherlands for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: nl.published, updated: nl.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'The Hague', url: HAGUE_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Netherlands"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Netherlands', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>The Netherlands: Europe's most crowded large country</h1>
        <LiveCounter
          label="Netherlands: estimated population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} base, up by roughly ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Some <strong>{millions(c.population)}</strong> people make the Netherlands their home in mid-{CURRENT_YEAR}, squeezed onto just {int(un.landAreaKm2)} km² of land: <strong>{int(c.densityPerKm2)} per km²</strong>, a density unmatched by any other European state with a population in eight figures. Nearly all of this year's growth comes from migration.
        </p>
        <div class="dates"><span>Updated <time datetime={nl.updated}>{longDate(nl.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Netherlands" code="nl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How densely populated is the Netherlands?</h2>
          <p>Very: every square kilometre of Dutch land holds {int(c.densityPerKm2)} residents on average in {CURRENT_YEAR}, against {int(y[1950].densityPerKm2)} in 1950. Nowhere else in Europe with a population in eight figures comes close, and only four countries or areas of that scale anywhere are denser. Under the Dutch national definition {pct(c.urbanPct!)} of residents are urban, a top-ten share in that same 10-million-plus group.</p>
        </div>
        <LineChart
          title="Dutch population, 1950–2100: still climbing, levelling off in the 2040s"
          subtitle="Dutch totals from the UN by mid-year; the projection, dashed, peaks in 2041 then drifts lower."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What is driving Dutch population growth?</h2>
          <p>Mainly migration. Of the {int(Math.round(c.change / 1000))} thousand added in {CURRENT_YEAR}, net arrivals account for about {int(Math.round(c.netMigrants / 1000))} thousand; births only just exceed deaths. Net migration hit its highest level in {migTop.year}, about {int(Math.round(migTop.netMigrants / 1000))} thousand, and the Netherlands passed 18 million the following year.</p>
        </div>

        <div class="story-block prose">
          <h2>When will the Netherlands' population stop growing?</h2>
          <p>Around {peak.year}, when the medium variant tops out near {millions(peak.population)}. The natural balance is expected to turn negative in {natLoss}, and from the 2040s smaller migration gains no longer fill the gap. By 2100 the total is {millions(y[2100].population)}, only a few percent below today.</p>
        </div>

        <div class="story-block prose">
          <h2>How has Dutch fertility changed since the 1960s?</h2>
          <p>It has halved and then some. Dutch women averaged {dec(tfrMax.fertility, 2)} births in {tfrMax.year}; in {CURRENT_YEAR} the rate is {dec(c.fertility, 2)}. Newborn Dutch can now look forward to {dec(c.lifeExpectancy, 1)} years, and half the population is over {dec(c.medianAge, 1)}.</p>
        </div>
        <LineChart
          title="Births per woman in the Netherlands, 1950–2050"
          subtitle="UN estimates and medium projection (dashed), measured against the 2.1 line."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 births' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <div class="age-row" role="group" aria-label="People per km² in the Netherlands">
          <div><span class="y">1950</span><div class="v">{int(y[1950].densityPerKm2)}</div><span class="d">People per km²</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.densityPerKm2)}</div><span class="d">Densest large European country</span></div>
          <div><span class="y">{peak.year}, UN projection</span><div class="v">{int(peak.densityPerKm2)}</div><span class="d">At the peak</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is Amsterdam or The Hague the capital of the Netherlands?</h2>
          <p>Amsterdam is the official capital, while The Hague is home to the government and the courts, as <a href={HAGUE_URL}>Encyclopaedia Britannica</a> notes. The UN files the country simply as the Netherlands, in Western Europe, where only Germany and France have more people.</p>
        </div>
        <RelatedPages iso3={nl.iso3} name={nl.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Dutch population and indicators across 150 years"
          subtitle="Each row a UN mid-year value; the shaded band from 2030 is projected."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${nl.slug}-population.csv`)}
          csvName={`${nl.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">The Dutch population in brief</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{nl.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={HAGUE_URL}>Encyclopaedia Britannica, "The Hague"</a>: The Hague as seat of government, Amsterdam as official capital.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={nl.published}>{longDate(nl.published)}</time> · Updated <time datetime={nl.updated}>{longDate(nl.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Netherlands population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Netherlands" code="nl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
