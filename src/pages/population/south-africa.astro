---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import za from '../../data/countries/south-africa.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: nearly nine in ten of Southern Africa's people, a deep dip and recovery in life expectancy, net immigration that keeps growth going to 2100.
const PAGE = '/population/south-africa/';
const un = countryData(za.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (za.verification as any).checkedOn as string | undefined;
const PTA_URL = 'https://www.britannica.com/place/Pretoria';

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const south = wpp.filter((d: any) => d.subregion === 'Southern Africa');
const share = (c.population / south.reduce((s: number, d: any) => s + at(d).population, 0)) * 100;
assertClaim(share > 85 && share < 90, 'almost nine in ten people in Southern Africa');
const inflow = wpp.filter((d: any) => d.region === 'Africa').sort((a: any, b: any) => at(b).netMigrants - at(a).netMigrants).map((d: any) => d.iso3);
assertClaim(inflow[0] === 'SDN' && inflow[1] === 'ZAF', 'second-largest net inflow in Africa after Sudan');
const leLow = un.years.filter((r) => r.year >= 1990 && r.year <= 2023).reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 2005 && y[1990].lifeExpectancy - leLow.lifeExpectancy > 8 && c.lifeExpectancy > y[1990].lifeExpectancy, 'life expectancy fell by more than 8 years from 1990 to a 2005 low, now above 1990');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(below === 2031 && tfrMax.year === 1958 && c.fertility > 2.1, 'fertility peak 1958; just above 2.1 now, below from 2031');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100 && y[2100].netMigrants > 10 * y[2100].naturalChange && y[2100].naturalChange > 0, 'still growing in 2100, mostly through migration');
const est = un.years.filter((r) => !r.projection);
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2008, 'births peaked in 2008');
const times = c.population / y[1950].population;
assertClaim(times > 4.9 && times < 5.1, 'about five times 1950');

assertClaim(un.years.filter((r) => r.year >= 2030).every((r) => r.netMigrants > 0) && c.naturalChange > c.netMigrants, 'net migration positive every year from 2030; births add more than migration now');
const title = `South Africa Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Still Drawing Migrants | AtlasFigures`;
const description = `Almost nine in ten residents of Southern Africa live in South Africa, home to ${millions(c.population)} at mid-${CURRENT_YEAR}. UN data on its migration, the fall and recovery of life expectancy, and growth to 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: za.capital, note: 'administrative capital' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Net migration', value: `+${int(c.netMigrants)}` },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, za.tableYears);

const faq = [
  { q: "What is South Africa's population count this year?", a: `Mid-${CURRENT_YEAR} UN data show ${millions(c.population)}, the world's ${ord(c.worldRank!)}-largest total and by far the biggest in Southern Africa.` },
  { q: 'Is South Africa gaining people through migration?', a: `Yes, in the UN figures: a net gain of about ${int(Math.round(c.netMigrants / 1000))} thousand in ${CURRENT_YEAR}. Among African countries only Sudan has a larger net inflow this year.` },
  { q: 'Did South African life expectancy fall and recover?', a: `Yes. The UN series records the drop, without explaining it, from ${dec(y[1990].lifeExpectancy, 1)} years in 1990 to ${dec(leLow.lifeExpectancy, 1)} in ${leLow.year}. It has since recovered to ${dec(c.lifeExpectancy, 1)}.` },
  { q: 'Is South Africa\'s birth rate at replacement level?', a: `Just above it: the ${CURRENT_YEAR} rate is ${dec(c.fertility, 2)}; the medium projection takes it below 2.1 from ${below}.` },
  { q: 'Which city is the capital of South Africa?', a: `Pretoria is the administrative capital, according to Encyclopaedia Britannica.` },
];

const schema = countrySchema({
  page: PAGE, slug: za.slug, name: za.name, wikipedia: za.wikipedia,
  headline: `South Africa's ${millions(c.population)}: migration, life expectancy and growth to 2100`,
  description,
  datasetName: 'South Africa population, migration, life expectancy, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of South Africa for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: za.published, updated: za.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Pretoria', url: PTA_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="South Africa"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'South Africa', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>South Africa: the population giant of Southern Africa</h1>
        <LiveCounter
          label="South Africa: population estimate, live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} base figure, increasing by close to ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          South Africa's population stood at roughly <strong>{millions(c.population)}</strong> by mid-{CURRENT_YEAR}, ranking {ord(c.worldRank!)} globally and accounting for <strong>almost nine in ten</strong> of everyone in Southern Africa. It still grows, by {pct(c.growthRatePct)}, helped by a net inflow of migrants.
        </p>
        <div class="dates"><span>Updated <time datetime={za.updated}>{longDate(za.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="South Africa" code="za" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is South Africa a country of immigration?</h2>
          <p>In net terms, yes. The UN estimates about {int(Math.round(c.netMigrants / 1000))} thousand more arrivals than departures in {CURRENT_YEAR}, the second-highest net inflow in Africa after Sudan. Births still add more, roughly {int(Math.round(c.naturalChange / 1000))} thousand above deaths, but by 2100 the projection has migration supplying most of the growth, as the natural surplus shrinks to about {int(Math.round(y[2100].naturalChange / 1000))} thousand.</p>
        </div>
        <LineChart
          title="South Africa's population, 1950–2100: slowing but never falling"
          subtitle="UN mid-year totals; the medium projection (dashed) is still edging up at about 94 million in 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How did life expectancy in South Africa change after 1990?</h2>
          <p>It fell sharply and then recovered. From {dec(y[1990].lifeExpectancy, 1)} years in 1990, the UN estimate dropped to {dec(leLow.lifeExpectancy, 1)} by {leLow.year}, more than eight years lower; it has since climbed back to {dec(c.lifeExpectancy, 1)}. The data record this path without giving its causes.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy in South Africa">
          <div><span class="y">1990</span><div class="v">{dec(y[1990].lifeExpectancy, 1)}</div><span class="d">Life expectancy</span></div>
          <div><span class="y">{leLow.year}</span><div class="v">{dec(leLow.lifeExpectancy, 1)}</div><span class="d">Low point</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Recovered</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is South Africa's fertility close to replacement?</h2>
          <p>Very close. South African women average {dec(c.fertility, 2)} children, compared with {dec(tfrMax.fertility, 2)} at the {tfrMax.year} high, and the rate is projected to dip below 2.1 from {below}. Births topped out at about {millions(birthTop.births)} in {birthTop.year}.</p>
        </div>
        <LineChart
          title="South African fertility, 1950 to 2050: down to the 2.1 line"
          subtitle="Average births per woman per the UN; projections in dashes, with 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How large does South Africa grow by 2100?</h2>
          <p>Around {millions(y[2100].population)}, on the medium path, and still slowly rising in 2100; today's total is already about five times the 1950 figure of {millions(y[1950].population)}. Its world rank barely moves: {ord(y[2050].worldRank!)} in 2050, {ord(y[2100].worldRank!)} in 2100. The national urban definition covers {pct(c.urbanPct!)} of South Africans, and Pretoria is the administrative capital (<a href={PTA_URL}>Encyclopaedia Britannica</a>).</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="South Africa's demographic record, 1950–2100"
          subtitle="Net migration stays positive in every projected row from 2030 to 2100."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${za.slug}-population.csv`)}
          csvName={`${za.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">South Africa's population: questions people raise</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{za.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={PTA_URL}>Encyclopaedia Britannica, "Pretoria"</a>: administrative capital.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={za.published}>{longDate(za.published)}</time> · Updated <time datetime={za.updated}>{longDate(za.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('South Africa population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="South Africa" code="za" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
