---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import eri from '../../data/countries/eritrea.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only (no causes): the 1991 net
// outflow (largest, about 16% of the 1990 total) and falls in 1991–1992; the 1995 net inflow; life-expectancy lows in
// 1957 and 1999; urban share still under half in 2050; growth to 2100; fertility under 2.1 only in 2080.
const PAGE = '/population/eritrea/';
const un = countryData(eri.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (eri.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const share = -outTop.netMigrants / y[1990].population;
assertClaim(outTop.year === 1991 && share > 0.15 && share < 0.17, '1991 outflow about 16% of 1990 total');
const falls = un.years.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1991,1992', 'falls 1991–1992 only');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1995, 'largest inflow 1995');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1957 && y[1999].lifeExpectancy < y[1997].lifeExpectancy - 10, 'low 1957; 1999 dip over 10 years');
assertClaim(un.years.filter((r) => r.urbanPct != null).every((r) => r.urbanPct! < 50), 'urban share under half through 2050');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(peak.year === 2100 && repl === 2080, 'growing in 2100; under 2.1 in 2080');
const since = c.population / y[1950].population;
assertClaim(since > 4.4 && since < 4.6, 'about 4.5 times 1950');

const title = `Eritrea Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Sixth of the People Gone in 1991, Arrivals in 1995, Still Largely Rural | AtlasFigures`;
const description = `Mid-${CURRENT_YEAR} UN reckoning: Eritrea, ${millions(c.population)}. In 1991 departures exceeded arrivals by ${int(-outTop.netMigrants)} (roughly one person in six); 1995 brought the largest inflow. The files record movement, not motive.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: eri.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, eri.tableYears);

const faq = [
  { q: 'What share of Eritreans left in 1991?', a: `About 16%, on the UN's net figure of ${int(-outTop.netMigrants)} against the 1990 population. The count dropped in 1991 and 1992; why is not stated.` },
  { q: 'When did people move into Eritrea?', a: `Chiefly 1995, whose ${int(inTop.netMigrants)} net arrivals top the series.` },
  { q: 'Do most Eritreans live in the countryside?', a: `Yes: urban areas hold ${pct(c.urbanPct!)}, and even the 2050 projection keeps them a minority.` },
  { q: 'What do the UN life-expectancy figures show for Eritrea?', a: `A trough of ${dec(y[1957].lifeExpectancy, 1)} years in 1957 and a slump to ${dec(y[1999].lifeExpectancy, 1)} in 1999; ${dec(c.lifeExpectancy, 1)} today.` },
  { q: 'Eritrea in 2100: how many people?', a: `${millions(y[2100].population)}, with growth continuing; women average more than 2.1 children until ${repl}.` },
];

const schema = countrySchema({
  page: PAGE, slug: eri.slug, name: eri.name, wikipedia: eri.wikipedia,
  headline: `Eritrea's ${millions(c.population)}: a 1991 outflow of a sixth of the population; a 1995 inflow; growth to 2100`,
  description,
  datasetName: 'Eritrea population, net migration and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Eritrea for selected years from 1950 to ${CURRENT_YEAR}, including 1957, 1990–1993, 1995 and 1998–1999, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: eri.published, updated: eri.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Eritrea"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Eritrea", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Eritrea: big swings in the 1990s, steady growth since</h1>
        <LiveCounter
          label="Eritrea: population estimate, live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Calculated from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} level; roughly ${int(c.change / 365)} more daily`}
        />
        <p class="answer">
          Eritrea's {CURRENT_YEAR} count, <strong>{millions(c.population)}</strong> in UN estimates, is some 4.5-fold its 1950 level. Towns house just <strong>{pct(c.urbanPct!)}</strong> of the people.
        </p>
        <div class="dates"><span>Updated <time datetime={eri.updated}>{longDate(eri.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Eritrea" code="er" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How big was the 1991 outflow from Eritrea?</h2>
          <p>{int(-outTop.netMigrants)} net, around 16% of the {millions(y[1990].population)} estimated for 1990. 1991 and 1992 are the sole years whose July totals dip. Then the direction flipped: 1995 logged {int(inTop.netMigrants)} net arrivals. Beyond these counts the UN data say nothing of motives.</p>
        </div>
        <div class="age-row" role="group" aria-label="Eritrea net migration in 1991, 1993 and 1995 (UN)">
          <div><span class="y">1991</span><div class="v">{int(-y[1991].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">1993</span><div class="v">{int(y[1993].netMigrants)}</div><span class="d">Net arrivals</span></div>
          <div><span class="y">1995</span><div class="v">{int(y[1995].netMigrants)}</div><span class="d">Net arrivals</span></div>
        </div>

        <div class="story-block prose">
          <h2>What do the UN lifespan estimates show for Eritrea?</h2>
          <p>Two troughs: {dec(y[1957].lifeExpectancy, 1)} years in 1957, the series minimum, and {dec(y[1999].lifeExpectancy, 1)} in 1999, having been {dec(y[1997].lifeExpectancy, 1)} in 1997. Today: {dec(c.lifeExpectancy, 1)}. Causes are not supplied.</p>
        </div>
        <LineChart
          title="Eritrean life expectancy, 1950–2050"
          subtitle="Includes the 1957 low and the 1998–1999 dip; projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will most Eritreans ever live in towns?</h2>
          <p>Not by 2050 on current projections. Urban residents made up {pct(y[1950].urbanPct!)} in 1950, {pct(c.urbanPct!)} now and are expected at {pct(y[2050].urbanPct!)} for 2050.</p>
        </div>

        <div class="story-block prose">
          <h2>How much will Eritrea grow?</h2>
          <p>Steadily: {millions(y[2050].population)} around 2050, {millions(y[2100].population)} at the close of the projection, with no peak in between. The median Eritrean is {dec(c.medianAge, 1)}; the fertility rate, {dec(c.fertility, 2)}, drops under 2.1 in {repl}.</p>
        </div>
        <RelatedPages iso3={eri.iso3} name={eri.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Eritrea, 1957, 1990–1995, 1998–1999 and the decades"
          subtitle="Read 1991 for the deepest outflow and 1995 for the strongest inflow."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${eri.slug}-population.csv`)}
          csvName={`${eri.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Eritrea: questions on the figures</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{eri.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={eri.published}>{longDate(eri.published)}</time> · Updated <time datetime={eri.updated}>{longDate(eri.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Eritrea population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Eritrea" code="er" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
