---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import mm from '../../data/countries/myanmar.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fertility just under replacement, steady net emigration, the shortest lives in South-Eastern Asia, a peak around 2049. Neutral, data only.
const PAGE = '/population/myanmar/';
const un = countryData(mm.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (mm.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 2024 && c.fertility < 2.1 && c.fertility > 2.0, 'fertility slipped just under 2.1 in 2024');
assertClaim(un.years.filter((r) => r.year >= 1990).every((r) => r.netMigrants < 0), 'net outflow every year since 1990, projections included');
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia');
const le = sea.slice().sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(le[0] === 'MMR', 'shortest life expectancy in South-Eastern Asia');
const urb = sea.filter((d: any) => at(d).urbanPct != null).sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3);
assertClaim(urb[0] === 'TLS' && urb[1] === 'MMR', 'second-lowest urban share in South-Eastern Asia, after Timor-Leste');
const big = sea.slice().sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(big.indexOf('MMR') === 4, 'fifth in South-Eastern Asia');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2049 && natLoss === 2054, 'peak 2049, natural loss from 2054');
const est = un.years.filter((r) => !r.projection);
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1984 && birthTop.births > 1.1e6, 'births peaked above 1.1 million in 1984');
const outTop = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2006, 'largest net outflow in 2006');
const times = c.population / y[1950].population;
assertClaim(times > 3 && times < 3.2, 'about three times 1950');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrMax.year === 1950, 'fertility highest in 1950');

const title = `Myanmar's Population in ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Nearing Its Peak | AtlasFigures`;
const description = `Myanmar's ${millions(c.population)} people (mid-${CURRENT_YEAR}) have fertility just below 2.1, and more leave than arrive each year. UN projections put the peak at ${millions(peak.population)} around ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: mm.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban share', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, mm.tableYears);

const faq = [
  { q: 'How many people does the UN count in Myanmar?', a: `${millions(c.population)} for mid-${CURRENT_YEAR}. That ranks it ${ord(c.worldRank!)} in the world and fifth in South-Eastern Asia.` },
  { q: 'Is Myanmar\'s fertility below replacement?', a: `Only just: ${dec(c.fertility, 2)} in ${CURRENT_YEAR}, having first gone under 2.1 in ${below}. In 1950 it was ${dec(y[1950].fertility, 2)}.` },
  { q: 'Does Myanmar lose people to emigration?', a: `In net terms, yes: each year from 1990 onward in the UN series; about ${int(Math.round(-c.netMigrants / 1000))} thousand in ${CURRENT_YEAR}. The largest net outflow, about ${int(Math.round(-outTop.netMigrants / 1000))} thousand, was in ${outTop.year}.` },
  { q: 'When will Myanmar\'s population start to fall?', a: `After ${peak.year}, its projected high of ${millions(peak.population)}. For 2100 the projection shows ${millions(y[2100].population)}.` },
  { q: 'What is life expectancy in Myanmar compared with its neighbours?', a: `${dec(c.lifeExpectancy, 1)} years, the lowest in South-Eastern Asia in the UN's ${CURRENT_YEAR} figures.` },
];

const schema = countrySchema({
  page: PAGE, slug: mm.slug, name: mm.name, wikipedia: mm.wikipedia,
  headline: `Myanmar's ${millions(c.population)}: fertility near 2.1 and a peak around ${peak.year}`,
  description,
  datasetName: 'Myanmar population, fertility, migration, life expectancy and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Myanmar for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: mm.published, updated: mm.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Myanmar"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Myanmar', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Myanmar's population approaches its high point</h1>
        <LiveCounter
          label="Myanmar: present-day population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} figure, rising about ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Myanmar counts about <strong>{millions(c.population)}</strong> people this year (mid-{CURRENT_YEAR} estimate), ranking {ord(c.worldRank!)} worldwide; growth has slowed to {pct(c.growthRatePct)}. Fertility is now <strong>just below 2.1</strong>, more people leave than arrive, and the population is projected to top out around {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={mm.updated}>{longDate(mm.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Myanmar" code="mm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has Myanmar's birth rate dropped below replacement?</h2>
          <p>Just, in the UN estimates: fertility slipped under 2.1 in {below} and is {dec(c.fertility, 2)} in {CURRENT_YEAR}, from {dec(y[1950].fertility, 2)} in 1950. Annual births reached their maximum, about {millions(birthTop.births)}, in {birthTop.year}; this year's figure is around {int(Math.round(c.births / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Myanmar fertility, 1950–2050: a steady slide to 2.1"
          subtitle="UN total fertility rate; the projected part is dashed, the 2.1 level drawn across."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 drawn' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How much does emigration reduce Myanmar's population?</h2>
          <p>Every year since 1990 the UN records more departures than arrivals; in {CURRENT_YEAR} the net loss is about {int(Math.round(-c.netMigrants / 1000))} thousand, against births exceeding deaths by {int(Math.round(c.naturalChange / 1000))} thousand. The biggest net outflow in the series came in {outTop.year}. The data give totals only, not reasons.</p>
        </div>

        <div class="story-block prose">
          <h2>How does life in Myanmar compare with the rest of South-East Asia?</h2>
          <p>Lives are shorter and fewer people are urban. A newborn's life expectancy, {dec(c.lifeExpectancy, 1)} years, is the lowest of any country in South-Eastern Asia as the UN defines it; the urban share by the national definition, {pct(c.urbanPct!)}, is second-lowest there after Timor-Leste. Back in 1950 a newborn's outlook was just {dec(y[1950].lifeExpectancy, 1)} years.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy in Myanmar">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Lowest in the region</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].lifeExpectancy, 1)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>When will Myanmar's population peak?</h2>
          <p>In {peak.year}, at about {millions(peak.population)}, under the medium variant; natural decrease follows from {natLoss}. By 2100 the projected population is {millions(y[2100].population)}, and Myanmar would slip from {ord(c.worldRank!)} to {ord(y[2100].worldRank!)} in the world. Today it has about three times its 1950 population of {millions(y[1950].population)} and is fifth in South-Eastern Asia.</p>
        </div>
        <LineChart
          title="Myanmar's population, 1950–2100: a mid-century plateau"
          subtitle="Mid-year totals per the UN; the dashed part flattens near 58.6 million around 2049."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={mm.iso3} name={mm.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Myanmar's population table, 1950 to 2100"
          subtitle="Net migration is negative in every row from 1990 onward."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${mm.slug}-population.csv`)}
          csvName={`${mm.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Myanmar's population: short Q&amp;A</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{mm.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and comparisons within the region.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={mm.published}>{longDate(mm.published)}</time> · Updated <time datetime={mm.updated}>{longDate(mm.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Myanmar population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Myanmar" code="mm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
