---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ph from '../../data/countries/philippines.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: one of the fastest recent falls in fertility.
const PAGE = '/population/philippines/';
const un = countryData(ph.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ph.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const falls = wpp.filter((d: any) => at(d).population > 50e6).map((d: any) => ({ iso3: d.iso3, f: at(d, 2010).fertility - at(d).fertility })).sort((a, b) => b.f - a.f);
const fallRank = falls.findIndex((x) => x.iso3 === 'PHL') + 1;
assertClaim(fallRank === 4 && falls.slice(0, fallRank).every((x) => x.iso3 === 'PHL' || ['UGA', 'NGA', 'ETH'].includes(x.iso3)), 'one of the four steepest fertility falls since 2010 among countries over 50 million; the others are in Africa');
const sub = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(sub === 2020 && un.years.filter((r) => r.year >= sub).every((r) => r.fertility < 2.1), 'below 2.1 from 2020');
const birthPeak = un.years.filter((r) => !r.projection).reduce((a, b) => (b.births > a.births ? b : a));
const est = un.years.filter((r) => !r.projection);
const outSince = est.map((r) => r.year).find((yr) => est.every((r) => r.year < yr || r.netMigrants < 0))!;
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(sea[0] === 'IDN' && sea[1] === 'PHL', 'second in South-East Asia after Indonesia');
const urbanFrom = un.years.find((r) => (r.urbanPct ?? 0) > 50)!.year;
const times = c.population / y[1950].population;
assertClaim(times > 6 && times < 6.5 && c.naturalChange > 5 * Math.abs(c.netMigrants), 'six-fold since 1950; natural gain far above the outflow');

const title = `Philippines Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million as Births Fall Fast | AtlasFigures`;
const description = `The Philippines has some ${millions(c.population)} people in ${CURRENT_YEAR}. Fertility has dropped from ${dec(y[2010].fertility, 2)} in 2010 to ${dec(c.fertility, 2)}, one of the steepest among large countries, with numbers topping ${millions(peak.population)} in ${peak.year} before falling.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ph.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
];

const rows = displayRows(un.years, ph.tableYears);

const faq = [
  { q: 'How many Filipinos are there in 2026?', a: `The UN's mid-year estimate for the Philippines is ${millions(c.population)}, ${ord(c.worldRank!)} among all countries and second in South-East Asia.` },
  { q: "Is the Philippines' birth rate falling?", a: `Sharply: from ${dec(y[2010].fertility, 2)} per woman in 2010 to ${dec(c.fertility, 2)} in ${CURRENT_YEAR}, and the annual number of births topped out in ${birthPeak.year}.` },
  { q: 'Do more Filipinos leave than arrive?', a: `They do. Departures have exceeded arrivals since ${outSince}, by about ${int(Math.round(Math.abs(c.netMigrants) / 1000))} thousand in ${CURRENT_YEAR}.` },
  { q: 'How large will the Philippines grow?', a: `To about ${millions(peak.population)} in ${peak.year}, the UN projects. After that the total declines, to ${millions(y[2100].population)} by 2100.` },
  { q: 'How dense is the Philippines?', a: `${int(c.densityPerKm2)} per km² in ${CURRENT_YEAR}, compared with ${int(y[1950].densityPerKm2)} in 1950.` },
];

const schema = countrySchema({
  page: PAGE, slug: ph.slug, name: ph.name, wikipedia: ph.wikipedia,
  headline: `Philippines population ${CURRENT_YEAR}: ${millions(c.population)} and a rapid drop in fertility`,
  description,
  datasetName: 'Philippines population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of the Philippines for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ph.published, updated: ph.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Philippines"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Philippines', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>The Philippines: population and a fast fall in births</h1>
        <LiveCounter
          label="Philippines, estimated population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level and about ${int(c.change / 365)} more people each day`}
        />
        <p class="answer">
          An estimated <strong>{millions(c.population)} people</strong> lived in the Philippines at mid-{CURRENT_YEAR}, the {ord(c.worldRank!)}-largest population of any country. In just sixteen years its fertility has dropped from {dec(y[2010].fertility, 2)} to <strong>{dec(c.fertility, 2)} children per woman</strong>, one of the sharpest declines of any large country.
        </p>
        <div class="dates"><span>Updated <time datetime={ph.updated}>{longDate(ph.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Philippines" code="ph" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How fast have births per woman fallen in the Philippines?</h2>
          <p>Remarkably fast. The UN's figure went from {dec(y[2010].fertility, 2)} in 2010 to {dec(y[2020].fertility, 2)} in 2020, crossing below 2.1 that year, and on to {dec(c.fertility, 2)} now. Just three nations above the 50 million mark, all African, have seen a bigger drop since 2010. In 1950 the average Filipino woman had {dec(y[1950].fertility, 2)} children.</p>
        </div>
        <LineChart
          title="Fertility in the Philippines: from 7 children to under 2"
          subtitle="UN total fertility rate, 1950–2050, with the steep fall after 2010. Projections dashed; line at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="children per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Line at 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why is the Philippine population still growing?</h2>
          <p>Because it is young. Half of all Filipinos are under {dec(c.medianAge, 1)}, so many people are in their child-bearing years even as each family has fewer children. This year's {millions(c.births)} births exceed {int(Math.round(c.deaths / 1000))} thousand deaths by {millions(c.naturalChange)}, with emigration trimming about {int(Math.round(Math.abs(c.netMigrants) / 1000))} thousand. More people have been leaving than arriving every year since {outSince}.</p>
        </div>

        <div class="story-block prose">
          <h2>When will the Philippine population peak?</h2>
          <p>Around {peak.year}, at roughly {millions(peak.population)}, according to the UN. Deaths would begin to exceed births in {natLoss}, and by 2100 the population is projected at {millions(y[2100].population)}, which would put the Philippines {ord(y[2100].worldRank!)} in the world, down from {ord(c.worldRank!)}.</p>
        </div>
        <LineChart
          title="The Philippines' population since 1950 and to 2100"
          subtitle="Mid-year totals; growth tails off before peaking in 2057, as the dashed UN projection shows."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How crowded is the Philippines?</h2>
          <p>Quite crowded: {int(c.densityPerKm2)} residents per km², more than six times the density of 1950 ({int(y[1950].densityPerKm2)}), as the population grew from {millions(y[1950].population)} to today's total. Only Indonesia has more people in South-East Asia. Urban residents became a majority in {urbanFrom} on the Philippines' own definition and make up {pct(c.urbanPct!)} in {CURRENT_YEAR}.</p>
        </div>
        <div class="age-row" role="group" aria-label="The Philippines in 1950 and today">
          <div><span class="y">1950</span><div class="v">{millionsShort(y[1950].population)}</div><span class="d">People</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{millionsShort(c.population)}</div><span class="d">About {Math.round(times)} times as many</span></div>
          <div><span class="y">Peak, {peak.year}</span><div class="v">{millionsShort(peak.population)}</div><span class="d">UN projection</span></div>
        </div>
        <RelatedPages iso3={ph.iso3} name={ph.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="The Philippines decade by decade, 1950–2100"
          subtitle="The Philippines in UN figures from 1950 onward; projected values begin with the 2030 row."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ph.slug}-population.csv`)}
          csvName={`${ph.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">The Philippines in numbers: quick answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ph.published}>{longDate(ph.published)}</time> · Updated <time datetime={ph.updated}>{longDate(ph.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Philippines population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Philippines" code="ph" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
