---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ae from '../../data/countries/united-arab-emirates.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the fastest growth of any country since 1950, a 2007 surge, very few deaths, and a strong male majority.
const PAGE = '/population/united-arab-emirates/';
const un = countryData(ae.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ae.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const times = c.population / y[1950].population;
const mult = wpp.slice().sort((a: any, b: any) => at(b).population / at(b, 1950).population - at(a).population / at(a, 1950).population).map((d: any) => d.iso3);
assertClaim(mult[0] === 'ARE' && times > 150 && times < 160, 'largest multiplication since 1950 of any country or area, over 150 times');
const men = (c.male / c.female) * 100;
const mf = wpp.filter((d: any) => at(d).population > 1e6).sort((a: any, b: any) => at(b).male / at(b).female - at(a).male / at(a).female).map((d: any) => d.iso3);
assertClaim(mf[0] === 'QAT' && mf[1] === 'ARE' && men > 170, 'second most male-heavy after Qatar, over 170 men per 100 women');
const cdr = (c.deaths / c.population) * 1000;
const lowDeath = wpp.filter((d: any) => at(d).population > 1e6).sort((a: any, b: any) => at(a).deaths / at(a).population - at(b).deaths / at(b).population).map((d: any) => d.iso3);
assertClaim(lowDeath[0] === 'ARE' && cdr < 1, 'lowest death rate of any country over 1 million, under 1 per 1,000');
const perDeath = c.births / c.deaths;
assertClaim(perDeath > 10 && perDeath < 11, 'about ten births for each death');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 2006 && un.years.every((r) => r.year < 2006 || r.fertility < 2.1), 'fertility below 2.1 every year since 2006');
assertClaim(c.naturalChange > c.netMigrants && c.netMigrants > 0, 'natural increase larger than net migration this year');
const est = un.years.filter((r) => !r.projection);
const surge = est.reduce((a, b) => (b.change > a.change ? b : a));
assertClaim(surge.year === 2007 && est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a)).year === 2007 && surge.growthRatePct > 13.5, '2007: largest gain and net inflow, growth above 13.5%');
const falls = un.years.filter((r) => r.change < 0).map((r) => r.year);
assertClaim(falls.join(',') === '2019' && y[2019].netMigrants < 0, 'only year of decline 2019, with net outflow');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
assertClaim(y[2000].male / y[2000].female > c.male / c.female && y[2050].male / y[2050].female < c.male / c.female, 'ratio higher in 2000, lower in 2050');
assertClaim(men > 170 && men < 180, 'about seven men for four women');
assertClaim(un.subregion === 'Western Asia', 'Western Asia');

const title = `UAE Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Up ${int(Math.round(times))}-Fold Since 1950 | AtlasFigures`;
const description = `The United Arab Emirates has ${millions(c.population)} residents as of mid-${CURRENT_YEAR}, from just ${int(Math.round(y[1950].population / 1000))} thousand in 1950. UN data on its record growth, low death rate and ${int(Math.round(men))} men per 100 women.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ae.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Growth since 1950', value: `×${int(Math.round(times))}` },
  { label: 'Men per 100 women', value: int(Math.round(men)) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, ae.tableYears);

const faq = [
  { q: 'What is the total number of people in the UAE?', a: `The Emirates' mid-${CURRENT_YEAR} population is ${millions(c.population)}, per the UN, ranking ${ord(c.worldRank!)} among the world's countries.` },
  { q: 'Why is the UAE growing when its birth rate is so low?', a: `Two reasons show up in the UN figures. Migration brings a net gain of some ${int(Math.round(c.netMigrants / 1000))} thousand in ${CURRENT_YEAR}, and because so few residents die, around ${int(Math.round(c.deaths / 1000))} thousand, the ${int(Math.round(c.births / 1000))} thousand births still produce a large natural increase despite ${dec(c.fertility, 2)} children per woman.` },
  { q: 'Do men outnumber women in the UAE?', a: `By a wide margin: ${dec(men, 1)} men per 100 women in ${CURRENT_YEAR}, the second-highest ratio among countries with at least 1 million people; Qatar's is higher.` },
  { q: 'What happened to the UAE population in 2007?', a: `It jumped by ${int(Math.round(surge.change / 1000))} thousand, ${pct(surge.growthRatePct)} in a single year, the UN estimates, as net migration reached ${int(Math.round(surge.netMigrants / 1000))} thousand.` },
  { q: 'Has the population of the Emirates ever fallen?', a: `Once since 1950: in 2019, a year of net emigration, the total dipped by about ${int(Math.round(Math.abs(y[2019].change) / 1000))} thousand.` },
];

const schema = countrySchema({
  page: PAGE, slug: ae.slug, name: ae.name, wikipedia: ae.wikipedia,
  headline: `The UAE's ${millions(c.population)} people: ${int(Math.round(times))} times the 1950 population`,
  description,
  datasetName: 'United Arab Emirates population, migration, births, deaths and urban share, 1950–2100',
  datasetDescription: `Mid-year population of the United Arab Emirates for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ae.published, updated: ae.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="UAE"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'United Arab Emirates', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>The UAE: the world's fastest population growth since 1950</h1>
        <LiveCounter
          label="United Arab Emirates: live population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} figure, up about ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          The United Arab Emirates has about <strong>{millions(c.population)}</strong> residents in mid-{CURRENT_YEAR}, <strong>{int(Math.round(times))} times as many as in 1950</strong>, a bigger multiple than any other country. It is also one of the most male-heavy populations anywhere, with {int(Math.round(men))} males to every 100 females.
        </p>
        <div class="dates"><span>Updated <time datetime={ae.updated}>{longDate(ae.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="United Arab Emirates" code="ae" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much has the UAE's population grown since 1950?</h2>
          <p>About {int(Math.round(times))}-fold, the largest increase recorded for any country or area since 1950. Some {int(Math.round(y[1950].population / 1000))} thousand people lived there in 1950; by 2000 there were {millions(y[2000].population)}, by 2010 {millions(y[2010].population)}, and today {millions(c.population)}.</p>
        </div>
        <LineChart
          title="UAE population, 1950–2100: from tens of thousands to millions"
          subtitle="UN mid-year values; the projected stretch, dashed, climbs to about 26 million by 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What happened to the UAE's population in 2007?</h2>
          <p>It grew by {pct(surge.growthRatePct)} in one year. The UN estimates a gain of {int(Math.round(surge.change / 1000))} thousand people in 2007, driven by net arrivals of {int(Math.round(surge.netMigrants / 1000))} thousand, the most in any year. The only year since 1950 in which the population fell was 2019, when departures outnumbered arrivals.</p>
        </div>

        <div class="story-block prose">
          <h2>How low is the UAE's death rate?</h2>
          <p>The lowest of any country with a million people or more: about {int(Math.round(c.deaths / 1000))} thousand deaths in {CURRENT_YEAR}, under 1 per 1,000 residents. Births run at roughly ten for every death. That keeps natural increase above net migration this year, even though fertility has been under 2.1 since {below} and is now {dec(c.fertility, 2)}.</p>
        </div>
        <LineChart
          title="Emirati fertility, 1950 to 2050"
          subtitle="Births per woman from the UN, projection dashed; reference at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 children' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many more men than women live in the UAE?</h2>
          <p>Roughly seven men for every four women: {dec(men, 1)} per 100 in {CURRENT_YEAR}, second only to Qatar among countries of at least 1 million. The ratio was higher still in 2000 and is projected to ease to {dec((y[2050].male / y[2050].female) * 100, 1)} by 2050. The UN data record the imbalance without giving its causes.</p>
        </div>
        <div class="age-row" role="group" aria-label="Men per 100 women in the UAE">
          <div><span class="y">2000</span><div class="v">{dec((y[2000].male / y[2000].female) * 100, 1)}</div><span class="d">Men per 100 women</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(men, 1)}</div><span class="d">Second after Qatar</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec((y[2050].male / y[2050].female) * 100, 1)}</div><span class="d">Easing</span></div>
        </div>

        <div class="story-block prose">
          <h2>How large could the UAE become by 2100?</h2>
          <p>About {millions(y[2100].population)}, in the medium variant, which shows it still growing in 2100 and climbing to {ord(y[2100].worldRank!)} worldwide from {ord(c.worldRank!)}. Density, {int(c.densityPerKm2)} people per km² today, would reach {int(y[2100].densityPerKm2)}. The Emirates count {pct(c.urbanPct!)} of residents as urban, and the median age is {dec(c.medianAge, 1)}.</p>
        </div>
        <RelatedPages iso3={ae.iso3} name={ae.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Emirates population table, 1950–2100"
          subtitle="From a few tens of thousands in 1950 to the projected 2100 total."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ae.slug}-population.csv`)}
          csvName={`${ae.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">UAE population: what people ask</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ae.unName}"): population, males and females, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ae.published}>{longDate(ae.published)}</time> · Updated <time datetime={ae.updated}>{longDate(ae.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('United Arab Emirates population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="United Arab Emirates" code="ae" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
