---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import bhr from '../../data/countries/bahrain.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: density about 2,140 per km², third-highest
// among 1M+ countries after Singapore and Hong Kong; UN urban share 100%; 163 men per 100 women (fourth-highest);
// 14 times the 1950 headcount; deaths never outnumber births 1950–2100; falls only in 2011, 2019 and 2020; largest
// net inflow 2008, largest net outflow 2019.
const PAGE = '/population/bahrain/';
const un = countryData(bhr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (bhr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const v1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...v1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 3).map((d: any) => d.iso3).join() === 'SGP,HKG,BHR', 'third-densest');
assertClaim(v1.filter((d: any) => at(d).urbanPct >= 99.95).map((d: any) => d.iso3).sort().join() === 'BHR,HKG,KWT,SGP', 'urban 100%, shared with HKG, SGP, KWT');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...v1].sort((a: any, b: any) => sr(b) - sr(a)).slice(0, 4).map((d: any) => d.iso3).join() === 'QAT,ARE,OMN,BHR', 'fourth-highest sex ratio after Qatar, UAE, Oman');
assertClaim(c.population / y[1950].population > 14 && c.population / y[1950].population < 14.5, 'about 14 times 1950');
assertClaim(un.years.every((r) => r.naturalChange > 0), 'births exceed deaths every year');
const falls = un.years.filter((r) => r.year > 1950 && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '2011,2019,2020', 'falls only 2011, 2019, 2020');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(inTop.year === 2008 && outTop.year === 2019, 'inflow 2008, outflow 2019');
assertClaim(un.years.filter((r) => r.year >= 2016).every((r) => r.fertility < 2.1) && y[2015].fertility >= 2.1, 'fertility under 2.1 from 2016');

const title = `Bahrain Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Fourteenfold Growth Since 1950 on a Crowded Archipelago | AtlasFigures`;
const description = `UN World Population Prospects puts Bahrain at ${millions(c.population)} in ${CURRENT_YEAR}: about ${int(c.densityPerKm2)} per km², a male-to-female ratio of ${dec((c.male / c.female) * 100, 1)} to 100, and close to fourteen times its 1950 size. No year in the series records more deaths than births.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: bhr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, bhr.tableYears);

const faq = [
  { q: 'Where does Bahrain rank for crowding?', a: `About ${int(c.densityPerKm2)} residents per km² (UN); among nations of a million or more, only Singapore and Hong Kong are more packed.` },
  { q: 'Does Bahrain have far more men than women?', a: `Strongly male: ${dec((c.male / c.female) * 100, 1)} to 100, behind only Qatar, the UAE and Oman among nations exceeding a million. No explanation is attached to the figure.` },
  { q: 'Did Bahrain ever shrink?', a: `Three times only, in 2011, 2019 and 2020, each a year of net departures; the 2019 net loss of ${int(-outTop.netMigrants)} tops the record.` },
  { q: 'What was Bahrain\'s population in 1950?', a: `${int(y[1950].population)}, about a fourteenth of today's ${millions(c.population)}.` },
  { q: 'Is Bahrain projected to grow through 2100?', a: `The medium variant says so, reaching ${millions(y[2050].population)} by 2050 and then ${millions(y[2100].population)} at century's end, with births ahead of deaths all along.` },
];

const schema = countrySchema({
  page: PAGE, slug: bhr.slug, name: bhr.name, wikipedia: bhr.wikipedia,
  headline: `Bahrain's ${millions(c.population)}: third-densest nation; about 14 times 1950; births ahead of deaths in every year 1950–2100`,
  description,
  datasetName: 'Bahrain population, density and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Bahrain for selected years from 1950 to ${CURRENT_YEAR}, including 2008, 2011 and 2018–2021, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: bhr.published, updated: bhr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Bahrain"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Bahrain", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Bahrain: a small island state, fourteen times its 1950 size</h1>
        <LiveCounter
          label="Bahrain: approximate head count"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Projected forward from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} total, adding near ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Bahrain's {CURRENT_YEAR} population, by UN reckoning: <strong>{millions(c.population)}</strong>, compared with <strong>{int(y[1950].population)}</strong> in 1950, packed at about {int(c.densityPerKm2)} per km².
        </p>
        <div class="dates"><span>Updated <time datetime={bhr.updated}>{longDate(bhr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Bahrain" code="bh" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is Bahrain densely packed?</h2>
          <p>It is: around {int(c.densityPerKm2)} residents per km², third among million-plus nations behind Singapore and Hong Kong. The UN's urban share, on Bahrain's own definition, is {pct(c.urbanPct!)}, a level shared only with Hong Kong, Singapore and Kuwait in that group.</p>
        </div>
        <LineChart
          title="Bahrain, 1950–2100: upward, with just three dips"
          subtitle="Mid-year residents; the UN projection appears dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What drives Bahrain's growth?</h2>
          <p>Two forces, per the UN: natural increase in each year from 1950 to 2100 with no exception, and a mainly positive migration balance, peaking at {int(inTop.netMigrants)} in 2008. The count dipped only in 2011, 2019 and 2020, all years of net departures; 2019 was the biggest outflow, {int(-outTop.netMigrants)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How skewed is Bahrain's sex ratio?</h2>
          <p>Markedly: the UN ratio stands at {dec((c.male / c.female) * 100, 1)} males per hundred females, exceeded among million-plus nations only by Qatar, the UAE and Oman; the data carry no reasons. The 1958 fertility rate of {dec(y[1958].fertility, 2)} has fallen to {dec(c.fertility, 2)}, below 2.1 continuously since 2016, and life expectancy stands at {dec(c.lifeExpectancy, 1)}.</p>
        </div>
        <RelatedPages iso3={bhr.iso3} name={bhr.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Bahrain by year: 2008, 2011, 2018–2021, plus each decade"
          subtitle="The only drops: 2011, 2019 and 2020."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${bhr.slug}-population.csv`)}
          csvName={`${bhr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Bahrain in five UN-based answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{bhr.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={bhr.published}>{longDate(bhr.published)}</time> · Updated <time datetime={bhr.updated}>{longDate(bhr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Bahrain population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Bahrain" code="bh" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
