---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ir from '../../data/countries/iran.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: one of the fastest fertility declines on record (1980–2000), births halved since 1985, a 2053 peak near 102 million.
const PAGE = '/population/iran/';
const un = countryData(ir.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ir.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const drop = y[1980].fertility - y[2000].fertility;
const drops = wpp.filter((d: any) => at(d).population > 10e6).sort((a: any, b: any) => (at(b, 1980).fertility - at(b, 2000).fertility) - (at(a, 1980).fertility - at(a, 2000).fertility)).map((d: any) => d.iso3);
assertClaim(drops[0] === 'IRN' && drop > 4.5, 'largest fall in fertility 1980–2000 among countries over 10 million, more than 4.5 births');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 1999 && un.years.every((r) => r.year < 1999 || r.fertility < 2.1), 'under 2.1 since 1999');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrMax.year === 1959, 'fertility peak 1959');
const est = un.years.filter((r) => !r.projection);
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
const half = c.births / birthTop.births;
assertClaim(birthTop.year === 1985 && half > 0.5 && half < 0.55, 'births in 1985 peak above 2 million; now about half');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2053 && natLoss === 2054 && un.years.filter((r) => r.year > 2053).every((r) => r.change < 0), 'peak 2053; natural loss and decline every year after');
const backTo = un.years.find((r) => r.population >= y[2100].population)!.year;
assertClaim(backTo === 2013, '2100 at about the 2013 level');
const falls = est.filter((r) => r.change < 0).map((r) => r.year);
assertClaim(falls.join(',') === '1993' && y[1993].netMigrants < -1.6e6, 'only decline in 1993, with net outflow above 1.6 million');
const south = wpp.filter((d: any) => d.subregion === 'Southern Asia');
const le = south.slice().sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(le[0] === 'MDV' && le[1] === 'IRN', 'second in Southern Asia for life expectancy after the Maldives');
const big = south.slice().sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(big.slice(0, 4).join(',') === 'IND,PAK,BGD,IRN' && un.subregion === 'Southern Asia', 'UN groups Iran in Southern Asia, fourth after India, Pakistan, Bangladesh');
assertClaim(c.naturalChange > c.change / 2 && Math.abs(y[1980].fertility - 6.6) < 0.05 && Math.abs(y[2000].fertility - 2.0) < 0.01, 'growth mostly natural; fertility about 6.6 in 1980 and 2.0 in 2000');

const title = `Iran Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million After a Record Fall in Births | AtlasFigures`;
const description = `UN estimates count ${millions(c.population)} Iranians in ${CURRENT_YEAR}. Births per woman dropped from ${dec(y[1980].fertility, 2)} in 1980 to ${dec(y[2000].fertility, 2)} in 2000, the fastest drop of any large country; the UN sees a ${peak.year} peak.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ir.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, ir.tableYears);

const faq = [
  { q: 'What is Iran\'s population right now?', a: `${millions(c.population)} at mid-${CURRENT_YEAR}, per UN estimates; Iran ranks ${ord(c.worldRank!)} in the world.` },
  { q: 'How did Iran\'s birth rate fall so fast?', a: `The UN data measure the speed, not the policies or social changes behind it: fertility went from ${dec(y[1980].fertility, 2)} in 1980 to ${dec(y[2000].fertility, 2)} in 2000, a drop of ${dec(drop, 2)} births per woman in twenty years, a record for any nation above 10 million people.` },
  { q: 'Is Iran\'s population going to start shrinking?', a: `Yes, after ${peak.year}, when it reaches a projected ${millions(peak.population)}. From then on deaths exceed births and the total shrinks each year.` },
  { q: 'Is Iran in the Middle East or South Asia in UN statistics?', a: `The UN's statistical grouping places Iran in Southern Asia, where it is the fourth most populous country after India, Pakistan and Bangladesh.` },
  { q: 'How does Iranian life expectancy compare regionally?', a: `A child born in Iran today has a life expectancy of ${dec(c.lifeExpectancy, 1)} years, second in Southern Asia after the Maldives. It was ${dec(y[1950].lifeExpectancy, 1)} in 1950.` },
];

const schema = countrySchema({
  page: PAGE, slug: ir.slug, name: ir.name, wikipedia: ir.wikipedia,
  headline: `Iran's ${millions(c.population)}: the population after a record fall in fertility`,
  description,
  datasetName: 'Iran population, fertility, births, ageing and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Iran (listed by the UN as Iran (Islamic Republic of)) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ir.published, updated: ir.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Iran"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Iran', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Iran's population after one of the fastest fertility drops on record</h1>
        <LiveCounter
          label="Iran: population estimate at present"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} total, climbing roughly ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          The UN estimates Iran's population at <strong>{millions(c.population)}</strong> for {CURRENT_YEAR}, placing it {ord(c.worldRank!)} worldwide. Fertility dropped from {dec(y[1980].fertility, 2)} in 1980 to {dec(y[2000].fertility, 2)} in 2000, and the population is now projected to <strong>top out in {peak.year}</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={ir.updated}>{longDate(ir.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Iran" code="ir" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How fast did Iran's fertility rate fall?</h2>
          <p>Faster than anywhere else of its size. The UN's estimate for 1980 is {dec(y[1980].fertility, 2)} births per woman; by 1990 the figure was {dec(y[1990].fertility, 2)} and by 2000 {dec(y[2000].fertility, 2)}, a fall of {dec(drop, 2)} in two decades, the largest among countries above 10 million people. It slipped below 2.1 in {below} and has stayed there; today it is {dec(c.fertility, 2)}.</p>
        </div>
        <LineChart
          title="Iranian fertility, 1950–2050: the 1980s–1990s plunge"
          subtitle="UN births-per-woman series, dashed where projected; horizontal line at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'line at 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Are fewer babies born in Iran than in the 1980s?</h2>
          <p>About half as many. Births hit their record, {millions(birthTop.births)}, in {birthTop.year}, while {CURRENT_YEAR} brings about {millions(c.births)}. The median Iranian has gone from {dec(y[2000].medianAge, 1)} in 2000 to {dec(c.medianAge, 1)}, with {dec(y[2050].medianAge, 1)} projected for 2050.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Iran">
          <div><span class="y">2000</span><div class="v">{dec(y[2000].medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Rising fast</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Mid-forties</span></div>
        </div>

        <div class="story-block prose">
          <h2>In what year does Iran's population top out?</h2>
          <p>In {peak.year}, at {millions(peak.population)}, according to the medium variant. Natural decrease is expected from {natLoss}, and each later year is smaller, ending with {millions(y[2100].population)} in 2100, about where it was in {backTo}.</p>
        </div>
        <LineChart
          title="Iran's population, 1950–2100: growth, a 2053 high, then decline"
          subtitle="Population each mid-year, per the UN; after 2026 the line, now dashed, crests just above 100 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Did Iran's population drop in 1993?</h2>
          <p>Yes. It was the only fall in the UN series, a year when net departures of about {millions(-y[1993].netMigrants)} outweighed natural growth. In {CURRENT_YEAR} the population rises by {pct(c.growthRatePct)}, about {int(Math.round(c.change / 1000))} thousand, mostly from births over deaths.</p>
        </div>

        <div class="story-block prose">
          <h2>Which UN region is Iran counted in?</h2>
          <p>Southern Asia. In that grouping it is the fourth-largest country, after India, Pakistan and Bangladesh, and has the second-longest life expectancy, {dec(c.lifeExpectancy, 1)} years, after the Maldives. {pct(c.urbanPct!)} of Iranians are urban by the national definition.</p>
        </div>
        <RelatedPages iso3={ir.iso3} name={ir.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Iran: population and fertility by decade, 1950–2100"
          subtitle="Fertility near 6.6 in 1980 and 2.0 by 2000 stands out in the rows below."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ir.slug}-population.csv`)}
          csvName={`${ir.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Iran's population: readers' questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ir.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ir.published}>{longDate(ir.published)}</time> · Updated <time datetime={ir.updated}>{longDate(ir.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Iran population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Iran" code="ir" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
