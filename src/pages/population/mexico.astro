---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import mx from '../../data/countries/mexico.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the pandemic shock, falling births and a peak in the 2050s.
const PAGE = '/population/mexico/';
const un = countryData(mx.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (mx.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const yr = (d: any, n: number) => d.years.find((r: any) => r.year === n);
const drop = (d: any) => yr(d, 2019).lifeExpectancy - Math.min(yr(d, 2020).lifeExpectancy, yr(d, 2021).lifeExpectancy);
const bigDrops = wpp.filter((d: any) => yr(d, CURRENT_YEAR).population > 50e6).sort((a: any, b: any) => drop(b) - drop(a));
assertClaim(bigDrops[0].iso3 === 'MEX', 'largest life-expectancy fall 2019-2021 of any country over 50 million');
const leLoss = y[2019].lifeExpectancy - y[2021].lifeExpectancy;
assertClaim(y[2020].lifeExpectancy < y[2019].lifeExpectancy && y[2021].lifeExpectancy < y[2020].lifeExpectancy && c.lifeExpectancy > y[2019].lifeExpectancy, 'two years of falls, now above 2019');
const sub = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(un.years.filter((r) => r.year >= sub).every((r) => r.fertility < 2.1), 'below 2.1 since');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const est = un.years.filter((r) => !r.projection);
const birthPeak = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(est.every((r) => r.netMigrants < 0) && c.netMigrants < 0, 'more people left than arrived in every year of the UN record');
const outPeak = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const firstFall = un.years.find((r) => r.year > CURRENT_YEAR && r.change < 0)!.year;
assertClaim(Math.abs(y[2100].population / c.population - 1) < 0.05 && Math.abs(c.netMigrants) < 0.2 * c.naturalChange, '2100 close to today; outflow small next to natural gain');
const latam = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean').sort((a: any, b: any) => yr(b, CURRENT_YEAR).population - yr(a, CURRENT_YEAR).population).map((d: any) => d.iso3);
assertClaim(latam[0] === 'BRA' && latam[1] === 'MEX', 'second in Latin America after Brazil');

const title = `Mexico, ${(c.population / 1e6).toFixed(1)} Million People in ${CURRENT_YEAR}: Births Falling, Peak by ${peak.year} | AtlasFigures`;
const description = `Mexico is home to about ${millions(c.population)} people (${CURRENT_YEAR}). Life expectancy fell ${dec(leLoss, 1)} years during the pandemic, fertility is ${dec(c.fertility, 2)}, and the UN expects growth to end in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: mx.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, mx.tableYears);

const faq = [
  { q: "What is Mexico's population as of 2026?", a: `The UN's mid-year figure is roughly ${millions(c.population)}, which places Mexico ${ord(c.worldRank!)} worldwide and second in Latin America after Brazil.` },
  { q: 'Is Mexico still growing?', a: `Yes, by ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, or about ${millions(c.change)} people. The pace keeps slowing until growth stops in ${peak.year}.` },
  { q: 'How many births does Mexico record a year?', a: `About ${millions(c.births)} in ${CURRENT_YEAR} by the UN's reckoning, down from a high of ${millions(birthPeak.births)} in ${birthPeak.year}.` },
  { q: 'Why did life expectancy in Mexico fall in 2020 and 2021?', a: `Those were the first two years of the COVID-19 pandemic. UN estimates show life expectancy at birth dropping from ${dec(y[2019].lifeExpectancy, 1)} years in 2019 to ${dec(y[2021].lifeExpectancy, 1)} in 2021, before recovering to ${dec(c.lifeExpectancy, 1)}.` },
  { q: "Will Mexico's population shrink?", a: `Yes, from ${firstFall} under the UN's central projection, falling to about ${millions(y[2100].population)} by 2100 from a ${peak.year} high of ${millions(peak.population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: mx.slug, name: mx.name, wikipedia: mx.wikipedia,
  headline: `Mexico's population in ${CURRENT_YEAR}: ${millions(c.population)}, after a sharp pandemic setback`,
  description,
  datasetName: 'Mexico population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Mexico for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: mx.published, updated: mx.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Mexico"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Mexico', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Mexico's population at a turning point</h1>
        <LiveCounter
          label="Mexico now, estimated population"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: 1 July ${CURRENT_YEAR} level plus about ${int(c.change / 365)} people daily`}
        />
        <p class="answer">
          Mexico, with an estimated <strong>{millions(c.population)} residents</strong> in {CURRENT_YEAR}, is the world's {ord(c.worldRank!)} most populous nation and second in Latin America after Brazil. Fertility has fallen to <strong>{dec(c.fertility, 2)} children per woman</strong>, and growth is projected to end in {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={mx.updated}>{longDate(mx.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Mexico" code="mx" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How hard did COVID-19 hit life expectancy in Mexico?</h2>
          <p>More than in any other nation with a population over 50 million. In the UN's estimates, a Mexican newborn's expected lifespan slid from {dec(y[2019].lifeExpectancy, 1)} years in 2019 to {dec(y[2020].lifeExpectancy, 1)} in 2020 and {dec(y[2021].lifeExpectancy, 1)} in 2021, {dec(leLoss, 1)} years lower. It bounced back to {dec(y[2023].lifeExpectancy, 1)} by 2023 and is {dec(c.lifeExpectancy, 1)} in {CURRENT_YEAR}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy at birth in Mexico">
          <div><span class="y">2019</span><div class="v">{dec(y[2019].lifeExpectancy, 1)}</div><span class="d">Years, before the pandemic</span></div>
          <div><span class="y">2021</span><div class="v">{dec(y[2021].lifeExpectancy, 1)}</div><span class="d">After two years of decline</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Fully recovered</span></div>
        </div>

        <div class="story-block prose">
          <h2>Has Mexico's fertility rate dropped below 2.1?</h2>
          <p>Yes, in {sub}, and it has kept falling, to {dec(c.fertility, 2)} this year. That is a long way from {tfrMax.year}, when Mexican women averaged {dec(tfrMax.fertility, 2)} children. Annual births hit their highest, {millions(birthPeak.births)}, in {birthPeak.year}; in {CURRENT_YEAR} the UN counts {millions(c.births)}.</p>
        </div>
        <LineChart
          title="Mexico's fertility rate over 100 years, 1950–2050"
          subtitle="Average births per woman; the reference line marks 2.1. The UN projection is shown dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 benchmark' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many Mexicans emigrate each year?</h2>
          <p>In {CURRENT_YEAR} Mexico loses roughly {int(Math.round(Math.abs(c.netMigrants) / 1000))} thousand residents, net, to migration. The UN's estimates show net emigration in every year since 1950, peaking in {outPeak.year} at about {int(Math.round(Math.abs(outPeak.netMigrants) / 1000))} thousand. That outflow is dwarfed by births exceeding deaths by {millions(c.naturalChange)}.</p>
        </div>

        <div class="story-block prose">
          <h2>When does Mexico's population reach its maximum?</h2>
          <p>In {peak.year}, at about {millions(peak.population)}, if the UN medium variant is right. From {firstFall} the total falls each year, reaching {millions(y[2100].population)} in 2100, close to today's level. Mexico would slip from {ord(c.worldRank!)} to {ord(y[2100].worldRank!)} in the world over that time.</p>
        </div>
        <LineChart
          title="How Mexico's population has changed since 1950, with the UN view to 2100"
          subtitle="People at mid-year. The dashed section, from the UN projection, peaks in the late 2050s."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Where does Mexico rank in Latin America?</h2>
          <p>Second, behind only Brazil. Measured the way Mexico defines towns and cities, {pct(c.urbanPct!)} of people are urban, up from {pct(y[1950].urbanPct!)} in 1950. Mexicans have also grown older: the median age has risen from {dec(y[1950].medianAge, 1)} in 1950 to {dec(c.medianAge, 1)}, and {dec(y[2050].medianAge, 1)} is projected for 2050.</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Mexican population, every decade from 1950 to 2100"
          subtitle="Mexican data from the UN for ten-year steps and the current year; the rows from 2030 are projected."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${mx.slug}-population.csv`)}
          csvName={`${mx.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Mexico's population: the short version</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, growth, density, fertility, median age, life expectancy, net migration, world rank, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={mx.published}>{longDate(mx.published)}</time> · Updated <time datetime={mx.updated}>{longDate(mx.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Mexico population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Mexico" code="mx" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
