---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import bgr from '../../data/countries/bulgaria.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: of the three countries of a million
// or more that are smaller now than in 1950, the furthest below; a 1988 peak and a lower total every year since; net departures above 110,000 a
// year in 1989–1992; deaths above births every year from 1990; brief net arrivals 2020–2024; 2100 projection.
const PAGE = '/population/bulgaria/';
const un = countryData(bgr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (bgr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const vs50 = (d: any) => at(d).population / at(d, 1950).population;
assertClaim(m1.filter((d: any) => vs50(d) < 1).map((d: any) => d.iso3).sort().join() === 'BGR,HRV,LVA' && [...m1].sort((a: any, b: any) => vs50(a) - vs50(b))[0].iso3 === 'BGR', 'furthest below 1950 of the three 1M+ countries smaller than in 1950');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1988, 'peak 1988');
assertClaim(un.years.filter((r) => r.year > 1988 && r.year <= CURRENT_YEAR).every((r) => r.population < y[r.year - 1].population), 'lower every year 1989–now');
const streak = (d: any) => { let n = 0; for (let k = CURRENT_YEAR; k > 1950 && at(d, k).population < at(d, k - 1).population; k--) n++; return n; };
assertClaim(streak(wpp.find((d: any) => d.iso3 === 'BGR')) === 38 && [...m1].sort((a: any, b: any) => streak(b) - streak(a)).slice(0, 2).map((d: any) => d.iso3).join() === 'SRB,BGR', '38 years, second only to Serbia');
assertClaim([1989, 1990, 1991, 1992].every((n) => -y[n].netMigrants > 110000), 'net departures above 110,000 in 1989–1992');
assertClaim([2020, 2021, 2022, 2023, 2024].every((n) => y[n].netMigrants > 0) && y[2019].netMigrants < 0 && y[2025].netMigrants < 0, 'net arrivals 2020–2024 only');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 1990 && un.years.filter((r) => r.year >= 1990).every((r) => r.naturalChange < 0), 'deaths above births every year from 1990');
assertClaim(c.deaths / c.births > 1.7 && c.deaths / c.births < 1.8, 'deaths about 1.7 times births');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy).map((d: any) => d.iso3).indexOf('BGR') === 4, 'fifth-lowest life expectancy in Europe');

const title = `Bulgaria Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Further Below Its 1950 Count Than Any Other Country | AtlasFigures`;
const description = `Bulgaria's UN-estimated total for ${CURRENT_YEAR}, ${millions(c.population)}, is lower than in 1950; no other million-plus country has slipped so far below its 1950 level. The count has fallen without pause since peaking at ${millions(peak.population)} in 1988.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: bgr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, bgr.tableYears);

const faq = [
  { q: 'Does Bulgaria have fewer people than in 1950?', a: `Yes: ${millions(c.population)} against ${millions(y[1950].population)}. Latvia and Croatia are also below their 1950 counts; among countries above one million inhabitants none has fallen as far as Bulgaria.` },
  { q: "How long is Bulgaria's run of yearly declines?", a: `38 in a row, every year from 1989 to ${CURRENT_YEAR}. Only Serbia's unbroken run is longer.` },
  { q: 'How many people left Bulgaria around 1990?', a: `Net departures topped 110,000 a year over 1989–1992, with ${int(-y[1992].netMigrants)} in 1992 the highest, per the UN. The files give counts only.` },
  { q: 'Are deaths higher than births in Bulgaria?', a: `Since 1990, yes. For ${CURRENT_YEAR} the projection is ${int(c.deaths)} deaths to ${int(c.births)} births.` },
  { q: 'What is the 2100 outlook for Bulgaria?', a: `Roughly half today's total: ${millions(y[2100].population)}, per the UN medium variant.` },
];

const schema = countrySchema({
  page: PAGE, slug: bgr.slug, name: bgr.name, wikipedia: bgr.wikipedia,
  headline: `Bulgaria's ${millions(c.population)}: smaller than in 1950; falling every year since 1988; deaths above births since 1990`,
  description,
  datasetName: 'Bulgaria population, net migration and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Bulgaria for selected years from 1950 to ${CURRENT_YEAR}, including 1988–1990, 1992 and 2022, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: bgr.published, updated: bgr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Bulgaria"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Bulgaria", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Bulgaria: fewer people today than in 1950</h1>
        <LiveCounter
          label="Bulgaria: estimated population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Starts from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} total and subtracts roughly ${int(-c.change / 365)} per day`}
        />
        <p class="answer">
          With <strong>{millions(c.population)}</strong> Bulgarians estimated for {CURRENT_YEAR}, the country is down from <strong>{millions(peak.population)}</strong> in 1988, its highest year, and below the {millions(y[1950].population)} of 1950. Nowhere else with a million-plus population is the shortfall against 1950 so large.
        </p>
        <div class="dates"><span>Updated <time datetime={bgr.updated}>{longDate(bgr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Bulgaria" code="bg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is Bulgaria smaller than it was in 1950?</h2>
          <p>It is. Three countries above the one-million mark have fewer inhabitants now than in 1950 (Bulgaria, Latvia and Croatia), and Bulgaria's gap is the widest. The count rose to {millions(peak.population)} in 1988 and has dropped every year since, 38 years without a break; only Serbia's run is longer.</p>
        </div>
        <LineChart
          title="Bulgaria's population, 1950–2100: up to 1988, then down"
          subtitle="Mid-year totals; after 2023 the line is the dashed UN projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many Bulgarians left around 1990?</h2>
          <p>More than 110,000 net in each year from 1989 to 1992: {int(-y[1989].netMigrants)} in 1989 and {int(-y[1992].netMigrants)} in 1992 by UN reckoning. These are counts; the files do not say who left or why. A short spell of net arrivals followed much later, from 2020 to 2024, largest in 2020 at {int(y[2020].netMigrants)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How wide is Bulgaria's gap between deaths and births?</h2>
          <p>Deaths have led every year since 1990. {CURRENT_YEAR}'s projected tally: {int(c.deaths)} deaths, {int(c.births)} births, about 1.7 deaths per birth; in 1950 there were {int(y[1950].births)} births. Fertility is {dec(c.fertility, 2)} and the median age {dec(c.medianAge, 1)}. At {dec(c.lifeExpectancy, 1)} years, Bulgarian life expectancy ranks fifth-lowest among European countries above a million.</p>
        </div>

        <div class="story-block prose">
          <h2>Where does Bulgaria's projection end up in 2100?</h2>
          <p>At {millions(y[2100].population)}, about half of today's figure, after {millions(y[2050].population)} by mid-century.</p>
        </div>
        <RelatedPages iso3={bgr.iso3} name={bgr.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Year-by-year Bulgaria: 1988 to 1990, 1992 and beyond"
          subtitle="From 1989 down the rows, each total undercuts its predecessor."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${bgr.slug}-population.csv`)}
          csvName={`${bgr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Bulgaria: the questions, answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{bgr.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={bgr.published}>{longDate(bgr.published)}</time> · Updated <time datetime={bgr.updated}>{longDate(bgr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Bulgaria population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Bulgaria" code="bg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
