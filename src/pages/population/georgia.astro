---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import geo from '../../data/countries/georgia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: a 1988 peak of 5.5 million;
// a lower total every year 1989–2015 and net departures in each of those years, largest 1993; about 31% below the peak
// now, third-deepest fall from a peak among 1M+ countries after Moldova and Latvia; deaths above births from 2021.
const PAGE = '/population/georgia/';
const un = countryData(geo.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (geo.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1988, 'peak 1988');
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(Array.from({ length: 27 }, (_, i) => 1989 + i).every((n) => falls.includes(n)) && !falls.includes(2016), 'lower every year 1989–2015');
assertClaim(un.years.filter((r) => r.year >= 1989 && r.year <= 2015).every((r) => r.netMigrants < 0), 'net departures 1989–2015');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1993, 'largest outflow 1993');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const drop = (d: any) => 1 - at(d).population / Math.max(...Array.from({ length: CURRENT_YEAR - 1949 }, (_, i) => at(d, 1950 + i).population));
assertClaim([...m1].sort((a: any, b: any) => drop(b) - drop(a)).slice(0, 3).map((d: any) => d.iso3).join() === 'MDA,LVA,GEO' && drop(wpp.find((d: any) => d.iso3 === 'GEO')) > 0.3, 'third-deepest fall from peak, over 30%');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2021 && un.years.filter((r) => r.year >= 2021).every((r) => r.naturalChange < 0), 'deaths above births from 2021');
assertClaim(y[2022].netMigrants > 2e4, '2022 net arrivals');

const title = `Georgia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Caucasus Nation Still 30% Under Its 1988 High | AtlasFigures`;
const description = `Georgia, the country in the Caucasus listed by the UN under Western Asia, counts ${millions(c.population)} for ${CURRENT_YEAR}: more than 30% under its 1988 maximum. Each July total from 1989 through 2015 undercut the last, and every one of those years lost people to migration.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: geo.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
];

const rows = displayRows(un.years, geo.tableYears);

const faq = [
  { q: 'Has Georgia lost population since Soviet times?', a: `Since its 1988 maximum, yes: ${millions(peak.population)} in 1988 versus ${millions(c.population)} at present, a drop of over 30%. Just two million-plus nations, Moldova and Latvia, have fallen further from their highs.` },
  { q: 'How many consecutive years did Georgia decline?', a: `Twenty-seven, 1989 through 2015, with net departures in each. Reasons are absent from the UN data.` },
  { q: 'Which year saw the largest outflow from Georgia?', a: `1993: ${int(-outTop.netMigrants)} more people went than came.` },
  { q: 'Do Georgian deaths now exceed births?', a: `Since 2021, yes; ${CURRENT_YEAR} pencils in ${int(c.deaths)} deaths versus ${int(c.births)} births.` },
  { q: "Where is Georgia's population going by 2100?", a: `Lower still: the UN's 2100 value is ${millions(y[2100].population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: geo.slug, name: geo.name, wikipedia: geo.wikipedia,
  headline: `Georgia's ${millions(c.population)}: down over 30% from 1988; shrinking 1989–2015; deaths above births since 2021`,
  description,
  datasetName: 'Georgia population, net migration and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Georgia (the country) for selected years from 1950 to ${CURRENT_YEAR}, including 1988–1990, 1993, 2015, 2016 and 2021–2022, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: geo.published, updated: geo.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Georgia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Georgia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Georgia: still far below its 1988 peak</h1>
        <LiveCounter
          label="Georgia: present-moment population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024, mid-${CURRENT_YEAR}; changing by about ${int(Math.abs(c.change) / 365)} people a day`}
        />
        <p class="answer">
          UN figures for {CURRENT_YEAR} show <strong>{millions(c.population)}</strong> people in Georgia, well short of 1988's <strong>{millions(peak.population)}</strong>. For twenty-seven straight years, 1989–2015, the count went down.
        </p>
        <div class="dates"><span>Updated <time datetime={geo.updated}>{longDate(geo.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Georgia" code="ge" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How far below its 1988 maximum is Georgia?</h2>
          <p>More than 30% below. The 1988 total, {millions(peak.population)}, was the high point; {CURRENT_YEAR} stands at {millions(c.population)}. Of all nations above a million, just Moldova and Latvia have slid further from their own highs.</p>
        </div>
        <LineChart
          title="Georgia, 1950–2100: the climb to 1988 and the long slide"
          subtitle="Yearly mid-point totals; dashed line marks UN projections."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why did Georgia's population fall for 27 years?</h2>
          <p>Migration accounts for it in the arithmetic: 1989 through 2015 all show more leavers than newcomers, the gap widest in 1993 at {int(-outTop.netMigrants)}, and each of those July counts sits under its predecessor. What drove people out goes unrecorded in the UN tables. After 2015 the total roughly steadied; 2022 even added {int(y[2022].netMigrants)} through net arrivals.</p>
        </div>

        <div class="story-block prose">
          <h2>Are Georgian deaths outnumbering births?</h2>
          <p>Since 2021, and every projected year keeps it that way: {CURRENT_YEAR} pencils in {int(c.deaths)} deaths, {int(c.births)} births. Women average {dec(c.fertility, 2)} children; for every 100 females Georgia has {dec((c.male / c.female) * 100, 1)} males. Looking out to 2100, the UN expects {millions(y[2100].population)}.</p>
        </div>
        <RelatedPages iso3={geo.iso3} name={geo.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Georgia, 1988 high through 2015 and on"
          subtitle="Rows 1989 to 2015 each come in under the one above."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${geo.slug}-population.csv`)}
          csvName={`${geo.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Georgia (the country): your questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{geo.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={geo.published}>{longDate(geo.published)}</time> · Updated <time datetime={geo.updated}>{longDate(geo.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Georgia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Georgia" code="ge" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
