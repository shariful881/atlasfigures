---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import dz from '../../data/countries/algeria.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: Africa's largest country by land with a thin average density, a fertility rebound in the 2000s, long lives for the continent, a peak around 2090.
const PAGE = '/population/algeria/';
const un = countryData(dz.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (dz.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const africa = wpp.filter((d: any) => d.region === 'Africa');
const largest = africa.slice().sort((a: any, b: any) => b.landAreaKm2 - a.landAreaKm2).map((d: any) => d.iso3);
assertClaim(largest[0] === 'DZA', 'largest land area in Africa');
const tfrLow = un.years.filter((r) => r.year >= 1990 && r.year <= 2010).reduce((a, b) => (b.fertility < a.fertility ? b : a));
const tfrHigh = un.years.filter((r) => r.year > tfrLow.year && r.year <= 2023).reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrLow.year === 2002 && tfrHigh.year === 2015 && tfrHigh.fertility - tfrLow.fertility > 0.6, 'fertility rose from a 2002 low to a 2015 high by more than 0.6');
const est = un.years.filter((r) => !r.projection);
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2017 && birthTop.births > 1e6, 'births peaked above 1 million in 2017');
const le = africa.filter((d: any) => at(d).population > 5e6).sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(le[0] === 'TUN' && le[1] === 'DZA', 'second-longest life expectancy in Africa (countries over 5 million), after Tunisia');
const north = wpp.filter((d: any) => d.subregion === 'Northern Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(north.slice(0, 3).join(',') === 'EGY,SDN,DZA', 'third in Northern Africa after Egypt and Sudan');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2090 && natLoss === 2092, 'peak 2090, natural loss from 2092');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(below === 2043 && tfrMax.year === 1967, 'fertility peak 1967; projected under 2.1 from 2043');
assertClaim(c.densityPerKm2 < 21 && y[1950].urbanPct! < 27 && c.urbanPct! > 76, 'about 20 per km²; urban share from about a quarter to over three-quarters');

assertClaim(y[2010].fertility > y[2000].fertility && y[2020].fertility > y[2000].fertility && peak.population > 65e6 && peak.population < 65.5e6, '2010 and 2020 fertility above 2000; peak just above 65 million');
const title = `${(c.population / 1e6).toFixed(1)} Million Algerians on Africa's Largest Territory (${CURRENT_YEAR}) | AtlasFigures`;
const description = `Spread across Africa's biggest land area, the ${millions(c.population)} Algerians counted for mid-${CURRENT_YEAR} average ${int(c.densityPerKm2)} per km². UN data show an unusual fertility rebound and a peak around ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: dz.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, dz.tableYears);

const faq = [
  { q: 'What does Algeria\'s population number in ' + CURRENT_YEAR + '?', a: `About ${millions(c.population)} at mid-year, by UN reckoning: ${ord(c.worldRank!)} worldwide and third in Northern Africa behind Egypt and Sudan.` },
  { q: 'Is there a bigger African country than Algeria by area?', a: `No. In the UN's figures Algeria has the largest land area on the continent, which leaves just ${int(c.densityPerKm2)} people per km² on average. By population it ranks lower within the continent.` },
  { q: 'Did Algeria\'s birth rate go back up?', a: `It did for a while. Fertility fell to ${dec(tfrLow.fertility, 2)} in ${tfrLow.year}, climbed back to ${dec(tfrHigh.fertility, 2)} by ${tfrHigh.year}, and has eased again to ${dec(c.fertility, 2)}.` },
  { q: 'Do Algerians have long life expectancy for Africa?', a: `Yes: a newborn can expect ${dec(c.lifeExpectancy, 1)} years, second in Africa only to Tunisia among countries above five million people.` },
  { q: 'When does Algeria\'s population stop growing?', a: `Around ${peak.year}; the highest projected total is ${millions(peak.population)}, and deaths would begin to outnumber births two years later.` },
];

const schema = countrySchema({
  page: PAGE, slug: dz.slug, name: dz.name, wikipedia: dz.wikipedia,
  headline: `Algeria's ${millions(c.population)} on Africa's largest territory in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Algeria population, density, fertility, life expectancy and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Algeria for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: dz.published, updated: dz.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Algeria"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Algeria', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Algeria: a vast country with a returning baby boom</h1>
        <LiveCounter
          label="Algeria: estimated population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, growing by around ${int(c.change / 365)} people daily`}
        />
        <p class="answer">
          Close to <strong>{millions(c.population)}</strong> Algerians were counted by mid-{CURRENT_YEAR}, a {ord(c.worldRank!)}-place total worldwide, living on the <strong>largest land area in Africa</strong>. Fertility bottomed out at {dec(tfrLow.fertility, 2)} in {tfrLow.year} and then rose again for more than a decade.
        </p>
        <div class="dates"><span>Updated <time datetime={dz.updated}>{longDate(dz.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Algeria" code="dz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why did Algeria's fertility rate rise again after 2002?</h2>
          <p>The UN numbers show the rebound but not what drove it. Fertility had dropped from {dec(tfrMax.fertility, 2)} in {tfrMax.year} to {dec(tfrLow.fertility, 2)} in {tfrLow.year}; it then rose to {dec(tfrHigh.fertility, 2)} by {tfrHigh.year}, a reversal of more than half a child per woman. Births peaked at about {millions(birthTop.births)} in {birthTop.year} and fertility is now back down to {dec(c.fertility, 2)}.</p>
        </div>
        <LineChart
          title="Algerian fertility since 1950: a fall, a rebound, another fall"
          subtitle="Births per woman (UN estimates, then the dashed medium projection); line at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 births' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How thinly populated is Algeria?</h2>
          <p>On average, very: {int(c.densityPerKm2)} people per km², because its land area, about {millions(un.landAreaKm2)} km² by the UN's measure, is the largest of any African country. By Algeria's own definition, {pct(c.urbanPct!)} of people live in urban areas, against {pct(y[1950].urbanPct!)} in 1950.</p>
        </div>
        <div class="age-row" role="group" aria-label="Urban share in Algeria">
          <div><span class="y">1950</span><div class="v">{pct(y[1950].urbanPct!)}</div><span class="d">Urban share</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">Three in four</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{pct(y[2050].urbanPct!)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>Do Algerians live longer than most Africans?</h2>
          <p>Yes. Life expectancy at birth reaches {dec(c.lifeExpectancy, 1)} years, second only to Tunisia's among African countries of more than five million, and up from {dec(y[1950].lifeExpectancy, 1)} in 1950. Half of Algerians are aged under {dec(c.medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Algeria's population going to peak this century?</h2>
          <p>Yes, near {peak.year}, when the projected total levels off at {millions(peak.population)}; natural decrease starts in {natLoss}. Until then growth slows steadily, from {pct(c.growthRatePct)} today. Algeria is the third most populous country in Northern Africa, after Egypt and Sudan.</p>
        </div>
        <LineChart
          title="Algeria's population, 1950–2100: growth easing to a 2090 crest"
          subtitle="Mid-year figures from the UN, dashed once projected; the top is just above 65 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Algeria's population and fertility, 1950–2100"
          subtitle="Fertility in the 2010 and 2020 rows sits above the 2000 row: the rebound in figures."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${dz.slug}-population.csv`)}
          csvName={`${dz.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Algeria's population: what readers ask most</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{dz.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and its projection to 2050.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={dz.published}>{longDate(dz.published)}</time> · Updated <time datetime={dz.updated}>{longDate(dz.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Algeria population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Algeria" code="dz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
