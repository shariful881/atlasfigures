---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import tgo from '../../data/countries/togo.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/); Togo's rows come from the UN interim update of
// 19 January 2026. Story, counts only: the 1993 net outflow and the only fall in the series, with net arrivals in
// 1994–1996; fertility above 2.1 through 2100; growth to 2100 with births rising until 2083; third-densest in Western
// Africa (1 million+); an urban majority from 2034.
const PAGE = '/population/togo/';
const un = countryData(tgo.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (tgo.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1993 && -outTop.netMigrants > 3e5, 'net outflow above 300,000 in 1993');
assertClaim([1994, 1995, 1996].every((n) => y[n].netMigrants > 0), 'net arrivals 1994–1996');
const falls = un.years.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1993', 'only fall 1993');
assertClaim(un.years.every((r) => r.fertility > 2.1), 'fertility above 2.1 through 2100');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1974, 'fertility high 1974');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(birthTop.year === 2083 && peak.year === 2100, 'births peak 2083; still growing 2100');
const times = y[2100].population / c.population;
assertClaim(times > 2.6 && times < 2.8, 'about 2.7 times today by 2100');
const waf1 = wpp.filter((d: any) => d.subregion === 'Western Africa' && at(d).population >= 1e6);
assertClaim([...waf1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 3).map((d: any) => d.iso3).join() === 'GMB,NGA,TGO', 'third-densest in Western Africa after Gambia and Nigeria');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2034, 'urban majority 2034');
const since = c.population / y[1950].population;
assertClaim(since > 6.2 && since < 6.4, 'about 6.3 times 1950');
assertClaim(c.medianAge < 19, 'median under 19');

const title = `Togo Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Exodus in 1993, Fertility Above 2.1 to 2100 | AtlasFigures`;
const description = `The UN's January 2026 update puts Togo at ${millions(c.population)} for ${CURRENT_YEAR}. The series dips only in 1993, a year of large net departures; fertility stays above 2.1 through 2100; by then the projection nears ${millions(y[2100].population)}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: tgo.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
];

const rows = displayRows(un.years, tgo.tableYears);

const faq = [
  { q: 'What caused the 1993 dip in Togo\'s population figures?', a: `Net departures of ${int(-outTop.netMigrants)}, according to the UN, the largest in the series, and the only drop in the mid-year total; net arrivals followed in 1994, 1995 and 1996. It gives no causes.` },
  { q: "Will Togo's fertility rate fall below 2.1?", a: `Not before 2100 on the projection: it is ${dec(c.fertility, 2)} now, down from ${dec(tfrTop.fertility, 2)} in ${tfrTop.year}, and still above 2.1 in the final year.` },
  { q: 'What size could Togo reach by 2100?', a: `${millions(y[2100].population)}, about 2.7 times today, and still rising; annual births keep increasing until ${birthTop.year}.` },
  { q: 'How crowded is Togo for Western Africa?', a: `At ${int(c.densityPerKm2)} per km², only Gambia and Nigeria are denser in the subregion among nations above a million.` },
  { q: 'Which UN figures does this page use for Togo?', a: `The interim update of World Population Prospects 2024 released on 19 January 2026, which replaced the original Togo estimates.` },
];

const schema = countrySchema({
  page: PAGE, slug: tgo.slug, name: tgo.name, wikipedia: tgo.wikipedia,
  headline: `Togo's ${millions(c.population)}: a 1993 outflow, fertility above 2.1 to 2100; a population heading for ${millions(y[2100].population)}`,
  description,
  datasetName: 'Togo population, fertility and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Togo for selected years from 1950 to ${CURRENT_YEAR} (every year 1992–1996 included), with UN medium-variant projections to 2100 from the 19 January 2026 interim update, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: tgo.published, updated: tgo.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Togo"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Togo", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Togo: a young population that keeps on growing</h1>
        <LiveCounter
          label="Togo: estimated population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`From the UN's January 2026 update to World Population Prospects 2024 (mid-${CURRENT_YEAR}), up about ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Togo's {CURRENT_YEAR} population, per the UN's interim update of January 2026, is <strong>{millions(c.population)}</strong>, roughly six times its 1950 level. Half are younger than <strong>{dec(c.medianAge, 1)}</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={tgo.updated}>{longDate(tgo.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Togo" code="tg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>What made Togo's 1993 total lower than 1992's?</h2>
          <p>Because of a large net outflow: {int(-outTop.netMigrants)} people in the UN data, the only year in which the mid-year total declines, by {int(y[1992].population - y[1993].population)} against 1992. Net arrivals followed, {int(y[1994].netMigrants)} in 1994 and {int(y[1995].netMigrants)} in 1995; why, the source does not say.</p>
        </div>
        <div class="age-row" role="group" aria-label="Togo net migration 1993 to 1995 (UN)">
          <div><span class="y">1993</span><div class="v">{int(-y[1993].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">1994</span><div class="v">{int(y[1994].netMigrants)}</div><span class="d">Net arrivals</span></div>
          <div><span class="y">1995</span><div class="v">{int(y[1995].netMigrants)}</div><span class="d">Net arrivals</span></div>
        </div>

        <div class="story-block prose">
          <h2>Does Togo's fertility ever drop below 2.1?</h2>
          <p>Not in the UN projection, which runs to 2100. The fertility rate hit its high, {dec(tfrTop.fertility, 2)}, in {tfrTop.year}, is {dec(c.fertility, 2)} now, and is still above replacement in 2100. Births, {int(c.births)} this year, keep rising until {birthTop.year}.</p>
        </div>
        <LineChart
          title="Togolese fertility, 1950 to 2050"
          subtitle="Births per woman, UN interim update of January 2026; projection dashed, 2.1 shown for reference."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'replacement 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Where does Togo's growth lead by 2100?</h2>
          <p>To {millions(y[2100].population)}, nearly 2.7 times the present figure, with no peak in sight. Already the third-densest Western African nation above one million, after Gambia and Nigeria, at {int(c.densityPerKm2)} per km², Togo is projected to turn majority-urban in {urbanHalf}.</p>
        </div>
        <RelatedPages iso3={tgo.iso3} name={tgo.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Togo by year, 1992 to 1996 complete"
          subtitle="The 1993 row carries the outflow; rows from 2024 are projections from the January 2026 update."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${tgo.slug}-population.csv`)}
          csvName={`${tgo.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common questions about Togo</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{tgo.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, (Togo's rows from the UN's interim update of 19 January 2026, which replaces the original WPP 2024 figures) world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={tgo.published}>{longDate(tgo.published)}</time> · Updated <time datetime={tgo.updated}>{longDate(tgo.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Togo population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Togo" code="tg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
