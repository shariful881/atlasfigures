---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import srb from '../../data/countries/serbia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/), Serbia row only; the UN lists Kosovo (under UNSC
// res. 1244) separately. Story, counts only: a 1987 peak and the longest unbroken decline of any country of a million or
// more (39 years); deaths above births from 1992; the 1999 life-expectancy dip; net departures 2012–2021 and the 2022
// net inflow (largest in the series); 90 men per 100 women; 2100 projection.
const PAGE = '/population/serbia/';
const un = countryData(srb.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (srb.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const streak = (d: any) => { let n = 0; for (let k = CURRENT_YEAR; k > 1950 && at(d, k).population < at(d, k - 1).population; k--) n++; return n; };
assertClaim(streak(wpp.find((d: any) => d.iso3 === 'SRB')) === 39 && [...m1].sort((a: any, b: any) => streak(b) - streak(a))[0].iso3 === 'SRB', '39-year decline, longest among 1M+');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1987, 'peak 1987');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 1992 && un.years.filter((r) => r.year >= 1992).every((r) => r.naturalChange < 0), 'deaths above births every year from 1992');
assertClaim(y[1999].lifeExpectancy < y[1998].lifeExpectancy - 2 && y[2000].lifeExpectancy > y[1998].lifeExpectancy, '1999 dip of over 2 years');
assertClaim(un.years.filter((r) => r.year >= 2012 && r.year <= 2021).every((r) => r.netMigrants < 0), 'net departures 2012–2021');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2022 && inTop.netMigrants > 4e4, 'largest inflow 2022');
assertClaim((c.male / c.female) * 100 < 90.5, 'about 90 men per 100 women');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(a).fertility - at(b).fertility).map((d: any) => d.iso3).indexOf('SRB') > 5, 'fertility not among lowest in Europe');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 0.55 && ratio < 0.57, 'about 56% of today by 2100');

const title = `Serbia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Thirty-Nine Straight Years of Decline | AtlasFigures`;
const description = `Serbia, ${CURRENT_YEAR}: ${millions(c.population)} on the UN's Serbia row; Kosovo is listed separately. The total has fallen every year since 1987: the longest uninterrupted drop among nations above one million, and natural change has been negative since 1992.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: srb.capital },
    { label: 'UN listing', value: 'Serbia; Kosovo (under UNSC res. 1244) listed separately' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
];

const rows = displayRows(un.years, srb.tableYears);

const faq = [
  { q: "Do these Serbia figures include Kosovo?", a: `No. The UN files list Kosovo (under UNSC res. 1244) in a row of its own, and this page uses only the Serbia row.` },
  { q: 'Which country has been shrinking for the longest unbroken stretch?', a: `Among countries over a million people, Serbia: every year from 1988 to ${CURRENT_YEAR}, 39 years, down from ${millions(peak.population)} in 1987.` },
  { q: 'Did Serbia gain migrants in 2022?', a: `Yes, ${int(inTop.netMigrants)} net, the biggest inflow in the UN series, after net departures each year from 2012 to 2021. Why is not recorded.` },
  { q: 'How uneven is the sex balance in Serbia?', a: `Women are the majority, with only ${dec((c.male / c.female) * 100, 1)} men per hundred of them on UN figures.` },
  { q: 'Where is Serbia heading by 2100?', a: `To ${millions(y[2100].population)}, around 56% of today, in the UN's medium scenario.` },
];

const schema = countrySchema({
  page: PAGE, slug: srb.slug, name: srb.name, wikipedia: srb.wikipedia,
  headline: `Serbia's ${millions(c.population)}: 39 years of decline since 1987; deaths above births since 1992; a 2022 inflow`,
  description,
  datasetName: 'Serbia population, fertility and net migration, 1950–2100 (Kosovo listed separately by the UN)',
  datasetDescription: `Mid-year population of Serbia (UN Serbia row; Kosovo under UNSC res. 1244 is listed separately) for selected years from 1950 to ${CURRENT_YEAR}, including 1987, 1988, 1999, 2012, 2019 and 2022, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: srb.published, updated: srb.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Serbia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Serbia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Serbia: a population that has not grown since 1987</h1>
        <LiveCounter
          label="Serbia: live population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024, Serbia row, mid-${CURRENT_YEAR}; the count drops by about ${int(-c.change / 365)} a day`}
        />
        <p class="answer">
          Serbia's {CURRENT_YEAR} total, on the UN's Serbia row (Kosovo is listed separately), is <strong>{millions(c.population)}</strong>. No year has brought growth since 1987 (<strong>{millions(peak.population)}</strong>): a 39-year run unmatched anywhere with a million-plus population.
        </p>
        <div class="dates"><span>Updated <time datetime={srb.updated}>{longDate(srb.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Serbia" code="rs" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why are Serbia's figures shown without Kosovo?</h2>
          <p>Because the UN files list "Kosovo (under UNSC res. 1244)" as a separate row, and every number on this page comes from the Serbia row alone. The page takes no position beyond that listing.</p>
        </div>

        <div class="story-block prose">
          <h2>How long has Serbia been shrinking?</h2>
          <p>Since 1988, without a single year of growth: 39 years, a streak longer than that of any other million-plus country. The top was {millions(peak.population)}, in 1987. Natural change has stayed below zero since 1992: the {CURRENT_YEAR} projection has {int(c.deaths)} deaths and {int(c.births)} births.</p>
        </div>
        <LineChart
          title="Serbia's fertility rate since 1950, against 2.1"
          subtitle="Births per woman; dashed after 2023 for the UN projection."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'level 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What do the UN migration figures show for Serbia?</h2>
          <p>Ten consecutive years of net departures, 2012 through 2021, with {int(-y[2019].netMigrants)} in 2019 alone, then a swing in 2022 to a net inflow of {int(inTop.netMigrants)}, the series high. In {CURRENT_YEAR} the balance is {int(-c.netMigrants)} out. The source counts people; it does not say who they were.</p>
        </div>

        <div class="story-block prose">
          <h2>Did Serbian life expectancy dip in 1999?</h2>
          <p>Yes, to {dec(y[1999].lifeExpectancy, 1)} years from {dec(y[1998].lifeExpectancy, 1)} in 1998, and back at {dec(y[2000].lifeExpectancy, 1)} in 2000; the UN gives no cause. Today it is {dec(c.lifeExpectancy, 1)}. Women outnumber men, who number {dec((c.male / c.female) * 100, 1)} per 100 women; median age: {dec(c.medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>What does 2100 hold for Serbia's head count?</h2>
          <p>{millions(y[2100].population)}, roughly 56% of the present count, is the UN's 2100 figure; for 2050 it gives {millions(y[2050].population)}. Fertility is {dec(c.fertility, 2)} per woman.</p>
        </div>
        <RelatedPages iso3={srb.iso3} name={srb.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Serbia by year, 1987–1988, 1999 and 2012–2022"
          subtitle="The 2022 row holds the one large positive net migration figure."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${srb.slug}-population.csv`)}
          csvName={`${srb.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Serbia, explained in answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{srb.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={srb.published}>{longDate(srb.published)}</time> · Updated <time datetime={srb.updated}>{longDate(srb.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Serbia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Serbia" code="rs" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
