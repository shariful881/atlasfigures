---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import tkm from '../../data/countries/turkmenistan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: an urban share stuck between about 42% and 48%
// from 1950 to 2050; the highest infant mortality and lowest life expectancy in Central Asia; second-lowest density
// there after Kazakhstan; births peaking in 2016; net arrivals in most years since 1999; growth to a 2079 peak.
const PAGE = '/population/turkmenistan/';
const un = countryData(tkm.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (tkm.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const urb = un.years.filter((r) => r.urbanPct != null).map((r) => r.urbanPct!);
assertClaim(Math.min(...urb) > 42 && Math.max(...urb) < 48.5 && urb.every((v) => v < 50), 'urban share between 42% and 48.5% throughout, never a majority');
const cas = wpp.filter((d: any) => d.subregion === 'Central Asia');
assertClaim([...cas].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000)[0].iso3 === 'TKM' && [...cas].sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy)[0].iso3 === 'TKM', 'highest infant mortality, lowest life expectancy in Central Asia');
assertClaim([...cas].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).slice(0, 2).map((d: any) => d.iso3).join() === 'KAZ,TKM', 'second-lowest density after Kazakhstan');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2016, 'births peak 2016');
const since = un.years.filter((r) => r.year >= 1999 && r.year <= CURRENT_YEAR);
assertClaim(since.filter((r) => r.netMigrants > 0).length > since.length * 0.8 && un.years.filter((r) => r.year >= 1990 && r.year <= 1998).every((r) => r.netMigrants <= 0), 'arrivals in most years since 1999, none 1990–1998');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2079, 'peak 2079');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1963 && repl === 2053, 'fertility high 1963, under 2.1 in 2053');
const times = c.population / y[1950].population;
assertClaim(times > 6 && times < 6.2, 'about 6.1 times 1950');
assertClaim([...cas].sort((a: any, b: any) => at(b).population / at(b, 1950).population - at(a).population / at(a, 1950).population).slice(0, 2).map((d: any) => d.iso3).join() === 'TJK,TKM', 'second-fastest growth since 1950 in Central Asia');

const title = `Turkmenistan Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Neither Mostly Urban Nor Mostly Rural Since 1950 | AtlasFigures`;
const description = `UN estimates give Turkmenistan ${millions(c.population)} people for ${CURRENT_YEAR}: about six times the 1950 count. Just under half have lived in urban areas throughout the series, and growth continues until ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: tkm.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, tkm.tableYears);

const faq = [
  { q: "Has Turkmenistan's urban share changed since 1950?", a: `Very little. It was ${pct(y[1950].urbanPct!)} then, is ${pct(c.urbanPct!)} now and should be ${pct(y[2050].urbanPct!)} by 2050, never crossing one half.` },
  { q: 'Is Turkmenistan behind its neighbours on infant deaths and lifespan?', a: `It has the region's highest infant mortality, ${dec(c.infantMortalityPer1000!, 1)} for each 1,000 born alive, and its shortest life expectancy, ${dec(c.lifeExpectancy, 1)} years.` },
  { q: 'When were the most babies born in Turkmenistan?', a: `In ${birthTop.year}, with ${int(birthTop.births)} births; this year the UN expects ${int(c.births)}.` },
  { q: 'Does Turkmenistan gain people from migration?', a: `Slightly, in most years since 1999, with ${int(c.netMigrants)} net in ${CURRENT_YEAR}; from 1990 to 1998 there were no net gains.` },
  { q: 'How high does the Turkmen head count climb?', a: `To ${millions(peak.population)}, reached in ${peak.year}.` },
];

const schema = countrySchema({
  page: PAGE, slug: tkm.slug, name: tkm.name, wikipedia: tkm.wikipedia,
  headline: `Turkmenistan's ${millions(c.population)}: an urban share stuck near half, Central Asia's highest infant mortality, and growth to ${peak.year}`,
  description,
  datasetName: 'Turkmenistan population, urban share and births, 1950–2100',
  datasetDescription: `Mid-year population of Turkmenistan for selected years from 1950 to ${CURRENT_YEAR}, including 1992, 1999 and 2016, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: tkm.published, updated: tkm.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Turkmenistan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Turkmenistan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Turkmenistan: a population split almost evenly between town and country</h1>
        <LiveCounter
          label="Turkmenistan: estimated population, ticking now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Follows the UN World Population Prospects 2024 mid-${CURRENT_YEAR} estimate, adding around ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Turkmenistan's {CURRENT_YEAR} head count is some <strong>{millions(c.population)}</strong> on UN estimates, roughly six times its 1950 total. For three quarters of a century just under half of them have lived in urban areas, <strong>{pct(c.urbanPct!)}</strong> at present.
        </p>
        <div class="dates"><span>Updated <time datetime={tkm.updated}>{longDate(tkm.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Turkmenistan" code="tm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why has Turkmenistan's urban share barely changed?</h2>
          <p>The source records the pattern but not the reason. Counting towns the way Turkmenistan itself does, the share was {pct(y[1950].urbanPct!)} in 1950 and {pct(y[1970].urbanPct!)} in 1970; the {CURRENT_YEAR} reading is {pct(c.urbanPct!)} and the 2050 one {pct(y[2050].urbanPct!)}, all below one half.</p>
        </div>
        <LineChart
          title="Urban share of Turkmenistan's population, 1950–2050"
          subtitle="World Urbanization Prospects 2025, national definition; almost flat throughout, projection dashed."
          points={rows.filter((r) => r.year <= 2050 && r.urbanPct != null).map((r) => ({ x: r.year, y: r.urbanPct!, projection: r.projection }))}
          format="percent"
          highlight={CURRENT_YEAR}
          source="UN World Urbanization Prospects 2025"
          sourceUrl={WUP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How healthy is Turkmenistan by Central Asian standards?</h2>
          <p>Less so than its neighbours on two measures: the region's highest infant mortality ({dec(c.infantMortalityPer1000!, 1)} for every 1,000 born) and its shortest life expectancy ({dec(c.lifeExpectancy, 1)} years).</p>
        </div>

        <div class="story-block prose">
          <h2>Are Turkmen births still rising?</h2>
          <p>No; they peaked at {int(birthTop.births)} in {birthTop.year} and are projected at {int(c.births)} this year. Fertility peaked at {dec(tfrTop.fertility, 2)} ({tfrTop.year}); today's rate is {dec(c.fertility, 2)} and 2.1 arrives in {repl}. Migration adds a little: net gains in most years since 1999, {int(c.netMigrants)} in {CURRENT_YEAR}.</p>
        </div>

        <div class="story-block prose">
          <h2>What population is Turkmenistan heading for?</h2>
          <p>It climbs to {millions(peak.population)} by {peak.year}, then dips slightly to {millions(y[2100].population)} by 2100. Only Tajikistan in Central Asia has grown more since 1950, and only Kazakhstan is more thinly populated than Turkmenistan's {int(c.densityPerKm2)} people per km².</p>
        </div>
        <RelatedPages iso3={tkm.iso3} name={tkm.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Turkmenistan through the decades, with 1992, 1999 and 2016"
          subtitle="The urban column barely moves; births in the 2016 row are the highest."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${tkm.slug}-population.csv`)}
          csvName={`${tkm.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Turkmenistan: frequent questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{tkm.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={tkm.published}>{longDate(tkm.published)}</time> · Updated <time datetime={tkm.updated}>{longDate(tkm.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Turkmenistan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Turkmenistan" code="tm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
