---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import hun from '../../data/countries/hungary.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a 1980 peak, a lower total in every year since
// except 2023; deaths above births every year from 1981 to 2100; today barely above the 1950 count; the 1956 net outflow
// (counts only); births in 2026 the fewest since 1950; fertility low 1.25 in 2011, above 2.1 only in 1974–1977 after 1958.
const PAGE = '/population/hungary/';
const un = countryData(hun.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (hun.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1980, 'peak 1980');
const ups = un.years.filter((r) => r.year > 1980 && r.population >= y[r.year - 1].population).map((r) => r.year);
assertClaim(ups.join() === '2023', 'lower every year since 1980 except 2023');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 1981 && un.years.filter((r) => r.year >= 1981).every((r) => r.naturalChange < 0), 'deaths over births every year from 1981');
const over = c.population / y[1950].population;
assertClaim(over > 1.02 && over < 1.04, 'about 3% above 1950');
const lost = peak.population - c.population;
assertClaim(lost > 1e6 && lost < 1.2e6, 'about 1.1 million below the peak');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(y[1957].population < y[1956].population, 'total fell in 1957');
assertClaim(outTop.year === 1956 && y[1955].netMigrants > 0 && y[1958].netMigrants > 0, 'largest outflow 1956; 1955 and 1958 positive');
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const bLow = est.reduce((a, b) => (b.births < a.births ? b : a));
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bLow.year === CURRENT_YEAR && bTop.year === 1954, 'fewest births this year; most in 1954');
const tLow = est.reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(tLow.year === 2011, 'fertility low 2011');
assertClaim(est.filter((r) => r.year >= 1959 && r.fertility >= 2.1).map((r) => r.year).join() === '1974,1975,1976,1977', 'above 2.1 only 1974–1977 since 1959');
const eeu = wpp.filter((d: any) => d.subregion === 'Eastern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(eeu.indexOf('HUN') === 5, 'sixth in Eastern Europe');

const title = `Hungary Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Past a 1980 Peak, Back Near Its 1950 Size | AtlasFigures`;
const description = `Hungary counts ${millions(c.population)} for ${CURRENT_YEAR} (UN estimate), barely more than in 1950. Its population maximum was in 1980; deaths have exceeded births annually from 1981, and ${CURRENT_YEAR} brings the fewest births on record.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: hun.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, hun.tableYears);

const faq = [
  { q: 'Since what year has Hungary been losing population?', a: `Since 1980, its high-water mark at ${millions(peak.population)}. Each following year's mid-year figure undercuts the last, with 2023 the single exception.` },
  { q: 'Is Hungary smaller now than in 1950?', a: `Not quite: in 1950 Hungary had ${millions(y[1950].population)}, so today's figure is only a few percent higher. For 2100 the projection is ${millions(y[2100].population)}.` },
  { q: 'Since when have deaths exceeded births in Hungary?', a: `Without a break since 1981, a pattern the projection carries through 2100. For ${CURRENT_YEAR}: ${int(c.deaths)} deaths, ${int(c.births)} births.` },
  { q: 'How did 1956 affect Hungarian migration figures?', a: `A net outflow of ${int(-outTop.netMigrants)}, the biggest in the Hungarian series, followed by ${int(-y[1957].netMigrants)} in 1957. The files carry no explanation.` },
  { q: "What was Hungary's lowest fertility rate?", a: `${dec(tLow.fertility, 2)} in ${tLow.year}. It is ${dec(c.fertility, 2)} today.` },
];

const schema = countrySchema({
  page: PAGE, slug: hun.slug, name: hun.name, wikipedia: hun.wikipedia,
  headline: `Hungary's ${millions(c.population)}: a 1980 peak, deaths ahead of births since 1981, and a total close to 1950's`,
  description,
  datasetName: 'Hungary population, births and deaths, 1950–2100',
  datasetDescription: `Mid-year population of Hungary for selected years from 1950 to ${CURRENT_YEAR}, including 1954–1957, 1980–1981, 2011 and 2022–2024, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: hun.published, updated: hun.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Hungary"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Hungary", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Hungary: decline since 1980, back near the 1950 mark</h1>
        <LiveCounter
          label="Hungary: estimated population at the present time"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 mid-${CURRENT_YEAR} level, minus about ${int(-c.change / 365)} people a day`}
        />
        <p class="answer">
          Hungary's {CURRENT_YEAR} total, <strong>{millions(c.population)}</strong> by UN estimate, only slightly exceeds the {millions(y[1950].population)} of 1950. It reached {millions(peak.population)} in 1980; the count has dropped almost every year since.
        </p>
        <div class="dates"><span>Updated <time datetime={hun.updated}>{longDate(hun.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Hungary" code="hu" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>For how many years has Hungary been shrinking?</h2>
          <p>More than four decades. The UN series tops out in 1980, and each year's estimate after that comes in below its predecessor, apart from 2023. Today's figure sits {millions(lost)} under the peak and just a few percent over 1950.</p>
        </div>
        <LineChart
          title="Hungary's population from 1950, peaking in 1980"
          subtitle="UN estimates up to 2023 and the dashed projection after that."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How long have Hungarian deaths outnumbered births?</h2>
          <p>Every single year since 1981, and the projection never reverses it; the UN data give no reason. This year brings {int(c.deaths)} deaths and {int(c.births)} births, the births the fewest recorded for any year from 1950; the most were {int(bTop.births)}, in {bTop.year}. After 1958 fertility returned to 2.1 only between 1974 and 1977; it touched {dec(tLow.fertility, 2)} in {tLow.year} and is {dec(c.fertility, 2)} now.</p>
        </div>
        <div class="age-row" role="group" aria-label="Hungary, births in 1954 and now, and deaths now (UN)">
          <div><span class="y">{bTop.year}</span><div class="v">{int(bTop.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.deaths)}</div><span class="d">Deaths</span></div>
        </div>

        <div class="story-block prose">
          <h2>What does 1956 look like in Hungary's population data?</h2>
          <p>A one-off exodus: departures exceed arrivals by {int(-outTop.netMigrants)} in 1956 and {int(-y[1957].netMigrants)} in 1957, while 1955 and 1958 both show small net gains. The 1957 total came in lower than 1956's. Only the numbers appear in the UN files.</p>
        </div>

        <div class="story-block prose">
          <h2>What lies ahead for Hungary's population?</h2>
          <p>Continued decline: {millions(y[2050].population)} is the 2050 projection, {millions(y[2100].population)} the 2100 one. Sixth in Eastern Europe by population, Hungary has {int(c.densityPerKm2)} people per km², and half its residents are over {dec(c.medianAge, 1)}.</p>
        </div>
        <RelatedPages iso3={hun.iso3} name={hun.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Hungary in figures: the 1950s, the 1980 high and recent years"
          subtitle="The 1956 row shows the outflow; from 1981 deaths outnumber births in every row."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${hun.slug}-population.csv`)}
          csvName={`${hun.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Hungary: questions on its population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{hun.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={hun.published}>{longDate(hun.published)}</time> · Updated <time datetime={hun.updated}>{longDate(hun.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Hungary population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Hungary" code="hu" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
