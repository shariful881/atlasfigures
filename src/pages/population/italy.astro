---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import it from '../../data/countries/italy.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a decline under way since 2014, very few births, the second-oldest large population.
const PAGE = '/population/italy/';
const un = countryData(it.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (it.verification as any).checkedOn as string | undefined;

const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2014, 'peak in 2014');
assertClaim(un.years.filter((r) => r.year > peak.year).every((r) => r.change < 0), 'smaller every year after 2014, estimates and projection');
const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const oldest = wpp.filter((d: any) => at(d).population > 5e6).sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).map((d: any) => d.iso3);
assertClaim(oldest[0] === 'JPN' && oldest[1] === 'ITA', 'second-highest median age among countries over 5 million, after Japan');
const lowEu = wpp.filter((d: any) => d.region === 'Europe' && at(d).population > 5e6).sort((a: any, b: any) => at(a).fertility - at(b).fertility).map((d: any) => d.iso3);
assertClaim(lowEu[0] === 'UKR' && lowEu[1] === 'ITA', 'second-lowest fertility in Europe among countries over 5 million, after Ukraine');
const falls = wpp.filter((d: any) => at(d).population > 20e6).sort((a: any, b: any) => at(a, 2100).population / at(a).population - at(b, 2100).population / at(b).population).map((d: any) => d.iso3);
assertClaim(falls.indexOf('ITA') === 5, 'sixth-steepest projected fall to 2100 among countries over 20 million');
const est = un.years.filter((r) => !r.projection);
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1964 && birthTop.births > 1e6 && c.births < birthTop.births * 0.4, 'over 1 million births in 1964; fewer than four in ten of that now');
assertClaim(c.naturalChange < 0 && c.netMigrants > 0 && c.netMigrants < Math.abs(c.naturalChange) / 4, 'net migration covers less than a quarter of the natural loss');
const firstNat = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(firstNat === 1993 && est.filter((r) => r.year >= 1993 && r.naturalChange < 0).length >= 25, 'deaths first above births in 1993, and in most years since');
const left = (1 - y[2100].population / c.population) * 100;
assertClaim(Math.abs(left - 40) < 0.5, 'about 40% smaller by 2100');
const south = wpp.filter((d: any) => d.subregion === 'Southern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(south[0] === 'ITA', 'most populous country in Southern Europe');

const title = `Italy's Shrinking Population: ${(c.population / 1e6).toFixed(1)} Million in ${CURRENT_YEAR}, Down Since ${peak.year} | AtlasFigures`;
const description = `Italy has fewer residents every year since its ${peak.year} high: ${millions(c.population)} at mid-${CURRENT_YEAR}, as roughly ${int(Math.round(c.births / 1000))} thousand babies are born and ${int(Math.round(c.deaths / 1000))} thousand people die each year. UN figures and projections to 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: it.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, it.tableYears);

const faq = [
  { q: 'How many residents does Italy count in this year?', a: `The UN's mid-${CURRENT_YEAR} figure is close to ${millions(c.population)}, placing Italy ${ord(c.worldRank!)} globally and first in Southern Europe.` },
  { q: 'When did Italy start losing population?', a: `After ${peak.year}, when the UN estimate topped out at ${millions(peak.population)}. Every year since has been smaller, and the medium projection keeps it that way to 2100.` },
  { q: 'Why does Italy have so few babies?', a: `The UN data show the result rather than the reasons: a fertility rate of ${dec(c.fertility, 2)} and roughly ${int(Math.round(c.births / 1000))} thousand newborns this year, compared with more than 1 million in ${birthTop.year}.` },
  { q: 'Is Italy older than the rest of Europe?', a: `Apart from a few microstates, yes. Its median age of ${dec(c.medianAge, 1)} leads all European countries above 5 million people and is second only to Japan in that size group.` },
  { q: 'How small could Italy get by 2100?', a: `The UN medium projection gives ${millions(y[2100].population)}, ${pct(left)} fewer than now, enough to push Italy down to ${ord(y[2100].worldRank!)} place worldwide.` },
];

const schema = countrySchema({
  page: PAGE, slug: it.slug, name: it.name, wikipedia: it.wikipedia,
  headline: `Italy has been shrinking since ${peak.year}: ${millions(c.population)} residents in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Italy population, births, deaths, ageing and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Italy for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: it.published, updated: it.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Italy"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Italy', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Italy, a population past its high point</h1>
        <LiveCounter
          label="Italy: estimated residents at this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} total, falling by roughly ${int(Math.abs(c.change) / 365)} residents a day`}
        />
        <p class="answer">
          Italy counts about <strong>{millions(c.population)}</strong> residents at mid-{CURRENT_YEAR} ({ord(c.worldRank!)} worldwide), and the number has gone down every year since {peak.year}. For each Italian birth there are now <strong>about {dec(c.deaths / c.births, 1)} deaths</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={it.updated}>{longDate(it.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Italy" code="it" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How quickly is Italy losing people?</h2>
          <p>By about {int(Math.round(Math.abs(c.change) / 1000))} thousand residents in {CURRENT_YEAR}, a fall of {pct(Math.abs(c.growthRatePct))}. The UN puts the high at {millions(peak.population)} in {peak.year}; each year after it is lower. Deaths have outnumbered births in most years since {firstNat}, and immigration now offsets less than a quarter of that gap: a migration surplus near {int(Math.round(c.netMigrants / 1000))} thousand set against a natural loss of about {int(Math.round(Math.abs(c.naturalChange) / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Italy's population, 1950–2100: a 2014 high, then a long slide"
          subtitle="UN mid-year counts; after 2026 the dashed projection sinks toward 35 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many babies are Italians having compared with the 1960s?</h2>
          <p>Fewer than four for every ten born at the peak. Italy recorded more than 1 million births in {birthTop.year}; the UN estimate for {CURRENT_YEAR} is about {int(Math.round(c.births / 1000))} thousand, set against some {int(Math.round(c.deaths / 1000))} thousand deaths. Fertility is {dec(c.fertility, 2)} per woman, against {dec(birthTop.fertility, 2)} in {birthTop.year}, and in Europe only Ukraine is lower among countries above 5 million.</p>
        </div>
        <LineChart
          title="Italian fertility, 1950 to 2050"
          subtitle="Births per woman, UN estimates and projection (dashed); the reference line marks 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 level' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Italy's population the oldest of any large European country?</h2>
          <p>Yes, by median age. Half of Italy's residents are older than {dec(c.medianAge, 1)}, the top figure among European nations above 5 million and behind only Japan in that group worldwide. The figure was {dec(y[1950].medianAge, 1)} in 1950 and is projected at {dec(y[2050].medianAge, 1)} in 2050. Newborns, meanwhile, can count on {dec(c.lifeExpectancy, 1)} years of life where their 1950 counterparts could expect {dec(y[1950].lifeExpectancy, 1)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Italy">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Oldest big European country</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Past 50</span></div>
        </div>

        <div class="story-block prose">
          <h2>What could Italy's population be at the end of this century?</h2>
          <p>Around {millions(y[2100].population)}, {pct(left)} below today, in the UN's medium variant. Of the nations now above 20 million, only five shrink faster in proportion, and Italy would drop from {ord(c.worldRank!)} to {ord(y[2100].worldRank!)} place globally. It still has the largest population in Southern Europe; {pct(c.urbanPct!)} live in areas Italy classifies as urban.</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Italy's numbers every ten years, 1950 to 2100"
          subtitle="UN estimates up to now and the medium projection after that."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${it.slug}-population.csv`)}
          csvName={`${it.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Short answers on Italy's population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{it.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={it.published}>{longDate(it.published)}</time> · Updated <time datetime={it.updated}>{longDate(it.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Italy population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Italy" code="it" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
