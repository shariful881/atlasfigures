---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import tjk from '../../data/countries/tajikistan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: an urban share (national definition) that peaked
// in 1970 and is projected to keep slipping to 2050; the early-1990s fall in life expectancy and net departures every year
// since 1989 (counts only, no causes); the youngest median age in Central Asia; growth through 2100.
const PAGE = '/population/tajikistan/';
const un = countryData(tjk.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (tjk.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const urbTop = un.years.filter((r) => r.year <= CURRENT_YEAR && r.urbanPct != null).reduce((a, b) => (b.urbanPct! > a.urbanPct! ? b : a));
assertClaim(urbTop.year === 1970 && c.urbanPct! < urbTop.urbanPct! - 10 && y[2050].urbanPct! < c.urbanPct!, 'urban share high 1970, 10+ points lower now, lower still by 2050');
assertClaim(un.years.every((r) => r.urbanPct == null || r.urbanPct < 50), 'never an urban majority to 2050');
assertClaim([...big].sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3).indexOf('TJK') === 6, 'seventh-lowest urban share among 10M+');
assertClaim(y[1993].lifeExpectancy < y[1991].lifeExpectancy - 6 && y[1995].lifeExpectancy < y[1991].lifeExpectancy, 'life expectancy down 6+ years 1991–1993');
const leLow = un.years.filter((r) => r.year >= 1980 && r.year <= CURRENT_YEAR).reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1993, 'low since 1980 in 1993');
const firstOut = un.years.find((r) => r.netMigrants < 0)!.year;
assertClaim(firstOut === 1979 && un.years.filter((r) => r.year >= 1989).every((r) => r.netMigrants < 0), 'net departures from 1979, every year since 1989');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1998, 'largest outflow 1998');
const cas = wpp.filter((d: any) => d.subregion === 'Central Asia');
assertClaim([...cas].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge)[0].iso3 === 'TJK', 'youngest in Central Asia');
assertClaim([...cas].sort((a: any, b: any) => at(b).fertility - at(a).fertility).slice(0, 2).map((d: any) => d.iso3).join() === 'UZB,TJK', 'second-highest fertility in Central Asia');
assertClaim([...cas].sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3).slice(0, 3).join() === 'UZB,KAZ,TJK', 'third in Central Asia after Uzbekistan and Kazakhstan');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1968, 'fertility high 1968');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2068, 'below 2.1 in 2068');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2040, 'births peak 2040');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100 && y[2100].population > 1.8 * c.population && y[2100].population < 2 * c.population, 'still growing in 2100, close to double');
assertClaim(c.urbanPct! > 24 && c.urbanPct! < 28, 'about one in four urban');
assertClaim(c.female > c.male, 'more women than men');

const title = `Tajikistan Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Young, Mostly Rural and Becoming More So | AtlasFigures`;
const description = `UN estimate for Tajikistan, ${CURRENT_YEAR}: ${millions(c.population)} people. The urban share is ${pct(c.urbanPct!)}, below the ${pct(urbTop.urbanPct!)} of 1970, and a median of ${dec(c.medianAge, 1)} years makes its people the youngest in Central Asia.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: tjk.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, tjk.tableYears);

const faq = [
  { q: 'Is Tajikistan becoming less urban?', a: `On the national definition, yes: urban residents were ${pct(urbTop.urbanPct!)} of the population in 1970, are ${pct(c.urbanPct!)} today and are projected at ${pct(y[2050].urbanPct!)} in 2050 by World Urbanization Prospects 2025.` },
  { q: 'Did Tajiks live shorter lives in the early 1990s?', a: `Yes, in the UN estimates life expectancy fell from ${dec(y[1991].lifeExpectancy, 1)} in 1991 to ${dec(leLow.lifeExpectancy, 1)} in ${leLow.year}, with deaths climbing from ${int(y[1991].deaths)} to ${int(y[1993].deaths)}. The files record no cause.` },
  { q: 'Has Tajikistan been losing people to migration?', a: `Yes, on balance, every year since 1989. The biggest net loss, ${int(-outTop.netMigrants)}, came in ${outTop.year}; this year's is ${int(-c.netMigrants)}.` },
  { q: 'Which Central Asian country has the youngest population?', a: `Tajikistan: its median resident is ${dec(c.medianAge, 1)}. Its fertility, ${dec(c.fertility, 2)}, is the region's second-highest after Uzbekistan.` },
  { q: "Is Tajikistan's growth expected to continue?", a: `Yes, all the way to 2100: by 2050 the medium variant expects ${millions(y[2050].population)}, and by 2100 ${millions(y[2100].population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: tjk.slug, name: tjk.name, wikipedia: tjk.wikipedia,
  headline: `Tajikistan's ${millions(c.population)}: a shrinking urban share, the early-1990s mortality rise, and Central Asia's youngest people`,
  description,
  datasetName: 'Tajikistan population, urban share and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Tajikistan for selected years from 1950 to ${CURRENT_YEAR} (every year 1989–1995 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: tjk.published, updated: tjk.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Tajikistan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Tajikistan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Tajikistan: young, rural and growing</h1>
        <LiveCounter
          label="Tajikistan: estimated head count right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Derived from UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), about ${int(c.change / 365)} more residents per day`}
        />
        <p class="answer">
          About <strong>{millions(c.population)}</strong> people are estimated to live in Tajikistan in {CURRENT_YEAR}, and roughly three in four of them live outside urban areas. Its median age, <strong>{dec(c.medianAge, 1)}</strong>, is Central Asia's lowest.
        </p>
        <div class="dates"><span>Updated <time datetime={tjk.updated}>{longDate(tjk.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Tajikistan" code="tj" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Tajikistan's urban share going down?</h2>
          <p>The UN figures show the trend but do not explain it. Under the national definition, urban residents peaked at {pct(urbTop.urbanPct!)} in {urbTop.year}, slipped to {pct(y[1990].urbanPct!)} in 1990 and stand at {pct(c.urbanPct!)} now; the 2050 projection is {pct(y[2050].urbanPct!)}. Just six countries with populations above ten million have a smaller urban share.</p>
        </div>
        <LineChart
          title="Share of Tajikistan's population classed as urban, 1950–2050"
          subtitle="National definition, World Urbanization Prospects 2025; the high point is 1970 and the projection (dashed) keeps falling."
          points={rows.filter((r) => r.year <= 2050 && r.urbanPct != null).map((r) => ({ x: r.year, y: r.urbanPct!, projection: r.projection }))}
          format="percent"
          highlight={CURRENT_YEAR}
          source="UN World Urbanization Prospects 2025"
          sourceUrl={WUP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Did deaths in Tajikistan rise in the early 1990s?</h2>
          <p>Yes, sharply. Life expectancy slides from {dec(y[1991].lifeExpectancy, 1)} in 1991 to {dec(leLow.lifeExpectancy, 1)} in {leLow.year}, and deaths go from {int(y[1991].deaths)} to {int(y[1993].deaths)}. Net departures, first recorded in {firstOut}, have continued every year since 1989; they were {int(-y[1992].netMigrants)} in 1992 and reached their largest, {int(-outTop.netMigrants)}, in {outTop.year}. The files give counts only, not causes.</p>
        </div>

        <div class="story-block prose">
          <h2>Does Tajikistan have Central Asia's youngest population?</h2>
          <p>Younger than any neighbour in Central Asia, at a median of {dec(c.medianAge, 1)}. Women average {dec(c.fertility, 2)} children, second in the region to Uzbekistan, down from {dec(tfrTop.fertility, 2)} in {tfrTop.year}, with 2.1 not reached until {repl} in the projection. Annual births, {int(c.births)} this year, go on rising until {birthTop.year}. There are slightly more women than men: the sex ratio is {dec((c.male / c.female) * 100, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How many people could Tajikistan have in 2100?</h2>
          <p>Close to double today's number: {millions(y[2100].population)}, still climbing, with {millions(y[2050].population)} passed on the way at mid-century. Of the five Central Asian states, only Uzbekistan and Kazakhstan are more populous now.</p>
        </div>
        <RelatedPages iso3={tjk.iso3} name={tjk.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Tajikistan by year, 1989–1995 shown in full"
          subtitle="Rows for the early 1990s carry the mortality rise; the urban column falls from its 1970 high."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${tjk.slug}-population.csv`)}
          csvName={`${tjk.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Tajikistan: quick facts in answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{tjk.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={tjk.published}>{longDate(tjk.published)}</time> · Updated <time datetime={tjk.updated}>{longDate(tjk.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Tajikistan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Tajikistan" code="tj" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
