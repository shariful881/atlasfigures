---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import svn from '../../data/countries/slovenia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peak in 2024 after growth in every year
// 1999–2024, decline in every projected year from 2025; a fall 1992–1998; deaths above births every year since 2017;
// births from 34,150 (1953, the most) to 16,897 (2026, the fewest); median age 45.0, thirteenth-highest of 1M+
// countries; life expectancy 82.1; fertility under 2.1 since 1981, lowest in 2003; the largest net inflow in 1986.
const PAGE = '/population/slovenia/';
const un = countryData(svn.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (svn.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2024 && un.years.filter((r) => r.year >= 1999 && r.year <= 2024).every((r) => r.population > y[r.year - 1].population) && un.years.filter((r) => r.year >= 2025).every((r) => r.population < y[r.year - 1].population), 'rise 1999–2024, peak 2024, fall after');
assertClaim(un.years.filter((r) => r.year >= 1992 && r.year <= 1998).every((r) => r.population < y[r.year - 1].population), 'fall 1992–1998');
assertClaim(un.years.filter((r) => r.year >= 2017).every((r) => r.naturalChange < 0) && y[2016].naturalChange >= 0, 'natural decrease from 2017');
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(bTop.year === 1953 && bLow.year === CURRENT_YEAR && c.births < bTop.births / 2, 'births 1953 to now, under half');
const s1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...s1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).findIndex((d: any) => d.iso3 === 'SVN') === 12, 'thirteenth-highest median age');
const tfrLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(tfrLow.year === 2003 && un.years.filter((r) => r.year >= 1981).every((r) => r.fertility < 2.1) && y[1980].fertility >= 2.1, 'under 2.1 from 1981, low 2003');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1986, 'largest inflow 1986');

const title = `Slovenia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Alpine Republic Just Past a 2024 Peak | AtlasFigures`;
const description = `Slovenia's ${CURRENT_YEAR} UN estimate, ${millions(c.population)}, sits fractionally under its 2024 maximum. From 2017 onward deaths have exceeded births, and ${CURRENT_YEAR} should see ${int(c.births)} births: under half the 1953 total.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: svn.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, svn.tableYears);

const faq = [
  { q: "When did Slovenia's population reach its maximum?", a: `2024, at ${millions(peak.population)}, after rising annually from 1999; every later year in the projection comes in below it.` },
  { q: 'Slovenian births: 1953 versus now?', a: `${int(c.births)} expected for ${CURRENT_YEAR}, the record low, versus ${int(bTop.births)} in 1953.` },
  { q: 'Since when have Slovenian deaths exceeded births?', a: `Annually from 2017, and the UN projects no reversal before 2100.` },
  { q: 'How old is the midpoint Slovenian?', a: `${dec(c.medianAge, 1)} years, thirteenth-highest among nations above a million; life expectancy is ${dec(c.lifeExpectancy, 1)}.` },
  { q: 'Did Slovenia shrink in the 1990s?', a: `Slightly, across 1992–1998; growth then resumed in 1999.` },
];

const schema = countrySchema({
  page: PAGE, slug: svn.slug, name: svn.name, wikipedia: svn.wikipedia,
  headline: `Slovenia's ${millions(c.population)}: a 2024 peak; natural decrease since 2017; the fewest births on record in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Slovenia population, births and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Slovenia for selected years from 1950 to ${CURRENT_YEAR}, including 1953, 1986, 1991–1992, 1998, 2003, 2016–2017 and 2024–2025, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: svn.published, updated: svn.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Slovenia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Slovenia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Slovenia: turning the corner after a 2024 high</h1>
        <LiveCounter
          label="Slovenia: running estimate of residents"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Projected on from UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), dipping by about ${int(-c.change / 365)} a day`}
        />
        <p class="answer">
          On UN figures, {CURRENT_YEAR} finds Slovenia at <strong>{millions(c.population)}</strong>, a fraction below the summit it reached in <strong>2024</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={svn.updated}>{longDate(svn.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Slovenia" code="si" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is Slovenia now past its population summit?</h2>
          <p>Yes, from 2025. The summit came in 2024 ({millions(peak.population)}), ending 26 straight years of increases that began in 1999. The line drifts down: {millions(y[2050].population)} as 2050 arrives; {millions(y[2100].population)} by century's end. An earlier dip ran 1992–1998.</p>
        </div>
        <LineChart
          title="Slovenia's population, 1950–2100, cresting in 2024"
          subtitle="Mid-year totals; dashed after 2023 for projections."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How have Slovenian births changed?</h2>
          <p>They have more than halved: {int(bTop.births)} in 1953, the record, against {int(c.births)} expected in {CURRENT_YEAR}, the fewest anywhere in the series. Births per woman dropped below 2.1 in 1981, have stayed there, bottomed out in 2003 and currently measure {dec(c.fertility, 2)}. From 2017 every year registers more deaths than births.</p>
        </div>

        <div class="story-block prose">
          <h2>What are Slovenian lifespans like?</h2>
          <p>{dec(c.lifeExpectancy, 1)} years on average; the median age, {dec(c.medianAge, 1)}, ranks thirteenth-highest among million-plus nations. Migration has mostly added residents, with 1986 holding the biggest net gain, {int(inTop.netMigrants)}.</p>
        </div>
        <RelatedPages iso3={svn.iso3} name={svn.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Slovenia: 1953, 1986, 1991–1998, 2016–2017, 2024–2025"
          subtitle="Births peak in the 1953 row; the 2024 row marks the summit."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${svn.slug}-population.csv`)}
          csvName={`${svn.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Slovenia: questions and UN answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{svn.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={svn.published}>{longDate(svn.published)}</time> · Updated <time datetime={svn.updated}>{longDate(svn.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Slovenia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Slovenia" code="si" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
