---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import dom from '../../data/countries/dominican-republic.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: net departures in every year 1950–2100 yet
// growth until 2061; the largest fertility fall since 1956 in Latin America and the Caribbean (1 million+); an urban
// share (national definition) that peaked in 2011 and is slightly lower now; women in the majority since 2003; larger
// than Haiti from 1977 to 2012.
const PAGE = '/population/dominican-republic/';
const un = countryData(dom.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (dom.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(un.years.every((r) => r.netMigrants < 0), 'net departures every year 1950–2100');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2006, 'largest net outflow 2006');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2061, 'peak 2061');
const times = c.population / y[1950].population;
assertClaim(times > 4.8 && times < 4.9, 'nearly five times 1950');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1956, 'fertility high 1956');
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
const fall = (d: any) => at(d, 1956).fertility - at(d).fertility;
assertClaim([...lac1].sort((a: any, b: any) => fall(b) - fall(a))[0].iso3 === 'DOM', 'largest fertility fall since 1956 in LAC (1M+)');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2030, 'below 2.1 in 2030');
const urbTop = un.years.filter((r) => r.year <= CURRENT_YEAR && r.urbanPct != null).reduce((a, b) => (b.urbanPct! > a.urbanPct! ? b : a));
assertClaim(urbTop.year === 2011 && c.urbanPct! < urbTop.urbanPct! - 1 && y[2050].urbanPct! > 89, 'urban share peaked 2011, lower now, above 89% by 2050');
const womenMore = un.years.filter((r) => r.female > r.male).map((r) => r.year);
assertClaim(womenMore[0] === 2003 && womenMore.length === 2100 - 2002, 'women in the majority every year from 2003');
const hti = wpp.find((d: any) => d.iso3 === 'HTI');
const ahead = un.years.filter((r) => r.population > at(hti, r.year).population).map((r) => r.year);
assertClaim(ahead.join() === Array.from({ length: 36 }, (_, i) => 1977 + i).join(), 'larger than Haiti 1977–2012');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1993, 'births peak 1993');
assertClaim([...lac1].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000).slice(0, 3).map((d: any) => d.iso3).join() === 'HTI,BOL,DOM', 'third-highest infant mortality in LAC');
const car = wpp.filter((d: any) => d.subregion === 'Caribbean').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(car.indexOf('DOM') === 1, 'second in the Caribbean');

const title = `Dominican Republic Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Departures Every Year, Growth Until ${peak.year} | AtlasFigures`;
const description = `By UN estimates, ${CURRENT_YEAR} finds the Dominican Republic with ${millions(c.population)} people, almost five times its 1950 count, despite net emigration in each year of the series; births per woman have gone from ${dec(tfrTop.fertility, 2)} to ${dec(c.fertility, 2)}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: dom.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, dom.tableYears);

const faq = [
  { q: 'What is the population of the Dominican Republic?', a: `${millions(c.population)}, the UN's ${CURRENT_YEAR} estimate: ${ord(c.worldRank!)} worldwide and second in the Caribbean, after Haiti.` },
  { q: 'Do more people leave the Dominican Republic than move there?', a: `Every year, 1950 through 2100, shows a net outflow. The biggest, ${int(-outTop.netMigrants)}, is estimated for ${outTop.year}; the ${CURRENT_YEAR} figure is ${int(-c.netMigrants)}.` },
  { q: 'How far has Dominican fertility fallen?', a: `From ${dec(tfrTop.fertility, 2)} per woman in ${tfrTop.year} to ${dec(c.fertility, 2)} now. No other country in the region with over a million inhabitants has seen a bigger drop over that period, and the rate is expected under 2.1 by ${repl}.` },
  { q: 'Was the Dominican Republic ever bigger than Haiti?', a: `For 36 years: 1977 through 2012. In 2013 Haiti moved back in front.` },
  { q: 'Is the Dominican Republic becoming more urban?', a: `Over the long run, yes, but on the national definition the urban share peaked at ${pct(urbTop.urbanPct!)} in ${urbTop.year}, slipping to ${pct(c.urbanPct!)} since, while World Urbanization Prospects 2025 puts 2050 at ${pct(y[2050].urbanPct!)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: dom.slug, name: dom.name, wikipedia: dom.wikipedia,
  headline: `The Dominican Republic's ${millions(c.population)}: departures in every year, fertility down from ${dec(tfrTop.fertility, 2)}, and a peak in ${peak.year}`,
  description,
  datasetName: 'Dominican Republic population, fertility and net migration, 1950–2100',
  datasetDescription: `Mid-year population of the Dominican Republic for selected years from 1950 to ${CURRENT_YEAR}, including 1956, 1977, 1993, 2003, 2006, 2011 and 2013, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: dom.published, updated: dom.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Dominican Republic"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Dominican Republic", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Dominican Republic: emigration every year, and still growing</h1>
        <LiveCounter
          label="Dominican Republic: estimated population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Mid-${CURRENT_YEAR} UN World Population Prospects 2024 figure, growing by roughly ${int(c.change / 365)} each day`}
        />
        <p class="answer">
          In {CURRENT_YEAR} the Dominican Republic counts <strong>{millions(c.population)}</strong> inhabitants (UN estimate), nearly five times its 1950 total of {millions(y[1950].population)}. Every year since then has seen more emigrants than immigrants, but births still outnumber deaths and departures combined.
        </p>
        <div class="dates"><span>Updated <time datetime={dom.updated}>{longDate(dom.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Dominican Republic" code="do" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How can the Dominican Republic grow if more people leave than arrive?</h2>
          <p>Births make up the difference. This year's projection: {int(c.births)} born, {int(c.deaths)} dying, so a natural gain of {int(c.naturalChange)} that more than covers {int(-c.netMigrants)} net departures. Emigration exceeds immigration across the full 1950–2100 span, most of all in {outTop.year} ({int(-outTop.netMigrants)}), yet the medium variant keeps the population rising until {peak.year} and a high of {millions(peak.population)}.</p>
        </div>
        <LineChart
          title="Dominican Republic population since 1950, with UN projections"
          subtitle="Mid-year estimates; the dashed medium variant rises to a 2061 peak, then declines to 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How much has fertility fallen in the Dominican Republic?</h2>
          <p>Faster than in any other country of the region above one million people: it was {dec(tfrTop.fertility, 2)} per woman in {tfrTop.year} and is {dec(c.fertility, 2)} today, with a drop below 2.1 projected for {repl}. Annual births topped out at {int(birthTop.births)} in {birthTop.year}. Only Haiti and Bolivia, in that same group, lose more infants: in the first year of life, {dec(c.infantMortalityPer1000!, 1)} of every 1,000 die.</p>
        </div>
        <LineChart
          title="Fertility in the Dominican Republic, 1950–2050"
          subtitle="Peak in 1956, the 2.1 line marked, projections dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'level of 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is the Dominican Republic's urban share falling?</h2>
          <p>Slightly, for now. Under the national definition, the urban share rose from {pct(y[1950].urbanPct!)} in 1950 to a high of {pct(urbTop.urbanPct!)} in {urbTop.year}; today it is {pct(c.urbanPct!)}. World Urbanization Prospects 2025 projects a renewed rise, to {pct(y[2050].urbanPct!)} by 2050.</p>
        </div>

        <div class="story-block prose">
          <h2>Are women the majority in the Dominican Republic?</h2>
          <p>They have been since 2003. The {CURRENT_YEAR} estimate gives a sex ratio of {dec((c.male / c.female) * 100, 1)}, meaning that many men to each 100 women. On the island it shares with Haiti, the Dominican side held the larger population from 1977 to 2012; it is now second in the Caribbean, with {int(c.densityPerKm2)} people per km².</p>
        </div>
        <RelatedPages iso3={dom.iso3} name={dom.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="The Dominican Republic over time, 1956 to the 2061 peak"
          subtitle="Includes the 1956 fertility high, the 1993 birth peak and the 2011 urban high."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${dom.slug}-population.csv`)}
          csvName={`${dom.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Dominican Republic: answers to common questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{dom.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={dom.published}>{longDate(dom.published)}</time> · Updated <time datetime={dom.updated}>{longDate(dom.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Dominican Republic population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Dominican Republic" code="do" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
