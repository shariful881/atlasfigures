---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import tw from '../../data/countries/taiwan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/), where this area is listed as "China, Taiwan
// Province of China". Neutral wording: the page uses the common English name and the UN's listing, takes no position on
// status and calls comparisons "countries or areas". Story: fertility below 1 (the world's lowest in 2010), a 2019 peak,
// deaths above births since 2019, a projected fall of more than half by 2100, very high density, rapid ageing.
const PAGE = '/population/taiwan/';
const un = countryData(tw.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (tw.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const tfr10 = [...wpp].sort((a: any, b: any) => at(a, 2010).fertility - at(b, 2010).fertility).map((d: any) => d.iso3);
assertClaim(tfr10[0] === 'TWN', 'lowest fertility of any country or area in 2010');
const tfrNow = [...wpp].sort((a: any, b: any) => at(a).fertility - at(b).fertility).map((d: any) => d.iso3);
assertClaim(tfrNow.slice(0, 5).join() === 'MAC,HKG,KOR,BLM,TWN', 'fifth-lowest fertility now');
assertClaim(un.years.filter((r) => r.year >= 2020 && r.year <= CURRENT_YEAR).every((r) => r.fertility < 1), 'fertility below 1 every year since 2020');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2019 && natNeg === 2019 && un.years.filter((r) => r.year >= 2019).every((r) => r.naturalChange < 0), 'peak 2019; deaths above births every year since 2019');
const fall = 1 - y[2100].population / c.population;
const falls = big.map((d: any) => ({ iso3: d.iso3, f: 1 - at(d, 2100).population / at(d).population })).sort((a: any, b: any) => b.f - a.f).map((d: any) => d.iso3);
assertClaim(fall > 0.5 && falls.slice(0, 3).join() === 'UKR,KOR,TWN', 'more than half smaller by 2100; third-largest fall among countries or areas above ten million');
const dense = [...big].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).map((d: any) => d.iso3);
assertClaim(dense.slice(0, 2).join() === 'BGD,TWN', 'second-highest density among countries or areas above ten million, after Bangladesh');
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bTop.year === 1962, 'births peaked in 1962');
const ageTop = un.years.reduce((a, b) => (b.medianAge > a.medianAge ? b : a));
assertClaim(ageTop.year === 2080, 'median age peaks in 2080');
const men1970 = (y[1970].male / y[1970].female) * 100;
const womenFrom = un.years.find((r) => r.year > 1950 && r.male < r.female)!.year;
assertClaim(men1970 > 112 && men1970 < 113 && womenFrom === 2016, 'about 113 men per 100 women in 1970; women in the majority from 2016');
const below20 = un.years.find((r) => r.year > 2019 && r.population < 2e7)!.year;
assertClaim(below20 === 2048 && un.years.filter((r) => r.year > 2019).every((r) => r.population < y[r.year - 1].population) && y[1950].fertility > 6, 'below 20 million in 2048; smaller every year after 2019');
assertClaim(y[1970].worldRank === 36 && c.worldRank === 61 && y[2100].worldRank === 101, 'rank 36 in 1970, 61 now, 101 in 2100');
const eas = wpp.filter((d: any) => d.subregion === 'Eastern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(eas.indexOf('TWN') === 4, 'fifth in Eastern Asia by population');

const title = `Taiwan Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M, Fertility Below 1 and a Shrinking Total | AtlasFigures`;
const description = `Taiwan (UN listing: China, Taiwan Province of China): ${millions(c.population)} people in ${CURRENT_YEAR}, a fertility rate of ${dec(c.fertility, 2)}, a 2019 high point, and ${millions(y[2100].population)} expected for 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Seat of government', value: tw.capital },
    { label: 'UN listing', value: tw.unName },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, tw.tableYears);

const faq = [
  { q: 'What is Taiwan\'s population count?', a: `${millions(c.population)} in UN data for 1 July ${CURRENT_YEAR}, filed under the name China, Taiwan Province of China, and ranked ${ord(c.worldRank!)} among countries and areas.` },
  { q: "Is Taiwan's population falling?", a: `Yes. The UN series peaks in ${peak.year} at ${millions(peak.population)}. From ${natNeg} on, deaths have outnumbered births year after year, and the ${CURRENT_YEAR} change is about ${int(Math.round(-c.change / 1000))} thousand down.` },
  { q: "How low is Taiwan's fertility rate?", a: `${dec(c.fertility, 2)} per woman this year, and under 1 each year from 2020. In 2010 it was the lowest of any country or area in the UN data; today four have lower rates.` },
  { q: 'What is Taiwan\'s projected population in 2100?', a: `${millions(y[2100].population)}, assuming the UN's medium path, less than half of today's total; it drops below 20 million in ${below20}.` },
  { q: 'Is Taiwan one of the most densely populated places?', a: `Yes: ${int(c.densityPerKm2)} residents to each km² of land; among countries and areas of more than ten million people, Bangladesh alone is denser.` },
];

const schema = countrySchema({
  page: PAGE, slug: tw.slug, name: tw.name, wikipedia: tw.wikipedia,
  headline: `Taiwan's ${millions(c.population)}: fertility below 1, a 2019 peak and a projected halving by 2100`,
  description,
  datasetName: 'Taiwan (UN: China, Taiwan Province of China) population, fertility and median age, 1950–2100',
  datasetDescription: `Mid-year population of Taiwan (UN listing: China, Taiwan Province of China) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: tw.published, updated: tw.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Taiwan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Taiwan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Taiwan: fertility below one and a population past its peak</h1>
        <LiveCounter
          label="Taiwan: estimated population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, falling by roughly ${int(-c.change / 365)} each day`}
        />
        <p class="answer">
          UN figures for mid-{CURRENT_YEAR} give Taiwan about <strong>{millions(c.population)}</strong> people. At <strong>{dec(c.fertility, 2)}</strong> births per woman, fertility ranks among the very lowest anywhere; numbers crested in {peak.year}, and the medium projection more than halves the total, to {millions(y[2100].population)}, by 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={tw.updated}>{longDate(tw.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Taiwan" code="tw" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is Taiwan's fertility rate below one?</h2>
          <p>Yes. The UN rate was {dec(y[2010].fertility, 2)} in 2010, lower than for every other country or area that year, and it has stayed under 1 from 2020 on; it is {dec(c.fertility, 2)} now, with only Macao, Hong Kong, South Korea and Saint Barthélemy lower. Annual births, near {int(Math.round(bTop.births / 1000))} thousand at their {bTop.year} high, are down to about {int(Math.round(c.births / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Taiwanese fertility from 1950, with the projection to 2050"
          subtitle="UN estimates fall from above six to under one; the medium-variant projection is dashed; 2.1 drawn for comparison."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 level' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Taiwan's population started to shrink?</h2>
          <p>Yes. {peak.year} is both the UN series' high point, {millions(peak.population)}, and the year deaths first outstripped births; that natural decrease has not let up. In {CURRENT_YEAR} about {int(Math.round(c.deaths / 1000))} thousand deaths outweigh {int(Math.round(c.births / 1000))} thousand births, and the total declines by about {int(Math.round(-c.change / 1000))} thousand. The population drops below 20 million in {below20}; {millions(y[2100].population)} remain in 2100, a fall exceeded only by Ukraine and South Korea among countries and areas now above ten million.</p>
        </div>
        <LineChart
          title="Taiwan's population: rise to 2019, projected decline to 2100"
          subtitle="Totals for 1 July from the UN; dashes show the medium variant."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How old is Taiwan's population on average?</h2>
          <p>{dec(c.medianAge, 1)} years, up from {dec(y[1990].medianAge, 1)} in 1990; the projection peaks at {dec(ageTop.medianAge, 1)} in {ageTop.year}. Newborns can now count on {dec(c.lifeExpectancy, 1)} years on average. The sex balance has turned as well, from a 1970 ratio of {dec(men1970, 1)} males per 100 females to a female majority each year from {womenFrom}.</p>
        </div>

        <div class="story-block prose">
          <h2>Where does Taiwan rank for density and size?</h2>
          <p>Second for density among countries and areas above ten million people: {int(c.densityPerKm2)} per square kilometre across {int(un.landAreaKm2)} km², behind only Bangladesh. In world population terms it ranked {ord(y[1970].worldRank!)} in 1970, ranks {ord(c.worldRank!)} today and would be {ord(y[2100].worldRank!)} by 2100; within Eastern Asia it is fifth. The UN lists it as "China, Taiwan Province of China".</p>
        </div>
        <RelatedPages iso3={tw.iso3} name={tw.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Taiwan: population and fertility, 1950 to 2100"
          subtitle="The 2019 row is the high point; from 2020 each row is smaller, and later rows are UN projections."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${tw.slug}-population.csv`)}
          csvName={`${tw.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Taiwan population FAQ</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{tw.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, men and women, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={tw.published}>{longDate(tw.published)}</time> · Updated <time datetime={tw.updated}>{longDate(tw.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Taiwan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Taiwan" code="tw" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
