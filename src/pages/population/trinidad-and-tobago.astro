---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import tto from '../../data/countries/trinidad-and-tobago.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: net departures every year 1950–2016 (67
// years) and in 2019 (the largest); net arrivals 2017–2018 and 2020–2026; peak in 2028 (1.51 million), then falls
// every year to 2100; urban majority since 1978 but only 54% now; births from a 1983 high to the fewest in 2026.
const PAGE = '/population/trinidad-and-tobago/';
const un = countryData(tto.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (tto.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(un.years.filter((r) => r.year <= 2016).every((r) => r.netMigrants < 0) && y[2017].netMigrants > 0 && y[2018].netMigrants > 0 && y[2019].netMigrants < 0, 'departures 1950–2016');
assertClaim(un.years.filter((r) => r.year >= 2020 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants > 0), 'arrivals 2020–now');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 2019 && inTop.year === 2018, 'outflow 2019, inflow 2018');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2028 && un.years.filter((r) => r.year >= 2029).every((r) => r.population < y[r.year - 1].population), 'peak 2028');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1978 && c.urbanPct! < 55, 'urban majority 1978, 54% now');
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(bTop.year === 1983 && bLow.year === CURRENT_YEAR, 'births 1983 to now');
assertClaim(un.years.filter((r) => r.year >= 1994).every((r) => r.fertility < 2.1) && y[2021].lifeExpectancy < 72, 'fertility, 2021 lifespan');

const title = `Trinidad and Tobago Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(2)}M): Outflows Ran 1950–2016; UN Sees a Top in 2028 | AtlasFigures`;
const description = `Trinidad and Tobago: roughly ${millions(c.population)}, says the UN's ${CURRENT_YEAR} estimate. Departures beat arrivals annually from 1950 to 2016; inflows have led since 2020; the projection tops out in 2028 before a steady decline.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: tto.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, tto.tableYears);

const faq = [
  { q: 'Has emigration always exceeded immigration in Trinidad and Tobago?', a: `Not always, but for 67 straight years, 1950 through 2016, and again in 2019, per the UN. Net arrivals came in 2017–2018 and in each year from 2020 to ${CURRENT_YEAR}.` },
  { q: 'What is the projected high point for Trinidad and Tobago?', a: `2028, with ${millions(peak.population)} in the UN's middle scenario; every year after that is projected lower.` },
  { q: 'Which year had the biggest migration swings?', a: `2018 brought the largest net inflow (${int(inTop.netMigrants)}); 2019 the largest net outflow (${int(-outTop.netMigrants)}). The UN records no reasons.` },
  { q: 'Do most Trinidadians and Tobagonians live in cities?', a: `A slim majority do: ${pct(c.urbanPct!)} on the national measure, past half since 1978.` },
  { q: 'Are Trinidad and Tobago births falling?', a: `Yes, to around ${int(c.births)} this year, a record low; the 1983 figure was ${int(bTop.births)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: tto.slug, name: tto.name, wikipedia: tto.wikipedia,
  headline: `Trinidad and Tobago's ${millions(c.population)}: net emigration in each year 1950–2016; inflows since 2020; a 2028 peak`,
  description,
  datasetName: 'Trinidad and Tobago population and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Trinidad and Tobago for selected years from 1950 to ${CURRENT_YEAR}, including 1978, 1983, 2016–2021 and 2028, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: tto.published, updated: tto.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Trinidad and Tobago"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Trinidad and Tobago", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Trinidad and Tobago: decades of departures, a peak still ahead</h1>
        <LiveCounter
          label="Trinidad and Tobago: live UN-derived count"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Runs on from UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), adding close to ${int(c.change / 365)} people daily`}
        />
        <p class="answer">
          With <strong>{millions(c.population)}</strong> residents estimated by the UN for {CURRENT_YEAR}, Trinidad and Tobago is still growing slightly; its maximum is due in 2028 by UN reckoning, followed by decline.
        </p>
        <div class="dates"><span>Updated <time datetime={tto.updated}>{longDate(tto.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Trinidad and Tobago" code="tt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Did Trinidad and Tobago lose more people than it gained through migration?</h2>
          <p>For most of its history, yes. Emigration outweighed immigration in the UN series for 67 consecutive years, 1950–2016, cancelling a good part of the surplus of births. The tables give the balance, not the reasons. Net arrivals followed in 2017 and 2018, the larger in 2018 at {int(inTop.netMigrants)}; 2019 then saw the biggest outflow, {int(-outTop.netMigrants)}.</p>
        </div>
        <LineChart
          title="Trinidad and Tobago, 1950–2100: topping out in 2028"
          subtitle="People at mid-year, with UN projection in dashes."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Trinidad and Tobago start losing population?</h2>
          <p>After 2028, on medium-variant assumptions: the arrivals surplus in place since 2020 flips to a deficit in 2027, a natural decrease begins in 2029, and each year thereafter is smaller, down to {int(Math.round(y[2100].population / 1e3))} thousand at 2100. Births, {int(bTop.births)} at their 1983 high, number {int(c.births)} in {CURRENT_YEAR}.</p>
        </div>

        <div class="story-block prose">
          <h2>Do towns hold most of Trinidad and Tobago's people?</h2>
          <p>Only just. UN World Urbanization Prospects, on the national definition, counts {pct(c.urbanPct!)} as urban, above half only since 1978 and expected at just {pct(y[2050].urbanPct!)} in 2050. Separately, WPP life expectancy is {dec(c.lifeExpectancy, 1)} years, recovered from {dec(y[2021].lifeExpectancy, 1)} in 2021.</p>
        </div>
        <RelatedPages iso3={tto.iso3} name={tto.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Trinidad and Tobago: 1978, 1983, 2016–2021, 2028"
          subtitle="Migration signs flip to plus for 2017–2018 and again from 2020."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${tto.slug}-population.csv`)}
          csvName={`${tto.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Trinidad and Tobago: UN numbers in brief</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{tto.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={tto.published}>{longDate(tto.published)}</time> · Updated <time datetime={tto.updated}>{longDate(tto.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Trinidad and Tobago population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Trinidad and Tobago" code="tt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
