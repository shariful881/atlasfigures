---
import Base from '../../layouts/Base.astro';
import bd from '../../data/countries/bangladesh.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const countries = [bd];
---
<Base
  title="Population of Every Country | AtlasFigures"
  description="Population, density, fertility and the story behind the numbers for every country in the world."
  section="population"
>
  <div class="crumbs"><a href={`${base}/`}>Home</a> / Population</div>
  <h1>Population by country</h1>
  <p class="lead">Every country gets its own page, written around what makes its population story different. We are adding countries every week.</p>
  <div class="grid-cards">
    {countries.map((c) => (
      <a class="card" href={`${base}/population/${c.slug}/`}>
        <span class="tag">{c.region}</span>
        <h3>{c.name}</h3>
        <p><span class="num">{(c.current.population / 1e6).toFixed(1)}M</span> people · #{c.current.worldRank} in the world</p>
      </a>
    ))}
  </div>
</Base>
