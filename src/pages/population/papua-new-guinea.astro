---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import png from '../../data/countries/papua-new-guinea.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the smallest urban share of any country with
// a million or more people (national definition), flat at about 13% from 1980 to 2000; life expectancy up from under
// 40 in 1950; sevenfold growth since 1950 and growth through 2100; the largest population in Melanesia.
const PAGE = '/population/papua-new-guinea/';
const un = countryData(png.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (png.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...m1].sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct)[0].iso3 === 'PNG', 'lowest urban share among 1M+');
assertClaim(y[1950].urbanPct! < 2 && Math.abs(y[2000].urbanPct! - y[1980].urbanPct!) < 0.5 && y[2050].urbanPct! > 2 * c.urbanPct! - 1, 'urban 1950 under 2%, flat 1980–2000, about double by 2050');
assertClaim(y[1950].lifeExpectancy < 40 && c.lifeExpectancy > 66, 'life expectancy under 40 in 1950, over 66 now');
const times = c.population / y[1950].population;
assertClaim(times > 7 && times < 7.2, 'about seven times 1950');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1969, 'fertility high 1969');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2070, 'below 2.1 in 2070');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2046, 'births peak 2046');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
const mel = wpp.filter((d: any) => d.subregion === 'Melanesia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(mel[0] === 'PNG' && at(wpp.find((d: any) => d.iso3 === 'FJI')).population * 10 < c.population, 'largest in Melanesia, over ten times Fiji');
assertClaim(c.netMigrants < 0 && Math.abs(c.netMigrants) < 5000, 'net migration near zero');
assertClaim(c.male > c.female, 'more men than women');

const title = `Papua New Guinea Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Fewest Town Dwellers of Any Country Its Size | AtlasFigures`;
const description = `Papua New Guinea's ${CURRENT_YEAR} total stands near ${millions(c.population)} on UN figures, and just ${pct(c.urbanPct!)} are in urban areas (national definition), the smallest share of any country above a million. Growth continues past 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: png.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, png.tableYears);

const faq = [
  { q: 'Is Papua New Guinea a mainly rural country?', a: `Yes: only ${pct(c.urbanPct!)} count as urban, going by the country's own urban definition, the smallest share among countries with a million or more inhabitants. By 2050 it should reach ${pct(y[2050].urbanPct!)}, says World Urbanization Prospects 2025.` },
  { q: 'Which Melanesian country has the most people?', a: `Papua New Guinea, by far: ${millions(c.population)}, more than ten times Fiji, the next largest.` },
  { q: "What is a Papua New Guinean's life expectancy at birth?", a: `${dec(c.lifeExpectancy, 1)} years on UN estimates, up from ${dec(y[1950].lifeExpectancy, 1)} in 1950. Out of every 1,000 babies, about ${dec(c.infantMortalityPer1000!, 1)} die in their first year.` },
  { q: "What is Papua New Guinea's annual growth rate?", a: `${pct(c.growthRatePct)} this year. The count is now some seven times that of 1950 and climbs throughout the UN projection, to ${millions(y[2100].population)} in 2100.` },
  { q: 'Does migration matter for Papua New Guinea?', a: `Hardly: the net loss to migration this year is just ${int(-c.netMigrants)}, so growth comes almost entirely from ${int(c.births)} births outnumbering ${int(c.deaths)} deaths.` },
];

const schema = countrySchema({
  page: PAGE, slug: png.slug, name: png.name, wikipedia: png.wikipedia,
  headline: `Papua New Guinea's ${millions(c.population)}: the lowest urban share among countries above a million, and growth to 2100`,
  description,
  datasetName: 'Papua New Guinea population and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Papua New Guinea for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: png.published, updated: png.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Papua New Guinea"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Papua New Guinea", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Papua New Guinea: millions of people, few of them in towns</h1>
        <LiveCounter
          label="Papua New Guinea: current population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, increasing by around ${int(c.change / 365)} per day`}
        />
        <p class="answer">
          Papua New Guinea, Melanesia's most populous country, counted <strong>{millions(c.population)}</strong> residents in {CURRENT_YEAR} by UN estimates. A mere <strong>{pct(c.urbanPct!)}</strong> of them are urban dwellers, the lowest share for any nation with a million-plus residents.
        </p>
        <div class="dates"><span>Updated <time datetime={png.updated}>{longDate(png.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Papua New Guinea" code="pg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has Papua New Guinea's urban share grown?</h2>
          <p>Slowly, and the data do not say why. By the country's own definition, the urban share was {pct(y[1950].urbanPct!)} in 1950, reached {pct(y[1980].urbanPct!)} by 1980, was still {pct(y[2000].urbanPct!)} in 2000 and is {pct(c.urbanPct!)} today, the lowest of any country above one million people. World Urbanization Prospects 2025 expects it roughly to double, to {pct(y[2050].urbanPct!)}, by 2050.</p>
        </div>
        <LineChart
          title="Papua New Guinea's urban share since 1950"
          subtitle="Percent urban on the national definition; nearly flat from 1980 to 2000, projected (dashed) to 2050."
          points={rows.filter((r) => r.year <= 2050 && r.urbanPct != null).map((r) => ({ x: r.year, y: r.urbanPct!, projection: r.projection }))}
          format="percent"
          highlight={CURRENT_YEAR}
          source="UN World Urbanization Prospects 2025"
          sourceUrl={WUP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How has life expectancy in Papua New Guinea changed since 1950?</h2>
          <p>It has risen by some {int(Math.round(c.lifeExpectancy - y[1950].lifeExpectancy))} years. In 1950 a baby could expect to live {dec(y[1950].lifeExpectancy, 1)} years; in 1970, {dec(y[1970].lifeExpectancy, 1)}; in 2000, {dec(y[2000].lifeExpectancy, 1)}; the figure is now {dec(c.lifeExpectancy, 1)}. Infant deaths run at {dec(c.infantMortalityPer1000!, 1)} for each 1,000 births.</p>
        </div>

        <div class="story-block prose">
          <h2>Is growth in Papua New Guinea slowing?</h2>
          <p>Gradually: yearly growth is {pct(c.growthRatePct)}. Fertility peaked at {dec(tfrTop.fertility, 2)} per woman in {tfrTop.year} and has since fallen to {dec(c.fertility, 2)}; the projection keeps it above 2.1 until {repl}, and yearly births keep climbing until {birthTop.year}. Migration plays almost no part: a net loss of {int(-c.netMigrants)} this year.</p>
        </div>

        <div class="story-block prose">
          <h2>Will Papua New Guinea's population peak this century?</h2>
          <p>Not on the medium variant, which has it reaching {millions(y[2100].population)} in 2100 and still rising, after {millions(y[2050].population)} in 2050. Density today is {int(c.densityPerKm2)} people per km².</p>
        </div>
        <LineChart
          title="Papua New Guinea, total population 1950–2100"
          subtitle="UN mid-year estimates followed by the medium-variant projection (dashed), with no peak before 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={png.iso3} name={png.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Papua New Guinea decade by decade, 1950 onward"
          subtitle="The urban column barely moves from 1980 to 2000."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${png.slug}-population.csv`)}
          csvName={`${png.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Papua New Guinea: common queries</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{png.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={png.published}>{longDate(png.published)}</time> · Updated <time datetime={png.updated}>{longDate(png.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Papua New Guinea population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Papua New Guinea" code="pg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
