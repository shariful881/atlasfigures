---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import gnq from '../../data/countries/equatorial-guinea.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: 111.2 men per 100 women, the highest of
// Africa's 1M+ countries; life expectancy 31.0 (1969) and 30.5 (1976, the low); population down every year 1970–1978
// with net departures every year 1969–1979, the most in 1973; net arrivals every year 1980–2019, the most in 2004;
// about 8.8 times its 1950 size; urban majority from 2009; growth every year from 1979 to 2100.
const PAGE = '/population/equatorial-guinea/';
const un = countryData(gnq.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (gnq.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const e1 = wpp.filter((d: any) => at(d).population >= 1e6 && d.region === 'Africa');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...e1].sort((a: any, b: any) => sr(b) - sr(a))[0].iso3 === 'GNQ', 'highest sex ratio in Africa');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1976 && y[1969].lifeExpectancy < 32 && y[1968].lifeExpectancy > 44, 'lifespan lows 1969 and 1976');
assertClaim(un.years.filter((r) => r.year >= 1970 && r.year <= 1978).every((r) => r.population < y[r.year - 1].population) && un.years.filter((r) => r.year >= 1979).every((r) => r.population > y[r.year - 1].population), 'falls 1970–1978, growth after');
assertClaim(un.years.filter((r) => r.year >= 1969 && r.year <= 1979).every((r) => r.netMigrants < 0) && un.years.filter((r) => r.year >= 1980 && r.year <= 2019).every((r) => r.netMigrants > 0), 'migration phases');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 1973 && inTop.year === 2004, 'outflow 1973, inflow 2004');
const since = c.population / y[1950].population;
assertClaim(since > 8.7 && since < 8.9, 'about 8.8 times 1950');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2009, 'urban majority 2009');

const title = `Equatorial Guinea Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Ninefold Since 1950 Despite a 1970s Collapse | AtlasFigures`;
const description = `Tallied at ${millions(c.population)} for ${CURRENT_YEAR} by the UN, Equatorial Guinea is nearly ninefold its 1950 count. Its ${dec((c.male / c.female) * 100, 1)} men per 100 women lead Africa's million-plus nations; the population shrank annually from 1970 to 1978.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: gnq.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, gnq.tableYears);

const faq = [
  { q: 'What is the sex ratio in Equatorial Guinea?', a: `${dec((c.male / c.female) * 100, 1)} males to 100 females, the widest male surplus of any African country past the million mark. The UN gives no reason.` },
  { q: 'Did Equatorial Guinea lose population during the 1970s?', a: `Yes, every year 1970–1978: ${int(y[1969].population)} shrank to ${int(y[1978].population)}. Outflows led over 1969–1979, peaking in 1973 (${int(-outTop.netMigrants)}). Causes go unrecorded.` },
  { q: 'How short were lifespans in Equatorial Guinea in the 1970s?', a: `Down to ${dec(leLow.lifeExpectancy, 1)} years by 1976, lowest on record, having also sunk to ${dec(y[1969].lifeExpectancy, 1)} in 1969. Today: ${dec(c.lifeExpectancy, 1)}.` },
  { q: 'When did migration to Equatorial Guinea peak?', a: `2004, at ${int(inTop.netMigrants)} net, within forty straight years of inflows, 1980 to 2019.` },
  { q: 'Where does Equatorial Guinea stand in 2100?', a: `At ${millions(y[2100].population)} on UN medium assumptions, after growth in every year.` },
];

const schema = countrySchema({
  page: PAGE, slug: gnq.slug, name: gnq.name, wikipedia: gnq.wikipedia,
  headline: `Equatorial Guinea's ${millions(c.population)}: Africa's highest sex ratio; a 1970–1978 decline; net arrivals 1980–2019; growth to 2100`,
  description,
  datasetName: 'Equatorial Guinea population, sex ratio, life expectancy and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Equatorial Guinea for selected years from 1950 to ${CURRENT_YEAR}, including each year 1968–1980 except 1971–1972 and 1974, plus 2004, 2009 and 2019–2020, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: gnq.published, updated: gnq.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Equatorial Guinea"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Equatorial Guinea", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Equatorial Guinea: a 1970s collapse, then near-ninefold growth</h1>
        <LiveCounter
          label="Equatorial Guinea: present population, estimated"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Updated from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} level, adding close to ${int(c.change / 365)} daily`}
        />
        <p class="answer">
          The UN tally for Equatorial Guinea in {CURRENT_YEAR} is <strong>{millions(c.population)}</strong>, and for each 100 women there are <strong>{dec((c.male / c.female) * 100, 1)}</strong> men, the most lopsided balance among Africa's million-plus nations.
        </p>
        <div class="dates"><span>Updated <time datetime={gnq.updated}>{longDate(gnq.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Equatorial Guinea" code="gq" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>What happened to Equatorial Guinea in the 1970s?</h2>
          <p>A collapse, on the UN numbers: every year from 1970 to 1978 the headcount dropped, from {int(y[1969].population)} to {int(y[1978].population)}. Outflows led each year 1969–1979, heaviest in 1973 ({int(-outTop.netMigrants)}), and life expectancy plunged to {dec(y[1969].lifeExpectancy, 1)} in 1969 and to {dec(leLow.lifeExpectancy, 1)} in 1976, its floor. No causes are attached.</p>
        </div>
        <LineChart
          title="Equatorial Guinea's life expectancy, 1950–2050"
          subtitle="Years at birth, with the 1969 and 1976 troughs; projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How large is Equatorial Guinea's male surplus?</h2>
          <p>{dec((c.male / c.female) * 100, 1)} males for each hundred females, higher than in any other African country past the million mark; the UN tables give the ratio, not the cause. Inflows exceeded outflows for forty straight years, 1980–2019, with 2004 the busiest ({int(inTop.netMigrants)}).</p>
        </div>

        <div class="story-block prose">
          <h2>Has Equatorial Guinea grown every year since the collapse?</h2>
          <p>In every year without exception. The present figure is close to 8.8 times 1950's {int(y[1950].population)}; towns have held the larger share since 2009 ({pct(c.urbanPct!)} now). Ahead: {millions(y[2050].population)} as of 2050; {millions(y[2100].population)} as of 2100.</p>
        </div>
        <RelatedPages iso3={gnq.iso3} name={gnq.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Equatorial Guinea: 1968–1980, 2004, 2009, 2019–2020"
          subtitle="Totals fall in each row from 1970 to 1978; growth resumes in 1979."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${gnq.slug}-population.csv`)}
          csvName={`${gnq.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Equatorial Guinea: questions on the record</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{gnq.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={gnq.published}>{longDate(gnq.published)}</time> · Updated <time datetime={gnq.updated}>{longDate(gnq.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Equatorial Guinea population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Equatorial Guinea" code="gq" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
