---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import ke from '../../data/countries/kenya.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: one of Africa's biggest falls in fertility, tenfold growth since 1950, a peak near 2098, fast urbanisation ahead.
const PAGE = '/population/kenya/';
const un = countryData(ke.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ke.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const fall = y[1980].fertility - c.fertility;
const falls = wpp.filter((d: any) => d.region === 'Africa' && at(d).population > 10e6).sort((a: any, b: any) => (at(b, 1980).fertility - at(b).fertility) - (at(a, 1980).fertility - at(a).fertility)).map((d: any) => d.iso3);
assertClaim(tfrMax.year === 1966 && falls[0] === 'RWA' && falls[1] === 'KEN', 'fertility peak 1966; second-largest fall since 1980 among African countries over 10 million, after Rwanda');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 2066, 'projected under 2.1 from 2066');
const times = c.population / y[1950].population;
assertClaim(times > 10 && times < 10.3, 'about ten times 1950');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2098 && y[2100].population < peak.population, 'peak 2098, slightly lower by 2100');
const uga = wpp.find((d: any) => d.iso3 === 'UGA');
const ugaPass = un.years.find((r) => r.year > CURRENT_YEAR && at(uga, r.year).population > r.population)!.year;
assertClaim(ugaPass === 2046, 'Uganda passes Kenya in 2046');
const east = wpp.filter((d: any) => d.subregion === 'Eastern Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(east.slice(0, 3).join(',') === 'ETH,TZA,KEN', 'third in Eastern Africa after Ethiopia and Tanzania');
assertClaim(un.years.filter((r) => r.year >= 2010 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0), 'net outflow every year since 2010');
assertClaim(y[2050].urbanPct! > 56 && c.urbanPct! < 33, 'urban share from about a third to over half by 2050');

const tza = wpp.find((d: any) => d.iso3 === 'TZA');
assertClaim(c.growthRatePct < at(uga).growthRatePct && c.growthRatePct < at(tza).growthRatePct && c.fertility < y[1980].fertility / 2, 'slower growth than Uganda and Tanzania; fertility more than halved since 1980');
const title = `Kenya in ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million People, Smaller Families | AtlasFigures`;
const description = `Kenya counts ${millions(c.population)} people in mid-${CURRENT_YEAR}. Births per woman have fallen from ${dec(tfrMax.fertility, 2)} to ${dec(c.fertility, 2)}, and UN projections level off at about ${millions(peak.population)} around ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ke.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, ke.tableYears);

const faq = [
  { q: 'How many Kenyans are there?', a: `About ${millions(c.population)}; that is the UN's mid-${CURRENT_YEAR} estimate, which ranks Kenya ${ord(c.worldRank!)} globally and third in Eastern Africa behind Ethiopia and Tanzania.` },
  { q: 'How quickly are Kenyan families getting smaller?', a: `The rate topped out at ${dec(tfrMax.fertility, 2)} (${tfrMax.year}) and is ${dec(c.fertility, 2)} now. The ${dec(fall, 2)}-child drop since 1980 is the second-biggest in Africa among nations above ten million, behind Rwanda.` },
  { q: 'What population is projected for Kenya in 2050?', a: `Roughly ${millions(y[2050].population)}, per the medium projection, which would make Kenya ${ord(y[2050].worldRank!)} in the world.` },
  { q: 'Will Uganda overtake Kenya?', a: `The UN projections show Uganda moving ahead in ${ugaPass}, because it keeps growing faster for longer.` },
  { q: 'Does Kenya\'s population ever stop rising?', a: `Only very late. The medium variant tops out at ${millions(peak.population)} in ${peak.year}, with a fractionally smaller total in 2100.` },
];

const schema = countrySchema({
  page: PAGE, slug: ke.slug, name: ke.name, wikipedia: ke.wikipedia,
  headline: `Kenya's ${millions(c.population)}: smaller families, slower growth, a peak near ${peak.year}`,
  description,
  datasetName: 'Kenya population, fertility, migration and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Kenya for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ke.published, updated: ke.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Kenya"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Kenya', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Kenya: a growing population with fast-shrinking families</h1>
        <LiveCounter
          label="Kenya: population estimate in real time"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} reading, gaining around ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Kenya's mid-{CURRENT_YEAR} headcount is about <strong>{millions(c.population)}</strong> ({ord(c.worldRank!)} worldwide), rising {pct(c.growthRatePct)} a year. Births per woman are down from <strong>{dec(tfrMax.fertility, 2)} at the peak to {dec(c.fertility, 2)}</strong>, one of the biggest drops in Africa.
        </p>
        <div class="dates"><span>Updated <time datetime={ke.updated}>{longDate(ke.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Kenya" code="ke" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How fast has Kenya's fertility rate dropped?</h2>
          <p>Faster than almost anywhere in Africa. Fertility in Kenya was {dec(tfrMax.fertility, 2)} in {tfrMax.year}, {dec(y[1980].fertility, 2)} in 1980 and {dec(c.fertility, 2)} in {CURRENT_YEAR}. The {dec(fall, 2)}-child decline since 1980 is second only to Rwanda's among African nations with populations above ten million. The UN expects the rate to slip below 2.1 in {below}.</p>
        </div>
        <LineChart
          title="Kenyan fertility, 1950 to 2050: from near 8 to about 3"
          subtitle="UN births-per-woman values, projected stretch dashed; reference at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 ref.' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Kenya growing more slowly than its neighbours?</h2>
          <p>Yes. Kenya's growth rate of {pct(c.growthRatePct)} this year (roughly {millions(c.change)} people) is below the rates in neighbouring Uganda and Tanzania, even though the population has multiplied about tenfold since 1950 ({millions(y[1950].population)}). As a result Uganda's population is projected to pass Kenya's in {ugaPass}. Net migration has been slightly negative in every year since 2010.</p>
        </div>
        <LineChart
          title="Kenya's population, 1950–2100: levelling off late in the century"
          subtitle="Mid-year totals (UN). The dashed projection flattens out at just over 104 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Kenya's population close to peaking?</h2>
          <p>No: the medium variant puts the high point at {millions(peak.population)} around {peak.year}, so Kenya keeps growing for most of the century, ever more slowly. By 2050 it is expected to have {millions(y[2050].population)} people, {ord(y[2050].worldRank!)} in the world, and half of all Kenyans would be older than {dec(y[2050].medianAge, 1)}, against {dec(c.medianAge, 1)} today.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Kenya becoming more urban?</h2>
          <p>Quickly, according to World Urbanization Prospects: {pct(c.urbanPct!)} of Kenyans count as urban by the national definition today, and the projection for 2050 is {pct(y[2050].urbanPct!)}. In 1950 the share was {pct(y[1950].urbanPct!)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Urban share in Kenya">
          <div><span class="y">1950</span><div class="v">{pct(y[1950].urbanPct!)}</div><span class="d">Urban</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">About a third</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{pct(y[2050].urbanPct!)}</div><span class="d">Over half</span></div>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Kenya's population over 150 years, in rows"
          subtitle="Fertility more than halves between the 1980 and 2026 rows; the total almost stops rising by 2100."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ke.slug}-population.csv`)}
          csvName={`${ke.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Kenya's population: questions readers ask</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ke.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and its projection to 2050.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ke.published}>{longDate(ke.published)}</time> · Updated <time datetime={ke.updated}>{longDate(ke.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Kenya population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Kenya" code="ke" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
