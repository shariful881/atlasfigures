---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import cog from '../../data/countries/republic-of-the-congo.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/; UN listing "Congo"). Story, counts only: the 1997
// life-expectancy dip; the 2009 net inflow (largest) and net departures 2012–2018; an urban majority since 1983, fourth
// in Middle Africa; growth through 2100 to about three times today, fertility above 2.1 to 2100.
const PAGE = '/population/republic-of-the-congo/';
const un = countryData(cog.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (cog.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(y[1997].lifeExpectancy < y[1996].lifeExpectancy - 6 && y[1998].lifeExpectancy < y[1996].lifeExpectancy, '1997 dip over 6 years');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2009 && inTop.netMigrants > 8e4, 'largest inflow 2009');
assertClaim(un.years.filter((r) => r.year >= 2012 && r.year <= 2018).every((r) => r.netMigrants < 0), 'net departures 2012–2018');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1983, 'urban majority 1983');
const maf = wpp.filter((d: any) => d.subregion === 'Middle Africa' && at(d).population >= 1e6);
assertClaim([...maf].sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct).slice(0, 4).map((d: any) => d.iso3).join() === 'GAB,AGO,GNQ,COG', 'fourth-most urban in Middle Africa');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
const times = y[2100].population / c.population;
assertClaim(times > 2.9 && times < 3.1, 'about three times today by 2100');
assertClaim(un.years.every((r) => r.fertility > 2.1), 'fertility above 2.1 through 2100');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1972, 'fertility high 1972');
const since = c.population / y[1950].population;
assertClaim(since > 7.8 && since < 8, 'about 7.9 times 1950');
assertClaim(c.medianAge < 19, 'median under 19');

const title = `Republic of the Congo Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Mostly Urban Since 1983, Tripling by 2100 | AtlasFigures`;
const description = `UN estimates for ${CURRENT_YEAR} put the Republic of the Congo (UN listing: Congo) at ${millions(c.population)}. Urban residents first formed a majority in 1983; by 2100 the count is projected at ${millions(y[2100].population)} and still rising.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: cog.capital },
    { label: 'UN listing', value: cog.unName },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, cog.tableYears);

const faq = [
  { q: 'Is this the same country as the DR Congo?', a: `No. This page covers the Republic of the Congo, capital Brazzaville, listed by the UN simply as Congo; the Democratic Republic of the Congo is a separate country.` },
  { q: 'Do most Congolese in the Republic of the Congo live in towns?', a: `Yes, as they have since 1983; ${pct(c.urbanPct!)} do today, fourth in Middle Africa among nations above a million, behind Gabon, Angola and Equatorial Guinea.` },
  { q: 'What happened to life expectancy there in 1997?', a: `UN estimates drop from ${dec(y[1996].lifeExpectancy, 1)} years in 1996 to ${dec(y[1997].lifeExpectancy, 1)} in 1997; no cause is given.` },
  { q: 'Which year brought the most migrants?', a: `${inTop.year}, with net arrivals of ${int(inTop.netMigrants)}; net departures followed in every year from 2012 to 2018.` },
  { q: 'Is the Republic of the Congo still growing in 2100?', a: `Yes. The projection rises to ${millions(y[2100].population)}, about three times today, and fertility stays above 2.1 throughout.` },
];

const schema = countrySchema({
  page: PAGE, slug: cog.slug, name: cog.name, wikipedia: cog.wikipedia,
  headline: `The Republic of the Congo's ${millions(c.population)}: urban since 1983, a 2009 inflow, and a population tripling by 2100`,
  description,
  datasetName: 'Republic of the Congo population, urban share and net migration, 1950–2100',
  datasetDescription: `Mid-year population of the Republic of the Congo (UN listing: Congo) for selected years from 1950 to ${CURRENT_YEAR}, including 1996, 1997, 2009 and 2012, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: cog.published, updated: cog.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Republic of the Congo"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Republic of the Congo", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Republic of the Congo: a young, town-dwelling country still growing fast</h1>
        <LiveCounter
          label="Republic of the Congo: population estimate in real time"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 (listed as Congo), mid-${CURRENT_YEAR}, with roughly ${int(c.change / 365)} added per day`}
        />
        <p class="answer">
          Known in the UN files simply as Congo, the Republic of the Congo has about <strong>{millions(c.population)}</strong> inhabitants in {CURRENT_YEAR}, nearly eight times its 1950 total. Of them, <strong>{pct(c.urbanPct!)}</strong> live in urban areas, and half are younger than {dec(c.medianAge, 1)}.
        </p>
        <div class="dates"><span>Updated <time datetime={cog.updated}>{longDate(cog.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Republic of the Congo" code="cg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has the Republic of the Congo been mostly urban for long?</h2>
          <p>Since 1983. That uses the country's own urban definition, as compiled in WUP 2025. The share was {pct(y[1950].urbanPct!)} in 1950 and is {pct(c.urbanPct!)} now, fourth in Middle Africa among countries over a million, after Gabon, Angola and Equatorial Guinea. Brazzaville is the capital.</p>
        </div>
        <LineChart
          title="Urban share in the Republic of the Congo, 1950–2050"
          subtitle="WUP 2025 figures, national urban definition; dashed beyond 2023."
          points={rows.filter((r) => r.year <= 2050 && r.urbanPct != null).map((r) => ({ x: r.year, y: r.urbanPct!, projection: r.projection }))}
          format="percent"
          highlight={CURRENT_YEAR}
          source="UN World Urbanization Prospects 2025"
          sourceUrl={WUP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why is 1997 a low point for life expectancy in the Republic of the Congo?</h2>
          <p>The cause is not in the UN files; the drop is. Life expectancy slid from {dec(y[1996].lifeExpectancy, 1)} years (1996) to {dec(y[1997].lifeExpectancy, 1)} (1997), recovering to {dec(y[1998].lifeExpectancy, 1)} in 1998. Infant deaths per 1,000 births have fallen from {dec(y[1950].infantMortalityPer1000!, 1)} in 1950 to {dec(c.infantMortalityPer1000!, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Why did migration into the Republic of the Congo spike in 2009?</h2>
          <p>The source gives no reason, only the count: {int(inTop.netMigrants)} more people arrived than left in 2009, unmatched by any other year. From 2012 to 2018 the flow ran the other way each year, with {int(-y[2012].netMigrants)} net departures in 2012.</p>
        </div>

        <div class="story-block prose">
          <h2>How large could the Republic of the Congo become?</h2>
          <p>Projected: {millions(y[2050].population)} for 2050, then {millions(y[2100].population)} for 2100, about three times today and still climbing when the projection stops. Fertility, {dec(tfrTop.fertility, 2)} at its {tfrTop.year} high and {dec(c.fertility, 2)} now, stays above 2.1 in every projected year.</p>
        </div>
        <RelatedPages iso3={cog.iso3} name={cog.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Republic of the Congo by year, 1996–1997 and 2009–2012"
          subtitle="The 2009 row carries the biggest net arrivals; the 1997 row the lifespan low."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${cog.slug}-population.csv`)}
          csvName={`${cog.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Republic of the Congo: frequently raised points</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{cog.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={cog.published}>{longDate(cog.published)}</time> · Updated <time datetime={cog.updated}>{longDate(cog.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Republic of the Congo population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Republic of the Congo" code="cg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
