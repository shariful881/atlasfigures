---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import lby from '../../data/countries/libya.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: the 2011 net outflow and falls in
// 2011–2012; life-expectancy dips in 2011 and 2023 (no causes given); the largest fertility fall of any country of a
// million or more since 1971; second-lowest density in Africa (1 million+); a very urban population; growth until 2086.
const PAGE = '/population/libya/';
const un = countryData(lby.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (lby.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2011 && -outTop.netMigrants > 5.5e5, 'net outflow above 550,000 in 2011');
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1983,2011,2012', 'falls 1983, 2011, 2012');
assertClaim(y[2011].lifeExpectancy < y[2010].lifeExpectancy - 2 && Math.abs(y[2012].lifeExpectancy - y[2010].lifeExpectancy) < 0.2, '2011 life-expectancy dip, recovered 2012');
assertClaim(y[2023].lifeExpectancy < y[2022].lifeExpectancy - 5 && y[2023].deaths > 1.35 * y[2022].deaths, '2023 dip over 5 years, deaths up over 35%');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1971 && tfrTop.fertility > 8, 'fertility high 1971 above 8');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const fall = (d: any) => at(d, 1971).fertility - at(d).fertility;
assertClaim([...m1].sort((a: any, b: any) => fall(b) - fall(a))[0].iso3 === 'LBY', 'largest fertility fall since 1971, 1M+');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2030, 'below 2.1 in 2030');
const af1 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population >= 1e6);
assertClaim([...af1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).slice(0, 2).map((d: any) => d.iso3).join() === 'NAM,LBY', 'second-lowest density in Africa after Namibia');
assertClaim([...af1].sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct).slice(0, 2).map((d: any) => d.iso3).join() === 'GAB,LBY', 'second-most urban in Africa after Gabon');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2086, 'peak 2086');
assertClaim(c.male > c.female, 'more men than women');
const times = c.population / y[1950].population;
assertClaim(times > 6.6 && times < 6.8, 'about 6.7 times 1950');

const title = `Libya Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Sharpest Fertility Fall Since 1971, a 2011 Outflow | AtlasFigures`;
const description = `On UN estimates Libya numbers about ${millions(c.population)} in ${CURRENT_YEAR}. The series records a net outflow of ${int(-outTop.netMigrants)} in 2011 and dips in 2011–2012; since 1971 fertility has dropped further than in any other country above a million.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: lby.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, lby.tableYears);

const faq = [
  { q: 'How did 2011 change Libya\'s population figures?', a: `The UN puts net departures at ${int(-outTop.netMigrants)} that year; the mid-year total fell in 2011 and again in 2012, and life expectancy dipped to ${dec(y[2011].lifeExpectancy, 1)}. No causes are given.` },
  { q: 'Why did Libyan deaths rise in 2023?', a: `The UN files show deaths climbing from ${int(y[2022].deaths)} in 2022 to ${int(y[2023].deaths)} and life expectancy sliding from ${dec(y[2022].lifeExpectancy, 1)} to ${dec(y[2023].lifeExpectancy, 1)}, without explaining why.` },
  { q: 'Has any country cut fertility more than Libya since 1971?', a: `None with over a million people. Libya went from ${dec(tfrTop.fertility, 2)} per woman in 1971 to ${dec(c.fertility, 2)}, and crosses below 2.1 in ${repl}.` },
  { q: 'Is Libya sparsely populated?', a: `Yes: ${int(c.densityPerKm2)} people per km², second-lowest in Africa after Namibia among nations above a million, even though ${pct(c.urbanPct!)} are town dwellers.` },
  { q: 'How big does Libya get before it stops growing?', a: `To about ${millions(peak.population)}, around ${peak.year}.` },
];

const schema = countrySchema({
  page: PAGE, slug: lby.slug, name: lby.name, wikipedia: lby.wikipedia,
  headline: `Libya's ${millions(c.population)}: a 2011 outflow, mortality spikes in 2011 and 2023; fertility down from ${dec(tfrTop.fertility, 2)}`,
  description,
  datasetName: 'Libya population, net migration and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Libya for selected years from 1950 to ${CURRENT_YEAR} (every year 2010–2014 and 2022–2024 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: lby.published, updated: lby.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Libya"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Libya", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Libya: an outflow in 2011, and fertility from eight to two</h1>
        <LiveCounter
          label="Libya: estimated population as of this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 for mid-${CURRENT_YEAR}, rising by close to ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Libya's {CURRENT_YEAR} population, around <strong>{millions(c.population)}</strong> by UN estimate, is 6.7 times what it was in 1950, yet spread at just <strong>{int(c.densityPerKm2)}</strong> people per km². The series shows a sharp outflow in 2011 and fertility that has fallen from above eight to near two.
        </p>
        <div class="dates"><span>Updated <time datetime={lby.updated}>{longDate(lby.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Libya" code="ly" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How did Libya's numbers change in 2011?</h2>
          <p>Departures outnumbered arrivals by {int(-outTop.netMigrants)}, the largest margin in the series, and the mid-year total fell in 2011 and 2012; the only earlier fall came in 1983. Life expectancy went from {dec(y[2010].lifeExpectancy, 1)} in 2010 to {dec(y[2011].lifeExpectancy, 1)}, then returned to {dec(y[2012].lifeExpectancy, 1)} in 2012. The UN files carry these counts only.</p>
        </div>
        <div class="age-row" role="group" aria-label="Libya, mid-year totals 2010 to 2012 (UN)">
          <div><span class="y">2010</span><div class="v">{millionsShort(y[2010].population)}</div><span class="d">People</span></div>
          <div><span class="y">2011</span><div class="v">{millionsShort(y[2011].population)}</div><span class="d">People</span></div>
          <div><span class="y">2012</span><div class="v">{millionsShort(y[2012].population)}</div><span class="d">People</span></div>
        </div>

        <div class="story-block prose">
          <h2>What changed in Libya's mortality figures in 2023?</h2>
          <p>Deaths jumped from {int(y[2022].deaths)} in 2022 to {int(y[2023].deaths)}, and life expectancy slid from {dec(y[2022].lifeExpectancy, 1)} to {dec(y[2023].lifeExpectancy, 1)}; the source states no cause. The {CURRENT_YEAR} estimate is {dec(c.lifeExpectancy, 1)}.</p>
        </div>
        <LineChart
          title="Libyan life expectancy, 1950–2050"
          subtitle="Annual detail for 2010–2014 and 2022–2024; dashed after 2023."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Libya's fertility fallen more than anyone's?</h2>
          <p>Since 1971 no bigger drop is recorded for any country of a million-plus: {dec(tfrTop.fertility, 2)} that year, {dec(c.fertility, 2)} today, with the rate projected under 2.1 from {repl}. Men slightly outnumber women, {dec((c.male / c.female) * 100, 1)} to 100.</p>
        </div>

        <div class="story-block prose">
          <h2>Where do Libyans live?</h2>
          <p>Mostly in towns: {pct(c.urbanPct!)} are urban, second in Africa (countries above a million) only to Gabon, though the country as a whole averages {int(c.densityPerKm2)} people per km², second-lowest on the continent after Namibia. Growth continues until {peak.year}, when the projection reaches {millions(peak.population)}.</p>
        </div>
        <RelatedPages iso3={lby.iso3} name={lby.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Libya by year, 2010–2014 and 2022–2024 shown"
          subtitle="The 2011 and 2023 lines carry the two sharpest moves in the series."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${lby.slug}-population.csv`)}
          csvName={`${lby.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Libya, question by question</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{lby.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={lby.published}>{longDate(lby.published)}</time> · Updated <time datetime={lby.updated}>{longDate(lby.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Libya population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Libya" code="ly" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
