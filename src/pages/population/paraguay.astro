---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import pry from '../../data/countries/paraguay.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: the 2019–2021 life-expectancy
// fall (second-largest in Latin America and the Caribbean after Bolivia; no cause given); more men than women; third-lowest
// density in the region; ahead of Nicaragua 2014–2025 and again from 2069 on the projection; fertility fourth-highest in the region.
const PAGE = '/population/paraguay/';
const un = countryData(pry.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (pry.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
const drop = (d: any) => at(d, 2019).lifeExpectancy - at(d, 2021).lifeExpectancy;
assertClaim([...lac1].sort((a: any, b: any) => drop(b) - drop(a)).slice(0, 2).map((d: any) => d.iso3).join() === 'BOL,PRY', 'second-largest 2019–2021 drop after Bolivia');
assertClaim(y[2022].lifeExpectancy > y[2021].lifeExpectancy + 3, 'rebound 2022');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim(c.male > c.female && [...lac1].sort((a: any, b: any) => sr(b) - sr(a)).slice(0, 2).map((d: any) => d.iso3).join() === 'HND,PRY', 'more men than women; second after Honduras');
assertClaim([...lac1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).slice(0, 3).map((d: any) => d.iso3).join() === 'BOL,ARG,PRY', 'third-lowest density after Bolivia and Argentina');
assertClaim([...lac1].sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3).indexOf('PRY') === 3, 'fourth-highest fertility');
const nic = wpp.find((d: any) => d.iso3 === 'NIC');
assertClaim(un.years.find((r) => r.year > CURRENT_YEAR && r.population > at(nic, r.year).population)!.year === 2069, 'passes Nicaragua 2069');
assertClaim(un.years.filter((r) => r.year >= 2014 && r.year <= 2025).every((r) => r.population > at(nic, r.year).population) && c.population < at(nic).population, 'ahead of Nicaragua 2014–2025, behind in 2026');
assertClaim(un.years.every((r) => r.netMigrants < 0), 'net departures every year');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2007, 'largest outflow 2007');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2043, 'under 2.1 in 2043');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2078 && y[2100].population > y[2050].population, 'peak 2078; 2100 above 2050');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1990, 'urban majority 1990');
const since = c.population / y[1950].population;
assertClaim(since > 4.6 && since < 4.8, 'about 4.7 times 1950');

const title = `Paraguay Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Male-Majority Country With a 2021 Lifespan Slump | AtlasFigures`;
const description = `UN figures show ${millions(c.population)} Paraguayans in ${CURRENT_YEAR}. Lifespans shrank by ${dec(y[2019].lifeExpectancy - y[2021].lifeExpectancy, 1)} years between 2019 and 2021 before recovering; men slightly outnumber women; and Paraguay moves back ahead of Nicaragua in 2069 on the projection.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: pry.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, pry.tableYears);

const faq = [
  { q: "What happened to Paraguay's life expectancy in 2021?", a: `It sank to ${dec(y[2021].lifeExpectancy, 1)} years from ${dec(y[2019].lifeExpectancy, 1)} in 2019, then came back to ${dec(y[2022].lifeExpectancy, 1)} in 2022. The UN series records the change without a cause.` },
  { q: 'Are men or women the majority in Paraguay?', a: `Men, narrowly: ${dec((c.male / c.female) * 100, 1)} for every 100 women. Only Honduras, among Latin American and Caribbean nations over a million, has a higher ratio.` },
  { q: 'How sparse is settlement in Paraguay?', a: `Very: at ${int(c.densityPerKm2)} people per km², only Bolivia and Argentina are emptier in the region.` },
  { q: 'Will Paraguay outgrow Nicaragua?', a: `Again: Paraguay was the larger of the two from 2014 to 2025, Nicaragua edges ahead in ${CURRENT_YEAR}, and from 2069 the projection puts Paraguay back in front.` },
  { q: 'How long will Paraguayan fertility stay above 2.1?', a: `Until ${repl}; it is ${dec(c.fertility, 2)} this year, fourth-highest among the region's countries.` },
];

const schema = countrySchema({
  page: PAGE, slug: pry.slug, name: pry.name, wikipedia: pry.wikipedia,
  headline: `Paraguay's ${millions(c.population)}: the 2021 lifespan slump, a male majority and the overtaking of Nicaragua in 2069`,
  description,
  datasetName: 'Paraguay population, life expectancy and sex balance, 1950–2100',
  datasetDescription: `Mid-year population of Paraguay for selected years from 1950 to ${CURRENT_YEAR} (every year 2019–2022 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: pry.published, updated: pry.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Paraguay"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Paraguay", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Paraguay: wide open land and a sudden dip in lifespans</h1>
        <LiveCounter
          label="Paraguay: live estimate of the population"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Anchored to the UN World Population Prospects 2024 mid-${CURRENT_YEAR} estimate; grows by close to ${int(c.change / 365)} daily`}
        />
        <p class="answer">
          UN estimates show Paraguay growing 4.7-fold since 1950, to <strong>{millions(c.population)}</strong> as of {CURRENT_YEAR}, yet with only <strong>{int(c.densityPerKm2)}</strong> people per km². Men slightly outnumber women.
        </p>
        <div class="dates"><span>Updated <time datetime={pry.updated}>{longDate(pry.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Paraguay" code="py" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>What pulled Paraguayan lifespans down in 2021?</h2>
          <p>The UN data record the fall but not its cause: {dec(y[2019].lifeExpectancy, 1)} years in 2019, {dec(y[2020].lifeExpectancy, 1)} in 2020, {dec(y[2021].lifeExpectancy, 1)} in 2021, then {dec(y[2022].lifeExpectancy, 1)} in 2022. Among Latin American and Caribbean nations above a million, only Bolivia lost more between 2019 and 2021. The {CURRENT_YEAR} value is {dec(c.lifeExpectancy, 1)}.</p>
        </div>
        <LineChart
          title="Paraguay's life expectancy, 1950–2050, and the 2021 trough"
          subtitle="Annual points 2019–2022; projection drawn dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Paraguay's population majority male?</h2>
          <p>Yes: the ratio is {dec((c.male / c.female) * 100, 1)}, counting men per 100 women, and only Honduras has a higher one among Latin American and Caribbean nations above a million. Half of Paraguayans are under {dec(c.medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How much room does Paraguay have?</h2>
          <p>Plenty: {int(c.densityPerKm2)} people per km², a density beaten on the low side in the region only by Bolivia and Argentina. Still, {pct(c.urbanPct!)} live in urban areas, a majority since {urbanHalf}. Net migration is negative every year, most of all in {outTop.year} ({int(-outTop.netMigrants)}).</p>
        </div>

        <div class="story-block prose">
          <h2>When does Paraguay overtake Nicaragua?</h2>
          <p>For good from 2069, as projected. Paraguay was already the larger from 2014 to 2025, but Nicaragua edges back ahead in {CURRENT_YEAR}, the two almost level. Paraguay keeps growing until {peak.year}, reaching {millions(peak.population)}, with {millions(y[2100].population)} left in 2100. Its fertility, {dec(c.fertility, 2)}, the fourth-highest in the region, slips under 2.1 only in {repl}.</p>
        </div>
        <RelatedPages iso3={pry.iso3} name={pry.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Paraguay by year, 2019–2022 in full"
          subtitle="The 2021 row shows the lifespan trough; from 2069 Paraguay leads Nicaragua."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${pry.slug}-population.csv`)}
          csvName={`${pry.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Paraguay at a glance: questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{pry.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={pry.published}>{longDate(pry.published)}</time> · Updated <time datetime={pry.updated}>{longDate(pry.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Paraguay population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Paraguay" code="py" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
