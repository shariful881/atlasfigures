---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import kp from '../../data/countries/north-korea.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a population close to its projected peak (2032);
// fertility under 2.1 since 1996 but far above South Korea's; the early-1950s fall in the UN series (PRB dates the
// Korean War 1950–1953); a sharp drop in UN life expectancy from 1995 to 2002. Neutral wording; censuses 1993 and 2008
// (UNFPA). The UN files give no causes.
const PAGE = '/population/north-korea/';
const un = countryData(kp.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const UNFPA_URL = 'https://www.unfpa.org/news/unfpa-helps-plan-and-monitor-successful-dprk-census';
const PRB_URL = 'https://scorecard.prb.org/?p=1729';
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (kp.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const kr = wpp.find((d: any) => d.iso3 === 'KOR');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natNeg = un.years.find((r) => r.year > 1960 && r.naturalChange < 0)!.year;
assertClaim(peak.year === 2032 && natNeg === 2033, 'peak 2032; deaths exceed births from 2033');
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(under === 1996 && un.years.filter((r) => r.year >= under).every((r) => r.fertility < 2.1), 'fertility under 2.1 since 1996');
assertClaim(c.fertility > 2 * at(kr).fertility && c.medianAge < at(kr).medianAge - 9, 'fertility more than double South Korea; median age over nine years lower');
const eas = wpp.filter((d: any) => d.subregion === 'Eastern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(eas.slice(0, 4).join() === 'CHN,JPN,KOR,PRK' && c.population / at(kr).population > 0.48 && c.population / at(kr).population < 0.55, 'fourth in Eastern Asia after China, Japan, South Korea; about half South Korea');
const ageGap = at(kr).medianAge - c.medianAge;
assertClaim([1950, 1951, 1952, 1953].every((n) => y[n].change < 0) && y[1954].change > 0, 'population fell in each year 1950–1953');
const regain = un.years.find((r) => r.year > 1953 && r.population > y[1950].population)!.year;
assertClaim(regain === 1958, 'back above the 1950 level by 1958');
assertClaim(y[1950].lifeExpectancy < 15 && y[1953].lifeExpectancy > 40, 'life expectancy 14 in 1950, above 40 by 1953');
const dip = un.years.filter((r) => r.year >= 1995 && r.year <= 2002);
assertClaim(dip.every((r) => r.lifeExpectancy < 61.5 && r.lifeExpectancy > 60.5) && y[1994].lifeExpectancy > 70 && y[2003].lifeExpectancy > 69, 'life expectancy near 61 in 1995–2002, above 69 before and after');
assertClaim(un.years.filter((r) => r.year >= 1958 && r.year <= 1993).every((r) => r.netMigrants === 0) && un.years.filter((r) => r.year > 1993 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0 && r.netMigrants > -4000), 'zero net migration 1958–1993; tiny net outflows since');
assertClaim(y[1950].worldRank === 34 && c.worldRank === 56 && y[2100].worldRank === 78, 'rank 34 in 1950, 56 now, 78 in 2100');

const title = `North Korea Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M and a Peak in ${peak.year} | AtlasFigures`;
const description = `North Korea (DPRK): ${millions(c.population)} people by UN estimate for ${CURRENT_YEAR}; sub-replacement fertility since ${under}, a projected maximum near ${millions(peak.population)} in ${peak.year}, and two censuses, 1993 and 2008.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: kp.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: `Peak, ${peak.year}`, value: millionsShort(peak.population) },
];

const rows = displayRows(un.years, kp.tableYears);

const faq = [
  { q: 'What is the population of the DPRK?', a: `UN estimates for ${CURRENT_YEAR} give the Democratic People's Republic of Korea ${millions(c.population)} inhabitants, placing it ${ord(c.worldRank!)} on Earth and fourth among Eastern Asian countries.` },
  { q: 'Has North Korea held a census recently?', a: 'The most recent took place in October 2008. UNFPA, which helped plan and monitor it, describes it as the first population and housing census in the country since 1993.' },
  { q: 'Is North Korea losing population yet?', a: `Not yet: growth this year is ${pct(c.growthRatePct)}. The UN's central path reaches its maximum, ${millions(peak.population)}, in ${peak.year}; from the next year on, more people die than are born, and 2100 ends with ${millions(y[2100].population)}.` },
  { q: 'How does North Korea compare with South Korea?', a: `It has about half as many people and is much younger: a median age of ${dec(c.medianAge, 1)} against ${dec(at(kr).medianAge, 1)}, and ${dec(c.fertility, 2)} births per woman against ${dec(at(kr).fertility, 2)}.` },
  { q: 'Do people migrate to or from North Korea?', a: `Very little, in the UN figures: net migration is zero in every year from 1958 to 1993 and a net outflow of only a few thousand a year since, about ${int(Math.round(-c.netMigrants / 1000))} thousand in ${CURRENT_YEAR}.` },
];

const schema = countrySchema({
  page: PAGE, slug: kp.slug, name: kp.name, wikipedia: kp.wikipedia,
  headline: `North Korea's ${millions(c.population)}: fertility under 2.1 since ${under} and a projected peak in ${peak.year}`,
  description,
  datasetName: 'North Korea (DPRK) population, fertility and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of the Democratic People's Republic of Korea for selected years from 1950 to ${CURRENT_YEAR} (1950–1953 and the mid-1990s included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: kp.published, updated: kp.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [
    { name: 'UNFPA Helps Plan and Monitor Successful DPRK Census', url: UNFPA_URL, publisher: 'UNFPA' },
    { name: 'Korea population scorecard', url: PRB_URL, publisher: 'Population Reference Bureau' },
  ],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="North Korea"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'North Korea', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>North Korea: a slowing population, near its high point</h1>
        <LiveCounter
          label="North Korea: population estimate in real time"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} base, about ${int(c.change / 365)} added daily`}
        />
        <p class="answer">
          The UN's mid-{CURRENT_YEAR} estimate for North Korea is <strong>{millions(c.population)}</strong>, which ranks it {ord(c.worldRank!)}. Women have averaged fewer than 2.1 children since {under}, yearly growth has slowed to <strong>{pct(c.growthRatePct)}</strong>, and the medium projection reaches its highest point, {millions(peak.population)}, in {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={kp.updated}>{longDate(kp.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="North Korea" code="kp" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How often has North Korea held a census?</h2>
          <p>Twice in recent decades, in 1993 and in October 2008; UNFPA, which helped plan and monitor the 2008 count, calls it the first population and housing census there since 1993. Every figure on this page is the UN's estimate or projection for the Democratic People's Republic of Korea, and the UN files record numbers, not explanations.</p>
        </div>

        <div class="story-block prose">
          <h2>When will North Korea's numbers begin to fall?</h2>
          <p>Right after {peak.year}, when the medium variant reaches {millions(peak.population)}. From {natNeg} onward deaths outnumber births, leaving {millions(y[2100].population)} in 2100. North Korea sat {ord(y[1950].worldRank!)} on the world list in 1950, sits {ord(c.worldRank!)} today and would drop to {ord(y[2100].worldRank!)} by the end of the projection.</p>
        </div>
        <LineChart
          title="North Korea, 1950–2100: the early dip, the rise and the projected decline"
          subtitle="UN mid-year totals (1950–1953 shown individually); the projection after the estimate years is dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why do the UN figures fall in the early 1950s?</h2>
          <p>The series begins during the Korean War, which the Population Reference Bureau dates to 1950–1953. The UN records a smaller population in each of those years, {millions(y[1950].population)} at the 1950 mid-point against {millions(y[1953].population)} three years later, with life expectancy at birth of {dec(y[1950].lifeExpectancy, 1)} years in 1950. The total was back above its 1950 level by {regain}.</p>
        </div>

        <div class="story-block prose">
          <h2>Why does North Korean life expectancy dip in the late 1990s data?</h2>
          <p>The UN files do not say. Their estimate goes from {dec(y[1994].lifeExpectancy, 1)} years in 1994 to {dec(y[1995].lifeExpectancy, 1)} in 1995 and stays near 61 until 2002, before returning to {dec(y[2003].lifeExpectancy, 1)} in 2003. Deaths rise from about {int(Math.round(y[1994].deaths / 1000))} thousand in 1994 to {int(Math.round(y[1995].deaths / 1000))} thousand in 1995. Today's figure is {dec(c.lifeExpectancy, 1)} years.</p>
        </div>

        <div class="story-block prose">
          <h2>How does North Korea differ from South Korea?</h2>
          <p>It is much younger and has more children. North Korea's fertility rate, {dec(c.fertility, 2)}, is more than double South Korea's {dec(at(kr).fertility, 2)}, and its median age, {dec(c.medianAge, 1)}, is {dec(ageGap, 1)} years lower. With {millions(c.population)} people, it ranks fourth in Eastern Asia, after China, Japan and South Korea.</p>
        </div>
        <LineChart
          title="North Korean fertility since 1950 and the UN projection to 2050"
          subtitle="Children per woman by UN estimate, then medium-variant projection in dashes; line drawn at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'level of 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={kp.iso3} name={kp.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="North Korea (DPRK): UN estimates and projections"
          subtitle="Separate rows for 1950–1953, 1994–1995 and 2002–2003; the projection begins after the estimate years."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${kp.slug}-population.csv`)}
          csvName={`${kp.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">North Korea in a few answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{kp.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={UNFPA_URL}>UNFPA, "UNFPA Helps Plan and Monitor Successful DPRK Census"</a> (15 February 2010): the 2008 census as the first since 1993.</li>
            <li><a href={PRB_URL}>Population Reference Bureau, Korea scorecard</a> (December 2010): the 1950–1953 Korean War.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={kp.published}>{longDate(kp.published)}</time> · Updated <time datetime={kp.updated}>{longDate(kp.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('North Korea population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="North Korea" code="kp" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
