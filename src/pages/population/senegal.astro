---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import sn from '../../data/countries/senegal.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the highest life expectancy and lowest infant
// mortality among Western African countries of ten million or more; more men than women since 2016 (and 1964–1982),
// projected to 2047; net departures every year 1975–2012, net arrivals 2013–2022; growth in every year; urban majority
// since 2020. Counts only; the UN files give no causes.
const PAGE = '/population/senegal/';
const un = countryData(sn.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (sn.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const wafBig = big.filter((d: any) => d.subregion === 'Western Africa');
assertClaim([...wafBig].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy)[0].iso3 === 'SEN', 'highest life expectancy among large Western African countries');
assertClaim([...wafBig].sort((a: any, b: any) => at(a).infantMortalityPer1000 - at(b).infantMortalityPer1000)[0].iso3 === 'SEN', 'lowest infant mortality among large Western African countries');
const gain = (d: any) => at(d).lifeExpectancy - at(d, 2000).lifeExpectancy;
assertClaim([...wafBig].sort((a: any, b: any) => gain(b) - gain(a)).slice(0, 2).map((d: any) => d.iso3).join() === 'NER,SEN', 'second-largest life-expectancy gain since 2000 among them, after Niger');
const imrCut = (d: any) => at(d).infantMortalityPer1000 / at(d, 2000).infantMortalityPer1000;
const afBig = big.filter((d: any) => d.region === 'Africa');
assertClaim([...afBig].sort((a: any, b: any) => imrCut(a) - imrCut(b)).map((d: any) => d.iso3).indexOf('SEN') === 3, 'fourth-largest proportional cut in infant mortality since 2000 among African countries of ten million or more');
const menYears = un.years.filter((r) => r.male > r.female).map((r) => r.year);
const run1 = menYears.filter((n) => n < 2000); const run2 = menYears.filter((n) => n >= 2000);
assertClaim(run1[0] === 1964 && run1[run1.length - 1] === 1982 && run1.length === 19 && run2[0] === 2016 && run2[run2.length - 1] === 2047 && run2.length === 32, 'more men than women 1964–1982 and 2016–2047');
const outYears = un.years.filter((r) => r.year >= 1975 && r.year <= 2012);
const inYears = un.years.filter((r) => r.year >= 2013 && r.year <= 2022);
assertClaim(outYears.every((r) => r.netMigrants < 0) && inYears.every((r) => r.netMigrants > 0) && y[1974].netMigrants > 0 && y[2023].netMigrants < 0, 'net departures 1975–2012, net arrivals 2013–2022');
const outTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2010, 'largest net departures 2010');
assertClaim(un.years.every((r, i, a) => i === 0 || r.population > a[i - 1].population), 'grows every year');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2020, 'urban majority since 2020');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1980 && under === 2094, 'fertility high 1980; under 2.1 from 2094');
assertClaim([...wafBig].sort((a: any, b: any) => at(a).fertility - at(b).fertility).slice(0, 2).map((d: any) => d.iso3).join() === 'GHA,SEN', 'second-lowest fertility among large Western African countries, after Ghana');
const waf = wpp.filter((d: any) => d.subregion === 'Western Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(waf.indexOf('SEN') === 6, 'seventh in Western Africa');
const times = c.population / y[1950].population;
assertClaim(times > 7.5 && times < 7.7, 'about seven and a half times 1950');

const title = `Senegal, ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M People and West Africa's Longest Lives | AtlasFigures`;
const description = `Of Western Africa's ten-million-plus nations, Senegal (UN estimate for ${CURRENT_YEAR}: ${millions(c.population)}) has the longest lives, ${dec(c.lifeExpectancy, 1)} years; males outnumber females and the majority is urban.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: sn.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, sn.tableYears);

const faq = [
  { q: 'How long do Senegalese people live?', a: `${dec(c.lifeExpectancy, 1)} years from birth this year, longer than in Western Africa's other big countries; it was ${dec(y[2000].lifeExpectancy, 1)} in 2000.` },
  { q: 'Are men the majority in Senegal?', a: `They are: the UN's ${CURRENT_YEAR} ratio is ${dec((c.male / c.female) * 100, 1)} males to 100 females. That has held since 2016 and continues in the projection through 2047, with no cause given in the data.` },
  { q: 'Is Senegal losing people to migration?', a: `This year, slightly: about ${int(Math.round(-c.netMigrants / 1000))} thousand on balance. The UN shows outflows each year of 1975–2012 and inflows each year of 2013–2022.` },
  { q: 'Has infant mortality fallen in Senegal?', a: `Sharply. In 2000, ${dec(y[2000].infantMortalityPer1000!, 1)} of every thousand babies died in their first year; now it is ${dec(c.infantMortalityPer1000!, 1)}, the best rate among the larger Western African countries.` },
  { q: 'What population does the UN expect for Senegal in 2050?', a: `${millions(y[2050].population)}, says the UN medium variant, then ${millions(y[2100].population)} by 2100; fertility, ${dec(c.fertility, 2)} now, is projected under 2.1 only from ${under}.` },
];

const schema = countrySchema({
  page: PAGE, slug: sn.slug, name: sn.name, wikipedia: sn.wikipedia,
  headline: `Senegal's ${millions(c.population)}: the longest lives in large West African states and a male majority since 2016`,
  description,
  datasetName: 'Senegal population, life expectancy and sex balance, 1950–2100',
  datasetDescription: `Mid-year population of Senegal for selected years from 1950 to ${CURRENT_YEAR} (2012, 2013, 2016 and 2022 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: sn.published, updated: sn.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Senegal"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Senegal", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Senegal: longer lives than its large West African neighbours</h1>
        <LiveCounter
          label="Senegal: estimated population at present"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} number, growing by roughly ${int(c.change / 365)} people per day`}
        />
        <p class="answer">
          Among the Western African nations of ten million or more, Senegalese live longest, <strong>{dec(c.lifeExpectancy, 1)}</strong> years at birth, and lose the fewest infants. The UN estimates <strong>{millions(c.population)}</strong> people for mid-{CURRENT_YEAR}, with slightly more men than women.
        </p>
        <div class="dates"><span>Updated <time datetime={sn.updated}>{longDate(sn.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Senegal" code="sn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Do people in Senegal live longer than elsewhere in West Africa?</h2>
          <p>Longer than in the region's other ten-million-plus nations, yes. Life expectancy was {dec(y[1950].lifeExpectancy, 1)} in 1950, {dec(y[2000].lifeExpectancy, 1)} in 2000 and is {dec(c.lifeExpectancy, 1)} now; in that group only Niger has gained more since 2000. The infant mortality rate went from {dec(y[2000].infantMortalityPer1000!, 1)} down to {dec(c.infantMortalityPer1000!, 1)} for every thousand births, a cut that only three of Africa's large nations beat in proportion.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy at birth in Senegal">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
          <div><span class="y">2000</span><div class="v">{dec(y[2000].lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
        </div>

        <div class="story-block prose">
          <h2>Why are males the majority in Senegal?</h2>
          <p>The UN files show the imbalance but not its cause: {dec((c.male / c.female) * 100, 1)} males for each 100 females this year. Males were also the majority between 1964 and 1982, became so again in 2016 and stay ahead until 2047 in the projection. Migration has swung as well, outward each year of 1975–2012 (most in {outTop.year}, near {int(Math.round(-outTop.netMigrants / 1000))} thousand) and inward in 2013–2022.</p>
        </div>
        <LineChart
          title="Senegal's population curve, 1950–2100"
          subtitle="Mid-year totals in UN data, rising every year; the projection is dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How quickly is Senegalese fertility falling?</h2>
          <p>It has roughly halved, from a {tfrTop.year} high of {dec(tfrTop.fertility, 2)} to {dec(c.fertility, 2)} today, second-lowest among large Western African countries after Ghana. The medium variant crosses 2.1 only in {under}. Meanwhile the population, {dec(times, 1)} times its 1950 size, heads for {millions(y[2050].population)} in 2050 and is still rising in 2100, at {millions(y[2100].population)}; Senegal is seventh in Western Africa.</p>
        </div>
        <LineChart
          title="How Senegal's fertility has fallen, 1950–2050"
          subtitle="UN estimates and medium variant (dashed), with a 2.1 reference."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'ref. 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Senegal now mostly urban?</h2>
          <p>Yes. Since {urbanHalf} towns and cities have held more Senegalese than the countryside, by the national count; the share now stands at {pct(c.urbanPct!)}, compared with {pct(y[1950].urbanPct!)} in 1950, and {pct(y[2050].urbanPct!)} is projected for 2050. Density works out at {int(c.densityPerKm2)} per km² across {int(un.landAreaKm2)} km² of land.</p>
        </div>
        <RelatedPages iso3={sn.iso3} name={sn.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Senegal by year, with 2012, 2013, 2016 and 2022"
          subtitle="Net migration turns positive in 2013 and negative again after 2022."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${sn.slug}-population.csv`)}
          csvName={`${sn.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Senegal in numbers: questions and answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{sn.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={sn.published}>{longDate(sn.published)}</time> · Updated <time datetime={sn.updated}>{longDate(sn.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Senegal population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Senegal" code="sn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
