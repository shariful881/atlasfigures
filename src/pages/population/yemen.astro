---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import ye from '../../data/countries/yemen.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the highest fertility of any country in the UN
// series (mid-1980s), a ninefold rise since 1950, life expectancy from under 30 to near 70, and a projection that makes
// Yemen the most populous country of Western Asia by 2100. Neutral wording: numbers only, no causes.
const PAGE = '/population/yemen/';
const un = countryData(ye.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ye.verification as any).checkedOn as string | undefined;
const BRIT_URL = 'https://www.britannica.com/place/Yemen';

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => !r.projection);
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const allMax = wpp.flatMap((d: any) => d.years.filter((r: any) => !r.projection).map((r: any) => ({ iso: d.iso3, v: r.fertility }))).reduce((a: any, b: any) => (b.v > a.v ? b : a));
assertClaim(tfrMax.year === 1985 && allMax.iso === 'YEM', 'highest fertility of any country in the UN series, 1985');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 2081, 'fertility under 2.1 only from 2081');
const times = c.population / y[1950].population;
assertClaim(times > 9 && times < 9.6, 'more than nine times 1950');
const westNow = wpp.filter((d: any) => d.subregion === 'Western Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
const west2100 = wpp.filter((d: any) => d.subregion === 'Western Asia').sort((a: any, b: any) => at(b, 2100).population - at(a, 2100).population).map((d: any) => d.iso3);
assertClaim(westNow.slice(0, 3).join(',') === 'TUR,IRQ,YEM' && west2100[0] === 'YEM', 'third in Western Asia now, first by 2100');
assertClaim(y[1950].lifeExpectancy < 30 && c.lifeExpectancy > 69, 'life expectancy from under 30 to almost 70');
assertClaim(un.years.filter((r) => r.year >= 2023 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0) && c.naturalChange > 50 * -c.netMigrants, 'small net outflow; births far outweigh it');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
const birthsGrow = c.births > y[2010].births;
assertClaim(birthsGrow, 'more births now than in 2010');
assertClaim(west2100[1] === 'IRQ' && west2100[2] === 'SAU', 'ahead of Iraq and Saudi Arabia in 2100');
assertClaim(c.fertility < tfrMax.fertility / 2 && c.lifeExpectancy > 2 * y[1950].lifeExpectancy, 'fertility more than halved; life expectancy more than doubled');
assertClaim(y[1980].fertility > 8 && y[1990].fertility > 8, 'fertility above 8 in the 1980 and 1990 rows');

const title = `Yemen Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Nine Times Its 1950 Size | AtlasFigures`;
const description = `Yemen holds ${millions(c.population)} people this year on the UN's reckoning, after the highest fertility any country has registered in the UN series. Growth, family size, lifespans and a projected ${millions(y[2100].population)}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ye.capital, note: 'political capital (Britannica)' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, ye.tableYears);
assertClaim(rows.filter((r) => r.projection).every((r, i, a) => i === 0 || r.population > a[i - 1].population), 'total rises in every projected row');

assertClaim(y[1990].growthRatePct > c.growthRatePct + 0.8, 'growth slower than in 1990');
const faq = [
  { q: 'Where does Yemen rank by population?', a: `${ord(c.worldRank!)} in the world, with roughly ${millions(c.population)} by the UN's count for mid-${CURRENT_YEAR}, and third within Western Asia behind Turkey and Iraq.` },
  { q: 'Did Yemen have the highest birth rate in the world?', a: `In the UN series, yes. The ${tfrMax.year} rate of ${dec(tfrMax.fertility, 2)} births per woman is the top value logged for any country from 1950 on; today's rate is ${dec(c.fertility, 2)}.` },
  { q: 'Has Yemen\'s growth eased since the 1990s?', a: `A little. Growth runs at ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, down from ${pct(y[1990].growthRatePct)} in 1990, which still means roughly ${millions(c.change)} extra people, nearly all from births outnumbering deaths.` },
  { q: 'Will Yemen ever be the most populous country in its region?', a: `Yes, if the UN's middle path holds: by 2100 Yemen tops every Western Asian country with ${millions(y[2100].population)}, ahead of Iraq and Saudi Arabia.` },
  { q: 'Is Sanaa the capital of Yemen?', a: 'Sanaa is the political capital in Encyclopaedia Britannica\'s account, with Aden as the economic centre.' },
];

const schema = countrySchema({
  page: PAGE, slug: ye.slug, name: ye.name, wikipedia: ye.wikipedia,
  headline: `Yemen's ${millions(c.population)}: record fertility, ninefold growth and a projected lead in Western Asia`,
  description,
  datasetName: 'Yemen population, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Yemen for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ye.published, updated: ye.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Yemen', url: BRIT_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Yemen"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Yemen', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Yemen: from record family size to steady fast growth</h1>
        <LiveCounter
          label="Yemen: population counter, estimated"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, increasing by some ${int(c.change / 365)} each day`}
        />
        <p class="answer">
          Yemen numbers roughly <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, which ranks it {ord(c.worldRank!)} and more than <strong>nine times</strong> the 1950 count. Its {tfrMax.year} fertility of {dec(tfrMax.fertility, 2)} is the peak in the UN's records; it is {dec(c.fertility, 2)} today.
        </p>
        <div class="dates"><span>Updated <time datetime={ye.updated}>{longDate(ye.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Yemen" code="ye" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Did Yemen once have the world's highest fertility rate?</h2>
          <p>Yes. For {tfrMax.year} the UN gives {dec(tfrMax.fertility, 2)} births per woman, the highest value for any country in its series since 1950. The rate has more than halved since then, to {dec(c.fertility, 2)}, but stays above 2.1 until {below} on the medium projection. Births keep climbing, from {millions(y[2010].births)} in 2010 to about {millions(c.births)} now.</p>
        </div>
        <LineChart
          title="Fertility in Yemen since 1950, projected to 2050"
          subtitle="UN children-per-woman series with the projection dashed; the 2.1 level drawn in."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Yemen's population still growing fast?</h2>
          <p>Yes: {pct(c.growthRatePct)} this year, on top of a more than ninefold rise since 1950, when Yemen had {millions(y[1950].population)}. Births outnumber deaths by roughly {millions(c.naturalChange)}, which accounts for practically all of the gain, while the UN records a small net outflow near {int(Math.round(-c.netMigrants / 1000))} thousand. Half of all Yemenis have not yet turned {dec(c.medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How has life expectancy changed in Yemen?</h2>
          <p>It has more than doubled. A child born in 1950 could expect about {dec(y[1950].lifeExpectancy, 1)} years in the UN estimate; the {CURRENT_YEAR} figure is {dec(c.lifeExpectancy, 1)}. The urban share, {pct(y[1950].urbanPct!)} in 1950 by the national definition, is {pct(c.urbanPct!)} now.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy in Yemen">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].lifeExpectancy, 1)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>Will Yemen overtake Turkey and Iraq?</h2>
          <p>The medium projection says so. Yemen ranks third in the region today, after Turkey and Iraq, but grows to {millions(y[2050].population)} in 2050 and then {millions(y[2100].population)} in 2100, still rising at that point and ahead of every other Western Asian country. Britannica describes Sanaa as the political capital (<a href={BRIT_URL}>Encyclopaedia Britannica</a>).</p>
        </div>
        <LineChart
          title="Yemen's population curve from 1950 to 2100"
          subtitle="UN totals for each 1 July; the projection drawn dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={ye.iso3} name={ye.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Yemen, 1950 to 2100, decade by decade"
          subtitle="Rates above 8 births per woman appear in the 1980 and 1990 rows; every projected row is larger than the one before."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ye.slug}-population.csv`)}
          csvName={`${ye.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Yemen's people in brief</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ye.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={BRIT_URL}>Encyclopaedia Britannica, "Yemen"</a>: Sanaa as the political capital, Aden as the economic centre.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ye.published}>{longDate(ye.published)}</time> · Updated <time datetime={ye.updated}>{longDate(ye.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Yemen population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Yemen" code="ye" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
