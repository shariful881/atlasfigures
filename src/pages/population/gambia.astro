---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import gmb from '../../data/countries/gambia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fourth-densest of Africa's 1M+ countries
// (after Mauritius, Rwanda, Burundi); about 9.4 times its 1950 size with no year of decline 1950–2100; net departures
// every year from 1994 through the projection to 2100, after inflows peaking in 1991; urban share from 10.5% (1950)
// to a majority from 2003; fertility from a 1976 high of 6.43; median age 18.8.
const PAGE = '/population/gambia/';
const un = countryData(gmb.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (gmb.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const g1 = wpp.filter((d: any) => at(d).population >= 1e6 && d.region === 'Africa');
assertClaim([...g1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 4).map((d: any) => d.iso3).join() === 'MUS,RWA,BDI,GMB', 'fourth-densest in Africa');
const since = c.population / y[1950].population;
assertClaim(since > 9.3 && since < 9.5, 'about 9.4 times 1950');
assertClaim(un.years.every((r) => !y[r.year - 1] || r.population > y[r.year - 1].population) && un.years.every((r) => r.naturalChange > 0), 'no fall, births above deaths always');
assertClaim(un.years.filter((r) => r.year >= 1994).every((r) => r.netMigrants < 0) && y[1993].netMigrants > 0, 'net departures from 1994 to 2100');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1991, 'inflow peak 1991');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2003, 'urban majority 2003');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1976 && repl === 2065, 'fertility high 1976, under 2.1 in 2065');
assertClaim(c.medianAge < 19, 'median under 19');

const title = `Gambia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Densely Settled, Young, Ninefold Since 1950 | AtlasFigures`;
const description = `Gambia, ${CURRENT_YEAR}: ${millions(c.population)} on UN estimates, close to 9.4 times the 1950 count, packed at ${int(c.densityPerKm2)} per km²: fourth on the continent among million-plus nations. The median resident is ${dec(c.medianAge, 1)}; outflows have exceeded inflows since 1994.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: gmb.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, gmb.tableYears);

const faq = [
  { q: 'Is Gambia densely packed by African standards?', a: `Yes: ${int(c.densityPerKm2)} per km² ranks fourth among the continent's million-plus nations, after Mauritius, Rwanda and Burundi.` },
  { q: 'Are most Gambians under twenty?', a: `Yes: half are younger than ${dec(c.medianAge, 1)} years, per the UN's ${CURRENT_YEAR} estimate.` },
  { q: 'Gambian net migration: when did it turn negative?', a: `Since 1994, every year, and the UN projection keeps net departures through 2100. The busiest inflow year was 1991, with ${int(inTop.netMigrants)}. No reasons are attached.` },
  { q: 'In which year did Gambia turn majority-urban?', a: `2003. Back in 1950 just ${pct(y[1950].urbanPct!)} lived in towns; now ${pct(c.urbanPct!)} do.` },
  { q: "Does Gambia's headcount rise every year to 2100?", a: `Yes; the medium-variant line climbs to ${millions(y[2100].population)}; births outnumber deaths throughout.` },
];

const schema = countrySchema({
  page: PAGE, slug: gmb.slug, name: gmb.name, wikipedia: gmb.wikipedia,
  headline: `Gambia's ${millions(c.population)}: fourth-densest of Africa's 1M+ nations; ninefold since 1950; net departures every year from 1994`,
  description,
  datasetName: 'Gambia population, density and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Gambia for selected years from 1950 to ${CURRENT_YEAR}, including 1976, 1991, 1993–1994, 2003 and 2019–2020, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: gmb.published, updated: gmb.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Gambia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Gambia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Gambia: crowded, youthful and still growing</h1>
        <LiveCounter
          label="Gambia: population at this instant (estimate)"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Extends the UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, rising by nearly ${int(c.change / 365)} per day`}
        />
        <p class="answer">
          Gambia's UN estimate for {CURRENT_YEAR} stands at <strong>{millions(c.population)}</strong>, crammed in at <strong>{int(c.densityPerKm2)}</strong> people per km². Half of them are under {dec(c.medianAge, 1)}.
        </p>
        <div class="dates"><span>Updated <time datetime={gmb.updated}>{longDate(gmb.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Gambia" code="gm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Just how packed is Gambia?</h2>
          <p>Enough to rank fourth in Africa among nations with a million-plus residents: {int(c.densityPerKm2)} per km², behind only Mauritius, Rwanda and Burundi. The 1950 count of {int(y[1950].population)} has multiplied roughly 9.4 times, and not one year between 1950 and 2100 shows a decline in the UN figures.</p>
        </div>

        <div class="story-block prose">
          <h2>What keeps Gambia's age profile so low?</h2>
          <p>The data show the pattern rather than its cause: the median Gambian is {dec(c.medianAge, 1)}, and {CURRENT_YEAR} expects {int(c.births)} births against {int(c.deaths)} deaths. Fertility topped out in 1976 at {dec(tfrTop.fertility, 2)} and is {dec(c.fertility, 2)} today; the projection crosses below 2.1 only in 2065.</p>
        </div>
        <LineChart
          title="Gambian fertility, 1950–2100, down from a 1976 high"
          subtitle="UN fertility estimates and projections, with the 2.1 line."
          points={rows.map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'replacement 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Are Gambians emigrating?</h2>
          <p>On balance, yes: since 1994 each year records more departures than arrivals ({int(-c.netMigrants)} net in {CURRENT_YEAR}), and the projection keeps that sign through 2100. Before then, inflows dominated, peaking at {int(inTop.netMigrants)} in 1991. The UN figures carry no explanation.</p>
        </div>

        <div class="story-block prose">
          <h2>How urban has Gambia become?</h2>
          <p>Majority-urban since 2003: {pct(y[1950].urbanPct!)} in 1950, {pct(c.urbanPct!)} today, {pct(y[2050].urbanPct!)} projected for 2050. Expect roughly {millions(y[2050].population)} as 2050 arrives, then {millions(y[2100].population)} once the century closes.</p>
        </div>
        <RelatedPages iso3={gmb.iso3} name={gmb.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Gambia: 1976, 1991–1994, 2003, 2019–2020 and every decade"
          subtitle="From the 1994 row onward, net migration carries a minus sign."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${gmb.slug}-population.csv`)}
          csvName={`${gmb.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Gambia: answers from the UN tables</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{gmb.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={gmb.published}>{longDate(gmb.published)}</time> · Updated <time datetime={gmb.updated}>{longDate(gmb.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Gambia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Gambia" code="gm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
