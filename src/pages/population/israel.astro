---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import isr from '../../data/countries/israel.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Neutral, counts only: the highest fertility and the
// youngest median age among countries of a million or more with life expectancy of 80 or above; growth of about 7.5
// times since 1950; net arrivals peaking in 1990–1991, net departures only in 1985–1986; growth through 2100 with births
// rising until 2081. The Key facts cell is labelled "Seat of government".
const PAGE = '/population/israel/';
const un = countryData(isr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (isr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m80 = wpp.filter((d: any) => at(d).population >= 1e6 && at(d).lifeExpectancy >= 80);
assertClaim([...m80].sort((a: any, b: any) => at(b).fertility - at(a).fertility)[0].iso3 === 'ISR', 'highest fertility among 1M+ with life expectancy 80+');
assertClaim([...m80].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge)[0].iso3 === 'ISR', 'youngest median among the same group');
const times = c.population / y[1950].population;
assertClaim(times > 7.3 && times < 7.6, 'about 7.5 times 1950');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1990 && y[1991].netMigrants > 1.5e5, 'largest net inflow 1990, over 150,000 again in 1991');
assertClaim(un.years.filter((r) => r.netMigrants < 0).map((r) => r.year).join() === '1985,1986', 'net departures only 1985–1986');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2069 && un.years.filter((r) => r.year <= 2050).every((r) => r.fertility > 2.1), 'above 2.1 through 2050, under 2.1 from 2069');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2081, 'births peak 2081');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const dbl = un.years.find((r) => r.population >= 2 * c.population)!.year;
assertClaim(peak.year === 2100 && dbl === 2096, 'doubles by 2096, still growing in 2100');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...m1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).map((d: any) => d.iso3).indexOf('ISR') === 13, '14th-densest among 1M+');
assertClaim(c.deaths * 3 < c.births, 'births more than three times deaths');

const title = `Israel Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Long Lives and Large Families in the UN Data | AtlasFigures`;
const description = `Israel's population in UN figures: ${millions(c.population)} for ${CURRENT_YEAR}. Its fertility, ${dec(c.fertility, 2)}, tops every other country of more than a million where life expectancy is 80 or more; the projection roughly doubles the total by 2096.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Seat of government', value: isr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
];

const rows = displayRows(un.years, isr.tableYears);

const faq = [
  { q: "Why is Israel's fertility rate high for a country where people live so long?", a: `The UN data show the rate, ${dec(c.fertility, 2)}, but not its causes. No other country over a million people with life expectancy of 80 or more has a higher rate.` },
  { q: "How does Israel's population today compare with 1950?", a: `It is roughly 7.5 times larger; the UN's 1950 figure is ${millions(y[1950].population)}.` },
  { q: 'Which years saw the most arrivals in Israel?', a: `1990 and 1991, with net gains of ${int(inTop.netMigrants)} and ${int(y[1991].netMigrants)}. The only years with net departures in the UN series are 1985 and 1986.` },
  { q: "Does Israel's population double this century?", a: `In the projection, yes: it passes twice today's level in ${dbl}, with ${millions(y[2100].population)} in 2100.` },
  { q: 'How long is life expectancy in Israel?', a: `${dec(c.lifeExpectancy, 1)} years in the ${CURRENT_YEAR} UN estimate.` },
];

const schema = countrySchema({
  page: PAGE, slug: isr.slug, name: isr.name, wikipedia: isr.wikipedia,
  headline: `Israel's ${millions(c.population)}: fertility of ${dec(c.fertility, 2)} alongside life expectancy above 80; a doubling projected by ${dbl}`,
  description,
  datasetName: 'Israel population, fertility and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Israel for selected years from 1950 to ${CURRENT_YEAR}, including 1985–1986 and 1990–1991, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: isr.published, updated: isr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Israel"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Israel", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Israel: high fertility and long life expectancy together</h1>
        <LiveCounter
          label="Israel: estimated population just now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 mid-${CURRENT_YEAR} estimate, plus roughly ${int(c.change / 365)} people per day`}
        />
        <p class="answer">
          Israel's head count reaches <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, on UN estimates, about 7.5 times the 1950 count. Women average <strong>{dec(c.fertility, 2)}</strong> children, a high rate for a country whose life expectancy is {dec(c.lifeExpectancy, 1)}.
        </p>
        <div class="dates"><span>Updated <time datetime={isr.updated}>{longDate(isr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Israel" code="il" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How does Israel combine high fertility with long lives?</h2>
          <p>The UN data record both without explaining them. Of all countries above a million people where life expectancy is 80 or more, Israel has the highest fertility, at {dec(c.fertility, 2)}, and the youngest median age, {dec(c.medianAge, 1)}. Births, {int(c.births)} this year, are more than three times deaths, {int(c.deaths)}.</p>
        </div>
        <LineChart
          title="Fertility in Israel, 1950–2050, above 2.1 throughout"
          subtitle="UN estimates and medium-variant projection (dashed); the rate stays above 2.1 until 2069."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 mark' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>When did most migrants arrive in Israel?</h2>
          <p>The largest net inflows in the UN series come in 1990, {int(inTop.netMigrants)}, and 1991, {int(y[1991].netMigrants)}. Net migration is positive in every year except 1985 and 1986; this year it is {int(c.netMigrants)}. The UN files carry counts only.</p>
        </div>

        <div class="story-block prose">
          <h2>How large could Israel's population become?</h2>
          <p>About twice today's by the mid-2090s: the projection crosses that mark in {dbl} and shows {millions(y[2100].population)} for 2100, still growing. Fertility does not fall below 2.1 until {repl} in the projection, and yearly births go on rising until {birthTop.year}.</p>
        </div>
        <LineChart
          title="Israel's population, 1950 to 2100"
          subtitle="UN mid-year totals, projected (dashed) to keep rising through 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Israel among the world's most crowded countries?</h2>
          <p>Yes: with {int(c.densityPerKm2)} residents to each km², it is 14th among the world's countries and areas above one million inhabitants. Urban residents, by Israel's own definition, are {pct(c.urbanPct!)} of the total.</p>
        </div>
        <RelatedPages iso3={isr.iso3} name={isr.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Israeli figures through the years, 1985–1986 and 1990–1991 shown"
          subtitle="The only net-departure years and the largest inflows sit in these rows."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${isr.slug}-population.csv`)}
          csvName={`${isr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Israel in numbers: common questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{isr.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={isr.published}>{longDate(isr.published)}</time> · Updated <time datetime={isr.updated}>{longDate(isr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Israel population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Israel" code="il" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
