---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import bih from '../../data/countries/bosnia-and-herzegovina.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peak 1991 (4.46 million); 1992 net outflow
// of about 437,000, near a tenth of the 1991 total; life expectancy 52.0 and 50.9 in 1992–1993 against 71.8 in 1991;
// falls 1992–1995, net arrivals 1995–2001 and a rise 1996–2002; a fall in every year from 2003 to 2100; now about 70%
// of the peak, fourth-largest drop among 1M+ countries; ninth-highest median age; fewest births of the series in 2026.
// The UN files give no causes, and the page names none.
const PAGE = '/population/bosnia-and-herzegovina/';
const un = countryData(bih.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (bih.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991, 'peak 1991');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1992 && -outTop.netMigrants / y[1991].population > 0.095 && -outTop.netMigrants / y[1991].population < 0.1, '1992 outflow near a tenth');
assertClaim(y[1992].lifeExpectancy < 53 && y[1993].lifeExpectancy < 52 && y[1991].lifeExpectancy > 71 && y[1995].lifeExpectancy > 70, 'lifespan 1992–1993');
const fell = (a: number, b: number) => un.years.filter((r) => r.year >= a && r.year <= b).every((r) => r.population < y[r.year - 1].population);
const rose = (a: number, b: number) => un.years.filter((r) => r.year >= a && r.year <= b).every((r) => r.population > y[r.year - 1].population);
assertClaim(fell(1992, 1995) && rose(1996, 2002) && fell(2003, 2100), 'falls 1992–95, rises 1996–2002, falls 2003–2100');
assertClaim(un.years.filter((r) => r.year >= 1995 && r.year <= 2001).every((r) => r.netMigrants > 0) && y[1994].netMigrants < 0 && y[2002].netMigrants < 0, 'net arrivals 1995–2001');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1996, 'largest inflow 1996');
const b1 = wpp.filter((d: any) => at(d).population >= 1e6);
const fromTop = (d: any) => at(d).population / Math.max(...d.years.filter((r: any) => r.year <= CURRENT_YEAR).map((r: any) => r.population));
assertClaim([...b1].sort((a: any, b: any) => fromTop(a) - fromTop(b)).slice(0, 4).map((d: any) => d.iso3).join() === 'MDA,LVA,GEO,BIH' && c.population / peak.population < 0.7, 'fourth-largest drop, under 70%');
assertClaim([...b1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).findIndex((d: any) => d.iso3 === 'BIH') === 8, 'ninth-highest median age');
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(bLow.year === CURRENT_YEAR, 'fewest births now');
assertClaim(un.years.filter((r) => r.year >= 2010).every((r) => r.naturalChange < 0), 'deaths above births from 2010');
assertClaim(y[2100].population / c.population > 0.43 && y[2100].population / c.population < 0.45, '2100 about 44% of today');

const title = `Bosnia and Herzegovina Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Balkan Decline From the 1991 High, Renewed in 2003 | AtlasFigures`;
const description = `Bosnia and Herzegovina: UN estimates hold ${millions(c.population)} for ${CURRENT_YEAR}, versus ${millions(peak.population)} at the 1991 maximum. Net departures in 1992 equalled almost a tenth of the population; from 2003 to 2100 each annual total undercuts its predecessor.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: bih.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, bih.tableYears);

const faq = [
  { q: 'When did Bosnia and Herzegovina have its largest population?', a: `1991, at ${millions(peak.population)}; this year's estimate is ${millions(c.population)}.` },
  { q: 'What was the net outflow from Bosnia and Herzegovina in 1992?', a: `${int(-outTop.netMigrants)}, close to 10% of the 1991 total. The UN data hold counts only.` },
  { q: 'Did people return to Bosnia and Herzegovina after 1995?', a: `Net arrivals appear from 1995 to 2001, largest in 1996 at ${int(inTop.netMigrants)}; the total grew from 1996 to 2002.` },
  { q: 'Is Bosnia and Herzegovina still losing population?', a: `Yes; each yearly total from 2003 is smaller, and from 2010 deaths outrun births without a break.` },
  { q: 'Bosnia and Herzegovina by 2100: how many?', a: `${millions(y[2100].population)}; that is about 44% of the present number.` },
];

const schema = countrySchema({
  page: PAGE, slug: bih.slug, name: bih.name, wikipedia: bih.wikipedia,
  headline: `Bosnia and Herzegovina's ${millions(c.population)}: 1991 peak; a 1992 outflow near a tenth of the population; lower every year from 2003`,
  description,
  datasetName: 'Bosnia and Herzegovina population, net migration and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Bosnia and Herzegovina for selected years from 1950 to ${CURRENT_YEAR}, including each year 1990–1996 plus 2002–2003, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: bih.published, updated: bih.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Bosnia and Herzegovina"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Bosnia and Herzegovina", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Bosnia and Herzegovina: two declines since a 1991 high</h1>
        <LiveCounter
          label="Bosnia and Herzegovina: estimated population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Derived from UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), dropping by close to ${int(-c.change / 365)} every day`}
        />
        <p class="answer">
          For {CURRENT_YEAR}, UN estimates assign Bosnia and Herzegovina <strong>{millions(c.population)}</strong>, well short of the 1991 peak, <strong>{millions(peak.population)}</strong>. Since 2003, every yearly figure has come in lower.
        </p>
        <div class="dates"><span>Updated <time datetime={bih.updated}>{longDate(bih.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Bosnia and Herzegovina" code="ba" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>What do UN figures show for Bosnia and Herzegovina in 1992–1995?</h2>
          <p>A sharp break. Net departures reached {int(-outTop.netMigrants)} in 1992, close to 10% of the 1991 count, followed by {int(-y[1993].netMigrants)} in 1993. Lifespan estimates sink from {dec(y[1991].lifeExpectancy, 1)} (1991) to {dec(y[1992].lifeExpectancy, 1)} and then {dec(y[1993].lifeExpectancy, 1)}. By 1995 the total stood at {millions(y[1995].population)}. Causes are not part of the dataset.</p>
        </div>
        <div class="age-row" role="group" aria-label="Bosnia and Herzegovina life expectancy in 1991, 1992 and 1993 (UN)">
          <div><span class="y">1991</span><div class="v">{dec(y[1991].lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">1992</span><div class="v">{dec(y[1992].lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">1993</span><div class="v">{dec(y[1993].lifeExpectancy, 1)}</div><span class="d">Years</span></div>
        </div>

        <div class="story-block prose">
          <h2>Did the population recover after 1995?</h2>
          <p>Partly. Net arrivals ran from 1995 to 2001, peaking at {int(inTop.netMigrants)} in 1996, and the count rose each year from 1996 to 2002, reaching {millions(y[2002].population)}. From 2003 it slipped again and has not risen since.</p>
        </div>
        <LineChart
          title="Bosnia and Herzegovina, 1950–2100: the 1991 top and two declines"
          subtitle="Mid-year population; dashes mark the UN projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How old and how small is Bosnia and Herzegovina becoming?</h2>
          <p>Half the residents are over {dec(c.medianAge, 1)}, the ninth-highest median among million-plus nations. The {int(c.births)} births expected in {CURRENT_YEAR} are the fewest of any year on file, against {int(c.deaths)} deaths; natural decrease has persisted since 2010. Today's count is under 70% of the 1991 peak, a gap exceeded only by Moldova, Latvia and Georgia. The UN line passes {millions(y[2050].population)} in 2050 and lands at {millions(y[2100].population)} in 2100.</p>
        </div>
        <RelatedPages iso3={bih.iso3} name={bih.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Bosnia and Herzegovina: 1990–1996, 2002–2003 and every decade"
          subtitle="Totals fall from 1992 to 1995, rise to 2002, then shrink every year."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${bih.slug}-population.csv`)}
          csvName={`${bih.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Bosnia and Herzegovina: what the figures say</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{bih.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={bih.published}>{longDate(bih.published)}</time> · Updated <time datetime={bih.updated}>{longDate(bih.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Bosnia and Herzegovina population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Bosnia and Herzegovina" code="ba" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
