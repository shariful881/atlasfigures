---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import se from '../../data/countries/sweden.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: growth kept going by migration, births slipping below deaths in 2026, a late peak in 2079.
const PAGE = '/population/sweden/';
const un = countryData(se.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (se.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const natNeg = un.years.filter((r) => r.naturalChange < 0).map((r) => r.year);
assertClaim(c.naturalChange < 0 && natNeg.filter((yr) => yr < CURRENT_YEAR).join(',') === '1997,1998,1999,2000,2001' && un.years.filter((r) => r.year >= CURRENT_YEAR).every((r) => r.naturalChange < 0), 'deaths above births in 2026 for the first time since 2001, and every year after');
assertClaim(c.netMigrants > Math.abs(c.naturalChange) * 10, 'net migration far larger than the natural loss');
const est = un.years.filter((r) => !r.projection);
const migTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(migTop.year === 2016 && migTop.netMigrants > 110e3, 'record net migration in 2016');
assertClaim(un.years.filter((r) => r.netMigrants <= 0).map((r) => r.year).join(',') === '1972,1973', 'net migration positive every year except 1972 and 1973');
const pass10 = un.years.find((r) => r.population >= 10e6)!.year;
assertClaim(pass10 === 2017, 'passed 10 million in 2017');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2079 && y[2100].population > c.population, 'peak 2079; 2100 still above today');
const growers = wpp.filter((d: any) => d.region === 'Europe' && at(d).population > 5e6).sort((a: any, b: any) => at(b, 2100).population / at(b).population - at(a, 2100).population / at(a).population).map((d: any) => d.iso3);
assertClaim(growers.indexOf('SWE') === 1, 'second-largest projected rise to 2100 among European countries over 5 million');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
const birthLow = est.filter((r) => r.year > 1991 && r.year < 2005).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(birthTop.year === 1991 && birthLow.year === 1999, 'births highest in 1991, lowest of the 1990s dip in 1999');
assertClaim(y[2010].births > birthLow.births && y[2010].fertility > 1.95 && Math.abs(c.fertility - 1.44) < 0.005, 'fertility near 2 in 2010, 1.44 now');
const sparse = wpp.filter((d: any) => d.region === 'Europe' && at(d).population > 10e6).sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).map((d: any) => d.iso3);
assertClaim(sparse[0] === 'RUS' && sparse[1] === 'SWE', 'least crowded European country over 10 million after Russia');
const north = wpp.filter((d: any) => d.subregion === 'Northern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(north[0] === 'GBR' && north[1] === 'SWE', 'second in Northern Europe after the UK');
const le50 = wpp.filter((d: any) => at(d, 1950).population > 5e6).sort((a: any, b: any) => at(b, 1950).lifeExpectancy - at(a, 1950).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(le50.indexOf('SWE') === 1 && le50[0] === 'NLD', 'second-highest life expectancy in 1950 among countries over 5 million');

const title = `Sweden Population: ${(c.population / 1e6).toFixed(1)} Million (${CURRENT_YEAR}), Still Rising Toward ${peak.year} | AtlasFigures`;
const description = `Sweden's mid-${CURRENT_YEAR} population stands near ${millions(c.population)}. From this year deaths slightly exceed births, yet migration keeps it growing toward a UN-projected high in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: se.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
];

const rows = displayRows(un.years, se.tableYears);

const faq = [
  { q: 'What is the number of people living in Sweden?', a: `Roughly ${millions(c.population)}, going by the UN's mid-year estimate, which puts Sweden ${ord(c.worldRank!)} on the global list and second in Northern Europe, behind the United Kingdom.` },
  { q: 'When did Sweden reach 10 million people?', a: `In ${pass10}, according to UN mid-year figures, one year after the largest net inflow on record, some ${int(Math.round(migTop.netMigrants / 1000))} thousand people, in ${migTop.year}.` },
  { q: 'Do more Swedes die than are born?', a: `From ${CURRENT_YEAR}, slightly: about ${int(c.deaths)} deaths against ${int(c.births)} births. It last happened from 1997 to 2001. The UN expects a small natural loss every year from now on.` },
  { q: 'Will Sweden keep growing?', a: `For decades yet: the medium projection only crests in ${peak.year}. At ${millions(y[2100].population)}, the 2100 total remains above today's level.` },
  { q: 'Why did Swedish births drop in the 1990s?', a: `The UN data record the size of the swing, not its causes: births peaked at ${int(birthTop.births)} in ${birthTop.year} and fell to ${int(birthLow.births)} by ${birthLow.year}.` },
];

const schema = countrySchema({
  page: PAGE, slug: se.slug, name: se.name, wikipedia: se.wikipedia,
  headline: `Sweden at ${millions(c.population)}: growing through migration toward a ${peak.year} high`,
  description,
  datasetName: 'Sweden population, births, deaths, migration and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Sweden for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: se.published, updated: se.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Sweden"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Sweden', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Sweden's population keeps growing, slowly</h1>
        <LiveCounter
          label="Sweden: population estimate, live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} starting point, adding about ${int(c.change / 365)} people per day`}
        />
        <p class="answer">
          Sweden's population sits around <strong>{millions(c.population)}</strong> as of mid-{CURRENT_YEAR}, ranking it {ord(c.worldRank!)} globally, and it still grows by {pct(c.growthRatePct)} a year. In {CURRENT_YEAR} <strong>deaths edge past births</strong>, so the added people now come from migration.
        </p>
        <div class="dates"><span>Updated <time datetime={se.updated}>{longDate(se.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Sweden" code="se" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has Sweden started recording more deaths than births?</h2>
          <p>Just barely, starting this year. The UN estimates {int(c.deaths)} deaths and {int(c.births)} births in {CURRENT_YEAR}, a gap of {int(Math.abs(c.naturalChange))}; the last time deaths were ahead was 1997 to 2001. A migration surplus in the region of {int(Math.round(c.netMigrants / 1000))} thousand easily covers it, so the population still rises by {int(Math.round(c.change / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Sweden's population, 1950–2100: a gentle climb with a late peak"
          subtitle="Swedish head count by mid-year; the dashed projection crests near 11.4 million in 2079."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How has migration shaped Sweden's population?</h2>
          <p>Net migration has been positive in all but two years since 1950, 1972 and 1973. The largest net inflow was in {migTop.year}, about {int(Math.round(migTop.netMigrants / 1000))} thousand, and Sweden crossed 10 million the next year. With births now below deaths, migration is the only source of growth in the projection.</p>
        </div>

        <div class="story-block prose">
          <h2>Why did Sweden's birth numbers rise and fall so sharply?</h2>
          <p>The UN series shows the swings without explaining them. Births peaked at {int(birthTop.births)} in {birthTop.year}, sank to {int(birthLow.births)} in {birthLow.year}, and recovered to {int(y[2010].births)} in 2010, when fertility was close to two children per woman ({dec(y[2010].fertility, 2)}). Since then the rate has slid to {dec(c.fertility, 2)}.</p>
        </div>
        <LineChart
          title="Swedish fertility, 1950 to 2050: ups and downs"
          subtitle="Average children per woman, UN series; dashed where projected. Line at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 per woman' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Sweden be bigger in 2100 than today?</h2>
          <p>Yes. The medium-variant path crests around {peak.year}, and Sweden still counts {millions(y[2100].population)} by 2100, compared with {millions(c.population)} today. Of Europe's nations larger than 5 million, only one is set to grow more in relative terms by 2100. Sweden would still be thinly settled, with {int(y[2100].densityPerKm2)} people per km².</p>
        </div>

        <div class="story-block prose">
          <h2>How long have Swedes been living long lives?</h2>
          <p>For generations. A Swedish child born in 1950 could already expect {dec(y[1950].lifeExpectancy, 1)} years, a level beaten only by the Netherlands in the group of nations over 5 million; today's figure is {dec(c.lifeExpectancy, 1)}. Half of Swedes are older than {dec(c.medianAge, 1)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy in Sweden">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].lifeExpectancy, 1)}</div><span class="d">Years at birth</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Life expectancy</span></div>
          <div><span class="y">2100, UN projection</span><div class="v">{dec(y[2100].lifeExpectancy, 1)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is Sweden one of Europe's emptiest countries?</h2>
          <p>Very: on average just {int(c.densityPerKm2)} people share each km², and among European countries above 10 million inhabitants only Russia is emptier. The population is concentrated in towns, though: {pct(c.urbanPct!)} live in areas Sweden defines as urban.</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Swedish population and vital rates, 1950–2100"
          subtitle="From 1950 to the 2100 projection, with the current year highlighted."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${se.slug}-population.csv`)}
          csvName={`${se.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions about Sweden's population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{se.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={se.published}>{longDate(se.published)}</time> · Updated <time datetime={se.updated}>{longDate(se.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Sweden population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Sweden" code="se" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
