---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import fr from '../../data/countries/france.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: Europe's highest fertility, now fading; a flat century ahead.
const PAGE = '/population/france/';
const un = countryData(fr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (fr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any) => d.years.find((r: any) => r.year === CURRENT_YEAR);
const bigEurope = wpp.filter((d: any) => d.region === 'Europe' && at(d).population > 30e6).sort((a: any, b: any) => at(b).fertility - at(a).fertility);
assertClaim(bigEurope[0].iso3 === 'FRA', 'highest fertility among European countries of more than 30 million');
const europeRank = wpp.filter((d: any) => d.region === 'Europe').sort((a: any, b: any) => at(b).population - at(a).population).findIndex((d: any) => d.iso3 === 'FRA') + 1;
assertClaim(europeRank === 4, 'fourth-largest population in Europe');
const birthDrop = (1 - c.births / y[2010].births) * 100;
assertClaim(birthDrop > 20 && birthDrop < 22, 'births about a fifth lower than in 2010');
assertClaim(y[2010].fertility > 2 && y[2010].fertility < 2.1, 'close to 2.1 in 2010');
const moreDeaths = un.years.find((r) => r.year > CURRENT_YEAR && r.naturalChange < 0)!.year;
assertClaim(moreDeaths === CURRENT_YEAR + 1 && un.years.filter((r) => r.year >= moreDeaths).every((r) => r.naturalChange < 0), 'deaths above births every year from next year');
assertClaim(c.naturalChange > 0 && c.naturalChange < 5000, 'births only just ahead of deaths this year');
const later = un.years.filter((r) => r.year >= CURRENT_YEAR);
const lo = Math.min(...later.map((r) => r.population)), hi = Math.max(...later.map((r) => r.population));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(hi - lo < 2e6, 'population within a 2 million band for the rest of the century');
const migLater = un.years.filter((r) => r.year > CURRENT_YEAR).map((r) => r.netMigrants);
assertClaim(Math.min(...migLater) > 85e3 && Math.max(...migLater) < 115e3, 'projected net migration about 90-110 thousand a year');
const OVERSEAS = [['REU', 'Réunion'], ['GLP', 'Guadeloupe'], ['MTQ', 'Martinique'], ['GUF', 'French Guiana'], ['MYT', 'Mayotte']] as const;
const overseas = OVERSEAS.map(([iso, name]) => ({ name, pop: byYear(countryData(iso).years)[CURRENT_YEAR].population }));
const overseasSum = overseas.reduce((a, o) => a + o.pop, 0);
assertClaim(c.deaths > y[2010].deaths && y[2010].population > 1.4 * y[1950].population, 'deaths up since 2010; strong growth 1950-2010');

const title = `France's Population in ${CURRENT_YEAR} Is ${(c.population / 1e6).toFixed(1)} Million, With Europe's Highest Fertility (for Now) | AtlasFigures`;
const description = `France has ${millions(c.population)} people in ${CURRENT_YEAR} (UN figure, without the overseas departments). Its ${dec(c.fertility, 2)} children per woman lead Europe's big countries, but births are down ${pct(birthDrop)} since 2010.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: fr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, fr.tableYears);

const faq = [
  { q: "What is France's population now?", a: `${millions(c.population)} at mid-${CURRENT_YEAR}, in the UN's figures for France without its overseas departments. That ranks France ${ord(c.worldRank!)} in the world and ${ord(europeRank)} in Europe.` },
  { q: 'Does France have the highest fertility in Europe?', a: `Yes, among the continent's large countries (over 30 million people): a fertility rate of ${dec(c.fertility, 2)} in ${CURRENT_YEAR}. In 2010 the figure was ${dec(y[2010].fertility, 2)}.` },
  { q: 'How many babies are born in France each year?', a: `About ${int(Math.round(c.births / 1000))} thousand in ${CURRENT_YEAR}, against ${int(Math.round(y[2010].births / 1000))} thousand in 2010. The number of deaths, about ${int(Math.round(c.deaths / 1000))} thousand, is nearly the same.` },
  { q: "Is France's population growing?", a: `Barely: by ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, almost all of it from net migration. The UN projects a near-flat total for the rest of the century, ending at ${millions(y[2100].population)} in 2100.` },
  { q: 'Do these figures include Réunion, Guadeloupe and the other overseas departments?', a: `No. The UN lists Réunion, Guadeloupe, Martinique, French Guiana and Mayotte as separate areas, with about ${millions(overseasSum)} people between them in ${CURRENT_YEAR}.` },
];

const schema = countrySchema({
  page: PAGE, slug: fr.slug, name: fr.name, wikipedia: fr.wikipedia,
  headline: `France's population in ${CURRENT_YEAR}: ${millions(c.population)}, fading births and a flat century ahead`,
  description,
  datasetName: 'France population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of France (UN definition, without the overseas departments listed separately) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: fr.published, updated: fr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="France"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'France', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Population of France</h1>
        <LiveCounter
          label="France: estimated population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: figure for 1 July ${CURRENT_YEAR}, adding about ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          France is home to <strong>{millions(c.population)} people</strong> in {CURRENT_YEAR}, counting the UN's way, without the overseas departments. Its fertility of {dec(c.fertility, 2)} children per woman is the <strong>highest among Europe's big countries</strong>, yet births have dropped by {pct(birthDrop)} since 2010.
        </p>
        <div class="dates"><span>Updated <time datetime={fr.updated}>{longDate(fr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="France" code="fr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Does France still lead Europe in births per woman?</h2>
          <p>Of the European countries with populations over 30 million, France has the highest rate. The average French woman has {dec(c.fertility, 2)} children in {CURRENT_YEAR}, ahead of the United Kingdom, Germany, Italy and Spain. But the lead rests on a lower number than before: in 2010 the rate was {dec(y[2010].fertility, 2)}, almost the 2.1 at which a population sustains itself without migration.</p>
        </div>
        <LineChart
          title="France's fertility rate since 1950"
          subtitle="UN total fertility rate. Close to 2.1 around 2010, lower since; the dashed stretch is projected."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Self-sustaining level' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How much have births in France fallen since 2010?</h2>
          <p>By about a fifth. The UN counts {int(Math.round(c.births / 1000))} thousand births in {CURRENT_YEAR}, down from {int(Math.round(y[2010].births / 1000))} thousand in 2010, a fall of {pct(birthDrop)}. Over the same years the number of deaths has risen, to about {int(Math.round(c.deaths / 1000))} thousand.</p>
        </div>

        <div class="story-block prose">
          <h2>From what year will France record more deaths than births?</h2>
          <p>Starting in {moreDeaths} and continuing every year after that, according to the UN projection. In {CURRENT_YEAR} births are ahead by only about {int(Math.round(c.naturalChange / 100) * 100)}, so the country's growth of {pct(c.growthRatePct)} now comes almost entirely from net migration, around {int(Math.round(c.netMigrants / 1000))} thousand people.</p>
        </div>

        <div class="story-block prose">
          <h2>Will France's population grow or shrink by 2100?</h2>
          <p>Neither, by much. The UN's medium projection keeps France between {millions(lo)} and {millions(hi)} for the rest of the century, with a high point in {peak.year} and {millions(y[2100].population)} in 2100. That path assumes net migration of roughly 90 to 110 thousand a year, which balances the growing excess of deaths.</p>
        </div>
        <LineChart
          title="France's population, 1950 to 2100"
          subtitle="Mid-year totals without the overseas departments. Strong growth to about 2010, then an almost level line in the UN projection (dashed)."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Does the population of France include its overseas departments?</h2>
          <p>Not in the UN's figures used here. The UN treats the five overseas departments as separate areas: Réunion ({int(Math.round(overseas[0].pop / 1000))} thousand people in {CURRENT_YEAR}), Guadeloupe ({int(Math.round(overseas[1].pop / 1000))} thousand), Martinique ({int(Math.round(overseas[2].pop / 1000))} thousand), French Guiana ({int(Math.round(overseas[3].pop / 1000))} thousand) and Mayotte ({int(Math.round(overseas[4].pop / 1000))} thousand). Together they add about {millions(overseasSum)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="France with and without its overseas departments">
          <div><span class="y">France (UN)</span><div class="v">{millionsShort(c.population)}</div><span class="d">Without the overseas departments</span></div>
          <div><span class="y">Overseas departments</span><div class="v">{millionsShort(overseasSum)}</div><span class="d">Five areas, listed separately</span></div>
          <div><span class="y">Combined</span><div class="v">{millionsShort(c.population + overseasSum)}</div><span class="d">Sum of the UN figures</span></div>
        </div>

        <div class="story-block prose">
          <h2>How old is the French population?</h2>
          <p>Half of the French are older than {dec(c.medianAge, 1)} in {CURRENT_YEAR}, compared with a median of {dec(y[1950].medianAge, 1)} in 1950, and life expectancy at birth has reached {dec(c.lifeExpectancy, 1)} years. France counts {pct(c.urbanPct!)} of its residents as urban. By population, the country stood {ord(y[1950].worldRank!)} worldwide in 1950; it is {ord(c.worldRank!)} today.</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="France: population and related figures by year"
          subtitle="UN mid-year population (without overseas departments) for 1950–2100, plus density, fertility, median age, urban share under the French definition (to 2050) and world ranking. Rows after 2026 are projections."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${fr.slug}-population.csv`)}
          csvName={`${fr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">France's population: frequent questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, comparisons with other European countries, the five overseas departments (listed by the UN as separate areas) and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={fr.published}>{longDate(fr.published)}</time> · Updated <time datetime={fr.updated}>{longDate(fr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('France population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="France" code="fr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
