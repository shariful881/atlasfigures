---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import kr from '../../data/countries/south-korea.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the lowest fertility of any country.
const PAGE = '/population/south-korea/';
const un = countryData(kr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (kr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, yr: number) => d.years.find((r: any) => r.year === yr);
// Hong Kong and Macao are special administrative regions of China, listed by the UN as separate areas.
const lowestTfr = wpp.filter((d: any) => !['HKG', 'MAC'].includes(d.iso3) && at(d, CURRENT_YEAR).population > 1e6).sort((a: any, b: any) => at(a, CURRENT_YEAR).fertility - at(b, CURRENT_YEAR).fertility);
assertClaim(lowestTfr[0].iso3 === 'KOR', 'lowest fertility of any country (of over a million people, outside Hong Kong and Macao)');
const belowKor = wpp.filter((d: any) => at(d, CURRENT_YEAR).fertility < c.fertility).map((d: any) => d.iso3).sort();
assertClaim(JSON.stringify(belowKor) === '["HKG","MAC"]', 'only Hong Kong and Macao lower');
const low = un.years.filter((r) => !r.projection).reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(low.year === 2023, 'record low in 2023');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2020 && un.years.filter((r) => r.year > peak.year).every((r) => r.change < 0), 'peak 2020, falling every year after');
const sub = un.years.find((r) => r.year > 1960 && r.fertility < 2.1)!.year;
assertClaim(sub === 1984 && un.years.filter((r) => r.year >= sub).every((r) => r.fertility < 2.1), 'below 2.1 since 1984');
const birthShare = c.births / y[1960].births;
assertClaim(birthShare < 0.25, 'fewer than a quarter of the births of 1960');
const deathsPerBirth = c.deaths / c.births;
const natLoss = un.years.find((r) => r.year > 1960 && r.naturalChange < 0)!.year;
assertClaim(un.years.filter((r) => r.year >= natLoss).every((r) => r.naturalChange < 0), 'more deaths than births every year since');
const keep = y[2100].population / c.population;
assertClaim(keep < 0.45 && y[2100].population < y[1960].population, 'less than half of today by 2100, below the 1960 level');
const longer = wpp.filter((d: any) => at(d, CURRENT_YEAR).population > 10e6).sort((a: any, b: any) => at(b, CURRENT_YEAR).lifeExpectancy - at(a, CURRENT_YEAR).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(longer[0] === 'JPN' && longer[1] === 'KOR', 'second-longest life expectancy among countries over 10 million, after Japan');
assertClaim(Math.abs(y[2050].growthRatePct) > 1, 'falling by more than 1% a year by 2050');
assertClaim(y[1960].population < c.population / 1.5 && y[1970].medianAge < 20 && y[2050].medianAge > 55, 'fewer people in 1960; teen median in 1970; over 55 by 2050');

const title = `South Korea Has the World's Lowest Fertility: Population ${(c.population / 1e6).toFixed(1)} Million (${CURRENT_YEAR}) | AtlasFigures`;
const description = `South Korea's ${millions(c.population)} people (${CURRENT_YEAR}) have ${dec(c.fertility, 2)} children per woman, the lowest of any country. The population peaked in ${peak.year} and is projected to reach ${millions(y[2100].population)} in 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: kr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Births this year', value: int(c.births) },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, kr.tableYears);

const faq = [
  { q: 'How many children does a South Korean woman have?', a: `${dec(c.fertility, 2)} on average in ${CURRENT_YEAR}, the lowest of any country; only Hong Kong and Macao, which the UN lists separately from China, are lower. The record low was ${dec(low.fertility, 2)} in ${low.year}.` },
  { q: "Is South Korea's population shrinking?", a: `Yes, since ${peak.year}, when it stood at ${millions(peak.population)}. In ${CURRENT_YEAR} it falls by about ${int(Math.round(Math.abs(c.change) / 1000))} thousand people, and the UN projects the yearly fall to pass 1% by 2050.` },
  { q: 'How many deaths are there in South Korea each year?', a: `About ${int(Math.round(c.deaths / 1000))} thousand in ${CURRENT_YEAR}, or ${dec(deathsPerBirth, 1)} for every birth. Since ${natLoss} there have been more deaths than births in each year.` },
  { q: 'How many South Koreans will there be in 2050?', a: `About ${millions(y[2050].population)}, the UN projects, and half of them would be older than ${dec(y[2050].medianAge, 1)}. For 2100 the figure is ${millions(y[2100].population)}.` },
  { q: 'How long do South Koreans live?', a: `On average ${dec(c.lifeExpectancy, 1)} years from birth, as of ${CURRENT_YEAR}. Only Japan does better among nations with populations over 10 million.` },
];

const schema = countrySchema({
  page: PAGE, slug: kr.slug, name: kr.name, wikipedia: kr.wikipedia,
  headline: `South Korea's population in ${CURRENT_YEAR}: ${millions(c.population)} and ${dec(c.fertility, 2)} children per woman`,
  description,
  datasetName: 'South Korea population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of South Korea (Republic of Korea) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: kr.published, updated: kr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="South Korea"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'South Korea', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>South Korea's population and its record-low births</h1>
        <LiveCounter
          label="South Korea, estimated population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: 1 July ${CURRENT_YEAR} level, down roughly ${int(Math.abs(c.change) / 365)} people per day`}
        />
        <p class="answer">
          South Korea has a population of <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}. Each woman there has <strong>{dec(c.fertility, 2)} children on average</strong>, fewer than in any other country, and the population has been getting smaller since {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={kr.updated}>{longDate(kr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="South Korea" code="kr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Does South Korea have the world's lowest fertility rate?</h2>
          <p>Yes, among countries. At {dec(c.fertility, 2)} births per woman this year, it is below every other nation in the UN data; only Hong Kong and Macao, special administrative regions of China that the UN counts separately, are lower. The rate bottomed out at {dec(low.fertility, 2)} in {low.year}. In 1960 it was {dec(y[1960].fertility, 2)}, and it has been under the 2.1 needed to keep numbers steady since {sub}.</p>
        </div>
        <LineChart
          title="South Korea's fertility rate from nearly 6 to below 1"
          subtitle="Average children per woman, 1950–2050. Dashed values are UN projections; the line marks 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="children per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Level that keeps numbers steady' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How few babies are born in South Korea today?</h2>
          <p>About <span data-exact>{int(c.births)}</span> in {CURRENT_YEAR}, under a quarter of the {millions(y[1960].births)} born in 1960, when the country had far fewer people. Deaths, at about {int(Math.round(c.deaths / 1000))} thousand, now run at {dec(deathsPerBirth, 1)} for every birth. They have exceeded births each year since {natLoss}.</p>
        </div>

        <div class="story-block prose">
          <h2>How fast is South Korea's population falling?</h2>
          <p>Slowly for now, then quickly. The total peaked at {millions(peak.population)} in {peak.year} and is down {pct(Math.abs(c.growthRatePct))} this year. Under the UN's medium variant, the yearly loss passes 1% by 2050, when {millions(y[2050].population)} people would remain.</p>
        </div>
        <LineChart
          title="Population of South Korea, 1950–2100"
          subtitle="Mid-year count. The curve peaks in 2020; dashed figures are the UN projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How old will South Koreans be by 2050?</h2>
          <p>Very old by any past standard. The median age, {dec(c.medianAge, 1)} in {CURRENT_YEAR}, was just {dec(y[1970].medianAge, 1)} in 1970. By 2050 the projection is {dec(y[2050].medianAge, 1)}. People also live long: life expectancy at birth is {dec(c.lifeExpectancy, 1)} years, second only to Japan among big countries (over 10 million people).</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in South Korea">
          <div><span class="y">1970</span><div class="v">{dec(y[1970].medianAge, 1)}</div><span class="d">Half were teenagers or younger</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Middle-aged country</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Half over 55</span></div>
        </div>

        <div class="story-block prose">
          <h2>Could South Korea's population halve by 2100?</h2>
          <p>On current trends, more than halve. The UN's medium projection reaches {millions(y[2100].population)} in 2100, {pct(keep * 100)} of today's total and fewer people than lived there in 1960. The country would fall from {ord(c.worldRank!)} to {ord(y[2100].worldRank!)} in the world ranking. Even a recovery in births would take decades to show up, because the generation of future parents has already been born.</p>
        </div>
        <RelatedPages iso3={kr.iso3} name={kr.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="South Korea's population data, 1950–2100"
          subtitle="Mid-year population alongside people per km², births per woman, median age, share urban (national definition, through 2050) and place in the world. 2030 onwards follows the UN projection."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${kr.slug}-population.csv`)}
          csvName={`${kr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">South Korea's population: key questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{kr.unName}"): population, births, deaths, growth, density, fertility, median age, life expectancy, world rank, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and subtracts the UN's projected decline for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={kr.published}>{longDate(kr.published)}</time> · Updated <time datetime={kr.updated}>{longDate(kr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('South Korea population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="South Korea" code="kr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
