---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import pl from '../../data/countries/poland.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: an all-time high in 2023, a projected halving by
// 2100, a net-migration spike in 2022 and outflows after it, fertility under 2.1 since 1989, and a fast-rising median age.
const PAGE = '/population/poland/';
const un = countryData(pl.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (pl.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => !r.projection);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const half = y[2100].population / peak.population;
assertClaim(peak.year === 2023 && half > 0.48 && half < 0.52, 'peak 2023; about half that by 2100');
const lastGain = un.years.filter((r) => r.naturalChange >= 0).at(-1)!.year;
assertClaim(lastGain === 2017, 'more deaths than births every year since 2018');
const migTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const europe = wpp.filter((d: any) => d.region === 'Europe');
const in22 = europe.filter((d: any) => at(d, 2022)).sort((a: any, b: any) => at(b, 2022).netMigrants - at(a, 2022).netMigrants).map((d: any) => d.iso3);
assertClaim(migTop.year === 2022 && in22[0] === 'DEU' && in22[1] === 'POL', '2022 net inflow: Poland\'s largest, second in Europe after Germany');
assertClaim(un.years.filter((r) => r.year >= 2023 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0) && y[2024].netMigrants < -2e5 && y[2025].netMigrants < -3e5, 'net outflows every year 2023–now');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
const tfrLow = un.years.reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(below === 1989 && un.years.filter((r) => r.year >= below).every((r) => r.fertility < 2.1) && tfrLow.year === 2003, 'under 2.1 every year since 1989; low in 2003');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1957, 'births peaked in 1957');
const big = europe.filter((d: any) => at(d).population > 10e6).sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3);
assertClaim(big[0] === 'ROU' && big[1] === 'POL', 'second-lowest urban share among European countries above ten million');
const east = wpp.filter((d: any) => d.subregion === 'Eastern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(east[2] === 'POL', 'third in Eastern Europe');

const title = `Poland Population: ${(c.population / 1e6).toFixed(1)} Million in ${CURRENT_YEAR}, Below the ${peak.year} High | AtlasFigures`;
const description = `Poland's all-time high, ${millions(peak.population)}, came in ${peak.year}; by mid-${CURRENT_YEAR} the total was ${millions(c.population)}. The UN projects roughly half the peak by 2100; here are the births, migration and ageing behind it.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: pl.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, pl.tableYears);

const faq = [
  { q: 'What population does Poland have today?', a: `UN estimates for the middle of ${CURRENT_YEAR} put it near ${millions(c.population)}. Only Russia and Ukraine are larger in Eastern Europe; Poland's world rank is ${ord(c.worldRank!)}.` },
  { q: 'Is Poland losing population?', a: `Yes. Its UN high point came in ${peak.year} (${millions(peak.population)}); the total has been lower ever since, and deaths have exceeded births since ${lastGain + 1}.` },
  { q: 'Will Poland\'s population halve by 2100?', a: `Roughly: the medium variant gives ${millions(y[2100].population)}, about half the ${peak.year} peak, which would rank Poland ${ord(y[2100].worldRank!)}.` },
  { q: 'How low is the Polish fertility rate?', a: `${dec(c.fertility, 2)} children per woman. Since ${below} it has not reached 2.1, and it touched ${dec(tfrLow.fertility, 2)} in ${tfrLow.year}.` },
  { q: 'Did Poland gain population through migration in 2022?', a: `Yes, about ${int(Math.round(y[2022].netMigrants / 1000))} thousand net in the UN figures, more than in any other year for Poland. The UN then records net outflows from 2023 to ${CURRENT_YEAR}.` },
];

const schema = countrySchema({
  page: PAGE, slug: pl.slug, name: pl.name, wikipedia: pl.wikipedia,
  headline: `Poland's ${millions(c.population)}: a 2023 peak, a 2022 migration spike and a projected halving by 2100`,
  description,
  datasetName: 'Poland population, net migration, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Poland for selected years from 1950 to ${CURRENT_YEAR} (every year from 2022), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: pl.published, updated: pl.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Poland"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Poland', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Poland: past its peak, heading for half by 2100</h1>
        <LiveCounter
          label="Poland: population right now, estimated"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, down about ${int(Math.abs(c.change) / 365)} people per day`}
        />
        <p class="answer">
          Poland had around <strong>{millions(c.population)}</strong> inhabitants by mid-{CURRENT_YEAR} ({ord(c.worldRank!)} worldwide), a little below its <strong>{peak.year} high</strong> of {millions(peak.population)}. On the UN's central path it falls to about {millions(y[2100].population)} by 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={pl.updated}>{longDate(pl.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Poland" code="pl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is Poland's population going down?</h2>
          <p>Yes, since its {peak.year} maximum. Births have fallen short of deaths every year since {lastGain + 1}; in {CURRENT_YEAR} the shortfall is about {int(Math.round(-c.naturalChange / 1000))} thousand, with roughly {int(Math.round(c.births / 1000))} thousand births against {int(Math.round(c.deaths / 1000))} thousand deaths. The medium projection gives {millions(y[2050].population)} for 2050; by 2100 it is {millions(y[2100].population)}, roughly half the peak.</p>
        </div>
        <LineChart
          title="Poland since 1950 and to 2100: plateau, peak, decline"
          subtitle="UN estimates to 2023's high point, projections (dashed) after; the line roughly halves by 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What happened to migration in Poland after 2021?</h2>
          <p>The UN series shows a jump and then a reversal. Net migration was about {int(Math.round(y[2021].netMigrants / 1000))} thousand in 2021, then about {int(Math.round(y[2022].netMigrants / 1000))} thousand in 2022, Poland's highest on record and second in Europe that year after Germany. Net outflows followed: about {int(Math.round(-y[2024].netMigrants / 1000))} thousand in 2024 and {int(Math.round(-y[2025].netMigrants / 1000))} thousand in 2025. The UN data give totals, not the reasons people moved.</p>
        </div>
        <div class="age-row" role="group" aria-label="Net migration in Poland, UN estimates">
          <div><span class="y">2022</span><div class="v">+{int(Math.round(y[2022].netMigrants / 1000))}k</div><span class="d">Record net inflow</span></div>
          <div><span class="y">2024</span><div class="v">−{int(Math.round(-y[2024].netMigrants / 1000))}k</div><span class="d">Net outflow</span></div>
          <div><span class="y">2025</span><div class="v">−{int(Math.round(-y[2025].netMigrants / 1000))}k</div><span class="d">Net outflow</span></div>
        </div>

        <div class="story-block prose">
          <h2>How far has the Polish birth rate fallen?</h2>
          <p>Well below replacement for more than three decades. Fertility has not reached 2.1 since {below}; its lowest point, {dec(tfrLow.fertility, 2)}, came in {tfrLow.year}, and it stands at {dec(c.fertility, 2)} today. Births numbered about {int(Math.round(birthTop.births / 1000))} thousand in {birthTop.year}, the most in the UN series; this year's total is roughly {int(Math.round(c.births / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Fertility in Poland, 1950–2050"
          subtitle="Polish fertility rate per UN estimate, projected years dashed, compared with 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How old is Poland's population becoming?</h2>
          <p>Fast. The median age was {dec(y[2000].medianAge, 1)} in 2000, is {dec(c.medianAge, 1)} today and is projected at {dec(y[2050].medianAge, 1)} by 2050. Poland also stays less urban than most large European countries: {pct(c.urbanPct!)} by its national definition, the second-lowest share among European countries above ten million people after Romania. Its world rank slides to {ord(y[2050].worldRank!)} by 2050.</p>
        </div>
        <RelatedPages iso3={pl.iso3} name={pl.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Polish population figures, 1950–2100"
          subtitle={`The 2022 row holds the migration spike; ${peak.year} is the all-time high in the UN series.`}
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${pl.slug}-population.csv`)}
          csvName={`${pl.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Poland's population: frequently raised points</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{pl.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={pl.published}>{longDate(pl.published)}</time> · Updated <time datetime={pl.updated}>{longDate(pl.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Poland population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Poland" code="pl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
