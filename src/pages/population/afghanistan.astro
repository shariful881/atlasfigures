---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import af from '../../data/countries/afghanistan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the youngest population outside Africa, high fertility, sharp migration swings in past decades, a near-tripling by 2100. Neutral, data only.
const PAGE = '/population/afghanistan/';
const un = countryData(af.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (af.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const outsideAfrica = wpp.filter((d: any) => d.region !== 'Africa' && at(d).population > 1e6);
const young = outsideAfrica.slice().sort((a: any, b: any) => at(a).medianAge - at(b).medianAge).map((d: any) => d.iso3);
assertClaim(young[0] === 'AFG', 'lowest median age outside Africa (countries over 1 million)');
const fert = outsideAfrica.slice().sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3);
assertClaim(fert[0] === 'AFG', 'highest fertility outside Africa (countries over 1 million)');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrMax.year === 1995, 'fertility highest in 1995');
const est = un.years.filter((r) => !r.projection);
const falls = est.filter((r) => r.change < 0).map((r) => r.year);
assertClaim(falls.join(',') === '1979,1980,1981,1982,1986,1987,1990,2000' && falls.every((yr) => y[yr].netMigrants < 0), 'eight years of decline 1979–2000, each with net outflow');
const outTop = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 1981 && outTop.netMigrants < -1.9e6 && inTop.year === 1992 && inTop.netMigrants > 1.1e6, '1981 net outflow near 2 million; 1992 net inflow above 1.1 million');
assertClaim(y[1983].population < y[1979].population * 0.81, 'population about a fifth smaller in 1983 than 1979');
assertClaim(un.years.filter((r) => r.year >= 2021 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0) && y[2020].netMigrants > 0, 'net outflow in every year from 2021 to now');
const dbl = un.years.find((r) => r.population >= 2 * c.population)!.year;
assertClaim(dbl === 2060, 'double today by 2060');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100 && y[2100].population / c.population > 2.85 && y[2100].population / c.population < 2.95, 'still growing in 2100, nearly three times today');
const south = wpp.filter((d: any) => d.subregion === 'Southern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(south.indexOf('AFG') === 4, 'fifth in Southern Asia');
assertClaim(y[1950].lifeExpectancy < 30, 'life expectancy under 30 in 1950');

assertClaim(c.births / y[1950].births > 3.8 && c.births / y[1950].births < 4, 'births almost four times 1950');
const title = `Afghanistan Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Median Age ${dec(c.medianAge, 1)} | AtlasFigures`;
const description = `Afghanistan's population is ${millions(c.population)} (UN, mid-${CURRENT_YEAR}), and half its people are younger than ${dec(c.medianAge, 1)}, a lower median than anywhere outside Africa. UN projections show it doubling by ${dbl}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: af.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Growth per year', value: `+${pct(c.growthRatePct)}` },
];

const rows = displayRows(un.years, af.tableYears);

const faq = [
  { q: 'How many people are in Afghanistan today?', a: `The UN's mid-${CURRENT_YEAR} estimate comes to ${millions(c.population)}: ${ord(c.worldRank!)} globally, fifth in Southern Asia.` },
  { q: "Is Afghanistan's population unusually young?", a: `Half of Afghans are under ${dec(c.medianAge, 1)}. Outside Africa, no nation above the 1 million mark has a lower median age.` },
  { q: 'At what pace is Afghanistan\'s population increasing?', a: `By ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, roughly ${millions(c.change)} people. On the UN's medium path it doubles by ${dbl}.` },
  { q: 'Did Afghanistan\'s population ever decline?', a: `Yes. The UN estimates show it falling in eight years between 1979 and 2000, each time alongside net emigration; the net outflow reached about ${millions(-outTop.netMigrants)} in ${outTop.year}.` },
  { q: 'How large could Afghanistan become by 2100?', a: `${millions(y[2100].population)} in the UN medium variant, nearly three times today, which would rank it ${ord(y[2100].worldRank!)} in the world.` },
];

const schema = countrySchema({
  page: PAGE, slug: af.slug, name: af.name, wikipedia: af.wikipedia,
  headline: `Afghanistan's ${millions(c.population)}: median age ${dec(c.medianAge, 1)} in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Afghanistan population, age, fertility, migration and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Afghanistan for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: af.published, updated: af.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Afghanistan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Afghanistan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Afghanistan, the youngest population outside Africa</h1>
        <LiveCounter
          label="Afghanistan: running estimate of the population"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} start value, rising by some ${int(c.change / 365)} people daily`}
        />
        <p class="answer">
          Afghanistan's population, estimated at <strong>{millions(c.population)}</strong> in mid-{CURRENT_YEAR}, ranks {ord(c.worldRank!)} globally, and its median resident is <strong>just {dec(c.medianAge, 1)}</strong>. Annual growth runs at {pct(c.growthRatePct)}, and on the medium projection the total doubles by {dbl}.
        </p>
        <div class="dates"><span>Updated <time datetime={af.updated}>{longDate(af.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Afghanistan" code="af" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How young are Afghans?</h2>
          <p>Younger than any population of over 1 million outside Africa: its median age is just {dec(c.medianAge, 1)}. In 1950 it stood at {dec(y[1950].medianAge, 1)}; projections reach {dec(y[2050].medianAge, 1)} by mid-century and {dec(y[2100].medianAge, 1)} by 2100.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Afghanistan">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Youngest outside Africa</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Still young</span></div>
        </div>
        <LineChart
          title="Afghanistan's population, 1950–2100: a dip around 1980, then steep growth"
          subtitle="UN mid-year counts; the projected years, dashed, are still climbing past 130 million in 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Afghanistan's birth rate the highest outside Africa?</h2>
          <p>Yes: the {CURRENT_YEAR} rate of about {dec(c.fertility, 2)} is more than in any non-African country above 1 million people. It peaked at {dec(tfrMax.fertility, 2)} in {tfrMax.year}. Births this year come to roughly {millions(c.births)}, almost four times the {int(Math.round(y[1950].births / 1000))} thousand of 1950.</p>
        </div>
        <LineChart
          title="Births per Afghan woman across a century, 1950–2050"
          subtitle="Average children per woman (UN); dashed values projected. 2.1 shown below for comparison."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 comparison' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why did Afghanistan's population fall around 1980?</h2>
          <p>In the UN's estimates the declines coincide with very large net outflows of people. The total dropped from {millions(y[1979].population)} (1979) to {millions(y[1983].population)} (1983), and the net outflow in {outTop.year} alone was about {millions(-outTop.netMigrants)}. Flows later swung the other way: {inTop.year} shows a net inflow of about {millions(inTop.netMigrants)}. Net migration has been negative again in every year since 2021.</p>
        </div>

        <div class="story-block prose">
          <h2>Will Afghanistan's population triple by 2100?</h2>
          <p>Nearly. The UN medium variant takes it to {millions(y[2050].population)} by 2050, {ord(y[2050].worldRank!)} in the world, and {millions(y[2100].population)} by 2100, {ord(y[2100].worldRank!)}, still growing at the end of the century. Life expectancy at birth, {dec(y[1950].lifeExpectancy, 1)} years in 1950, is {dec(c.lifeExpectancy, 1)} today. The national definition classes {pct(c.urbanPct!)} of Afghans as urban.</p>
        </div>
        <RelatedPages iso3={af.iso3} name={af.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Afghan population statistics across 150 years"
          subtitle="Rows from 2030 on are UN projections, ending near three times today's total."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${af.slug}-population.csv`)}
          csvName={`${af.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions about Afghanistan's population, answered with UN data</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{af.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={af.published}>{longDate(af.published)}</time> · Updated <time datetime={af.updated}>{longDate(af.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Afghanistan population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Afghanistan" code="af" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
