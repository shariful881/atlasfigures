---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import nam from '../../data/countries/namibia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the third-lowest density of any 1M+ country
// (after Mongolia and Australia); an urban majority only from 2024; net departures every year 1950–1984, arrivals
// 1985–2001 with the 1989 peak, departures again 2002–2011; life expectancy falling from 61.4 (1990) to a 2003 low,
// a one-year dip in 2021 (falls every year 1991–2001); growth to 2100, fertility above 2.1 until 2074.
const PAGE = '/population/namibia/';
const un = countryData(nam.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (nam.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const n1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...n1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).slice(0, 3).map((d: any) => d.iso3).join() === 'MNG,AUS,NAM', 'third-lowest density');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2024, 'urban majority from 2024');
const nm = (a: number, b: number) => un.years.filter((r) => r.year >= a && r.year <= b);
assertClaim(nm(1950, 1984).every((r) => r.netMigrants < 0) && nm(1985, 2001).every((r) => r.netMigrants > 0) && nm(2002, 2011).every((r) => r.netMigrants < 0) && y[2012].netMigrants > 0, 'migration phases');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(inTop.year === 1989 && outTop.year === 1978, 'inflow peak 1989, outflow peak 1978');
const leLow = un.years.filter((r) => r.year >= 1970 && r.year <= CURRENT_YEAR).reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 2003 && un.years.filter((r) => r.year > 1990 && r.year <= 2001).every((r) => r.lifeExpectancy < y[r.year - 1].lifeExpectancy), 'lifespan falls every year 1991–2001, low 2003');
assertClaim(y[2021].lifeExpectancy < y[2020].lifeExpectancy - 3 && y[2022].lifeExpectancy > y[2020].lifeExpectancy, '2021 one-year dip');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(peak.year === 2100 && repl === 2074, 'growing to 2100; under 2.1 in 2074');
const since = c.population / y[1950].population;
assertClaim(since > 6 && since < 6.3, 'about six times 1950');

const title = `Namibia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Sparse Land, Towns Now Hold the Majority | AtlasFigures`;
const description = `Namibia holds ${millions(c.population)} in ${CURRENT_YEAR} (UN estimate) at ${int(c.densityPerKm2)} per km²; only Mongolia and Australia are sparser among million-plus nations. Since 2024 urban residents form the larger part, and lifespans dipped from 1991 to 2003.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: nam.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, nam.tableYears);

const faq = [
  { q: 'Does Namibia have a lot of empty land per person?', a: `Yes: ${int(c.densityPerKm2)} per km², and Mongolia and Australia are the only million-plus nations with fewer.` },
  { q: 'In what year did urban Namibians outnumber rural ones?', a: `2024 is the first such year; the urban share is ${pct(c.urbanPct!)} now, up from ${pct(y[1950].urbanPct!)} in 1950.` },
  { q: 'Did Namibian life expectancy fall?', a: `Yes, overall from 1991 to 2003, from ${dec(y[1990].lifeExpectancy, 1)} to ${dec(leLow.lifeExpectancy, 1)} years; ${dec(c.lifeExpectancy, 1)} now. The source does not attribute causes.` },
  { q: 'What was the peak year of arrivals in Namibia?', a: `1989, with ${int(inTop.netMigrants)} net arrivals, in a run of inflows lasting from 1985 to 2001.` },
  { q: 'Namibia in 2100: how many residents?', a: `${millions(y[2100].population)}, with ${millions(y[2050].population)} along the way around 2050.` },
];

const schema = countrySchema({
  page: PAGE, slug: nam.slug, name: nam.name, wikipedia: nam.wikipedia,
  headline: `Namibia's ${millions(c.population)}: third-emptiest of the 1M+ nations; urban majority from 2024; a 1991–2003 lifespan decline`,
  description,
  datasetName: 'Namibia population, urban share and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Namibia for selected years from 1950 to ${CURRENT_YEAR}, including 1978, 1984–1985, 1989, 2003, 2011–2012, 2021 and 2024, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: nam.published, updated: nam.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Namibia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Namibia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Namibia: wide open land, towns only now in the lead</h1>
        <LiveCounter
          label="Namibia: population estimate ticking"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Anchored to UN World Population Prospects 2024 for mid-${CURRENT_YEAR}; climbing by roughly ${int(c.change / 365)} daily`}
        />
        <p class="answer">
          The UN reckons Namibia at <strong>{millions(c.population)}</strong> for {CURRENT_YEAR}, thinly spread at <strong>{int(c.densityPerKm2)}</strong> per km². Only since 2024 have town dwellers formed the majority.
        </p>
        <div class="dates"><span>Updated <time datetime={nam.updated}>{longDate(nam.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Namibia" code="na" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is Namibia among the least crowded places on Earth?</h2>
          <p>Third from the bottom among the million-plus group: only Mongolia and Australia have fewer residents per km² than Namibia's {int(c.densityPerKm2)}. Today's count is about six times the {int(y[1950].population)} of 1950.</p>
        </div>

        <div class="story-block prose">
          <h2>Since when have most Namibians lived in towns?</h2>
          <p>Since 2024, when the urban share first passed one half. It stood at {pct(y[1950].urbanPct!)} in 1950, reads {pct(c.urbanPct!)} today, and the 2050 projection gives {pct(y[2050].urbanPct!)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Over which years did Namibian lifespans shorten?</h2>
          <p>Across 1991–2003. Starting from {dec(y[1990].lifeExpectancy, 1)} in 1990, each year up to 2001 shaved something off, and the low point, {dec(leLow.lifeExpectancy, 1)}, arrived in 2003 before recovery; 2021 brought a one-year drop to {dec(y[2021].lifeExpectancy, 1)}. Today: {dec(c.lifeExpectancy, 1)}. These swings appear in the UN estimates without stated causes.</p>
        </div>
        <LineChart
          title="Namibian lifespans, 1950–2050"
          subtitle="Years of life expectancy at birth; projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has migration added to or taken from Namibia?</h2>
          <p>Both, in three phases. Outflows prevailed through 1950–1984, heaviest in 1978 ({int(-outTop.netMigrants)}); inflows held over 1985–2001, topped by 1989 with {int(inTop.netMigrants)}; 2002–2011 tipped back to small outflows. The {CURRENT_YEAR} balance sits near nil.</p>
        </div>

        <div class="story-block prose">
          <h2>Does Namibia's growth continue?</h2>
          <p>Upward right to 2100 in the UN projection, ending at {millions(y[2100].population)}. Women average {dec(c.fertility, 2)} children, with 2074 the first projected year under 2.1; the median resident is {dec(c.medianAge, 1)}.</p>
        </div>
        <RelatedPages iso3={nam.iso3} name={nam.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Namibia: 1978, 1984–1989, 2003, 2011–2012, 2021 and decades"
          subtitle="Life expectancy bottoms out in the 2003 row; 2024 is the first urban-majority year."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${nam.slug}-population.csv`)}
          csvName={`${nam.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Namibia: short questions, UN answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{nam.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={nam.published}>{longDate(nam.published)}</time> · Updated <time datetime={nam.updated}>{longDate(nam.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Namibia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Namibia" code="na" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
