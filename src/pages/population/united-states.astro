---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import us from '../../data/countries/united-states.json';
import { countryData, countryIndex, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: growth that now rests on migration.
const PAGE = '/population/united-states/';
const un = countryData(us.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const perDay = c.change / 365;
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (us.verification as any).checkedOn as string | undefined;

const top = [...countryIndex.countries].sort((a, b) => b.population - a.population);
assertClaim(top[0].iso3 === 'IND' && top[1].iso3 === 'CHN' && c.worldRank === 3, 'third largest, after India and China');
const migShare = (c.netMigrants / c.change) * 100;
assertClaim(migShare > 60 && migShare < 75, 'about two thirds of growth from net migration');
const firstMoreDeaths = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(un.years.filter((r) => r.year >= firstMoreDeaths).every((r) => r.naturalChange < 0), 'deaths outnumber births in every year from then on');
assertClaim(un.years.every((r, i, a) => i === 0 || r.population > a[i - 1].population), 'population never stops growing in the UN projection to 2100');
const boomPeak = un.years.filter((r) => r.year >= 1946 && r.year <= 1964).reduce((a, b) => (b.fertility > a.fertility ? b : a));
const below = un.years.find((r) => r.year > 1964 && r.fertility < 2.1)!.year;
assertClaim(un.years.filter((r) => r.year >= below).every((r) => r.fertility < 2.1), 'below 2.1 in every year since');
const leDrop = y[2019].lifeExpectancy - y[2021].lifeExpectancy;
assertClaim(y[2021].lifeExpectancy < y[2020].lifeExpectancy && y[2020].lifeExpectancy < y[2019].lifeExpectancy && y[2023].lifeExpectancy > y[2019].lifeExpectancy, 'life expectancy fell two years running, then passed its 2019 level by 2023');
const slips = un.years.filter((r, i, a) => i > 0 && r.worldRank !== a[i - 1].worldRank).map((r) => ({ year: r.year, rank: r.worldRank! }));
assertClaim(slips.length === 3 && slips[0].rank === 4 && slips[2].rank === 6, 'falls to 4th, then 5th, then 6th');
const ahead2100 = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>)
  .map((m) => m.default ?? m)
  .filter((d: any) => d.years.find((r: any) => r.year === 2100).population > y[2100].population)
  .map((d: any) => d.iso3)
  .sort();
assertClaim(JSON.stringify(ahead2100) === JSON.stringify(['CHN', 'COD', 'IND', 'NGA', 'PAK']), 'in 2100 only India, China, Pakistan, Nigeria and DR Congo are larger');

for (const iso of ['PAK', 'NGA', 'COD']) {
  const o = byYear(countryData(iso).years)[CURRENT_YEAR];
  assertClaim(o.medianAge < 30 && o.fertility > c.fertility, `${iso} younger and with higher fertility than the US`);
}
const title = `How Many People Live in the United States? ${(c.population / 1e6).toFixed(1)} Million in ${CURRENT_YEAR} | AtlasFigures`;
const description = `About ${millions(c.population)} people live in the United States in ${CURRENT_YEAR}. See why migration now drives most US growth, when deaths will outnumber births, and why the UN still sees ${millions(y[2100].population)} Americans by 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: us.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Net migrants', value: `+${millionsShort(c.netMigrants)}` },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, us.tableYears);

const faq = [
  { q: 'How many people live in the US right now?', a: `The UN puts the mid-${CURRENT_YEAR} figure at ${millions(c.population)}, which is ${pct(c.worldSharePct)} of humanity and the third-largest national total after India and China. The counter on this page adds the expected yearly gain of about ${millions(c.change)} evenly through the year.` },
  { q: 'How much of US population growth comes from immigration?', a: `About ${pct(migShare)} in ${CURRENT_YEAR}. Net migration adds roughly ${millions(c.netMigrants)} people, while births exceed deaths by only about ${int(c.naturalChange / 1000)} thousand.` },
  { q: 'What is the fertility rate in the United States?', a: `${dec(c.fertility, 2)} children per woman in ${CURRENT_YEAR}. It has not reached 2.1 in any year since ${below}, and the UN expects it to hover near ${dec(y[2050].fertility, 2)} through 2050.` },
  { q: 'How old is the typical American?', a: `${dec(c.medianAge, 1)} years in ${CURRENT_YEAR}, compared with ${dec(y[1970].medianAge, 1)} in 1970, when the baby boomers were still young. It is projected to rise to ${dec(y[2050].medianAge, 1)} in 2050.` },
  { q: 'How many people will live in the United States in 2100?', a: `About ${millions(y[2100].population)}, on the UN's medium projection, up from ${millions(y[2050].population)} in 2050. Even so, the country would fall to ${ord(y[2100].worldRank!)} among all nations.` },
];

const schema = countrySchema({
  page: PAGE, slug: us.slug, name: us.name, wikipedia: us.wikipedia,
  headline: `United States population in ${CURRENT_YEAR}: ${millions(c.population)}, migration and the road to 2100`,
  description,
  datasetName: 'United States population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of the United States for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: us.published, updated: us.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Baby boomers', url: 'https://www.britannica.com/topic/baby-boomers', publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="United States"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'United States', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Population of the United States</h1>
        <LiveCounter
          label="Estimated US population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} figure plus about ${int(perDay)} people a day`}
        />
        <p class="answer">
          About <strong>{millions(c.population)} people</strong> live in the United States in {CURRENT_YEAR}, the third-largest population on Earth after India and China. The country still gains roughly {millions(c.change)} people a year, but <strong>{pct(migShare)} of that gain</strong> now comes from net migration rather than from births.
        </p>
        <div class="dates"><span>Updated <time datetime={us.updated}>{longDate(us.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="United States" code="us" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is the US population still growing?</h2>
          <p>Mostly because people keep arriving. In {CURRENT_YEAR} the UN estimates {millions(c.births)} births and {millions(c.deaths)} deaths, a natural gain of only about {int(c.naturalChange / 1000)} thousand. Net migration adds another {millions(c.netMigrants)}, so newcomers account for {pct(migShare)} of the year's growth of {pct(c.growthRatePct)}.</p>
          <p>That balance has shifted within a lifetime. In 1960, births outnumbered deaths by {millions(y[1960].naturalChange)} and net migration added just {int(y[1960].netMigrants / 1000)} thousand.</p>
        </div>

        <div class="story-block prose">
          <h2>When will deaths outnumber births in America?</h2>
          <p>From {firstMoreDeaths}, in the UN's medium projection, and in every year after that. By then the baby-boom generation will be between its late seventies and mid-nineties, while the number of births stays roughly flat. Yet the total keeps rising: migration is projected to more than cover the gap, taking the country to {millions(y[2050].population)} in 2050 and {millions(y[2100].population)} by 2100, with no peak before the century ends.</p>
        </div>
        <LineChart
          title="How the US population has grown since 1950, and the UN outlook to 2100"
          subtitle="People living in the United States at mid-year. The dashed stretch is the UN projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How big was the American baby boom?</h2>
          <p>Big enough to define a generation. The Census Bureau dates the boom from 1946 to 1964, and the UN series shows fertility at its height in {boomPeak.year}, at {dec(boomPeak.fertility, 2)} children per woman. Annual births topped {millions(y[1961].births)} in 1961. The rate then fell fast, to {dec(y[1980].fertility, 2)} by 1980, and has stayed short of 2.1, the rate at which a generation replaces itself, in each year from {below} on. Today it is {dec(c.fertility, 2)}.</p>
        </div>
        <LineChart
          title="Children per woman in the United States, 1950–2050"
          subtitle="Total fertility rate; the peak falls inside the 1946–1964 baby boom. Dashed values are projected by the UN."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="children per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Replacement, 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What happened to US life expectancy during the pandemic?</h2>
          <p>It fell two years in a row, from {dec(y[2019].lifeExpectancy, 1)} years in 2019 to {dec(y[2020].lifeExpectancy, 1)} in 2020 and {dec(y[2021].lifeExpectancy, 1)} in 2021, a loss of {dec(leDrop, 1)} years in the UN estimates. The recovery was quicker than the fall: by 2023 it had reached {dec(y[2023].lifeExpectancy, 1)}, above the pre-pandemic level, and in {CURRENT_YEAR} it stands at {dec(c.lifeExpectancy, 1)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="US life expectancy at birth">
          <div><span class="y">2019</span><div class="v">{dec(y[2019].lifeExpectancy, 1)}</div><span class="d">Years at birth before COVID-19</span></div>
          <div><span class="y">2021</span><div class="v">{dec(y[2021].lifeExpectancy, 1)}</div><span class="d">The low point</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Back above 2019</span></div>
        </div>

        <div class="story-block prose">
          <h2>Will the United States stay the third most populous country?</h2>
          <p>Not for the whole century. The UN projects Pakistan to pass it in {slips[0].year}, Nigeria in {slips[1].year} and the Democratic Republic of the Congo in {slips[2].year}, leaving the United States {ord(y[2100].worldRank!)} in 2100 even though it keeps growing. All three are much younger, with median ages under 30 against {dec(c.medianAge, 1)} here, and families are larger, so their populations rise faster.</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="US population, 1950 to 2100"
          subtitle="Each row: people at mid-year, how many per km², children per woman, the median age, the share living in urban areas (to 2050) and the country's world rank. Projected from 2030."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${us.slug}-population.csv`)}
          csvName={`${us.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">US population: common questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{us.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href="https://www.britannica.com/topic/baby-boomers">Encyclopaedia Britannica, "Baby boomers"</a>: the US Census Bureau's dating of the baby boom, mid-1946 to mid-1964.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={us.published}>{longDate(us.published)}</time> · Updated <time datetime={us.updated}>{longDate(us.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('United States population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="United States" code="us" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
