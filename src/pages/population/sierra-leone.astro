---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import sle from '../../data/countries/sierra-leone.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: the world's highest infant
// mortality today; net departures every year 1991–1999 (largest 1991) and net arrivals 2000–2003 (largest 2001), with the
// total falling in 1992–1993; life expectancy near 42–45 through the 1990s and 62 now; growth until a 2092 peak.
const PAGE = '/population/sierra-leone/';
const un = countryData(sle.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (sle.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim([...wpp].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000)[0].iso3 === 'SLE', 'highest infant mortality in the world');
const run = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
assertClaim(run(1991, 1999).every((n) => y[n].netMigrants < 0) && run(2000, 2003).every((n) => y[n].netMigrants > 0), 'departures 1991–1999, arrivals 2000–2003');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 1991 && inTop.year === 2001, 'largest outflow 1991, inflow 2001');
const outSum = -run(1991, 1999).reduce((s, n) => s + y[n].netMigrants, 0);
assertClaim(outSum > 9e5 && outSum < 1e6, 'about 0.9 million net departures 1991–1999');
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1992,1993', 'total fell only in 1992 and 1993');
assertClaim(run(1990, 1999).every((n) => y[n].lifeExpectancy < 45) && c.lifeExpectancy > 62, 'life expectancy under 45 in the 1990s, over 62 now');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1950, 'lowest life expectancy 1950');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2092, 'peak 2092');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1987 && repl === 2071, 'fertility high 1987, under 2.1 in 2071');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2032, 'urban majority 2032');
const times = c.population / y[1950].population;
assertClaim(times > 4.4 && times < 4.6, 'about 4.5 times 1950');
assertClaim(c.medianAge < 20, 'median under 20');

const title = `Sierra Leone Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Outflow in the 1990s, Highest Infant Mortality Today | AtlasFigures`;
const description = `UN figures put Sierra Leone at ${millions(c.population)} for ${CURRENT_YEAR}. Net departures ran every year from 1991 to 1999, then reversed in 2000–2003; today its infant mortality, ${dec(c.infantMortalityPer1000!, 1)}, is the highest anywhere.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: sle.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, sle.tableYears);

const faq = [
  { q: 'Which country has the highest infant mortality?', a: `In the UN's ${CURRENT_YEAR} estimates, Sierra Leone: ${dec(c.infantMortalityPer1000!, 1)} of every 1,000 babies die before their first birthday.` },
  { q: 'Did people leave Sierra Leone in the 1990s?', a: `On balance, yes: net departures every year from 1991 to 1999, close to ${int(Math.round(outSum / 1e4) * 10)} thousand overall, the largest in 1991 (${int(-outTop.netMigrants)}). Net arrivals followed from 2000 to 2003, peaking at ${int(inTop.netMigrants)} in 2001. The data give no reasons.` },
  { q: 'In which years did Sierra Leone shrink?', a: `Just two, 1992 and 1993, on the UN's estimates; every other year shows growth.` },
  { q: 'When does Sierra Leone stop growing in the UN projection?', a: `Around ${peak.year}, at ${millions(peak.population)}.` },
  { q: 'How young is Sierra Leone?', a: `Very young. Half the population is below ${dec(c.medianAge, 1)} years old, and fertility, ${dec(c.fertility, 2)}, is projected to stay above 2.1 until ${repl}.` },
];

const schema = countrySchema({
  page: PAGE, slug: sle.slug, name: sle.name, wikipedia: sle.wikipedia,
  headline: `Sierra Leone's ${millions(c.population)}: departures through the 1990s, arrivals after 2000; the highest infant mortality anywhere`,
  description,
  datasetName: 'Sierra Leone population, net migration and infant mortality, 1950–2100',
  datasetDescription: `Mid-year population of Sierra Leone for selected years from 1950 to ${CURRENT_YEAR} (every year 1990–1995 and 1999–2003 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: sle.published, updated: sle.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Sierra Leone"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Sierra Leone", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Sierra Leone: the 1990s outflow and a young, growing country</h1>
        <LiveCounter
          label="Sierra Leone: estimated population at this time"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024, mid-${CURRENT_YEAR}: some ${int(c.change / 365)} more people each day`}
        />
        <p class="answer">
          Sierra Leone counts an estimated <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, about 4.5 times its 1950 total. With <strong>{dec(c.infantMortalityPer1000!, 1)}</strong> babies in every 1,000 dying before age one, it has the highest infant mortality anywhere.
        </p>
        <div class="dates"><span>Updated <time datetime={sle.updated}>{longDate(sle.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Sierra Leone" code="sl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why did so many people leave Sierra Leone in the 1990s?</h2>
          <p>The UN data record the flow, not its causes. More people left than came in every year from 1991 to 1999, close to {int(Math.round(outSum / 1e4) * 10)} thousand altogether, most of all in 1991 ({int(-outTop.netMigrants)}). The mid-year total slipped in 1992 and 1993, its only falls on record. Between 2000 and 2003 the direction reversed, with {int(inTop.netMigrants)} net arrivals in 2001. Life expectancy stayed below 45 throughout the decade.</p>
        </div>
        <div class="age-row" role="group" aria-label="Sierra Leone net migration in 1991, 1995 and 2001 (UN)">
          <div><span class="y">1991</span><div class="v">{int(-y[1991].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">1995</span><div class="v">{int(-y[1995].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">2001</span><div class="v">{int(y[2001].netMigrants)}</div><span class="d">Net arrivals</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is infant mortality in Sierra Leone the world's highest?</h2>
          <p>Yes, in the UN's {CURRENT_YEAR} estimates: {dec(c.infantMortalityPer1000!, 1)} per 1,000 live births. Lifespans have nonetheless lengthened, from {dec(y[1950].lifeExpectancy, 1)} years in 1950 and {dec(y[2000].lifeExpectancy, 1)} in 2000 to {dec(c.lifeExpectancy, 1)} now.</p>
        </div>
        <LineChart
          title="Life expectancy in Sierra Leone, 1950–2050"
          subtitle="UN estimates with each year 1990–1995 and 1999–2003 shown; dashed projection after 2023."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How quickly is Sierra Leone's population rising?</h2>
          <p>By {pct(c.growthRatePct)} a year; the typical resident is just {dec(c.medianAge, 1)}. The fertility peak came in {tfrTop.year} ({dec(tfrTop.fertility, 2)}); the rate now stands at {dec(c.fertility, 2)}, and the projection takes it below 2.1 in {repl}, with the population cresting at {millions(peak.population)} in {peak.year}. Urban residents become the majority in {urbanHalf} under the national definition.</p>
        </div>
        <RelatedPages iso3={sle.iso3} name={sle.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Sierra Leone across the years, 1990–1995 and 1999–2003 in full"
          subtitle="The net migration column turns negative in 1991 and positive again in 2000."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${sle.slug}-population.csv`)}
          csvName={`${sle.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Sierra Leone: questions from readers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{sle.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={sle.published}>{longDate(sle.published)}</time> · Updated <time datetime={sle.updated}>{longDate(sle.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Sierra Leone population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Sierra Leone" code="sl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
