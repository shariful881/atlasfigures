---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import uz from '../../data/countries/uzbekistan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: Central Asia's most populous country, a
// fertility rebound from 2012 to 2023 that pushed births to a record, a median age that stops rising for a while, and
// growth that continues to 2100.
const PAGE = '/population/uzbekistan/';
const un = countryData(uz.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (uz.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => !r.projection);
const central = wpp.filter((d: any) => d.subregion === 'Central Asia');
const bySize = [...central].sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
const byTfr = [...central].sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3);
assertClaim(bySize[0] === 'UZB' && byTfr[0] === 'UZB', 'largest population and highest fertility in Central Asia');
const kaz = central.find((d: any) => d.iso3 === 'KAZ');
const ratio = c.population / at(kaz).population;
assertClaim(ratio > 1.7 && ratio < 1.9, 'about 1.8 times Kazakhstan');
const tfrLow = un.years.filter((r) => r.year >= 1990 && r.year <= 2023).reduce((a, b) => (b.fertility < a.fertility ? b : a));
const tfrHigh = un.years.filter((r) => r.year >= tfrLow.year && !r.projection).reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrLow.year === 2012 && tfrHigh.year === 2023 && tfrHigh.fertility - tfrLow.fertility > 1, 'fertility rose by more than one child per woman from 2012 to 2023');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2023, 'births in 2023 the highest of the estimate years');
assertClaim(y[2030].medianAge < c.medianAge && y[2040].medianAge < y[2050].medianAge, 'median age dips slightly to 2030 before rising again');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(peak.year === 2100 && below === 2079, 'still growing in 2100; fertility under 2.1 only from 2079');
assertClaim(un.years.filter((r) => r.year >= 1990 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0), 'small net outflow every year since 1990');
const times = c.population / y[1950].population;
assertClaim(times > 5.8 && times < 6.2, 'about six times 1950');

const title = `Uzbekistan Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Central Asia's Largest | AtlasFigures`;
const description = `Central Asia's most populous country: ${millions(c.population)} Uzbekistanis in mid-${CURRENT_YEAR} (UN). Fertility turned up after 2012, births set a record in 2023, and ${millions(y[2100].population)} is the UN's medium figure for 2100.`;
assertClaim(c.urbanPct! > 50 && c.urbanPct! < 52, 'just over half urban');

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: uz.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, uz.tableYears);

const faq = [
  { q: 'Does Uzbekistan have more people than Kazakhstan?', a: `Many more. Its ${millions(c.population)} residents this year (UN) outnumber Kazakhstan roughly ${dec(ratio, 1)} to one; the country ranks ${ord(c.worldRank!)} globally.` },
  { q: 'Why did births rise in Uzbekistan after 2012?', a: `The UN figures show the rise but not its causes. A ${tfrLow.year} rate of ${dec(tfrLow.fertility, 2)} had become ${dec(tfrHigh.fertility, 2)} by ${tfrHigh.year}, and births reached about ${int(Math.round(birthTop.births / 1000))} thousand in ${birthTop.year}.` },
  { q: 'Is the typical Uzbekistani getting older?', a: `Not yet. Half of residents are under ${dec(c.medianAge, 1)} this year, and the UN projection even lowers that midpoint a little, to ${dec(y[2030].medianAge, 1)}, by 2030 before it rises again.` },
  { q: 'What size will Uzbekistan reach by 2050?', a: `Around ${millions(y[2050].population)} if the UN's central assumptions hold, rising further to ${millions(y[2100].population)} in 2100 with growth continuing right up to that year.` },
  { q: 'Is Uzbekistan losing people to emigration?', a: `Only a few. Departures have exceeded arrivals in each UN year from 1990, by some ${int(Math.round(-c.netMigrants / 1000))} thousand this year, which is tiny next to the ${int(Math.round(c.naturalChange / 1000))} thousand surplus of births over deaths.` },
];

const schema = countrySchema({
  page: PAGE, slug: uz.slug, name: uz.name, wikipedia: uz.wikipedia,
  headline: `Uzbekistan's ${millions(c.population)}: Central Asia's largest population and a fertility rebound`,
  description,
  datasetName: 'Uzbekistan population, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Uzbekistan for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: uz.published, updated: uz.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Uzbekistan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Uzbekistan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Uzbekistan: Central Asia's biggest, with a baby boom</h1>
        <LiveCounter
          label="Uzbekistan: population today, estimated"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: value for mid-${CURRENT_YEAR}, growing by around ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Uzbekistan, home to some <strong>{millions(c.population)}</strong> in mid-{CURRENT_YEAR}, leads Central Asia in population and ranks {ord(c.worldRank!)} globally. Fertility <strong>rose again</strong> after its {tfrLow.year} low of {dec(tfrLow.fertility, 2)}, reaching {dec(tfrHigh.fertility, 2)} by {tfrHigh.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={uz.updated}>{longDate(uz.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Uzbekistan" code="uz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why are more babies being born in Uzbekistan?</h2>
          <p>The UN data record a rebound without giving reasons. After touching {dec(tfrLow.fertility, 2)} in {tfrLow.year}, the rate climbed by more than one child to {dec(tfrHigh.fertility, 2)} in {tfrHigh.year}; it is {dec(c.fertility, 2)} now, the highest in Central Asia. Births peaked among the estimate years in {birthTop.year} at about {int(Math.round(birthTop.births / 1000))} thousand.</p>
        </div>
        <LineChart
          title="How Uzbek fertility fell and recovered, 1950 to 2050"
          subtitle="UN births-per-woman estimates, dashed when projected; 2.1 shown."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How does Uzbekistan compare with its Central Asian neighbours?</h2>
          <p>It is by far the largest, outnumbering Kazakhstan, the runner-up, by roughly {dec(ratio, 1)} to one, and it has grown about {dec(times, 1)}-fold since 1950, when it had {millions(y[1950].population)}. Growth is {pct(c.growthRatePct)} this year. Departures have edged out arrivals every year since 1990, around {int(Math.round(-c.netMigrants / 1000))} thousand for {CURRENT_YEAR}.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Uzbekistan ageing yet?</h2>
          <p>Not for now. The median age rose from {dec(y[2000].medianAge, 1)} in 2000 to {dec(c.medianAge, 1)} today, but the UN projection has it dipping slightly to {dec(y[2030].medianAge, 1)} by 2030 and only then climbing again, to {dec(y[2050].medianAge, 1)} in 2050. Towns and cities hold just over half of residents, {pct(c.urbanPct!)} by the national definition.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Uzbekistan">
          <div><span class="y">2000</span><div class="v">{dec(y[2000].medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">2030, UN projection</span><div class="v">{dec(y[2030].medianAge, 1)}</div><span class="d">Slight dip</span></div>
        </div>

        <div class="story-block prose">
          <h2>How large could Uzbekistan grow?</h2>
          <p>The medium variant goes to {millions(y[2050].population)} in 2050, then on to {millions(y[2100].population)} in 2100 without ever turning down; fertility drops below 2.1 only in {below}.</p>
        </div>
        <LineChart
          title="Uzbekistan's population, 1950–2100"
          subtitle="UN mid-year series; the projection (dashed) keeps rising through 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={uz.iso3} name={uz.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Uzbekistan year by year, 1950 to 2100"
          subtitle="The 2012 and 2023 rows mark the low and high of the fertility rebound."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${uz.slug}-population.csv`)}
          csvName={`${uz.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Uzbekistan's population: answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{uz.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={uz.published}>{longDate(uz.published)}</time> · Updated <time datetime={uz.updated}>{longDate(uz.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Uzbekistan population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Uzbekistan" code="uz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
