---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import lk from '../../data/countries/sri-lanka.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a dense island with a small official urban share, long lives for the region, steady net emigration, a 2051 peak.
const PAGE = '/population/sri-lanka/';
const un = countryData(lk.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (lk.verification as any).checkedOn as string | undefined;
const KOTTE_URL = 'https://www.britannica.com/place/Sri-Jayewardenepura-Kotte';

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const south = wpp.filter((d: any) => d.subregion === 'Southern Asia');
const urbLow = south.filter((d: any) => at(d).urbanPct != null).sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3);
assertClaim(urbLow[0] === 'LKA', 'lowest urban share in Southern Asia (national definitions)');
const urb10 = wpp.filter((d: any) => at(d).population > 10e6 && at(d).urbanPct != null).sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3);
assertClaim(urb10.indexOf('LKA') === 3, 'fourth-lowest urban share among countries over 10 million');
const urbVals = un.years.filter((r) => r.year <= 2050 && r.urbanPct != null).map((r) => r.urbanPct!);
assertClaim(Math.min(...urbVals) > 14 && Math.max(...urbVals) < 23, 'urban share between 14% and 23% in every year 1950–2050');
const dense = wpp.filter((d: any) => at(d).population > 10e6).sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).map((d: any) => d.iso3);
assertClaim(dense.indexOf('LKA') === 10, 'eleventh-densest country over 10 million');
const le = south.slice().sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(le.slice(0, 3).join(',') === 'MDV,IRN,LKA', 'third-longest life expectancy in Southern Asia after the Maldives and Iran');
const men = (c.male / c.female) * 100;
const men1950 = (y[1950].male / y[1950].female) * 100;
assertClaim(men1950 > 119 && men < 94, '119 men per 100 women in 1950, under 94 now');
const est = un.years.filter((r) => !r.projection);
assertClaim(un.years.filter((r) => r.year >= 2002).every((r) => r.netMigrants < 0) && y[2001].netMigrants >= 0, 'net outflow every year since 2002');
const outTop = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1984, 'largest net outflow in 1984');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1979, 'births peaked in 1979');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 2015 && un.years.every((r) => r.year < 2015 || r.fertility < 2.1) && un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a)).year === 1950, 'fertility highest in 1950; under 2.1 since 2015');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2051 && natLoss === 2058 && un.years.filter((r) => r.year > 2051).every((r) => r.change < 0), 'peak 2051, decline every year after; natural loss from 2058');

const oldS = south.slice().sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).map((d: any) => d.iso3);
assertClaim(oldS.indexOf('LKA') < 4 && south.length >= 8, 'median age higher than most of Southern Asia');
assertClaim(peak.year - CURRENT_YEAR === 25, 'peak 25 years away');
const title = `Sri Lanka's ${(c.population / 1e6).toFixed(1)} Million People (${CURRENT_YEAR}): Dense but Mostly Rural | AtlasFigures`;
const description = `Sri Lanka has ${millions(c.population)} people (mid-${CURRENT_YEAR}) at ${int(c.densityPerKm2)} per km², yet only ${pct(c.urbanPct!)} count as urban. UN data on its long life expectancy, emigration and a ${peak.year} peak.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: lk.capital, note: 'legislative; Colombo is the commercial capital' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Urban share', value: pct(c.urbanPct!) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, lk.tableYears);

const faq = [
  { q: 'What does Sri Lanka\'s population come to in ' + CURRENT_YEAR + '?', a: `Around ${millions(c.population)}, from the UN's mid-year series, which places Sri Lanka ${ord(c.worldRank!)} in the world.` },
  { q: 'Why does Sri Lanka count so few people as urban?', a: `The share, ${pct(c.urbanPct!)}, follows Sri Lanka's own definition of an urban area as reported to the UN; the urbanization figures do not explain the definition. Compared country to country, it is the lowest in Southern Asia.` },
  { q: 'What is the life span of a Sri Lankan?', a: `Sri Lankan newborns can expect ${dec(c.lifeExpectancy, 1)} years; in Southern Asia only the Maldives and Iran do better.` },
  { q: 'Is Sri Lanka\'s population close to its peak?', a: `Within about 25 years: in ${peak.year}, at ${millions(peak.population)}, by the UN's medium projection. After that it slips each year, to ${millions(y[2100].population)} in 2100.` },
  { q: 'Is Colombo the capital of Sri Lanka?', a: `Not officially: Sri Jayewardenepura Kotte is the legislative capital, and nearby Colombo is the commercial capital, as Encyclopaedia Britannica describes them.` },
];

const schema = countrySchema({
  page: PAGE, slug: lk.slug, name: lk.name, wikipedia: lk.wikipedia,
  headline: `Sri Lanka: ${millions(c.population)} people, ${int(c.densityPerKm2)} per km², ${pct(c.urbanPct!)} urban`,
  description,
  datasetName: 'Sri Lanka population, density, urban share, life expectancy and migration, 1950–2100',
  datasetDescription: `Mid-year population of Sri Lanka for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: lk.published, updated: lk.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Sri Jayewardenepura Kotte', url: KOTTE_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Sri Lanka"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Sri Lanka', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Sri Lanka: a densely settled island that counts itself mostly rural</h1>
        <LiveCounter
          label="Sri Lanka: live estimate of the population"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} reference point, growing about ${int(c.change / 365)} people per day`}
        />
        <p class="answer">
          Sri Lanka's population is roughly <strong>{millions(c.population)}</strong> in mid-{CURRENT_YEAR} ({ord(c.worldRank!)} worldwide), packed at {int(c.densityPerKm2)} per km². Yet by its own definition <strong>only {pct(c.urbanPct!)} live in urban areas</strong>, the smallest share in Southern Asia.
        </p>
        <div class="dates"><span>Updated <time datetime={lk.updated}>{longDate(lk.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Sri Lanka" code="lk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Sri Lanka's urban population so small?</h2>
          <p>It is small on paper: Sri Lanka's national definition puts {pct(c.urbanPct!)} of people in urban areas, the lowest in Southern Asia and the fourth-lowest of any country above 10 million. The figure has stayed between about 15% and 22% in every year since 1950, even as density rose to {int(c.densityPerKm2)} per km², eleventh-highest in that size group. The UN data record the definition's result, not its details.</p>
        </div>
        <LineChart
          title="Sri Lanka's population, 1950–2100: up to 2051, then down"
          subtitle="Mid-year population as the UN records it; the dashed part tops out near 24.8 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Do Sri Lankans live longer than their neighbours?</h2>
          <p>Mostly yes. Newborns can expect {dec(c.lifeExpectancy, 1)} years, behind only the Maldives and Iran in the UN's Southern Asia group, and up from {dec(y[1950].lifeExpectancy, 1)} in 1950. The median Sri Lankan is {dec(c.medianAge, 1)}, older than most of the region.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy in Sri Lanka">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].lifeExpectancy, 1)}</div><span class="d">Years of life</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Third in Southern Asia</span></div>
          <div><span class="y">2100, UN projection</span><div class="v">{dec(y[2100].lifeExpectancy, 1)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>How much does emigration affect Sri Lanka?</h2>
          <p>It trims growth every year. Net migration has been negative in each year since 2002, about {int(Math.round(-c.netMigrants / 1000))} thousand in {CURRENT_YEAR}, while births exceed deaths by {int(Math.round(c.naturalChange / 1000))} thousand. The largest net outflow in the UN series came in {outTop.year}, about {int(Math.round(-outTop.netMigrants / 1000))} thousand. In 1950 there were {dec(men1950, 1)} males per 100 females; today there are {dec(men, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How has Sri Lanka's birth rate changed?</h2>
          <p>Sri Lankan fertility was at its highest in 1950, {dec(y[1950].fertility, 2)} children per woman, and has been under 2.1 since {below}; it is {dec(c.fertility, 2)} now. Births peaked in {birthTop.year} at around {int(Math.round(birthTop.births / 1000))} thousand and are about {int(Math.round(c.births / 1000))} thousand this year.</p>
        </div>
        <LineChart
          title="Sri Lanka's fertility rate since 1950 and projected to 2050"
          subtitle="UN total fertility; estimates solid, projection dashed, 2.1 drawn for scale."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 for scale' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>When will Sri Lanka stop growing?</h2>
          <p>The medium variant sees growth stop in {peak.year} at a population of {millions(peak.population)}, with a fall every year after; natural decrease begins in {natLoss}. By 2100 Sri Lanka would hold {millions(y[2100].population)}, and half the population would be older than {dec(y[2100].medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Which city is Sri Lanka's capital?</h2>
          <p>Two cities share the role: <a href={KOTTE_URL}>Encyclopaedia Britannica</a> describes Sri Jayewardenepura Kotte as the legislative capital and nearby Colombo as the commercial capital.</p>
        </div>
        <RelatedPages iso3={lk.iso3} name={lk.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Sri Lanka, decade by decade, with projections"
          subtitle="The urban column stays low throughout, while density keeps rising until the 2050s."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${lk.slug}-population.csv`)}
          csvName={`${lk.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Sri Lanka's population in a few questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{lk.unName}"): population, males and females, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and comparisons with other countries.</li>
            <li><a href={KOTTE_URL}>Encyclopaedia Britannica, "Sri Jayewardenepura Kotte"</a>: legislative capital; Colombo as commercial capital.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={lk.published}>{longDate(lk.published)}</time> · Updated <time datetime={lk.updated}>{longDate(lk.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Sri Lanka population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Sri Lanka" code="lk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
