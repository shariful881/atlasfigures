---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import slv from '../../data/countries/el-salvador.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: the densest mainland country in
// the Americas (1 million+); net departures in every year 1950–2100, largest 1998; the 1980 life-expectancy dip (no cause
// given); 90.5 men per 100 women, second-lowest in Latin America and the Caribbean after Puerto Rico; fertility under 2.1
// since 2015; the one fall in 2006; a 2047 peak.
const PAGE = '/population/el-salvador/';
const un = countryData(slv.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (slv.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
const main1 = lac1.filter((d: any) => d.subregion !== 'Caribbean');
assertClaim([...main1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2)[0].iso3 === 'SLV', 'densest mainland Latin American country');
assertClaim([...lac1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 3).map((d: any) => d.iso3).join() === 'HTI,PRI,SLV', 'third in the region after Haiti and Puerto Rico');
assertClaim(un.years.every((r) => r.netMigrants < 0), 'net departures every year');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1998, 'largest outflow 1998');
assertClaim(y[1980].lifeExpectancy < y[1979].lifeExpectancy - 5 && y[1982].lifeExpectancy < y[1979].lifeExpectancy, '1980 dip over 5 years');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...lac1].sort((a: any, b: any) => sr(a) - sr(b)).slice(0, 2).map((d: any) => d.iso3).join() === 'PRI,SLV', 'second-lowest sex ratio after Puerto Rico');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2015 && un.years.filter((r) => r.year >= 2015).every((r) => r.fertility < 2.1), 'under 2.1 every year from 2015');
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '2006', 'only fall to date in 2006');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2047, 'peak 2047');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1992, 'urban majority 1992');
const cam = wpp.filter((d: any) => d.subregion === 'Central America' && at(d).population >= 1e6).sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).map((d: any) => d.iso3);
assertClaim(cam.slice(0, 2).join() === 'SLV,GTM', 'Guatemala next-densest in Central America');

const title = `El Salvador Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Mainland America's Most Crowded Country | AtlasFigures`;
const description = `El Salvador's ${CURRENT_YEAR} count: ${millions(c.population)} (UN), with ${int(c.densityPerKm2)} people to each km², denser than any other mainland country in the Americas. Departures exceed arrivals every year from 1950 to 2100; the total peaks in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: slv.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, slv.tableYears);

const faq = [
  { q: 'Does any Central American country pack people in more tightly than El Salvador?', a: `No, and none on the American mainland does either: ${int(c.densityPerKm2)} per km². Haiti and Puerto Rico, both islands, are denser.` },
  { q: 'In which year did the most Salvadorans leave?', a: `${outTop.year}, when departures topped arrivals by ${int(-outTop.netMigrants)}. The UN shows a net loss in every year from 1950 to 2100 and does not give reasons.` },
  { q: 'Do Salvadoran women outnumber men?', a: `Yes. The UN files put men at ${dec((c.male / c.female) * 100, 1)} per 100 women; region-wide only Puerto Rico sits lower. Reasons are not given.` },
  { q: 'Since when has Salvadoran fertility been below 2.1?', a: `From 2015 onward, without a break; currently ${dec(c.fertility, 2)}.` },
  { q: 'When does the Salvadoran count stop rising?', a: `In ${peak.year} (${millions(peak.population)}), after which it slides, reaching ${millions(y[2100].population)} in 2100.` },
];

const schema = countrySchema({
  page: PAGE, slug: slv.slug, name: slv.name, wikipedia: slv.wikipedia,
  headline: `El Salvador's ${millions(c.population)}: the densest mainland country in the Americas; emigration every year and a ${peak.year} peak`,
  description,
  datasetName: 'El Salvador population, density and net migration, 1950–2100',
  datasetDescription: `Mid-year population of El Salvador for selected years from 1950 to ${CURRENT_YEAR}, including 1978, 1980, 1998, 2005 and 2006, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: slv.published, updated: slv.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="El Salvador"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "El Salvador", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>El Salvador: small, crowded and losing people abroad</h1>
        <LiveCounter
          label="El Salvador: estimated head count, live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Tracks the UN World Population Prospects 2024 mid-${CURRENT_YEAR} level; roughly ${int(c.change / 365)} more each day`}
        />
        <p class="answer">
          On UN figures, <strong>{millions(c.population)}</strong> Salvadorans share their small country in {CURRENT_YEAR}, <strong>{int(c.densityPerKm2)}</strong> to each km², a crowding no other mainland country in the Americas reaches. Net emigration runs through every year of the series.
        </p>
        <div class="dates"><span>Updated <time datetime={slv.updated}>{longDate(slv.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="El Salvador" code="sv" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Is El Salvador denser than the rest of Central America?</h2>
          <p>Much denser: {int(c.densityPerKm2)} residents per km², against {int(at(wpp.find((d: any) => d.iso3 === 'GTM')).densityPerKm2)} in Guatemala, the next-densest Central American country. Region-wide, only two islands, Haiti and Puerto Rico, pack people more tightly. {pct(c.urbanPct!)} of Salvadorans are urban, a majority since {urbanHalf}.</p>
        </div>

        <div class="story-block prose">
          <h2>How many Salvadorans have left, year by year?</h2>
          <p>On balance more go than come in every year from 1950 to 2100. The UN puts the net outflow at {int(-y[1980].netMigrants)} in 1980, {int(-outTop.netMigrants)} in {outTop.year} (the most) and {int(-c.netMigrants)} in {CURRENT_YEAR}. Only 2006 shows a lower July total than the year before. The files count departures without saying why they happened.</p>
        </div>
        <LineChart
          title="Salvadoran net migration since 1950"
          subtitle="Arrivals minus departures, every value below zero; dashed after 2023."
          points={rows.map((r) => ({ x: r.year, y: r.netMigrants, projection: r.projection }))}
          format="plain"
          unit="people"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What does the 1980 dip in Salvadoran life expectancy show?</h2>
          <p>A fall from {dec(y[1979].lifeExpectancy, 1)} years in 1979 to {dec(y[1980].lifeExpectancy, 1)} in 1980, more than five years, with {dec(y[1982].lifeExpectancy, 1)} still recorded for 1982. The source does not name a cause. Lifespans now average {dec(c.lifeExpectancy, 1)}. Men are fewer: {dec((c.male / c.female) * 100, 1)} of them for each 100 women, a ratio only Puerto Rico undercuts in the region.</p>
        </div>

        <div class="story-block prose">
          <h2>Is the Salvadoran total still climbing?</h2>
          <p>For two more decades. The medium variant carries it up to {millions(peak.population)} by {peak.year}, after which it declines, to {millions(y[2100].population)} in 2100. Since 2015 the fertility rate has stayed under 2.1; this year's: {dec(c.fertility, 2)}.</p>
        </div>
        <RelatedPages iso3={slv.iso3} name={slv.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="El Salvador across the decades, 1980, 1998 and 2006 included"
          subtitle="Net migration is negative on every row; 2006 is the one dip in the total."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${slv.slug}-population.csv`)}
          csvName={`${slv.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">El Salvador, the short answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{slv.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={slv.published}>{longDate(slv.published)}</time> · Updated <time datetime={slv.updated}>{longDate(slv.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("El Salvador population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="El Salvador" code="sv" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
