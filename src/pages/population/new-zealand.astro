---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import nz from '../../data/countries/new-zealand.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: growth split almost evenly between births and
// arrivals, migration that swings between net gains and net losses, fertility that lingered near 2.1 into the 2010s,
// and one of the latest population peaks in the rich world (2078).
const PAGE = '/population/new-zealand/';
const un = countryData(nz.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (nz.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => !r.projection);
const ratio = c.netMigrants / c.naturalChange;
assertClaim(ratio > 0.85 && ratio < 1, 'net migration and natural increase roughly equal, births slightly ahead');
const aus = wpp.find((d: any) => d.iso3 === 'AUS');
assertClaim(at(aus).growthRatePct > c.growthRatePct, 'growing more slowly than Australia');
const outYears = est.filter((r) => r.netMigrants < 0).map((r) => r.year);
assertClaim(outYears.join(',') === '1967,1968,1969,1976,1977,1978,1979,1980,1981,1984,1985,1986,1987,1988,1989,1998,1999,2000,2011,2012,2021', 'net outflow years: late 1960s, late 1970s and 1980s, around 2000, 2011–2012, 2021');
assertClaim(un.years.filter((r) => r.year >= 1978 && r.year <= 2010).every((r) => r.fertility > 1.85 && r.fertility < 2.25), 'fertility hovered around 2.1 from 1978 to 2010');
const migTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(migTop.year === 2016, 'record net inflow 2016');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrMax.year === 1961 && y[2008].fertility > 2.1 && y[2010].fertility > 2.1 && y[2018].fertility < 1.8, 'fertility 1961 high, above 2.1 again in 2008 and 2010, under 1.8 by 2018');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2078 && natLoss === 2047, 'peak 2078; deaths exceed births from 2047');
const oceania = wpp.filter((d: any) => d.region === 'Oceania').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(oceania.slice(0, 3).join(',') === 'AUS,PNG,NZL', 'third in Oceania after Australia and Papua New Guinea');
const nor = wpp.find((d: any) => d.iso3 === 'NOR');
const passNor = un.years.find((r) => r.year > CURRENT_YEAR && r.population > at(nor, r.year).population)!.year;
assertClaim(passNor === 2063, 'passes Norway in 2063');
const times = c.population / y[1950].population;
assertClaim(times > 2.7 && times < 2.85, 'about 2.8 times 1950');
assertClaim(c.densityPerKm2 > 19.5 && c.densityPerKm2 < 20.5, 'about 20 per km²');

const title = `New Zealand Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Peak Not Until ${peak.year} | AtlasFigures`;
const description = `Births and net migration add similar numbers to New Zealand's population of ${millions(c.population)} (UN estimate for mid-${CURRENT_YEAR}). Growth continues until about ${peak.year}, when the projected total tops out at ${millions(peak.population)}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: nz.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Growth', value: `+${pct(c.growthRatePct)}` },
  { label: 'Net migration', value: `+${int(c.netMigrants)}` },
  { label: 'Peak year', value: String(peak.year) },
];

const rows = displayRows(un.years, nz.tableYears);
assertClaim(y[1980].netMigrants < 0 && y[2000].netMigrants < 0 && rows.filter((r) => r.projection).every((r) => r.netMigrants > 0), '1980 and 2000 rows negative, every projected row positive');

const faq = [
  { q: 'How many people call New Zealand home?', a: `Close to ${millions(c.population)} by UN estimate for mid-${CURRENT_YEAR}. Only Australia and Papua New Guinea have more people in Oceania; worldwide New Zealand ranks ${ord(c.worldRank!)}.` },
  { q: 'What is New Zealand\'s growth rate?', a: `${pct(c.growthRatePct)} in ${CURRENT_YEAR}, about ${int(Math.round(c.change / 1000))} thousand people, a slower rate than Australia's.` },
  { q: 'Is net migration into New Zealand ever negative?', a: `Yes, in ${outYears.length} years of the UN series, most recently 2021, though net gains are far more common; the largest, about ${int(Math.round(migTop.netMigrants / 1000))} thousand, came in ${migTop.year}.` },
  { q: 'In what year is New Zealand\'s population projected to peak?', a: `In ${peak.year}, at about ${millions(peak.population)}, under the UN's medium projection. From ${natLoss} the UN expects deaths to top births.` },
  { q: 'How many children does the average New Zealand woman have?', a: `${dec(c.fertility, 2)} in ${CURRENT_YEAR}. The rate was ${dec(y[2010].fertility, 2)} as recently as 2010 and ${dec(tfrMax.fertility, 2)} at its ${tfrMax.year} high.` },
];

const schema = countrySchema({
  page: PAGE, slug: nz.slug, name: nz.name, wikipedia: nz.wikipedia,
  headline: `New Zealand's ${millions(c.population)}: births and arrivals in step, and a peak in ${peak.year}`,
  description,
  datasetName: 'New Zealand population, net migration, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of New Zealand for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: nz.published, updated: nz.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="New Zealand"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'New Zealand', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>New Zealand: growing on births and arrivals alike</h1>
        <LiveCounter
          label="New Zealand: population as estimated now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} starting point, climbing about ${int(c.change / 365)} daily`}
        />
        <p class="answer">
          New Zealand's population, by UN estimate <strong>{millions(c.population)}</strong> for mid-{CURRENT_YEAR}, ranks {ord(c.worldRank!)} worldwide, with growth of {pct(c.growthRatePct)} a year shared between <strong>net migration and natural increase</strong> in similar amounts; the total is not projected to peak until {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={nz.updated}>{longDate(nz.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="New Zealand" code="nz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Where does New Zealand's population growth come from?</h2>
          <p>Almost equally from two sources. In {CURRENT_YEAR} births exceed deaths by about {int(Math.round(c.naturalChange / 1000))} thousand, and arrivals exceed departures by about {int(Math.round(c.netMigrants / 1000))} thousand. The two combined add about {int(Math.round(c.change / 1000))} thousand people, a rate of {pct(c.growthRatePct)}, a little slower than Australia's.</p>
        </div>
        <LineChart
          title={`New Zealand's population, 1950–2100: still climbing until ${peak.year}`}
          subtitle="UN population by year, projected part dashed; the curve flattens only late in the century."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has New Zealand ever lost people to migration?</h2>
          <p>In some years, yes. The UN series shows a net outflow in {outYears.length} separate years since 1950, in runs during the late 1960s, the late 1970s and 1980s, around 2000, in 2011–2012 and most recently in 2021. In between came large net gains, the biggest about {int(Math.round(migTop.netMigrants / 1000))} thousand in {migTop.year}. The data record the balance, not who moved.</p>
        </div>
        <div class="age-row" role="group" aria-label="Net migration in New Zealand, UN estimates">
          <div><span class="y">{migTop.year}</span><div class="v">+{int(Math.round(migTop.netMigrants / 1000))}k</div><span class="d">Largest net gain</span></div>
          <div><span class="y">2021</span><div class="v">−{int(Math.round(-y[2021].netMigrants / 1000))}k</div><span class="d">Latest net loss</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">+{int(Math.round(c.netMigrants / 1000))}k</div><span class="d">This year</span></div>
        </div>

        <div class="story-block prose">
          <h2>How has fertility changed in New Zealand?</h2>
          <p>It fell from a {tfrMax.year} high of {dec(tfrMax.fertility, 2)} but hovered around 2.1 for decades, still {dec(y[2008].fertility, 2)} in 2008 and {dec(y[2010].fertility, 2)} in 2010. Since then it has dropped to {dec(y[2018].fertility, 2)} in 2018 and {dec(c.fertility, 2)} today.</p>
        </div>
        <LineChart
          title="New Zealand fertility, 1950 to 2050"
          subtitle="Children per woman from UN estimates, dashed where projected; reference line at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Until when will New Zealand's population grow?</h2>
          <p>Late in the century. From {natLoss} deaths are expected to top births, but continued net migration keeps the total rising to about {millions(peak.population)} in {peak.year}; it is {millions(y[2100].population)} in 2100. Along the way New Zealand passes Norway, in {passNor}. Today's total is about {dec(times, 1)} times the 1950 level ({millions(y[1950].population)}); the country averages {int(c.densityPerKm2)} people per km², and is {pct(c.urbanPct!)} urban by its national definition.</p>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="New Zealand's population, 1950–2100, row by row"
          subtitle="The 1980 and 2000 rows show net outflows; every projected row is a net gain."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${nz.slug}-population.csv`)}
          csvName={`${nz.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">New Zealand's population: answers at a glance</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{nz.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={nz.published}>{longDate(nz.published)}</time> · Updated <time datetime={nz.updated}>{longDate(nz.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('New Zealand population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="New Zealand" code="nz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
