---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import pk from '../../data/countries/pakistan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fast growth that carries Pakistan to third place.
const PAGE = '/population/pakistan/';
const un = countryData(pk.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (pk.verification as any).checkedOn as string | undefined;

const usa = byYear(countryData('USA').years), idn = byYear(countryData('IDN').years);
const passIdn = un.years.find((r) => r.population > idn[r.year].population)!.year;
const passUsa = un.years.find((r) => r.population > usa[r.year].population)!.year;
assertClaim(passIdn === 2037 && passUsa === 2053 && un.years.filter((r) => r.year >= passUsa).every((r) => r.worldRank === 3), 'passes Indonesia in 2037 and the US in 2053, then stays third');
assertClaim(un.years.every((r, i, a) => !i || r.population > a[i - 1].population), 'no peak before 2100');
const times = c.population / y[1950].population;
assertClaim(times > 7 && times < 7.5, 'about seven times the 1950 population');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const sub = un.years.find((r) => r.fertility < 2.1)!.year;
const est = un.years.filter((r) => !r.projection);
const outPeak = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const outSince = est.map((r) => r.year).find((yr) => est.every((r) => r.year < yr || r.netMigrants < 0))!;
assertClaim(c.netMigrants < 0 && c.naturalChange > 4 * Math.abs(c.netMigrants), 'net emigration, but natural growth more than four times larger');
assertClaim(c.fertility / tfrMax.fertility > 0.45 && c.fertility / tfrMax.fertility < 0.55 && c.lifeExpectancy / y[1950].lifeExpectancy > 1.9 && c.medianAge - y[1950].medianAge < 5, 'half the peak fertility; life expectancy doubled; median age barely moved');
assertClaim(c.worldRank === 5 && y[2050].fertility > 2.1, 'fifth; fertility above 2.1 in 2050');
const perDayBirths = Math.round(c.births / 365 / 1000) * 1000;
assertClaim(c.medianAge < 21, 'half of Pakistanis are younger than 21');
assertClaim(y[2050].urbanPct! < 50, 'urban share still under half in 2050');

const title = `Pakistan's Population, ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million and Set to Pass the US by ${passUsa} | AtlasFigures`;
const description = `Pakistan, the ${ord(c.worldRank!)} most populous nation, had ${millions(c.population)} inhabitants in ${CURRENT_YEAR} and adds about ${millions(c.change)} a year. Why the numbers keep climbing, and the year it is projected to become third.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: pk.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Infant deaths per 1,000 births', value: dec(c.infantMortalityPer1000, 1) },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Added per year', value: `+${millionsShort(c.change)}` },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, pk.tableYears);

const faq = [
  { q: "What is Pakistan's total population?", a: `${millions(c.population)} at mid-${CURRENT_YEAR}, according to UN estimates, or ${pct(c.worldSharePct)} of the world. Only India, China, the United States and Indonesia have more people.` },
  { q: 'Will Pakistan overtake the United States in population?', a: `Yes, on the UN's medium projection: in ${passUsa}. Pakistan would pass Indonesia first, in ${passIdn}, and then keep third place until 2100.` },
  { q: 'Is growth in Pakistan slowing down?', a: `Only gradually. The rate is ${pct(c.growthRatePct)} in ${CURRENT_YEAR} with ${pct(y[2050].growthRatePct)} projected for 2050. In absolute numbers the yearly gain stays over 4 million until the 2050s.` },
  { q: 'How big will Pakistan be by 2050?', a: `Around ${millions(y[2050].population)} people, the UN projects, with ${millions(y[2100].population)} by 2100 and still no peak.` },
  { q: 'How urban is Pakistan?', a: `On Pakistan's own definition, ${pct(c.urbanPct!)} of the population was urban in ${CURRENT_YEAR}, up from ${pct(y[1950].urbanPct!)} in 1950; by 2050 the projected figure is ${pct(y[2050].urbanPct!)}, still a minority.` },
];
assertClaim(un.years.filter((r) => r.year >= CURRENT_YEAR && r.year < 2050).every((r) => r.change > 4e6), 'yearly gain above 4 million until the 2050s');

const schema = countrySchema({
  page: PAGE, slug: pk.slug, name: pk.name, wikipedia: pk.wikipedia,
  headline: `Pakistan's population in ${CURRENT_YEAR}: ${millions(c.population)}, on course for third place in the world`,
  description,
  datasetName: 'Pakistan population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Pakistan for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: pk.published, updated: pk.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Pakistan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Pakistan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Pakistan's fast-growing population</h1>
        <LiveCounter
          label="Pakistan population, live estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: 1 July ${CURRENT_YEAR} total, rising by around ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Some <strong>{millions(c.population)}</strong> people lived in Pakistan at mid-{CURRENT_YEAR}, putting it {ord(c.worldRank!)} in the world, and each year adds <strong>roughly {millions(c.change)} more</strong>. On UN projections it overtakes the United States in {passUsa} to become the third most populous country.
        </p>
        <div class="dates"><span>Updated <time datetime={pk.updated}>{longDate(pk.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Pakistan" code="pk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How quickly is Pakistan adding people?</h2>
          <p>By {pct(c.growthRatePct)} in {CURRENT_YEAR}, which adds about {int(Math.round(c.change / 365 / 100) * 100)} people every day. Starting from {millions(y[1950].population)} in 1950, the population has multiplied about {dec(times, 1)} times. The medium projection never reaches a peak this century, arriving at {millions(y[2050].population)} by 2050, then {millions(y[2100].population)} at the century's end.</p>
        </div>
        <LineChart
          title="Pakistan's population from 1950, projected to 2100"
          subtitle="Mid-year totals. Growth continues through the whole UN projection, drawn dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>When will Pakistan become the world's third most populous country?</h2>
          <p>In {passUsa}, assuming the UN's medium variant is right. Pakistan moves past Indonesia in {passIdn} to take fourth place, then past the United States. It is expected to stay third, behind India and China, through to 2100.</p>
        </div>

        <div class="story-block prose">
          <h2>What is Pakistan's birth rate?</h2>
          <p>Pakistani women average {dec(c.fertility, 2)} children each in {CURRENT_YEAR}, half the {dec(tfrMax.fertility, 2)} of {tfrMax.year} but still well above the 2.1 at which a population stops growing in the long run. The UN does not project Pakistan to fall below that level until {sub}. That means close to {millions(c.births)} babies a year, roughly {int(perDayBirths)} a day.</p>
        </div>
        <LineChart
          title="Fertility in Pakistan, 1950 to 2050"
          subtitle="Children per woman. Falling, but projected to stay above the 2.1 line beyond 2050 (projected values shown dashed)."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="children per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1, long-run replacement' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many young people does Pakistan have?</h2>
          <p>A great many: half the population is younger than {dec(c.medianAge, 1)}. The median age has barely moved in seventy years, from {dec(y[1950].medianAge, 1)} in 1950, and the UN expects only {dec(y[2050].medianAge, 1)} by 2050. That young structure is why the population keeps growing even as families shrink.</p>
        </div>

        <div class="story-block prose">
          <h2>Does emigration slow Pakistan's growth?</h2>
          <p>A little. Departures have outnumbered arrivals in every year since {outSince}, with the outflow at its highest in {outPeak.year}, about {millions(Math.abs(outPeak.netMigrants))}. In {CURRENT_YEAR} net emigration is about {millions(Math.abs(c.netMigrants))}, set against a natural gain of {millions(c.naturalChange)} from births over deaths.</p>
        </div>

        <div class="story-block prose">
          <h2>How many babies in Pakistan die before their first birthday?</h2>
          <p>About {dec(c.infantMortalityPer1000, 1)} in every 1,000 in {CURRENT_YEAR}, the UN estimates. That is far fewer than the {int(y[1950].infantMortalityPer1000)} of 1950, and life expectancy has doubled over the same period, from {dec(y[1950].lifeExpectancy, 1)} to {dec(c.lifeExpectancy, 1)} years.</p>
        </div>
        <div class="age-row" role="group" aria-label="Survival in Pakistan">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].lifeExpectancy, 1)}</div><span class="d">Years of life expected at birth</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Twice as long</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.infantMortalityPer1000, 1)}</div><span class="d">Infant deaths per 1,000 births</span></div>
        </div>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Pakistan's population figures, 1950–2100"
          subtitle="Pakistan at ten-year steps plus the current year; everything from 2030 on is a UN projection."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${pk.slug}-population.csv`)}
          csvName={`${pk.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Pakistan's population: common queries</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, growth, density, fertility, median age, infant mortality, life expectancy, migration, world rank, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={pk.published}>{longDate(pk.published)}</time> · Updated <time datetime={pk.updated}>{longDate(pk.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Pakistan population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Pakistan" code="pk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
