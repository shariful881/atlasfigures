---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import co from '../../data/countries/colombia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: from a country of net emigration to one of net immigration in 2016, a 2018 record inflow, low fertility and a 2050 peak.
const PAGE = '/population/colombia/';
const un = countryData(co.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (co.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => !r.projection);
assertClaim(est.filter((r) => r.year < 2016).every((r) => r.netMigrants < 0) && un.years.filter((r) => r.year >= 2016 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants > 0), 'net outflow every year 1950–2015, net inflow every year since 2016');
const inTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2018 && inTop.netMigrants > 450e3, 'record net inflow in 2018, above 450 thousand');
const south = wpp.filter((d: any) => d.subregion === 'South America').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(south[0] === 'BRA' && south[1] === 'COL', 'second in South America after Brazil');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2050 && natLoss === 2051, 'peak 2050, natural loss from 2051');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(below === 2009 && tfrMax.year === 1959 && un.years.every((r) => r.year < 2009 || r.fertility < 2.1), 'fertility peak 1959; under 2.1 since 2009');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1994, 'births peaked in 1994');
assertClaim(c.netMigrants > 100e3 && Math.abs(y[2050].netMigrants) < 1000, 'net inflow above 100 thousand now, near zero by 2050');
const times = c.population / y[1950].population;
assertClaim(times > 4.5 && times < 4.7, 'about four and a half times 1950');

assertClaim(y[2010].netMigrants < 0 && y[2020].netMigrants > 0, 'net migration negative in 2010, positive in 2020');
const title = `Colombia's ${(c.population / 1e6).toFixed(1)} Million (${CURRENT_YEAR}): From Emigration to Immigration | AtlasFigures`;
const description = `With ${millions(c.population)} residents by mid-${CURRENT_YEAR}, Colombia has been a net receiver of migrants since 2016. UN data on that shift, its low fertility and a population peak in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: co.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Net migration', value: `+${int(c.netMigrants)}` },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, co.tableYears);

const faq = [
  { q: "How many residents does Colombia have?", a: `Close to ${millions(c.population)} in the UN's mid-${CURRENT_YEAR} series, ranking ${ord(c.worldRank!)} globally and second in South America behind Brazil.` },
  { q: 'When did Colombia start receiving more migrants than it lost?', a: `In 2016. From 1950 to 2015 departures exceeded arrivals in every UN year; the net inflow peaked in ${inTop.year} at about ${int(Math.round(inTop.netMigrants / 1000))} thousand. The data do not say where the migrants came from.` },
  { q: 'Does Colombia\'s population still rise each year?', a: `Yes, by ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, but the medium projection has it levelling off at ${millions(peak.population)} in ${peak.year}.` },
  { q: 'How far has Colombian fertility dropped?', a: `To ${dec(c.fertility, 2)} children per woman; no year since ${below} has reached 2.1; the ${tfrMax.year} peak was ${dec(tfrMax.fertility, 2)}.` },
  { q: 'Is Colombia an urban country?', a: `Yes: ${pct(c.urbanPct!)} under Colombia's own urban definition, heading for ${pct(y[2050].urbanPct!)} in 2050 according to World Urbanization Prospects.` },
];

const schema = countrySchema({
  page: PAGE, slug: co.slug, name: co.name, wikipedia: co.wikipedia,
  headline: `Colombia's ${millions(c.population)}: a turn to net immigration and a peak in ${peak.year}`,
  description,
  datasetName: 'Colombia population, migration, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Colombia for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: co.published, updated: co.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Colombia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Colombia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Colombia: a population reshaped by a migration turnaround</h1>
        <LiveCounter
          label="Colombia: rolling population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} starting figure, plus about ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Colombia's mid-{CURRENT_YEAR} total of about <strong>{millions(c.population)}</strong> puts it {ord(c.worldRank!)} on the global list. Having lost people to emigration every year up to 2015, it has <strong>gained through migration since 2016</strong>, with a record net inflow in {inTop.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={co.updated}>{longDate(co.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Colombia" code="co" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>When did Colombia become a country of immigration?</h2>
          <p>In 2016, by the UN's count. From 1950 through 2015 the net migration figure was negative every single year; from 2016 it turned positive and reached a high of about {int(Math.round(inTop.netMigrants / 1000))} thousand in {inTop.year}. The {CURRENT_YEAR} estimate is still a gain of around {int(Math.round(c.netMigrants / 1000))} thousand, while the medium projection fades it to roughly zero by 2050. Where the new arrivals come from is not part of these data.</p>
        </div>
        <div class="age-row" role="group" aria-label="Net migration in Colombia">
          <div><span class="y">2010</span><div class="v">{int(Math.round(y[2010].netMigrants / 1000))}k</div><span class="d">Net migration</span></div>
          <div><span class="y">{inTop.year}</span><div class="v">+{int(Math.round(inTop.netMigrants / 1000))}k</div><span class="d">Record inflow</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">+{int(Math.round(c.netMigrants / 1000))}k</div><span class="d">Still positive</span></div>
        </div>
        <LineChart
          title="Colombia's population, 1950–2100: a 2050 summit"
          subtitle="Mid-year population estimates by the UN; the dashed projection peaks at 59.4 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How quickly have Colombian families shrunk?</h2>
          <p>Within two generations. From a {tfrMax.year} level of {dec(tfrMax.fertility, 2)} the fertility rate sank below 2.1 by {below} and now stands at {dec(c.fertility, 2)}. Annual births have been falling since their {birthTop.year} high of roughly {int(Math.round(birthTop.births / 1000))} thousand; this year about {int(Math.round(c.births / 1000))} thousand are expected.</p>
        </div>
        <LineChart
          title="Fertility in Colombia, 1950 to 2050"
          subtitle="Colombian fertility by year: UN estimate, then projection in dashes; 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 mark' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Colombia's population start shrinking?</h2>
          <p>Yes, after {peak.year}. In the medium variant the population tops out at {millions(peak.population)} that year, natural decrease starts in {natLoss}, and the total falls to {millions(y[2100].population)} by 2100, {ord(y[2100].worldRank!)} in the world. Today's median of {dec(c.medianAge, 1)} rises to {dec(y[2050].medianAge, 1)} by 2050.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Colombia mostly urban?</h2>
          <p>Yes: {pct(c.urbanPct!)} under the national definition, compared with {pct(y[1950].urbanPct!)} in 1950, with {pct(y[2050].urbanPct!)} projected for 2050. Colombia is the second most populous country in South America, after Brazil, and has about four and a half times its 1950 population.</p>
        </div>
        <RelatedPages iso3={co.iso3} name={co.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Colombia's population statistics by decade"
          subtitle="Net migration flips sign from the 2010 row to the 2020 row."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${co.slug}-population.csv`)}
          csvName={`${co.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Colombia's population: questions worth asking</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{co.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and its projection to 2050.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={co.published}>{longDate(co.published)}</time> · Updated <time datetime={co.updated}>{longDate(co.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Colombia population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Colombia" code="co" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
