---
import Base from '../../layouts/Base.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import LiveCounter from '../../components/LiveCounter.astro';
import LineChart from '../../components/LineChart.astro';
import DataTable from '../../components/DataTable.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import et from '../../data/countries/ethiopia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../lib/figures';
import { countrySchema } from '../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: Africa's second-largest population, adding over 3 million a year, still mostly rural, heading for seventh in the world.
const PAGE = '/population/ethiopia/';
const un = countryData(et.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (et.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const africa = wpp.filter((d: any) => d.region === 'Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(africa[0] === 'NGA' && africa[1] === 'ETH', 'second in Africa after Nigeria');
const adders = wpp.slice().sort((a: any, b: any) => at(b).change - at(a).change).map((d: any) => d.iso3);
assertClaim(adders.indexOf('ETH') === 4 && c.change > 3.4e6, 'fifth-largest yearly addition in the world, over 3.4 million');
assertClaim(y[2050].worldRank === 7 && y[2100].worldRank === 7 && un.years.every((r) => r.year <= CURRENT_YEAR || r.change > 0), 'seventh in the world in 2050 and 2100; growth in every projected year');
const dbl = un.years.find((r) => r.population >= 2 * c.population)!.year;
assertClaim(dbl === 2066, 'double by 2066');
const urb = wpp.filter((d: any) => at(d).population > 10e6 && at(d).urbanPct != null).sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3);
assertClaim(urb.indexOf('ETH') === 5 && c.urbanPct! < 25, 'sixth-lowest urban share among countries over 10 million, under a quarter');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrMax.year === 1984 && below === 2075, 'fertility peak 1984; projected under 2.1 from 2075');
const perDeath = c.births / c.deaths;
assertClaim(perDeath > 5 && perDeath < 5.5, 'about five births per death');
const times = c.population / y[1950].population;
assertClaim(times > 7.8 && times < 7.9, 'almost eight times 1950');
assertClaim(y[1950].lifeExpectancy < 36 && c.lifeExpectancy > 68, 'life expectancy from about 35 to over 68');

assertClaim(adders.slice(0, 4).join(',') === 'IND,NGA,PAK,COD' && Math.abs(c.netMigrants) < c.change * 0.02, 'only India, Nigeria, Pakistan, DR Congo add more; migration small');
assertClaim(un.years.every((r) => r.change > 0), 'population larger every year, 1950–2100');
const title = `Ethiopia, Population ${(c.population / 1e6).toFixed(1)} Million: Africa's Runner-Up in ${CURRENT_YEAR} | AtlasFigures`;
const description = `Ethiopia gained about ${millions(c.change)} people in the year to mid-${CURRENT_YEAR}, reaching ${millions(c.population)}. Three in four live outside urban areas, and UN projections show ${millions(y[2050].population)} by 2050.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: et.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Added this year', value: int(c.change) },
  { label: 'Urban share', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, et.tableYears);

const faq = [
  { q: 'What is the population of Ethiopia today?', a: `A UN estimate for mid-${CURRENT_YEAR} puts it at ${millions(c.population)}; in Africa only Nigeria is bigger.` },
  { q: 'How many people are added to Ethiopia every year?', a: `About ${millions(c.change)} in ${CURRENT_YEAR}: some ${millions(c.births)} births minus ${int(Math.round(c.deaths / 1000))} thousand deaths, with little effect from migration. Only four countries add more people in a year.` },
  { q: 'Will Ethiopia be one of the biggest countries in the world?', a: `The medium projection lifts it to ${ord(y[2050].worldRank!)} by 2050, with ${millions(y[2050].population)}, and it is still growing in 2100 at ${millions(y[2100].population)}.` },
  { q: 'How many Ethiopians live in cities?', a: `${pct(c.urbanPct!)} by the national urban definition, among the six lowest shares for nations above ten million; a third of the population, ${pct(y[2050].urbanPct!)}, is projected to be urban by 2050.` },
  { q: 'Is Ethiopia\'s birth rate falling?', a: `Yes. Women averaged ${dec(tfrMax.fertility, 2)} children at the ${tfrMax.year} peak and ${dec(c.fertility, 2)} now. A rate under 2.1 is not projected before ${below}.` },
];

const schema = countrySchema({
  page: PAGE, slug: et.slug, name: et.name, wikipedia: et.wikipedia,
  headline: `Ethiopia's ${millions(c.population)}: Africa's second-largest population in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Ethiopia population, births, fertility, urban share and projections, 1950–2100',
  datasetDescription: `Mid-year population of Ethiopia for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: et.published, updated: et.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Ethiopia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Ethiopia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Ethiopia: Africa's second most populous country keeps growing</h1>
        <LiveCounter
          label="Ethiopia: estimated population this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} estimate, gaining around ${int(c.change / 365)} people daily`}
        />
        <p class="answer">
          Home to roughly <strong>{millions(c.population)}</strong> people by mid-{CURRENT_YEAR}, Ethiopia ranks {ord(c.worldRank!)} on Earth and trails only Nigeria within Africa. Each year brings about <strong>{millions(c.change)} more</strong>, while the urban share is just {pct(c.urbanPct!)}.
        </p>
        <div class="dates"><span>Updated <time datetime={et.updated}>{longDate(et.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Ethiopia" code="et" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How many people does Ethiopia add each year?</h2>
          <p>Around {millions(c.change)} in {CURRENT_YEAR}, more than any country except India, Nigeria, Pakistan and DR Congo. Births, about {millions(c.births)}, outnumber deaths by roughly five to one. Since 1950, when it had {millions(y[1950].population)}, Ethiopia has grown almost eightfold, and the medium projection doubles today's total by {dbl}.</p>
        </div>
        <LineChart
          title="Ethiopia, 1950–2100: a line that never turns down"
          subtitle="Ethiopia's mid-year count (UN); dashed values, still rising, reach 367 million in 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why do so few Ethiopians live in cities?</h2>
          <p>The UN figures show the level, not the reasons: Ethiopia's own definition classes {pct(c.urbanPct!)} of residents as urban, the sixth-lowest share among nations of more than ten million. That is up from {pct(y[1950].urbanPct!)} in 1950; the 2050 projection in World Urbanization Prospects is {pct(y[2050].urbanPct!)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Urban share in Ethiopia">
          <div><span class="y">1950</span><div class="v">{pct(y[1950].urbanPct!)}</div><span class="d">Urban share</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">One in four</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{pct(y[2050].urbanPct!)}</div><span class="d">One in three</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is Ethiopia's fertility rate coming down?</h2>
          <p>Steadily. The rate peaked at {dec(tfrMax.fertility, 2)} in {tfrMax.year} and has come down to {dec(c.fertility, 2)}; projections keep it above 2.1 until {below}. Ethiopia's median age is {dec(c.medianAge, 1)}.</p>
        </div>
        <LineChart
          title="How Ethiopian fertility has moved, 1950–2050"
          subtitle="Average births per woman (UN), the projected years dashed; 2.1 for reference."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'reference 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Where will Ethiopia rank in the world by 2050?</h2>
          <p>Seventh, with about {millions(y[2050].population)} people, in the UN's medium variant, up from {ord(c.worldRank!)} today; it holds that place in 2100 with {millions(y[2100].population)}, still growing. A newborn's life expectancy has meanwhile climbed from {dec(y[1950].lifeExpectancy, 1)} years (1950) to {dec(c.lifeExpectancy, 1)}.</p>
        </div>
        <RelatedPages iso3={et.iso3} name={et.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Ethiopian totals and rates by ten-year step"
          subtitle="Every row is bigger than the one before; projections begin with the 2030 line."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${et.slug}-population.csv`)}
          csvName={`${et.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common questions on Ethiopia's population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{et.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share, its projection to 2050 and comparisons with other countries.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={et.published}>{longDate(et.published)}</time> · Updated <time datetime={et.updated}>{longDate(et.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Ethiopia population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Ethiopia" code="et" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
