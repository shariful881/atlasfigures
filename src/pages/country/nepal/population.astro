---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import np from '../../../data/countries/nepal.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: emigration cancels most natural growth, two years of decline, fewer men than women, a 2067 peak.
const PAGE = '/country/nepal/population/';
const un = countryData(np.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (np.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const outRate = wpp.filter((d: any) => at(d).population > 1e6).sort((a: any, b: any) => at(a).netMigrants / at(a).population - at(b).netMigrants / at(b).population).map((d: any) => d.iso3);
assertClaim(outRate[0] === 'NPL', 'largest net outflow relative to population among countries over 1 million');
const cancel = -c.netMigrants / c.naturalChange;
assertClaim(cancel > 0.85 && cancel < 0.9 && c.change > 0, 'emigration cancels most (about 87%) of natural increase; still slight growth');
const est = un.years.filter((r) => !r.projection);
const falls = est.filter((r) => r.change < 0).map((r) => r.year);
assertClaim(falls.join(',') === '2022,2023', 'population fell in 2022 and 2023');
const outTop = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2023 && outTop.netMigrants < -400e3, 'largest net outflow in 2023, over 400 thousand');
assertClaim([2019, 2020, 2021].every((yr) => y[yr].netMigrants > 0) && un.years.filter((r) => r.year >= 2022).every((r) => r.netMigrants < 0), 'net inflow 2019–2021; net outflow every year since 2022 and in the projection');
const men = (c.male / c.female) * 100;
const men1950 = (y[1950].male / y[1950].female) * 100;
assertClaim(men < 91 && men > 90 && men1950 > 98 && men1950 < 100, 'about 91 men per 100 women, against 99 in 1950');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrMax.year === 1961 && below === 2019 && un.years.every((r) => r.year < 2019 || r.fertility < 2.1), 'fertility peak 1961; under 2.1 since 2019');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1995, 'births peaked in 1995');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2067 && natLoss === 2070, 'peak 2067, natural loss from 2070');
const south = wpp.filter((d: any) => d.subregion === 'Southern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(south.indexOf('NPL') === 5, 'sixth-largest in Southern Asia');

const title = `Nepal Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Held Back by Emigration | AtlasFigures`;
const description = `Nepal has ${millions(c.population)} people (UN, mid-${CURRENT_YEAR}). Departures cancel most of the natural increase, so growth is just ${pct(c.growthRatePct)}; the total even fell in 2022 and 2023.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: np.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Growth per year', value: `+${pct(c.growthRatePct)}` },
  { label: 'Net migration', value: int(c.netMigrants) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, np.tableYears);

const faq = [
  { q: "What is the latest UN figure for Nepal's population?", a: `Close to ${millions(c.population)} for mid-${CURRENT_YEAR}, ranking it ${ord(c.worldRank!)} worldwide and sixth in Southern Asia.` },
  { q: 'Why has Nepal\'s population almost stopped growing?', a: `Because more people leave than arrive. The natural surplus is roughly ${int(Math.round(c.naturalChange / 1000))} thousand this year, but net departures of about ${int(Math.round(-c.netMigrants / 1000))} thousand take away most of that gain.` },
  { q: 'What is Nepal\'s net migration?', a: `The UN publishes the net balance, not total departures: about ${int(Math.round(-c.netMigrants / 1000))} thousand more left than arrived in ${CURRENT_YEAR}, and the figure peaked at ${int(Math.round(-outTop.netMigrants / 1000))} thousand in ${outTop.year}.` },
  { q: 'Does Nepal have fewer men than women?', a: `Yes: the UN counts ${dec(men, 1)} males per 100 females in ${CURRENT_YEAR}. In 1950 the two were close to even, at ${dec(men1950, 1)}.` },
  { q: "When will Nepal's population be at its largest?", a: `About ${peak.year}, at a projected ${millions(peak.population)}; deaths start to outnumber births a few years later, in ${natLoss}.` },
];

const schema = countrySchema({
  page: PAGE, slug: np.slug, name: np.name, wikipedia: np.wikipedia,
  headline: `Nepal's ${millions(c.population)}: growth held back by emigration in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Nepal population, net migration, births, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Nepal for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: np.published, updated: np.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Nepal"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Nepal', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Nepal: births add people, departures take most of them away</h1>
        <LiveCounter
          label="Nepal: population estimate now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} anchor, plus roughly ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Nepal's mid-{CURRENT_YEAR} population is close to <strong>{millions(c.population)}</strong> ({ord(c.worldRank!)} globally), and growth is only <strong>{pct(c.growthRatePct)}</strong>, because net emigration cancels nearly nine-tenths of the natural increase.
        </p>
        <div class="dates"><span>Updated <time datetime={np.updated}>{longDate(np.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Nepal" code="np" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Nepal's population barely growing?</h2>
          <p>Emigration. In {CURRENT_YEAR} births run ahead of deaths by roughly {int(Math.round(c.naturalChange / 1000))} thousand, yet net departures of about {int(Math.round(-c.netMigrants / 1000))} thousand leave a gain of only {int(Math.round(c.change / 1000))} thousand. Measured against its size, no country above 1 million people loses more through net migration.</p>
        </div>
        <LineChart
          title="Nepal's population, 1950–2100: a flat patch in the 2020s"
          subtitle="Nepali population by UN mid-year count; the projected line tops out near 35.8 million around 2067."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Did Nepal's population fall in 2022 and 2023?</h2>
          <p>Yes, slightly, in the UN estimates. Those were the first years since 1950 with a decline. After three years of net inflow (2019 to 2021), the balance swung back to departures in 2022; {outTop.year} brought the largest net loss on record, about {int(Math.round(-outTop.netMigrants / 1000))} thousand. The UN's medium path keeps net migration negative in every year to 2100.</p>
        </div>

        <div class="story-block prose">
          <h2>Why does Nepal have more women than men?</h2>
          <p>The UN figures show the gap but not its causes: a ratio of {dec(men, 1)} males to 100 females in {CURRENT_YEAR}, compared with {dec(men1950, 1)} in 1950. The share is projected to move back towards balance, {dec((y[2100].male / y[2100].female) * 100, 1)} by 2100.</p>
        </div>
        <div class="age-row" role="group" aria-label="Males per 100 females in Nepal">
          <div><span class="y">1950</span><div class="v">{dec(men1950, 1)}</div><span class="d">Males per 100 females</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(men, 1)}</div><span class="d">Women outnumber men</span></div>
          <div><span class="y">2100, UN projection</span><div class="v">{dec((y[2100].male / y[2100].female) * 100, 1)}</div><span class="d">Closer to even</span></div>
        </div>

        <div class="story-block prose">
          <h2>How quickly has fertility fallen in Nepal?</h2>
          <p>Within one lifetime. Nepali women averaged {dec(tfrMax.fertility, 2)} children in {tfrMax.year}; the rate crossed below 2.1 in {below} and is {dec(c.fertility, 2)} now. Births topped out in {birthTop.year} at about {int(Math.round(birthTop.births / 1000))} thousand and are down to roughly {int(Math.round(c.births / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Nepali fertility, 1950–2050"
          subtitle="Births per Nepali woman, UN series; dashed years are projected, guide line at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 guide' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Nepal's population start to shrink?</h2>
          <p>Eventually. The medium variant has Nepal growing slowly to {millions(peak.population)} around {peak.year}, with natural decrease from {natLoss}, and ending the century at {millions(y[2100].population)}. Half of Nepalis are younger than {dec(c.medianAge, 1)} today; by 2100 the median is projected at {dec(y[2100].medianAge, 1)}. Nepal's own urban definition now covers {pct(c.urbanPct!)} of residents.</p>
        </div>
        <RelatedPages iso3={np.iso3} name={np.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Nepal in figures from 1950 to 2100"
          subtitle="Watch the net migration column: negative in most years, deeply so in the 2020s."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${np.slug}-population.csv`)}
          csvName={`${np.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Nepal's population: what people search for</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{np.unName}"): population, males and females, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={np.published}>{longDate(np.published)}</time> · Updated <time datetime={np.updated}>{longDate(np.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Nepal population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Nepal" code="np" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
