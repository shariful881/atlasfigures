---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import lao from '../../../data/countries/laos.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the most thinly settled country in South-Eastern
// Asia (1 million+); infant mortality down from 207 to under 30 per 1,000; life expectancy up from under 40; fertility from
// 6.38 in 1983 to 2.33, under 2.1 in 2035; net migration never positive; an urban majority from 2037; a peak in 2068.
const PAGE = '/country/laos/population/';
const un = countryData(lao.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (lao.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const sea1 = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia' && at(d).population >= 1e6);
assertClaim([...sea1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2)[0].iso3 === 'LAO', 'lowest density in South-Eastern Asia, 1M+');
assertClaim([...sea1].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000).slice(0, 3).map((d: any) => d.iso3).join() === 'TLS,MMR,LAO', 'third-highest infant mortality in SE Asia');
assertClaim(y[1950].infantMortalityPer1000! > 200 && c.infantMortalityPer1000! < 30, 'infant mortality above 200 in 1950, under 30 now');
assertClaim(y[1950].lifeExpectancy < 40 && c.lifeExpectancy > 69, 'life expectancy under 40 in 1950, over 69 now');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1983 && repl === 2035, 'fertility high 1983, under 2.1 in 2035');
assertClaim(un.years.every((r) => r.netMigrants <= 0), 'net migration never positive');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2004, 'largest net outflow 2004');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2037, 'urban majority 2037');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2068, 'peak 2068');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1993, 'births peak 1993');
const times = c.population / y[1950].population;
assertClaim(times > 4.6 && times < 4.8, 'about 4.7 times 1950');
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(sea.indexOf('LAO') === 7, 'eighth in South-Eastern Asia');

const title = `Laos Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Few People per km², Far Fewer Infant Deaths | AtlasFigures`;
const description = `Laos (UN listing: Lao People's Democratic Republic) counts ${millions(c.population)} in ${CURRENT_YEAR}: the sparsest population in South-Eastern Asia among countries over a million. Infant mortality has fallen from above 200 to ${dec(c.infantMortalityPer1000!, 1)} per 1,000.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: lao.capital },
    { label: 'UN listing', value: lao.unName },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, lao.tableYears);

const faq = [
  { q: 'Is Laos the least densely populated country in South-East Asia?', a: `It is, counting only countries there with over a million inhabitants: ${int(c.densityPerKm2)} per km².` },
  { q: 'Have infant deaths in Laos come down?', a: `Sharply. The 1950 estimate is ${dec(y[1950].infantMortalityPer1000!, 1)} per 1,000 births; today's is ${dec(c.infantMortalityPer1000!, 1)}, still third-highest in South-Eastern Asia after Timor-Leste and Myanmar.` },
  { q: 'How many babies does a Lao woman have on average now?', a: `${dec(c.fertility, 2)} this year. The ${tfrTop.year} peak was ${dec(tfrTop.fertility, 2)}; replacement level, 2.1, is passed in ${repl}.` },
  { q: 'Is net migration negative for Laos?', a: `It loses a few: net migration is never positive in the UN series, and the biggest yearly loss, ${int(-outTop.netMigrants)}, is estimated for ${outTop.year}.` },
  { q: 'When will most people in Laos live in towns?', a: `World Urbanization Prospects 2025 puts the urban majority in ${urbanHalf}; ${pct(c.urbanPct!)} live in towns now.` },
];

const schema = countrySchema({
  page: PAGE, slug: lao.slug, name: lao.name, wikipedia: lao.wikipedia,
  headline: `Laos's ${millions(c.population)}: the sparsest population in South-Eastern Asia, infant deaths cut from above 200 per 1,000; a ${peak.year} peak`,
  description,
  datasetName: 'Laos population, infant mortality and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Laos (UN listing: Lao People's Democratic Republic) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: lao.published, updated: lao.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Laos"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Laos", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Laos: room to spare and lives growing longer</h1>
        <LiveCounter
          label="Laos: population estimate for this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 (mid-${CURRENT_YEAR}) as the base, with about ${int(c.change / 365)} added each day`}
        />
        <p class="answer">
          The UN reckons Laos's {CURRENT_YEAR} total at roughly <strong>{millions(c.population)}</strong>, close to five times the 1950 count. With <strong>{int(c.densityPerKm2)}</strong> people to a km², it is still the most thinly settled country in South-Eastern Asia among those above a million.
        </p>
        <div class="dates"><span>Updated <time datetime={lao.updated}>{longDate(lao.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Laos" code="la" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much has child survival improved in Laos?</h2>
          <p>Enormously. UN figures put infant deaths at {dec(y[1950].infantMortalityPer1000!, 1)} for every 1,000 births in 1950, {dec(y[1990].infantMortalityPer1000!, 1)} in 1990 and {dec(c.infantMortalityPer1000!, 1)} in {CURRENT_YEAR}. Lifespans grew too, from {dec(y[1950].lifeExpectancy, 1)} to {dec(c.lifeExpectancy, 1)} years. Only Timor-Leste and Myanmar in the subregion still lose more infants.</p>
        </div>
        <LineChart
          title="Laos: life expectancy at birth since 1950"
          subtitle="Estimated values to 2023, projected values (dashed) to 2050."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Lao fertility close to replacement level?</h2>
          <p>Getting close. The rate stood at {dec(tfrTop.fertility, 2)} in {tfrTop.year}, {dec(y[2000].fertility, 2)} in 2000 and {dec(c.fertility, 2)} at present; on the medium path it slips under 2.1 in {repl}. Births topped out in {birthTop.year}; {CURRENT_YEAR} is expected to bring {int(c.births)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Does Laos ever gain from migration?</h2>
          <p>Never, in the UN series: from 1950 onward the net balance stays at zero or below. The biggest net loss, {int(-outTop.netMigrants)}, falls in {outTop.year}; this year's is {int(-c.netMigrants)}.</p>
        </div>

        <div class="story-block prose">
          <h2>In what year does Laos stop growing?</h2>
          <p>{peak.year}, with {millions(peak.population)}, after which the projection slips back, leaving {millions(y[2100].population)} in 2100. Townspeople, {pct(c.urbanPct!)} of the total now, become the majority in {urbanHalf}. Laos is eighth among South-Eastern Asian countries by population.</p>
        </div>
        <RelatedPages iso3={lao.iso3} name={lao.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Laos at a glance by decade, with 1983 and 1993"
          subtitle="Infant mortality and fertility both fall steeply across these rows."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${lao.slug}-population.csv`)}
          csvName={`${lao.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Laos: questions people ask</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{lao.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={lao.published}>{longDate(lao.published)}</time> · Updated <time datetime={lao.updated}>{longDate(lao.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Laos population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Laos" code="la" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
