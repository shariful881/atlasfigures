---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import pan from '../../../data/countries/panama.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fertility crossing under 2.1 in 2025; men and
// women almost exactly balanced (105 per 100 in 1950); life expectancy second in Central America; urban majority since
// 1981; about 5.4 times 1950; births peak 2015; growth to a 2080 peak.
const PAGE = '/country/panama/population/';
const un = countryData(pan.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (pan.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2025 && y[2024].fertility > 2.1, 'fertility under 2.1 first in 2025');
const sr = (c.male / c.female) * 100;
assertClaim(sr > 99.9 && sr < 100.1 && (y[1950].male / y[1950].female) * 100 > 104.5, 'balanced now, about 105 in 1950');
const cam1 = wpp.filter((d: any) => d.subregion === 'Central America' && at(d).population >= 1e6);
assertClaim([...cam1].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy).slice(0, 2).map((d: any) => d.iso3).join() === 'CRI,PAN', 'second-longest life expectancy after Costa Rica');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1981, 'urban majority 1981');
const since = c.population / y[1950].population;
assertClaim(since > 5.3 && since < 5.5, 'about 5.4 times 1950');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(birthTop.year === 2015 && peak.year === 2080, 'births peak 2015, population peak 2080');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1962, 'fertility high 1962');

const title = `Panama Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Just Under Replacement Fertility, an Even Sex Ratio | AtlasFigures`;
const description = `Panama, ${CURRENT_YEAR}: ${millions(c.population)} by UN estimate. Its fertility dipped under 2.1 in 2025, the first such year; men and women are now nearly equal in number; and growth runs until ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: pan.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, pan.tableYears);

const faq = [
  { q: 'Has Panamanian fertility fallen below replacement?', a: `Just: ${dec(y[2024].fertility, 2)} in 2024, then ${dec(y[2025].fertility, 2)} in 2025, the first sub-2.1 year; ${dec(c.fertility, 2)} for ${CURRENT_YEAR}.` },
  { q: 'Are Panamanian men and women equal in number?', a: `Practically: ${dec((c.male / c.female) * 100, 1)} men to 100 women, compared with ${dec((y[1950].male / y[1950].female) * 100, 1)} in 1950.` },
  { q: 'Which Central American country besides Costa Rica has the longest lives?', a: `Panama, at ${dec(c.lifeExpectancy, 1)} years, second only to Costa Rica.` },
  { q: 'When did Panama become mostly urban?', a: `In ${urbanHalf}; ${pct(c.urbanPct!)} of Panamanians are urban now.` },
  { q: 'What is the peak year for Panama?', a: `${peak.year}; the medium-variant high is ${millions(peak.population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: pan.slug, name: pan.name, wikipedia: pan.wikipedia,
  headline: `Panama's ${millions(c.population)}: fertility below 2.1 from 2025; a balanced sex ratio; growth to ${peak.year}`,
  description,
  datasetName: 'Panama population, fertility and sex ratio, 1950–2100',
  datasetDescription: `Mid-year population of Panama for selected years from 1950 to ${CURRENT_YEAR}, including 1962, 1981, 2015 and 2024–2026, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: pan.published, updated: pan.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Panama"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Panama", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Panama: crossing below replacement fertility</h1>
        <LiveCounter
          label="Panama: real-time population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Uses the mid-${CURRENT_YEAR} UN World Population Prospects 2024 estimate; about ${int(c.change / 365)} added daily`}
        />
        <p class="answer">
          In {CURRENT_YEAR} Panama counts <strong>{millions(c.population)}</strong> people, 5.4 times its 1950 total by UN reckoning. Its fertility, <strong>{dec(c.fertility, 2)}</strong>, has only just slipped under 2.1.
        </p>
        <div class="dates"><span>Updated <time datetime={pan.updated}>{longDate(pan.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Panama" code="pa" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>When did Panama fall below replacement fertility?</h2>
          <p>In 2025, on UN figures: {dec(y[2024].fertility, 2)} in 2024, {dec(y[2025].fertility, 2)} in 2025, {dec(c.fertility, 2)} now. The {tfrTop.year} rate was {dec(tfrTop.fertility, 2)}. Yearly births topped out in {birthTop.year} with {int(birthTop.births)}; {int(c.births)} are expected this year.</p>
        </div>
        <LineChart
          title="Panamanian fertility since 1950, just crossing 2.1"
          subtitle="Children per woman; the UN medium variant takes over after 2023."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'threshold 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Panama's population evenly split between the sexes?</h2>
          <p>Almost perfectly: the UN ratio is {dec((c.male / c.female) * 100, 1)} (men to 100 women) this year, down from {dec((y[1950].male / y[1950].female) * 100, 1)} in 1950.</p>
        </div>

        <div class="story-block prose">
          <h2>How long do Panamanians live, and where?</h2>
          <p>Life expectancy is {dec(c.lifeExpectancy, 1)} years, second in Central America after Costa Rica. Since {urbanHalf} the urban share has exceeded half; it is {pct(c.urbanPct!)} today.</p>
        </div>

        <div class="story-block prose">
          <h2>What ceiling does Panama's population hit?</h2>
          <p>{millions(peak.population)}, the medium-variant figure for {peak.year}; by 2100 Panama is at {millions(y[2100].population)}.</p>
        </div>
        <RelatedPages iso3={pan.iso3} name={pan.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Panama, 1950 to 2100 with 2024–2026 shown yearly"
          subtitle="Fertility goes under 2.1 in the 2025 row."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${pan.slug}-population.csv`)}
          csvName={`${pan.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Panama: quick answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{pan.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={pan.published}>{longDate(pan.published)}</time> · Updated <time datetime={pan.updated}>{longDate(pan.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Panama population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Panama" code="pa" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
