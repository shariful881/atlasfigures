---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/ukraine.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/ukraine/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const remPeak = s.remittances.reduce((a, b) => (b[1] > a[1] ? b : a));
const remRank = rankBy('remittances', L).find((r) => r.iso3 === c.iso3)!.rank;
const uLast = s.unemploymentPct.at(-1)!;
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const decade = [1990, 1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999];
const lowGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x < growth).map(([y]) => y));

assertClaim(worst[0] === 2022 && worst[1] < -28 && s.gdpGrowthPct[0][0] === 1988, '2022 worst year since 1988');
assertClaim(isMax(s.gdp) && gdp > v('gdp', 2021)! && B.gdpRank === 56, 'record dollar GDP, above 2021; 56th');
assertClaim([2023, 2024, L].every((y) => g(y) > 0) && lowGrowSince === 2022, 'growth since 2023, slowest since 2022');
assertClaim(infl.year === L && i(2024) < infl.value && i(2022) > 20 && iMax[0] === 1993 && iMax[1] > 4000, 'inflation up again; 2022 above 20%; 1993 peak');
assertClaim(remPeak[0] === 2021 && rem!.value < 0.6 * remPeak[1] && remRank === 25, 'remittances well below 2021; 25th');
assertClaim((1 + g(2022) / 100) * (1 + g(2023) / 100) * (1 + g(2024) / 100) * (1 + growth / 100) < 1, 'growth since 2023 smaller than the 2022 loss');
assertClaim(uLast[0] === 2021 && unemp == null, 'unemployment series ends 2021');
assertClaim(decade.every((y) => g(y) < 0), 'output fell every year 1990-99');

const title = `Ukraine Economy ${L}: Output After the 2022 Collapse | AtlasFigures`;
const description = `Growth of ${pct(growth)} in ${L} marked Ukraine\'s third year of recovery after the ${pct(Math.abs(worst[1]))} fall of 2022. In dollars output reached ${usd(gdp)}; inflation picked up to ${pct(infl.value)}.`;

const faq = [
  { q: 'How deep was Ukraine\'s 2022 contraction?', a: `Real output dropped ${pct(Math.abs(worst[1]))}, the largest annual fall on the World Bank\'s Ukrainian record, which opens in 1988.` },
  { q: 'Is Ukraine\'s output back to its pre-2022 level?', a: `Not yet. Growth was ${pct(g(2023))} in 2023, ${pct(g(2024))} in 2024 and ${pct(growth)} in ${L}. Those gains add up to less than the 2022 loss.` },
  { q: 'Why is Ukraine\'s dollar GDP a record?', a: `At ${usd(gdp)} in ${L} it is above the ${usd(v('gdp', 2021)!)} of 2021. A dollar figure mixes volume with prices and the hryvnia rate; in volume, output is still below 2021.` },
  { q: 'Is there a current jobless rate for Ukraine?', a: `No. The ILO-modelled series in the World Bank files stops in 2021, at ${pct(uLast[1])}.` },
  { q: 'Have remittances to Ukraine fallen?', a: `Yes. The 2021 peak was ${usd(remPeak[1])}; the ${L} figure, ${usd(rem!.value)}, still ranks ${ord(remRank)} by value.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Ukraine's economy ${L}: a third year of growth after 2022's record fall, and inflation rising again`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Ukrainian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Ukraine', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Ukraine's economy: rebuilding after 2022</h1>
        <p class="answer">
          Real output in Ukraine rose <strong>{pct(growth)}</strong> in {L}, a third year of growth after the <strong>{pct(Math.abs(worst[1]))}</strong> collapse in 2022. Output in current dollars was {usd(gdp)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Ukraine economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Ukraine" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Ukraine's 2022 contraction was the largest in its World Bank record; three years of growth have not yet made it up.</p>

        <div class="story-block prose">
          <h2>How far did Ukraine's output fall in 2022?</h2>
          <p>By {pct(Math.abs(worst[1]))}, the deepest one-year drop in Ukraine's World Bank record, which begins in 1988. Growth has resumed since: {pct(g(2023))}, {pct(g(2024))} and {pct(growth)} in {L}, the slowest of the three.</p>
        </div>
        <LineChart
          title={`Ukraine's real growth, 1988–${L}`}
          subtitle="Annual change in GDP volume, %; 2022 is the deepest fall."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Ukraine's economy back to pre-2022 levels?</h2>
          <p>Not in volume: the three years of growth since 2023 add up to less than the 2022 loss. In current dollars, though, {L} output of {usd(gdp)} stood above 2021's {usd(v('gdp', 2021)!)} and {ord(B.gdpRank!)} globally — a total that moves with prices and the hryvnia's exchange rate.</p>
        </div>
        <div class="story-block prose">
          <h2>Did Ukrainian inflation pick up again?</h2>
          <p>It picked up to {pct(infl.value)} in {L} from {pct(i(2024))} in 2024; in 2022 it was {pct(i(2022))}. The record, over 4,000%, came in 1993, during a decade in which output shrank every year from 1990 to 1999.</p>
        </div>
        <div class="story-block prose">
          <h2>What about jobs and remittances?</h2>
          <p>The World Bank's ILO-modelled unemployment series stops at 2021 ({pct(uLast[1])}). Remittance receipts stood at {usd(rem!.value)} for {L} ({ord(remRank)} by value), well under the {usd(remPeak[1])} received in 2021.</p>
        </div>
        <LineChart
          title={`Ukraine's remittance inflows, 1996–${L}`}
          subtitle="Remittance inflows in US$; the top year is 2021."
          points={s.remittances.filter(([y]) => y >= 1996).map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <nav class="related" aria-label="Related pages">
          <h2>Ukraine and its region: further pages</h2>
          <ul>
            <li><a href={path('/country/ukraine/population/')}>Ukraine's population</a></li>
            <li><a href={path('/country/poland/economy/')}>Poland's economy</a></li>
            <li><a href={path('/country/russia/economy/')}>Russia's economy</a></li>
            <li><a href={path('/country/turkey/economy/')}>Turkey's economy</a></li>
            <li><a href={path('/rankings/remittances-by-country/')}>Remittances, every country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Ukraine's economy in selected years, 1990 to ${L}`}
          subtitle="1993–95, 2009 and 2014–15, then 2019 up to the latest year; download the CSV for all."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/ukraine-economy.csv')} csvName="ukraine-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Ukraine's economy: key questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank's GDP series for Ukraine starts in 1987 and its unemployment series ends in 2021. Neutral note: figures are as published by the World Bank for Ukraine as a whole. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Ukrainian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Ukraine" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
