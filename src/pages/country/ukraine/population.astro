---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ua from '../../../data/countries/ukraine.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a quarter below the 1993 high, the largest
// single-year net outflow in the UN series, record-low fertility, and figures that rest on a 2001 census (UNFPA).
// Neutral wording: the page reports the UN's numbers and does not state causes the data do not show.
const PAGE = '/country/ukraine/population/';
const un = countryData(ua.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ua.verification as any).checkedOn as string | undefined;
const UNFPA_URL = 'https://eeca.unfpa.org/en/news/ukraines-demographic-challenges-deepen-amidst-ongoing-war';

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => !r.projection);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const fallPct = (1 - c.population / peak.population) * 100;
assertClaim(peak.year === 1993 && fallPct > 23 && fallPct < 27, 'peak 1993; about a quarter lower now');
const lastGain = un.years.filter((r) => r.naturalChange >= 0).at(-1)!.year;
assertClaim(lastGain === 1990, 'deaths above births every year since 1991');
const natRate = (d: any) => at(d).naturalChange / at(d).population;
const steep = wpp.filter((d: any) => at(d) && at(d).population > 5e6).sort((a: any, b: any) => natRate(a) - natRate(b));
assertClaim(steep[0].iso3 === 'UKR', 'steepest natural decrease relative to size among countries above five million');
const allOut = wpp.flatMap((d: any) => d.years.filter((r: any) => !r.projection).map((r: any) => ({ iso: d.iso3, year: r.year, v: r.netMigrants })));
const worst = allOut.reduce((a: any, b: any) => (b.v < a.v ? b : a));
assertClaim(worst.iso === 'UKR' && worst.year === 2022, 'largest single-year net outflow of any country in the UN series');
assertClaim(y[2024].netMigrants > 1e6 && y[2025].netMigrants > 1.5e6 && y[2023].netMigrants < 0 && c.netMigrants < 0, 'net inflows in 2024 and 2025, outflows in 2023 and 2026');
const europe = wpp.filter((d: any) => d.region === 'Europe');
const tfrLow = un.years.reduce((a, b) => (b.fertility < a.fertility ? b : a));
const eur22 = europe.filter((d: any) => at(d, 2022)).sort((a: any, b: any) => at(a, 2022).fertility - at(b, 2022).fertility);
assertClaim(tfrLow.year === 2022 && eur22[0].iso3 === 'UKR', 'fertility low of 2022, lowest in Europe that year');
const below = un.years.filter((r) => r.fertility >= 2.1).at(-1)!.year + 1;
assertClaim(below === 1987, 'under 2.1 every year since 1987');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1960 && c.births < birthTop.births / 3, 'births now under a third of the 1960 peak');
const east = wpp.filter((d: any) => d.subregion === 'Eastern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(east[0] === 'RUS' && east[1] === 'UKR', 'second in Eastern Europe after Russia');
const pol = wpp.find((d: any) => d.iso3 === 'POL');
const polAhead = un.years.filter((r) => r.year > CURRENT_YEAR && at(pol, r.year).population > r.population)[0].year;
assertClaim(at(pol, 2023).population > y[2023].population && at(pol, 2024).population > y[2024].population && at(pol, 2022).population < y[2022].population && at(pol, 2025).population < y[2025].population, 'Poland briefly larger in 2023 and 2024');
assertClaim(polAhead === 2042 && un.years.filter((r) => r.year >= 2042).every((r) => at(pol, r.year).population > r.population), 'Poland larger from 2042 on');

const title = `Ukraine Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, a Quarter Below the 1993 High | AtlasFigures`;
const description = `Ukraine's mid-${CURRENT_YEAR} population estimate, ${millions(c.population)}, is far below the ${millions(peak.population)} the UN records for ${peak.year}. Migration swings since 2022, fertility near one child per woman, and why the figures are uncertain.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ua.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: `Peak (${peak.year})`, value: millionsShort(peak.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, ua.tableYears);

const faq = [
  { q: "What population does the UN give for Ukraine?", a: `${millions(c.population)} for the middle of ${CURRENT_YEAR}; worldwide it is ${ord(c.worldRank!)}, and in Eastern Europe only Russia is larger. It is a model estimate, not a count.` },
  { q: 'In which year did Ukraine have the most people?', a: `${peak.year}, with ${millions(peak.population)} in the UN series. The ${CURRENT_YEAR} estimate is about a quarter lower.` },
  { q: 'When was the last census in Ukraine?', a: `In 2001, according to UNFPA, which calls a new census crucial once security allows. Later figures, including the UN's, are estimates.` },
  { q: 'Is fertility in Ukraine really about one child per woman?', a: `Yes: ${dec(c.fertility, 2)} in ${CURRENT_YEAR}. The UN's lowest value, ${dec(tfrLow.fertility, 2)} in ${tfrLow.year}, was the lowest in Europe that year.` },
  { q: 'Will Poland have more people than Ukraine?', a: `In the medium projection, from ${polAhead} onward. Poland was briefly larger in the UN estimates for 2023 and 2024 as well.` },
];

const schema = countrySchema({
  page: PAGE, slug: ua.slug, name: ua.name, wikipedia: ua.wikipedia,
  headline: `Ukraine's ${millions(c.population)}: decline since ${peak.year}, migration since 2022 and very low fertility`,
  description,
  datasetName: 'Ukraine population, net migration, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Ukraine for selected years from 1950 to ${CURRENT_YEAR} (every year from 2020), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ua.published, updated: ua.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: "Ukraine's demographic challenges deepen amidst ongoing war", url: UNFPA_URL, publisher: 'UNFPA Eastern Europe and Central Asia' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Ukraine"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Ukraine', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Ukraine: a population a quarter smaller than in {peak.year}</h1>
        <LiveCounter
          label="Ukraine: modelled population today"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} estimate, falling by roughly ${int(Math.abs(c.change) / 365)} a day`}
        />
        <p class="answer">
          For mid-{CURRENT_YEAR}, the UN's figure for Ukraine is <strong>{millions(c.population)}</strong> ({ord(c.worldRank!)} globally), with about <strong>a quarter fewer people</strong> than at the {peak.year} peak ({millions(peak.population)}). Treat recent years with care: the last census was in 2001.
        </p>
        <div class="dates"><span>Updated <time datetime={ua.updated}>{longDate(ua.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Ukraine" code="ua" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much has Ukraine's population fallen since {peak.year}?</h2>
          <p>By about a quarter from its {peak.year} maximum. Deaths have exceeded births each year from {lastGain + 1} onward, and in {CURRENT_YEAR} the gap is about {int(Math.round(-c.naturalChange / 1000))} thousand: relative to population size, the steepest natural decrease of any country above five million people.</p>
        </div>
        <LineChart
          title={`Ukraine's population curve, 1950–2100: up to ${peak.year}, down ever since`}
          subtitle="Mid-year UN numbers with the projection dashed; the sharp 2022 drop is in the estimates themselves."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What does the UN record for Ukraine's migration since 2022?</h2>
          <p>Large swings in both directions. For 2022 the UN series has a net outflow of about {millions(-y[2022].netMigrants)}, the largest single-year net loss for any country since 1950. Net inflows followed in 2024 (about {millions(y[2024].netMigrants)}) and 2025 (about {millions(y[2025].netMigrants)}). For {CURRENT_YEAR} the estimate is close to balance, a net loss of about {int(Math.round(-c.netMigrants / 1000))} thousand. The figures count movements; they do not describe who moved or why.</p>
        </div>
        <div class="age-row" role="group" aria-label="Net migration in Ukraine, UN estimates">
          <div><span class="y">2022</span><div class="v">−{(-y[2022].netMigrants / 1e6).toFixed(1)}M</div><span class="d">Net outflow</span></div>
          <div><span class="y">2024</span><div class="v">+{(y[2024].netMigrants / 1e6).toFixed(1)}M</div><span class="d">Net inflow</span></div>
          <div><span class="y">2025</span><div class="v">+{(y[2025].netMigrants / 1e6).toFixed(1)}M</div><span class="d">Net inflow</span></div>
        </div>

        <div class="story-block prose">
          <h2>How reliable are Ukraine's population figures today?</h2>
          <p>They rest on old data. Ukraine's last census was in 2001, and UNFPA describes a new one, once security allows, as crucial for planning (<a href={UNFPA_URL}>UNFPA, October 2024</a>). Every figure for the years after 2001 on this page is therefore a UN estimate, not a count.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Ukraine's fertility the lowest in Europe?</h2>
          <p>Yes, in 2022: the UN's figure for that year is {dec(tfrLow.fertility, 2)} children per woman. The {CURRENT_YEAR} estimate is {dec(c.fertility, 2)}, and the rate has stayed below 2.1 from {below} on. About {int(Math.round(c.births / 1000))} thousand babies are expected this year, under a third of the roughly {int(Math.round(birthTop.births / 1000))} thousand born in {birthTop.year}.</p>
        </div>
        <LineChart
          title="Ukrainian fertility, 1950–2050: down to about one child"
          subtitle="UN-estimated children per woman (projection dashed) with the 2.1 level marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How small could Ukraine become by 2100?</h2>
          <p>Roughly {millions(y[2100].population)} under UN medium assumptions, which would rank it {ord(y[2100].worldRank!)} worldwide, with {millions(y[2050].population)} projected for 2050. Ukraine stays second in Eastern Europe for now, but Poland is projected to pass it again in {polAhead}. Half of the population is now over {dec(c.medianAge, 1)}, a midpoint the UN puts at {dec(y[2100].medianAge, 1)} for 2100.</p>
        </div>
        <RelatedPages iso3={ua.iso3} name={ua.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Ukraine year by year, with every year since 2020"
          subtitle={`The ${peak.year} row is the UN's all-time high; 2022 shows the steepest fall.`}
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ua.slug}-population.csv`)}
          csvName={`${ua.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Short answers about Ukraine's population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ua.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={UNFPA_URL}>UNFPA Eastern Europe and Central Asia, "Ukraine's demographic challenges deepen amidst ongoing war"</a> (22 October 2024): date of the last census and the need for a new one.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ua.published}>{longDate(ua.published)}</time> · Updated <time datetime={ua.updated}>{longDate(ua.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Ukraine population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Ukraine" code="ua" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
