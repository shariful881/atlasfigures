---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import my from '../../../data/countries/malaysia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: still growing, migration turned from outflow to inflow around 1980, rapid urbanisation, a peak in the 2070s.
const PAGE = '/country/malaysia/population/';
const un = countryData(my.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (my.verification as any).checkedOn as string | undefined;

const migShare = (c.netMigrants / c.change) * 100;
assertClaim(migShare > 38 && migShare < 42, 'about two-fifths of growth from net migration');
const outYears = un.years.filter((r) => r.netMigrants < 0).map((r) => r.year);
assertClaim(outYears[0] === 1952 && outYears[outYears.length - 1] === 1979 && outYears.length === 28, 'net outflow every year 1952–1979, inflow in every year since');
const est = un.years.filter((r) => !r.projection);
const migTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(migTop.year === 2006, 'largest net inflow in 2006');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2072 && natLoss === 2060, 'deaths above births from 2060, peak 2072');
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1996, 'births peaked in 1996');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrMax.year === 1957 && below === 2013 && un.years.every((r) => r.year < 2013 || r.fertility < 2.1), 'fertility peak 1957; under 2.1 since 2013');
assertClaim(y[1950].urbanPct! < 21 && c.urbanPct! > 77, 'urban share from about a fifth to over three-quarters');
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(sea.indexOf('MYS') === 5, 'sixth-largest in South-Eastern Asia');
const men = (c.male / c.female) * 100;
assertClaim(men > 109 && men < 110, 'about 109 men per 100 women');
assertClaim(y[2100].population < peak.population && y[2100].population > c.population, '2100 below the peak but above today');

assertClaim(c.population / y[1950].population > 5.8 && c.population / y[1950].population < 6.2, 'roughly sixfold since 1950');
assertClaim(un.years.filter((r) => r.year >= natLoss && r.year <= peak.year).every((r) => r.netMigrants > 0), 'migration positive between natural loss and peak');
assertClaim(y[2050].urbanPct! > 90 && y[2050].urbanPct! < 92, 'about nine in ten urban by 2050');
const title = `Malaysia, ${CURRENT_YEAR}: Population ${(c.population / 1e6).toFixed(1)} Million, Growing Into the 2070s | AtlasFigures`;
const description = `Malaysia's population is ${millions(c.population)} at mid-${CURRENT_YEAR}, rising ${pct(c.growthRatePct)} a year with migration supplying about two-fifths of the gain. UN projections peak at ${millions(peak.population)} in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: my.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Urban share', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, my.tableYears);

const faq = [
  { q: "What is Malaysia's population at the moment?", a: `Roughly ${millions(c.population)}, UN data for mid-${CURRENT_YEAR} show. That is ${ord(c.worldRank!)} in the world and sixth in South-Eastern Asia.` },
  { q: 'Will Malaysia keep adding people?', a: `Yes, by about ${int(Math.round(c.change / 1000))} thousand people (${pct(c.growthRatePct)}) in ${CURRENT_YEAR}. The UN medium variant has growth continuing until ${peak.year}.` },
  { q: 'What share of Malaysia\'s growth comes from migration?', a: `Net migration accounts for about ${int(Math.round(c.netMigrants / 1000))} thousand of this year's increase, roughly ${int(Math.round(migShare))}%. The UN figures give net totals only, not a breakdown of who the migrants are.` },
  { q: 'When did Malaysia start gaining people through migration?', a: `In 1980. From 1952 to 1979 the UN records a net outflow every year; since then arrivals have exceeded departures, most of all in ${migTop.year}.` },
  { q: 'How urban is Malaysia today?', a: `${pct(c.urbanPct!)} of Malaysians are urban residents under the national definition; in 1950 the share was ${pct(y[1950].urbanPct!)}. The UN's urbanization figures project ${pct(y[2050].urbanPct!)} by 2050.` },
];

const schema = countrySchema({
  page: PAGE, slug: my.slug, name: my.name, wikipedia: my.wikipedia,
  headline: `Malaysia at ${millions(c.population)}: still growing, with a peak in ${peak.year}`,
  description,
  datasetName: 'Malaysia population, migration, urbanization, fertility and ageing, 1950–2100',
  datasetDescription: `Mid-year population of Malaysia for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: my.published, updated: my.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Malaysia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Malaysia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Malaysia's population is still on the rise</h1>
        <LiveCounter
          label="Malaysia: population estimate at this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} base, increasing by roughly ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Malaysia has close to <strong>{millions(c.population)}</strong> inhabitants in mid-{CURRENT_YEAR} and ranks {ord(c.worldRank!)} globally; it adds about {int(Math.round(c.change / 1000))} thousand a year. Roughly <strong>two-fifths of that growth is net migration</strong>, and the UN does not expect the total to peak until {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={my.updated}>{longDate(my.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Malaysia" code="my" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How quickly is Malaysia's population growing?</h2>
          <p>At {pct(c.growthRatePct)} in {CURRENT_YEAR}, or around {int(Math.round(c.change / 1000))} thousand people. About {int(Math.round(c.naturalChange / 1000))} thousand of that comes from births outnumbering deaths and about {int(Math.round(c.netMigrants / 1000))} thousand from migration. Malaysia is now roughly six times its 1950 size of {millions(y[1950].population)}.</p>
        </div>
        <LineChart
          title="Malaysia's population, 1950–2100: rising into the 2070s"
          subtitle="UN mid-year population; the dashed projection crests at 46.4 million and dips slightly."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Malaysia always gained people through migration?</h2>
          <p>No. The UN series shows more people leaving than arriving in every year from 1952 to 1979. The balance turned in 1980 and has been positive ever since, with the largest net inflow, about {int(Math.round(migTop.netMigrants / 1000))} thousand, in {migTop.year}. Men outnumber women at {dec(men, 1)} per 100; the data do not show whether migration explains it.</p>
        </div>

        <div class="story-block prose">
          <h2>How has the number of births in Malaysia changed?</h2>
          <p>Births reached their high point in {birthTop.year}, at about {int(Math.round(birthTop.births / 1000))} thousand, and are around {int(Math.round(c.births / 1000))} thousand in {CURRENT_YEAR}. The fertility rate, {dec(tfrMax.fertility, 2)} in {tfrMax.year}, slipped under 2.1 in {below} and is {dec(c.fertility, 2)} now.</p>
        </div>
        <LineChart
          title="Births per Malaysian woman, 1950–2050"
          subtitle="UN fertility series; the projected years are dashed. Reference line: 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 mark' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How fast has Malaysia urbanized?</h2>
          <p>Dramatically. Around one Malaysian in five lived in an urban area in 1950 ({pct(y[1950].urbanPct!)}); now it is {pct(c.urbanPct!)}, under the national definition, and World Urbanization Prospects projects {pct(y[2050].urbanPct!)} by 2050.</p>
        </div>
        <div class="age-row" role="group" aria-label="Urban share in Malaysia">
          <div><span class="y">1950</span><div class="v">{pct(y[1950].urbanPct!)}</div><span class="d">Urban</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">Three in four</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{pct(y[2050].urbanPct!)}</div><span class="d">Nine in ten</span></div>
        </div>

        <div class="story-block prose">
          <h2>How long will Malaysia keep growing?</h2>
          <p>Until around {peak.year}, when the UN's medium path tops out at {millions(peak.population)}. Deaths are expected to exceed births from {natLoss}; continuing migration delays the turning point by about a decade. The 2100 figure, {millions(y[2100].population)}, is only slightly below the peak. Meanwhile the median age climbs from {dec(c.medianAge, 1)} to {dec(y[2050].medianAge, 1)} in 2050.</p>
        </div>
        <RelatedPages iso3={my.iso3} name={my.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Malaysian population figures by decade, 1950–2100"
          subtitle="Estimates to 2026 and the UN's medium projection beyond, including net migration."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${my.slug}-population.csv`)}
          csvName={`${my.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Malaysia's population, question by question</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{my.unName}"): population, males and females, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and its projection to 2050.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={my.published}>{longDate(my.published)}</time> · Updated <time datetime={my.updated}>{longDate(my.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Malaysia population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Malaysia" code="my" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
