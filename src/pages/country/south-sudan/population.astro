---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ssd from '../../../data/countries/south-sudan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: two stretches in which the
// mid-year estimate falls (1988–1989 and 2015–2018), the 1988 life-expectancy low, net departures 2014–2017 and the
// 2023 inflow; the largest life-expectancy gain anywhere from 1990 to 2010; a young, still-growing population to 2100.
// The UN files give no causes, and the page says so.
const PAGE = '/country/south-sudan/population/';
const un = countryData(ssd.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ssd.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const falls = est.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1988,1989,2015,2016,2017,2018', 'mid-year estimate falls in 1988–1989 and 2015–2018');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1988 && leLow.lifeExpectancy < 12, 'life expectancy low 1988, about 11');
assertClaim([...wpp].sort((a: any, b: any) => at(a, 1988).lifeExpectancy - at(b, 1988).lifeExpectancy)[0].iso3 === 'SSD', 'lowest life expectancy in the world in 1988');
const imrTop = un.years.reduce((a, b) => (b.infantMortalityPer1000! > a.infantMortalityPer1000! ? b : a));
assertClaim(imrTop.year === 1988 && imrTop.infantMortalityPer1000! > 400, 'infant mortality above 400 in 1988');
assertClaim(y[1988].deaths > 2 * y[1989].deaths, '1988 deaths more than twice 1989');
const outYears = [2014, 2015, 2016, 2017];
assertClaim(outYears.every((n) => y[n].netMigrants < 0), 'net departures each year 2014–2017');
const outSum = -outYears.reduce((s, n) => s + y[n].netMigrants, 0);
assertClaim(outSum > 1.9e6 && outSum < 2e6, 'net departures 2014–2017 just under 2 million');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 2017 && inTop.year === 2023, 'largest outflow 2017, largest inflow 2023');
const pre = y[2014].population;
const back = un.years.find((r) => r.year > 2014 && r.population > pre)!.year;
assertClaim(back === 2023, '2014 total passed again in 2023');
const leRank = [...wpp].sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(leRank.slice(0, 3).join() === 'NGA,TCD,SSD', 'third-lowest life expectancy, after Nigeria and Chad');
assertClaim([...wpp].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000).map((d: any) => d.iso3).indexOf('SSD') === 5, 'sixth-highest infant mortality');
const gain = (d: any) => at(d, 2010).lifeExpectancy - at(d, 1990).lifeExpectancy;
assertClaim([...wpp].sort((a: any, b: any) => gain(b) - gain(a))[0].iso3 === 'SSD', 'largest life-expectancy gain 1990–2010');
const urbRank = [...big].sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3).indexOf('SSD');
assertClaim(urbRank === 4, 'fifth-lowest urban share among 10M+');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100 && y[2100].population > 1.9 * c.population, 'still growing in 2100, almost double today');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1987, 'fertility high 1987');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2076, 'below 2.1 from 2076');
assertClaim(c.medianAge < 20, 'median age under 20');

const title = `South Sudan Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Two Falls in the Count and a Young Future | AtlasFigures`;
const description = `UN estimate for South Sudan in ${CURRENT_YEAR}: ${millions(c.population)}. The series dips in 1988–1989 and 2015–2018 and shows net departures near ${dec(outSum / 1e6, 1)} million over 2014–2017, and is still climbing at ${millions(y[2100].population)} in 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ssd.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, ssd.tableYears);

const faq = [
  { q: "Why does South Sudan's population go down in some years?", a: `The UN mid-year estimate falls in 1988 and 1989 and again from 2015 to 2018. The UN files record the counts (deaths, births, net migration) but not what caused them.` },
  { q: 'How many people left South Sudan between 2014 and 2017?', a: `Around ${dec(outSum / 1e6, 1)} million net, over four years, by the UN's count; ${outTop.year} alone accounts for ${int(-outTop.netMigrants)}.` },
  { q: 'How long can a newborn in South Sudan expect to live?', a: `${dec(c.lifeExpectancy, 1)} years as of ${CURRENT_YEAR}; only Nigeria and Chad rank lower anywhere. For 1988 the UN figure was just ${dec(leLow.lifeExpectancy, 1)}.` },
  { q: "Is South Sudan's total still rising?", a: `Rising ${pct(c.growthRatePct)} this year, and the medium-variant path never turns down: ${millions(y[2100].population)} in 2100, still climbing.` },
  { q: "Is South Sudan's population mostly young?", a: `Half are younger than ${dec(c.medianAge, 1)}. The average woman has ${dec(c.fertility, 2)} children, and the UN keeps that figure above 2.1 until ${repl}.` },
];

const schema = countrySchema({
  page: PAGE, slug: ssd.slug, name: ssd.name, wikipedia: ssd.wikipedia,
  headline: `South Sudan's ${millions(c.population)}: two falls in the UN count, about ${dec(outSum / 1e6, 1)} million net departures in four years, and growth to 2100`,
  description,
  datasetName: 'South Sudan population, life expectancy and net migration, 1950–2100',
  datasetDescription: `Mid-year population of South Sudan for selected years from 1950 to ${CURRENT_YEAR} (every year 1984–1990 and 2013–2020 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ssd.published, updated: ssd.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="South Sudan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "South Sudan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>South Sudan: two falls in the count and a very young population</h1>
        <LiveCounter
          label="South Sudan: estimated population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024, mid-${CURRENT_YEAR}; roughly ${int(c.change / 365)} more people each day`}
        />
        <p class="answer">
          South Sudan's {CURRENT_YEAR} population is estimated by the UN at <strong>{millions(c.population)}</strong>, with a median age of just {dec(c.medianAge, 1)}. Its UN series shrinks twice, in the late 1980s and after 2014, and is projected to keep growing until at least 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={ssd.updated}>{longDate(ssd.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="South Sudan" code="ss" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>When did South Sudan's population fall?</h2>
          <p>Twice: the mid-year estimate is lower than the year before in 1988 and 1989, then in every year from 2015 to 2018. The 1988 figures are extreme. Life expectancy at birth is estimated at {dec(leLow.lifeExpectancy, 1)} years, the lowest anywhere that year, down from {dec(y[1986].lifeExpectancy, 1)} in 1986; {dec(imrTop.infantMortalityPer1000!, 1)} of every 1,000 babies are estimated to die in their first year; and the death count, {int(y[1988].deaths)}, is more than double the following year's. The UN files hold these counts only; they say nothing about causes.</p>
        </div>
        <LineChart
          title="How long South Sudanese newborns could expect to live, 1950–2050"
          subtitle="UN estimates for each year in the table, with every year from 1984 to 1990 included; projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many people left South Sudan after 2014?</h2>
          <p>About {dec(outSum / 1e6, 1)} million more left than arrived from 2014 to 2017, by UN estimates, with the largest net outflow, {int(-outTop.netMigrants)}, in {outTop.year}. The direction reversed later: the series' biggest net inflow, {int(inTop.netMigrants)}, falls in {inTop.year}, the year the total finally beat the 2014 mark ({millions(pre)}).</p>
        </div>
        <div class="age-row" role="group" aria-label="South Sudan's mid-year population, UN estimates">
          <div><span class="y">2014</span><div class="v">{millionsShort(y[2014].population)}</div><span class="d">People</span></div>
          <div><span class="y">2018</span><div class="v">{millionsShort(y[2018].population)}</div><span class="d">People</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{millionsShort(c.population)}</div><span class="d">People</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is South Sudan's life expectancy improving?</h2>
          <p>Over the long run, yes. Between 1990 and 2010 it climbed from {dec(y[1990].lifeExpectancy, 1)} to {dec(y[2010].lifeExpectancy, 1)} years, a bigger rise than the UN shows for any other country or area. The {CURRENT_YEAR} figure, {dec(c.lifeExpectancy, 1)}, is still beaten from below only by Nigeria and Chad, and with {dec(c.infantMortalityPer1000!, 1)} infant deaths for each 1,000 born, South Sudan has the sixth-worst rate worldwide.</p>
        </div>

        <div class="story-block prose">
          <h2>Does South Sudan's growth continue through 2100?</h2>
          <p>Yes. The projected count passes {millions(y[2050].population)} by 2050, then reaches {millions(y[2100].population)} as the century closes, with no peak in sight. Fertility topped out in {tfrTop.year} ({dec(tfrTop.fertility, 2)} per woman); it is {dec(c.fertility, 2)} now and not projected below 2.1 until {repl}. Only {pct(c.urbanPct!)} of people live in places the country defines as urban, the fifth-smallest share in the group of countries with at least ten million residents.</p>
        </div>
        <LineChart
          title="South Sudan's population, 1950 to 2100"
          subtitle="UN mid-year estimates, with the 1988–1989 and 2015–2018 falls visible; medium-variant projection dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={ssd.iso3} name={ssd.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="South Sudan's numbers for each listed year, 1984–1990 and 2013–2020 complete"
          subtitle="Both falls in the estimate are shown row by row; later rows are UN projections."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ssd.slug}-population.csv`)}
          csvName={`${ssd.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">South Sudan in short answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ssd.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ssd.published}>{longDate(ssd.published)}</time> · Updated <time datetime={ssd.updated}>{longDate(ssd.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("South Sudan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="South Sudan" code="ss" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
