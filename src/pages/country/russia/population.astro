---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ru from '../../../data/countries/russia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: smaller than in 1991, with far fewer men than women.
const PAGE = '/country/russia/population/';
const un = countryData(ru.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ru.verification as any).checkedOn as string | undefined;

const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991, 'peak in 1991');
const under140 = un.years.find((r) => r.year > peak.year && r.population < 140e6)!.year;
const menPer100 = (c.male / c.female) * 100;
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any) => d.years.find((r: any) => r.year === CURRENT_YEAR);
assertClaim(wpp.filter((d: any) => at(d).population > 10e6).sort((a: any, b: any) => at(a).male / at(a).female - at(b).male / at(b).female)[0].iso3 === 'RUS', 'fewest men per woman of any country over 10 million');
const leLow = un.years.filter((r) => r.year > 1980 && !r.projection).reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1994 && y[2021].lifeExpectancy < y[2019].lifeExpectancy - 3 && c.lifeExpectancy > y[2019].lifeExpectancy, 'low in 1994; fall to 2021; now above 2019');
const tfrLow = un.years.filter((r) => !r.projection).reduce((a, b) => (b.fertility < a.fertility ? b : a));
const posYears = un.years.filter((r) => r.year > peak.year && r.naturalChange >= 0).map((r) => r.year);
assertClaim(JSON.stringify(posYears) === '[2012,2013,2014,2015,2016]', 'births above deaths only in 2012-2016 since 1991');
assertClaim(y[1999].births < y[1987].births / 2 + 30000, 'births roughly halved between 1987 and 1999');
const europe = wpp.filter((d: any) => d.region === 'Europe').sort((a: any, b: any) => at(b).population - at(a).population);
const landTop = [...wpp].sort((a: any, b: any) => b.landAreaKm2 - a.landAreaKm2)[0].iso3;
assertClaim(europe[0].iso3 === 'RUS' && landTop === 'RUS', 'most populous in Europe and largest land area');
assertClaim(c.netMigrants > 0 && un.years.filter((r) => r.year > CURRENT_YEAR).every((r) => r.netMigrants > 0 && r.naturalChange < 0), 'migration positive but deaths above births in every projected year');

const title = `Russia's Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Below Its 1991 Peak | AtlasFigures`;
const description = `With ${dec(menPer100, 1)} men for every 100 women and a population (${millions(c.population)} in ${CURRENT_YEAR}) still below its ${peak.year} peak, Russia is shrinking. Births, deaths, life expectancy and a projected ${millions(y[2100].population)} by 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: dec(c.densityPerKm2, 1) },
    { label: 'Capital', value: ru.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Men per 100 women', value: dec(menPer100, 1) },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Men per 100 women', value: dec(menPer100, 1) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, ru.tableYears);

const faq = [
  { q: "What is the latest estimate of Russia's population?", a: `The UN's mid-${CURRENT_YEAR} estimate is ${millions(c.population)}. That is ${ord(c.worldRank!)} in the world and the largest of any European country.` },
  { q: 'Has Russia been losing people since 1991?', a: `Overall, yes. The UN puts the ${peak.year} peak at ${millions(peak.population)}; the ${CURRENT_YEAR} figure is ${millions(peak.population - c.population)} lower, though in some years migration lifted the total.` },
  { q: 'Are there more women than men in Russia?', a: `Many more. There are ${dec(menPer100, 1)} men for every 100 women in ${CURRENT_YEAR}, lower than in any other nation of over 10 million inhabitants.` },
  { q: 'How long do Russians live on average?', a: `A child born in Russia in ${CURRENT_YEAR} is expected to live ${dec(c.lifeExpectancy, 1)} years. It was ${dec(leLow.lifeExpectancy, 1)} in ${leLow.year} and dipped to ${dec(y[2021].lifeExpectancy, 1)} in 2021.` },
  { q: "How far could Russia's population fall by 2100?", a: `The medium projection sees about ${millions(y[2100].population)} by 2100, falling under 140 million in ${under140} and leaving Russia ${ord(y[2100].worldRank!)} worldwide.` },
];

const schema = countrySchema({
  page: PAGE, slug: ru.slug, name: ru.name, wikipedia: ru.wikipedia,
  headline: `Russia's population in ${CURRENT_YEAR}: ${millions(c.population)}, still below the ${peak.year} peak`,
  description,
  datasetName: 'Russia population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Russia (Russian Federation) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ru.published, updated: ru.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Russia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Russia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Russia's shrinking population</h1>
        <LiveCounter
          label="Russia's population, estimated live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} figure, declining by roughly ${int(Math.abs(c.change) / 365)} a day`}
        />
        <p class="answer">
          At about <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, Russia has more people than any other European country, yet <strong>{millions(peak.population - c.population)} fewer than at its {peak.year} peak</strong>. Deaths outnumber births by a wide margin, and only migration keeps the decline from being faster.
        </p>
        <div class="dates"><span>Updated <time datetime={ru.updated}>{longDate(ru.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Russia" code="ru" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>When did Russia's population peak?</h2>
          <p>In {peak.year}, at {millions(peak.population)}, in the UN's reconstruction. Since then, only {posYears[0]}–{posYears[posYears.length - 1]} saw more births than deaths. This year deaths exceed births by about {int(Math.round(Math.abs(c.naturalChange) / 1000))} thousand, partly offset by net migration of {int(Math.round(c.netMigrants / 1000))} thousand, leaving a fall of {pct(Math.abs(c.growthRatePct))}.</p>
        </div>
        <LineChart
          title="Russia's population, 1950 to 2100"
          subtitle="Mid-year totals for the Russian Federation as the UN reports it. The dashed part of the line is the medium projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many men are there for every 100 women in Russia?</h2>
          <p>{dec(menPer100, 1)} in {CURRENT_YEAR}, the most unbalanced among countries home to over 10 million people. The gap is long-standing: in 1950 the UN figure was {dec((y[1950].male / y[1950].female) * 100, 1)}. In absolute terms Russia has about {millions(c.female - c.male)} more women than men.</p>
        </div>

        <div class="story-block prose">
          <h2>What happened to life expectancy in Russia in the 1990s?</h2>
          <p>It fell sharply. Life expectancy at birth was {dec(y[1990].lifeExpectancy, 1)} years in 1990 but only {dec(leLow.lifeExpectancy, 1)} by {leLow.year}, the lowest point in the UN series since 1980. It recovered later, dropped again to {dec(y[2021].lifeExpectancy, 1)} in 2021 from {dec(y[2019].lifeExpectancy, 1)} in 2019, and stands at {dec(c.lifeExpectancy, 1)} in {CURRENT_YEAR}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy in Russia">
          <div><span class="y">1990</span><div class="v">{dec(y[1990].lifeExpectancy, 1)}</div><span class="d">Years expected at birth</span></div>
          <div><span class="y">{leLow.year}</span><div class="v">{dec(leLow.lifeExpectancy, 1)}</div><span class="d">The low point</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Recovered</span></div>
        </div>

        <div class="story-block prose">
          <h2>How low did births fall in Russia?</h2>
          <p>To about half their late-1980s level. The UN counts {millions(y[1987].births)} births in 1987 and {millions(y[1999].births)} in 1999, when fertility hit {dec(tfrLow.fertility, 2)} children per woman. The rate has recovered to {dec(c.fertility, 2)}, still far below 2.1, and about {millions(c.births)} babies are expected this year.</p>
        </div>
        <LineChart
          title="Russian fertility since 1950, with the 1999 low"
          subtitle="UN total fertility rate, with its 1999 low; dashed values are projected. Dotted line: 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Replacement rate' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Does Russia have Europe's largest population?</h2>
          <p>Yes, as the UN groups countries; it also has the largest land area of any country, about {millions(un.landAreaKm2)} km², so density is only {dec(c.densityPerKm2, 1)} people per km². Three in four Russians, {pct(c.urbanPct!)}, are urban residents by the national definition. In 1950 Russia ranked {ord(y[1950].worldRank!)} by population worldwide; it is {ord(c.worldRank!)} now and is projected to be {ord(y[2100].worldRank!)} in 2100.</p>
        </div>
        <RelatedPages iso3={ru.iso3} name={ru.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Russia's population data by year, 1950–2100"
          subtitle="The Russian Federation's mid-year headcount, alongside people per km², fertility, median age, urban percentage under the national definition (until 2050) and ranking. Rows from 2030: UN projection."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ru.slug}-population.csv`)}
          csvName={`${ru.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Russia's population: short questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ru.unName}"): population by sex, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and subtracts the UN's projected decline for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ru.published}>{longDate(ru.published)}</time> · Updated <time datetime={ru.updated}>{longDate(ru.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Russia population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Russia" code="ru" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
