---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import sa from '../../../data/countries/saudi-arabia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: twentyfold growth since 1950, a male-heavy population, swings in migration, growth all the way to 2100.
const PAGE = '/country/saudi-arabia/population/';
const un = countryData(sa.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (sa.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const times = c.population / y[1950].population;
assertClaim(times > 20 && times < 21, 'about 20 times the 1950 population');
const men = (c.male / c.female) * 100;
const mf = wpp.filter((d: any) => at(d).population > 1e6).sort((a: any, b: any) => at(b).male / at(b).female - at(a).male / at(a).female).map((d: any) => d.iso3);
assertClaim(mf.indexOf('SAU') === 5 && mf.slice(0, 5).every((k: string) => ['QAT', 'ARE', 'OMN', 'BHR', 'KWT'].includes(k)), 'sixth most male-heavy country over 1 million, behind five other Gulf states');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100 && un.years.every((r) => r.year < 2027 || r.change > 0), 'grows every projected year to 2100');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 2 && ratio < 2.05, 'about double by 2100');
const est = un.years.filter((r) => !r.projection);
const falls = est.filter((r) => r.change < 0).map((r) => r.year);
assertClaim(falls.join(',') === '2017,2018' && y[2017].netMigrants < -900e3 && y[2018].netMigrants < -900e3, 'fell only in 2017 and 2018, each with net outflow above 900 thousand');
const rebound = est.reduce((a, b) => (b.change > a.change ? b : a));
assertClaim(rebound.year === 2022 && rebound.netMigrants > 950e3, '2022 biggest gain, net inflow near 1 million');
assertClaim(Math.abs(y[1970].fertility - 7.58) < 0.005 && c.fertility > 2.1, 'fertility 7.58 in 1970, still above 2.1');
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(below === 2034, 'projected below 2.1 from 2034');
assertClaim(c.naturalChange > c.netMigrants * 4, 'natural increase over four times net migration this year');
const wasia = wpp.filter((d: any) => d.subregion === 'Western Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(wasia.slice(0, 4).join(',') === 'TUR,IRQ,YEM,SAU', 'fourth-largest in Western Asia after Turkey, Iraq and Yemen');
assertClaim(men > 145 && men < 155, 'about three men for every two women');

const title = `Saudi Arabia Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, 20 Times Its 1950 Size | AtlasFigures`;
const description = `Saudi Arabia's 1950 population of ${millions(y[1950].population)} has become ${millions(c.population)} in ${CURRENT_YEAR}, with ${int(Math.round(men))} males per 100 females. UN figures show growth continuing to 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: sa.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Men per 100 women', value: int(Math.round(men)) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, sa.tableYears);

const faq = [
  { q: 'How big is the Saudi population in ' + CURRENT_YEAR + '?', a: `${millions(c.population)} people at mid-year by the UN's count, ${ord(c.worldRank!)} worldwide and fourth in Western Asia, behind Turkey, Iraq and Yemen.` },
  { q: 'Why are there more men than women in Saudi Arabia?', a: `The UN figures record the imbalance, a ratio of ${int(Math.round(men))} men to 100 women in ${CURRENT_YEAR}, but not its causes. In 1950 the ratio was ${dec((y[1950].male / y[1950].female) * 100, 1)}.` },
  { q: 'Did Saudi Arabia\'s population ever go down?', a: `Yes, in 2017 and 2018. In both years the net outflow of people topped 900 thousand. Growth came back strongly, with a gain of ${millions(rebound.change)} in ${rebound.year}.` },
  { q: 'Will the Saudi population keep rising?', a: `Yes, by ${pct(c.growthRatePct)} this year, and the UN's medium path keeps it rising every year to 2100, when it reaches ${millions(y[2100].population)}.` },
  { q: 'How has the Saudi birth rate changed?', a: `Fertility stood at ${dec(y[1970].fertility, 2)} in 1970 and is ${dec(c.fertility, 2)} now; a drop below 2.1 is projected for ${below}.` },
];

const schema = countrySchema({
  page: PAGE, slug: sa.slug, name: sa.name, wikipedia: sa.wikipedia,
  headline: `Saudi Arabia's population: ${millions(c.population)} in ${CURRENT_YEAR}, twenty times 1950`,
  description,
  datasetName: 'Saudi Arabia population, migration, fertility and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Saudi Arabia for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: sa.published, updated: sa.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Saudi Arabia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Saudi Arabia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Saudi Arabia's population, twenty times bigger than in 1950</h1>
        <LiveCounter
          label="Saudi Arabia: population estimate now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, gaining roughly ${int(c.change / 365)} people every day`}
        />
        <p class="answer">
          About <strong>{millions(c.population)}</strong> people call Saudi Arabia home as of mid-{CURRENT_YEAR}, number {c.worldRank} on the world list and <strong>20 times the {millions(y[1950].population)} of 1950</strong>. Men outnumber women by about three to two, and growth is projected to last until 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={sa.updated}>{longDate(sa.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Saudi Arabia" code="sa" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>By what factor has Saudi Arabia's population multiplied since 1950?</h2>
          <p>Twentyfold in three-quarters of a century: 1950's {millions(y[1950].population)} became {millions(y[2000].population)} by 2000 and is {millions(c.population)} today. Births still far exceed deaths, {int(Math.round(c.births / 1000))} thousand against {int(Math.round(c.deaths / 1000))} thousand this year, so natural increase adds more than four times as many people as migration does.</p>
        </div>
        <LineChart
          title="Saudi Arabia's population, 1950–2100: rising throughout"
          subtitle="UN figures for each mid-year. The dashed medium projection reaches about 71 million in 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why does Saudi Arabia have so many more men than women?</h2>
          <p>The UN data show how large the gap is rather than why it exists: {int(Math.round(men))} males for every 100 females in {CURRENT_YEAR}, against {dec((y[1950].male / y[1950].female) * 100, 1)} in 1950. Among countries of a million-plus residents, only five, all of them Gulf neighbours (Qatar, the UAE, Oman, Bahrain and Kuwait), are more lopsided.</p>
        </div>

        <div class="story-block prose">
          <h2>Did Saudi Arabia's population shrink in 2017 and 2018?</h2>
          <p>It did, according to the UN. Net departures exceeded 900 thousand in each of those two years, enough to outweigh natural growth, and they are the only years of decline since 1950. The flow then reversed: {rebound.year} brought the largest one-year gain on record, {millions(rebound.change)}, with net arrivals just short of the 1 million mark.</p>
        </div>

        <div class="story-block prose">
          <h2>Has the Saudi birth rate dropped?</h2>
          <p>Yes, steeply over two generations. In 1970 the fertility rate was {dec(y[1970].fertility, 2)}; today it is {dec(c.fertility, 2)}, and the medium projection takes it under the 2.1 replacement mark in {below}. The population remains young: half are under {dec(c.medianAge, 1)}.</p>
        </div>
        <LineChart
          title="Saudi fertility from 1950 to 2050"
          subtitle="Average births per woman (UN); dashed after 2026. The marked line is 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'replacement 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <div class="age-row" role="group" aria-label="Men per 100 women in Saudi Arabia">
          <div><span class="y">1950</span><div class="v">{dec((y[1950].male / y[1950].female) * 100, 1)}</div><span class="d">Men per 100 women</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(men, 1)}</div><span class="d">Three to two</span></div>
          <div><span class="y">2100, UN projection</span><div class="v">{dec((y[2100].male / y[2100].female) * 100, 1)}</div><span class="d">Narrowing</span></div>
        </div>

        <div class="story-block prose">
          <h2>Will Saudi Arabia's population keep growing to 2100?</h2>
          <p>In the UN's medium variant it grows every single year and roughly doubles to {millions(y[2100].population)} by 2100, moving from {ord(c.worldRank!)} to {ord(y[2100].worldRank!)} in the world. It is a thinly settled country, {int(c.densityPerKm2)} people per km², yet {pct(c.urbanPct!)} of Saudis are urban dwellers by the kingdom's own definition.</p>
        </div>
        <RelatedPages iso3={sa.iso3} name={sa.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Saudi population, 1950 through 2100"
          subtitle="A row for each decade and for the current year; the shaded rows are projections."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${sa.slug}-population.csv`)}
          csvName={`${sa.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Saudi population questions answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{sa.unName}"): population, males and females, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={sa.published}>{longDate(sa.published)}</time> · Updated <time datetime={sa.updated}>{longDate(sa.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Saudi Arabia population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Saudi Arabia" code="sa" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
