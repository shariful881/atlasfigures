---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import cl from '../../../data/countries/chile.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the lowest fertility in South America and fifth-lowest
// among countries of ten million or more; a peak in 2041, natural decrease from 2036 and a fall of about a third by 2100;
// net emigration every year to 1991, then net immigration with a 2018 high; the highest life expectancy and oldest median
// age among South American countries of a million or more. Counts only; the UN files give no causes.
const PAGE = '/country/chile/population/';
const un = countryData(cl.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (cl.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const sam = wpp.filter((d: any) => d.subregion === 'South America');
const sam1m = sam.filter((d: any) => at(d).population >= 1e6);
assertClaim([...sam].sort((a: any, b: any) => at(a).fertility - at(b).fertility)[0].iso3 === 'CHL', 'lowest fertility in South America');
const lowBig = [...big].sort((a: any, b: any) => at(a).fertility - at(b).fertility).map((d: any) => d.iso3);
assertClaim(lowBig.indexOf('CHL') === 4, 'fifth-lowest fertility among countries of ten million or more');
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(under === 1999 && un.years.filter((r) => r.year >= under).every((r) => r.fertility < 2.1), 'under 2.1 every year from 1999');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
const belowNow = un.years.find((r) => r.year > peak.year && r.population < c.population)!.year;
assertClaim(peak.year === 2041 && natNeg === 2036 && belowNow === 2056, 'peak 2041; deaths exceed births from 2036; below today from 2056');
assertClaim(un.years.filter((r) => r.year > natNeg).every((r) => r.naturalChange < 0), 'natural decrease continues every year after 2036');
const fall = 1 - y[2100].population / c.population;
assertClaim(fall > 0.32 && fall < 0.34, 'about a third smaller by 2100');
const lastOut = Math.max(...un.years.filter((r) => r.netMigrants < 0).map((r) => r.year));
assertClaim(lastOut === 1991 && un.years.filter((r) => r.year <= 1991).every((r) => r.netMigrants < 0), 'net emigration every year 1950–1991, never after');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2018, 'largest net arrivals 2018');
assertClaim([...sam].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy)[0].iso3 === 'CHL', 'highest life expectancy in South America');
assertClaim([...sam1m].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge)[0].iso3 === 'CHL' && [...sam1m].sort((a: any, b: any) => at(b, 2050).medianAge - at(a, 2050).medianAge)[0].iso3 === 'CHL', 'oldest median age among South American countries of a million or more, now and in 2050');
const bTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bTop.year === 1991, 'births peaked in 1991');

const title = `Chile Population Outlook ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M Now, Peaking in 2041 | AtlasFigures`;
const description = `South America's lowest fertility, ${dec(c.fertility, 2)}, belongs to Chile, home to ${millions(c.population)} in ${CURRENT_YEAR} (UN); deaths overtake births in 2036 and numbers crest in 2041, leaving ${millions(y[2100].population)} for 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: cl.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Peak year', value: String(peak.year) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, cl.tableYears);

const faq = [
  { q: 'Does Chile have the lowest birth rate in South America?', a: `Yes. At ${dec(c.fertility, 2)} children per woman this year it ranks last on the continent and only South Korea, Taiwan, Ukraine and China, of all places with ten million-plus people, are lower.` },
  { q: 'Is Chile going to shrink?', a: `Yes. ${peak.year} is the projected high, ${millions(peak.population)}; natural decrease begins in ${natNeg}.` },
  { q: 'How many migrants arrived in Chile in 2018?', a: `Net arrivals were about ${int(Math.round(inTop.netMigrants / 1000))} thousand, the highest in the UN series; Chile has had more arrivals than departures in every year since 1992.` },
  { q: 'Do Chileans live longer than other South Americans?', a: `Yes: ${dec(c.lifeExpectancy, 1)} years at birth, longer than in any other South American country, up from ${dec(y[1950].lifeExpectancy, 1)} in 1950.` },
  { q: 'How old is the average Chilean?', a: `${dec(c.medianAge, 1)} at the median, the oldest of South America's countries above a million people, rising to ${dec(y[2050].medianAge, 1)} by 2050.` },
];

const schema = countrySchema({
  page: PAGE, slug: cl.slug, name: cl.name, wikipedia: cl.wikipedia,
  headline: `Chile's ${millions(c.population)}: South America's lowest fertility, a 2041 peak and immigration since 1992`,
  description,
  datasetName: 'Chile population, fertility and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Chile for selected years from 1950 to ${CURRENT_YEAR} (1991, 2018, 2036, 2041 and 2056 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: cl.published, updated: cl.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Chile"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Chile", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Chile: South America's lowest fertility and a peak in sight</h1>
        <LiveCounter
          label="Chile: live estimate of residents"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, rising by close to ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          No South American country has lower fertility than Chile, at <strong>{dec(c.fertility, 2)}</strong>. Its population (UN estimate: <strong>{millions(c.population)}</strong> for {CURRENT_YEAR}) still rises for now; the UN expects natural decrease from {natNeg} and a high point in {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={cl.updated}>{longDate(cl.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Chile" code="cl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How low has Chile's fertility fallen?</h2>
          <p>To {dec(c.fertility, 2)} children per woman, last in South America and fifth from the bottom of all places with ten million-plus people. It was {dec(y[1950].fertility, 2)} in 1950, has been under 2.1 since {under} and has fallen by {dec(y[2015].fertility - c.fertility, 2)} since 2015 alone. The yearly number of babies was greatest in {bTop.year} (roughly {int(Math.round(bTop.births / 1000))} thousand); around {int(Math.round(c.births / 1000))} thousand are expected this year.</p>
        </div>
        <LineChart
          title="Chilean fertility, 1950 to 2050"
          subtitle="UN births per woman; the projected part is dashed and a line marks 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'line at 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>When does Chile stop growing?</h2>
          <p>Growth ends in {peak.year}, with {millions(peak.population)} projected. Starting in {natNeg}, deaths top births in each projected year, and from {belowNow} the count is smaller than today's. The 2100 projection, {millions(y[2100].population)}, is roughly a third below the present, and Chile moves from {ord(c.worldRank!)} to {ord(y[2100].worldRank!)} in the world.</p>
        </div>
        <LineChart
          title="Chile's population: growth to 2041, then decline"
          subtitle="UN totals at 1 July; dashed after the estimate years."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has migration into Chile overtaken emigration?</h2>
          <p>Yes. The UN records net emigration in every year from 1950 to {lastOut} and net arrivals in every year since. Inflows were largest in {inTop.year}, about {int(Math.round(inTop.netMigrants / 1000))} thousand, and are near {int(Math.round(c.netMigrants / 1000))} thousand this year. The data show the balance, not where people came from.</p>
        </div>

        <div class="story-block prose">
          <h2>How old is Chile's population?</h2>
          <p>The median Chilean is {dec(c.medianAge, 1)}, compared with {dec(y[1990].medianAge, 1)} in 1990, and {dec(y[2050].medianAge, 1)} is expected by mid-century. No other South American country with a million-plus people is older, today or then. Chileans also have the continent's longest life expectancy, {dec(c.lifeExpectancy, 1)}, and {pct(c.urbanPct!)} count as urban nationally.</p>
        </div>
        <RelatedPages iso3={cl.iso3} name={cl.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Chile, 1950–2100, with the 2036, 2041 and 2056 rows"
          subtitle="Net migration turns positive after 1991; 2041 is the projected high point."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${cl.slug}-population.csv`)}
          csvName={`${cl.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Chile: what people ask</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{cl.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={cl.published}>{longDate(cl.published)}</time> · Updated <time datetime={cl.updated}>{longDate(cl.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Chile population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Chile" code="cl" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
