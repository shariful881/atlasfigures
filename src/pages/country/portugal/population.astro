---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import prt from '../../../data/countries/portugal.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: net emigration every year 1950–1970
// (largest in 1970) with the total falling every year 1964–1970, then net arrivals in 1971; a 2010 peak; deaths above
// births every year since 2009; the second-oldest median age in Europe (1 million+); far more women than men.
const PAGE = '/country/portugal/population/';
const un = countryData(prt.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (prt.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1970 && -outTop.netMigrants > 1.9e5, 'largest net outflow 1970, above 190,000');
const run = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
assertClaim(run(1964, 1970).every((n) => y[n].naturalChange > 0 && y[n].netMigrants < -y[n].naturalChange), 'emigration outweighed natural increase 1964–1970');
assertClaim(run(1964, 1970).every((n) => y[n].population < y[n - 1].population) && y[1963].population > y[1962].population, 'total fell every year 1964–1970');
assertClaim(run(1950, 1970).every((n) => y[n].netMigrants < 0) && run(1971, 1990).filter((n) => y[n].netMigrants > 0).length > 0 && y[1971].netMigrants > 0, 'net departures every year 1950–1970, arrivals in 1971');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2010, 'peak 2010');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2009 && un.years.filter((r) => r.year >= 2009).every((r) => r.naturalChange < 0), 'deaths over births every year from 2009');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2021, 'largest net inflow 2021');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).slice(0, 2).map((d: any) => d.iso3).join() === 'ITA,PRT', 'second-oldest in Europe after Italy');
assertClaim(c.male / c.female < 0.92, 'about 91 men per 100 women');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1962, 'births peak 1962');
const repl = un.years.find((r) => r.year > 1962 && r.fertility < 2.1)!.year;
assertClaim(repl === 1982 && un.years.filter((r) => r.year >= 1982 && r.year <= CURRENT_YEAR).every((r) => r.fertility < 2.1), 'under 2.1 since 1982');
const seu = wpp.filter((d: any) => d.subregion === 'Southern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(seu.slice(0, 3).join() === 'ITA,ESP,PRT', 'third in Southern Europe');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1994, 'urban majority 1994');

const title = `Portugal Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Emigrants in the 1960s, Decline After 2010 | AtlasFigures`;
const description = `Portugal's resident count for ${CURRENT_YEAR}: ${millions(c.population)}, in UN data. Heavy net emigration shrank it every year from 1964 to 1970; the high point came in 2010, with deaths in excess of births from 2009.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: prt.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, prt.tableYears);

const faq = [
  { q: 'Did Portugal lose population in the 1960s?', a: `Yes. The UN estimates show a smaller total each year from 1964 to 1970, the net outflow topping out at ${int(-outTop.netMigrants)} in 1970; the files do not say why people left.` },
  { q: "When was Portugal's population largest?", a: `In 2010, with ${millions(peak.population)}; the UN's projection for 2100 is ${millions(y[2100].population)}.` },
  { q: 'Is Portugal one of the oldest countries in Europe?', a: `Second oldest, by median age (${dec(c.medianAge, 1)}), with Italy ahead, counting European states of over a million.` },
  { q: 'Is Portugal recording more deaths than births?', a: `Each year from 2009 on. For ${CURRENT_YEAR}: ${int(c.deaths)} deaths and ${int(c.births)} births, with net arrivals of ${int(c.netMigrants)}.` },
  { q: 'Why are there fewer men than women in Portugal?', a: `The UN figures record ${dec((c.male / c.female) * 100, 1)} men for each 100 women but do not explain the gap; women also live longer on average.` },
];

const schema = countrySchema({
  page: PAGE, slug: prt.slug, name: prt.name, wikipedia: prt.wikipedia,
  headline: `Portugal's ${millions(c.population)}: 1960s emigration, a 2010 high, and deaths ahead of births since 2009`,
  description,
  datasetName: 'Portugal population, net migration and births, 1950–2100',
  datasetDescription: `Mid-year population of Portugal for selected years from 1950 to ${CURRENT_YEAR}, including 1962–1964, 1970–1971 and 2009–2011, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: prt.published, updated: prt.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Portugal"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Portugal", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Portugal: emigration, return and a greying population</h1>
        <LiveCounter
          label="Portugal: estimated population at the moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`From the mid-${CURRENT_YEAR} UN World Population Prospects 2024 estimate; down roughly ${int(-c.change / 365)} people a day`}
        />
        <p class="answer">
          The UN reckons Portugal's {CURRENT_YEAR} population at <strong>{millions(c.population)}</strong>, short of the {millions(peak.population)} reached in 2010. Its median age (<strong>{dec(c.medianAge, 1)}</strong>) is topped in Europe only by Italy's, among countries over a million.
        </p>
        <div class="dates"><span>Updated <time datetime={prt.updated}>{longDate(prt.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Portugal" code="pt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why did Portugal's population shrink in the 1960s?</h2>
          <p>Emigration outweighed natural growth. Departures exceeded arrivals in each year from 1950 to 1970; the {outTop.year} outflow, {int(-outTop.netMigrants)}, was the largest, and the mid-year total is lower each year from 1964 to 1970. In 1971 the balance turns to net arrivals ({int(y[1971].netMigrants)} that year). The UN series records the movements but not the reasons for them.</p>
        </div>
        <LineChart
          title="Portuguese population across 1950–2100"
          subtitle="Mid-year totals; the 1960s dip and the 2010 high are visible, projection dashed to 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Portugal's population been falling since 2010?</h2>
          <p>Mostly. The 2010 count of {millions(peak.population)} is the series high, and deaths have been in excess of births every year starting in 2009; the {CURRENT_YEAR} gap is {int(c.deaths - c.births)}. Net arrivals, largest in {inTop.year} at {int(inTop.netMigrants)}, have slowed the decline without reversing it. Projected totals are {millions(y[2050].population)} (2050) and {millions(y[2100].population)} (2100).</p>
        </div>

        <div class="story-block prose">
          <h2>Is Portugal one of Europe's oldest populations?</h2>
          <p>Yes: its median resident is {dec(c.medianAge, 1)}, second only to Italy's in Europe, counting countries over one million. The most births in any year, {int(birthTop.births)}, was recorded in {birthTop.year}, against a projected {int(c.births)} now. Fertility, below 2.1 continuously from {repl}, is {dec(c.fertility, 2)}, while life expectancy stands at {dec(c.lifeExpectancy, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>How large is the gap between Portuguese women and men?</h2>
          <p>Wide: the sex ratio is {dec((c.male / c.female) * 100, 1)}, one of Europe's lowest. Third in Southern Europe by population, after Italy and Spain, Portugal turned majority-urban in {urbanHalf} (national definition); the share is {pct(c.urbanPct!)} today.</p>
        </div>
        <RelatedPages iso3={prt.iso3} name={prt.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Portugal over the decades, with 1962–1964, 1970 and 2009–2011"
          subtitle="The 1964–1970 rows trace the emigration years; 2010 marks the peak."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${prt.slug}-population.csv`)}
          csvName={`${prt.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Portugal: frequently raised questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{prt.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={prt.published}>{longDate(prt.published)}</time> · Updated <time datetime={prt.updated}>{longDate(prt.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Portugal population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Portugal" code="pt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
