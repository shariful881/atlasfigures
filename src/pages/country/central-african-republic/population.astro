---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import caf from '../../../data/countries/central-african-republic.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only (no causes given): the youngest
// population of any country of a million or more; UN-estimated mortality spikes in 2009, 2019 and 2022 (the lowest
// life-expectancy values of any such country since 2000); falls in 2009, 2010, 2014 and 2022; net outflow largest in
// 2014; density fifth-lowest in Africa; urban majority expected in 2038; growth to 2100.
const PAGE = '/country/central-african-republic/population/';
const un = countryData(caf.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (caf.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...m1].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge)[0].iso3 === 'CAF', 'youngest median age, 1M+');
const lowSince2000 = (d: any) => Math.min(...Array.from({ length: CURRENT_YEAR - 1999 }, (_, i) => at(d, 2000 + i).lifeExpectancy));
assertClaim([...m1].sort((a: any, b: any) => lowSince2000(a) - lowSince2000(b))[0].iso3 === 'CAF', 'lowest life expectancy of any 1M+ country since 2000');
assertClaim([2009, 2019, 2022].every((n) => y[n].lifeExpectancy < 35 && y[n].deaths > 2 * y[n - 1].deaths), 'spikes 2009, 2019, 2022');
assertClaim(y[2023].lifeExpectancy > 55, 'back above 55 in 2023');
const falls = un.years.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '2009,2010,2014,2022', 'falls 2009, 2010, 2014, 2022');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2014, 'largest outflow 2014');
const af1 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population >= 1e6);
assertClaim([...af1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).map((d: any) => d.iso3).indexOf('CAF') === 4, 'fifth-lowest density in Africa');
assertClaim([...m1].sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3).indexOf('CAF') === 3, 'fourth-highest fertility');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2038, 'urban majority 2038');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const times = y[2100].population / c.population;
assertClaim(peak.year === 2100 && times > 3.2 && times < 3.4, 'still growing 2100, about 3.3 times today');

const title = `Central African Republic Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Youngest Population, Median Age Under 15 | AtlasFigures`;
const description = `UN estimates for ${CURRENT_YEAR}: ${millions(c.population)} Central Africans; their median age, ${dec(c.medianAge, 1)}, is the world's lowest among nations topping one million. UN mortality estimates spike in 2009, 2019 and 2022; the files give no causes.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: caf.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, caf.tableYears);

const faq = [
  { q: 'Which country has the youngest population?', a: `Counting nations above one million, the Central African Republic, where the median resident is ${dec(c.medianAge, 1)}.` },
  { q: 'Why does life expectancy in the Central African Republic drop in 2009, 2019 and 2022?', a: `UN estimates show deaths more than doubling in each of those years and life expectancy falling to ${dec(y[2009].lifeExpectancy, 1)}, ${dec(y[2019].lifeExpectancy, 1)} and ${dec(y[2022].lifeExpectancy, 1)} years. The files do not explain these spikes.` },
  { q: 'Has the Central African Republic lost population?', a: `In four years of the series: 2009, 2010, 2014 and 2022. The heaviest net departures, ${int(-outTop.netMigrants)}, came in 2014.` },
  { q: 'How sparsely populated is the Central African Republic?', a: `Very: ${int(c.densityPerKm2)} per km², fifth-lowest in Africa among million-plus states.` },
  { q: 'What population is projected for 2100?', a: `${millions(y[2100].population)}, roughly 3.3-fold the present count, and growth has not stopped by then.` },
];

const schema = countrySchema({
  page: PAGE, slug: caf.slug, name: caf.name, wikipedia: caf.wikipedia,
  headline: `The Central African Republic's ${millions(c.population)}: the youngest population; mortality spikes in 2009, 2019 and 2022; growth to 2100`,
  description,
  datasetName: 'Central African Republic population, deaths and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of the Central African Republic for selected years from 1950 to ${CURRENT_YEAR} (every year 2018–2023 included, with 2008–2010 and 2014), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: caf.published, updated: caf.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Central African Republic"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Central African Republic", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Central African Republic: the youngest population on Earth</h1>
        <LiveCounter
          label="Central African Republic: population, live estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Rests on the UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, increasing by some ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          The Central African Republic's {CURRENT_YEAR} population is around <strong>{millions(c.population)}</strong>, UN estimates show; the median age, only <strong>{dec(c.medianAge, 1)}</strong>, is the youngest among million-plus nations.
        </p>
        <div class="dates"><span>Updated <time datetime={caf.updated}>{longDate(caf.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Central African Republic" code="cf" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How young is the Central African Republic?</h2>
          <p>Younger than anywhere else with over a million people: the median age is {dec(c.medianAge, 1)}. Fertility stands at {dec(c.fertility, 2)} births per woman, fourth-highest in that group, and {int(c.births)} births are expected this year against {int(c.deaths)} deaths.</p>
        </div>

        <div class="story-block prose">
          <h2>What do the UN mortality estimates show for 2009, 2019 and 2022?</h2>
          <p>Three sudden spikes. Estimated deaths jump to {int(y[2009].deaths)} in 2009, {int(y[2019].deaths)} in 2019 and {int(y[2022].deaths)} in 2022, each more than double the year before, and life expectancy falls to {dec(y[2009].lifeExpectancy, 1)}, {dec(y[2019].lifeExpectancy, 1)} and {dec(y[2022].lifeExpectancy, 1)} years. Since 2000, no nation topping one million has a lower reading. The UN files carry the estimates without explaining them; by 2023 the figure is back at {dec(y[2023].lifeExpectancy, 1)}.</p>
        </div>
        <LineChart
          title="Central African Republic: life expectancy, 1950–2050"
          subtitle="Every year 2018–2023 plotted; the three troughs are UN estimates, projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has the Central African Republic's population ever fallen?</h2>
          <p>Four times: in 2009, 2010, 2014 and 2022. Net departures were heaviest in {outTop.year}, at {int(-outTop.netMigrants)}; in {CURRENT_YEAR} they are {int(-c.netMigrants)}. The source gives counts only.</p>
        </div>

        <div class="story-block prose">
          <h2>How much room and how much growth lie ahead?</h2>
          <p>Space is ample: {int(c.densityPerKm2)} per km², a density only four African states of a million-plus undercut. Only {pct(c.urbanPct!)} live in towns, with an urban majority expected in {urbanHalf}. Projected totals reach {millions(y[2050].population)} in 2050; by 2100, {millions(y[2100].population)}, with no peak inside the century.</p>
        </div>
        <RelatedPages iso3={caf.iso3} name={caf.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Central African Republic, yearly 2018–2023, with 2009 and 2014"
          subtitle="The 2009, 2019 and 2022 rows hold the UN-estimated mortality spikes."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${caf.slug}-population.csv`)}
          csvName={`${caf.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Central African Republic, asked and answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{caf.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={caf.published}>{longDate(caf.published)}</time> · Updated <time datetime={caf.updated}>{longDate(caf.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Central African Republic population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Central African Republic" code="cf" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
