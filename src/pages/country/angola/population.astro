---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ao from '../../../data/countries/angola.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: one of the most urban large countries in
// Africa, a very young population growing near 3% a year, and a projection that lifts it into the world's top 15 by 2100.
const PAGE = '/country/angola/population/';
const un = countryData(ao.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ao.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const af10 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population > 10e6);
const urbanRank = [...af10].sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct).map((d: any) => d.iso3);
assertClaim(urbanRank[0] === 'DZA' && urbanRank[1] === 'AGO', 'second most urban African country above ten million, after Algeria');
const mid = wpp.filter((d: any) => d.subregion === 'Middle Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(mid[0] === 'COD' && mid[1] === 'AGO', 'second in Middle Africa after DR Congo');
const af2100 = wpp.filter((d: any) => d.region === 'Africa').sort((a: any, b: any) => at(b, 2100).population - at(a, 2100).population).map((d: any) => d.iso3);
assertClaim(af2100.indexOf('AGO') === 5 && y[2100].worldRank === 13, 'sixth in Africa and 13th in the world by 2100');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100 && un.years.every((r) => r.fertility >= 2.1), 'still growing in 2100; fertility above 2.1 throughout');
const times = c.population / y[1950].population;
assertClaim(times > 8.6 && times < 9, 'nearly nine times 1950');
const young = wpp.filter((d: any) => at(d).population > 10e6).sort((a: any, b: any) => at(a).medianAge - at(b).medianAge).map((d: any) => d.iso3);
assertClaim(young.indexOf('AGO') < 10, 'among the ten youngest countries above ten million');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrMax.year === 1974, 'fertility peak 1974');
assertClaim(y[2050].urbanPct! > 90, 'over nine in ten urban by 2050');
assertClaim(y[1990].urbanPct! < 50 && y[2000].urbanPct! > 50, 'urban share passes one half by the 2000 row');

const title = `Angola Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Young and Mostly Urban | AtlasFigures`;
const description = `Angola's ${CURRENT_YEAR} population is near ${millions(c.population)} (UN): ${pct(c.urbanPct!)} urban, half below age ${dec(c.medianAge, 1)}, and on course for ${millions(y[2100].population)} by 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ao.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, ao.tableYears);

const faq = [
  { q: 'What is the population of Angola now?', a: `For mid-${CURRENT_YEAR} the UN figure is ${millions(c.population)}; only DR Congo has more people in Middle Africa, and Angola is ${ord(c.worldRank!)} on the world list.` },
  { q: 'Do most Angolans live in towns?', a: `Yes, ${pct(c.urbanPct!)} under Angola's own definition; only Algeria scores higher among African countries above ten million people.` },
  { q: 'How young is Angola compared with other countries?', a: `Half are younger than ${dec(c.medianAge, 1)}, which puts Angola among the ten youngest countries with more than ten million inhabitants.` },
  { q: 'What could Angola\'s population reach by 2100?', a: `The medium variant says ${millions(y[2100].population)}, good for ${ord(y[2100].worldRank!)} place globally.` },
  { q: 'How many children does an Angolan woman have on average?', a: `${dec(c.fertility, 2)} this year (${dec(tfrMax.fertility, 2)} at the ${tfrMax.year} high); no UN projection year falls under 2.1 before 2100.` },
];

const schema = countrySchema({
  page: PAGE, slug: ao.slug, name: ao.name, wikipedia: ao.wikipedia,
  headline: `Angola's ${millions(c.population)}: a young, largely urban population on track for ${millions(y[2100].population)}`,
  description,
  datasetName: 'Angola population, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Angola for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ao.published, updated: ao.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Angola"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Angola', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Angola: a young population, most of it in cities</h1>
        <LiveCounter
          label="Angola: estimated population, ticking"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: 1 July ${CURRENT_YEAR} figure, adding about ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Angola's mid-{CURRENT_YEAR} population, according to UN estimates, is <strong>{millions(c.population)}</strong>, ranking it {ord(c.worldRank!)}. An unusually high <strong>{pct(c.urbanPct!)}</strong> are urban for an African country, and numbers rise {pct(c.growthRatePct)} a year.
        </p>
        <div class="dates"><span>Updated <time datetime={ao.updated}>{longDate(ao.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Angola" code="ao" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Angola's urban share so high?</h2>
          <p>The UN data show how quickly it rose, not why. By Angola's national criteria {pct(c.urbanPct!)} of residents are urban, up from {pct(y[1950].urbanPct!)} in 1950 and {pct(y[2000].urbanPct!)} in 2000; among African countries above ten million people only Algeria is higher. The 2050 figure from World Urbanization Prospects is {pct(y[2050].urbanPct!)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Urban share in Angola">
          <div><span class="y">1950</span><div class="v">{pct(y[1950].urbanPct!)}</div><span class="d">Urban</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">Urban today</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{pct(y[2050].urbanPct!)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>By how much does Angola grow in a year?</h2>
          <p>Around {millions(c.change)} in {CURRENT_YEAR}, a {pct(c.growthRatePct)} rise, nearly all from some {millions(c.births)} births set against about {int(Math.round(c.deaths / 1000))} thousand deaths. That leaves nearly nine times as many Angolans as in 1950, when there were {millions(y[1950].population)}.</p>
        </div>
        <LineChart
          title="Angola's population since 1950 and on to 2100"
          subtitle="UN mid-year figures; projected values dashed, climbing through 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How does Angola's age profile look?</h2>
          <p>Very young: a median of {dec(c.medianAge, 1)}, among the ten lowest of any country with over ten million people. The fertility rate, {dec(tfrMax.fertility, 2)} at its {tfrMax.year} peak, has come down to {dec(c.fertility, 2)} and stays above 2.1 through 2100 on the UN projection. Average life expectancy: {dec(c.lifeExpectancy, 1)} years.</p>
        </div>
        <LineChart
          title="Births per Angolan woman, 1950 onward and projected to 2050"
          subtitle="UN estimates with projected years dashed; reference at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Where could Angola rank by 2100?</h2>
          <p>{ord(y[2100].worldRank!)} globally and sixth on the continent, with {millions(y[2100].population)} people on the medium projection ({millions(y[2050].population)} in 2050). It already ranks second in Middle Africa, behind DR Congo.</p>
        </div>
        <RelatedPages iso3={ao.iso3} name={ao.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Angola's figures from 1950 to 2100"
          subtitle="Urban share passes one half in the 2000 row; fertility stays above 2.1 in every row."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ao.slug}-population.csv`)}
          csvName={`${ao.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Angola's population, briefly answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ao.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ao.published}>{longDate(ao.published)}</time> · Updated <time datetime={ao.updated}>{longDate(ao.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Angola population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Angola" code="ao" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
