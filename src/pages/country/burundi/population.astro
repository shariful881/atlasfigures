---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import bi from '../../../data/countries/burundi.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the second-densest large country in Africa;
// UN life-expectancy breaks in 1972 and 1993 and falling mid-year totals in 1972–1973, 1993 and 1997; net departures of
// about 685 thousand in 1993 followed by net arrivals of about 516 thousand in 1994; very young and still growing in
// 2100; an urban share more than tripled since 2000. Capitals cited from Britannica. Counts only.
const PAGE = '/country/burundi/population/';
const un = countryData(bi.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (bi.verification as any).checkedOn as string | undefined;
const BRIT_URL = 'https://kids.britannica.com/students/article/Gitega/624668';
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const afBig = big.filter((d: any) => d.region === 'Africa');
assertClaim([...afBig].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 2).map((d: any) => d.iso3).join() === 'RWA,BDI', 'second-densest large African country, after Rwanda');
assertClaim(y[1972].lifeExpectancy < 27 && y[1971].lifeExpectancy > 43 && y[1993].lifeExpectancy < 38 && y[1992].lifeExpectancy > 44, 'life-expectancy breaks in 1972 and 1993');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1972, 'lowest life expectancy 1972');
const drops = un.years.filter((r, i, a) => i > 0 && r.population < a[i - 1].population).map((r) => r.year);
assertClaim(drops.join() === '1972,1973,1993,1997', 'mid-year totals fell only in 1972, 1973, 1993, 1997');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 1993 && inTop.year === 1994, 'largest net departures 1993, largest net arrivals 1994');
const youngRank = [...big].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge).map((d: any) => d.iso3).indexOf('BDI');
const tfrRank = [...big].sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3).indexOf('BDI');
assertClaim(youngRank === 6 && tfrRank === 6, 'seventh-youngest and seventh-highest fertility among countries of ten million or more');
assertClaim(c.urbanPct! > 3.2 * y[2000].urbanPct! && un.years.find((r) => r.urbanPct != null && r.urbanPct > 50) === undefined, 'urban share more than tripled since 2000; no urban majority by 2050');
const gain = (d: any) => at(d).lifeExpectancy - at(d, 2000).lifeExpectancy;
assertClaim([...wpp].sort((a: any, b: any) => gain(b) - gain(a)).map((d: any) => d.iso3).indexOf('BDI') === 10, 'eleventh-largest life-expectancy gain since 2000');
const bTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bTop.year === 2015 && y[2100].population > y[2099].population, 'births high 2015; still growing in 2100');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1989 && under === 2095, 'fertility high 1989; under 2.1 from 2095');

const title = `Burundi's Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M on Some of Africa's Most Crowded Land | AtlasFigures`;
const description = `With ${int(c.densityPerKm2)} people per km² and ${millions(c.population)} in all (UN, ${CURRENT_YEAR}), Burundi is second in Africa's large countries only to Rwanda. Its UN series shows sharp breaks in 1972 and 1993.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Political capital', value: bi.capital },
    { label: 'Economic capital', value: 'Bujumbura' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, bi.tableYears);

const faq = [
  { q: 'Is Gitega or Bujumbura the capital of Burundi?', a: 'Gitega, named the political capital in 2019 according to Encyclopaedia Britannica; Bujumbura, the largest city, is the economic capital.' },
  { q: 'How many people live per km² in Burundi?', a: `${int(c.densityPerKm2)}; Rwanda is the only denser African nation above ten million.` },
  { q: 'Why do Burundi\'s life-expectancy figures dip in 1972 and 1993?', a: `Estimated life expectancy falls to ${dec(y[1972].lifeExpectancy, 1)} years in 1972 and ${dec(y[1993].lifeExpectancy, 1)} in 1993, while the 1 July total slips in 1972, 1973, 1993 and 1997. The UN files show the dips, not their causes.` },
  { q: 'What was the net migration in Burundi in 1993?', a: `Minus ${int(Math.round(-outTop.netMigrants / 1000))} thousand or so, the biggest outflow in the UN record; ${inTop.year} then shows the largest net inflow, close to ${int(Math.round(inTop.netMigrants / 1000))} thousand.` },
  { q: 'Does Burundi keep growing to 2100?', a: `Yes. On the UN's central projection the 2100 total, ${millions(y[2100].population)}, is still going up; fertility, ${dec(c.fertility, 2)} now, drops under 2.1 only in ${under}.` },
];

const schema = countrySchema({
  page: PAGE, slug: bi.slug, name: bi.name, wikipedia: bi.wikipedia,
  headline: `Burundi's ${millions(c.population)}: dense, very young, and marked by the 1972 and 1993 breaks in the UN series`,
  description,
  datasetName: 'Burundi population, life expectancy and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Burundi for selected years from 1950 to ${CURRENT_YEAR} (1971–1973 and 1992–1994 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: bi.published, updated: bi.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Gitega', url: BRIT_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Burundi"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Burundi", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Burundi: crowded hills and a very young population</h1>
        <LiveCounter
          label="Burundi: modelled head count now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} figure, growing by roughly ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Burundi fits <strong>{millions(c.population)}</strong> people (UN, {CURRENT_YEAR}) onto {int(un.landAreaKm2)} km², or <strong>{int(c.densityPerKm2)}</strong> per km², a crowding beaten in large African countries only by Rwanda. The median age there is a mere {dec(c.medianAge, 1)}.
        </p>
        <div class="dates"><span>Updated <time datetime={bi.updated}>{longDate(bi.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Burundi" code="bi" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How densely settled is Burundi?</h2>
          <p>Very: {int(c.densityPerKm2)} people per km², second only to neighbouring Rwanda among large African nations. Yet towns and cities hold just {pct(c.urbanPct!)} of the population on the national definition; that share has more than tripled from {pct(y[2000].urbanPct!)} in 2000, and even by 2050 ({pct(y[2050].urbanPct!)}) it stays below half.</p>
        </div>

        <div class="story-block prose">
          <h2>What breaks appear in Burundi's UN data for 1972 and 1993?</h2>
          <p>Two deep ones. Estimated life expectancy falls from {dec(y[1971].lifeExpectancy, 1)} in 1971 to {dec(y[1972].lifeExpectancy, 1)} in 1972, its lowest, and from {dec(y[1992].lifeExpectancy, 1)} in 1992 to {dec(y[1993].lifeExpectancy, 1)} in 1993. The 1 July total is lower than a year before in 1972, 1973, 1993 and 1997. In {outTop.year} the net outflow was about {int(Math.round(-outTop.netMigrants / 1000))} thousand; in {inTop.year} the balance swung to an inflow near {int(Math.round(inTop.netMigrants / 1000))} thousand. No causes are given in the UN files.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy at birth in Burundi, UN estimates">
          <div><span class="y">1971</span><div class="v">{dec(y[1971].lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">1972</span><div class="v">{dec(y[1972].lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Years</span></div>
        </div>
        <LineChart
          title="Burundi's population from 1950 to 2100"
          subtitle="1 July totals in UN data with the brief dips visible; medium variant dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How young is the average Burundian?</h2>
          <p>{dec(c.medianAge, 1)} years, the seventh-youngest of any country above ten million; fertility, {dec(c.fertility, 2)} children per woman, ranks seventh-highest in that group; it peaked at {dec(tfrTop.fertility, 2)} in {tfrTop.year} and the projection crosses 2.1 only in {under}. Annual births were greatest in {bTop.year}. Since 2000 life expectancy has gained {dec(gain({ years: un.years }), 1)} years and now stands at {dec(c.lifeExpectancy, 1)}.</p>
        </div>
        <LineChart
          title="Fertility in Burundi, 1950 to 2050"
          subtitle="Burundi's UN fertility series, a high in 1989, projection dashed; 2.1 for reference."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 births' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What is Burundi's capital?</h2>
          <p>Gitega. Encyclopaedia Britannica says it was named the political capital in 2019, while Bujumbura, the largest city, became the economic capital. Growth does not stop before 2100 in the medium variant, which ends at {millions(y[2100].population)}.</p>
        </div>
        <RelatedPages iso3={bi.iso3} name={bi.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Burundi by year, the early 1970s and early 1990s in detail"
          subtitle="Look at 1972 and 1993 for the breaks, and at 1993–1994 for the migration swing."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${bi.slug}-population.csv`)}
          csvName={`${bi.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Burundi in brief</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{bi.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={BRIT_URL}>Encyclopaedia Britannica, "Gitega"</a>: Gitega named political capital in 2019; Bujumbura the economic capital.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={bi.published}>{longDate(bi.published)}</time> · Updated <time datetime={bi.updated}>{longDate(bi.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Burundi population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Burundi" code="bi" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
