---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import kh from '../../../data/countries/cambodia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the 1975–1979 collapse in the UN series
// (population, life expectancy, births), with the Khmer Rouge period and death toll cited from Britannica; the 1974 total
// regained in 1988; a low of 85.9 men per 100 women in 1980; net arrivals 1992–1997; the largest life-expectancy gain in
// South-Eastern Asia since 2000; an urban share that doubled after 2010.
const PAGE = '/country/cambodia/population/';
const un = countryData(kh.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (kh.verification as any).checkedOn as string | undefined;
const BRIT_URL = 'https://www.britannica.com/question/What-was-the-impact-of-the-Khmer-Rouge-on-Cambodia';
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const pre = un.years.filter((r) => r.year < 1976).reduce((a, b) => (b.population > a.population ? b : a));
const low = un.years.filter((r) => r.year >= 1975 && r.year <= 1985).reduce((a, b) => (b.population < a.population ? b : a));
const back = un.years.find((r) => r.year > low.year && r.population > pre.population)!.year;
assertClaim(pre.year === 1974 && low.year === 1979 && back === 1988, '1974 high, 1979 low, 1974 level regained in 1988');
assertClaim([1975, 1976, 1977, 1978, 1979].every((n) => y[n].population < y[n - 1].population), 'mid-year totals fell every year 1975–1979');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1977 && y[1975].lifeExpectancy < 15 && y[1978].lifeExpectancy < 15 && y[1979].lifeExpectancy > 40, 'life expectancy under 15 in 1975–1978, lowest 1977');
const bLow = un.years.filter((r) => r.year >= 1974 && r.year <= 1980).reduce((a, b) => (b.births < a.births ? b : a));
const bTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bLow.year === 1977 && bLow.births < 0.55 * y[1974].births && bTop.year === 1994, 'births halved by 1977; high in 1994');
const srLow = un.years.reduce((a, b) => (b.male / b.female < a.male / a.female ? b : a));
assertClaim(srLow.year === 1980, 'fewest men per 100 women in 1980');
assertClaim([1992, 1993, 1994, 1995, 1996, 1997].every((n) => y[n].netMigrants > 0), 'net arrivals 1992–1997');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1996, 'largest net arrivals 1996');
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia');
const gain = (d: any) => at(d).lifeExpectancy - at(d, 2000).lifeExpectancy;
assertClaim([...sea].sort((a: any, b: any) => gain(b) - gain(a))[0].iso3 === 'KHM', 'largest life-expectancy gain in South-Eastern Asia since 2000');
assertClaim(c.urbanPct! > 1.9 * y[2010].urbanPct!, 'urban share nearly doubled since 2010');
assertClaim([...sea].sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3).indexOf('KHM') === 6, 'seventh in South-Eastern Asia');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2078, 'peak 2078');
assertClaim((pre.population - low.population) / pre.population > 0.23 && (pre.population - low.population) / pre.population < 0.27, 'about a quarter lost 1974–1979');
assertClaim(un.years.filter((r) => r.year > 1979 && r.year <= CURRENT_YEAR).every((r) => r.population > y[r.year - 1].population) && c.population > 3 * low.population, 'rising every year since 1979; more than three times the 1979 low');

const title = `Cambodia's Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M, Half a Century After the 1975–79 Collapse | AtlasFigures`;
const description = `Cambodia counts ${millions(c.population)} people (UN, ${CURRENT_YEAR}). Its UN series loses about a quarter of the population across the Khmer Rouge years (${millions(low.population)} by 1979), and the 1974 level regained only in 1988.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: kh.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Low (1979)', value: millionsShort(low.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, kh.tableYears);

const faq = [
  { q: 'By how much did Cambodia shrink under the Khmer Rouge?', a: `In the UN estimates the 1 July total shrank by ${dec((pre.population - low.population) / 1e6, 1)} million between 1974 and 1979, to ${millions(low.population)}. Britannica dates the regime to 1975–79 and puts the deaths it caused at no fewer than 1.5 million.` },
  { q: 'In what year was the 1974 total exceeded again?', a: `In ${back}, nine years after the 1979 low; the UN figure has risen every year since then.` },
  { q: 'Why was Cambodia so short of men around 1980?', a: `The UN data measure it (a sex ratio of ${dec((srLow.male / srLow.female) * 100, 1)} in ${srLow.year}) without explaining it; the ratio is ${dec((c.male / c.female) * 100, 1)} today.` },
  { q: 'How long do Cambodians live now?', a: `${dec(c.lifeExpectancy, 1)} years is today's life expectancy, up from ${dec(y[2000].lifeExpectancy, 1)} in 2000; no other South-Eastern Asian country has gained as much since.` },
  { q: 'How fast is Cambodia urbanising?', a: `Quickly: the urban share has nearly doubled since 2010, from ${pct(y[2010].urbanPct!)} to ${pct(c.urbanPct!)} by the national definition.` },
];

const schema = countrySchema({
  page: PAGE, slug: kh.slug, name: kh.name, wikipedia: kh.wikipedia,
  headline: `Cambodia's ${millions(c.population)}: the 1975–79 collapse in the UN series, a 1988 recovery and fast gains since`,
  description,
  datasetName: 'Cambodia population, births and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Cambodia for selected years from 1950 to ${CURRENT_YEAR} (every year 1974–1980 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: kh.published, updated: kh.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'What was the impact of the Khmer Rouge on Cambodia?', url: BRIT_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Cambodia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Cambodia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Cambodia: a population that collapsed in the 1970s and rebuilt</h1>
        <LiveCounter
          label="Cambodia: estimated people now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} anchor, rising by about ${int(c.change / 365)} per day`}
        />
        <p class="answer">
          Today's <strong>{millions(c.population)}</strong> Cambodians (UN estimate, {CURRENT_YEAR}) outnumber the <strong>{millions(low.population)}</strong> of {low.year} more than three to one. The UN series shows the population shrinking every year from 1975 to 1979 and passing its 1974 level again only in {back}.
        </p>
        <div class="dates"><span>Updated <time datetime={kh.updated}>{longDate(kh.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Cambodia" code="kh" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>What happened to Cambodia's population between 1975 and 1979?</h2>
          <p>It fell every year, from a mid-year estimate of {millions(pre.population)} in 1974 down to {millions(low.population)} by {low.year}. Britannica dates Khmer Rouge rule to 1975–79 and attributes at least 1.5 million deaths to it. The UN's estimated life expectancy at birth drops from {dec(y[1974].lifeExpectancy, 1)} in 1974 to {dec(leLow.lifeExpectancy, 1)} in {leLow.year} and returns to {dec(y[1979].lifeExpectancy, 1)} in 1979; yearly births drop to {int(Math.round(bLow.births / 1000))} thousand by {bLow.year}, about half the 1974 count.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy at birth in Cambodia, UN estimates">
          <div><span class="y">1974</span><div class="v">{dec(y[1974].lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">{leLow.year}</span><div class="v">{dec(leLow.lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Years</span></div>
        </div>
        <LineChart
          title="Cambodia's population from 1950: the late-1970s fall and the long climb"
          subtitle="Cambodia at 1 July in UN data, with 1974 to 1980 shown year by year; projection dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How quickly did Cambodia recover?</h2>
          <p>The total passed its 1974 level in {back}. Births climbed to their all-time high in {bTop.year} (roughly {int(Math.round(bTop.births / 1000))} thousand). Each year from 1992 to 1997 brought more arrivals than departures, with {inTop.year} the busiest at some {int(Math.round(inTop.netMigrants / 1000))} thousand; who the arrivals were is not part of the data. The sex ratio hit its low in {srLow.year}, {dec((srLow.male / srLow.female) * 100, 1)} males to 100 females, and is {dec((c.male / c.female) * 100, 1)} today.</p>
        </div>

        <div class="story-block prose">
          <h2>How has life in Cambodia changed since 2000?</h2>
          <p>Average lifespans have lengthened from {dec(y[2000].lifeExpectancy, 1)} to {dec(c.lifeExpectancy, 1)} years since 2000, the largest gain in South-Eastern Asia, while infant mortality has been cut from {dec(y[2000].infantMortalityPer1000!, 1)} to {dec(c.infantMortalityPer1000!, 1)} for each thousand born alive. Measured nationally, {pct(c.urbanPct!)} of Cambodians are urban, against {pct(y[2010].urbanPct!)} in 2010. Fertility is {dec(c.fertility, 2)}, and the medium variant's highest point is {millions(peak.population)} in {peak.year}; by population Cambodia ranks seventh in South-Eastern Asia.</p>
        </div>
        <RelatedPages iso3={kh.iso3} name={kh.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Cambodia, 1950–2100, with every year from 1974 to 1980"
          subtitle="Rows 1975 to 1979 each show a smaller total; by the 1988 row the 1974 level is passed."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${kh.slug}-population.csv`)}
          csvName={`${kh.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Cambodia: key questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{kh.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={BRIT_URL}>Encyclopaedia Britannica, "What was the impact of the Khmer Rouge on Cambodia?"</a>: the regime's years (1975–79) and the death toll of at least 1.5 million.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={kh.published}>{longDate(kh.published)}</time> · Updated <time datetime={kh.updated}>{longDate(kh.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Cambodia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Cambodia" code="kh" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
