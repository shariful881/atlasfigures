---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import kwt from '../../../data/countries/kuwait.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only (no causes): 1990 net departures
// of about 1.2 million, over half the 1989 population and the largest relative outflow of any 1M+ country since 1950;
// the 1991 net inflow; falls in 1990, 1991, 1994, 2020, 2021; about 33 times 1950, third after the UAE and Qatar;
// 156.5 men per 100 women; fully urban; growth to 2100.
const PAGE = '/country/kuwait/population/';
const un = countryData(kwt.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (kwt.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const share = -outTop.netMigrants / y[1989].population;
assertClaim(outTop.year === 1990 && share > 0.53 && share < 0.55, '1990 outflow about 54% of 1989 population');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const worst = (d: any) => Math.min(...Array.from({ length: CURRENT_YEAR - 1950 }, (_, i) => at(d, 1951 + i).netMigrants / at(d, 1950 + i).population));
assertClaim([...m1].sort((a: any, b: any) => worst(a) - worst(b))[0].iso3 === 'KWT', 'largest relative outflow of any 1M+ country');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1991, 'largest inflow 1991');
const falls = un.years.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1990,1991,1994,2020,2021', 'falls 1990, 1991, 1994, 2020, 2021');
assertClaim(y[2022].netMigrants > 3e5 && y[2020].netMigrants < 0, '2020 outflow, 2022 inflow');
const since = c.population / y[1950].population;
assertClaim(since > 32 && since < 34 && [...m1].sort((a: any, b: any) => at(b).population / at(b, 1950).population - at(a).population / at(a, 1950).population).slice(0, 3).map((d: any) => d.iso3).join() === 'ARE,QAT,KWT', 'about 33 times 1950, third after UAE and Qatar');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...m1].sort((a: any, b: any) => sr(b) - sr(a)).map((d: any) => d.iso3).indexOf('KWT') === 4, 'fifth-highest sex ratio');
assertClaim(c.urbanPct! >= 99.95, 'fully urban');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing 2100');

const title = `Kuwait Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Over Half Left in 1990, Thirty-Three-Fold Since 1950 | AtlasFigures`;
const description = `At ${millions(c.population)} in ${CURRENT_YEAR}, Kuwait has grown 33-fold since 1950 in UN figures. In 1990 net departures equalled over half of the 1989 population, proportionally the largest one-year outflow for any nation topping a million since 1950. The files hold counts, not causes.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: kwt.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, kwt.tableYears);

const faq = [
  { q: 'How large was the 1990 outflow from Kuwait?', a: `${millions(-outTop.netMigrants)} net, about 54% of the 1989 population, by UN estimate; Kuwait's total fell to ${millions(y[1990].population)} (1989: ${millions(y[1989].population)}). No reason is recorded.` },
  { q: 'Did people return to Kuwait afterwards?', a: `The 1991 net inflow, ${int(inTop.netMigrants)}, is the largest in the series, though the July 1991 total was still under 1990's.` },
  { q: 'Which countries have grown more than Kuwait since 1950?', a: `Only the United Arab Emirates and Qatar, if one counts countries holding a million or more. Kuwait started from ${int(y[1950].population)}.` },
  { q: 'Is Kuwait completely urban?', a: `Yes: ${pct(c.urbanPct!)} on the national definition used in World Urbanization Prospects 2025.` },
  { q: 'How wide is the sex gap in Kuwait?', a: `By a wide margin: ${dec((c.male / c.female) * 100, 1)} to 100, a ratio four million-plus nations exceed.` },
];

const schema = countrySchema({
  page: PAGE, slug: kwt.slug, name: kwt.name, wikipedia: kwt.wikipedia,
  headline: `Kuwait's ${millions(c.population)}: the 1990 outflow; a 1991 return flow; 33-fold growth since 1950`,
  description,
  datasetName: 'Kuwait population, net migration and sex ratio, 1950–2100',
  datasetDescription: `Mid-year population of Kuwait for selected years from 1950 to ${CURRENT_YEAR}, including 1989–1992, 1994 and 2019–2022, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: kwt.published, updated: kwt.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Kuwait"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Kuwait", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Kuwait: a city-state that lost half its people in a year</h1>
        <LiveCounter
          label="Kuwait: estimated population at present"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024, mid-${CURRENT_YEAR} level, plus approximately ${int(c.change / 365)} each day`}
        />
        <p class="answer">
          Thirty-three times more people live in Kuwait now than in 1950: <strong>{millions(c.population)}</strong> for {CURRENT_YEAR}, by UN estimate. Yet in 1990 alone net departures of <strong>{millions(-outTop.netMigrants)}</strong> removed over half the 1989 population.
        </p>
        <div class="dates"><span>Updated <time datetime={kwt.updated}>{longDate(kwt.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Kuwait" code="kw" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much of Kuwait's population left in 1990?</h2>
          <p>On balance {millions(-outTop.netMigrants)}, about 54% of the {millions(y[1989].population)} counted for 1989: proportionally the biggest single-year outflow any country of over a million has seen since 1950. July totals: {millions(y[1990].population)} in 1990, lower still in 1991 ({millions(y[1991].population)}); life expectancy slid to {dec(y[1990].lifeExpectancy, 1)} years. These are UN counts; the files carry no explanation.</p>
        </div>
        <div class="age-row" role="group" aria-label="Kuwait, mid-year totals 1989 to 1991 (UN)">
          <div><span class="y">1989</span><div class="v">{millionsShort(y[1989].population)}</div><span class="d">People</span></div>
          <div><span class="y">1990</span><div class="v">{millionsShort(y[1990].population)}</div><span class="d">People</span></div>
          <div><span class="y">1991</span><div class="v">{millionsShort(y[1991].population)}</div><span class="d">People</span></div>
        </div>

        <div class="story-block prose">
          <h2>How did Kuwait recover?</h2>
          <p>Through arrivals: {int(inTop.netMigrants)} net in 1991, the series high. Kuwait passed its 1989 total again in {un.years.find((r) => r.year > 1991 && r.population > y[1989].population)!.year}. A smaller setback followed in 2020–2021 ({int(-y[2020].netMigrants)} net leavers in 2020), then {int(y[2022].netMigrants)} net newcomers in 2022.</p>
        </div>
        <LineChart
          title="Kuwaiti head count from 1950, and the 1990 collapse"
          subtitle="1 July totals; projection after 2023 drawn dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Who lives in Kuwait today?</h2>
          <p>A mostly male population: {dec((c.male / c.female) * 100, 1)} men to each 100 women, fifth among million-plus nations. Everyone counts as urban ({pct(c.urbanPct!)}), density is {int(c.densityPerKm2)} per km², and no peak appears before 2100 ({millions(y[2100].population)}).</p>
        </div>
        <RelatedPages iso3={kwt.iso3} name={kwt.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Kuwait: 1989 to 1994 and 2019 to 2022 in detail"
          subtitle="The 1990 row shows the largest drop; 1991 the biggest net arrivals."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${kwt.slug}-population.csv`)}
          csvName={`${kwt.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Kuwait: the key numbers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{kwt.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={kwt.published}>{longDate(kwt.published)}</time> · Updated <time datetime={kwt.updated}>{longDate(kwt.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Kuwait population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Kuwait" code="kw" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
