---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ca from '../../../data/countries/canada.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a vast, thinly settled country built by immigration.
const PAGE = '/country/canada/population/';
const un = countryData(ca.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const us = byYear(countryData('USA').years)[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ca.verification as any).checkedOn as string | undefined;

const G7 = ['USA', 'CAN', 'GBR', 'DEU', 'FRA', 'ITA', 'JPN'];
const g7Growth = G7.map((iso) => ({ iso, g: byYear(countryData(iso).years)[CURRENT_YEAR].growthRatePct })).sort((a, b) => b.g - a.g);
assertClaim(g7Growth[0].iso === 'CAN', 'fastest-growing G7 country this year');
const migShare = (c.netMigrants / c.change) * 100;
assertClaim(migShare > 88 && migShare < 93, 'about nine tenths of growth from migration');
const est = un.years.filter((r) => !r.projection);
const migPeak = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(migPeak.year === 2022 && y[2023].growthRatePct > 1.2, 'record inflow in 2022; growth above 1.2% in 2023');
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const sparse = wpp.map((d: any) => ({ iso3: d.iso3, r: d.years.find((x: any) => x.year === CURRENT_YEAR) })).filter((e) => e.r.population > 30e6).sort((a, b) => a.r.densityPerKm2 - b.r.densityPerKm2);
assertClaim(sparse[0].iso3 === 'CAN', 'least densely populated country of more than 30 million people');
const byLand = [...wpp].sort((a: any, b: any) => b.landAreaKm2 - a.landAreaKm2).map((d: any) => d.iso3);
const landRank = byLand.indexOf('CAN') + 1;
assertClaim(landRank === 4, 'fourth-largest land area in the UN data');
const moreDeaths = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(un.years.filter((r) => r.year >= moreDeaths).every((r) => r.naturalChange < 0), 'deaths exceed births from then on');
assertClaim(un.years.every((r, i, a) => !i || r.population > a[i - 1].population), 'no peak before 2100');
const tfrPeak = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const subRep = un.years.find((r) => r.year > 1960 && r.fertility < 2.1)!.year;
assertClaim(un.years.filter((r) => r.year >= subRep).every((r) => r.fertility < 2.1), 'below 2.1 every year since');
assertClaim(c.fertility < us.fertility && c.medianAge > us.medianAge, 'fewer children and older than the US');
assertClaim(pct(y[2022].growthRatePct) === pct(y[2023].growthRatePct), 'same rounded growth in 2022 and 2023');
assertClaim(c.population / y[1950].population > 2.8 && c.population / y[1950].population < 3, 'nearly tripled since 1950');
assertClaim(['DEU', 'ITA', 'JPN'].every((iso) => byYear(countryData(iso).years)[CURRENT_YEAR].growthRatePct < 0) && g7Growth.filter((g) => g.g < 0).length === 3, 'Germany, Italy and Japan shrinking; the other four growing');
const usTimes = us.densityPerKm2 / c.densityPerKm2;

const title = `Canada's Population Reaches ${(c.population / 1e6).toFixed(1)} Million (${CURRENT_YEAR}): Growth Driven by Immigration | AtlasFigures`;
const description = `With about ${millions(c.population)} residents in ${CURRENT_YEAR}, Canada is the fastest-growing G7 country, with ${pct(migShare)} of its growth from migration. Density, fertility and the UN outlook for 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: dec(c.densityPerKm2, 1) },
    { label: 'Capital', value: ca.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Net migrants', value: `+${int(c.netMigrants)}` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'People per km²', value: dec(c.densityPerKm2, 1) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, ca.tableYears);

const faq = [
  { q: 'How many people live in Canada today?', a: `About ${millions(c.population)}, using the UN's mid-${CURRENT_YEAR} estimate. That places Canada ${ord(c.worldRank!)} among the world's countries by population.` },
  { q: "Is Canada's population growth slowing?", a: `Yes, from a recent high. Growth ran at about ${pct(y[2023].growthRatePct)} a year in 2022 and 2023, and the UN estimates ${pct(c.growthRatePct)} for ${CURRENT_YEAR}, still the highest rate among G7 countries.` },
  { q: 'How many immigrants does Canada add each year?', a: `Net migration, arrivals minus departures, is about ${int(Math.round(c.netMigrants / 1000))} thousand people in ${CURRENT_YEAR}. The UN's highest estimate was ${int(Math.round(migPeak.netMigrants / 1000))} thousand in ${migPeak.year}.` },
  { q: 'Why is Canada so sparsely populated?', a: `It spreads ${millions(c.population)} people over about ${millions(un.landAreaKm2)} km², the fourth-largest land area in the UN data. That works out to about ${dec(c.densityPerKm2, 1)} people per km², the lowest among nations of over 30 million inhabitants.` },
  { q: "What will Canada's population be in 2100?", a: `Around ${millions(y[2100].population)}, on the UN medium projection, with no peak before the end of the century. More deaths than births are expected from ${moreDeaths}, so the gains depend on migration.` },
];

const schema = countrySchema({
  page: PAGE, slug: ca.slug, name: ca.name, wikipedia: ca.wikipedia,
  headline: `Canada population ${CURRENT_YEAR}: ${millions(c.population)}, the G7's fastest growth and the emptiest large country`,
  description,
  datasetName: 'Canada population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Canada for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ca.published, updated: ca.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Canada"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Canada', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Canada's population and its newcomers</h1>
        <LiveCounter
          label="Canada's population right now (estimate)"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: 1 July ${CURRENT_YEAR} estimate, growing by around ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          Canada's population is about <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, spread across the world's {ord(landRank)}-largest land area. It is <strong>growing faster than any other G7 country</strong>, at {pct(c.growthRatePct)} a year, and about nine in ten of the new residents come from migration rather than births.
        </p>
        <div class="dates"><span>Updated <time datetime={ca.updated}>{longDate(ca.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Canada" code="ca" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Canada growing faster than the rest of the G7?</h2>
          <p>Immigration. Canada's {pct(c.growthRatePct)} growth in {CURRENT_YEAR} is the highest of the seven G7 economies; Germany, Italy and Japan are shrinking. The pace was even faster just after the pandemic: net migration hit a record {int(Math.round(migPeak.netMigrants / 1000))} thousand in {migPeak.year} by UN reckoning, and the population grew {pct(y[2023].growthRatePct)} in 2023.</p>
        </div>

        <div class="story-block prose">
          <h2>How much of Canada's growth comes from immigration?</h2>
          <p>{pct(migShare)} of it this year. Births this year number about <span data-exact>{int(c.births)}</span> against <span data-exact>{int(c.deaths)}</span> deaths — so births add only {int(Math.round(c.naturalChange / 1000))} thousand, while net migration contributes {int(Math.round(c.netMigrants / 1000))} thousand. From {moreDeaths} deaths are projected to exceed births every year, so after that every bit of growth will come from people moving to Canada.</p>
        </div>
        <LineChart
          title="Canada's population, 1950–2100"
          subtitle="Mid-year totals. Canada nearly tripled since 1950; the dashed part, still climbing in 2100, comes from the UN medium projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How empty is Canada?</h2>
          <p>Remarkably so for its size. Each square kilometre of land holds about {dec(c.densityPerKm2, 1)} people; no nation of over 30 million residents is more thinly settled. The United States, next door, is roughly {int(usTimes)} times as dense. Even so, {pct(c.urbanPct!)} of Canadians live in areas Canada classes as urban.</p>
        </div>

        <div class="story-block prose">
          <h2>How many children do Canadian women have?</h2>
          <p>{dec(c.fertility, 2)} on average in {CURRENT_YEAR}, well below the {dec(us.fertility, 2)} in the United States and far below the 2.1 that keeps a population stable without migration. It peaked at {dec(tfrPeak.fertility, 2)} in {tfrPeak.year} and has stayed beneath 2.1 from {subRep} onward.</p>
        </div>
        <LineChart
          title="Births per woman in Canada since 1950"
          subtitle="Total fertility rate; dashed figures are projected by the UN. The reference line marks 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Stable without migration: 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Canada's population getting older?</h2>
          <p>Yes. Half of all Canadians are older than {dec(c.medianAge, 1)} in {CURRENT_YEAR}, a median about {dec(c.medianAge - us.medianAge, 1)} years above the US one; in 1970 it was {dec(y[1970].medianAge, 1)}. Canadians can expect to live {dec(c.lifeExpectancy, 1)} years at birth. The UN projects a median age of {dec(y[2050].medianAge, 1)} by 2050.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Canada">
          <div><span class="y">1970</span><div class="v">{dec(y[1970].medianAge, 1)}</div><span class="d">A young country</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Older than the US</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Mid-forties</span></div>
        </div>
        <RelatedPages iso3={ca.iso3} name={ca.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Canada, 1950–2100: population and key measures"
          subtitle="Canada's population on 1 July alongside its density, fertility rate, median age and urban percentage by the national yardstick (until 2050), plus world rank; 2030 on are UN projections."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ca.slug}-population.csv`)}
          csvName={`${ca.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Canada's population: short answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, comparisons with other countries (G7: Canada, France, Germany, Italy, Japan, the United Kingdom, the United States) and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ca.published}>{longDate(ca.published)}</time> · Updated <time datetime={ca.updated}>{longDate(ca.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Canada population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Canada" code="ca" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
