---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/canada.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/canada/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, share } = B;
const us = econData('USA').series;
const bra = valueIn(econData('BRA').series.gdp, L)!;
const g = (y: number) => v('gdpGrowthPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const pc = (y: number) => v('gdpPerCapita', y)!;
const peakBefore = s.gdpPerCapita.filter(([y]) => y < 2021).reduce((a, b) => (b[1] > a[1] ? b : a));
const regained = s.gdpPerCapita.find(([y, x]) => y > peakBefore[0] && x > peakBefore[1])![0];
const trough = s.gdpPerCapita.filter(([y]) => y > peakBefore[0] && y < regained).reduce((a, b) => (b[1] < a[1] ? b : a));
const G7 = ['USA', 'GBR', 'DEU', 'JPN', 'FRA', 'ITA', 'CAN'];
const g7Unemp = G7.map((x) => ({ iso3: x, v: valueIn(econData(x).series.unemploymentPct, L)! })).sort((a, b) => b.v - a.v);
const usPc = valueIn(us.gdpPerCapita, L)!, usPpp = valueIn(us.gdpPerCapitaPpp, L)!;

assertClaim(B.gdpRank === 10 && rankBy('gdp', L)[10].iso3 === 'BRA' && gdp - bra < 50e9, 'tenth, just ahead of Brazil');
assertClaim(peakBefore[0] === 2012 && trough[0] === 2016 && regained === 2021, 'GDP per person peaked 2012, low 2016, regained 2021');
assertClaim(g7Unemp[0].iso3 === 'FRA' && g7Unemp[1].iso3 === c.iso3, 'second-highest unemployment in the G7');
assertClaim(s.unemploymentPct.filter(([y]) => y > 2021 && y < L).every(([, x]) => x < u(L)) && u(2021) > u(L), 'unemployment highest since 2021');
assertClaim(perHead / usPc > 0.6 && perHead / usPc < 0.65 && ppp! < usPpp, 'about 62% of the US level, still behind at PPP');
assertClaim(infl.year === L && v('inflationPct', 2022)! > 6.5 && infl.value / v('inflationPct', 2022)! > 0.28 && infl.value / v('inflationPct', 2022)! < 0.36, 'inflation about a third of the 2022 peak');
assertClaim(g(2020) < 0 && s.gdpGrowthPct.filter(([y, x]) => y > 2009 && x < 0).map(([y]) => y).join() === '2020', 'only 2020 contracted since 2009');

const title = `Canada Economy ${L}: GDP, Jobs and Income | AtlasFigures`;
const description = `Canada ranks tenth worldwide, its ${usd(gdp)} economy in ${L} just ahead of Brazil. Income per person is about three-fifths of the US level, and unemployment of ${pct(unemp!)} is the G7's second-highest.`;

const faq = [
  { q: 'Where does Canada rank among world economies?', a: `${ord(B.gdpRank!)}: its ${usd(gdp)} economy in ${L} was only ${usd(gdp - bra)} bigger than Brazil's.` },
  { q: 'Are Canadians poorer than Americans?', a: `On GDP per person, yes: ${usdWhole(perHead)} in Canada against ${usdWhole(usPc)} in the United States in ${L}. At purchasing power parity the figures are ${intDollars(ppp!)} and ${intDollars(usPpp)}.` },
  { q: 'Why did Canada\'s GDP per capita drop after 2012?', a: `In US dollars it fell from ${usdWhole(peakBefore[1])} in 2012 to ${usdWhole(trough[1])} in 2016 and only passed its old peak in ${regained}. Dollar figures move with the Canadian dollar's exchange rate as well as with output; the World Bank series does not separate the two.` },
  { q: 'What is Canada\'s jobless rate?', a: `Modelled ILO figures give ${pct(unemp!)} for ${L}, a rate not seen since 2021 and second only to France within the G7.` },
  { q: 'How much did prices rise in Canada?', a: `The annual rise was ${pct(infl.value)} in ${L}, about a third of the 2022 peak (${pct(v('inflationPct', 2022)!)}).` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Canada's economy ${L}: GDP of ${usd(gdp)}, income per person and unemployment`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Canada's economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Canada', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Canadian economy, by the numbers</h1>
        <p class="answer">
          Canada's output totalled <strong>{usd(gdp)}</strong> in {L}, ranking {ord(B.gdpRank!)} worldwide and working out at <strong>{usdWhole(perHead)} for each resident</strong>. Real growth was {pct(growth)} and unemployment rose to {pct(unemp!)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Canada economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Canada" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Canada is a wealthy country living next door to an even wealthier one. Its income per head in dollars took nine years to recover its 2012 high, and its jobless rate now sits near the top of the G7.</p>

        <div class="story-block prose">
          <h2>Is Canada a top 10 economy?</h2>
          <p>Only just. Output worth {usd(gdp)} in {L} placed it {ord(B.gdpRank!)}, with Brazil ({usd(bra)}) close behind in eleventh. Canada accounts for {pct(share)} of world output; the full order is on our <a href={path('/rankings/gdp-by-country/')}>GDP ranking</a>.</p>
        </div>

        <div class="story-block prose">
          <h2>How does Canada's income compare with the United States?</h2>
          <p>Output per resident was {usdWhole(perHead)} in {L}, about {Math.round((perHead / usPc) * 100)}% of the American {usdWhole(usPc)}. Adjusting for prices narrows the gap but does not close it: in purchasing-power terms Canada reaches {intDollars(ppp!)} and the US {intDollars(usPpp)}. More on the <a href={path('/country/united-states/economy/')}>US economy page</a>.</p>
        </div>

        <div class="story-block prose">
          <h2>What happened to Canada's GDP per capita after 2012?</h2>
          <p>Measured in US dollars it reached {usdWhole(peakBefore[1])} in 2012, sank to {usdWhole(trough[1])} by 2016 and did not top the 2012 mark again until {regained}. Because these are dollar figures, swings in the Canadian dollar's exchange rate are part of that path, not only changes in output.</p>
        </div>
        <LineChart
          title={`Canada's GDP per person, 1990–${L}`}
          subtitle="Output per resident in current US dollars."
          points={s.gdpPerCapita.filter(([y]) => y >= 1990).map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is unemployment rising in Canada?</h2>
          <p>Yes. The ILO's modelled rate climbed to {pct(unemp!)} in {L}, the highest since 2021, from {pct(u(2022))} in 2022. Among G7 countries only France ({pct(g7Unemp[0].v)}) had more of its workforce unemployed.</p>
        </div>
        <LineChart
          title={`Canada's unemployment rate, 1991–${L}`}
          subtitle="Share of the workforce without a job and looking for one."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How fast are Canadian prices and output growing?</h2>
          <p>Slowly on both counts. Canadian prices were up {pct(infl.value)} in {L}, after topping out at {pct(v('inflationPct', 2022)!)} in 2022. Real GDP grew {pct(growth)}; since 2009 the only year of decline was 2020, when output fell {pct(Math.abs(g(2020)))}.</p>
        </div>

        <nav class="related" aria-label="Related pages">
          <h2>More about Canada and North America</h2>
          <ul>
            <li><a href={path('/country/canada/population/')}>Canada's population</a></li>
            <li><a href={path('/country/united-states/economy/')}>The US economy</a></li>
            <li><a href={path('/country/mexico/population/')}>Mexico's population</a></li>
            <li><a href={path('/country/united-kingdom/economy/')}>The UK economy</a></li>
            <li><a href={path('/economy/')}>All country economies</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Canada's economy in figures, 1960–${L}`}
          subtitle="Includes the 2012 income peak and the 2016 low; every year is in the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/canada-economy.csv')} csvName="canada-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Canada's economy in brief</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), remittances, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Canada's national accounts are reported on a calendar-year basis (World Bank country notes). "G7" means Canada, France, Germany, Italy, Japan, the United Kingdom and the United States. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Canada's economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Canada" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
