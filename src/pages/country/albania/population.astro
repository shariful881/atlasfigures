---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import alb from '../../../data/countries/albania.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peak 1991 (3.28 million); net departures in
// every year from 1989 through the projection to 2100, the most in 1994; a fall in every year 1992–2026 except 2017;
// the largest gain in life expectancy since 1950 of any European country or area above a million (44.5 to 80.1);
// fertility from 6.54 (1955) to 1.32; births from a 1990 peak to the fewest of the series in 2026; urban majority
// only from 2009; 2100 at about 43% of today.
const PAGE = '/country/albania/population/';
const un = countryData(alb.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (alb.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991, 'peak 1991');
assertClaim(un.years.filter((r) => r.year >= 1989).every((r) => r.netMigrants < 0) && y[1988].netMigrants >= 0, 'net departures from 1989 to 2100');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1994, 'largest outflow 1994');
const ups = un.years.filter((r) => r.year > 1991 && r.year <= CURRENT_YEAR && r.population > y[r.year - 1].population).map((r) => r.year);
assertClaim(ups.join() === '2017', 'only rise 1992–2026 in 2017');
const eu = wpp.filter((d: any) => at(d).population >= 1e6 && d.region === 'Europe');
const gain = (d: any) => at(d).lifeExpectancy - at(d, 1950).lifeExpectancy;
assertClaim([...eu].sort((a: any, b: any) => gain(b) - gain(a))[0].iso3 === 'ALB', 'largest lifespan gain in Europe');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(tfrTop.year === 1955 && bTop.year === 1990 && bLow.year === CURRENT_YEAR && c.births < bTop.births / 3, 'fertility 1955, births 1990 to now');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2009, 'urban majority 2009');
assertClaim(y[2100].population / c.population > 0.42 && y[2100].population / c.population < 0.44, '2100 about 43%');
assertClaim(un.years.filter((r) => r.year >= 2002).every((r) => r.fertility < 2.1) && y[2001].fertility >= 2.1, 'under 2.1 from 2002');

const title = `Albania Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Adriatic Nation With Emigration Every Year Since 1989 | AtlasFigures`;
const description = `Albania counts ${millions(c.population)} this year (${CURRENT_YEAR}, UN), down from ${millions(peak.population)} (1991). Net emigration has occurred annually since 1989, while lifespans rose from ${dec(y[1950].lifeExpectancy, 1)} years (1950) to ${dec(c.lifeExpectancy, 1)}, the biggest gain in Europe.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: alb.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, alb.tableYears);

const faq = [
  { q: 'Since when has Albania had net emigration?', a: `Since 1989, without a break, and the UN projection continues it to 2100. The largest year was 1994, ${int(-outTop.netMigrants)} net. Motives go unrecorded.` },
  { q: "In what year did Albania's population top out?", a: `1991, with ${millions(peak.population)}. From 1992 to ${CURRENT_YEAR}, 2017 is the only year that rose.` },
  { q: 'By how many years has Albanian life expectancy risen since 1950?', a: `About 35: ${dec(y[1950].lifeExpectancy, 1)} then, ${dec(c.lifeExpectancy, 1)} today, more than any other European nation of a million-plus.` },
  { q: 'Albanian births: how far have they fallen?', a: `About ${int(c.births)} in ${CURRENT_YEAR}, under a third of the ${int(bTop.births)} recorded for 1990 and the lowest of any year since 1950.` },
  { q: 'Albania in 2100: projected size?', a: `${millions(y[2100].population)}, close to 43% of the current total.` },
];

const schema = countrySchema({
  page: PAGE, slug: alb.slug, name: alb.name, wikipedia: alb.wikipedia,
  headline: `Albania's ${millions(c.population)}: net emigration every year since 1989; a 1991 peak; Europe's largest lifespan gain since 1950`,
  description,
  datasetName: 'Albania population, net migration, births and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Albania for selected years from 1950 to ${CURRENT_YEAR}, including 1955, 1989–1994, 2002, 2009 and 2016–2018, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: alb.published, updated: alb.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Albania"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Albania", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Albania: longer lives, fewer people since 1991</h1>
        <LiveCounter
          label="Albania: current population, modelled"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Begins at the UN World Population Prospects 2024 total for mid-${CURRENT_YEAR}, then subtracts close to ${int(-c.change / 365)} a day`}
        />
        <p class="answer">
          For {CURRENT_YEAR}, Albania's UN total is <strong>{millions(c.population)}</strong>, below its 1991 maximum, <strong>{millions(peak.population)}</strong>. Outflows have exceeded inflows annually from 1989.
        </p>
        <div class="dates"><span>Updated <time datetime={alb.updated}>{longDate(alb.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Albania" code="al" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How long has net emigration from Albania lasted?</h2>
          <p>Since 1989, with no year off, and the UN projection carries it to 2100. The peak year was 1994, {int(-outTop.netMigrants)} net; {CURRENT_YEAR} expects {int(-c.netMigrants)}. From 1992 through {CURRENT_YEAR}, only 2017 saw the total rise. The source records numbers only, not causes.</p>
        </div>
        <LineChart
          title="Albania's population, 1950–2100, after the 1991 top"
          subtitle="July totals; dashes after 2023 show projections."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Which European nation gained the most years of life since 1950?</h2>
          <p>Albania, by some 35 years: life expectancy went from {dec(y[1950].lifeExpectancy, 1)} to {dec(c.lifeExpectancy, 1)}, the widest improvement of any European nation above a million.</p>
        </div>

        <div class="story-block prose">
          <h2>How sharply have Albanian births dropped?</h2>
          <p>They collapsed after a 1990 peak of {int(bTop.births)}; {CURRENT_YEAR} expects {int(c.births)}, the lowest of the series and under a third of that peak. Fertility, {dec(tfrTop.fertility, 2)} in 1955, dipped under 2.1 in 2002 and is {dec(c.fertility, 2)} now. Most Albanians have lived in towns only since 2009. Projections: {millions(y[2050].population)} as of 2050, then {millions(y[2100].population)} once 2100 arrives.</p>
        </div>
        <RelatedPages iso3={alb.iso3} name={alb.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Albania year rows: 1955, 1989–1994, 2002, 2009, 2016–2018"
          subtitle="Every row from 1989 shows net emigration; 2017 is the lone rise after 1991."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${alb.slug}-population.csv`)}
          csvName={`${alb.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Albania: the UN numbers, explained</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{alb.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={alb.published}>{longDate(alb.published)}</time> · Updated <time datetime={alb.updated}>{longDate(alb.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Albania population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Albania" code="al" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
