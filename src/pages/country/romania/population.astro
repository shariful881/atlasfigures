---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ro from '../../../data/countries/romania.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a 1991 peak and a 1 July total lower in every
// year since; natural decrease every year from 1993; fertility that nearly doubled from 1966 to 1967 (Decree 770, cited
// from Our World in Data); large net emigration with a 2008 high and a one-year inflow in 2022; below the 1950 level from
// 2047. Counts only beyond the cited decree.
const PAGE = '/country/romania/population/';
const un = countryData(ro.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ro.verification as any).checkedOn as string | undefined;
const OWID_URL = 'https://ourworldindata.org/the-human-cost-of-unsafe-abortions';
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991 && un.years.filter((r) => r.year > 1991).every((r, i, a) => r.population < (i === 0 ? peak.population : a[i - 1].population)), 'peak 1991; lower every year since');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 1993 && un.years.filter((r) => r.year >= 1993).every((r) => r.naturalChange < 0), 'natural decrease every year from 1993');
assertClaim(y[1966].fertility < 1.9 && y[1967].fertility > 3.5 && y[1967].births > 1.9 * y[1966].births, 'fertility and births nearly doubled 1966 to 1967');
const bTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.births > a.births ? b : a));
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const tfrLow = un.years.filter((r) => !r.projection).reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(bTop.year === 1967 && tfrTop.year === 1967 && tfrLow.year === 2002, 'births and fertility high 1967; fertility low 2002');
const outTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2008 && y[2022].netMigrants > 0 && un.years.filter((r) => r.year > 1991).filter((r) => r.change >= 0).map((r) => r.year).join() === '2022', 'largest outflow 2008; 2022 the only year of positive change since 1991');
const below1950 = un.years.find((r) => r.year > peak.year && r.population < y[1950].population)!.year;
assertClaim(below1950 === 2047, 'below the 1950 level from 2047');
const lostPct = (1 - c.population / peak.population) * 100;
assertClaim(lostPct > 18 && lostPct < 18.3, 'about 18% below the peak');
const eeu = wpp.filter((d: any) => d.subregion === 'Eastern Europe');
assertClaim([...eeu].sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3).indexOf('ROU') === 3, 'fourth in Eastern Europe');
assertClaim([...eeu].sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).slice(0, 2).map((d: any) => d.iso3).join() === 'MDA,ROU', 'second-lowest urban share in Eastern Europe, after Moldova');
const urbTop = un.years.filter((r) => r.year <= CURRENT_YEAR && r.urbanPct != null).reduce((a, b) => (b.urbanPct! > a.urbanPct! ? b : a));
assertClaim(urbTop.year === 1992, 'urban share highest in 1992');
assertClaim(un.years.filter((r) => r.netMigrants < 0).length > 100, 'net emigration in most years');

const title = `Romania's Shrinking Population: ${(c.population / 1e6).toFixed(1)}M in ${CURRENT_YEAR}, Down Every Year Since 1991 | AtlasFigures`;
const description = `Romania reached ${millions(peak.population)} in 1991 and has shrunk every year since, to ${millions(c.population)} (UN, ${CURRENT_YEAR}); natural decrease began in 1993, and by 2047 it is below its 1950 size.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ro.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Peak (1991)', value: millionsShort(peak.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, ro.tableYears);

const faq = [
  { q: "Why is Romania's population shrinking?", a: `The UN data show two drivers: natural decrease in each year from ${natNeg}, and departures have exceeded arrivals in most years, with the estimated peak outflow, about ${int(Math.round(-outTop.netMigrants / 1000))} thousand, in ${outTop.year}.` },
  { q: 'What was the highest population of Romania?', a: `${millions(peak.population)}, reached in ${peak.year}; today's count is some ${dec(lostPct, 1)}% below it.` },
  { q: 'What happened to births in Romania in 1967?', a: `They nearly doubled between 1966 and 1967, to some ${int(Math.round(y[1967].births / 1000))} thousand; Our World in Data links the jump to Decree 770, which tightly restricted abortion and contraception.` },
  { q: 'Will Romania fall below its 1950 population?', a: `Yes, from ${below1950} on the UN's medium assumptions; the 2100 projection, ${millions(y[2100].population)}, compares with ${millions(y[1950].population)} for 1950.` },
  { q: 'Was 2022 different for migration in Romania?', a: `On balance, yes: arrivals beat departures by roughly ${int(Math.round(y[2022].netMigrants / 1000))} thousand, making 2022 the lone post-1991 year with a positive UN annual change. Who arrived is not in the data.` },
];

const schema = countrySchema({
  page: PAGE, slug: ro.slug, name: ro.name, wikipedia: ro.wikipedia,
  headline: `Romania's ${millions(c.population)}: smaller every year since its 1991 peak, with natural decrease since 1993`,
  description,
  datasetName: 'Romania population, births and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Romania for selected years from 1950 to ${CURRENT_YEAR} (1966–1968, 1991, 2008 and 2022 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ro.published, updated: ro.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'The human cost of unsafe abortions', url: OWID_URL, publisher: 'Our World in Data' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Romania"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Romania", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Romania: a population shrinking since 1991</h1>
        <LiveCounter
          label="Romania: estimated residents now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, declining by close to ${int(-c.change / 365)} people a day`}
        />
        <p class="answer">
          Romania's population topped out at <strong>{millions(peak.population)}</strong> in {peak.year} and the UN's 1 July figure has been lower every year since; the {CURRENT_YEAR} estimate is <strong>{millions(c.population)}</strong>. Deaths have outnumbered births since {natNeg}.
        </p>
        <div class="dates"><span>Updated <time datetime={ro.updated}>{longDate(ro.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Romania" code="ro" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How many people has Romania lost since its 1991 peak?</h2>
          <p>About {dec(peak.population / 1e6 - c.population / 1e6, 1)} million, or {dec(lostPct, 1)}%: {millions(peak.population)} then, {millions(c.population)} now. From {natNeg} onward every year shows natural decrease; for {CURRENT_YEAR} the UN expects roughly {int(Math.round(c.deaths / 1000))} thousand deaths and {int(Math.round(c.births / 1000))} thousand births. Net emigration added to the loss, heaviest in {outTop.year} at about {int(Math.round(-outTop.netMigrants / 1000))} thousand. Only 2022, when net arrivals came to about {int(Math.round(y[2022].netMigrants / 1000))} thousand, shows a positive annual change, and even then the next 1 July total was lower. Who left or arrived is not recorded.</p>
        </div>
        <LineChart
          title="Romania, 1950–2100: growth to 1991, decline after"
          subtitle="UN mid-year totals; dashes mark the medium variant."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why did births in Romania double in 1967?</h2>
          <p>Our World in Data ties it to Decree 770, which put tight restrictions on abortion and contraception. In the UN series fertility jumps from {dec(y[1966].fertility, 2)} in 1966 to {dec(y[1967].fertility, 2)} in 1967, its highest ever, while births leap to roughly {int(Math.round(y[1967].births / 1000))} thousand from {int(Math.round(y[1966].births / 1000))} thousand, a record for one year. Fertility later sank to {dec(tfrLow.fertility, 2)} in {tfrLow.year}; it is {dec(c.fertility, 2)} now.</p>
        </div>
        <div class="age-row" role="group" aria-label="Births per woman in Romania">
          <div><span class="y">1966</span><div class="v">{dec(y[1966].fertility, 2)}</div><span class="d">Births per woman</span></div>
          <div><span class="y">1967</span><div class="v">{dec(y[1967].fertility, 2)}</div><span class="d">Births per woman</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.fertility, 2)}</div><span class="d">Births per woman</span></div>
        </div>
        <LineChart
          title="Births per woman in Romania: the 1967 spike and after"
          subtitle="UN births per woman to 2050; projection dashed; 2.1 as a reference."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 reference' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Romania end up smaller than in 1950?</h2>
          <p>Yes. In the medium variant the count sinks below 1950's {millions(y[1950].population)} in {below1950}, and by 2100 only {millions(y[2100].population)} remain. Romania is fourth in Eastern Europe by population. Its urban share, {pct(c.urbanPct!)} by the national definition, peaked in {urbTop.year} at {pct(urbTop.urbanPct!)} and is the second-lowest in the subregion after Moldova. The median age is {dec(c.medianAge, 1)}.</p>
        </div>
        <RelatedPages iso3={ro.iso3} name={ro.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Romania, 1950–2100, including 1966–1968, 1991 and 2022"
          subtitle="The 1967 row shows the fertility spike; 1991 is the peak; 2022 the one year of net inflow."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ro.slug}-population.csv`)}
          csvName={`${ro.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Romania: short answers on population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ro.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={OWID_URL}>Our World in Data, "The human cost of unsafe abortions"</a>: Decree 770 and its restrictions on abortion and contraception.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ro.published}>{longDate(ro.published)}</time> · Updated <time datetime={ro.updated}>{longDate(ro.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Romania population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Romania" code="ro" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
