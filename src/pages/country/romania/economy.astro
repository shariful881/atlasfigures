---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/romania.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/romania/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const slowing = [2022, 2023, 2024, L].every((y) => g(y) < g(y - 1)) && g(2021) > 5;
const loGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x < growth).map(([y]) => y));
const hi22Since = Math.max(...s.inflationPct.filter(([y, x]) => y < 2022 && x > i(2022)).map(([y]) => y));
const hiUSince = Math.max(...s.unemploymentPct.filter(([y, x]) => y < L && x > unemp!).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const remRank = rankBy('remittances', L).find((r) => r.iso3 === c.iso3)!.rank;
const remX = (rem!.value / v('remittances', 2015)!).toFixed(1);
const gdpX = Math.round(gdp / v('gdp', 2000)!);
const cze = valueIn(econData('CZE').series.gdp, L)!, pol = valueIn(econData('POL').series.gdp, L)!;

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 37 && B.e.incomeGroup === 'High income' && gdp > cze && gdp < pol / 2, 'record GDP; 37th; high income; between Czechia and Poland');
assertClaim(slowing && loGrowSince === 2020 && growth < 0.7, 'growth slowed four years running to the weakest since 2020');
assertClaim(infl.value > i(L - 1) && hi22Since === 2003 && i(2022) > 13.7 && iMax[0] === 1993 && iMax[1] > 255, 'inflation back up; 2022 highest since 2003; peak 1993');
assertClaim(hiUSince === 2015 && unemp! > 5.9, 'unemployment highest since 2015');
assertClaim(worst[0] === 1991 && worst[1] < -12.9 && s.gdp[0][0] === 1987, 'worst 1991; GDP from 1987');
assertClaim(isMax(s.remittances) && remRank === 22 && Number(remX) === 2.0 && gdpX === 12, 'record remittances 22nd, twice 2015; GDP about 12x 2000');

const title = `Romania Economy ${L}: Growth Slows to ${pct(growth)}, Inflation ${pct(infl.value)} | AtlasFigures`;
const description = `After a fourth consecutive slowdown Romania grew only ${pct(growth)} in ${L}, even as dollar GDP climbed to ${usd(gdp)}; consumer prices rose ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Romania\'s economy losing steam?', a: `Growth figures say so, though not why: ${pct(g(2021))} in 2021, then ${pct(g(2022))}, ${pct(g(2023))}, ${pct(g(2024))} and ${pct(growth)} in ${L} — the weakest result since 2020.` },
  { q: 'Does the World Bank count Romania as high income?', a: `It does. Each Romanian accounted for ${usdWhole(perHead)} of ${L} GDP (rank: ${ord(B.pcRank!)}), which converts to ${intDollars(ppp!)} in PPP terms.` },
  { q: 'How does Romania\'s economy compare with Poland and Czechia?', a: `Romanian GDP of ${usd(gdp)} exceeds Czechia\'s but is well under half of Poland\'s; worldwide it ranks ${ord(B.gdpRank!)}.` },
  { q: 'Is inflation in Romania rising again?', a: `Yes, modestly: ${pct(i(L - 1))} in ${L - 1}, then ${pct(infl.value)} in ${L}. Romania has not seen a rate above 2022\'s ${pct(i(2022))} since 2003, and 1993 holds the record at ${pct(iMax[1])}.` },
  { q: 'Are remittances into Romania at a record?', a: `Yes: ${usd(rem!.value)} for ${L}, double the 2015 figure, which ranks Romania ${ord(remRank)} among recipient countries.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Romania's economy in ${L}: record size, fading growth and stubborn inflation`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Romanian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Romania', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Romania's economy: bigger, but losing pace</h1>
        <p class="answer">
          Romania's GDP grew just <strong>{pct(growth)}</strong> in {L}, a fourth slowdown in a row, even as dollar output reached <strong>{usd(gdp)}</strong>; inflation rose to {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Romania economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Romania" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">The World Bank places Romania among high-income economies; it keeps growing — but more slowly each year since 2021.</p>

        <div class="story-block prose">
          <h2>Is Romania's economic growth fading?</h2>
          <p>Year by year, yes. Real GDP growth has slowed every year since 2021's {pct(g(2021))}, reaching {pct(growth)} in {L}, Romania's weakest outcome since 2020. Measured in current dollars, though, output set another record at {usd(gdp)}, around {gdpX} times its 2000 level.</p>
        </div>
        <LineChart
          title={`Real economic growth in Romania, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Constant-price GDP, % change from the prior year."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why has Romanian inflation not settled?</h2>
          <p>The data track the rate, not its drivers. After 2022's {pct(i(2022))} — Romania's steepest in almost two decades — and 2023's {pct(i(2023))}, prices rose {pct(i(L - 1))} in {L - 1} and then a faster {pct(infl.value)} in {L}. 1993's {pct(iMax[1])} remains the record.</p>
        </div>
        <div class="story-block prose">
          <h2>Where does Romania stand in Europe's economic league?</h2>
          <p>Romania's {usd(gdp)} output places it {ord(B.gdpRank!)} globally — bigger than Czechia, though well behind Poland. The World Bank counts it among high-income economies; per person, output was {usdWhole(perHead)}, {ord(B.pcRank!)} on the global list.</p>
        </div>
        <div class="story-block prose">
          <h2>Are jobs and remittances moving in different directions?</h2>
          <p>Joblessness on the ILO model rose to {pct(unemp!)}, a level not reached since 2015, yet money from Romanians abroad climbed to its highest yet, {usd(rem!.value)}. (Romania's dollar GDP series starts in 1987; the sharpest annual fall, {pct(Math.abs(worst[1]))}, came in 1991.)</p>
        </div>
        <LineChart
          title={`Romania's remittance receipts, ${s.remittances[0][0]}–${L}`}
          subtitle="Personal transfers plus compensation of employees received, current US$."
          points={s.remittances.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <nav class="related" aria-label="Related pages">
          <h2>Romania and Central Europe: related pages</h2>
          <ul>
            <li><a href={path('/country/romania/population/')}>Romania's population</a></li>
            <li><a href={path('/country/poland/economy/')}>Poland's economy</a></li>
            <li><a href={path('/country/ukraine/economy/')}>Ukraine's economy</a></li>
            <li><a href={path('/country/italy/economy/')}>Italy's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Romania's figures, selected years`}
          subtitle="Opens with 1987, when the GDP series begins, then 1991, 1993, 2000, 2004 and 2010 before annual rows from 2015; download for every year."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/romania-economy.csv')} csvName="romania-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Romania's economy: common questions answered</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank notes that for 1987–1992 multiple exchange rates in Romania are combined into an alternative conversion factor. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Romanian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Romania" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
