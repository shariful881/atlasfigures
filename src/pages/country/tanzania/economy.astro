---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/tanzania.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/tanzania/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const NORTH_AFRICA = ['DZA', 'EGY', 'LBY', 'MAR', 'TUN'];
const africa = rankBy('gdp', L).filter((r) => r.region === 'Sub-Saharan Africa' || NORTH_AFRICA.includes(r.iso3));
const aPos = africa.findIndex((r) => r.iso3 === c.iso3);
const uAsc = rankBy('unemploymentPct', L).slice().reverse();
const uPos = uAsc.findIndex((r) => r.iso3 === c.iso3) + 1;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const lastNeg = Math.max(...s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y));
const mult = (gdp / v('gdp', 2000)!).toFixed(1);
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 82, 'record GDP and per person; 82nd');
assertClaim(aPos === 11 && africa[aPos - 1].iso3 === 'COD' && africa[aPos + 1].iso3 === 'UGA', 'twelfth in Africa, just behind DR Congo, ahead of Uganda');
assertClaim(hiGrowSince === 2017 && [2021, 2022, 2023, 2024, L].every((y, k, a) => k === 0 || g(y) > g(a[k - 1])), 'growth faster each year since 2021, fastest since 2017');
assertClaim(lastNeg === 1983, 'growth every year since 1984');
assertClaim(uPos === 12 && unemp! < 2, 'twelfth-lowest unemployment, under 2%');
assertClaim(Number(mult) > 6.5 && Number(mult) < 7, 'about 6.7 times 2000');
assertClaim(infl.year === L && infl.value < 5 && [2018, 2019, 2020, 2021, 2022, 2023, 2024].every((y) => i(y) < 5) && iMax[0] === 1984, 'inflation under 5% since 2018; peak 1984');
assertClaim(gdp / v('gdp', 2015)! > 1.8 && gdp / v('gdp', 2015)! < 2.05 && gdp < valueIn(econData('KEN').series.gdp, L)!, 'nearly doubled since 2015; smaller than Kenya');
assertClaim(rem!.year === 2024 && net!.value > 30 && net!.value < 33, 'remittances 2024; about three in ten online');

const title = `Tanzania Economy ${L}: Growth Speeds Up for a Fifth Year | AtlasFigures`;
const description = `For a fifth year running Tanzania's growth quickened, reaching ${pct(growth)} in ${L}; output of ${usd(gdp)} is nearly level with DR Congo's. Inflation held at ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Tanzania\'s economy speeding up?', a: `Yes. The rate has gone up in each year after 2021 — ${pct(g(2021))}, then ${pct(g(2022))}, ${pct(g(2023))}, ${pct(g(2024))} and ${pct(growth)} — the last being the quickest since 2017.` },
  { q: 'Is Tanzania bigger than Kenya or DR Congo?', a: `Not in dollars. In ${L} Tanzania's ${usd(gdp)} trailed DR Congo's ${usd(africa[aPos - 1].value)} by a small margin and was smaller than Kenya's economy; it ranks ${ord(aPos + 1)} in Africa.` },
  { q: 'How much has Tanzania\'s GDP grown since 2000?', a: `About ${mult}-fold in current dollars: ${usd(v('gdp', 2000)!)} in 2000, ${usd(gdp)} in ${L}.` },
  { q: 'Does Tanzania really have under 2% unemployment?', a: `Only ${pct(unemp!)} of Tanzanians in the labour force were counted as jobless in ${L} (ILO), the ${ord(uPos)} smallest share globally. Anyone doing some paid or farm work, including informal work, is classed as employed.` },
  { q: 'What is the average output per Tanzanian?', a: `${usdWhole(perHead)} in ${L}, the highest so far, and ${intDollars(ppp!)} when local prices are equalised.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Tanzania's economy ${L}: five years of quickening growth and record output`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Tanzanian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Tanzania', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Tanzania's economy: growth that keeps quickening</h1>
        <p class="answer">
          Tanzania's real growth rose for a fifth straight year to <strong>{pct(growth)}</strong> in {L}, and GDP reached <strong>{usd(gdp)}</strong>, its largest yet. Prices went up {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Tanzania economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Tanzania" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Steady, accelerating growth has nearly doubled Tanzania's dollar output since 2015 and brought it level with DR Congo.</p>

        <div class="story-block prose">
          <h2>Is Tanzania's growth getting faster?</h2>
          <p>Year after year since 2021. Real growth climbed from {pct(g(2021))} that year to {pct(growth)} in {L}, a pace Tanzania had not beaten since 2017, and output has not fallen in any year since 1984.</p>
        </div>
        <LineChart
          title={`Tanzanian growth rate, 2000–${L}`}
          subtitle="Change in real GDP from the year before, %."
          points={s.gdpGrowthPct.filter(([y]) => y >= 2000).map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>How big is Tanzania's economy in dollars?</h2>
          <p>{usd(gdp)} in {L}, a new high and about {mult} times its size in 2000. That places it {ord(B.gdpRank!)} globally and {ord(aPos + 1)} in Africa, a whisker behind DR Congo and ahead of Uganda.</p>
        </div>
        <LineChart
          title={`Tanzania's GDP since 1960`}
          subtitle="Value of output in current US dollars."
          points={s.gdp.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why is the Tanzanian jobless rate so small?</h2>
          <p>Tanzania's ILO-modelled rate, {pct(unemp!)} in {L}, is {ord(uPos)} lowest anywhere. A smallholder or market trader is counted as employed, so only those entirely without work and searching for it show up as unemployed.</p>
        </div>
        <div class="story-block prose">
          <h2>How stable are prices in Tanzania?</h2>
          <p>Inflation was {pct(infl.value)} in {L} and has stayed below 5% each year from 2018 on — far from the {pct(iMax[1])} of 1984. Per inhabitant, output reached {usdWhole(perHead)} ({intDollars(ppp!)} with prices equalised), and {pct(net!.value)} of people were online.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Tanzania's neighbours and related pages</h2>
          <ul>
            <li><a href={path('/country/tanzania/population/')}>Tanzania's population</a></li>
            <li><a href={path('/country/kenya/economy/')}>Kenya's economy</a></li>
            <li><a href={path('/country/uganda/economy/')}>Uganda's economy</a></li>
            <li><a href={path('/country/dr-congo/economy/')}>DR Congo's economy</a></li>
            <li><a href={path('/rankings/gdp-by-country/')}>GDP of every country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Tanzania in numbers, 1960 to ${L} (selected years)`}
          subtitle="Picks out 1984, the first year of an unbroken growth run, plus every year from 2019; the CSV is complete."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/tanzania-economy.csv')} csvName="tanzania-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Tanzania's economy explained</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Africa" here means the World Bank's Sub-Saharan Africa region plus Algeria, Egypt, Libya, Morocco and Tunisia. Remittances for Tanzania run to 2024 in the World Bank files. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Tanzanian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Tanzania" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
