---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/papua-new-guinea.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/papua-new-guinea/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const pcPeak = s.gdpPerCapita.reduce((a, b) => (b[1] > a[1] ? b : a));
const hiSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x >= growth).map(([y]) => y));
const gRank = rankBy('gdpGrowthPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const iLow = s.inflationPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const forest = valueIn(s.forestPct, 2024)!; const forestRank = rankBy('forestPct', 2024).find((r) => r.iso3 === c.iso3)!.rank;
const netList = rankBy('internetPct', net!.year); const netLow = netList.length - netList.findIndex((r) => r.iso3 === c.iso3);
const men = valueIn(s.lfpMale, L)!, women = valueIn(s.lfpFemale, L)!;
const menList = rankBy('lfpMale', L); const menLow = menList.length - menList.findIndex((r) => r.iso3 === c.iso3);
const contractions = [2018, 2020, 2021].every((y) => g(y) < 0);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapitaPpp!) && pcPeak[0] === 2022 && perHead < pcPeak[1], 'record dollar GDP; per head below 2022 peak');
assertClaim(hiSince === 2022 && gRank === 37 && contractions, '5.6% best since 2022, 37th; falls 2018, 2020, 2021');
assertClaim(iLow[0] === 2024 && s.inflationPct[0][0] === 1972 && iMax[0] === 1974 && i(L) > 4, 'inflation low 0.6% in 2024 since 1972 start; peak 1974; 4.4% in 2025');
assertClaim(forestRank === 10 && forest > 75 && netLow === 9, 'forest 75.2%, 10th; internet 9th lowest');
assertClaim(menLow === 8 && men > women, "men's participation 8th lowest");
assertClaim(rem!.year === 2024 && rem!.value < 4e6, 'remittances tiny, 2024');

const title = `Papua New Guinea Economy ${L}: Output Up ${pct(growth)}, Incomes Lag 2022 | AtlasFigures`;
const description = `PNG's economy grew ${pct(growth)} in ${L}, its quickest since 2022, pushing dollar GDP to a new mark of ${usd(gdp)}. Per head, though, the ${usdWhole(perHead)} figure trails 2022.`;

const faq = [
  { q: 'Is Papua New Guinea\'s economy expanding?', a: `Yes — ${pct(growth)} for ${L}, ${ord(gRank)} of 186 economies and PNG's quickest pace since 2022. Real output contracted in 2018, 2020 and 2021.` },
  { q: 'How much is PNG\'s output per person?', a: `${usdWhole(perHead)} for ${L}, short of 2022's ${usdWhole(pcPeak[1])}; the PPP figure is ${intDollars(ppp!)}.` },
  { q: 'Did prices in Papua New Guinea rise faster in 2025?', a: `They did: ${pct(infl.value)}, after only ${pct(iLow[1])} in 2024, which was the lowest reading in a series dating from 1972. The record, ${pct(iMax[1])}, belongs to 1974.` },
  { q: 'Is most of Papua New Guinea covered by forest?', a: `Three-quarters of it: ${pct(forest)} of the land in 2024 on FAO estimates, which places PNG ${ord(forestRank)} in the world for forest share.` },
  { q: 'What share of PNG is online?', a: `Just under a fifth — ${pct(net!.value)} in ${net!.year} per the ITU — which ranks ${ord(netLow)}-lowest of ${netList.length} countries and areas.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Papua New Guinea's economy in ${L}: record dollar output, income per head still short of 2022`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="PNG economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Papua New Guinea', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Papua New Guinea's economy: faster growth, flat incomes</h1>
        <p class="answer">
          Real GDP in Papua New Guinea grew <strong>{pct(growth)}</strong> in {L} and dollar output hit a record <strong>{usd(gdp)}</strong>, though income per person remains below its 2022 level.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Papua New Guinea economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Papua New Guinea" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">The economy is expanding again after three contractions in four years, in one of the most forested and least connected countries on Earth.</p>

        <div class="story-block prose">
          <h2>Is Papua New Guinea's economy back on track?</h2>
          <p>On growth, it is. After shrinking in 2018, 2020 and 2021, PNG posted {pct(growth)} for {L} — {ord(gRank)} worldwide and its best showing since 2022. Valued in today's dollars, PNG's output has never been larger: {usd(gdp)}.</p>
        </div>
        <LineChart
          title={`PNG real growth by year, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Constant-price growth, % per year."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Has income per person regained its 2022 level?</h2>
          <p>Not in dollars: output per head is {usdWhole(perHead)}, still beneath the {usdWhole(pcPeak[1])} of 2022, even though PPP income ({intDollars(ppp!)}) is at a high. Consumer-price inflation was {pct(infl.value)}, a pickup from 2024's {pct(iLow[1])} — itself the lowest figure since the series opened in 1972.</p>
        </div>
        <div class="story-block prose">
          <h2>What makes Papua New Guinea stand out in world tables?</h2>
          <p>Forest and connectivity. Woodland covers {pct(forest)} of the land (FAO, 2024), {ord(forestRank)} highest anywhere; internet use, at {pct(net!.value)} in {net!.year}, is {ord(netLow)}-lowest of {netList.length}. ILO models put male labour force participation at {pct(men)} — {ord(menLow)} from the bottom — with women close behind at {pct(women)}. Remittance inflows are minor: {usd(rem!.value)} in {rem!.year}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Papua New Guinea and its neighbours: related pages</h2>
          <ul>
            <li><a href={path('/country/papua-new-guinea/population/')}>Papua New Guinea's population</a></li>
            <li><a href={path('/country/australia/economy/')}>Australia's economy</a></li>
            <li><a href={path('/country/indonesia/economy/')}>Indonesia's economy</a></li>
            <li><a href={path('/country/philippines/economy/')}>Philippines' economy</a></li>
            <li><a href={path('/rankings/forest-area-by-country/')}>Forest area by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`PNG economic statistics, 1960–2025`}
          subtitle="Every decade from 1960, plus 1972, 1993 and 1997, then 2015–2025; the CSV holds all years."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/papua-new-guinea-economy.csv')} csvName="papua-new-guinea-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">PNG economy: common questions answered</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Forest: AG.LND.FRST.ZS (FAO); labour force: SL.TLF.CACT.MA.ZS and SL.TLF.CACT.FE.ZS (ILO modelled estimates), via the World Bank. Remittance data end in 2024; inflation data start in 1972. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Papua New Guinea economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Papua New Guinea" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
