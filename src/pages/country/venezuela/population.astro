---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ve from '../../../data/countries/venezuela.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the estimate-year high in 2016, five years of
// decline 2017–2021 driven by net departures (2018: the largest net outflow of any country), slow regrowth since 2022,
// the 2016 level regained only in 2044, a second, projected peak in 2057. Counts only, no causes.
const PAGE = '/country/venezuela/population/';
const un = countryData(ve.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ve.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const est = un.years.filter((r) => r.year <= 2023);
const hi = est.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(hi.year === 2016, 'estimate-year high in 2016');
const falls = un.years.filter((r) => r.year <= 2030 && r.change < 0).map((r) => r.year);
assertClaim(falls.join() === '2017,2018,2019,2020,2021', 'population fell in each year 2017–2021');
const low = un.years.filter((r) => r.year > hi.year && r.year <= CURRENT_YEAR).reduce((a, b) => (b.population < a.population ? b : a));
assertClaim(low.year === 2022, 'mid-year low in 2022');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const world2018 = [...wpp].sort((a: any, b: any) => at(a, 2018).netMigrants - at(b, 2018).netMigrants)[0].iso3;
assertClaim(outTop.year === 2018 && world2018 === 'VEN', '2018: largest net outflow in the series and of any country that year');
const outSum = un.years.filter((r) => r.year >= 2015 && r.year <= CURRENT_YEAR).reduce((s, r) => s + r.netMigrants, 0);
assertClaim(outSum < -4.8e6 && outSum > -5e6 && un.years.filter((r) => r.year >= 2010 && r.year <= CURRENT_YEAR).every((r) => r.netMigrants < 0), 'net departures every year since 2010, about 4.9 million in 2015–2026');
const back = un.years.find((r) => r.year > hi.year && r.population > hi.population)!.year;
assertClaim(back === 2044, 'regains the 2016 level in 2044');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2057, 'projected peak 2057');
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(under === 2022 && un.years.filter((r) => r.year >= under).every((r) => r.fertility < 2.1), 'fertility under 2.1 since 2022');
const sam = wpp.filter((d: any) => d.subregion === 'South America').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(sam.indexOf('VEN') === 4, 'fifth in South America');
assertClaim(y[2010].worldRank === 41 && c.worldRank === 54 && y[2100].worldRank === 66, 'rank 41 in 2010, 54 now, 66 in 2100');
assertClaim(c.change > 0 && c.naturalChange > -c.netMigrants, 'growing again: natural increase larger than net departures');

const title = `Venezuela Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M, Below Its 2016 High | AtlasFigures`;
const description = `By UN estimate Venezuela holds ${millions(c.population)} people in ${CURRENT_YEAR}, against ${millions(hi.population)} in 2016. It shrank in each year 2017–2021; the medium variant regains the 2016 level only in ${back}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ve.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: '2016 high', value: millionsShort(hi.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: `Peak, ${peak.year}`, value: millionsShort(peak.population) },
];

const rows = displayRows(un.years, ve.tableYears);

const faq = [
  { q: 'How large is Venezuela\'s population today?', a: `${millions(c.population)} is the UN's mid-${CURRENT_YEAR} figure. Venezuela comes ${ord(c.worldRank!)} worldwide and fifth within South America.` },
  { q: "Has Venezuela's population gone down?", a: `Yes. From ${millions(hi.population)} in 2016 it shrank in each year 2017–2021 by the UN's count, with the low point, ${millions(low.population)}, in the 2022 estimate.` },
  { q: 'How many more people left Venezuela than arrived?', a: `About ${millions(-outSum)} on balance between 2015 and ${CURRENT_YEAR}, adding up the UN's yearly figures. ${outTop.year} alone accounts for roughly ${millions(-outTop.netMigrants)}, the largest net outflow of any country that year.` },
  { q: 'Is Venezuela growing again?', a: `Slowly, by ${pct(c.growthRatePct)} in ${CURRENT_YEAR}. Births outpace deaths by about ${int(Math.round(c.naturalChange / 1000))} thousand, more than the ${int(Math.round(-c.netMigrants / 1000))} thousand lost to net emigration.` },
  { q: 'When will Venezuela get back to its 2016 population?', a: `${back}, on the UN's central projection. A later maximum, ${millions(peak.population)}, arrives in ${peak.year}, and 2100 closes at ${millions(y[2100].population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: ve.slug, name: ve.name, wikipedia: ve.wikipedia,
  headline: `Venezuela's ${millions(c.population)}: five years of decline, net departures and a slow recovery`,
  description,
  datasetName: 'Venezuela population, net migration and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Venezuela for selected years from 1950 to ${CURRENT_YEAR} (each year 2015–2022 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ve.published, updated: ve.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Venezuela"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Venezuela', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Venezuela: five years of decline, then a slow recovery</h1>
        <LiveCounter
          label="Venezuela: current population, modelled"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} starting point, near ${int(c.change / 365)} more per day`}
        />
        <p class="answer">
          With <strong>{millions(c.population)}</strong> residents according to UN figures for {CURRENT_YEAR}, Venezuela is still smaller than in 2016 (<strong>{millions(hi.population)}</strong>). It shrank in each year from 2017 to 2021, with net emigration heaviest in {outTop.year} at around {millions(-outTop.netMigrants)}. Not until {back} does the UN's central path climb back to the 2016 figure.
        </p>
        <div class="dates"><span>Updated <time datetime={ve.updated}>{longDate(ve.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Venezuela" code="ve" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How large were Venezuela's net departures?</h2>
          <p>At their height, the largest in the world. In the UN's yearly figures, emigration has exceeded immigration in each year since 2010, and from 2015 to {CURRENT_YEAR} the cumulative net outflow comes to about {millions(-outSum)}. The biggest single year, {outTop.year}, saw net departures of roughly {millions(-outTop.netMigrants)}, more than for any other country that year. The UN series measures the flows only; it says nothing about who moved or for what reason.</p>
        </div>
        <div class="age-row" role="group" aria-label="Net migration in Venezuela, UN estimates">
          <div><span class="y">2016</span><div class="v">−{int(Math.round(-y[2016].netMigrants / 1000))}k</div><span class="d">Net departures</span></div>
          <div><span class="y">{outTop.year}</span><div class="v">−{(-outTop.netMigrants / 1e6).toFixed(2)}M</div><span class="d">Net departures</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">−{int(Math.round(-c.netMigrants / 1000))}k</div><span class="d">Net departures</span></div>
        </div>
        <LineChart
          title="Venezuela's population, 1950–2100, with the 2017–2021 dip"
          subtitle="UN mid-year totals; every year from 2015 to 2022 is plotted, and the projection is dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Venezuela's population rising again?</h2>
          <p>Yes, modestly, since 2022, when the mid-year total bottomed out at {millions(low.population)}. In the current year births top deaths by some {int(Math.round(c.naturalChange / 1000))} thousand while net emigration takes roughly {int(Math.round(-c.netMigrants / 1000))} thousand, leaving growth of {pct(c.growthRatePct)}. The projection does not get back to the 2016 level until {back}; its eventual high of {millions(peak.population)} arrives in {peak.year}.</p>
        </div>

        <div class="story-block prose">
          <h2>How has Venezuela's age profile changed since 2016?</h2>
          <p>It has aged quickly. The median Venezuelan was {dec(y[2016].medianAge, 1)} in 2016 and is {dec(c.medianAge, 1)} now, while annual births dropped from roughly {int(Math.round(y[2016].births / 1000))} thousand to {int(Math.round(c.births / 1000))} thousand. Fertility dropped under 2.1 in {under} and is {dec(c.fertility, 2)} this year.</p>
        </div>
        <LineChart
          title="Births per Venezuelan woman since 1950, projected to 2050"
          subtitle="UN estimates and the medium-variant continuation (dashed), with the 2.1 benchmark."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'benchmark 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Venezuela slipped down the world population list?</h2>
          <p>Yes: it is {ord(c.worldRank!)} now, against {ord(y[2010].worldRank!)} in 2010, though still fifth within South America. The UN projection has it at {ord(y[2100].worldRank!)} by 2100, when the population is {millions(y[2100].population)}. Nearly everyone lives in urban areas: {pct(c.urbanPct!)} by the national definition.</p>
        </div>
        <RelatedPages iso3={ve.iso3} name={ve.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Venezuela: yearly rows 2015–2022 and long-run figures"
          subtitle="Year-by-year rows trace the 2017–2021 decline; projections follow the estimate years."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ve.slug}-population.csv`)}
          csvName={`${ve.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions on Venezuela's population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ve.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ve.published}>{longDate(ve.published)}</time> · Updated <time datetime={ve.updated}>{longDate(ve.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Venezuela population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Venezuela" code="ve" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
