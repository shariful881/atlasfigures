---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import kgz from '../../../data/countries/kyrgyzstan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: net departures through the 1990s
// (largest 1993) and net arrivals since 2016; fertility that rose from 2.55 in 2001 to 3.33 in 2019 before easing;
// births also peaking in 2019; an urban share that peaked in 1979 and never reaches a majority; growth through 2100.
const PAGE = '/country/kyrgyzstan/population/';
const un = countryData(kgz.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (kgz.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1993 && -outTop.netMigrants > 1e5, 'largest net outflow 1993, above 100,000');
const run = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
assertClaim(run(1990, 1999).every((n) => y[n].netMigrants < 0) && run(2016, CURRENT_YEAR).every((n) => y[n].netMigrants >= 0) && y[2015].netMigrants < 0, 'departures through the 1990s, arrivals since 2016');
assertClaim(un.years.find((r) => r.year > CURRENT_YEAR && r.netMigrants < 0)?.year === 2028, 'projection turns negative again in 2028');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2020, 'largest inflow 2020');
const low = un.years.filter((r) => r.year >= 1990 && r.year <= 2010).reduce((a, b) => (b.fertility < a.fertility ? b : a));
const high = un.years.filter((r) => r.year >= 2005 && r.year <= CURRENT_YEAR).reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(low.year === 2001 && high.year === 2019 && high.fertility - low.fertility > 0.6 && c.fertility < high.fertility - 0.4, 'fertility low 2001, high 2019, lower now');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2019, 'births peak 2019');
const urbTop = un.years.filter((r) => r.year <= CURRENT_YEAR && r.urbanPct != null).reduce((a, b) => (b.urbanPct! > a.urbanPct! ? b : a));
assertClaim(urbTop.year === 1979 && un.years.every((r) => r.urbanPct == null || r.urbanPct < 50), 'urban high 1979, never a majority');
const cas = wpp.filter((d: any) => d.subregion === 'Central Asia');
assertClaim([...cas].sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).slice(0, 2).map((d: any) => d.iso3).join() === 'TJK,KGZ', 'second-least urban in Central Asia');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
assertClaim(y[1990].male / y[1990].female < 0.91 && c.male / c.female > 0.97, 'sex ratio 90.5 in 1990, 97.7 now');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2061, 'under 2.1 in 2061');

const title = `Kyrgyzstan Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): From Departures to Arrivals, and a Fertility Rebound | AtlasFigures`;
const description = `Kyrgyzstan's ${CURRENT_YEAR} UN estimate is ${millions(c.population)}. Net departures ran through the 1990s and net arrivals since 2016; fertility climbed from ${dec(low.fertility, 2)} in 2001 to ${dec(high.fertility, 2)} in ${high.year}, and growth continues past 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: kgz.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, kgz.tableYears);

const faq = [
  { q: 'Did Kyrgyzstan lose people to migration in the 1990s?', a: `Yes, on balance, in each year of that decade; the biggest loss, ${int(-outTop.netMigrants)}, came in 1993. Since 2016 the balance has been zero or positive, highest in 2020 at ${int(inTop.netMigrants)}. The data carry no reasons.` },
  { q: 'Did fertility in Kyrgyzstan go up?', a: `Yes, for a time: ${dec(low.fertility, 2)} in ${low.year}, ${dec(high.fertility, 2)} in ${high.year}, and ${dec(c.fertility, 2)} now.` },
  { q: 'When were births highest in Kyrgyzstan?', a: `In ${birthTop.year}, at ${int(birthTop.births)}; this year's projection is ${int(c.births)}.` },
  { q: 'Are most Kyrgyz town dwellers?', a: `No: ${pct(c.urbanPct!)} now; the high point was ${pct(urbTop.urbanPct!)}, reached in ${urbTop.year}; in Central Asia only Tajikistan has a smaller share.` },
  { q: 'Will Kyrgyzstan ever stop growing?', a: `Not this century; the projection rises every step of the way to ${millions(y[2100].population)} in 2100.` },
];

const schema = countrySchema({
  page: PAGE, slug: kgz.slug, name: kgz.name, wikipedia: kgz.wikipedia,
  headline: `Kyrgyzstan's ${millions(c.population)}: 1990s departures, arrivals since 2016; a fertility rebound and growth through 2100`,
  description,
  datasetName: 'Kyrgyzstan population, net migration and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Kyrgyzstan for selected years from 1950 to ${CURRENT_YEAR}, including 1992–1994, 2016 and 2019–2020, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: kgz.published, updated: kgz.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Kyrgyzstan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Kyrgyzstan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Kyrgyzstan: a turn in migration and a rise in births</h1>
        <LiveCounter
          label="Kyrgyzstan: estimated population at this point"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Uses the UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, growing by some ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          For {CURRENT_YEAR}, UN figures place Kyrgyzstan at <strong>{millions(c.population)}</strong>, more than four times the 1950 figure. After a decade of net departures in the 1990s, the country has not had a net migration loss in any year since 2016.
        </p>
        <div class="dates"><span>Updated <time datetime={kgz.updated}>{longDate(kgz.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Kyrgyzstan" code="kg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How did migration change for Kyrgyzstan?</h2>
          <p>It flipped. Between 1990 and 1999 departures exceeded arrivals every year, {int(-y[1992].netMigrants)} in 1992 and most of all {int(-outTop.netMigrants)} in 1993. From 2016 to {CURRENT_YEAR} the balance is zero or positive, reaching {int(inTop.netMigrants)} in 2020; the projection turns it negative again from 2028. The figures give counts only. Meanwhile the sex ratio moved from {dec((y[1990].male / y[1990].female) * 100, 1)} in 1990 to {dec((c.male / c.female) * 100, 1)} today.</p>
        </div>
        <div class="age-row" role="group" aria-label="Kyrgyzstan, net migration in 1993, 2010 and 2020 (UN)">
          <div><span class="y">1993</span><div class="v">{int(-y[1993].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">2010</span><div class="v">{int(-y[2010].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">2020</span><div class="v">{int(y[2020].netMigrants)}</div><span class="d">Net arrivals</span></div>
        </div>

        <div class="story-block prose">
          <h2>Why did Kyrgyz fertility climb after 2001?</h2>
          <p>Only the climb itself is recorded: {dec(low.fertility, 2)} per woman in {low.year}, {dec(high.fertility, 2)} by {high.year}, and {dec(c.fertility, 2)} now. Kyrgyz births hit their record, {int(birthTop.births)}, in {birthTop.year}. The projection keeps the rate above 2.1 until {repl}.</p>
        </div>
        <LineChart
          title="Fertility in Kyrgyzstan, 1950–2050, with the 2000s rebound"
          subtitle="Solid line for UN estimates through 2023, dashed for the projection; 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'mark 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Kyrgyzstan's urban share risen?</h2>
          <p>Not past its old high. By the national definition the share peaked in {urbTop.year} at {pct(urbTop.urbanPct!)}; it has a current level of {pct(c.urbanPct!)}, and the share projected for 2050, {pct(y[2050].urbanPct!)}, still falls short of it; only Tajikistan is less urban in Central Asia. The total keeps climbing all the same: {millions(y[2050].population)} around 2050, then {millions(y[2100].population)} when the century closes.</p>
        </div>
        <RelatedPages iso3={kgz.iso3} name={kgz.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Kyrgyzstan by year, 1992–1994 and the 2010s"
          subtitle="Net migration turns from negative to positive between the 1990s and 2016 rows."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${kgz.slug}-population.csv`)}
          csvName={`${kgz.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Kyrgyzstan, briefly</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{kgz.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={kgz.published}>{longDate(kgz.published)}</time> · Updated <time datetime={kgz.updated}>{longDate(kgz.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Kyrgyzstan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Kyrgyzstan" code="kg" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
