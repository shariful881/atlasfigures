---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import aze from '../../../data/countries/azerbaijan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: a tripling since 1950; the early-1990s
// dips in life expectancy and the 1989 net outflow (no causes given); fertility from 5.96 in 1962 to under 2.1 in 1996;
// a sex ratio that dipped below 89 men per 100 women in 1999; growth until a 2050 peak.
const PAGE = '/country/azerbaijan/population/';
const un = countryData(aze.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (aze.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const times = c.population / y[1950].population;
assertClaim(c.growthRatePct < 0.5 * y[1990].growthRatePct, 'growth less than half the 1990 rate');
assertClaim(times > 3.2 && times < 3.4, 'more than three times 1950');
assertClaim(y[1992].lifeExpectancy < y[1991].lifeExpectancy - 1.5 && y[1994].lifeExpectancy < y[1993].lifeExpectancy - 1 && y[1996].lifeExpectancy > y[1991].lifeExpectancy, 'dips 1992 and 1994, recovered 1996');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1989 && -outTop.netMigrants > 1e5, 'largest net outflow 1989, over 100,000');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1996, 'largest net inflow 1996');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1962 && repl === 1996, 'fertility high 1962, under 2.1 in 1996');
const srLow = un.years.filter((r) => r.year >= 1980 && r.year <= CURRENT_YEAR).reduce((a, b) => (b.male / b.female < a.male / a.female ? b : a));
assertClaim(srLow.year === 1999, 'lowest sex ratio since 1980 in 1999');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2050 && natNeg === 2049, 'peak 2050, natural decrease from 2049');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1988, 'births peak 1988');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1968 && Math.abs(y[2050].urbanPct! - c.urbanPct!) < 1, 'urban majority 1968; share nearly flat to 2050');
const w1 = wpp.filter((d: any) => d.subregion === 'Western Asia' && at(d).population >= 1e6);
assertClaim([...w1].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000).map((d: any) => d.iso3).indexOf('AZE') === 3, 'fourth-highest infant mortality in Western Asia, 1M+');
const was = wpp.filter((d: any) => d.subregion === 'Western Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(was.indexOf('AZE') === 7, 'eighth in Western Asia');

const title = `Azerbaijan Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Tripled Since 1950, Peaking by Mid-Century | AtlasFigures`;
const description = `On UN estimates Azerbaijan has ${millions(c.population)} inhabitants in ${CURRENT_YEAR}, over three times its 1950 count. Fertility fell from ${dec(tfrTop.fertility, 2)} in 1962 to under 2.1 by 1996; the projection has growth ending in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: aze.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, aze.tableYears);

const faq = [
  { q: 'Has Azerbaijan tripled in size since 1950?', a: `A little more than that: in 1950 the UN counted ${millions(y[1950].population)}, under a third of today's number.` },
  { q: 'Did more people leave Azerbaijan around 1990?', a: `On UN estimates, net departures were ${int(-y[1988].netMigrants)} in 1988 and ${int(-outTop.netMigrants)} in 1989, the largest outflow on record, and a net inflow of ${int(inTop.netMigrants)} in 1996. It gives no reasons.` },
  { q: "In what year does Azerbaijan's growth end?", a: `Around ${peak.year}, at ${millions(peak.population)}; from ${natNeg} the projection has slightly more deaths than births.` },
  { q: 'How many children do women in Azerbaijan have?', a: `${dec(c.fertility, 2)} on average in ${CURRENT_YEAR}. The figure was ${dec(tfrTop.fertility, 2)} in ${tfrTop.year} and dropped under 2.1 in ${repl}.` },
  { q: 'Is the Azerbaijani population mostly female?', a: `Yes. The UN gives ${dec((c.male / c.female) * 100, 1)} men to 100 women at present; its most recent low, ${dec((srLow.male / srLow.female) * 100, 1)}, came in ${srLow.year}.` },
];

const schema = countrySchema({
  page: PAGE, slug: aze.slug, name: aze.name, wikipedia: aze.wikipedia,
  headline: `Azerbaijan's ${millions(c.population)}: threefold growth since 1950, the early-1990s dips, and a peak in ${peak.year}`,
  description,
  datasetName: 'Azerbaijan population, fertility and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Azerbaijan for selected years from 1950 to ${CURRENT_YEAR} (every year 1988–1996 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: aze.published, updated: aze.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Azerbaijan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Azerbaijan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Azerbaijan: three times its 1950 size, nearing a plateau</h1>
        <LiveCounter
          label="Azerbaijan: estimated population as it stands"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Projected from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, about ${int(c.change / 365)} added daily`}
        />
        <p class="answer">
          Azerbaijan, with <strong>{millions(c.population)}</strong> inhabitants ({CURRENT_YEAR}, UN reckoning), has grown more than threefold since 1950. Growth has slowed sharply, and the medium variant expects it to stop around {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={aze.updated}>{longDate(aze.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Azerbaijan" code="az" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has fertility in Azerbaijan fallen below replacement?</h2>
          <p>Yes, since {repl}. It went from {dec(tfrTop.fertility, 2)} per woman at the {tfrTop.year} high to {dec(y[1990].fertility, 2)} in 1990, and below 2.1 by {repl}; it is {dec(c.fertility, 2)} today. The most births in a year, {int(birthTop.births)}, came in {birthTop.year}; the {CURRENT_YEAR} projection is {int(c.births)}.</p>
        </div>
        <LineChart
          title="Azerbaijani fertility rate, 1950 estimates to 2050"
          subtitle="UN estimates, with the 1962 high and the 1996 crossing of 2.1; the projection is dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'line at 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What changed in Azerbaijan's numbers around 1990?</h2>
          <p>Departures surged and life expectancy dipped twice. Net emigration was {int(-y[1988].netMigrants)} in 1988 and {int(-outTop.netMigrants)} in 1989, the most in the series; by 1996 the flow had reversed to a net gain of {int(inTop.netMigrants)}. Expected lifespan went from {dec(y[1991].lifeExpectancy, 1)} in 1991 to {dec(y[1992].lifeExpectancy, 1)} in 1992 and to {dec(y[1994].lifeExpectancy, 1)} in 1994. No explanation for either is given in the source.</p>
        </div>

        <div class="story-block prose">
          <h2>Why are Azerbaijani men in the minority?</h2>
          <p>The source records the imbalance, not its cause. Men per 100 women dipped to {dec((srLow.male / srLow.female) * 100, 1)} in {srLow.year} and have since recovered to {dec((c.male / c.female) * 100, 1)}. At {dec(c.infantMortalityPer1000!, 1)} deaths in the first year per 1,000 births, infant mortality ranks fourth-highest in Western Asia among nations above one million.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Azerbaijan near its peak population?</h2>
          <p>Within about a generation: the projected count is largest in {peak.year}, at {millions(peak.population)}, a year after deaths begin to exceed births, then declines to {millions(y[2100].population)} for 2100. The urban share, a majority since {urbanHalf}, barely moves over that time: {pct(c.urbanPct!)} today, {pct(y[2050].urbanPct!)} in 2050.</p>
        </div>
        <RelatedPages iso3={aze.iso3} name={aze.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Azerbaijan in figures, each year 1988–1996 included"
          subtitle="The 1989 row holds the largest outflow; fertility crosses 2.1 in the 1996 row."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${aze.slug}-population.csv`)}
          csvName={`${aze.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Azerbaijan: what people want to know</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{aze.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={aze.published}>{longDate(aze.published)}</time> · Updated <time datetime={aze.updated}>{longDate(aze.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Azerbaijan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Azerbaijan" code="az" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
