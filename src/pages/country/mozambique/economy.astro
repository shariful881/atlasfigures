---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/mozambique.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/mozambique/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const gPeak = s.gdp.reduce((a, b) => (b[1] > a[1] ? b : a));
const pPeak = s.gdpPerCapita.reduce((a, b) => (b[1] > a[1] ? b : a));
const prevNeg = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x < 0).map(([y]) => y));
const run = s.gdpGrowthPct.filter(([y]) => y >= 1993 && y <= 2019).every(([, x]) => x > 0);
const pcBelow = rankBy('gdpPerCapita', L).length - B.pcRank!;
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const best = s.gdpGrowthPct.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(growth < 0 && prevNeg === 2020 && run, 'shrank in 2025, first since 2020; grew every year 1993-2019');
assertClaim(gPeak[0] === L - 1 && gdp < gPeak[1] && pPeak[0] === 2014 && B.e.incomeGroup === 'Low income', 'GDP peak 2024; per head peak 2014; low income');
assertClaim(B.pcRank === 183 && pcBelow === 3, 'fourth-lowest GDP per person');
assertClaim(iMax[0] === 2016 && iMax[1] > 17 && s.inflationPct[0][0] === 2005 && i(2022) > 10, 'inflation peak 2016 in series from 2005; 10% in 2022');
assertClaim(best[0] === 1987 && s.gdp[0][0] === 1991 && net!.value < 21, 'best growth 1987; GDP dollars from 1991; about one in five online');

const title = `Mozambique Economy ${L}: First Contraction Since 2020 | AtlasFigures`;
const description = `Real output in Mozambique dipped ${pct(Math.abs(growth))} in ${L}, the first fall since 2020, leaving output at ${usd(gdp)}. Income per person is just ${usdWhole(perHead)}: among the four lowest.`;

const faq = [
  { q: `Was ${L} a recession year for Mozambique?`, a: `Slightly: real output fell ${pct(Math.abs(growth))}, only the second decline since 1993 (the other was 2020), and dollar GDP edged down to ${usd(gdp)} from the previous year\'s record.` },
  { q: 'Is Mozambique one of the poorest countries?', a: `Measured by output per head, it is: ${usdWhole(perHead)} in ${L}, ${ord(B.pcRank!)} of ${rankBy('gdpPerCapita', L).length} economies. The World Bank classes it as low income.` },
  { q: 'Is Mozambican inflation under control?', a: `${pct(infl.value)} in ${L}. Records begin in 2005; the worst year so far was 2016 (${pct(iMax[1])}), and 2022 came to ${pct(i(2022))}.` },
  { q: 'What share of Mozambicans are online?', a: `About one in five — ${pct(net!.value)} of the population in ${net!.year}, according to the ITU.` },
  { q: 'When did Mozambique grow fastest?', a: `In 1987, when real GDP rose ${pct(best[1])}. Between 1993 and 2019 the economy expanded every single year.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Mozambique's economy in ${L}: a rare dip after decades of growth`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Mozambican economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Mozambique', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Mozambique's economy: a setback in {L}</h1>
        <p class="answer">
          Mozambique's economy shrank <strong>{pct(Math.abs(growth))}</strong> in {L}, leaving GDP at <strong>{usd(gdp)}</strong> — just {usdWhole(perHead)} per person.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Mozambique economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Mozambique" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">After growing in all but one year since 1993, Mozambique slipped back in {L}.</p>

        <div class="story-block prose">
          <h2>Why is Mozambique's {L} result unusual?</h2>
          <p>Because the economy contracted. Real GDP fell {pct(Math.abs(growth))}, only the second negative year since 1993; before 2020, Mozambique had grown in every year from 1993 to 2019. Output in dollars was {usd(gdp)}, a little below {L - 1}'s record {usd(gPeak[1])}.</p>
        </div>
        <LineChart
          title={`Year-by-year change in Mozambique's output, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Constant-price GDP, % change year on year."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Where does Mozambique rank on income per head?</h2>
          <p>Near the bottom: {usdWhole(perHead)} of GDP per inhabitant in {L} ({intDollars(ppp!)} in purchasing-power terms), which leaves only {pcBelow} economies lower in the World Bank list. That dollar figure has yet to regain the {usdWhole(pPeak[1])} of 2014.</p>
        </div>
        <div class="story-block prose">
          <h2>Is Mozambique keeping inflation in check?</h2>
          <p>Mostly. The {L} inflation rate, {pct(infl.value)}, compares with {pct(i(2022))} three years earlier; 2016 still holds the top spot in World Bank inflation data for Mozambique (which start in 2005), at {pct(iMax[1])}.</p>
        </div>
        <LineChart
          title={`Inflation in Mozambique, ${s.inflationPct[0][0]}–${L}`}
          subtitle="Annual % rise in consumer prices."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>How connected and employed are Mozambicans?</h2>
          <p>Joblessness, as the ILO models it, stood at {pct(unemp!)} in {L}, and about one person in five ({pct(net!.value)}) was online in {net!.year}. Note the data ranges: dollar GDP is published from 1991, growth rates from 1981 and remittances from 1980.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Mozambique and southern Africa: related pages</h2>
          <ul>
            <li><a href={path('/country/mozambique/population/')}>Mozambique's population</a></li>
            <li><a href={path('/country/south-africa/economy/')}>South Africa's economy</a></li>
            <li><a href={path('/country/tanzania/economy/')}>Tanzania's economy</a></li>
            <li><a href={path('/country/angola/economy/')}>Angola's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Mozambique's GDP, prices and growth by year`}
          subtitle="1991, 2000 and the 2014 per-person peak, then each year from 2015 to the latest; more years in the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/mozambique-economy.csv')} csvName="mozambique-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Mozambique's economy: answers</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Income groups are the World Bank's. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Mozambican economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Mozambique" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
