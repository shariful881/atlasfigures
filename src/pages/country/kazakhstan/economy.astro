---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/kazakhstan.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/kazakhstan/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const CENTRAL = ['UZB', 'TKM', 'KGZ', 'TJK'];
const biggerCA = CENTRAL.every((k) => gdp > valueIn(econData(k).series.gdp, L)!);
const uzb = valueIn(econData('UZB').series.gdp, L)!;
const uzbX = (gdp / uzb).toFixed(1);
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const first = s.gdp[0][0];
const shrank = [1991, 1992, 1993, 1994, 1995].every((y) => g(y) < 0);
const rest3 = ['TKM', 'KGZ', 'TJK'].reduce((a, k) => a + valueIn(econData(k).series.gdp, L)!, 0);
const pcX = Math.round(perHead / v('gdpPerCapita', 2000)!);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 48 && B.pcRank === 68 && biggerCA && Number(uzbX) === 2.1 && gdp > 3 * rest3, 'record GDP and per person; 48th/68th; about twice Uzbekistan');
assertClaim(hiGrowSince === 2011 && Math.abs(growth - 6.5) < 0.01, 'growth fastest since 2011');
assertClaim(shrank && worst[0] === 1994 && worst[1] < -12, 'shrank every year 1991-95, worst 1994');
assertClaim(iMax[0] === 1994 && iMax[1] > 1800 && s.inflationPct[0][0] === 1994, 'inflation peak 1994, series start');
assertClaim(infl.value > i(L - 1) && i(2022) > 14.9, 'inflation up again, 15% in 2022');
assertClaim(first === 1990 && pcX === 12, 'GDP series from 1990; per head 12 times 2000');
assertClaim(net!.year === L - 1 && net!.value > 93, 'over 93% online');

const title = `Kazakhstan Economy ${L}: Growth Hits ${pct(growth)}, Fastest Since 2011 | AtlasFigures`;
const description = `Growth of ${pct(growth)} in ${L} was Kazakhstan\'s best since 2011 and pushed GDP to a new peak of ${usd(gdp)}, about ${uzbX} times Uzbekistan\'s. Inflation rose to ${pct(infl.value)}.`;

const faq = [
  { q: 'Does Kazakhstan lead Central Asia\'s economies?', a: `Clearly. With ${L} output of ${usd(gdp)}, Kazakhstan is about ${uzbX} times the size of Uzbekistan and more than three times Turkmenistan, Kyrgyzstan and Tajikistan put together; worldwide it ranks ${ord(B.gdpRank!)}.` },
  { q: 'Is Kazakhstan\'s growth accelerating?', a: `It was in ${L}: ${pct(growth)}, against ${pct(g(L - 1))} in ${L - 1} — the best year since 2011.` },
  { q: 'What is inflation in Kazakhstan?', a: `${pct(infl.value)} in ${L}, above ${L - 1}\'s ${pct(i(L - 1))}, and as high as ${pct(i(2022))} in 2022. When the World Bank\'s records for Kazakhstan open, in 1994, the rate was ${pct(iMax[1])}.` },
  { q: 'How bad was Kazakhstan\'s 1990s downturn?', a: `Real GDP shrank in 1991, 1992, 1993, 1994 and 1995; the sharpest fall, ${pct(Math.abs(worst[1]))}, came in 1994.` },
  { q: 'What does Kazakhstan produce per resident?', a: `In ${L} the figure was ${usdWhole(perHead)}, good for ${ord(B.pcRank!)} place on the world list and about ${pcX} times its 2000 value in current dollars.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Kazakhstan's economy in ${L}: Central Asia's largest, growing at its quickest since 2011`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Kazakhstani economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Kazakhstan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Kazakhstan's economy: Central Asia's leader speeds up</h1>
        <p class="answer">
          Kazakhstan's output expanded <strong>{pct(growth)}</strong> in {L}; GDP, at <strong>{usd(gdp)}</strong>, set a new record, though inflation climbed back to {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Kazakhstan economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Kazakhstan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">The quickest growth in fourteen years, set against prices that are again rising by more than a tenth a year.</p>

        <div class="story-block prose">
          <h2>Was {L} a strong year for Kazakhstan?</h2>
          <p>The strongest since 2011: growth of {pct(growth)} followed {pct(g(L - 1))} a year earlier. Output peaked at {usd(gdp)}, ranking {ord(B.gdpRank!)} worldwide and dwarfing Uzbekistan's, Central Asia's second economy, by a factor of about {uzbX}.</p>
        </div>
        <div class="story-block prose">
          <h2>How deep was the slump after independence?</h2>
          <p>Very deep. The World Bank's GDP data for Kazakhstan go back to {first}, and real output then declined without a break from 1991 to 1995, by as much as {pct(Math.abs(worst[1]))} in 1994. By 2001 growth had reached {pct(g(2001))}.</p>
        </div>
        <LineChart
          title={`Kazakhstan's GDP growth, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Real GDP, % change on the previous year."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why is inflation in Kazakhstan still high?</h2>
          <p>The data show the level rather than the cause: {pct(infl.value)} in {L}, up from {pct(i(L - 1))}, after {pct(i(2022))} in 2022. The series opens in 1994 at {pct(iMax[1])}, a figure that dwarfs anything since.</p>
        </div>
        <LineChart
          title={`Inflation in Kazakhstan, 2000–${L}`}
          subtitle="Consumer prices, annual % change."
          points={s.inflationPct.filter(([y]) => y >= 2000).map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Kazakhstan's income per head at a high?</h2>
          <p>Yes: {usdWhole(perHead)} in {L}, which ranks {ord(B.pcRank!)}; adjusted for prices it is {intDollars(ppp!)}. Unemployment (ILO model) was {pct(unemp!)}, and {pct(net!.value)} of Kazakhstan's population was online in {net!.year}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Kazakhstan and its region: related pages</h2>
          <ul>
            <li><a href={path('/country/kazakhstan/population/')}>Kazakhstan's population</a></li>
            <li><a href={path('/country/russia/economy/')}>Russia's economy</a></li>
            <li><a href={path('/country/turkey/economy/')}>Turkey's economy</a></li>
            <li><a href={path('/country/iran/economy/')}>Iran's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Kazakhstan year by year: GDP, growth, prices`}
          subtitle="Begins in 1990, the first World Bank GDP year; 1994, 2000, 2001 and 2010 follow, then 2015–2025 in full; the remaining years sit in the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/kazakhstan-economy.csv')} csvName="kazakhstan-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Kazakhstan's economy, explained in brief</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Central Asia" here means Kazakhstan, Uzbekistan, Turkmenistan, Kyrgyzstan and Tajikistan. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Kazakhstani economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Kazakhstan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
