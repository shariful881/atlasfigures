---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/oman.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/oman/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const pcPeak = s.gdpPerCapita.reduce((a, b) => (b[1] > a[1] ? b : a));
const gdpPeak = s.gdp.reduce((a, b) => (b[1] > a[1] ? b : a));
const pcDrop = Math.round((1 - perHead / pcPeak[1]) * 100);
const mig = valueIn(s.migrantPct, 2024)!; const migRank = rankBy('migrantPct', 2024).find((r) => r.iso3 === c.iso3)!.rank;
const men = valueIn(s.lfpMale, L)!, women = valueIn(s.lfpFemale, L)!;
const menRank = rankBy('lfpMale', L).find((r) => r.iso3 === c.iso3)!.rank;
const gaps = rankBy('lfpMale', L).map((r) => ({ iso3: r.iso3, d: r.value - (valueIn(econData(r.iso3).series.lfpFemale, L) ?? r.value) })).sort((a, b) => b.d - a.d);
const gapPos = gaps.findIndex((x) => x.iso3 === c.iso3) + 1;
const lowInfl = s.inflationPct.filter(([y]) => y >= 2012).every(([, x]) => x < 3);
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(pcPeak[0] === 2008 && pcDrop === 25 && gdpPeak[0] === 2022 && gdp < gdpPeak[1], 'per head 25% below 2008 peak; GDP just under 2022 record');
assertClaim(g(2022) > 7.9 && g(2019) < 0 && g(2020) < 0 && growth > 2.3 && growth < 2.5, '8.0% in 2022 after falls in 2019 and 2020; 2.4% in 2025');
assertClaim(lowInfl && iMax[0] === 2008 && s.inflationPct[0][0] === 2001, 'inflation under 3% every year since 2012; peak 2008; series from 2001');
assertClaim(Math.round(mig * 10) === 432 && migRank === 22 && valueIn(s.migrantPct, 2000) === 24.1, 'migrants 43.2% (22nd), 24.1% in 2000');
assertClaim(menRank === 4 && gapPos === 3 && gaps[0].iso3 === 'AFG' && gaps[1].iso3 === 'IRQ' && Math.round(women) === 30, "men's participation 4th highest; gap 3rd widest after Afghanistan and Iraq");

const title = `Oman Economy ${L}: Output per Head ${pcDrop}% Below 2008 Peak | AtlasFigures`;
const description = `The sultanate's ${L} output: ${usd(gdp)}, up ${pct(growth)} in volume. Per resident that is ${usdWhole(perHead)}, ${pcDrop}% short of 2008, while yearly price rises have not reached 3% since 2012.`;

const faq = [
  { q: 'What is the size of the Omani economy?', a: `${usd(gdp)} for ${L} — fractionally less than 2022's ${usd(gdpPeak[1])} — with real growth of ${pct(growth)}.` },
  { q: 'Is Oman richer than it was in 2008?', a: `Not per person in dollar terms: ${usdWhole(perHead)} for ${L} against ${usdWhole(pcPeak[1])} in 2008, about ${pcDrop}% less. At PPP the ${L} figure is ${intDollars(ppp!)}.` },
  { q: 'Has inflation in Oman stayed low?', a: `Yes: ${pct(infl.value)} for ${L}; no year from 2012 onward reached 3%. The highest reading, ${pct(iMax[1])}, came in 2008.` },
  { q: 'What share of people in Oman are foreigners?', a: `Foreign-born residents made up ${pct(mig)} of Oman's population in 2024 by UN reckoning, ${ord(migRank)} in the world, against ${pct(valueIn(s.migrantPct, 2000)!)} in 2000.` },
  { q: 'How many Omani women work?', a: `About three in ten: the ILO models female participation at ${pct(women)} for ${L}, versus ${pct(men)} for men, a gap exceeded only in Afghanistan and Iraq.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Oman's economy in ${L}: steady prices, output per person below its 2008 peak`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Omani economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Oman', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Oman's economy: stable prices, smaller incomes than in 2008</h1>
        <p class="answer">
          Oman's <strong>{usd(gdp)}</strong> economy, up <strong>{pct(growth)}</strong> in real terms, is near its record, yet output per person ({usdWhole(perHead)}) remains about a quarter under its 2008 level.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Oman economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Oman" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Inflation has been under 3% for over a decade, and four in ten residents were born outside the country.</p>

        <div class="story-block prose">
          <h2>How has Oman's income per person changed since 2008?</h2>
          <p>Downward, in dollars. The per-resident figure topped out at {usdWhole(pcPeak[1])} in 2008; {L} came in at {usdWhole(perHead)}, roughly {pcDrop}% lower, and total GDP ({usd(gdp)}) sits a whisker under its 2022 peak ({usd(gdpPeak[1])}). After shrinking in 2019 and 2020, the economy jumped {pct(g(2022))} in 2022, then settled at {pct(g(2023))}, {pct(g(2024))} and {pct(growth)}.</p>
        </div>
        <LineChart
          title={`Oman: dollar output per resident, ${s.gdpPerCapita[0][0]}–${L}`}
          subtitle="Current US dollars per resident."
          points={s.gdpPerCapita.map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Does Oman have inflation?</h2>
          <p>Very little. The consumer price index climbed {pct(infl.value)} over {L}, and every annual increase since 2012 has stayed under 3%. Oman's figures start in 2001, and the steepest annual rise ({pct(iMax[1])}) came in 2008. The ILO-modelled unemployment rate is {pct(unemp!)}.</p>
        </div>
        <div class="story-block prose">
          <h2>Who makes up Oman's workforce?</h2>
          <p>Many workers come from elsewhere: by UN estimates, {pct(mig)} of Oman's 2024 population was born abroad, placing it {ord(migRank)} worldwide. Men aged 15+ take part in the labour market at a rate of {pct(men)} ({ord(menRank)} globally) and women at {pct(women)} — on ILO numbers only Afghanistan and Iraq show a wider divide.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Oman and the Gulf: related pages</h2>
          <ul>
            <li><a href={path('/country/oman/population/')}>Oman's population</a></li>
            <li><a href={path('/country/saudi-arabia/economy/')}>Saudi Arabia's economy</a></li>
            <li><a href={path('/country/united-arab-emirates/economy/')}>United Arab Emirates' economy</a></li>
            <li><a href={path('/country/iran/economy/')}>Iran's economy</a></li>
            <li><a href={path('/rankings/immigrant-percentage-by-country/')}>Immigrants as a percentage of population</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Oman in yearly data`}
          subtitle="Decade years from 1960 alongside 2001 and 2008, and 2015–2025 in full; the CSV has each year."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/oman-economy.csv')} csvName="oman-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Oman, economically speaking: FAQ</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Migrants: SM.POP.TOTL.ZS (UN DESA); labour force: SL.TLF.CACT.MA.ZS and SL.TLF.CACT.FE.ZS (ILO modelled estimates), via the World Bank. Inflation data start in 2001. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Omani economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Oman" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
