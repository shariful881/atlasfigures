---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/germany.json';
import { econData, econMeta, valueIn, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/germany/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, share } = B;
const jp = econData('JPN').series.gdp;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const G7 = ['USA', 'GBR', 'DEU', 'JPN', 'FRA', 'ITA', 'CAN'];
const aheadOfJapan = s.gdp.filter(([y, x]) => x > (valueIn(jp, y) ?? Infinity)).map(([y]) => y);

assertClaim(B.gdpRank === 3 && aheadOfJapan.filter((y) => y > 1971).join() === '2023,2024,2025' && aheadOfJapan.includes(1971), 'third, ahead of Japan since 2023 for the first time since 1971');
assertClaim(g(2023) < 0 && g(2024) < 0 && g(L) > 0 && g(L) < 0.5, 'two years of contraction, then near-zero growth');
assertClaim(s.gdpGrowthPct.filter(([y]) => y > 2003 && y < 2023).every(([y, x], k, a) => !(x < 0 && (a.find(([z]) => z === y + 1)?.[1] ?? 1) < 0)) && g(2002) < 0 && g(2003) < 0, 'first back-to-back contraction since 2002–03');
assertClaim(G7.every((x) => x === c.iso3 || valueIn(econData(x).series.gdpGrowthPct, L)! > growth), 'slowest growth in the G7');
assertClaim(s.inflationPct.filter(([y]) => y > 1974 && y !== 2022).every(([, x]) => x < i(2022)) && i(1974) > i(2022), '2022 inflation highest since 1974');
assertClaim(unemp! < 4 && G7.filter((x) => valueIn(econData(x).series.unemploymentPct, L)! < unemp!).map((x) => x).join() === 'JPN', 'second-lowest unemployment in the G7, after Japan');
assertClaim(g(2009) < -5 && g(2009) < g(2020), '2009 deeper than 2020');
assertClaim(unemp! > v('unemploymentPct', 2022)! && unemp! - v('unemploymentPct', 2022)! < 1, 'a little above 2022');

const title = `German Economy ${L}: GDP, Recession and Jobs | AtlasFigures`;
const description = `Germany is the world's third-biggest economy (${usd(gdp)} in ${L}), back ahead of Japan, but output shrank in 2023 and 2024 and grew only ${pct(growth)} in ${L}, the weakest in the G7.`;

const faq = [
  { q: 'Is Germany in a recession?', a: `Its economy shrank in both 2023 (${signedPct(g(2023))}) and 2024 (${signedPct(g(2024))}), the first back-to-back declines since 2002–03, and grew just ${pct(growth)} in ${L}.` },
  { q: 'Is Germany\'s economy bigger than Japan\'s?', a: `Yes, since 2023 in current dollars: ${usd(gdp)} against ${usd(valueIn(jp, L)!)} in ${L}. Before that, Germany had last been ahead in 1971.` },
  { q: 'What is Germany\'s GDP per head?', a: `${usdWhole(perHead)} in ${L}, ${ord(B.pcRank!)} worldwide; at purchasing power parity ${intDollars(ppp!)}.` },
  { q: 'How low is German unemployment?', a: `${pct(unemp!)} in ${L} (ILO modelled), the second-lowest rate in the G7 after Japan.` },
  { q: 'How bad was German inflation in 2022?', a: `Prices rose ${pct(i(2022))}, more than in any year since 1974. By ${L} the rate was down to ${pct(infl.value)}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Germany's economy ${L}: third-largest in the world, barely growing`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="German economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Germany', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>German economy: Europe's biggest, barely growing</h1>
        <p class="answer">
          Germany's GDP added up to <strong>{usd(gdp)}</strong> in {L}, third in the world and {pct(share)} of global output. Yet real growth was a mere <strong>{pct(growth)}</strong> after two shrinking years, the weakest showing in the G7.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Germany economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Germany" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Germany has moved up to third place in the world while its own output has gone nowhere for three years. Jobs, meanwhile, have held up.</p>

        <div class="story-block prose">
          <h2>Did Germany overtake Japan?</h2>
          <p>Yes. On dollar figures it moved into third place in 2023 and has held it since. In {L} Germany produced {usd(gdp)} against Japan's {usd(valueIn(jp, L)!)}. The last time Germany's dollar GDP topped Japan's was 1971. The <a href={path('/country/japan/economy/')}>Japan economy page</a> covers the other side of the swap.</p>
        </div>
        <LineChart
          title={`Germany's GDP, 1960–${L}`}
          subtitle="Output in current US dollars, shown every five years and yearly since 2019."
          points={s.gdp.filter(([y]) => y % 5 === 0 || y >= 2019).map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is the German economy shrinking?</h2>
          <p>It did in 2023 ({signedPct(g(2023))}) and 2024 ({signedPct(g(2024))}), the first time since 2002 and 2003 that real output fell two years running. No other G7 member grew as little as Germany's {signedPct(growth)} in {L}. Earlier slumps were sharper but shorter: {signedPct(g(2009))} in 2009 and {signedPct(g(2020))} in 2020.</p>
        </div>

        <div class="story-block prose">
          <h2>Are Germans losing their jobs?</h2>
          <p>Not many. Just {pct(unemp!)} of German workers had no job in {L}, going by modelled ILO data, a little above the {pct(v('unemploymentPct', 2022)!)} of 2022 and lower than anywhere else in the G7 except Japan. In 2010 the rate had been {pct(v('unemploymentPct', 2010)!)}.</p>
        </div>
        <LineChart
          title={`Unemployment in Germany, 1991–${L}`}
          subtitle="Jobless share of the German labour force, modelled ILO estimates."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How high did German inflation go?</h2>
          <p>To {pct(i(2022))} in 2022, the steepest annual rise since 1974, followed by {pct(i(2023))} in 2023. It has since settled at {pct(infl.value)}. Output per resident, at {usdWhole(perHead)}, ranks {ord(B.pcRank!)} in the world.</p>
        </div>

        <nav class="related" aria-label="Related pages">
          <h2>More about Germany and Europe</h2>
          <ul>
            <li><a href={path('/country/germany/population/')}>Germany's population</a></li>
            <li><a href={path('/country/france/economy/')}>France's economy</a></li>
            <li><a href={path('/country/united-kingdom/economy/')}>The UK economy</a></li>
            <li><a href={path('/country/netherlands/population/')}>The Netherlands' population</a></li>
            <li><a href={path('/rankings/gdp-by-country/')}>GDP of every country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`German economic record, 1960–${L}`}
          subtitle="With the 2002–03, 2009, 2020 and 2023–24 downturns; the CSV has every year."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/germany-economy.csv')} csvName="germany-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">German economy FAQ</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), remittances, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"G7" means Canada, France, Germany, Italy, Japan, the United Kingdom and the United States. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('German economy', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Germany" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
