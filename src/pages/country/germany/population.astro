---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import de from '../../../data/countries/germany.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: more deaths than births since 1972, held up by migration.
const PAGE = '/country/germany/population/';
const un = countryData(de.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (de.verification as any).checkedOn as string | undefined;

const natSince = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natSince === 1972 && un.years.filter((r) => r.year >= natSince).every((r) => r.naturalChange < 0), 'more deaths than births every year since 1972');
const deathsPerBirth = c.deaths / c.births;
const span = un.years.filter((r) => r.year >= 2010 && r.year <= 2023);
const migSum = span.reduce((a, r) => a + r.netMigrants, 0);
const natSum = span.reduce((a, r) => a + r.naturalChange, 0);
assertClaim(migSum > 2 * -natSum && y[2023].population > y[2010].population, 'migration 2010-2023 more than twice the natural loss; population rose');
const est = un.years.filter((r) => !r.projection);
const migTop = est.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(migTop.year === 2015 && y[2022].netMigrants > 900e3, 'net migration highest in 2015, also very high in 2022');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2024 && un.years.filter((r) => r.year >= 2030).every((r) => r.population < peak.population), 'UN projection peaks in 2024');
assertClaim(un.years.filter((r) => r.year >= 2030).every((r) => r.netMigrants > 100e3), 'projection keeps net migration above 100 thousand a year');
const sub = un.years.find((r) => r.year > 1964 && r.fertility < 2.1)!.year;
assertClaim(un.years.filter((r) => r.year >= sub).every((r) => r.fertility < 2.1), 'below 2.1 since');
const tfrLow = est.reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(y[1964].births > 1.5 * c.births && un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a)).year === 1964, '1960s births far above today; fertility highest in 1964');
const grewYears = un.years.filter((r) => r.year >= natSince && r.year <= 2023 && r.change > 0).length;
assertClaim(grewYears > (2023 - natSince + 1) / 2, 'population grew in most years since 1972 despite the natural loss');
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any) => d.years.find((r: any) => r.year === CURRENT_YEAR);
const europe = wpp.filter((d: any) => d.region === 'Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(europe[0] === 'RUS' && europe[1] === 'DEU', 'second in Europe after Russia');
const EU27 = ['AUT', 'BEL', 'BGR', 'HRV', 'CYP', 'CZE', 'DNK', 'EST', 'FIN', 'FRA', 'DEU', 'GRC', 'HUN', 'IRL', 'ITA', 'LVA', 'LTU', 'LUX', 'MLT', 'NLD', 'POL', 'PRT', 'ROU', 'SVK', 'SVN', 'ESP', 'SWE'];
assertClaim(wpp.filter((d: any) => EU27.includes(d.iso3)).sort((a: any, b: any) => at(b).population - at(a).population)[0].iso3 === 'DEU', 'largest EU member');

const title = `Germany's Population in ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Kept Up by Migration | AtlasFigures`;
const description = `Germany has had more deaths than births every year since ${natSince}, yet counts ${millions(c.population)} people in ${CURRENT_YEAR} thanks to migration. Births, ageing and the UN path to ${millions(y[2100].population)} in 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: de.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Deaths per birth', value: dec(deathsPerBirth, 2) },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, de.tableYears);

const faq = [
  { q: "What is Germany's population today?", a: `The UN count for mid-${CURRENT_YEAR} is ${millions(c.population)}: the largest in the European Union and second in Europe after Russia.` },
  { q: "Is Germany's population growing or shrinking?", a: `Shrinking slightly, by ${pct(Math.abs(c.growthRatePct))} in ${CURRENT_YEAR}. In the UN medium variant the total is at its highest in ${peak.year} and lower in every year from 2030 onward.` },
  { q: "How much does migration add to Germany's population?", a: `From 2010 to 2023, net migration added about ${millions(migSum)} people while the surplus of deaths over births took away ${millions(-natSum)}. The single biggest year was ${migTop.year}, at ${millions(migTop.netMigrants)}.` },
  { q: 'Are German families having more children again?', a: `Only a little. The fertility rate is ${dec(c.fertility, 2)} in ${CURRENT_YEAR}, up from a low of ${dec(tfrLow.fertility, 2)} in ${tfrLow.year} but still well under 2.1, where it has stayed since ${sub}.` },
  { q: "How small will Germany's population get by 2100?", a: `The UN projects ${millions(y[2050].population)} for 2050 and ${millions(y[2100].population)} for 2100, assuming net migration continues at more than 100 thousand people a year.` },
];

const schema = countrySchema({
  page: PAGE, slug: de.slug, name: de.name, wikipedia: de.wikipedia,
  headline: `Germany's population in ${CURRENT_YEAR}: ${millions(c.population)}, with deaths above births since ${natSince}`,
  description,
  datasetName: 'Germany population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Germany (present borders, both before and after 1990) for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: de.published, updated: de.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Germany"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Germany', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Germany population: births, deaths and migration</h1>
        <LiveCounter
          label="Germany's population at this moment (estimate)"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} number, falling by roughly ${int(Math.abs(c.change) / 365)} a day`}
        />
        <p class="answer">
          Germany's population is <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, the largest in the European Union. Since {natSince}, <strong>deaths have outnumbered births each year</strong>; immigration is what has kept the total from falling for most of that time.
        </p>
        <div class="dates"><span>Updated <time datetime={de.updated}>{longDate(de.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Germany" code="de" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why do more Germans die each year than are born?</h2>
          <p>The big post-war cohorts, born in the two decades after 1950, are now old, while births have been low for half a century. This year about {millions(c.deaths)} people will die and {millions(c.births)} will be born, {dec(deathsPerBirth, 2)} deaths for each newborn. No year since {natSince} has had more births than deaths.</p>
        </div>

        <div class="story-block prose">
          <h2>How has immigration changed Germany's population?</h2>
          <p>It has turned decline into growth. Between 2010 and 2023, net migration brought in about {millions(migSum)} people, more than twice the {millions(-natSum)} lost to the excess of deaths. The population rose from {millions(y[2010].population)} to {millions(y[2023].population)} over those years. The biggest inflow, {millions(migTop.netMigrants)}, came in {migTop.year}, and 2022 was almost as high.</p>
        </div>
        <LineChart
          title="Germany's population from 1950, with the UN's outlook"
          subtitle="Mid-year totals for Germany within today's borders. The dashed line shows the UN medium variant."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has Germany's population peaked?</h2>
          <p>Probably, if the UN is right. Its medium projection puts the high point in {peak.year}, at {millions(peak.population)}, and has the country {pct(Math.abs(c.growthRatePct))} smaller this year. That outlook already assumes net migration of well over 100 thousand people a year; even so, the total sinks to {millions(y[2050].population)} by 2050 and {millions(y[2100].population)} by 2100.</p>
        </div>

        <div class="story-block prose">
          <h2>How low is fertility in Germany?</h2>
          <p>{dec(c.fertility, 2)} on average in {CURRENT_YEAR}. The rate dropped below 2.1 in {sub}, hit a low of {dec(tfrLow.fertility, 2)} in {tfrLow.year} and has recovered only partly. Its 1964 level, the series high, was {dec(y[1964].fertility, 2)}.</p>
        </div>
        <LineChart
          title="Fertility rate in Germany, 1950–2050"
          subtitle="Children per woman. The reference line at 2.1 is the rate that replaces each generation; dashed points are projected."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="children per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 replaces each generation' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Germany the most populous country in Europe?</h2>
          <p>Second, behind Russia, and first within the European Union. At {int(c.densityPerKm2)} people per km², it is also densely settled, and its median resident is {dec(c.medianAge, 1)} years old, against {dec(y[1950].medianAge, 1)} in 1950. By Germany's own yardstick, {pct(c.urbanPct!)} of people are urban dwellers. In 1950 it was the world's {ord(y[1950].worldRank!)} most populous country; today it is {ord(c.worldRank!)}.</p>
        </div>
        <RelatedPages iso3={de.iso3} name={de.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Germany in figures, 1950–2100"
          subtitle="Population on 1 July, density, total fertility, median age, urban share as Germany defines it (to 2050) and world rank, within today's borders. From 2030: UN projection."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${de.slug}-population.csv`)}
          csvName={`${de.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Germany's population: quick facts</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, deaths, net migration, growth, density, fertility, median age, world rank, comparisons with other European countries and projections. UN figures for years before 1990 cover East and West Germany combined. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and subtracts the UN's projected decline for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={de.published}>{longDate(de.published)}</time> · Updated <time datetime={de.updated}>{longDate(de.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Germany population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Germany" code="de" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
