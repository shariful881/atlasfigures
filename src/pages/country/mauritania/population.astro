---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import mrt from '../../../data/countries/mauritania.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: an urban share of 2.6% in 1950 (WUP 2025,
// national definition) rising to a majority in 2014; fourth-lowest density in Africa; about 8.3 times 1950; infant
// mortality from 185 to 27.5; fertility above 2.1 through 2100; growth to 2100.
const PAGE = '/country/mauritania/population/';
const un = countryData(mrt.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (mrt.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(y[1950].urbanPct! < 3 && c.urbanPct! > 60, 'urban under 3% in 1950, over 60% now');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2014, 'urban majority 2014');
const af1 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population >= 1e6);
assertClaim([...af1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2).map((d: any) => d.iso3).indexOf('MRT') === 3, 'fourth-lowest density in Africa');
const since = c.population / y[1950].population;
assertClaim(since > 8.2 && since < 8.4, 'about 8.3 times 1950');
assertClaim(y[1950].infantMortalityPer1000! > 180 && c.infantMortalityPer1000! < 28, 'infant mortality from above 180 to under 28');
assertClaim(un.years.every((r) => r.fertility > 2.1), 'fertility above 2.1 through 2100');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1977, 'fertility high 1977');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const times = y[2100].population / c.population;
assertClaim(peak.year === 2100 && times > 3 && times < 3.2, 'still growing 2100, about 3.1 times today');

const title = `Mauritania Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Towns Overtook the Countryside in 2014 | AtlasFigures`;
const description = `On UN estimates Mauritania reaches ${millions(c.population)} this year (${CURRENT_YEAR}). Under 3% lived in towns in 1950; most have since 2014. At ${int(c.densityPerKm2)} per km² the land is among Africa's emptiest, yet the count heads for ${millions(y[2100].population)} by 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: mrt.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, mrt.tableYears);

const faq = [
  { q: 'How urban was Mauritania in 1950?', a: `Barely: ${pct(y[1950].urbanPct!)} on the national definition in World Urbanization Prospects 2025. Towns have held most people since ${urbanHalf}; ${pct(c.urbanPct!)} live there now.` },
  { q: 'Is Mauritania thinly settled by African standards?', a: `It is: ${int(c.densityPerKm2)} per km², with only Namibia, Libya and Botswana emptier among African nations above a million.` },
  { q: 'Do fewer Mauritanian babies die now?', a: `From ${dec(y[1950].infantMortalityPer1000!, 1)} per 1,000 births in 1950 to ${dec(c.infantMortalityPer1000!, 1)} now, UN estimates show.` },
  { q: 'Will Mauritanian fertility drop below 2.1?', a: `Not by 2100 in the projection: ${dec(c.fertility, 2)} now and ${dec(y[2100].fertility, 2)} in the last projected year, with ${dec(tfrTop.fertility, 2)} back in ${tfrTop.year}.` },
  { q: 'What size could Mauritania reach this century?', a: `Some ${millions(y[2100].population)} in 2100, roughly triple today, and not yet at a peak.` },
];

const schema = countrySchema({
  page: PAGE, slug: mrt.slug, name: mrt.name, wikipedia: mrt.wikipedia,
  headline: `Mauritania's ${millions(c.population)}: under 3% urban in 1950, a town majority since 2014; growth to 2100`,
  description,
  datasetName: 'Mauritania population, urban share and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Mauritania for selected years from 1950 to ${CURRENT_YEAR}, including 1977, 1992, 1996 and 2014, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: mrt.published, updated: mrt.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Mauritania"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Mauritania", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Mauritania: from 3% urban to a town-dwelling majority</h1>
        <LiveCounter
          label="Mauritania: estimated residents, real time"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Driven by the UN World Population Prospects 2024 mid-${CURRENT_YEAR} estimate; roughly ${int(c.change / 365)} added daily`}
        />
        <p class="answer">
          Mauritania's head count, <strong>{millions(c.population)}</strong> in {CURRENT_YEAR} as estimated by the UN, is 8.3 times the 1950 one. Just <strong>{pct(y[1950].urbanPct!)}</strong> lived in towns in 1950; today {pct(c.urbanPct!)} do.
        </p>
        <div class="dates"><span>Updated <time datetime={mrt.updated}>{longDate(mrt.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Mauritania" code="mr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How quickly did Mauritania urbanise?</h2>
          <p>From almost nothing: {pct(y[1950].urbanPct!)} in 1950, {pct(y[1970].urbanPct!)} in 1970 and {pct(y[1990].urbanPct!)} in 1990, by Mauritania's own definition as compiled in World Urbanization Prospects 2025. Townspeople have outnumbered rural dwellers since {urbanHalf}; {pct(c.urbanPct!)} now.</p>
        </div>
        <LineChart
          title="Mauritania's urban share since 1950"
          subtitle="WUP 2025, national definition; from under 3% to over 60%, projection dashed."
          points={rows.filter((r) => r.year <= 2050 && r.urbanPct != null).map((r) => ({ x: r.year, y: r.urbanPct!, projection: r.projection }))}
          format="percent"
          highlight={CURRENT_YEAR}
          source="UN World Urbanization Prospects 2025"
          sourceUrl={WUP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How much space does Mauritania have?</h2>
          <p>A great deal: {int(c.densityPerKm2)} residents to each km². Among African nations above a million, only Namibia, Libya and Botswana are more thinly settled.</p>
        </div>

        <div class="story-block prose">
          <h2>How has child survival changed in Mauritania?</h2>
          <p>Dramatically. Of every 1,000 births, {dec(y[1950].infantMortalityPer1000!, 1)} ended in an infant death in 1950; today {dec(c.infantMortalityPer1000!, 1)} do. Average lifespans went from {dec(y[1950].lifeExpectancy, 1)} years to {dec(c.lifeExpectancy, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Will Mauritania's growth slow?</h2>
          <p>Gradually. Fertility (it peaked in {tfrTop.year}, at {dec(tfrTop.fertility, 2)}) is {dec(c.fertility, 2)} today and remains over 2.1 all the way to 2100. Projected totals: {millions(y[2050].population)} around mid-century, {millions(y[2100].population)} by 2100, roughly three times today.</p>
        </div>
        <RelatedPages iso3={mrt.iso3} name={mrt.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Mauritanian figures by decade, 1977 and 2014 added"
          subtitle="Watch the urban column cross 50% at 2014."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${mrt.slug}-population.csv`)}
          csvName={`${mrt.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Mauritania: frequently checked figures</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{mrt.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={mrt.published}>{longDate(mrt.published)}</time> · Updated <time datetime={mrt.updated}>{longDate(mrt.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Mauritania population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Mauritania" code="mr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
