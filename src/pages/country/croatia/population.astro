---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import hrv from '../../../data/countries/croatia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: a 1990 peak; falls 1991–2001
// and every year since 2008 (19 years); below the 1950 count; deaths above births every year from 1991; net departures
// largest in 1996; the 1991 life-expectancy dip; 2100 projection about 56% of today.
const PAGE = '/country/croatia/population/';
const un = countryData(hrv.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (hrv.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1990, 'peak 1990');
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.filter((n) => n <= 2001).join() === '1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001' && falls.filter((n) => n > 2001).length === CURRENT_YEAR - 2007 && falls.includes(2008), 'falls 1991–2001 and every year from 2008');
assertClaim(c.population < y[1950].population, 'below 1950');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 1991 && un.years.filter((r) => r.year >= 1991).every((r) => r.naturalChange < 0), 'deaths above births from 1991');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1996 && un.years.filter((r) => r.year >= 1991 && r.year <= 2000).every((r) => r.netMigrants < 0), 'net departures 1991–2000, largest 1996');
assertClaim(y[1991].lifeExpectancy < y[1990].lifeExpectancy - 1 && y[1992].lifeExpectancy > y[1991].lifeExpectancy, '1991 dip');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 0.55 && ratio < 0.57, 'about 56% of today by 2100');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(b).deaths / at(b).births - at(a).deaths / at(a).births).map((d: any) => d.iso3).indexOf('HRV') === 7, 'eighth-highest deaths-to-births ratio in Europe');

const title = `Croatia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Fewer Than in 1950, Lower Each Year From 2008 | AtlasFigures`;
const description = `On the UN's numbers Croatia's ${CURRENT_YEAR} population, ${millions(c.population)}, is smaller than its 1950 one. Numbers peaked in 1990, sank through 1991–2001 and have dropped each year since 2008; natural decrease has run since 1991.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: hrv.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
];

const rows = displayRows(un.years, hrv.tableYears);

const faq = [
  { q: 'Is Croatia smaller than in 1950?', a: `Yes: ${millions(c.population)} now against ${millions(y[1950].population)} then; in between it rose to ${millions(peak.population)} (1990).` },
  { q: "Since when has Croatia's population been in decline?", a: `Without a break since 2008, and before that from 1991 to 2001, per the UN series.` },
  { q: 'In which year did Croatian deaths first exceed births?', a: `1991, and they have kept the lead ever after; ${CURRENT_YEAR} is projected at ${int(c.deaths)} deaths against ${int(c.births)} births.` },
  { q: 'Which year had the most net departures from Croatia?', a: `1996, with ${int(-outTop.netMigrants)}. The UN files give no reasons.` },
  { q: 'What does the end of the century look like for Croatia?', a: `${millions(y[2100].population)}: a little over half of today.` },
];

const schema = countrySchema({
  page: PAGE, slug: hrv.slug, name: hrv.name, wikipedia: hrv.wikipedia,
  headline: `Croatia's ${millions(c.population)}: below its 1950 count; falling since 2008; natural decrease since 1991`,
  description,
  datasetName: 'Croatia population, natural change and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Croatia for selected years from 1950 to ${CURRENT_YEAR}, including 1990–1992, 1996, 2001, 2007, 2008 and 2017, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: hrv.published, updated: hrv.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Croatia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Croatia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Croatia: fewer people than in 1950</h1>
        <LiveCounter
          label="Croatia: estimated population right this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Derived from UN World Population Prospects 2024 for mid-${CURRENT_YEAR}; about ${int(-c.change / 365)} fewer every day`}
        />
        <p class="answer">
          On UN figures Croatia's {CURRENT_YEAR} head count of <strong>{millions(c.population)}</strong> falls short of the 1950 figure, <strong>{millions(y[1950].population)}</strong>. It peaked in 1990 ({millions(peak.population)}) and has shrunk each year from 2008.
        </p>
        <div class="dates"><span>Updated <time datetime={hrv.updated}>{longDate(hrv.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Croatia" code="hr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>When was Croatia at its most populous?</h2>
          <p>1990, with {millions(peak.population)}. Each year from 1991 to 2001 was lower, 2002–2007 brought a slight rise, and since 2008 the total has shrunk without pause, to {millions(c.population)}, now under the 1950 count.</p>
        </div>
        <LineChart
          title="Croatians counted each July, 1950–2100"
          subtitle="Mid-year totals; UN projection dashed from 2024."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What did the UN record for Croatia in the 1990s?</h2>
          <p>Net losses through migration in each year from 1991 to 2000, the heaviest {int(-outTop.netMigrants)} in 1996, and lifespans dipping from {dec(y[1990].lifeExpectancy, 1)} years in 1990 to {dec(y[1991].lifeExpectancy, 1)} in 1991. The series does not attribute them. A later outflow reached {int(-y[2017].netMigrants)} in 2017.</p>
        </div>

        <div class="story-block prose">
          <h2>Are deaths outrunning births in Croatia?</h2>
          <p>Since 1991, every year. {CURRENT_YEAR} brings a projected {int(c.deaths)} deaths and {int(c.births)} births; only seven million-plus European states have a higher ratio of deaths to births. Half of Croatians are over {dec(c.medianAge, 1)}, and fertility is {dec(c.fertility, 2)}.</p>
        </div>

        <div class="story-block prose">
          <h2>What is Croatia's outlook to 2100?</h2>
          <p>Further decline, which leaves {millions(y[2100].population)} in the last projected year (close to 56% of today's number) after {millions(y[2050].population)} at mid-century.</p>
        </div>
        <RelatedPages iso3={hrv.iso3} name={hrv.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Croatia, peak year 1990 and the years after"
          subtitle="From the 2008 row down, every total undercuts its predecessor."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${hrv.slug}-population.csv`)}
          csvName={`${hrv.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Croatia: questions answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{hrv.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={hrv.published}>{longDate(hrv.published)}</time> · Updated <time datetime={hrv.updated}>{longDate(hrv.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Croatia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Croatia" code="hr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
