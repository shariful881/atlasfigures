---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import bd from '../../../data/economy/bangladesh.json';
import { econData, econMeta, aggregate, valueIn, latest, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { countryData, byYear, assertClaim, pct, millions } from '../../../lib/figures';
import { abs, path, longDate, ORG_ID, WEBSITE_ID, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/); populations from UN WPP 2024.
const PUBLISHED = bd.published;
const UPDATED = bd.updated;
const iso = (d: string) => `${d}T12:00:00+06:00`;
const PAGE = '/country/bangladesh/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const WPP = 'UN World Population Prospects 2024';
const checkedOn = bd.verification?.checkedOn;

const e = econData(bd.iso3);
const s = e.series;
const india = econData(bd.compareWith).series;
const pak = econData('PAK').series;
const world = aggregate('WLD').series;
const pakPeople = byYear(countryData('PAK').years);
const bdPeople = byYear(countryData(bd.iso3).years);

const L = latest(s.gdp)!.year;                          // latest World Bank year
for (const k of ['gdp', 'gdpPerCapita', 'gdpGrowthPct', 'inflationPct', 'remittances', 'remittancesPctGdp', 'unemploymentPct', 'gdpPerCapitaPpp'] as const) {
  assertClaim(latest(s[k])!.year === L, `${k} has a value for ${L}`);
}
const v = (k: keyof typeof s, y: number) => valueIn(s[k], y)!;
const gdp = v('gdp', L), perHead = v('gdpPerCapita', L), growth = v('gdpGrowthPct', L), infl = v('inflationPct', L);
const rem = v('remittances', L), remPct = v('remittancesPctGdp', L), ppp = v('gdpPerCapitaPpp', L), unemp = v('unemploymentPct', L);
const net = latest(s.internetPct)!;
const worldShare = (gdp / valueIn(world.gdp, L)!) * 100;
const pakGdp = valueIn(pak.gdp, L)!;
const sasGrowth = valueIn(aggregate('SAS').series.gdpGrowthPct, L)!;
assertClaim(sasGrowth > growth + 2, 'South Asia grew much faster');
assertClaim(econData('PAK').region !== 'South Asia' && econData('AFG').region !== 'South Asia', 'World Bank South Asia excludes Pakistan and Afghanistan');
const indPerHead = valueIn(india.gdpPerCapita, L)!, indPpp = valueIn(india.gdpPerCapitaPpp, L)!;

// Story figures, each checked so the sentences stay true for the data.
const growthYears = s.gdpGrowthPct.filter(([y]) => y > 1975);
assertClaim(growthYears.every(([, g]) => g > 0) && growthYears[0][0] === 1976 && growthYears.at(-1)![0] === L, 'the economy has grown every year since 1976');
assertClaim(v('gdpGrowthPct', 1975) < 0, 'last contraction in 1975');
const g71 = v('gdpGrowthPct', 1971), g72 = v('gdpGrowthPct', 1972);
assertClaim(g71 < 0 && g72 < 0 && [...s.gdpGrowthPct].sort((a, b) => a[1] - b[1]).slice(0, 2).map(([y]) => y).sort().join() === '1971,1972', 'the two deepest falls on record were 1971 and 1972');
const avg1019 = s.gdpGrowthPct.filter(([y]) => y >= 2010 && y <= 2019).reduce((a, [, g]) => a + g, 0) / 10;
const peak = s.gdpGrowthPct.filter(([y]) => y >= 1990).reduce((a, b) => (b[1] > a[1] ? b : a));
assertClaim(peak[0] === 2019, 'growth since 1990 peaked in 2019');
assertClaim([2021, 2022, 2023, 2024].every((y) => v('gdpGrowthPct', y) > growth) && v('gdpGrowthPct', 2020) < growth, `growth in ${L} was the slowest since 2020`);
assertClaim(growth < v('gdpGrowthPct', L - 1) && v('gdpGrowthPct', L - 1) < v('gdpGrowthPct', L - 2) && v('gdpGrowthPct', L - 2) < v('gdpGrowthPct', L - 3) && v('gdpGrowthPct', L - 3) > v('gdpGrowthPct', L - 4), 'growth slowed three years in a row, after a rise');
const gdp72 = v('gdp', 1972);
assertClaim(gdp > pakGdp && pakPeople[L].population > bdPeople[L].population, 'economy larger than Pakistan, which has more people');
const aheadYears = s.gdpPerCapita.filter(([y, x]) => y >= 2010 && x > valueIn(india.gdpPerCapita, y)!).map(([y]) => y);
assertClaim(JSON.stringify(aheadYears) === JSON.stringify([2019, 2020, 2021, 2022, 2023, 2024]), 'GDP per person above India in 2019–2024 only (since 2010)');
assertClaim(indPerHead > perHead && indPpp > ppp, `India ahead again in ${L}, also at PPP`);
const timesSince2000 = perHead / v('gdpPerCapita', 2000);
assertClaim(timesSince2000 > 6, 'GDP per person more than six times its 2000 level');
const infl24 = v('inflationPct', 2024);
assertClaim(infl24 > 10 && s.inflationPct.filter(([y]) => y > 2011 && y < 2024).every(([, x]) => x < infl24) && v('inflationPct', 2011) > infl24, 'inflation in 2024 the highest since 2011');
assertClaim(infl < infl24 && infl > 6, `inflation eased in ${L} but stayed above 6%`);
assertClaim(s.inflationPct.filter(([y]) => y >= 2016 && y <= 2021).every(([, x]) => x > 5 && x < 6), 'inflation between 5% and 6% from 2016 to 2021');
assertClaim(s.remittances.every(([y, x]) => y === L || x < rem), `remittances in ${L} a record`);
const rem23 = v('remittances', 2023);
assertClaim(rem / rem23 > 1.5, 'remittances up by more than half in two years');
assertClaim(s.remittancesPctGdp.filter(([y]) => y > 2015 && y < L).every(([, x]) => x < remPct) && v('remittancesPctGdp', 2015) > remPct, `remittance share of GDP the highest since 2015`);
assertClaim(net.value > 50 && valueIn(s.internetPct, net.year - 1)! < 50, 'internet users passed half the population in the latest year');
assertClaim(e.incomeGroup === 'Lower middle income', 'World Bank lower-middle-income group');

const title = `Bangladesh Economy ${L}: GDP ${usd(gdp).replace(' billion', ' Billion')} | AtlasFigures`;
const description = `Bangladesh's GDP was ${usd(gdp)} in ${L}, or ${usdWhole(perHead)} per person. Growth slowed to ${pct(growth)}, inflation was ${pct(infl)} and money sent home by workers abroad hit a record ${usd(rem)}.`;

const cards = [
  { label: 'GDP', value: usd(gdp).replace(' billion', 'B'), year: L, note: 'current US$' },
  { label: 'GDP per person', value: usdWhole(perHead), year: L },
  { label: 'GDP growth', value: signedPct(growth), year: L },
  { label: 'Inflation', value: pct(infl), year: L, note: 'consumer prices' },
];
const factGroups = [
  { title: 'Size', facts: [
    { label: 'GDP', value: usd(gdp), note: `${L}, current US$` },
    { label: 'Share of world GDP', value: pct(worldShare) },
    { label: 'GDP growth', value: signedPct(growth), note: 'constant prices' },
  ] },
  { title: 'Income', facts: [
    { label: 'GDP per person', value: usdWhole(perHead) },
    { label: 'GDP per person, PPP', value: intDollars(ppp) },
    { label: 'World Bank income group', value: e.incomeGroup! },
  ] },
  { title: 'Prices and jobs', facts: [
    { label: 'Inflation', value: pct(infl), note: 'consumer prices' },
    { label: 'Unemployment', value: pct(unemp), note: 'modelled ILO estimate' },
  ] },
  { title: 'Links abroad', facts: [
    { label: 'Remittances received', value: usd(rem) },
    { label: 'Remittances, share of GDP', value: pct(remPct) },
    { label: 'Internet users', value: pct(net.value), note: `${net.year}, share of people` },
  ] },
];
// Mobile tiles show what the swipe cards above do not (the cards already carry GDP, per person, growth, inflation).
const highlights = [
  { label: 'Share of world GDP', value: pct(worldShare) },
  { label: 'Per person, PPP', value: intDollars(ppp) },
  { label: 'Remittances', value: usd(rem).replace(' billion', 'B') },
  { label: 'Internet users', value: pct(net.value) },
];

const rows = bd.tableYears.map((y) => ({
  year: y, gdp: valueIn(s.gdp, y), gdpPerCapita: valueIn(s.gdpPerCapita, y), growth: valueIn(s.gdpGrowthPct, y),
  inflation: valueIn(s.inflationPct, y), remittancesPctGdp: valueIn(s.remittancesPctGdp, y),
}));
const gdpChartYears = [1972, 1975, 1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025].filter((y) => y <= L);
const ldc = bd.ldc;
const ldcLong = (d: string) => longDate(d);

const faq = [
  { q: 'What is the GDP of Bangladesh?', a: `${usd(gdp)} in ${L}, measured in current US dollars by the World Bank. That is about ${pct(worldShare)} of world GDP and larger than Pakistan's ${usd(pakGdp)}.` },
  { q: 'What is the per capita income of Bangladesh?', a: `GDP per person was ${usdWhole(perHead)} in ${L}, or ${intDollars(ppp)} when adjusted for the lower prices of goods and services in Bangladesh (purchasing power parity). Official "per capita income" figures from Bangladesh usually use gross national income, which also counts income earned abroad, so they differ from GDP per person.` },
  { q: 'Is Bangladesh a developing country?', a: `Yes. The World Bank places it in its ${e.incomeGroup!.toLowerCase()} group, and the UN still counts it among the least developed countries: its departure from that list, first set for ${ldcLong(ldc.originalDate)}, was moved to ${ldcLong(ldc.newDate)}.` },
  { q: `What was the inflation rate in Bangladesh in ${L}?`, a: `Consumer prices rose ${pct(infl)} in ${L}, after ${pct(infl24)} in 2024, the fastest increase since 2011. Between 2016 and 2021 it never left the 5–6% range.` },
  { q: 'How much remittance does Bangladesh receive?', a: `${usd(rem)} in ${L}, a record and equal to ${pct(remPct)} of GDP. In 2023 it was ${usd(rem23)}.` },
];

const citation = [
  { '@type': 'CreativeWork', name: 'World Development Indicators', url: WDI_URL, publisher: { '@type': 'Organization', name: 'The World Bank' } },
  { '@type': 'CreativeWork', name: 'World Population Prospects 2024', url: 'https://population.un.org/wpp/', publisher: { '@type': 'Organization', name: 'United Nations, Department of Economic and Social Affairs, Population Division' } },
  ...ldc.sources.map((x) => ({ '@type': 'CreativeWork', name: x.name, url: x.url })),
];
const schema = [
  {
    '@type': 'Article',
    '@id': abs(`${PAGE}#article`),
    headline: `Bangladesh economy ${L}: GDP of ${usd(gdp)}, income per person, inflation and remittances`,
    description,
    datePublished: iso(PUBLISHED),
    dateModified: iso(UPDATED),
    author: { '@type': 'Organization', name: PUBLISHER, url: abs('/about/') },
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: abs(PAGE),
    image: abs('/icon-512.png'),
    inLanguage: 'en',
    about: { '@type': 'Country', name: 'Bangladesh', sameAs: 'https://en.wikipedia.org/wiki/Bangladesh' },
    citation,
  },
  {
    '@type': 'Dataset',
    '@id': abs(`${PAGE}#dataset`),
    name: `Bangladesh GDP, GDP per person, growth, inflation, unemployment, remittances and internet use, 1960–${L}`,
    description: `Yearly World Bank World Development Indicators for Bangladesh, as published (WDI update of ${longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person in current US$, GDP per person at purchasing power parity, real GDP growth, consumer price inflation, unemployment (modelled ILO estimate), personal remittances received and individuals using the internet.`,
    url: abs(PAGE),
    creator: { '@id': ORG_ID },
    isBasedOn: [WDI_URL],
    temporalCoverage: `1960/${L}`,
    spatialCoverage: { '@type': 'Place', name: 'Bangladesh' },
    variableMeasured: Object.values(econMeta.indicators).map((i: any) => `${i.label} (${i.unit})`),
    dateModified: iso(UPDATED),
    license: econMeta.licenceUrl,
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: abs('/data/bangladesh-economy.csv') }],
  },
  {
    '@type': 'FAQPage',
    '@id': abs(`${PAGE}#faq`),
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title={title}
  description={description}
  section="economy"
  appTitle="Bangladesh economy"
  back="/economy/"
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Bangladesh', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Bangladesh economy</h1>
        <p class="answer">
          Bangladesh produced <strong>{usd(gdp)}</strong> of goods and services in {L}, about <strong>{usdWhole(perHead)} per person</strong>, by World Bank figures. That is {pct(worldShare)} of the world economy, and growth slowed to {pct(growth)}, the weakest year since 2020.
        </p>
        <div class="dates"><span>Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Bangladesh economy, ${L}`} cards={cards} />
        <KeyFacts variant="mobile" country="Bangladesh" code="bd" year={L} groups={factGroups} highlights={highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">
          Bangladesh's economy has grown without a single shrinking year for half a century. What changed recently is the pace, the price level and how much the country leans on money from its workers abroad.
        </p>

        <div class="story-block prose">
          <h2>How big is the economy of Bangladesh?</h2>
          <p>Its gross domestic product was {usd(gdp)} in {L}, up from {usd(gdp72)} in 1972, the first full year after independence (both in current US dollars, so the rise also reflects inflation and exchange rates). Bangladesh's output is now bigger than Pakistan's {usd(pakGdp)}, even though Pakistan's population ({millions(pakPeople[L].population)} in {L}) outnumbers Bangladesh's ({millions(bdPeople[L].population)}).</p>
        </div>
        <LineChart
          title={`Bangladesh GDP, 1972–${L}`}
          subtitle="Gross domestic product in current US dollars; tap or point at the line for any year."
          points={gdpChartYears.map((y) => ({ x: y, y: v('gdp', y) }))}
          format="usdBillions"
          highlight={L}
          estimateLabel="World Bank data"
          source={WDI}
          sourceUrl={WDI_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How fast is Bangladesh's economy growing?</h2>
          <p>Real GDP grew {pct(growth)} in {L}, the third slowdown in a row and the weakest result since the pandemic year of 2020 and well behind the {pct(sasGrowth)} recorded for the World Bank's South Asia region (which, in the Bank's current grouping, does not include Pakistan or Afghanistan). Through the 2010s growth averaged {pct(avg1019)} a year and peaked at {pct(peak[1])} in 2019. The economy has not shrunk in any year since 1975; the deepest falls on record came in 1971 ({signedPct(g71)}) and 1972 ({signedPct(g72)}), the years of the war of independence and its aftermath.</p>
        </div>
        <LineChart
          title={`Yearly GDP growth in Bangladesh, 1976–${L}`}
          subtitle="Change in real GDP (constant prices) from the year before."
          points={growthYears.map(([x, y]) => ({ x, y }))}
          format="percent"
          highlight={L}
          estimateLabel="World Bank data"
          source={WDI}
          sourceUrl={WDI_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Bangladesh richer than India?</h2>
          <p>Not in {L}: GDP per person was {usdWhole(perHead)} in Bangladesh and {usdWhole(indPerHead)} in India. But in current dollars Bangladesh was ahead every year from 2019 to 2024, before India moved back in front. Adjusted for prices (purchasing power parity), India is also ahead, at {intDollars(indPpp)} against {intDollars(ppp)}. Either way, Bangladesh's GDP per person is {Number(timesSince2000.toFixed(1))} times what it was in 2000.</p>
        </div>
        <div class="age-row" role="group" aria-label="GDP per person, Bangladesh and India">
          <div><span class="y">2019, first year ahead</span><div class="v">{usdWhole(v('gdpPerCapita', 2019))}</div><span class="d">India: {usdWhole(valueIn(india.gdpPerCapita, 2019)!)}</span></div>
          <div><span class="y">2024, last year ahead</span><div class="v">{usdWhole(v('gdpPerCapita', 2024))}</div><span class="d">India: {usdWhole(valueIn(india.gdpPerCapita, 2024)!)}</span></div>
          <div><span class="y">{L}, India in front</span><div class="v">{usdWhole(perHead)}</div><span class="d">India: {usdWhole(indPerHead)}</span></div>
        </div>

        <div class="story-block prose">
          <h2>How fast are prices rising in Bangladesh?</h2>
          <p>Consumer prices rose {pct(infl)} in {L}, easing from {pct(infl24)} in 2024, which was the steepest rise since 2011. From 2016 to 2021 the rate had held between 5% and 6% every year, so prices are still climbing much faster than Bangladeshis were used to.</p>
        </div>

        <div class="story-block prose">
          <h2>How much money do Bangladeshis abroad send home?</h2>
          <p>A record {usd(rem)} in {L}, more than half as much again as the {usd(rem23)} of 2023. Remittances were worth {pct(remPct)} of GDP, their largest share since 2015. They are the other side of the emigration on our <a href={path('/country/bangladesh/population/')}>Bangladesh population page</a>: more people have left the country than arrived every year since the 1970s.</p>
        </div>
        <LineChart
          title={`Remittances received by Bangladesh, 1976–${L}`}
          subtitle="Personal remittances received, current US dollars."
          points={s.remittances.map(([x, y]) => ({ x, y }))}
          format="usdBillions"
          highlight={L}
          estimateLabel="World Bank data"
          source={WDI}
          sourceUrl={WDI_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>When will Bangladesh stop being a least developed country?</h2>
          <p>Not before <time datetime={ldc.newDate}>{ldcLong(ldc.newDate)}</time>. Bangladesh had met the UN's criteria and was due to leave the least developed country list on <time datetime={ldc.originalDate}>{ldcLong(ldc.originalDate)}</time>, but at its request the General Assembly gave it three more years to prepare, in a resolution adopted without a vote in October 2026. Leaving the list means losing trade preferences reserved for these countries, such as duty-free, quota-free access to the European Union under its Everything But Arms scheme. In the World Bank's own income ranking, Bangladesh is already a {e.incomeGroup!.toLowerCase()} economy.</p>
        </div>

        <div class="story-block prose">
          <h2>How many people in Bangladesh use the internet?</h2>
          <p>{pct(net.value)} of the population in {net.year}, the first year more than half were online, according to the International Telecommunication Union's figures in the World Bank database. Unemployment, by the ILO's modelled estimate, was {pct(unemp)} of the labour force in {L}; that measure counts people without work who are looking for it.</p>
        </div>

        <nav class="related" aria-label="Related pages">
          <h2>More about Bangladesh and its neighbours</h2>
          <ul>
            <li><a href={path('/country/bangladesh/population/')}>Bangladesh population: density, births and migration</a></li>
            <li><a href={path('/country/india/population/')}>India's population</a></li>
            <li><a href={path('/country/pakistan/population/')}>Pakistan's population</a></li>
            <li><a href={path('/rankings/gdp-by-country/')}>Where Bangladesh ranks by GDP</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person, every country ranked</a></li>
            <li><a href={path('/rankings/remittances-by-country/')}>Remittances received, country by country</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation rates around the world</a></li>
            <li><a href={path('/economy/')}>Economy of every country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h"
          title={`Bangladesh economy by year, 1975–${L}`}
          subtitle="Half a century of output, income, prices and money from abroad, as the World Bank publishes it. The CSV holds every year from 1960."
          rows={rows}
          latest={L}
          source={WDI}
          sourceUrl={WDI_URL}
          checkedOn={checkedOn}
          csv={path('/data/bangladesh-economy.csv')}
          csvName="bangladesh-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Quick answers about the Bangladesh economy</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (national accounts, current US$), GDP per person at PPP (International Comparison Program), GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances (IMF balance of payments and World Bank staff estimates), internet users (International Telecommunication Union). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
            <li><a href="https://population.un.org/wpp/">UN DESA Population Division, World Population Prospects 2024</a>: populations of Bangladesh and Pakistan.</li>
            <li>Least developed country status: {ldc.decided}. Reported by {ldc.sources.map((x, i) => (<>{i > 0 && ', '}<a href={x.url}>{x.name}</a></>))}.</li>
          </ul>
          <p class="note">Bangladesh's national accounts follow a July–June fiscal year, so World Bank GDP figures for Bangladesh cover fiscal years rather than calendar years. Dollar figures are in current prices; growth is measured in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={PUBLISHED}>{longDate(PUBLISHED)}</time> · Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Bangladesh economy', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Bangladesh" code="bd" year={L} groups={factGroups} highlights={highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>

  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
