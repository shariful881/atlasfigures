---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ury from '../../../data/countries/uruguay.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the most urban country in Latin America and
// the Caribbean, already 78% urban in 1950; a 2020 peak and a lower total every year since 2021; deaths first above
// births in 2021 and every year from 2024; fertility under 2.1 since 2004; 2100 back to its 1950 size.
const PAGE = '/country/uruguay/population/';
const un = countryData(ury.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ury.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
assertClaim([...lac1].sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct)[0].iso3 === 'URY' && [...lac1].sort((a: any, b: any) => at(b, 1950).urbanPct - at(a, 1950).urbanPct)[0].iso3 === 'URY', 'most urban now and in 1950');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2020, 'peak 2020');
assertClaim(un.years.filter((r) => r.year >= 2021).every((r) => r.population < y[r.year - 1].population), 'lower every year from 2021');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2021 && un.years.filter((r) => r.year >= 2024).every((r) => r.naturalChange < 0) && y[2023].naturalChange >= 0, 'deaths above births 2021–2022 and from 2024');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2004 && un.years.filter((r) => r.year >= 2004).every((r) => r.fertility < 2.1), 'under 2.1 from 2004');
assertClaim(Math.abs(y[2100].population - y[1950].population) / y[1950].population < 0.02, '2100 close to 1950');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2003, 'largest outflow 2003');

const title = `Uruguay Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Most Urban in Its Region, Past Its 2020 Peak | AtlasFigures`;
const description = `Uruguay's ${CURRENT_YEAR} total of ${millions(c.population)} (UN estimate) sits a little under its 2020 high. ${pct(c.urbanPct!)} of Uruguayans are urban, the region's highest urban level, and by 2100 the country returns to about its 1950 size.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ury.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, ury.tableYears);

const faq = [
  { q: 'Which Latin American country is the most urban?', a: `Uruguay, ${pct(c.urbanPct!)}; it was ahead in 1950 too, at ${pct(y[1950].urbanPct!)}.` },
  { q: "In what year was Uruguay's population largest?", a: `2020: ${millions(peak.population)}. From 2021 onward each UN total is smaller.` },
  { q: 'When did Uruguay start recording more deaths than births?', a: `They first did in 2021, and from 2024 they do every year; ${CURRENT_YEAR} pencils in ${int(c.deaths)} deaths beside ${int(c.births)} births.` },
  { q: "How long has Uruguay's fertility stayed under 2.1?", a: `Since 2004, without interruption; currently ${dec(c.fertility, 2)}.` },
  { q: 'What will Uruguay look like in 2100?', a: `${millions(y[2100].population)}, practically the 1950 figure (${millions(y[1950].population)}).` },
];

const schema = countrySchema({
  page: PAGE, slug: ury.slug, name: ury.name, wikipedia: ury.wikipedia,
  headline: `Uruguay's ${millions(c.population)}: the region's most urban population; past its 2020 peak; back to 1950 size by 2100`,
  description,
  datasetName: 'Uruguay population, urban share and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Uruguay for selected years from 1950 to ${CURRENT_YEAR} (each year 2020–2024 included, with 1975 and 2003), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ury.published, updated: ury.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Uruguay"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Uruguay", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Uruguay: a city-dwelling country past its peak</h1>
        <LiveCounter
          label="Uruguay: population estimate now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Follows the UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, with near ${int(-c.change / 365)} fewer each day`}
        />
        <p class="answer">
          Uruguay's {CURRENT_YEAR} UN estimate stands at <strong>{millions(c.population)}</strong>, just short of the 2020 high. Urban areas hold <strong>{pct(c.urbanPct!)}</strong>, the region's top share.
        </p>
        <div class="dates"><span>Updated <time datetime={ury.updated}>{longDate(ury.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Uruguay" code="uy" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Does any Latin American country outdo Uruguay's urban share?</h2>
          <p>None does: among the region's million-plus nations nobody tops Uruguay's {pct(c.urbanPct!)} today. Back in 1950 its {pct(y[1950].urbanPct!)} also led the region.</p>
        </div>

        <div class="story-block prose">
          <h2>From which year has Uruguay been getting smaller?</h2>
          <p>Since 2021. The 2020 count, {millions(peak.population)}, is the series maximum, and each later total comes in lower. Deaths overtook births first in 2021 and permanently from 2024; fertility, under 2.1 since 2004, is {dec(c.fertility, 2)}. The deepest migration loss fell in {outTop.year}: {int(-outTop.netMigrants)} net.</p>
        </div>
        <LineChart
          title="Uruguayans counted from 1950 to 2100"
          subtitle="Peak in 2020; mid-year totals, projection dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Uruguay be smaller in 2100?</h2>
          <p>Yes, roughly back to its starting point. The UN expects {millions(y[2050].population)} for 2050; the closing 2100 figure, {millions(y[2100].population)}, nearly matches 1950's {millions(y[1950].population)}.</p>
        </div>
        <RelatedPages iso3={ury.iso3} name={ury.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Uruguay table: 1950 to 2100 with 2020–2024 in full"
          subtitle="The 2020 row is the peak; totals decline from 2021."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ury.slug}-population.csv`)}
          csvName={`${ury.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Uruguay in a nutshell</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ury.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ury.published}>{longDate(ury.published)}</time> · Updated <time datetime={ury.updated}>{longDate(ury.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Uruguay population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Uruguay" code="uy" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
