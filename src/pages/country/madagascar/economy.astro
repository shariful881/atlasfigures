---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/madagascar.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/madagascar/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const loGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x < growth).map(([y]) => y));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const pcBelow = rankBy('gdpPerCapita', L).length - B.pcRank!;
const netRank = rankBy('internetPct', net!.year).find((r) => r.iso3 === c.iso3)!.rank;
const netN = rankBy('internetPct', net!.year).length;
const remJump = Math.round((rem!.value / v('remittances', L - 1)! - 1) * 100);
const gdpX = (gdp / v('gdp', 2000)!).toFixed(1);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.pcRank === 184 && pcBelow === 2 && B.e.incomeGroup === 'Low income', 'record GDP and per head, yet third-lowest per head; low income');
assertClaim(loGrowSince === 2020 && growth < 3.1, 'slowest growth since 2020');
assertClaim(worst[0] === 2002 && worst[1] < -12 && g(2020) < -7 && g(2009) < -3.9, 'worst 2002; 2020 and 2009 falls');
assertClaim(iMax[0] === 1995 && iMax[1] > 49 && infl.value > 8, 'inflation peak 1995');
assertClaim(netRank === 175 && netN === 182 && net!.value < 19, 'internet 175th of 182');
assertClaim(isMax(s.remittances) && remJump === 52 && Number(gdpX) === 4.2, 'record remittances up 52%; GDP 4.2x 2000');
assertClaim([2021, 2022, 2023, 2024, L].every((y) => g(y) >= 3 && g(y) < 5), 'growth 3-5% since 2021');

const title = `Madagascar Economy ${L}: Record Output, Yet Among the Poorest | AtlasFigures`;
const description = `Never before has Madagascar produced as much as in ${L} — ${usd(gdp)} — but at ${usdWhole(perHead)} a head only two economies rank lower. Growth eased to ${pct(growth)}; inflation was ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Madagascar among the poorest economies?', a: `Third from the bottom. At ${usdWhole(perHead)} a head in ${L} — Madagascar\'s best figure so far — just ${pcBelow} economies sat further down the list. It is classed as low income.` },
  { q: `Did Madagascar\'s growth slow in ${L}?`, a: `Yes, to ${pct(growth)} from ${pct(g(L - 1))} — Madagascar\'s softest year since 2020.` },
  { q: 'What was Madagascar\'s worst recession?', a: `2002, when output dropped ${pct(Math.abs(worst[1]))}. Other deep falls came in 2009 (${signedPct(g(2009))}) and 2020 (${signedPct(g(2020))}).` },
  { q: 'Is inflation high in Madagascar?', a: `Moderate: ${pct(infl.value)} in ${L}. The 1995 spike reached ${pct(iMax[1])}.` },
  { q: 'Do many Malagasy people use the internet?', a: `Few: ${pct(net!.value)} in ${net!.year}, ${ord(netRank)} of ${netN} economies with ITU data.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Madagascar's economy in ${L}: a record total, but third-lowest income per head`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Malagasy economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Madagascar', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Madagascar's economy: bigger than ever, still near the bottom</h1>
        <p class="answer">
          Madagascar produced more than ever in {L} — <strong>{usd(gdp)}</strong> — yet per person that is only <strong>{usdWhole(perHead)}</strong>, with just two economies below it.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Madagascar economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Madagascar" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">An island economy that has grown 3–5% a year since 2021, from one of the lowest starting points anywhere.</p>

        <div class="story-block prose">
          <h2>How can Madagascar set a record and still be so poor?</h2>
          <p>Both are true. Total output of {usd(gdp)} and output per head of {usdWhole(perHead)} in {L} were the highest yet in current dollars — but only {pcBelow} economies in the World Bank list recorded less per head. Price-adjusted, the figure is {intDollars(ppp!)}.</p>
        </div>
        <LineChart
          title={`GDP per Malagasy, ${s.gdpPerCapita[0][0]}–${L}`}
          subtitle="GDP per person in current US dollars."
          points={s.gdpPerCapita.map(([x, y]) => ({ x, y }))}
          format="usd" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is the Malagasy economy losing momentum?</h2>
          <p>A little. Growth of {pct(growth)} in {L}, versus {pct(g(L - 1))} before, was Madagascar's weakest showing since 2020. Dollar GDP is about {gdpX} times its 2000 size.</p>
        </div>
        <div class="story-block prose">
          <h2>Which years hit Madagascar hardest?</h2>
          <p>2002 was the worst, with output down {pct(Math.abs(worst[1]))} — the sharpest drop since records begin in 1961. Output also shrank {pct(Math.abs(g(2009)))} in 2009 and {pct(Math.abs(g(2020)))} in 2020.</p>
        </div>
        <LineChart
          title={`Madagascar's yearly change in real GDP, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Growth of output at constant prices, %."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>How quickly are prices rising in Madagascar?</h2>
          <p>By {pct(infl.value)} in {L}, after {pct(i(L - 1))} in {L - 1}. The 1995 peak was {pct(iMax[1])}.</p>
        </div>
        <div class="story-block prose">
          <h2>What else stands out in Madagascar's numbers?</h2>
          <p>Remittances jumped {remJump}% in {L} to a record {usd(rem!.value)}. Internet users numbered just {pct(net!.value)} of the population in {net!.year} ({ord(netRank)} of {netN}); modelled unemployment stood at {pct(unemp!)}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Madagascar and East Africa: related pages</h2>
          <ul>
            <li><a href={path('/country/madagascar/population/')}>Madagascar's population</a></li>
            <li><a href={path('/country/mozambique/economy/')}>Mozambique's economy</a></li>
            <li><a href={path('/country/tanzania/economy/')}>Tanzania's economy</a></li>
            <li><a href={path('/country/kenya/economy/')}>Kenya's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Madagascar's main figures, selected years`}
          subtitle="Decades from 1960, 1995 and 2002, then annually from 2015; complete data in the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/madagascar-economy.csv')} csvName="madagascar-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Madagascar's economy: readers' questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Income groups are the World Bank's. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Malagasy economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Madagascar" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
