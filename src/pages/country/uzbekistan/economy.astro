---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/uzbekistan.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/uzbekistan/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const CA = ['KAZ', 'UZB', 'TKM', 'KGZ', 'TJK'];
const caOrder = CA.slice().sort((a, b) => valueIn(econData(b).series.gdp, L)! - valueIn(econData(a).series.gdp, L)!);
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const jump = Math.round((gdp / v('gdp', L - 1)! - 1) * 100);
const remRank = rankBy('remittances', L).find((r) => r.iso3 === c.iso3)!.rank;
const remX = (rem!.value / v('remittances', 2015)!).toFixed(1);
const gdpX = Math.round(gdp / v('gdp', 2000)!);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 60 && caOrder[0] === 'KAZ' && caOrder[1] === 'UZB', 'record GDP and per person; 60th; second in Central Asia');
assertClaim(jump === 21 && hiGrowSince === 2021 && growth > 7.6, 'dollar GDP up 21%; growth fastest since 2021');
assertClaim(lowInflSince === 2016 && iMax[0] === 2018 && iMax[1] > 17 && s.inflationPct[0][0] === 2011, 'inflation lowest since 2016; peak 2018 in a series from 2011');
assertClaim(isMax(s.remittances) && remRank === 12 && Number(remX) === 4.4 && remPct!.value > 14, 'record remittances, 12th, 4.4x 2015, over 14% of GDP');
assertClaim(worst[0] === 1992 && worst[1] < -11 && s.gdp[0][0] === 1987 && gdpX === 11, 'worst 1992; GDP from 1987; 11x 2000');
assertClaim([2021, 2022, 2023, 2024, L].every((y) => g(y) > 6) && remPct!.value > 100 / 7 && gdp < valueIn(econData('KAZ').series.gdp, L)! / 2, 'over 6% since 2021; over a seventh; under half Kazakhstan');

const title = `Uzbekistan Economy ${L}: ${pct(growth)} Growth, ${usd(rem!.value)} From Abroad | AtlasFigures`;
const description = `Real growth of ${pct(growth)} took Uzbekistan\'s GDP to ${usd(gdp)} in ${L}. Remittances of ${usd(rem!.value)} equalled ${pct(remPct!.value)} of GDP, and inflation dipped to ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Uzbekistan growing faster than before?', a: `It is — ${pct(growth)} in ${L}, up from ${pct(g(L - 1))}, and the quickest pace since 2021. In current-dollar terms output leapt ${jump}% in a single year to ${usd(gdp)}.` },
  { q: 'Is Uzbekistan bigger than Kazakhstan?', a: `No. Uzbekistan is Central Asia\'s second-largest economy; its ${usd(gdp)} is less than half of Kazakhstan\'s total. Worldwide it ranks ${ord(B.gdpRank!)}.` },
  { q: 'How much do Uzbek migrants send home?', a: `${usd(rem!.value)} in ${L}, ${remX}-fold the 2015 inflow. That is ${pct(remPct!.value)} of GDP and puts Uzbekistan ${ord(remRank)} among the world\'s recipients.` },
  { q: 'Is Uzbekistan bringing inflation down?', a: `It is easing: ${pct(infl.value)} in ${L}, below every year back to 2016. Uzbek inflation figures from the World Bank go back only to 2011, and 2018 was the worst year at ${pct(iMax[1])}.` },
  { q: 'What happened after Uzbekistan became independent?', a: `Output fell in 1991–1995, most steeply in 1992 (${signedPct(worst[1])}). Dollar GDP is now roughly ${gdpX} times its 2000 level.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Uzbekistan's economy in ${L}: fast growth and record migrant transfers`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Uzbek economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Uzbekistan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Uzbekistan's economy: a fast-rising Central Asian market</h1>
        <p class="answer">
          Output in Uzbekistan expanded <strong>{pct(growth)}</strong> after inflation in {L}, lifting dollar GDP to <strong>{usd(gdp)}</strong>; migrants sent home {usd(rem!.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Uzbekistan economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Uzbekistan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Growth has topped 6% each year from 2021, and remittances are worth more than a seventh of GDP.</p>

        <div class="story-block prose">
          <h2>Why did Uzbekistan's GDP jump in {L}?</h2>
          <p>Two things moved together. Real output rose {pct(growth)}, the quickest since 2021, and the dollar value of GDP climbed {jump}% to {usd(gdp)}, a record that ranks {ord(B.gdpRank!)} in the world and trails only Kazakhstan among Central Asian economies.</p>
        </div>
        <LineChart
          title={`Uzbekistan's dollar output, ${s.gdp[0][0]}–${L}`}
          subtitle="Current-dollar GDP, as published from 1987 onward."
          points={s.gdp.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why do migrant transfers matter so much to Uzbekistan?</h2>
          <p>Because of their scale. Uzbeks working abroad sent home {usd(rem!.value)} in {L} — more than in any earlier year and over four times the 2015 inflow; they amount to {pct(remPct!.value)} of GDP and form the {ord(remRank)}-biggest received by any country.</p>
        </div>
        <LineChart
          title={`Migrant remittances into Uzbekistan, ${s.remittances[0][0]}–${L}`}
          subtitle="Money received from Uzbeks working abroad, current US$."
          points={s.remittances.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Uzbek inflation coming down?</h2>
          <p>Gradually. Prices climbed {pct(infl.value)} over {L}, a shade under {L - 1}'s {pct(i(L - 1))} and Uzbekistan's mildest rise since 2016. The World Bank's series only starts in 2011, and its peak came in 2018 at {pct(iMax[1])}.</p>
        </div>
        <div class="story-block prose">
          <h2>How much does each Uzbek produce?</h2>
          <p>A new high of {usdWhole(perHead)} in {L}, or {intDollars(ppp!)} when price differences are taken into account. ILO-modelled unemployment was {pct(unemp!)}; internet use covered {pct(net!.value)} of the population in {net!.year}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Uzbekistan and Central Asia: related pages</h2>
          <ul>
            <li><a href={path('/country/uzbekistan/population/')}>Uzbekistan's population</a></li>
            <li><a href={path('/country/kazakhstan/economy/')}>Kazakhstan's economy</a></li>
            <li><a href={path('/country/russia/economy/')}>Russia's economy</a></li>
            <li><a href={path('/country/afghanistan/economy/')}>Afghanistan's economy</a></li>
            <li><a href={path('/rankings/remittances-by-country/')}>Remittances league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Uzbekistan's economy by year`}
          subtitle="1987 (first GDP year), 1992, 2000, 2005, 2010–2011 and every year from 2015 onward appear here; the CSV file is complete."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/uzbekistan-economy.csv')} csvName="uzbekistan-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Uzbekistan's economy: five questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Central Asia" here means Kazakhstan, Uzbekistan, Turkmenistan, Kyrgyzstan and Tajikistan. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Uzbek economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Uzbekistan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
