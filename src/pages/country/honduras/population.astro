---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import hnd from '../../../data/countries/honduras.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the largest growth since 1950 among Latin
// American and Caribbean countries of a million or more; the 1998 fall in life expectancy (third-largest anywhere that
// year), with Hurricane Mitch's landfall and toll cited from Britannica, and an earlier 1973–1974 dip (counts only);
// births at their all-time high in 2025; a peak in 2090.
const PAGE = '/country/honduras/population/';
const un = countryData(hnd.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (hnd.verification as any).checkedOn as string | undefined;
const BRIT_URL = 'https://www.britannica.com/event/Hurricane-Mitch';
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
const grow = (d: any) => at(d).population / at(d, 1950).population;
assertClaim([...lac1].sort((a: any, b: any) => grow(b) - grow(a))[0].iso3 === 'HND', 'largest growth since 1950 in LAC (1M+)');
const times = grow({ years: un.years });
assertClaim(times > 7 && times < 7.3, 'about seven times 1950');
const cam = wpp.filter((d: any) => d.subregion === 'Central America').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(cam.slice(0, 3).join() === 'MEX,GTM,HND', 'third in Central America');
assertClaim(y[1998].lifeExpectancy < y[1997].lifeExpectancy - 5 && y[1999].lifeExpectancy > y[1997].lifeExpectancy, '1998 drop of over 5 years, recovered in 1999');
const drop = (d: any) => at(d, 1998).lifeExpectancy - at(d, 1997).lifeExpectancy;
assertClaim([...wpp].sort((a: any, b: any) => drop(a) - drop(b)).slice(0, 3).map((d: any) => d.iso3).join() === 'SSD,ERI,HND', 'third-largest drop in 1998');
assertClaim(y[1998].deaths > 1.4 * y[1997].deaths, '1998 deaths over 40% higher');
assertClaim(y[1974].lifeExpectancy < y[1972].lifeExpectancy - 3 && y[1975].lifeExpectancy > y[1972].lifeExpectancy, '1973–1974 dip');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2025, 'births peak 2025');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1954, 'fertility high 1954');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2043, 'below 2.1 in 2043');
assertClaim([...lac1].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge).slice(0, 3).map((d: any) => d.iso3).join() === 'GTM,HTI,HND', 'third-youngest median age in LAC');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2090 && natNeg === 2090, 'peak and natural decrease 2090');
assertClaim(un.years.every((r) => r.netMigrants < 0), 'net departures every year');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2008, 'urban majority 2008');

const title = `Honduras Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Sevenfold Since 1950, and the Mitch Year in the Data | AtlasFigures`;
const description = `Honduras (${millions(c.population)} residents in ${CURRENT_YEAR}; UN estimate) has grown roughly sevenfold since 1950, a bigger rise than any regional country of over a million can show. Life expectancy fell sharply in 1998; that was the year of Hurricane Mitch.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: hnd.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, hnd.tableYears);

const faq = [
  { q: 'Has any Latin American country grown faster than Honduras since 1950?', a: `Not among those above a million people; the Honduran count has risen roughly sevenfold, to ${millions(c.population)} today.` },
  { q: 'How did Hurricane Mitch affect Honduras in the population data?', a: `The UN life-expectancy estimate falls from ${dec(y[1997].lifeExpectancy, 1)} in 1997 to ${dec(y[1998].lifeExpectancy, 1)} in 1998 and deaths rise from ${int(y[1997].deaths)} to ${int(y[1998].deaths)}. Britannica says Mitch reached northern Honduras on 29 October 1998 and killed more than 11,000 people, mostly in Honduras and Nicaragua.` },
  { q: 'Is Honduras at its all-time high for births?', a: `Yes: ${int(birthTop.births)} babies in 2025 make it the record year in the series, though each woman now has ${dec(c.fertility, 2)} children on average against ${dec(tfrTop.fertility, 2)} in ${tfrTop.year}.` },
  { q: "When will Honduras's population be at its highest?", a: `${peak.year}, with ${millions(peak.population)}; in that year, too, deaths are projected to edge past births.` },
  { q: 'How does Honduras rank in Central America?', a: `Third by population, behind Mexico and Guatemala, with ${int(c.densityPerKm2)} people per km².` },
];

const schema = countrySchema({
  page: PAGE, slug: hnd.slug, name: hnd.name, wikipedia: hnd.wikipedia,
  headline: `Honduras's ${millions(c.population)}: sevenfold growth since 1950, the 1998 drop in life expectancy, and births at a record`,
  description,
  datasetName: 'Honduras population, life expectancy and births, 1950–2100',
  datasetDescription: `Mid-year population of Honduras for selected years from 1950 to ${CURRENT_YEAR} (every year 1972–1975 and 1997–1999 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: hnd.published, updated: hnd.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Hurricane Mitch', url: BRIT_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Honduras"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Honduras", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Honduras: the region's biggest growth story since 1950</h1>
        <LiveCounter
          label="Honduras: estimated population at present"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Mid-${CURRENT_YEAR} UN World Population Prospects 2024 level, with roughly ${int(c.change / 365)} added daily`}
        />
        <p class="answer">
          The UN's estimate for Honduras in {CURRENT_YEAR} is <strong>{millions(c.population)}</strong>, against {millions(y[1950].population)} in 1950. Among the region's nations above a million, that is the largest increase over the period.
        </p>
        <div class="dates"><span>Updated <time datetime={hnd.updated}>{longDate(hnd.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Honduras" code="hn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has any country in the region grown more than Honduras?</h2>
          <p>No. Its population has grown roughly sevenfold since 1950, the biggest rise among the region's nations above a million inhabitants. That leaves Honduras third in Central America, after Mexico and Guatemala. A small net outflow, {int(-c.netMigrants)} people this year, appears in all years from 1950 to 2100 and barely dents a natural increase of {int(c.naturalChange)}.</p>
        </div>
        <LineChart
          title="Honduras's population, 1950 to 2100"
          subtitle="Estimates to 2023, then the dashed projection, which levels off in 2090."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How did 1998 show up in Honduras's life-expectancy figures?</h2>
          <p>It fell by more than five years, from {dec(y[1997].lifeExpectancy, 1)} to {dec(y[1998].lifeExpectancy, 1)}, while deaths rose from {int(y[1997].deaths)} to {int(y[1998].deaths)}; only South Sudan and Eritrea had a bigger fall that year. By 1999 the figure was back to {dec(y[1999].lifeExpectancy, 1)}. According to Britannica, Hurricane Mitch made landfall in northern Honduras on 29 October 1998 and killed more than 11,000 people, mostly in Honduras and Nicaragua. An earlier dip, to {dec(y[1974].lifeExpectancy, 1)} in 1974, appears in the UN series without any cause attached.</p>
        </div>
        <LineChart
          title="Life expectancy at birth for Hondurans, 1950–2050"
          subtitle="Each year 1972–1975 and 1997–1999 is plotted, so both dips show; dashed after 2023."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Honduras having more babies than ever?</h2>
          <p>In raw numbers, yes: {int(birthTop.births)} births in {birthTop.year}, the series high. The rate per woman tells the opposite story, {dec(tfrTop.fertility, 2)} in {tfrTop.year} against {dec(c.fertility, 2)} today, with 2.1 crossed in {repl}. Only Guatemala and Haiti have a younger median age in the region than Honduras's {dec(c.medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>When will Honduras reach its peak population?</h2>
          <p>Late, in {peak.year}, at {millions(peak.population)}; that same year deaths begin to exceed births. By the national definition, townspeople have been the larger group since {urbanHalf}; they make up {pct(c.urbanPct!)} now, rising to {pct(y[2050].urbanPct!)} by 2050.</p>
        </div>
        <RelatedPages iso3={hnd.iso3} name={hnd.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Honduras by year, 1972–1975 and 1997–1999 in full"
          subtitle="Rows around 1974 and 1998 carry both life-expectancy dips; 2025 holds the birth record."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${hnd.slug}-population.csv`)}
          csvName={`${hnd.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Short answers on Honduras</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{hnd.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={BRIT_URL}>Encyclopaedia Britannica, "Hurricane Mitch"</a>: landfall in northern Honduras on 29 October 1998; more than 11,000 people killed, mostly in Honduras and Nicaragua.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={hnd.published}>{longDate(hnd.published)}</time> · Updated <time datetime={hnd.updated}>{longDate(hnd.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Honduras population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Honduras" code="hn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
