---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import gab from '../../../data/countries/gabon.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: 92.3% urban, the highest of any African
// country above a million; urban majority since 1978; net migration never negative 1950–2100, positive from 1969, the
// most in 2012; about 5.6 times its 1950 size; 10 people per km²; growth in every year to 2100 (2.6 times today);
// fertility from a 1983 high of 5.76, under 2.1 only from 2084.
const PAGE = '/country/gabon/population/';
const un = countryData(gab.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (gab.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const a1 = wpp.filter((d: any) => at(d).population >= 1e6 && d.region === 'Africa');
assertClaim([...a1].sort((a: any, b: any) => (at(b).urbanPct ?? 0) - (at(a).urbanPct ?? 0))[0].iso3 === 'GAB', 'most urban in Africa');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1978, 'urban majority 1978');
assertClaim(un.years.every((r) => r.netMigrants >= 0) && un.years.find((r) => r.netMigrants > 0)!.year === 1969, 'no net outflow ever; positive from 1969');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2012, 'largest inflow 2012');
const since = c.population / y[1950].population;
assertClaim(since > 5.5 && since < 5.7, 'about 5.6 times 1950');
assertClaim(un.years.every((r) => !y[r.year - 1] || r.population > y[r.year - 1].population) && y[2100].population / c.population > 2.5 && y[2100].population / c.population < 2.7, 'growth every year; 2.6x by 2100');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1983 && repl === 2084, 'fertility high 1983, under 2.1 in 2084');

const title = `Gabon Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Africa's Most Urban Nation, Never a Net Outflow | AtlasFigures`;
const description = `Gabon numbers ${millions(c.population)} (UN, ${CURRENT_YEAR}), with ${pct(c.urbanPct!)} in urban areas: no other African nation of a million-plus comes close. Not one year from 1950 to 2100 records net emigration.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: gab.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, gab.tableYears);

const faq = [
  { q: 'Which African country has the highest urban share?', a: `Gabon, at ${pct(c.urbanPct!)}, among nations with over a million inhabitants; Libya is next.` },
  { q: 'Has Gabon ever had net emigration?', a: `No. UN net migration is zero for 1950–1968 and positive in every year since, peaking at ${int(inTop.netMigrants)} in 2012. The data carry no explanation.` },
  { q: 'In which year did Gabon cross 50% urban?', a: `1978; in 1950 just ${pct(y[1950].urbanPct!)} of people were urban.` },
  { q: 'Is Gabon thinly settled?', a: `Yes, fairly: about ${int(c.densityPerKm2)} people per km².` },
  { q: 'How large is Gabon projected to become?', a: `It adds people annually right up to 2100, when the UN expects ${millions(y[2100].population)}; that would be about 2.6 times today.` },
];

const schema = countrySchema({
  page: PAGE, slug: gab.slug, name: gab.name, wikipedia: gab.wikipedia,
  headline: `Gabon's ${millions(c.population)}: the most urban of Africa's 1M+ nations; never a year of net emigration; growth to 2100`,
  description,
  datasetName: 'Gabon population, urban share and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Gabon for selected years from 1950 to ${CURRENT_YEAR}, including 1969, 1978, 1983 and 2012, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: gab.published, updated: gab.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Gabon"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Gabon", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Gabon: a town-dwelling nation that draws people in</h1>
        <LiveCounter
          label="Gabon: population estimate this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Moves on from the mid-${CURRENT_YEAR} UN World Population Prospects 2024 estimate at roughly ${int(c.change / 365)} added daily`}
        />
        <p class="answer">
          Gabon's population for {CURRENT_YEAR} is <strong>{millions(c.population)}</strong> in UN estimates, and urban areas hold <strong>{pct(c.urbanPct!)}</strong>, Africa's top share.
        </p>
        <div class="dates"><span>Updated <time datetime={gab.updated}>{longDate(gab.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Gabon" code="ga" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Does any African country beat Gabon's urban share?</h2>
          <p>None does, counting countries on the continent with over a million inhabitants: urban areas hold {pct(c.urbanPct!)} in Gabon, Libya coming second. Urban residents crossed half in 1978; in 1950 they were {pct(y[1950].urbanPct!)}.</p>
        </div>
        <LineChart
          title="Gabon's town-dweller percentage, 1950–2050"
          subtitle="National definition; projected years dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.urbanPct!, projection: r.projection }))}
          format="percent"
          highlight={CURRENT_YEAR}
          refLine={{ y: 50, label: 'half' }}
          source="UN World Urbanization Prospects 2025"
          sourceUrl={WUP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Gabon a net receiver of migrants?</h2>
          <p>Yes, in every year where the balance is not zero. UN net migration is zero for 1950–1968 and positive from 1969 onward, including every projected year; the largest inflow, {int(inTop.netMigrants)}, came in 2012. The series gives no reasons.</p>
        </div>

        <div class="story-block prose">
          <h2>Does Gabon's population ever dip?</h2>
          <p>Never, from 1950 through 2100. Today's count is about 5.6 times the {int(y[1950].population)} of 1950, spread at {int(c.densityPerKm2)} per km². Fertility, highest in 1983 at {dec(tfrTop.fertility, 2)}, is {dec(c.fertility, 2)} now, staying above 2.1 until 2084. Projected: {millions(y[2050].population)} (2050), {millions(y[2100].population)} (2100).</p>
        </div>
        <RelatedPages iso3={gab.iso3} name={gab.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Gabon: 1969, 1978, 1983, 2012 and each decade"
          subtitle="Net migration is never negative; 2012 holds the largest inflow."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${gab.slug}-population.csv`)}
          csvName={`${gab.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Gabon: the data at a glance</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{gab.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={gab.published}>{longDate(gab.published)}</time> · Updated <time datetime={gab.updated}>{longDate(gab.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Gabon population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Gabon" code="ga" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
