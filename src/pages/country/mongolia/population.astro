---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import mng from '../../../data/countries/mongolia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the lowest density of any country of 1M+;
// fertility from 7.41 (1966) to under 2.1 in 2003–2005, back to 3.01 by 2015, highest in Eastern Asia now; births
// peak 2015; no fall in any year; urban majority since 1977; growth to 2100.
const PAGE = '/country/mongolia/population/';
const un = countryData(mng.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (mng.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...m1].sort((a: any, b: any) => at(a).densityPerKm2 - at(b).densityPerKm2)[0].iso3 === 'MNG', 'lowest density of 1M+');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1966, 'fertility high 1966');
const under = un.years.filter((r) => r.year <= CURRENT_YEAR && r.fertility < 2.1).map((r) => r.year);
assertClaim(under.join() === '2003,2004,2005', 'under 2.1 only 2003–2005 to date');
assertClaim(y[2015].fertility > 3 && c.fertility > 2.5, 'rebound above 3 by 2015');
const ea1 = wpp.filter((d: any) => d.subregion === 'Eastern Asia' && at(d).population >= 1e6);
assertClaim([...ea1].sort((a: any, b: any) => at(b).fertility - at(a).fertility)[0].iso3 === 'MNG', 'highest fertility in Eastern Asia');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2015, 'births peak 2015');
assertClaim(un.years.every((r) => !y[r.year - 1] || r.population >= y[r.year - 1].population), 'never a fall');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1977, 'urban majority 1977');
const back = un.years.find((r) => r.year > CURRENT_YEAR && r.fertility < 2.1)!.year;
assertClaim(back === 2042, 'projected under 2.1 again from 2042');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'growing 2100');

const title = `Mongolia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Steppe Nation at Two per km², Births That Bounced Back | AtlasFigures`;
const description = `For ${CURRENT_YEAR} the UN reckons ${millions(c.population)} Mongolians, spread at ${int(c.densityPerKm2)} per km²; nowhere else above one million is emptier. Fertility dipped below 2.1 during 2003–2005, then recovered past 3 by 2015.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: mng.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, mng.tableYears);

const faq = [
  { q: 'Is Mongolia the most sparsely populated country on Earth?', a: `Counting only nations above one million, Mongolia has the fewest per km²: ${int(c.densityPerKm2)} in UN figures.` },
  { q: 'Why is Mongolian fertility higher than in 2005?', a: `A rebound shows in the UN numbers, unexplained: ${dec(y[2005].fertility, 2)} in 2005, ${dec(y[2015].fertility, 2)} by 2015, ${dec(c.fertility, 2)} now, the top rate in Eastern Asia.` },
  { q: 'When were the most Mongolian babies born?', a: `In ${birthTop.year}: ${int(birthTop.births)}.` },
  { q: 'Any year of decline in Mongolia\'s history?', a: `None appears in the UN data for 1950–2100.` },
  { q: 'Mongolia at the century\'s end: what size?', a: `${millions(y[2100].population)}, still edging upward.` },
];

const schema = countrySchema({
  page: PAGE, slug: mng.slug, name: mng.name, wikipedia: mng.wikipedia,
  headline: `Mongolia's ${millions(c.population)}: the lowest density of any 1M+ country; a fertility rebound after 2005; no year of decline`,
  description,
  datasetName: 'Mongolia population, density and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Mongolia for selected years from 1950 to ${CURRENT_YEAR}, including 1966, 1977, 2003, 2005, 2008 and 2015, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: mng.published, updated: mng.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Mongolia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Mongolia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Mongolia: the emptiest country, with births that bounced back</h1>
        <LiveCounter
          label="Mongolia: live population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Built on UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), adding approximately ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          By UN estimate there are <strong>{millions(c.population)}</strong> Mongolians in {CURRENT_YEAR}. With just <strong>{int(c.densityPerKm2)}</strong> of them per km², no nation topping one million is more thinly settled.
        </p>
        <div class="dates"><span>Updated <time datetime={mng.updated}>{longDate(mng.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Mongolia" code="mn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Just how thinly peopled is Mongolia?</h2>
          <p>Emptier than any other nation of a million-plus: {int(c.densityPerKm2)} residents per km². Yet towns hold most of them, {pct(c.urbanPct!)} today and a majority ever since {urbanHalf}.</p>
        </div>

        <div class="story-block prose">
          <h2>Why did Mongolian fertility rise again?</h2>
          <p>The rebound is in the data; its causes are not. The rate was {dec(tfrTop.fertility, 2)} in {tfrTop.year} and {dec(y[2005].fertility, 2)} in 2005, under 2.1 only across 2003–2005, before climbing to {dec(y[2015].fertility, 2)} in 2015. The current {dec(c.fertility, 2)} tops Eastern Asia; projections bring it under 2.1 again from {back}. The record year for births: {birthTop.year}, {int(birthTop.births)}.</p>
        </div>
        <LineChart
          title="Mongolia's fertility, 1950–2050: the fall and the rebound"
          subtitle="Births per woman with the 2.1 line; projected years dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'mark 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Does Mongolia's count ever dip?</h2>
          <p>No year from 1950 to 2100 falls below its predecessor. Mid-century brings {millions(y[2050].population)}; 2100 closes on {millions(y[2100].population)}.</p>
        </div>
        <RelatedPages iso3={mng.iso3} name={mng.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Mongolia, with 1966, 2003–2008 and 2015 shown"
          subtitle="Fertility dips under 2.1 in the 2003 and 2005 rows, then recovers."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${mng.slug}-population.csv`)}
          csvName={`${mng.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Mongolia, figure by figure</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{mng.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={mng.published}>{longDate(mng.published)}</time> · Updated <time datetime={mng.updated}>{longDate(mng.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Mongolia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Mongolia" code="mn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
