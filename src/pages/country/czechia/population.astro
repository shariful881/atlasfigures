---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import cze from '../../../data/countries/czechia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only for 2022: the largest net inflow
// per head in Europe (1 million+) in 2022, a population peak in 2023 and a lower total each year since; births in 2026 the
// fewest since 1950; fertility at a low of 1.14 in 1999; more deaths than births in most years since 1994.
const PAGE = '/country/czechia/population/';
const un = countryData(cze.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (cze.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2022 && inTop.netMigrants > 3e5, 'net arrivals above 300,000 in 2022, the series high');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d, 2022).population >= 1e6);
const perHead = (d: any) => at(d, 2022).netMigrants / at(d, 2022).population;
assertClaim([...e1].sort((a: any, b: any) => perHead(b) - perHead(a))[0].iso3 === 'CZE', 'largest net inflow per head in Europe 2022');
assertClaim([2023, 2024, 2025].every((n) => y[n].netMigrants < 0), 'net departures 2023–2025');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2023 && [2024, 2025, CURRENT_YEAR].every((n) => y[n].population < y[n - 1].population), 'peak 2023, lower each year since');
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const bLow = est.reduce((a, b) => (b.births < a.births ? b : a));
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bLow.year === CURRENT_YEAR && bTop.year === 1974, 'fewest births since 1950 this year; most in 1974');
const tLow = est.reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(tLow.year === 1999, 'fertility low 1999');
const natNeg = est.filter((r) => r.year >= 1994 && r.naturalChange < 0).length;
assertClaim(natNeg > (CURRENT_YEAR - 1994 + 1) / 2 && est.find((r) => r.naturalChange < 0)!.year === 1986, 'deaths over births in most years since 1994; first in 1986');
assertClaim(un.years.filter((r) => r.year > CURRENT_YEAR).every((r) => r.naturalChange < 0), 'natural decrease every projected year');
const eeu = wpp.filter((d: any) => d.subregion === 'Eastern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(eeu.slice(0, 5).join() === 'RUS,UKR,POL,ROU,CZE', 'fifth in Eastern Europe after Russia, Ukraine, Poland, Romania');
assertClaim(c.change < 0, 'falling this year');

const title = `Czechia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Influx in 2022, Highest in 2023, Record-Low Births Now | AtlasFigures`;
const description = `Czechia's population is estimated at ${millions(c.population)} for ${CURRENT_YEAR} (UN). Net arrivals of ${int(inTop.netMigrants)} in 2022 pushed it to a 2023 high; it has slipped every year since, and ${CURRENT_YEAR} has the fewest births of any year from 1950.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: cze.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, cze.tableYears);

const faq = [
  { q: 'How many people moved to Czechia in 2022?', a: `The UN puts net arrivals at ${int(inTop.netMigrants)} that year, the most in its series and, relative to population, the most of any European country above a million. Its files give the count without the reasons.` },
  { q: "Has Czechia's population started to decline?", a: `Yes. Its highest count, ${millions(peak.population)}, came in 2023; each later mid-year figure is lower, falling to ${millions(y[2100].population)} by 2100 in the projection.` },
  { q: 'Is Czechia recording its fewest births?', a: `Yes: the ${CURRENT_YEAR} projection of ${int(c.births)} births is the lowest annual figure since 1950, against ${int(bTop.births)} in ${bTop.year}.` },
  { q: 'What was the lowest Czech fertility rate?', a: `${dec(tLow.fertility, 2)}, recorded in ${tLow.year}; today the rate is ${dec(c.fertility, 2)}.` },
  { q: 'Are deaths outpacing births in Czechia?', a: `In the majority of years from 1994, and in every projected year: ${int(c.deaths)} deaths against ${int(c.births)} births in ${CURRENT_YEAR}.` },
];

const schema = countrySchema({
  page: PAGE, slug: cze.slug, name: cze.name, wikipedia: cze.wikipedia,
  headline: `Czechia's ${millions(c.population)}: a record inflow in 2022, a peak in 2023, and the fewest births since 1950`,
  description,
  datasetName: 'Czechia population, births and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Czechia for selected years from 1950 to ${CURRENT_YEAR} (every year 2020–2026 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: cze.published, updated: cze.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Czechia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Czechia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Czechia: an inflow, a peak and a slide</h1>
        <LiveCounter
          label="Czechia: estimated population this instant"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Starts from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} level and subtracts about ${int(-c.change / 365)} a day`}
        />
        <p class="answer">
          Czechia now numbers <strong>{millions(c.population)}</strong> ({CURRENT_YEAR}, UN), after a 2023 maximum of {millions(peak.population)}. A one-year jump in arrivals in 2022 lifted the total; since then fewer births and net departures have pulled it back.
        </p>
        <div class="dates"><span>Updated <time datetime={cze.updated}>{longDate(cze.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Czechia" code="cz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why did Czechia's population jump in 2022?</h2>
          <p>Because of arrivals: net migration reached {int(inTop.netMigrants)} that year, against {int(y[2021].netMigrants)} in 2021, the largest figure in the Czech series and, per head, the largest in any European country above a million. The UN files hold that count, not the story behind it. The next three years show net departures instead: {int(-y[2023].netMigrants)}, {int(-y[2024].netMigrants)} and {int(-y[2025].netMigrants)}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Czechia, net migration 2021 to 2024 (UN)">
          <div><span class="y">2021</span><div class="v">{int(y[2021].netMigrants)}</div><span class="d">Net arrivals</span></div>
          <div><span class="y">2022</span><div class="v">{int(y[2022].netMigrants)}</div><span class="d">Net arrivals</span></div>
          <div><span class="y">2024</span><div class="v">{int(-y[2024].netMigrants)}</div><span class="d">Net departures</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is Czechia's population falling now?</h2>
          <p>Yes. After the 2023 maximum, {millions(peak.population)}, the figures for 2024, 2025 and {CURRENT_YEAR} each come in lower. Deaths first topped births in 1986 and have done so in the majority of years from 1994; the projection has them ahead every year from now on. By 2100 the projection is down to {millions(y[2100].population)}.</p>
        </div>
        <LineChart
          title="Czech population through 1950–2100, around the 2023 high"
          subtitle="UN mid-year estimates around the 2023 high, followed by the dashed medium variant."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Are Czech births at a record low?</h2>
          <p>They are. The {CURRENT_YEAR} projection, {int(c.births)}, is below every annual figure since 1950; the high was {int(bTop.births)} in {bTop.year}. Fertility bottomed out in {tLow.year}, at {dec(tLow.fertility, 2)}, recovered somewhat, and stands at {dec(c.fertility, 2)}. Median age: {dec(c.medianAge, 1)}.</p>
        </div>
        <LineChart
          title="Czech fertility from 1950, with the 1999 low"
          subtitle="Children per woman, UN estimates and the dashed projection to 2050; 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 per woman' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Where does Czechia rank in Eastern Europe?</h2>
          <p>Fifth by population, after Russia, Ukraine, Poland and Romania. Its people live {dec(c.lifeExpectancy, 1)} years on average, with {int(c.densityPerKm2)} of them to each km².</p>
        </div>
        <RelatedPages iso3={cze.iso3} name={cze.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Czech figures for each year 2020–2026, and earlier decades"
          subtitle="Look at 2022 for the influx and 2023 for the maximum."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${cze.slug}-population.csv`)}
          csvName={`${cze.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Czechia: readers ask</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{cze.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={cze.published}>{longDate(cze.published)}</time> · Updated <time datetime={cze.updated}>{longDate(cze.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Czechia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Czechia" code="cz" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
