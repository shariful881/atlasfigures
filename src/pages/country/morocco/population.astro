---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ma from '../../../data/countries/morocco.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fertility at the edge of replacement after a
// fast fall, net emigration in every year since 1953 (and in every projected year), one of Africa's oldest and
// longest-lived populations, a peak in 2058.
const PAGE = '/country/morocco/population/';
const un = countryData(ma.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ma.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const lastIn = un.years.filter((r) => r.netMigrants >= 0).at(-1)!.year;
assertClaim(lastIn === 1952, 'net emigration in every year from 1953 to 2100');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrMax.year === 1962 && below === 2030 && c.fertility > 2.1 && un.years.filter((r) => r.year >= below).every((r) => r.fertility < 2.1), 'fertility peak 1962; just above 2.1 now, below from 2030 on');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2058 && natLoss === 2067, 'peak 2058; deaths exceed births from 2067');
const af5 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population > 5e6);
const le = [...af5].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy).map((d: any) => d.iso3);
assertClaim(le.slice(0, 3).join(',') === 'TUN,DZA,MAR', 'third-longest life expectancy among African countries above five million');
const af10 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population > 10e6);
const old = [...af10].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).map((d: any) => d.iso3);
assertClaim(old[0] === 'TUN' && old[1] === 'MAR', 'second-oldest median age among African countries above ten million');
const north = wpp.filter((d: any) => d.subregion === 'Northern Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(north.indexOf('MAR') === 3, 'fourth in Northern Africa');
assertClaim(y[2000].fertility < y[1980].fertility / 2, 'fertility more than halved between 1980 and 2000');

const title = `Morocco Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Fertility Near Replacement | AtlasFigures`;
const description = `Morocco (${millions(c.population)} residents, UN ${CURRENT_YEAR}): fertility at ${dec(c.fertility, 2)}, emigrants outnumbering arrivals each year, and a UN-projected peak of ${millions(peak.population)} around ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ma.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Net migration', value: int(c.netMigrants) },
  { label: 'Peak year', value: String(peak.year) },
];

const rows = displayRows(un.years, ma.tableYears);

const faq = [
  { q: "What is Morocco's population?", a: `Roughly ${millions(c.population)} as of 1 July ${CURRENT_YEAR} by UN estimate. Globally that is ${ord(c.worldRank!)}; within Northern Africa it is fourth.` },
  { q: 'Is Morocco below replacement fertility?', a: `Not yet. The ${CURRENT_YEAR} rate is ${dec(c.fertility, 2)}, a shade above 2.1, and the UN medium projection crosses below it in ${below} for good.` },
  { q: 'Do more Moroccans emigrate than people arrive?', a: `Yes. Since 1953 every UN year, estimated or projected through 2100, shows more people leaving than coming; this year the gap is around ${int(Math.round(-c.netMigrants / 1000))} thousand.` },
  { q: 'In which year does Morocco reach its population high?', a: `${peak.year}, at ${millions(peak.population)} if the medium path holds; deaths first exceed births in ${natLoss}.` },
  { q: 'Is life expectancy in Morocco high for Africa?', a: `Yes. At ${dec(c.lifeExpectancy, 1)} years it ranks third on the continent, after Tunisia and Algeria, counting countries of five million or more.` },
];

const schema = countrySchema({
  page: PAGE, slug: ma.slug, name: ma.name, wikipedia: ma.wikipedia,
  headline: `Morocco's ${millions(c.population)}: fertility near 2.1, steady emigration and a ${peak.year} peak`,
  description,
  datasetName: 'Morocco population, fertility, net migration and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Morocco for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ma.published, updated: ma.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Morocco"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Morocco', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Morocco: small families, steady emigration</h1>
        <LiveCounter
          label="Morocco: moving population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} reference, plus roughly ${int(c.change / 365)} per day`}
        />
        <p class="answer">
          Morocco numbers about <strong>{millions(c.population)}</strong> this year by UN estimate, {ord(c.worldRank!)} among countries. Women have about <strong>{dec(c.fertility, 2)} children</strong>, close to the replacement level; emigration exceeds immigration every year, and growth has slowed to {pct(c.growthRatePct)}.
        </p>
        <div class="dates"><span>Updated <time datetime={ma.updated}>{longDate(ma.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Morocco" code="ma" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How did Moroccan families get smaller so fast?</h2>
          <p>Within one generation it more than halved: the 1980 rate of {dec(y[1980].fertility, 2)} became {dec(y[2000].fertility, 2)} by 2000, after a {tfrMax.year} high of {dec(tfrMax.fertility, 2)}. The {CURRENT_YEAR} rate, {dec(c.fertility, 2)}, sits just above 2.1, and the UN projects it under that line from {below}. Births are now about {int(Math.round(c.births / 1000))} thousand a year.</p>
        </div>
        <LineChart
          title="Moroccan fertility from 1950, projected to 2050"
          subtitle="Moroccan births per woman by year; projected part dashed, replacement level marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'the 2.1 line' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Does Morocco lose people to migration?</h2>
          <p>Every year, in net terms. Departures outweigh arrivals in all UN years after 1952, and the projection keeps it so to 2100; for {CURRENT_YEAR} the outflow is about {int(Math.round(-c.netMigrants / 1000))} thousand. Natural increase, births minus deaths, is still larger at about {int(Math.round(c.naturalChange / 1000))} thousand, so the total keeps rising for now.</p>
        </div>

        <div class="story-block prose">
          <h2>How old is Morocco's population compared with the rest of Africa?</h2>
          <p>Older than almost anywhere else on the continent. Its median age of {dec(c.medianAge, 1)} is the highest in Africa after Tunisia's, counting countries of ten million or more, and its life expectancy of {dec(c.lifeExpectancy, 1)} years ranks third among those of five million or more. Urban residents make up {pct(c.urbanPct!)} by the national definition.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Morocco">
          <div><span class="y">1970</span><div class="v">{dec(y[1970].medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Projected</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is a population peak coming for Morocco?</h2>
          <p>Yes. The central UN path tops out in {peak.year} with {millions(peak.population)}. Deaths only overtake births from {natLoss}; steady emigration tips the balance earlier. The 2100 total falls back to {millions(y[2100].population)}.</p>
        </div>
        <LineChart
          title="Morocco's population, 1950–2100: a crest in the late 2050s"
          subtitle="Moroccan total by year, projection dashed; a gentle decline follows the high point."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={ma.iso3} name={ma.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Morocco in figures, 1950 to 2100"
          subtitle="Every row after 1950 shows net emigration; the 2030 row is the first with fertility under 2.1."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ma.slug}-population.csv`)}
          csvName={`${ma.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Morocco in quick answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ma.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ma.published}>{longDate(ma.published)}</time> · Updated <time datetime={ma.updated}>{longDate(ma.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Morocco population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Morocco" code="ma" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
