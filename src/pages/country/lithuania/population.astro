---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ltu from '../../../data/countries/lithuania.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peak 1991 (3.70 million), now about 76% of it,
// seventh-largest fall from its own peak among 1M+ countries; net departures every year 1989–2018 (most in 2010), net
// arrivals 2019–2024 (most in 2022) and departures again from 2025; the only rises after 1991 in 2020 and 2022–2024;
// deaths above births every year since 1994; 89.6 men per 100 women; fertility under 2.1 since 1988.
const PAGE = '/country/lithuania/population/';
const un = countryData(ltu.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ltu.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991 && c.population / peak.population > 0.75 && c.population / peak.population < 0.76, 'peak 1991, about 76% left');
const l1 = wpp.filter((d: any) => at(d).population >= 1e6);
const fromTop = (d: any) => at(d).population / Math.max(...d.years.filter((r: any) => r.year <= CURRENT_YEAR).map((r: any) => r.population));
assertClaim([...l1].sort((a: any, b: any) => fromTop(a) - fromTop(b)).findIndex((d: any) => d.iso3 === 'LTU') === 6, 'seventh-largest drop');
const nm = (a: number, b: number) => un.years.filter((r) => r.year >= a && r.year <= b);
assertClaim(nm(1989, 2018).every((r) => r.netMigrants < 0) && nm(2019, 2024).every((r) => r.netMigrants > 0) && y[2025].netMigrants < 0 && y[1988].netMigrants > 0, 'migration phases');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 2010 && inTop.year === 2022, 'outflow peak 2010, inflow peak 2022');
const ups = un.years.filter((r) => r.year > 1991 && r.population > y[r.year - 1].population).map((r) => r.year);
assertClaim(ups.join() === '2020,2022,2023,2024', 'rises after 1991');
assertClaim(un.years.filter((r) => r.year >= 1994).every((r) => r.naturalChange < 0) && y[1993].naturalChange > 0, 'natural decrease from 1994');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...l1].sort((a: any, b: any) => sr(a) - sr(b)).findIndex((d: any) => d.iso3 === 'LTU') === 9, 'tenth-lowest sex ratio');
assertClaim(un.years.filter((r) => r.year >= 1988).every((r) => r.fertility < 2.1) && y[1987].fertility >= 2.1, 'under 2.1 since 1988');

const title = `Lithuania Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Baltic Republic a Quarter Below 1991, Arrivals Briefly Ahead | AtlasFigures`;
const description = `Lithuania's ${CURRENT_YEAR} population (UN): ${millions(c.population)}, about three quarters of the ${millions(peak.population)} tallied in 1991. Thirty straight years of net emigration (1989–2018) were followed by net arrivals over 2019–2024; deaths have topped births in each year since 1994.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ltu.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, ltu.tableYears);

const faq = [
  { q: "What was Lithuania's peak population?", a: `${millions(peak.population)} in 1991; about 76% of that remains in ${CURRENT_YEAR}, the seventh-largest proportional loss among nations above a million.` },
  { q: 'When did Lithuania have its biggest net emigration?', a: `2010: ${int(-outTop.netMigrants)} net departures, within the 1989–2018 stretch of continuous outflows.` },
  { q: 'Has migration into Lithuania picked up lately?', a: `Yes; 2019 through 2024 show net arrivals, 2022 being the biggest year (${int(inTop.netMigrants)}). Reasons are absent from the source, and 2025 turns negative again.` },
  { q: 'Have Lithuanian deaths outnumbered births for long?', a: `Every year since 1994; ${CURRENT_YEAR} expects ${int(c.deaths)} deaths and ${int(c.births)} births.` },
  { q: 'Lithuania by 2100: what does the projection give?', a: `The medium variant shows ${millions(y[2100].population)}, roughly 43% of today.` },
];

const schema = countrySchema({
  page: PAGE, slug: ltu.slug, name: ltu.name, wikipedia: ltu.wikipedia,
  headline: `Lithuania's ${millions(c.population)}: about 76% of its 1991 peak; net emigration 1989–2018; arrivals 2019–2024; natural decrease since 1994`,
  description,
  datasetName: 'Lithuania population, net migration and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Lithuania for selected years from 1950 to ${CURRENT_YEAR}, including each year 1988–1994 and 2018–2025, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ltu.published, updated: ltu.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Lithuania"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Lithuania", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Lithuania: thirty years of leaving, then a short reversal</h1>
        <LiveCounter
          label="Lithuania: estimated headcount now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Calculated forward from UN World Population Prospects 2024 (mid-${CURRENT_YEAR}); losing about ${int(-c.change / 365)} each day`}
        />
        <p class="answer">
          The UN figure for Lithuania in {CURRENT_YEAR} is <strong>{millions(c.population)}</strong>, around three quarters of its 1991 maximum, <strong>{millions(peak.population)}</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={ltu.updated}>{longDate(ltu.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Lithuania" code="lt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much smaller is Lithuania than in 1991?</h2>
          <p>About a quarter smaller, set against a 1991 count of {millions(peak.population)}. Among nations above a million, only six have fallen further below their own peaks. After 1991 the total rose in just four years, 2020 and 2022–2024.</p>
        </div>

        <div class="story-block prose">
          <h2>When did Lithuanians leave, and when did arrivals take over?</h2>
          <p>From 1989 through 2018 every year shows net departures, thirty in a row, the heaviest being 2010 at {int(-outTop.netMigrants)}. Then 2019–2024 swung to net arrivals, topped by 2022 with {int(inTop.netMigrants)}. The UN expects departures to lead again from 2025. No motives are recorded.</p>
        </div>
        <LineChart
          title="Lithuania's population, 1950–2100, with the 1991 summit"
          subtitle="Mid-year values; dashed line is the UN projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Are there fewer births than deaths in Lithuania?</h2>
          <p>In every year since 1994. Women have averaged under 2.1 children since 1988 and now average {dec(c.fertility, 2)}. Males number {dec((c.male / c.female) * 100, 1)} per 100 females, tenth-lowest among million-plus nations, and the median resident is {dec(c.medianAge, 1)}. For 2100 the medium variant shows {millions(y[2100].population)}.</p>
        </div>
        <RelatedPages iso3={ltu.iso3} name={ltu.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Lithuania, 1988–1994 and 2018–2025 year by year"
          subtitle="Peak at 1991; net arrivals across 2019–2024."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ltu.slug}-population.csv`)}
          csvName={`${ltu.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Lithuania: what the UN figures show</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ltu.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ltu.published}>{longDate(ltu.published)}</time> · Updated <time datetime={ltu.updated}>{longDate(ltu.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Lithuania population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Lithuania" code="lt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
