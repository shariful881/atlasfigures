---
// Yemen health (task 174). Figures from the World Bank WDI files (src/data/wdi/, checked against the original zips
// by check-wdi) and the country profile; none typed by hand.
import HealthTopic from '../../../components/HealthTopic.astro';
import LineChart from '../../../components/LineChart.astro';
import pg from '../../../data/country-pages/yemen.json';
import { econData, econMeta, valueIn } from '../../../lib/econ';
import { profile, stat, ordinal, fromTop, fromBottom } from '../../../lib/profile';
import { assertClaim, dec } from '../../../lib/figures';
import { path } from '../../../site';

const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = (pg.pages.health as any).verification?.checkedOn;
const p = profile(pg.iso3);
const st = (id: string) => stat(p, 'health', id);
const s = econData(pg.iso3).series;
const v = (k: keyof typeof s, y: number) => valueIn(s[k], y)!;

const u5 = st('u5'), mat = st('maternal'), dpt = st('dpt'), measles = st('measles'), stunt = st('stunting'), mal = st('malaria');
const oop = st('oop'), hPc = st('healthPc'), doc = st('doctors'), beds = st('beds'), tb = st('tb'), road = st('road');
const U = u5.year!;

const before = s.dptVaccPct.filter(([y, x]) => y < dpt.year! && x <= Number(dpt.value));
const lastLower = before[before.length - 1][0];
assertClaim(fromBottom(dpt) === 2 && fromBottom(measles) === 2 && lastLower === 1997 && v('dptVaccPct', 2022) > Number(dpt.value) + 15, 'DPT and measles second lowest; DPT lowest since 1997, 15+ points below 2022');
assertClaim(fromTop(stunt) === 2 && Number(stunt.value) > v('stuntingPct', 2021), 'stunting second highest, up from 2021');
const malLow = s.malariaIncidence.reduce((a, b) => (b[1] < a[1] ? b : a));
assertClaim(malLow[0] === 2015 && Number(mal.value) > 2 * malLow[1], 'malaria lowest in 2015, now more than double');
const dPeak = s.doctorsPer1000.reduce((a, b) => (b[1] > a[1] ? b : a));
assertClaim(fromTop(oop) === 8 && fromBottom(doc) === 12 && dPeak[0] === 2004 && Number(doc.value) < dPeak[1] / 3 && fromBottom(beds) === 10, 'out-of-pocket eighth; doctors 12th lowest, under a third of the 2004 peak; beds tenth lowest');
const m90 = v('maternalMortality', 1990), u90 = v('under5Mortality', 1990);
assertClaim(Number(mat.value) < m90 / 3 && Number(u5.value) < u90 / 3 && fromTop(road) === 29, 'maternal and under-five under a third of 1990; road deaths 29th');

const title = `Yemen Health Data ${U}: Vaccination, Stunting, Malaria, Health Costs | AtlasFigures`;
const description = `Yemen's infant DPT3 coverage, ${dpt.text} in ${dpt.year}, is the second lowest anywhere. ${stunt.text} of young children are stunted and malaria has doubled since ${malLow[0]}.`;

const faq = [
  { q: 'Has maternal mortality fallen in Yemen?', a: `Yes: MMEIG modelling shows ${m90} in 1990 and ${mat.text} by ${mat.year}, counted per 100,000 live births.` },
  { q: 'Are fewer Yemeni children dying than in 1990?', a: `Yes: ${u5.text} per mille in ${U} (UN IGME), under a third of the ${u90} of 1990.` },
  { q: 'Is TB widespread in Yemen?', a: `Moderately: ${tb.text} per 100k in ${tb.year}, WHO's modelled incidence.` },
  { q: 'Are road accidents a big killer in Yemen?', a: `${road.text} traffic deaths per 100k in ${road.year}; only twenty-eight of ${road.of} countries had a higher rate.` },
];
const headline = `Yemen health ${U}: collapsing vaccination, severe stunting, malaria on the rise`;
---
<HealthTopic
  pg={pg}
  title={title}
  description={description}
  h1="Yemen's health: vaccines falter, stunting deepens"
  headline={headline}
  tableTitle={`Yemeni health indicators across 1990–${U}`}
  tableSubtitle="Twelve chosen years here; Yemen's complete record is in the CSV."
  faq={faq}
  faqTitle="Health in Yemen: four short answers"
  related={[
    { href: '/country/yemen/', label: 'Yemen in figures' },
    { href: '/country/yemen/population/', label: 'Yemen population and births' },
    { href: '/country/sudan/health/', label: 'Sudan health' },
    { href: '/country/afghanistan/health/', label: 'Afghanistan health' },
    { href: '/rankings/child-mortality-by-country/', label: 'Under-five deaths by country' },
  ]}
>
  <Fragment slot="answer">DPT immunisation reached only <strong>{dpt.text} of Yemeni babies</strong> during {dpt.year}, and measles {measles.text}. Nearly half of young children, <strong>{stunt.text}</strong>, were stunted in {stunt.year}, and malaria incidence has more than doubled since {malLow[0]}.</Fragment>
  <div class="story-block prose">
    <h2>Is child vaccination collapsing in Yemen?</h2>
    <p>It has fallen steeply since 2022. DPT coverage dropped from {v('dptVaccPct', 2022)}% that year to {dpt.text} in {dpt.year}, Yemen's weakest figure since {lastLower} and second worst of {dpt.of} countries; measles coverage is also second lowest.</p>
  </div>
  <LineChart
    title={`Yemeni infants fully vaccinated against DPT, 1990–${dpt.year}`}
    subtitle="Yemeni babies completing the diphtheria-tetanus-pertussis series, percent; WHO and UNICEF."
    points={s.dptVaccPct.filter(([y]) => y >= 1990).map(([x, y]) => ({ x, y }))}
    format="percent"
    highlight={dpt.year!}
    estimateLabel="World Bank data"
    source={WDI}
    sourceUrl={WDI_URL}
    checkedOn={checkedOn}
  />
  <div class="story-block prose">
    <h2>How widespread is stunting in Yemen?</h2>
    <p>Close to half of young Yemenis are stunted: {stunt.text} in {stunt.year}, up from {v('stuntingPct', 2021)}% a year earlier and the {ordinal(fromTop(stunt))} highest rate of {stunt.of}.</p>
  </div>
  <div class="story-block prose">
    <h2>Has malaria increased in Yemen since 2015?</h2>
    <p>Yes. WHO's Yemeni estimate sank to {malLow[1]} in {malLow[0]} and has since doubled, to {mal.text} in {mal.year}.</p>
  </div>
  <LineChart
    title={`Malaria in Yemen, 2000–${mal.year}`}
    subtitle="Estimated malaria cases per 1,000 Yemenis living in at-risk areas (WHO)."
    points={s.malariaIncidence.map(([x, y]) => ({ x, y: Number(y.toFixed(1)) }))}
    format="plain"
    unit="per 1,000 at risk"
    highlight={mal.year!}
    estimateLabel="World Bank data"
    source={WDI}
    sourceUrl={WDI_URL}
    checkedOn={checkedOn}
  />
  <div class="story-block prose">
    <h2>How much do Yemeni families pay for healthcare?</h2>
    <p>Most of it. In {oop.year}, patients themselves funded {oop.text} of health spending ({ordinal(fromTop(oop))} highest), on total outlays of {hPc.text} per person. Doctors numbered {doc.text} per 1,000 in {doc.year}, down from {dec(dPeak[1], 2)} in {dPeak[0]}, and hospital beds {beds.text}. See <a href={path('/country/yemen/population/')}>our Yemen population page</a> for births and deaths.</p>
  </div>
</HealthTopic>
