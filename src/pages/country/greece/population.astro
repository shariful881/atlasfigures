---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import grc from '../../../data/countries/greece.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: a 2010 peak and a lower total in
// every year from 2011 through the projection to 2100 (about two thirds of today by 2100); deaths above births every
// year since 2011; net departures 2011–2015 and 2021–2024; births from 177,000 in 1967 to under 70,000 now.
const PAGE = '/country/greece/population/';
const un = countryData(grc.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (grc.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2010 && un.years.filter((r) => r.year >= 2011).every((r) => r.population < y[r.year - 1].population), 'peak 2010, lower every year 2011–2100');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2011 && un.years.filter((r) => r.year >= 2011).every((r) => r.naturalChange < 0), 'deaths over births every year from 2011');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 0.62 && ratio < 0.65, 'about two thirds of today by 2100');
assertClaim([2011, 2012, 2013, 2014, 2015, 2021, 2022, 2023, 2024].every((n) => y[n].netMigrants < 0) && y[2010].netMigrants > 0 && y[2016].netMigrants > 0 && y[2025].netMigrants > 0, 'net departures 2011–2015 and 2021–2024');
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const outTop = est.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2021, 'largest net outflow 2021');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1967 && c.births < 7e4 && birthTop.births > 1.7e5, 'births 1967 peak above 170,000; under 70,000 now');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).slice(0, 3).map((d: any) => d.iso3).join() === 'ITA,PRT,GRC', 'third-oldest in Europe');
const lost = peak.population - c.population;
assertClaim(lost > 1e6, 'over a million fewer than in 2010');
const seu = wpp.filter((d: any) => d.subregion === 'Southern Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(seu.slice(0, 4).join() === 'ITA,ESP,PRT,GRC', 'fourth in Southern Europe');
const repl = un.years.find((r) => r.year > 1950 && r.fertility < 2.1)!.year;
assertClaim(repl === 1982, 'under 2.1 from 1982');

const title = `Greece Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Down Every Year Since 2010, and Still Falling | AtlasFigures`;
const description = `The UN's estimate for Greece this year, ${CURRENT_YEAR}: ${millions(c.population)}, more than a million below the 2010 high. Deaths have outrun births ever since 2011; the projection carries the decline on to ${millions(y[2100].population)} in 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: grc.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, grc.tableYears);

const faq = [
  { q: 'How far below its peak is Greece today?', a: `About ${millions(lost)}: the UN puts the 2010 high at ${millions(peak.population)}; every mid-year total since 2011 is lower than the one before.` },
  { q: 'Are Greek births falling?', a: `Sharply: ${int(birthTop.births)} in ${birthTop.year} against ${int(c.births)} projected for ${CURRENT_YEAR}, with ${int(c.deaths)} deaths.` },
  { q: 'Did many people leave Greece after 2010?', a: `The UN records net departures from 2011 to 2015 and again from 2021 to 2024, the largest being ${int(-outTop.netMigrants)} in ${outTop.year}. The source gives counts, not causes.` },
  { q: 'How small will Greece be by 2100?', a: `About two thirds of today's: ${millions(y[2100].population)}.` },
  { q: 'What is the typical age of a Greek resident?', a: `The median is ${dec(c.medianAge, 1)} years; among European countries over a million people, only Italy and Portugal have an older median.` },
];

const schema = countrySchema({
  page: PAGE, slug: grc.slug, name: grc.name, wikipedia: grc.wikipedia,
  headline: `Greece's ${millions(c.population)}: a 2010 peak, falls every year since, and births at a third of their 1967 level`,
  description,
  datasetName: 'Greece population, births and deaths, 1950–2100',
  datasetDescription: `Mid-year population of Greece for selected years from 1950 to ${CURRENT_YEAR}, including 2010–2013, 2015–2016 and 2020–2025, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: grc.published, updated: grc.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Greece"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Greece", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Greece: smaller every year since 2010</h1>
        <LiveCounter
          label="Greece: estimated population, updated live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024, mid-${CURRENT_YEAR} level, falling by around ${int(-c.change / 365)} a day`}
        />
        <p class="answer">
          Greece's population, put at <strong>{millions(c.population)}</strong> for {CURRENT_YEAR} in UN figures, has declined year after year from its 2010 peak of {millions(peak.population)}. More deaths than births each year since 2011 drive the fall, and the projection does not see it end before 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={grc.updated}>{longDate(grc.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Greece" code="gr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How long has Greece's population been shrinking?</h2>
          <p>Since 2011. The high point, {millions(peak.population)}, came in 2010; every mid-year estimate after that is lower than the previous one, a run the projection extends to 2100. Today's count is {millions(lost)} lower than at that high.</p>
        </div>
        <LineChart
          title="Greece's population across 1950–2100, peaking in 2010"
          subtitle="Estimates to 2023; after that the dashed projection declines every year to 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How large is Greece's excess of deaths over births?</h2>
          <p>About {int(c.deaths - c.births)} in {CURRENT_YEAR}; the excess has been there annually since 2011. The projection counts {int(c.deaths)} deaths and {int(c.births)} births, not much over a third of {birthTop.year}'s {int(birthTop.births)}. The fertility rate dropped under 2.1 in {repl}; it is {dec(c.fertility, 2)} today.</p>
        </div>
        <div class="age-row" role="group" aria-label="Greece, births in 1967 and this year, and deaths this year (UN)">
          <div><span class="y">{birthTop.year}</span><div class="v">{int(birthTop.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.deaths)}</div><span class="d">Deaths</span></div>
        </div>

        <div class="story-block prose">
          <h2>Did emigration add to Greece's decline?</h2>
          <p>In two stretches. Net departures appear from 2011 to 2015 ({int(-y[2012].netMigrants)} in 2012) and from 2021 to 2024, with the largest, {int(-outTop.netMigrants)}, in {outTop.year}; this year the UN expects a small net gain of {int(c.netMigrants)}. The figures record the flows but not why they happened.</p>
        </div>

        <div class="story-block prose">
          <h2>How far will Greece's population fall by 2100?</h2>
          <p>Around two thirds of the present number, {millions(y[2100].population)}, with {millions(y[2050].population)} as the 2050 waypoint. Greece's median age, {dec(c.medianAge, 1)}, is surpassed only by Italy's and Portugal's among Europe's nations of over a million; Greece also ranks fourth in Southern Europe by population.</p>
        </div>
        <RelatedPages iso3={grc.iso3} name={grc.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Greece year by year, around the 2010 high"
          subtitle="Rows for 2010–2016 and 2020–2025 trace both stretches of net departures."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${grc.slug}-population.csv`)}
          csvName={`${grc.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Greece: questions answered briefly</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{grc.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={grc.published}>{longDate(grc.published)}</time> · Updated <time datetime={grc.updated}>{longDate(grc.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Greece population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Greece" code="gr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
