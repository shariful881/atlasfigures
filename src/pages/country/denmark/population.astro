---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import dnk from '../../../data/countries/denmark.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: urban majority already in 1950
// (third in Europe); the 1981–1984 dip with deaths above births 1981–1988; net arrivals every year since 1990, largest
// 2022; deaths above births again in 2022 and from 2027; a 2042 peak and a 2100 total close to today's.
const PAGE = '/country/denmark/population/';
const un = countryData(dnk.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (dnk.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(b, 1950).urbanPct - at(a, 1950).urbanPct).slice(0, 3).map((d: any) => d.iso3).join() === 'GBR,DEU,DNK', 'third most urban in Europe in 1950');
const falls = un.years.filter((r) => r.year <= CURRENT_YEAR && y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1981,1982,1983,1984', 'falls 1981–1984 only');
const natNeg = un.years.filter((r) => r.naturalChange < 0).map((r) => r.year);
assertClaim(natNeg.filter((n) => n <= CURRENT_YEAR).join() === '1981,1982,1983,1984,1985,1986,1987,1988,2022', 'deaths above births 1981–1988 and 2022');
assertClaim(un.years.filter((r) => r.year >= 2027).every((r) => r.naturalChange < 0), 'deaths above births every year from 2027');
assertClaim(un.years.filter((r) => r.year >= 1990).every((r) => r.netMigrants > 0), 'net arrivals every year since 1990');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2022, 'largest inflow 2022');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2042, 'peak 2042');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 0.96 && ratio < 0.98, 'about 97% of today by 2100');
const since = c.population / y[1950].population;
assertClaim(since > 1.35 && since < 1.45, 'about 1.4 times 1950');
const ne1 = wpp.filter((d: any) => d.subregion === 'Northern Europe' && at(d).population >= 1e6);
assertClaim([...ne1].sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3).indexOf('DNK') === 2, 'third-largest in Northern Europe');

const title = `Denmark Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Urban Since 1950, Kept Growing by Arrivals | AtlasFigures`;
const description = `Danes total ${millions(c.population)}, the UN's mid-year figure for ${CURRENT_YEAR}. Most Danes already lived in towns in 1950; net arrivals have added people in each year from 1990, while from 2027 the projection puts deaths above births.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: dnk.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, dnk.tableYears);

const faq = [
  { q: 'Did Denmark\'s population ever shrink?', a: `Briefly: each mid-year total from 1981 to 1984 was a little lower than the year before. Deaths outnumbered births from 1981 to 1988.` },
  { q: 'Does Denmark gain people from abroad?', a: `It has in each year from 1990, on balance. The ${CURRENT_YEAR} surplus is ${int(c.netMigrants)}; the 2022 one, the largest, ${int(inTop.netMigrants)}.` },
  { q: 'Was Denmark already urban in 1950?', a: `Yes, ${pct(y[1950].urbanPct!)} by its own definition, third in Europe after the United Kingdom and Germany (states with a million-plus people). Today the share is ${pct(c.urbanPct!)}.` },
  { q: 'Will deaths overtake births in Denmark?', a: `They did in 2022; from 2027 the projection keeps them ahead every year.` },
  { q: 'How many Danes will there be in 2100?', a: `${millions(y[2100].population)}, close to today's count; the highest point, ${millions(peak.population)}, comes in ${peak.year}.` },
];

const schema = countrySchema({
  page: PAGE, slug: dnk.slug, name: dnk.name, wikipedia: dnk.wikipedia,
  headline: `Denmark's ${millions(c.population)}: urban in 1950; a dip in 1981–84; arrivals every year since 1990`,
  description,
  datasetName: 'Denmark population, net migration and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Denmark for selected years from 1950 to ${CURRENT_YEAR}, including 1981, 1984, 1985, 2015, 2022 and 2027, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: dnk.published, updated: dnk.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Denmark"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Denmark", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Denmark: a town-dwelling nation held up by newcomers</h1>
        <LiveCounter
          label="Denmark: population, estimated as you read"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`From the mid-${CURRENT_YEAR} UN World Population Prospects 2024 figure, growing by around ${int(c.change / 365)} per day`}
        />
        <p class="answer">
          Denmark's {CURRENT_YEAR} total, <strong>{millions(c.population)}</strong> on UN estimates, is 1.4 times the 1950 count. A clear majority, <strong>{pct(c.urbanPct!)}</strong>, live in urban areas, as most Danes already did in 1950.
        </p>
        <div class="dates"><span>Updated <time datetime={dnk.updated}>{longDate(dnk.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Denmark" code="dk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Was Denmark already an urban country in 1950?</h2>
          <p>It was: {pct(y[1950].urbanPct!)} of Danes lived in towns that year on the national definition, a level only the United Kingdom and Germany beat on the continent, counting states of a million-plus. The share has since climbed to {pct(c.urbanPct!)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Did Denmark really shrink in the early 1980s?</h2>
          <p>Slightly, yes. Deaths outnumbered births in every year from 1981 to 1988, and the July total edged down from 1981 to 1984 before growing again. The UN figures show the pattern; they do not explain it. Deaths topped births once more in 2022.</p>
        </div>
        <LineChart
          title="Net migration to Denmark, 1950–2100"
          subtitle="Above zero from 1990 onward; projected values dashed."
          points={rows.map((r) => ({ x: r.year, y: r.netMigrants, projection: r.projection }))}
          format="plain"
          unit="people"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How much do newcomers add to Denmark each year?</h2>
          <p>Since 1990, arrivals have exceeded departures every single year. The surplus was {int(y[2015].netMigrants)} in 2015 and peaked at {int(inTop.netMigrants)} in 2022; for {CURRENT_YEAR} it is {int(c.netMigrants)}. It stays positive across the projection, which matters: deaths are expected to outnumber births in every year from 2027.</p>
        </div>

        <div class="story-block prose">
          <h2>Will Denmark be larger or smaller in 2100?</h2>
          <p>Slightly smaller. It rises a little more, reaching {millions(peak.population)} in {peak.year}, then drifts down to {millions(y[2100].population)} by 2100, roughly 97% of today. Denmark is the third-largest country in Northern Europe after the United Kingdom and Sweden; life expectancy is {dec(c.lifeExpectancy, 1)} years and fertility {dec(c.fertility, 2)}.</p>
        </div>
        <RelatedPages iso3={dnk.iso3} name={dnk.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Danish population rows, 1981–1985 and 2022 among them"
          subtitle="Totals dip from 1981 to 1984; every net migration value after 1990 is positive."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${dnk.slug}-population.csv`)}
          csvName={`${dnk.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Denmark: reader questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{dnk.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={dnk.published}>{longDate(dnk.published)}</time> · Updated <time datetime={dnk.updated}>{longDate(dnk.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Denmark population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Denmark" code="dk" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
