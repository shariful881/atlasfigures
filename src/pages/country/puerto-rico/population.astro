---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import pri from '../../../data/countries/puerto-rico.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: fertility 0.94, fourth-lowest
// of countries and areas of 1M+; a 2001 peak and the second-steepest projected fall to 2100 after Hong Kong; the 2017
// net outflow (largest); deaths above births from 2014; oldest median age and longest life expectancy in Latin America
// and the Caribbean; fewest births in 2022.
const PAGE = '/country/puerto-rico/population/';
const un = countryData(pri.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (pri.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...m1].sort((a: any, b: any) => at(a).fertility - at(b).fertility).map((d: any) => d.iso3).indexOf('PRI') === 3 && c.fertility < 1, 'fertility under 1, fourth-lowest');
assertClaim([...m1].sort((a: any, b: any) => at(a, 2100).population / at(a).population - at(b, 2100).population / at(b).population).slice(0, 2).map((d: any) => d.iso3).join() === 'HKG,PRI', 'second-steepest projected fall');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 0.3 && ratio < 0.32, 'about 31% of today by 2100');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2001, 'peak 2001');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2017, 'largest outflow 2017');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2014 && un.years.filter((r) => r.year >= 2014).every((r) => r.naturalChange < 0), 'deaths above births from 2014');
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
assertClaim([...lac1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge)[0].iso3 === 'PRI' && [...lac1].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy)[0].iso3 === 'PRI', 'oldest and longest-lived in the region');
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(bLow.year === 2022, 'fewest births 2022');

const title = `Puerto Rico Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Island Births Below One per Woman, Steep Fall Ahead | AtlasFigures`;
const description = `Puerto Rico: ${millions(c.population)} in ${CURRENT_YEAR} per UN tallies, down from the 2001 high. Women average ${dec(c.fertility, 2)} children. From 2014 on, yearly deaths have topped yearly births without a gap; 2100's projected total is ${millions(y[2100].population)}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: pri.capital },
    { label: 'UN listing', value: pri.unName },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, pri.tableYears);

const faq = [
  { q: "Puerto Rico's births per woman: how low?", a: `${dec(c.fertility, 2)}, below one; just Hong Kong, South Korea and Taiwan are lower among places of a million-plus.` },
  { q: "When was Puerto Rico's count highest?", a: `2001, ${millions(peak.population)}; the ${CURRENT_YEAR} count is ${millions(c.population)}.` },
  { q: 'Which year had the largest net outflow from Puerto Rico?', a: `2017, when ${int(-outTop.netMigrants)} more left than came, per the UN. No reason is attached.` },
  { q: 'How far could Puerto Rico shrink?', a: `To ${millions(y[2100].population)} by 2100, near 31% of today; only Hong Kong's projected drop is steeper among places over a million.` },
  { q: 'Is anywhere in the region older than Puerto Rico?', a: `No; the median Puerto Rican is ${dec(c.medianAge, 1)}, and its ${dec(c.lifeExpectancy, 1)}-year life expectancy also leads the region.` },
];

const schema = countrySchema({
  page: PAGE, slug: pri.slug, name: pri.name, wikipedia: pri.wikipedia,
  headline: `Puerto Rico's ${millions(c.population)}: fertility under one; deaths above births since 2014; a 2017 outflow; a steep projected fall`,
  description,
  datasetName: 'Puerto Rico population, fertility and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Puerto Rico for selected years from 1950 to ${CURRENT_YEAR}, including 2001, 2014, 2016–2018, 2022 and 2023, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: pri.published, updated: pri.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Puerto Rico"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Puerto Rico", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Puerto Rico: an island with fewer cradles than graves</h1>
        <LiveCounter
          label="Puerto Rico: estimated population today"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Starts at the mid-${CURRENT_YEAR} UN World Population Prospects 2024 figure; about ${int(-c.change / 365)} fewer per day`}
        />
        <p class="answer">
          For {CURRENT_YEAR}, the UN tally for Puerto Rico is <strong>{millions(c.population)}</strong>, under its 2001 maximum, {millions(peak.population)}. Women here average <strong>{dec(c.fertility, 2)}</strong> children, fewer than one each.
        </p>
        <div class="dates"><span>Updated <time datetime={pri.updated}>{longDate(pri.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Puerto Rico" code="pr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why are so few babies born in Puerto Rico?</h2>
          <p>The UN figures measure it without explaining it: {dec(c.fertility, 2)} children per woman now against {dec(y[1950].fertility, 2)} in 1950, a level only Hong Kong, South Korea and Taiwan undercut among places of a million-plus. Births bottomed out in 2022 ({int(bLow.births)}); 1950 had {int(y[1950].births)}. Each year from 2014 has registered more deaths than births.</p>
        </div>
        <LineChart
          title="Puerto Rican totals across 1950–2100 (high point 2001)"
          subtitle="Mid-year totals; dashes show the UN projection."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What does the UN show for Puerto Rico in 2017?</h2>
          <p>Its largest net outflow: {int(-outTop.netMigrants)}, after {int(-y[2016].netMigrants)} in 2016. The July count slid to {millions(y[2017].population)}, having been {millions(y[2016].population)}. The source states no cause. Arrivals have since exceeded departures at times, by {int(y[2023].netMigrants)} in 2023.</p>
        </div>

        <div class="story-block prose">
          <h2>How elderly has Puerto Rico become?</h2>
          <p>Older than anywhere else in its region: the median resident is {dec(c.medianAge, 1)}, and lifespans, at {dec(c.lifeExpectancy, 1)} years, lead the region. Projected totals: 2050, {millions(y[2050].population)}; 2100, {millions(y[2100].population)}, near 31% of today, a fall steeper only in Hong Kong.</p>
        </div>
        <RelatedPages iso3={pri.iso3} name={pri.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Puerto Rico, 2001 peak, 2014 and 2016–2023"
          subtitle="The 2017 row has the largest net outflow; deaths exceed births from 2014."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${pri.slug}-population.csv`)}
          csvName={`${pri.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Puerto Rico: numbers in answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{pri.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={pri.published}>{longDate(pri.published)}</time> · Updated <time datetime={pri.updated}>{longDate(pri.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Puerto Rico population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Puerto Rico" code="pr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
