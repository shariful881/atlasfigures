---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import gn from '../../../data/countries/guinea.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the fifth-highest infant mortality and eighth-
// lowest life expectancy in the world; net arrivals only in 1990, 1991, 1993 and 1995, net departures otherwise (largest
// 2001); fertility that peaked in 1987; an urban share rising every year, with a majority in 2043; growth in every year
// to 2100. Counts only; the UN files give no causes.
const PAGE = '/country/guinea/population/';
const un = countryData(gn.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (gn.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const imrRank = [...wpp].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000).map((d: any) => d.iso3).indexOf('GIN');
const leRank = [...wpp].sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy).map((d: any) => d.iso3).indexOf('GIN');
assertClaim(imrRank === 4 && leRank === 7, 'fifth-highest infant mortality, eighth-lowest life expectancy');
const wafBig = big.filter((d: any) => d.subregion === 'Western Africa');
assertClaim([...wafBig].sort((a: any, b: any) => at(b).infantMortalityPer1000 - at(a).infantMortalityPer1000).slice(0, 2).map((d: any) => d.iso3).join() === 'NGA,GIN', 'second-highest infant mortality among large Western African countries, after Nigeria');
const posYears = un.years.filter((r) => r.netMigrants > 0).map((r) => r.year);
assertClaim(posYears.join() === '1990,1991,1993,1995', 'net arrivals only 1990, 1991, 1993, 1995');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(inTop.year === 1990 && outTop.year === 2001, 'largest inflow 1990, largest outflow 2001');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1987 && under === 2088, 'fertility high 1987; under 2.1 from 2088');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2043 && un.years.filter((r) => r.year > 1950 && r.year <= 2050).every((r) => r.urbanPct! >= y[r.year - 1].urbanPct!), 'urban share never fell 1950–2050; majority 2043');
assertClaim(un.years.every((r, i, a) => i === 0 || r.population > a[i - 1].population) && y[2100].population > y[2099].population, 'rises every year to 2100');
const waf = wpp.filter((d: any) => d.subregion === 'Western Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(waf.indexOf('GIN') === 7, 'eighth in Western Africa');
const times = c.population / y[1950].population;
assertClaim(times > 5 && times < 5.2, 'about five times 1950');

const title = `Guinea Population ${CURRENT_YEAR}, ${(c.population / 1e6).toFixed(1)}M: Infant Survival and a Fast-Growing Country | AtlasFigures`;
const description = `Guinea (${millions(c.population)}, UN ${CURRENT_YEAR}) has the fifth-highest infant mortality of any country or area, ${dec(c.infantMortalityPer1000!, 1)} per 1,000 births, yet its rate has fallen from ${dec(y[1990].infantMortalityPer1000!, 1)} in 1990; it grows every year to 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: gn.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Infant deaths per 1,000', value: dec(c.infantMortalityPer1000!, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, gn.tableYears);

const faq = [
  { q: 'How high is infant mortality in Guinea?', a: `${dec(c.infantMortalityPer1000!, 1)} per thousand live births in ${CURRENT_YEAR}, fifth-highest of any country or area and down from ${dec(y[1950].infantMortalityPer1000!, 1)} in 1950.` },
  { q: 'What is the average life expectancy in Guinea?', a: `${dec(c.lifeExpectancy, 1)} years at birth, eighth-lowest in the world; in 2000 it was ${dec(y[2000].lifeExpectancy, 1)}.` },
  { q: 'Did people move to Guinea around 1990?', a: `In net terms, yes, in 1990, 1991, 1993 and 1995 only; ${inTop.year} had the most, about ${int(Math.round(inTop.netMigrants / 1000))} thousand. In all other UN years more people leave than come. The data do not give reasons.` },
  { q: 'When will Guinea become mostly urban?', a: `${urbanHalf} is the year World Urbanization Prospects gives; the share is ${pct(c.urbanPct!)} today and has risen in every year since 1950.` },
  { q: 'Will Guinea still be growing in 2100?', a: `Yes: the UN's central path, ${millions(y[2050].population)} by 2050, keeps climbing to ${millions(y[2100].population)} by 2100.` },
];

const schema = countrySchema({
  page: PAGE, slug: gn.slug, name: gn.name, wikipedia: gn.wikipedia,
  headline: `Guinea's ${millions(c.population)}: among the world's highest infant mortality, a 1990s migration spell and growth to 2100`,
  description,
  datasetName: 'Guinea population, infant mortality and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Guinea for selected years from 1950 to ${CURRENT_YEAR} (1990, 1991, 1993, 1995 and 2001 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: gn.published, updated: gn.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Guinea"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Guinea", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Guinea: a young country where infant survival is still improving</h1>
        <LiveCounter
          label="Guinea: projected population right now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} level, increasing by about ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Of every thousand babies born in Guinea, <strong>{dec(c.infantMortalityPer1000!, 1)}</strong> die before age one, the fifth-highest rate anywhere, though it was {dec(y[1990].infantMortalityPer1000!, 1)} in 1990. Guinea's total for mid-{CURRENT_YEAR}, per the UN, is <strong>{millions(c.population)}</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={gn.updated}>{longDate(gn.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Guinea" code="gn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is infant mortality in Guinea so high?</h2>
          <p>The UN data quantify it but give no reasons. At {dec(c.infantMortalityPer1000!, 1)} per 1,000 live births it is fifth-highest of any country or area, and among Western Africa's nations above ten million only Nigeria's is higher. Life expectancy, {dec(c.lifeExpectancy, 1)} years, is eighth-lowest in the world, up from {dec(y[1950].lifeExpectancy, 1)} in 1950 and {dec(y[2000].lifeExpectancy, 1)} in 2000.</p>
        </div>
        <div class="age-row" role="group" aria-label="Infant deaths per 1,000 live births in Guinea">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].infantMortalityPer1000!, 1)}</div><span class="d">Per 1,000</span></div>
          <div><span class="y">1990</span><div class="v">{dec(y[1990].infantMortalityPer1000!, 1)}</div><span class="d">Per 1,000</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.infantMortalityPer1000!, 1)}</div><span class="d">Per 1,000</span></div>
        </div>

        <div class="story-block prose">
          <h2>Is Guinea losing people through emigration?</h2>
          <p>Yes, except in four years. Net arrivals appear only in 1990, 1991, 1993 and 1995, largest in {inTop.year} at about {int(Math.round(inTop.netMigrants / 1000))} thousand; in every other year more people left than came, with the biggest gap, about {int(Math.round(-outTop.netMigrants / 1000))} thousand, in {outTop.year}. The {CURRENT_YEAR} balance is an outflow of roughly {int(Math.round(-c.netMigrants / 1000))} thousand. Who moved is not recorded.</p>
        </div>
        <LineChart
          title="Guinea's population, 1950–2100"
          subtitle="UN mid-year totals, up in every year; dashes after the estimate years."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Guinea's population still rising quickly?</h2>
          <p>Yes, by {pct(c.growthRatePct)} a year; the total is {dec(times, 1)} times that of 1950 and keeps rising to {millions(y[2100].population)} in 2100. Fertility topped out at {dec(tfrTop.fertility, 2)} in {tfrTop.year}; it is {dec(c.fertility, 2)} now and drops under 2.1 only in {under}. Guinea's urban share has not fallen in any UN year since 1950; at {pct(c.urbanPct!)} today it is projected to pass half in {urbanHalf}. Guinea is eighth in Western Africa by population.</p>
        </div>
        <LineChart
          title="How Guinean fertility has changed, 1950–2050"
          subtitle="UN births per woman, highest in 1987; the medium variant is dashed; 2.1 drawn."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 mark' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={gn.iso3} name={gn.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Guinea by year, with 1990, 1991, 1993, 1995 and 2001"
          subtitle="Positive net migration appears only in the early-1990s rows; 2001 shows the largest outflow."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${gn.slug}-population.csv`)}
          csvName={`${gn.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Guinea: key questions answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{gn.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={gn.published}>{longDate(gn.published)}</time> · Updated <time datetime={gn.updated}>{longDate(gn.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Guinea population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Guinea" code="gn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
