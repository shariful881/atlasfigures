---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/guinea.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';
import { rankLatest, latest } from '../../../lib/econ';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/guinea/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const hiSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x >= growth).map(([y]) => y));
const gRank = rankBy('gdpGrowthPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const falls = s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y);
const gMax = s.gdpGrowthPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const iLow = s.inflationPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const lit = rankLatest('literacyPct', 2015); const litMe = lit.find((r) => r.iso3 === c.iso3)!; const litLow = lit.length - litMe.rank + 1;
const u5 = latest(s.under5Mortality)!;

assertClaim(isMax(s.gdp) && B.gdpRank === 116, 'record GDP; 116th');
assertClaim(hiSince === 2017 && gRank === 15 && gMax[0] === 2016 && gMax[1] > 10.8, 'fastest since 2017; 15th; record 2016');
assertClaim(falls.join() === '1977,1979,2009', 'only falls 1977, 1979, 2009');
assertClaim(iLow[0] === L && s.inflationPct[0][0] === 2005 && iMax[0] === 2006 && iMax[1] > 34, 'lowest inflation since series began 2005; peak 2006');
assertClaim(litMe.year === 2018 && litLow === 5 && Math.round(litMe.value) === 40, 'literacy 39.6% (2018), 5th lowest');
assertClaim(u5.year === 2024 && u5.value > 92 && rem!.year === 2024, 'under-5 92.1; remittances to 2024');

const title = `Guinea's Economy in ${L}: Faster Growth, Lowest Inflation on Record | AtlasFigures`;
const description = `Guinean growth hit ${pct(growth)} in ${L}, highest since 2017, as GDP rose to ${usd(gdp)}; consumer inflation eased to ${pct(infl.value)} — a low for the data, which go back to 2005.`;

const faq = [
  { q: 'Did Guinea\'s growth speed up in 2025?', a: `${pct(growth)} in real terms — the quickest since 2017, ranking ${ord(gRank)} worldwide. The record is ${pct(gMax[1])}, set in 2016.` },
  { q: 'How rare are recessions in Guinea?', a: `Very: just three since 1970 on World Bank figures — 1977, 1979 and 2009.` },
  { q: 'Is Guinean inflation at a low?', a: `Markedly — ${pct(infl.value)} for ${L} versus ${pct(i(L - 1))} a year earlier, a low for Guinea's 2005-onward series; in 2006 the rate was ${pct(iMax[1])}.` },
  { q: 'What share of Guineans can read?', a: `${pct(litMe.value)} of adults at the ${litMe.year} UNESCO measurement, the ${ord(litLow)}-lowest of the ${lit.length} countries with a figure from 2015 on.` },
  { q: 'What does Guinea\'s record GDP mean per person?', a: `${ord(B.gdpRank!)} of the world's economies, with record output worth ${usd(gdp)} in ${L} — ${usdWhole(perHead)} for each Guinean, or ${intDollars(ppp!)} at PPP.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Guinea's economy in ${L}: faster growth and the lowest inflation on record`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Guinean economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Guinea', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Guinea's economy: quicker growth, slower prices</h1>
        <p class="answer">
          Real growth in Guinea reached <strong>{pct(growth)}</strong> in {L} and GDP <strong>{usd(gdp)}</strong>; the inflation rate dropped to {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Guinea economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Guinea" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Prices are now rising at their slowest pace in two decades of data, and growth at its fastest since 2017.</p>

        <div class="story-block prose">
          <h2>How low has Guinean inflation fallen?</h2>
          <p>To its lowest on record: the {L} increase in the price index was {pct(infl.value)}, down from {pct(i(L - 1))} and the smallest increase since Guinea's inflation series starts in 2005. The peak in that series is {pct(iMax[1])}, in 2006.</p>
        </div>
        <LineChart
          title={`Guinea's inflation rate, ${s.inflationPct[0][0]}–${L}`}
          subtitle="Guinean consumer price inflation, annual %."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Guinea's economy growing quickly?</h2>
          <p>Yes: {pct(growth)} in {L}, Guinea's fastest pace since 2017 and {ord(gRank)} in the world. The peak year remains 2016 ({pct(gMax[1])}); GDP has shrunk only in 1977, 1979 and 2009 over the whole series from 1970. Dollar GDP, {usd(gdp)}, has never been higher.</p>
        </div>
        <div class="story-block prose">
          <h2>How do literacy and child survival compare?</h2>
          <p>Both lag. UNESCO counted {pct(litMe.value)} of Guinean adults as literate in {litMe.year}, {ord(litLow)}-lowest among countries with recent data, and the UN IGME estimates that {u5.value.toFixed(1)} in every 1,000 Guinean babies did not reach their fifth birthday in {u5.year}. Remittances, published to {rem!.year}, were {usd(rem!.value)}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Guinea and its region: related pages</h2>
          <ul>
            <li><a href={path('/country/guinea/population/')}>Guinea's population</a></li>
            <li><a href={path('/country/mali/economy/')}>Mali's economy</a></li>
            <li><a href={path('/country/senegal/economy/')}>Senegal's economy</a></li>
            <li><a href={path('/country/cote-divoire/economy/')}>Côte d'Ivoire's economy</a></li>
            <li><a href={path('/rankings/literacy-rate-by-country/')}>Literacy rate by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Guinea: the numbers by year`}
          subtitle="Opens with 1970 (Guinea's first GDP figure), adds 1977, 1979, 2005 and 2009, then runs 2015–2025; all years are in the download."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/guinea-economy.csv')} csvName="guinea-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Guinea's economy: reader questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Literacy: SE.ADT.LITR.ZS (UNESCO); child mortality: SH.DYN.MORT (UN IGME), via the World Bank. Remittances are published to 2024. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Guinean economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Guinea" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
