---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/argentina.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/argentina/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const lac = rankBy('gdp', L).filter((r) => r.region === 'Latin America & Caribbean');
const infl24 = rankBy('inflationPct', 2024);
const negs = s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y);
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const uMax = s.unemploymentPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const inflYears = s.inflationPct.map(([y]) => y);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 24, 'record GDP and GDP per person; 24th');
assertClaim(lac[0].iso3 === 'BRA' && lac[1].iso3 === 'MEX' && lac[2].iso3 === c.iso3, 'third in Latin America after Brazil and Mexico');
assertClaim(g(2023) < 0 && g(2024) < 0 && growth > 0 && hiGrowSince === 2022, 'growth after two declines, fastest since 2022');
assertClaim(negs.length * 3 > L - 1960 && negs.length === 26 && s.gdpGrowthPct[0][0] === 1961, '26 years of decline since 1961');
assertClaim(infl.year === 2024 && inflYears[0] === 2018 && !inflYears.includes(L) && inflYears.length === 7 && infl24[0].iso3 === c.iso3 && infl.value > 200, 'no latest-year CPI; 2024 above 200%, highest in the world');
assertClaim(perHead > valueIn(econData('BRA').series.gdpPerCapita, L)!, 'richer than Brazil per person');
assertClaim(uMax[0] === 2002 && unemp! < 10, 'unemployment peak 2002');

const title = `Argentina Economy ${L}: Rebound After Two Down Years | AtlasFigures`;
const description = `After contracting in 2023 and 2024, Argentina expanded ${pct(growth)} in ${L} to ${usd(gdp)}, Latin America's third-largest economy. Its 2024 inflation, ${pct(infl.value)}, topped every other country.`;

const faq = [
  { q: 'Did Argentina\'s economy grow in ' + L + '?', a: `Yes, by ${pct(growth)}, after falls of ${pct(Math.abs(g(2023)))} in 2023 and ${pct(Math.abs(g(2024)))} in 2024. It was the strongest year since 2022.` },
  { q: 'What was Argentina\'s inflation rate?', a: `${pct(infl.value)} in 2024, higher than in any other economy that year. The World Bank series for Argentina has no ${L} figure yet and covers only 2018 to 2024.` },
  { q: 'How often does Argentina\'s output fall?', a: `Real GDP has declined in ${negs.length} of the years since 1961, the latest being 2023 and 2024.` },
  { q: 'Is Argentina richer than Brazil per person?', a: `Measured as GDP per person in current dollars, yes: ${usdWhole(perHead)} in ${L} against Brazil's ${usdWhole(valueIn(econData('BRA').series.gdpPerCapita, L)!)}, ranking ${ord(B.pcRank!)} globally. On a purchasing-power basis Argentina reaches ${intDollars(ppp!)}.` },
  { q: 'What is unemployment in Argentina?', a: `${pct(unemp!)} of the labour force lacked work in ${L} (ILO model), down from a peak of ${pct(uMax[1])} in 2002.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Argentina's economy ${L}: growth returns after 2023 and 2024, with the world's highest inflation in 2024`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Argentine economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Argentina', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Argentina's economy: back to growth</h1>
        <p class="answer">
          After two years of decline, output grew <strong>{pct(growth)}</strong> in {L}, lifting GDP in current dollars to <strong>{usd(gdp)}</strong>, the highest yet. Inflation reached {pct(infl.value)} in 2024, the last year in the World Bank series.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Argentina economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Argentina" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Argentina's output has shrunk in more than a third of the years since 1961, most recently in 2023 and 2024.</p>

        <div class="story-block prose">
          <h2>Is Argentina's economy recovering?</h2>
          <p>On {L} numbers, yes. Output rose {pct(growth)} after shrinking in both 2023 and 2024, making it the strongest year since 2022. Valued in current dollars, the economy hit an all-time high of {usd(gdp)}, {ord(B.gdpRank!)} worldwide.</p>
        </div>
        <LineChart
          title={`Argentine real growth, 1961–${L}`}
          subtitle="Percentage change in inflation-adjusted output each year; negative values mark contractions."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>How many years has Argentina's output fallen?</h2>
          <p>{negs.length} since 1961, more than one year in every three. Joblessness hit {pct(uMax[1])} in 2002; by {L} it had dropped to {pct(unemp!)}.</p>
        </div>
        <div class="story-block prose">
          <h2>How high was inflation in Argentina?</h2>
          <p>In 2024 the cost of living jumped {pct(infl.value)}, more than in any other economy. Argentina's World Bank price series spans just 2018–2024, so no {L} rate is shown here.</p>
        </div>
        <LineChart
          title={`Inflation in Argentina, 2018–2024`}
          subtitle="Yearly rise in the consumer price index, %; the World Bank series has only these seven years."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Argentina Latin America's third-largest economy?</h2>
          <p>Yes, behind Brazil and Mexico. Divided among Argentines, {L} output equals {usdWhole(perHead)} each — another high — or {intDollars(ppp!)} adjusted for price levels.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Argentina and South America: related pages</h2>
          <ul>
            <li><a href={path('/country/argentina/population/')}>Argentina's population</a></li>
            <li><a href={path('/country/brazil/economy/')}>Brazil's economy</a></li>
            <li><a href={path('/country/colombia/economy/')}>Colombia's economy</a></li>
            <li><a href={path('/country/mexico/economy/')}>Mexico's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation rates by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Argentina's GDP, jobs and prices — key years from 1960 to ${L}`}
          subtitle="Shows 2002 and 2018 alongside 2019–2025; the CSV carries each year back to 1960."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/argentina-economy.csv')} csvName="argentina-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Asked about Argentina's economy</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"Latin America" here means the World Bank's Latin America &amp; Caribbean region. The World Bank notes that, because the Atlas method is limited for economies with persistent high inflation, Argentina remains classified as upper-middle-income, and that multiple exchange rates in use are averaged into an alternative conversion factor. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Argentine economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Argentina" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
