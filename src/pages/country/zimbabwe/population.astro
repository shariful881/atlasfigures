---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import zw from '../../../data/countries/zimbabwe.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: life expectancy that peaked in 1986, fell to a
// 2001 low and passed the 1986 level only in 2019 (sixth-largest gain since 2000); infant mortality that rose in the 1990s;
// women in the majority every year; net emigration every year since 1998 (biggest outflow 1993, biggest inflow 1980);
// still growing in 2100. Counts only; the UN files give no causes.
const PAGE = '/country/zimbabwe/population/';
const un = countryData(zw.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (zw.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const leTop = un.years.filter((r) => r.year < 2000).reduce((a, b) => (b.lifeExpectancy > a.lifeExpectancy ? b : a));
const leLow = un.years.filter((r) => r.year >= 1990 && r.year <= CURRENT_YEAR).reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
const leBack = un.years.find((r) => r.year > leLow.year && r.lifeExpectancy > leTop.lifeExpectancy)!.year;
assertClaim(leTop.year === 1986 && leLow.year === 2001 && leBack === 2019, 'life expectancy 1986 high, 2001 low, above 1986 again in 2019');
const gain = (d: any) => at(d).lifeExpectancy - at(d, 2000).lifeExpectancy;
assertClaim([...wpp].sort((a: any, b: any) => gain(b) - gain(a)).map((d: any) => d.iso3).indexOf('ZWE') === 5, 'sixth-largest life-expectancy gain since 2000');
const imrTop = un.years.filter((r) => r.year >= 1985 && r.year <= 2005).reduce((a, b) => (b.infantMortalityPer1000! > a.infantMortalityPer1000! ? b : a));
assertClaim(imrTop.year === 1996 && imrTop.infantMortalityPer1000! > y[1990].infantMortalityPer1000! + 5, 'infant mortality rose in the 1990s to a 1996 high');
assertClaim(un.years.every((r) => r.male < r.female), 'women in the majority every year 1950–2100');
const srLow = un.years.reduce((a, b) => (b.male / b.female < a.male / a.female ? b : a));
assertClaim(srLow.year === 2013, 'fewest men per 100 women in 2013');
assertClaim([...big].sort((a: any, b: any) => at(a).male / at(a).female - at(b).male / at(b).female).map((d: any) => d.iso3).indexOf('ZWE') === 4, 'fifth-lowest men-to-women ratio among countries of ten million or more');
const lastIn = Math.max(...un.years.filter((r) => r.netMigrants > 0).map((r) => r.year));
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(lastIn === 1998 && outTop.year === 1993 && inTop.year === 1980, 'net emigration every year after 1998; largest outflow 1993; largest inflow 1980');
assertClaim(un.years.filter((r) => r.change < 0).map((r) => r.year).join() === '1993' && un.years.every((r, i, a) => i === 0 || r.population > a[i - 1].population), 'only one negative annual change (1993); mid-year totals rise every year');
assertClaim(Math.abs(y[2010].urbanPct! - y[2000].urbanPct!) < 0.5, 'urban share flat 2000–2010');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2041 && y[2100].population > y[2099].population, 'urban majority 2041; still growing in 2100');
const eaf = wpp.filter((d: any) => d.subregion === 'Eastern Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(eaf.indexOf('ZWE') === 9, 'tenth in Eastern Africa');

const title = `Zimbabwe's ${(c.population / 1e6).toFixed(1)}M in ${CURRENT_YEAR}: Life Expectancy Back Above the 1986 Peak | AtlasFigures`;
const description = `Zimbabwe's life expectancy fell from a 1986 high to a 2001 low and only passed the 1986 level in 2019; it is ${dec(c.lifeExpectancy, 1)} now, for a population of ${millions(c.population)} (UN, ${CURRENT_YEAR}). Women outnumber men in every UN year.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: zw.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, zw.tableYears);

const faq = [
  { q: 'Has Zimbabwe recovered its 1980s life expectancy?', a: `Yes, after a long dip: from ${dec(leTop.lifeExpectancy, 1)} years in ${leTop.year} to ${dec(leLow.lifeExpectancy, 1)} in ${leLow.year} in the UN estimates; it passed the ${leTop.year} figure again in ${leBack} and is ${dec(c.lifeExpectancy, 1)} today. The data do not state causes.` },
  { q: 'Are women the majority in Zimbabwe?', a: `Yes, in every year the UN covers, from 1950 to 2100. Its ${CURRENT_YEAR} sex ratio, ${dec((c.male / c.female) * 100, 1)} men per 100 women, is among the five lowest for nations above ten million.` },
  { q: 'Is Zimbabwe a country of net emigration?', a: `It has been in each year after 1998; the ${CURRENT_YEAR} net loss is roughly ${int(Math.round(-c.netMigrants / 1000))} thousand. The record outflow came in ${outTop.year}, the record inflow in ${inTop.year}.` },
  { q: 'Does Zimbabwe stop growing before 2100?', a: `No. The medium variant is still climbing in 2100, at ${millions(y[2100].population)}; mid-century brings ${millions(y[2050].population)}.` },
  { q: 'When will most Zimbabweans be urban?', a: `In ${urbanHalf}, per World Urbanization Prospects; the share is ${pct(c.urbanPct!)} now, after stalling in 2000–2010.` },
];

const schema = countrySchema({
  page: PAGE, slug: zw.slug, name: zw.name, wikipedia: zw.wikipedia,
  headline: `Zimbabwe's ${millions(c.population)}: lifespans that fell after 1986 and recovered by 2019; a female majority every year`,
  description,
  datasetName: 'Zimbabwe population, life expectancy and sex ratio, 1950–2100',
  datasetDescription: `Mid-year population of Zimbabwe for selected years from 1950 to ${CURRENT_YEAR} (1986, 1993, 1996, 2001 and 2019 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: zw.published, updated: zw.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Zimbabwe"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Zimbabwe", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Zimbabwe: lifespans lost and regained</h1>
        <LiveCounter
          label="Zimbabwe: projected population at this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: value for mid-${CURRENT_YEAR}, adding around ${int(c.change / 365)} each day`}
        />
        <p class="answer">
          Zimbabwean life expectancy, <strong>{dec(c.lifeExpectancy, 1)}</strong> years, is above the {leTop.year} high of {dec(leTop.lifeExpectancy, 1)} that was lost for more than three decades. The UN puts the population at <strong>{millions(c.population)}</strong> for mid-{CURRENT_YEAR}.
        </p>
        <div class="dates"><span>Updated <time datetime={zw.updated}>{longDate(zw.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Zimbabwe" code="zw" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How far did life expectancy fall in Zimbabwe?</h2>
          <p>From {dec(leTop.lifeExpectancy, 1)} years in {leTop.year} to {dec(leLow.lifeExpectancy, 1)} in {leLow.year} in the UN estimates, a loss of {dec(leTop.lifeExpectancy - leLow.lifeExpectancy, 1)} years. Infant mortality rose too: {dec(y[1990].infantMortalityPer1000!, 1)} deaths per thousand births in 1990, {dec(imrTop.infantMortalityPer1000!, 1)} by {imrTop.year}. The {leTop.year} level was passed again in {leBack}; the gain since 2000 is the sixth-largest of any country or area. The UN data record these swings but not their causes.</p>
        </div>
        <div class="age-row" role="group" aria-label="Life expectancy at birth in Zimbabwe">
          <div><span class="y">{leTop.year}</span><div class="v">{dec(leTop.lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">{leLow.year}</span><div class="v">{dec(leLow.lifeExpectancy, 1)}</div><span class="d">Years</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.lifeExpectancy, 1)}</div><span class="d">Years</span></div>
        </div>

        <div class="story-block prose">
          <h2>Why do Zimbabwean women outnumber men?</h2>
          <p>The UN figures show it in every year from 1950 to 2100 but do not explain it. The sex ratio bottomed out in {srLow.year} at {dec((srLow.male / srLow.female) * 100, 1)} men to every 100 women and is {dec((c.male / c.female) * 100, 1)} now, fifth-lowest among countries above ten million. Departures have outweighed arrivals each year after 1998, by some {int(Math.round(-c.netMigrants / 1000))} thousand in {CURRENT_YEAR}. {outTop.year} holds the record net outflow (near {int(Math.round(-outTop.netMigrants / 1000))} thousand) and {inTop.year} the record inflow (around {int(Math.round(inTop.netMigrants / 1000))} thousand).</p>
        </div>
        <LineChart
          title="Zimbabwe's population, 1950–2100"
          subtitle="UN totals at 1 July, rising in every year; projected years dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Will Zimbabwe's population keep rising?</h2>
          <p>Yes; it grows {pct(c.growthRatePct)} a year now, and the medium variant keeps climbing all the way to 2100, ending at {millions(y[2100].population)}. Fertility is {dec(c.fertility, 2)}, down from {dec(y[1960].fertility, 2)} in 1960. Urban growth stalled from 2000 to 2010, and the share is {pct(c.urbanPct!)} today; a majority is projected for {urbanHalf}. Zimbabwe is tenth in Eastern Africa by population.</p>
        </div>
        <LineChart
          title="Fertility in Zimbabwe since 1950, with the projection to 2050"
          subtitle="UN births per woman; dashes for the medium variant; reference at 2.1."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'ref 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={zw.iso3} name={zw.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Zimbabwe, 1950 to 2100, including 1986, 2001 and 2019"
          subtitle="Life expectancy peaks in 1986, bottoms out in 2001 and is higher again from 2019."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${zw.slug}-population.csv`)}
          csvName={`${zw.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Zimbabwe: quick facts</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{zw.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={zw.published}>{longDate(zw.published)}</time> · Updated <time datetime={zw.updated}>{longDate(zw.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Zimbabwe population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Zimbabwe" code="zw" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
