---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/indonesia.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';
import wpp from '../../../data/wpp/index.json';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/indonesia/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
// "South-eastern Asia" = the UN geoscheme subregion used in World Population Prospects 2024.
const sea = (wpp as any).countries.filter((x: any) => x.subregion === 'South-Eastern Asia').map((x: any) => x.iso3);
const seaRanked = rankBy('gdp', L).filter((r) => sea.includes(r.iso3));
const next = seaRanked[1];
const t1 = s.gdp.find(([, x]) => x >= 1e12)![0];
const negs = s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y);
const hyper = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const steady = [2022, 2023, 2024, L].every((y) => g(y) >= 5 && g(y) < 5.5);

assertClaim(B.gdpRank === 17 && seaRanked[0].iso3 === c.iso3 && next.iso3 === 'SGP' && gdp > 2 * next.value, 'largest in South-eastern Asia, more than twice Singapore');
assertClaim(t1 === 2017, 'passed one trillion dollars in 2017');
assertClaim(perHead >= 5000 && s.gdpPerCapita.every(([y, x]) => y === L || x < 5000), 'GDP per person above $5,000 for the first time');
assertClaim(steady, 'growth between 5.0% and 5.5% in each of the last four years');
assertClaim(negs.join() === '1963,1998,2020' && s.gdpGrowthPct[0][0] === 1961 && g(1998) < -13, 'three declines since 1961, 1998 the worst');
assertClaim(hyper[0] === 1966 && hyper[1] > 1000, 'inflation over 1,000% in 1966');
assertClaim(infl.year === L && infl.value < 2 && s.inflationPct.filter(([y]) => y > 2021 && y < L).every(([, x]) => x > infl.value) && i(2021) < infl.value, 'inflation under 2%, lowest since 2021');

const title = `Indonesian Economy ${L}: Size, 5% Growth, Income per Head | AtlasFigures`;
const description = `At ${usd(gdp)} for ${L}, Indonesia is South-eastern Asia's largest economy. It has grown by about 5% a year since 2022, and output per person passed $5,000 for the first time.`;

const faq = [
  { q: 'Is Indonesia the largest economy in Southeast Asia?', a: `Yes, by a wide margin. Indonesia's ${usd(gdp)} for ${L} is ${(gdp / next.value).toFixed(1)} times Singapore's total, the region's next largest.` },
  { q: 'What is Indonesia\'s GDP growth rate?', a: `${pct(growth)} in ${L}. Growth has stayed between ${pct(5)} and ${pct(5.5)} in each year since 2022.` },
  { q: 'When did Indonesia become a trillion-dollar economy?', a: `In ${t1}, on World Bank figures in current US dollars.` },
  { q: 'How bad was the 1998 crisis for Indonesia?', a: `Real GDP fell ${pct(Math.abs(g(1998)))} in 1998, Indonesia's sharpest decline in World Bank data going back to 1961. The only other declines were in 1963 and 2020.` },
  { q: 'What is Indonesia\'s income per head?', a: `${usdWhole(perHead)} in ${L}, a first above $5,000. Price-adjusted (PPP): ${intDollars(ppp!)}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Indonesia's economy ${L}: South-eastern Asia's largest, growing about 5% a year`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Indonesia's economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Indonesia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Indonesia's economy: steady 5% growth</h1>
        <p class="answer">
          Indonesian GDP reached <strong>{usd(gdp)}</strong> in {L}, the biggest in South-eastern Asia and {ord(B.gdpRank!)} worldwide. Real growth was <strong>{pct(growth)}</strong>, in line with every year since 2022.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Indonesia economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Indonesia" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Indonesia's yearly growth figures since 2022 sit within half a percentage point of each other, while output per person has crossed a new threshold.</p>

        <div class="story-block prose">
          <h2>Is Indonesia a trillion-dollar economy?</h2>
          <p>Yes, since {t1}. Its {L} total of {usd(gdp)} ranks {ord(B.gdpRank!)} globally and leads South-eastern Asia, at over double Singapore's {usd(next.value)}. That is {pct(share)} of the planet's GDP.</p>
        </div>
        <LineChart
          title={`Indonesia's GDP, 1967–${L}`}
          subtitle="Current US dollars; the World Bank series starts in 1967."
          points={s.gdp.filter(([y]) => y % 5 === 0 || y >= 2019).map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Indonesia's growth holding steady?</h2>
          <p>Steadily: the economy expanded {pct(g(2022))} in 2022, {pct(g(2023))} in 2023, {pct(g(2024))} in 2024 and {pct(growth)} in {L}. Contractions have come only in 1963, 1998 and 2020 since records begin in 1961; the 1998 fall of {pct(Math.abs(g(1998)))} was by far the worst.</p>
        </div>
        <div class="story-block prose">
          <h2>Has Indonesia's income per person passed $5,000?</h2>
          <p>Yes, for the first time in {L}: {usdWhole(perHead)} per resident and {ord(B.pcRank!)} in the world. Measured at purchasing power parity the number is {intDollars(ppp!)}. Back in 2000, per-person output was {usdWhole(v('gdpPerCapita', 2000)!)}.</p>
        </div>
        <div class="story-block prose">
          <h2>Are prices and jobs stable in Indonesia?</h2>
          <p>Indonesian shoppers saw prices go up {pct(infl.value)} in {L}, the mildest rise since 2021. In the 1960s it was a different story: inflation passed 1,000% in 1966. Unemployment was {pct(unemp!)} on the ILO's modelled measure.</p>
        </div>
        <LineChart
          title={`Unemployment in Indonesia, 1991–${L}`}
          subtitle="Joblessness in Indonesia as estimated by the ILO model, per cent."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <nav class="related" aria-label="Related pages">
          <h2>Indonesia and South-eastern Asia: more pages</h2>
          <ul>
            <li><a href={path('/country/indonesia/population/')}>Indonesia's population</a></li>
            <li><a href={path('/country/philippines/population/')}>The Philippines' population</a></li>
            <li><a href={path('/country/vietnam/population/')}>Vietnam's population</a></li>
            <li><a href={path('/country/china/economy/')}>China's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person ranking</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Indonesian economy by year, 1970–${L}`}
          subtitle="Includes the 1998 crisis and 2017, the first trillion-dollar year; the CSV has every year."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/indonesia-economy.csv')} csvName="indonesia-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Indonesia's economy in five questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"South-eastern Asia" is the UN subregion used in World Population Prospects 2024. World Bank data for Indonesia include Timor-Leste up to 1999; national accounts follow the calendar year. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Indonesia's economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Indonesia" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
