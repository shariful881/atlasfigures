---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import idj from '../../../data/countries/indonesia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a giant reaching replacement fertility, with a peak in sight.
const PAGE = '/country/indonesia/population/';
const un = countryData(idj.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (idj.verification as any).checkedOn as string | undefined;
const CAPITAL_URL = 'https://www.thejakartapost.com/indonesia/2026/05/15/court-ruling-raises-further-questions-over-nusantaras-future.html';

const sub = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(sub === 2025 && un.years.filter((r) => r.year >= sub).every((r) => r.fertility < 2.1), 'below 2.1 from 2025 in the UN projection');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
const backTo = un.years.find((r) => r.population >= y[2100].population)!.year;
assertClaim(peak.year === 2058 && natLoss === 2060, 'peak in 2058, deaths exceed births from 2060');
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any) => d.years.find((r: any) => r.year === CURRENT_YEAR);
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia');
const seaShare = (c.population / sea.reduce((a: number, d: any) => a + at(d).population, 0)) * 100;
assertClaim([...sea].sort((a: any, b: any) => at(b).population - at(a).population)[0].iso3 === 'IDN' && seaShare > 40 && seaShare < 42, 'largest in South-East Asia, about two in five of its people');
const passedBy: { year: number; iso3: string }[] = [];
for (const r of un.years.filter((r) => r.year > CURRENT_YEAR)) {
  for (const d of wpp) {
    const o = byYear(d.years);
    if (o[r.year].population > r.population && o[r.year - 1].population <= y[r.year - 1].population) passedBy.push({ year: r.year, iso3: d.iso3 });
  }
}
assertClaim(JSON.stringify(passedBy) === JSON.stringify([{ year: 2037, iso3: 'PAK' }, { year: 2040, iso3: 'NGA' }, { year: 2072, iso3: 'COD' }, { year: 2078, iso3: 'ETH' }]), 'passed by Pakistan, Nigeria, DR Congo and Ethiopia');
const sorted = [...sea].sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(sorted[1] === 'PHL' && sorted[2] === 'VNM' && c.population > 2 * at(sea.find((d: any) => d.iso3 === 'PHL')).population && c.population / y[1950].population > 4, 'well ahead of the Philippines and Vietnam; more than four times 1950');
const urbanFrom = un.years.find((r) => (r.urbanPct ?? 0) > 50)!.year;

const title = `Indonesia Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Fourth in the World, Peak Expected in ${peak.year} | AtlasFigures`;
const description = `Two in five South-East Asians live in Indonesia, which has about ${millions(c.population)} people (${CURRENT_YEAR}). Fertility has just dropped to ${dec(c.fertility, 2)}, and the UN sees the population topping out in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: idj.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Infant deaths per 1,000 births', value: dec(c.infantMortalityPer1000, 1) },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, idj.tableYears);

const faq = [
  { q: 'How many people are there in Indonesia?', a: `About ${millions(c.population)} in mid-${CURRENT_YEAR}, the UN estimates. Only India, China and the United States have more.` },
  { q: "Does Indonesia's population keep rising?", a: `For now. It grows ${pct(c.growthRatePct)} in ${CURRENT_YEAR}, adding about ${millions(c.change)} people, but the UN expects growth to slow every decade until the peak.` },
  { q: "In which year does Indonesia's population begin shrinking?", a: `The medium UN projection puts it in ${peak.year + 1}, right after the ${millions(peak.population)} high of ${peak.year}. Deaths overtake births from ${natLoss}.` },
  { q: 'Are Indonesian families smaller than in the past?', a: `Much smaller: ${dec(c.fertility, 2)} per woman in ${CURRENT_YEAR}, against ${dec(tfrMax.fertility, 2)} in ${tfrMax.year}.` },
  { q: "Is Jakarta still Indonesia's capital?", a: `Yes. A planned new capital, Nusantara, is being built in East Kalimantan, but in May 2026 Indonesia's Constitutional Court confirmed that Jakarta remains the capital until a presidential decree transfers that status.` },
];
assertClaim(c.worldRank === 4 && [2030, 2040, 2050].every((yr, i, a) => y[yr].growthRatePct < (i ? y[a[i - 1]].growthRatePct : c.growthRatePct)), 'fourth; growth slows decade by decade');

const schema = countrySchema({
  page: PAGE, slug: idj.slug, name: idj.name, wikipedia: idj.wikipedia,
  headline: `Indonesia's population in ${CURRENT_YEAR}: ${millions(c.population)}, with a UN-projected peak in ${peak.year}`,
  description,
  datasetName: 'Indonesia population, density, fertility, median age and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Indonesia for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: idj.published, updated: idj.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: "Court ruling raises further questions over Nusantara's future", url: CAPITAL_URL, publisher: 'The Jakarta Post' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Indonesia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Indonesia', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Indonesia population: the world's fourth largest</h1>
        <LiveCounter
          label="Indonesia's population right now (estimate)"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} estimate, growing by close to ${int(c.change / 365)} a day`}
        />
        <p class="answer">
          Indonesia's mid-{CURRENT_YEAR} population is about <strong>{millions(c.population)}</strong>, fourth only to India, China and the United States. Women now average <strong>{dec(c.fertility, 2)} children</strong>, just under the level that keeps a population stable, and the UN expects numbers to peak in {peak.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={idj.updated}>{longDate(idj.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Indonesia" code="id" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has Indonesia's fertility rate fallen below replacement level?</h2>
          <p>Only just. The UN's figures put it at {dec(c.fertility, 2)} in {CURRENT_YEAR}, having crossed under 2.1 in {sub}. Sixty years ago the picture was very different: in {tfrMax.year} the average woman had {dec(tfrMax.fertility, 2)} children. The decline has been long and steady rather than sudden.</p>
        </div>
        <LineChart
          title="Indonesia's fertility rate, 1950–2050"
          subtitle="Children per woman, reaching the 2.1 line in the mid-2020s. Later values (dashed) are projected by the UN."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="children per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'Replacement at 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>In what year will Indonesia's population top out?</h2>
          <p>In {peak.year}, when the medium projection tops out near {millions(peak.population)}. Because today's population is still fairly young, with a median age of {dec(c.medianAge, 1)}, growth continues for three more decades although each family is having fewer children. Deaths are projected to outnumber births from {natLoss}, and by 2100 the total would be back to {millions(y[2100].population)}, about the size reached in {backTo}.</p>
        </div>
        <LineChart
          title="Population of Indonesia, 1950–2100"
          subtitle="Mid-year count, rising to a peak in the late 2050s on the UN projection (dashed), then easing down."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Indonesia the biggest country in South-East Asia?</h2>
          <p>By population, clearly. About {pct(seaShare)} of everyone living in South-East Asia is Indonesian, well ahead of the Philippines and Vietnam. With {int(c.densityPerKm2)} people per km² across {millions(un.landAreaKm2)} km² of land, it is also more than four times as populous as it was in 1950, when the UN counts {millions(y[1950].population)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Why will Indonesia slip down the world rankings?</h2>
          <p>Because faster-growing countries catch up. The UN projects Pakistan to overtake Indonesia in {passedBy[0].year} and Nigeria in {passedBy[1].year}, followed by DR Congo in {passedBy[2].year} and Ethiopia in {passedBy[3].year}. That would leave Indonesia {ord(y[2100].worldRank!)} in the world in 2100.</p>
        </div>

        <div class="story-block prose">
          <h2>How many Indonesians live in urban areas?</h2>
          <p>{pct(c.urbanPct!)} in {CURRENT_YEAR}, on Indonesia's own definition, against {pct(y[1950].urbanPct!)} in 1950. Since {urbanFrom} urban dwellers have been the majority; for 2050 the projected share is {pct(y[2050].urbanPct!)}. Survival has improved just as sharply: infant deaths fell from {int(y[1950].infantMortalityPer1000)} to {dec(c.infantMortalityPer1000, 1)} per 1,000 births.</p>
        </div>
        <div class="age-row" role="group" aria-label="Indonesia then and now">
          <div><span class="y">1950</span><div class="v">{pct(y[1950].urbanPct!)}</div><span class="d">Share living in urban areas</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">Urban majority since {urbanFrom}</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{pct(y[2050].urbanPct!)}</div><span class="d">About four in five</span></div>
        </div>
        <RelatedPages iso3={idj.iso3} name={idj.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Indonesia's population record, 1950–2100"
          subtitle="Seventy-six years of Indonesian figures from the UN, with the projected rows starting in 2030."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${idj.slug}-population.csv`)}
          csvName={`${idj.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Indonesia's population: questions and answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files): population, births, deaths, growth, density, fertility, median age, infant mortality, world rank, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={CAPITAL_URL}>The Jakarta Post, "Court ruling raises further questions over Nusantara's future" (15 May 2026)</a>: Jakarta remains the capital until a presidential decree transfers the status to Nusantara.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and adds the UN's projected growth for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={idj.published}>{longDate(idj.published)}</time> · Updated <time datetime={idj.updated}>{longDate(idj.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Indonesia population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Indonesia" code="id" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
