---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import jor from '../../../data/countries/jordan.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only: a population more than twenty
// times its 1950 size (fourth among countries of a million or more), with large net inflows in 1990, 2006 and 2013–2015
// (2014 third-largest anywhere); the only fall in the series in 2025, after net departures in 2024–2025; very few deaths
// for each birth; births still rising to 2041; one of the most urban countries. The UN files give no causes.
const PAGE = '/country/jordan/population/';
const un = countryData(jor.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (jor.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const times = c.population / y[1950].population;
assertClaim(y[1950].population < 5e5, 'under half a million in 1950');
assertClaim(times > 26 && times < 27, 'about 26 times 1950');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const grow = (d: any) => at(d).population / at(d, 1950).population;
assertClaim([...m1].sort((a: any, b: any) => grow(b) - grow(a)).slice(0, 4).map((d: any) => d.iso3).join() === 'ARE,QAT,KWT,JOR', 'fourth-fastest growth since 1950 among 1M+, after UAE, Qatar, Kuwait');
assertClaim(y[1990].netMigrants > 2.5e5 && y[2006].netMigrants > 5e5 && [2013, 2014, 2015].every((n) => y[n].netMigrants > 4.5e5), 'large inflows 1990, 2006, 2013–2015');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 2014, 'largest inflow 2014');
assertClaim([...wpp].sort((a: any, b: any) => at(b, 2014).netMigrants - at(a, 2014).netMigrants).slice(0, 3).map((d: any) => d.iso3).join() === 'USA,TUR,JOR', 'third-largest net arrivals in 2014, after the US and Türkiye');
const falls = un.years.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '2025', 'only fall in the series 2025');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(-y[2025].netMigrants > y[2025].naturalChange, '2025 departures exceed natural increase');
assertClaim(outTop.year === 2025 && y[2024].netMigrants < -1.5e5, 'largest outflow 2025, also net departures 2024');
assertClaim(c.deaths * 5 < c.births, 'deaths under a fifth of births');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 2041, 'births peak 2041');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1969, 'fertility high 1969');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2044, 'below 2.1 in 2044');
assertClaim([...m1].sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct).map((d: any) => d.iso3).indexOf('JOR') === 8, 'ninth-highest urban share, 1M+');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1970, 'urban majority 1970');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
const was = wpp.filter((d: any) => d.subregion === 'Western Asia').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(was.indexOf('JOR') === 5, 'sixth in Western Asia');

const title = `Jordan Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Twenty-Six Times 1950, Shaped by Waves of Arrivals | AtlasFigures`;
const description = `Jordan's UN estimate for ${CURRENT_YEAR} is ${millions(c.population)}, some 26 times the 1950 figure. Net arrivals peaked in 2014; in 2025 net departures made the total dip for the only time in the series.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: jor.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, jor.tableYears);

const faq = [
  { q: 'Has Jordan grown faster than most countries since 1950?', a: `Much faster. Its population has multiplied roughly 26-fold since 1950. Among countries now above a million people, only the United Arab Emirates, Qatar and Kuwait have grown more.` },
  { q: 'Which year brought the most arrivals to Jordan?', a: `${inTop.year}, with a net gain of ${int(inTop.netMigrants)} people in the UN estimates, and only the United States and Türkiye took in more on a net basis that year. The UN files give the counts, not the reasons.` },
  { q: "Did Jordan's population go down in 2025?", a: `Slightly: the mid-year estimate for 2025 is ${int(y[2024].population - y[2025].population)} below 2024's, the only drop in the series, as net departures reached ${int(-outTop.netMigrants)}.` },
  { q: 'How many births and deaths does Jordan have a year?', a: `For ${CURRENT_YEAR} the UN projects ${int(c.births)} births and ${int(c.deaths)} deaths, fewer than one death per five births. Annual births keep climbing until ${birthTop.year}.` },
  { q: 'How many Jordanians are city dwellers?', a: `Nearly all: ${pct(c.urbanPct!)} count as urban by national rules, ninth-highest among countries above a million inhabitants; urban residents have outnumbered rural ones since ${urbanHalf}.` },
];

const schema = countrySchema({
  page: PAGE, slug: jor.slug, name: jor.name, wikipedia: jor.wikipedia,
  headline: `Jordan's ${millions(c.population)}: growth of some 26-fold since 1950, record net arrivals in ${inTop.year} and a one-year dip in 2025`,
  description,
  datasetName: 'Jordan population, net migration and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Jordan for selected years from 1950 to ${CURRENT_YEAR} (every year 2012–2016 and 2023–2026 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: jor.published, updated: jor.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Jordan"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Jordan", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Jordan: twentyfold growth and the waves behind it</h1>
        <LiveCounter
          label="Jordan: population estimate at this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Built on UN World Population Prospects 2024 for mid-${CURRENT_YEAR}; the count rises by some ${int(c.change / 365)} each day`}
        />
        <p class="answer">
          Jordan, home to fewer than half a million people in 1950, has <strong>{millions(c.population)}</strong> in {CURRENT_YEAR} by UN estimates. Much of that rise came in sudden surges of net arrivals, the largest in {inTop.year}.
        </p>
        <div class="dates"><span>Updated <time datetime={jor.updated}>{longDate(jor.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Jordan" code="jo" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why did Jordan's population rise so steeply?</h2>
          <p>Births and several bursts of arrivals. In 1950 Jordan had {millions(y[1950].population)}; today's count is roughly 26 times that, growth exceeded only by the United Arab Emirates, Qatar and Kuwait among countries now above a million. The UN series shows net inflows of {int(y[1990].netMigrants)} in 1990, {int(y[2006].netMigrants)} in 2006, and {int(y[2013].netMigrants)}, {int(y[2014].netMigrants)} and {int(y[2015].netMigrants)} in 2013, 2014 and 2015; for {inTop.year} only the United States and Türkiye recorded more. The files hold these counts but no explanation of them.</p>
        </div>
        <LineChart
          title="Jordan's mid-year count, 1950 estimates to 2100 projections"
          subtitle="Mid-year estimates, every year from 2012 to 2016 shown; the dashed medium variant is still rising in 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why did Jordan's population dip in 2025?</h2>
          <p>Because net departures exceeded natural increase for a year. They reached {int(-y[2024].netMigrants)} in 2024 and {int(-outTop.netMigrants)} in 2025, and the 2025 mid-year estimate ended {int(y[2024].population - y[2025].population)} below 2024's. It is the single year between 1950 and 2100 in which Jordan's total goes down; growth resumes in {CURRENT_YEAR}.</p>
        </div>
        <div class="age-row" role="group" aria-label="Jordan, mid-year totals 2024 to now (UN)">
          <div><span class="y">2024</span><div class="v">{millionsShort(y[2024].population)}</div><span class="d">People</span></div>
          <div><span class="y">2025</span><div class="v">{millionsShort(y[2025].population)}</div><span class="d">People</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{millionsShort(c.population)}</div><span class="d">People</span></div>
        </div>

        <div class="story-block prose">
          <h2>Are births in Jordan still rising?</h2>
          <p>Yes, until {birthTop.year} on the UN projection, even though each woman has far fewer children than before: {dec(tfrTop.fertility, 2)} at the {tfrTop.year} high, {dec(c.fertility, 2)} now and under 2.1 from {repl}. A young age profile, median {dec(c.medianAge, 1)}, keeps deaths low: {int(c.deaths)} expected this year against {int(c.births)} births.</p>
        </div>

        <div class="story-block prose">
          <h2>Will Jordan keep growing after 2050?</h2>
          <p>Yes, without a break: {millions(y[2050].population)} is the projection for 2050 and {millions(y[2100].population)} the one for 2100, with no turning point before then. Sixth in Western Asia by population, Jordan is also one of the world's most urban countries, at {pct(c.urbanPct!)}, and has had an urban majority since {urbanHalf}.</p>
        </div>
        <RelatedPages iso3={jor.iso3} name={jor.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Jordan by year, with 2012–2016 and 2023–2026 complete"
          subtitle="The rows for 2013–2015 hold the largest inflows; 2025 is the one year the total falls."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${jor.slug}-population.csv`)}
          csvName={`${jor.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Jordan, answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{jor.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={jor.published}>{longDate(jor.published)}</time> · Updated <time datetime={jor.updated}>{longDate(jor.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Jordan population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Jordan" code="jo" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
