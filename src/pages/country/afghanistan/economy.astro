---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/afghanistan.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';
import { rankingYear } from '../../../lib/econ';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/afghanistan/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
// The World Bank has no GDP figure for Afghanistan for the latest ranking year; this page uses its latest year.
const RY = rankingYear('gdp');
const peak = s.gdp.reduce((a, b) => (b[1] > a[1] ? b : a));
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const pcLow = rankBy('gdpPerCapita', L).slice().reverse();
const negInfl = s.inflationPct.filter(([, x]) => x < 0).map(([y]) => y);
const uMax = s.unemploymentPct.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(L === RY - 1 && valueIn(s.gdp, RY) == null && s.gdp[0][0] === 2000, 'latest GDP one year behind; series from 2000');
assertClaim(peak[0] === 2014 && gdp < peak[1] && worst[0] === 2021 && g(2022) < 0 && g(2023) > 0 && growth > 0, 'below 2014 peak; 2021 worst; growth since 2023');
assertClaim(pcLow[0].iso3 === 'BDI' && pcLow[1].iso3 === c.iso3, 'second-lowest GDP per person');
assertClaim(infl.year === L && infl.value < 0 && i(2023) < 0 && negInfl.join() === '2009,2015,2023,' + L, 'prices fell in 2023 and 2024');
assertClaim(u(RY) < unemp! && u(RY) < uMax[1] && uMax[0] === 2022 && unemp! > 13 && net!.value < 20 && rem!.year === 2020, 'unemployment peak 2022; under a fifth online; remittances end 2020');

const title = `Afghanistan Economy ${L}: GDP, Falling Prices, Income | AtlasFigures`;
const description = `Afghan output, ${usd(gdp)} in ${L} (latest World Bank year), is still under its 2014 peak following the ${pct(Math.abs(worst[1]))} collapse of 2021. Prices fell for a second year.`;

const faq = [
  { q: 'What happened to Afghan output in 2021?', a: `It dropped ${pct(Math.abs(worst[1]))} after inflation — no year since the series opens in 2000 was worse — and slid ${pct(Math.abs(g(2022)))} more in 2022.` },
  { q: 'Is Afghanistan\'s economy growing now?', a: `Modestly: ${pct(g(2023))} in 2023 and ${pct(growth)} in ${L}. The ${L} total, ${usd(gdp)}, has not regained 2014\'s ${usd(peak[1])}.` },
  { q: 'Why is there no ' + RY + ' GDP for Afghanistan?', a: `No such figure is out yet, so this page uses ${L}, and the ${RY} GDP ranking does not include Afghanistan.` },
  { q: 'Why are Afghan prices going down?', a: `The index records falls in two consecutive years, not their causes — ${signedPct(i(2023))} in 2023, ${signedPct(infl.value)} in ${L}.` },
  { q: 'How poor is Afghanistan?', a: `Output per Afghan came to ${usdWhole(perHead)} in ${L}, and Burundi was the single economy reporting a smaller ${L} value. At equalised prices, ${intDollars(ppp!)}.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Afghanistan's economy ${L}: below its 2014 size after the 2021 collapse, with prices falling`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Afghan economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Afghanistan', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Afghanistan's economy: smaller than a decade ago</h1>
        <p class="answer">
          Afghan output — <strong>{usd(gdp)}</strong> in {L}, the newest year the World Bank reports — remains under its 2014 level, three years after it dropped <strong>{pct(Math.abs(worst[1]))}</strong> in 2021. Prices fell {pct(Math.abs(infl.value))}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Afghanistan economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Afghanistan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Afghanistan's output dropped by a fifth in 2021, and three years on the economy is still smaller in dollars than in 2014.</p>

        <div class="story-block prose">
          <h2>How big was Afghanistan's economic collapse?</h2>
          <p>Output shrank {pct(Math.abs(worst[1]))} in 2021 and a further {pct(Math.abs(g(2022)))} in 2022, the two worst results in a World Bank series that begins in 2000. Small gains followed: {pct(g(2023))} in 2023 and {pct(growth)} in {L}.</p>
        </div>
        <LineChart
          title={`Afghanistan's real growth, 2001–${L}`}
          subtitle="GDP at constant prices, % change from the year before."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Is Afghanistan's economy smaller than before?</h2>
          <p>Yes. Valued in dollars, {L} output — the newest published — totalled {usd(gdp)}, against {usd(peak[1])} in 2014. The World Bank has no {RY} figure yet, so Afghanistan does not appear in our {RY} GDP ranking.</p>
        </div>
        <LineChart
          title={`Value of Afghan output, current dollars, 2000–${L}`}
          subtitle="Current US dollars; the series starts in 2000."
          points={s.gdp.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>How low are incomes in Afghanistan?</h2>
          <p>Output per Afghan stood at {usdWhole(perHead)} in {L}; only Burundi's was smaller; with comparable prices, {intDollars(ppp!)}. Only {pct(net!.value)} of people were online.</p>
        </div>
        <div class="story-block prose">
          <h2>Why are Afghan prices falling?</h2>
          <p>The data show the fall, not its cause: the index dropped {pct(Math.abs(i(2023)))} over 2023 and a further {pct(Math.abs(infl.value))} over {L}. ILO-modelled unemployment was {pct(unemp!)} in {L} and {pct(u(RY))} in {RY}, just under the 2022 high of {pct(uMax[1])}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Afghanistan and its neighbours: more pages</h2>
          <ul>
            <li><a href={path('/country/afghanistan/population/')}>Afghanistan's population</a></li>
            <li><a href={path('/country/pakistan/economy/')}>Pakistan's economy</a></li>
            <li><a href={path('/country/iran/economy/')}>Iran's economy</a></li>
            <li><a href={path('/country/india/economy/')}>India's economy</a></li>
            <li><a href={path('/rankings/gdp-per-capita-by-country/')}>GDP per person ranking</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Afghan economic data for chosen years, 2000–${L}`}
          subtitle="Includes 2001, 2008, 2012 and 2014 with every year from 2019; remittance cells end in 2020."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/afghanistan-economy.csv')} csvName="afghanistan-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Afghan economy: what is asked</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank notes Afghanistan's national accounts use a fiscal year ending 20 March. Its GDP series for Afghanistan begins in 2000, its internet series in 1990 and its remittance series ends in 2020; unemployment is modelled for {RY} as well. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Afghan economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Afghanistan" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
