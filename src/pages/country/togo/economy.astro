---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/togo.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/togo/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const streak = [2021, 2022, 2023, 2024, L].every((y) => g(y) > 5) && g(2020) < 5;
const gRank = rankBy('gdpGrowthPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const iLowSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x <= infl.value).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const uRank = rankBy('unemploymentPct', L).find((r) => r.iso3 === c.iso3)!.rank;
const uN = rankBy('unemploymentPct', L).length;
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const xGdp = (gdp / v('gdp', 2015)!).toFixed(1);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.gdpRank === 146, 'record GDP; 146th');
assertClaim(streak && gRank === 27, 'five years above 5%; 27th fastest');
assertClaim(iLowSince === 2017 && i(2017) < 0 && i(2022) > 7.9 && infl.value < 0.5, 'inflation 0.4%, lowest since 2017 deflation; 8.0% in 2022');
assertClaim(iMax[0] === 1994 && iMax[1] > 39 && worst[0] === 1993 && worst[1] < -15, '1993 worst year, 1994 inflation peak');
assertClaim(uN - uRank === 15 && unemp! < 2.1 && s.unemploymentPct.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === 1993, 'unemployment 16th lowest; peak 1993');
assertClaim(rem!.year === 2020 && remPct!.value > 8.6, 'remittances end 2020, 8.7% of GDP');
assertClaim(Number(xGdp) === 2.1, 'GDP 2.1x 2015 in dollars');

const title = `Togo Economy ${L}: Fifth Year of Growth Above 5% | AtlasFigures`;
const description = `For a fifth consecutive year Togo's real growth topped 5% (${pct(growth)} in ${L}); GDP climbed to an all-time ${usd(gdp)}, and inflation slid to ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Togo on a growth streak?', a: `Yes: ${pct(growth)} in ${L}, and above 5% for five years running. Measured in dollars, ${L} output (${usd(gdp)}) is ${xGdp}-fold what it was in 2015.` },
  { q: 'Are Togolese prices still climbing?', a: `Barely: ${pct(infl.value)} over ${L}, Togo's smallest rise since prices dipped in 2017, against ${pct(i(2022))} three years earlier.` },
  { q: 'How many Togolese are jobless?', a: `Only ${pct(unemp!)} of the labour force on ILO modelling for ${L} — the ${ord(uN - uRank + 1)}-lowest of ${uN} economies. Its highest reading was ${pct(u(1993))}, in 1993.` },
  { q: 'Do Togolese abroad send much money home?', a: `The newest World Bank number is for ${rem!.year}: ${usd(rem!.value)}, or ${pct(remPct!.value)} of GDP. Later years have not been published.` },
  { q: 'Which year hit Togo hardest?', a: `1993, when output fell ${pct(Math.abs(worst[1]))}. Inflation then peaked at ${pct(iMax[1])} in 1994.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Togo's economy in ${L}: five straight years of growth above 5%`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Togolese economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Togo', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Togo's economy: a steady five-year run</h1>
        <p class="answer">
          Togolese output expanded <strong>{pct(growth)}</strong> during {L}, lifting GDP to <strong>{usd(gdp)}</strong>; inflation was {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Togo economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Togo" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Five straight years of 5%-plus growth, with the price level now almost flat.</p>

        <div class="story-block prose">
          <h2>How quickly has Togo expanded lately?</h2>
          <p>Above 5% a year in real terms since 2021, with {L} at {pct(growth)} — ranked {ord(gRank)} worldwide. Dollar GDP reached {usd(gdp)}, a record and {xGdp}-fold 2015, — {usdWhole(perHead)} per resident.</p>
        </div>
        <LineChart
          title={`Togo's annual growth, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Real GDP change, %."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Have Togo's prices settled down?</h2>
          <p>Yes. The {L} increase was a mere {pct(infl.value)}, below every year since 2017, when the index slipped; 2022 had seen {pct(i(2022))}. Much earlier, 1993 saw output fall {pct(Math.abs(worst[1]))} and 1994 brought {pct(iMax[1])} inflation.</p>
        </div>
        <LineChart
          title={`Inflation in Togo, ${s.inflationPct[0][0]}–${L}`}
          subtitle="Consumer prices, annual % change."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What do Togo's job and remittance figures show?</h2>
          <p>Modelled unemployment is just {pct(unemp!)}, the {ord(uN - uRank + 1)}-lowest of {uN} economies on the ILO's estimates. Remittances were last published for {rem!.year}, at {usd(rem!.value)} or {pct(remPct!.value)} of GDP; at PPP, output per person was {intDollars(ppp!)} in {L}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Togo and its neighbours: related pages</h2>
          <ul>
            <li><a href={path('/country/togo/population/')}>Togo's population</a></li>
            <li><a href={path('/country/ghana/economy/')}>Ghana's economy</a></li>
            <li><a href={path('/country/cote-divoire/economy/')}>Côte d'Ivoire's economy</a></li>
            <li><a href={path('/country/nigeria/economy/')}>Nigeria's economy</a></li>
            <li><a href={path('/rankings/gdp-by-country/')}>GDP by country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Togo's data table`}
          subtitle="Ten-year steps from 1960 plus 1993–94, then 2015 onward each year; the CSV covers all years."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/togo-economy.csv')} csvName="togo-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions on Togo's economy</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Remittances are published to 2020. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Togolese economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Togo" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
