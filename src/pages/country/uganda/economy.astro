---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/uganda.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/uganda/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const remR = rankBy('remittances', rem!.year);
const ssaRem = remR.filter((r) => r.region === 'Sub-Saharan Africa');
const net24 = rankBy('internetPct', net!.year).slice().reverse();
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const negs = s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y);
const hiGrowSince = Math.max(...s.gdpGrowthPct.filter(([y, x]) => y < L && x > growth).map(([y]) => y));
const iMax = s.inflationPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const remX = (rem!.value / v('remittances', 2015)!).toFixed(1);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && B.e.incomeGroup === 'Low income', 'record GDP and per person; low income');
assertClaim(negs.join() === '1984,1985' && s.gdpGrowthPct[0][0] === 1983, 'declines only 1984-85; series from 1983');
assertClaim(hiGrowSince === 2019 && g(2020) < g(2019) && growth > 6, 'growth above 6%, fastest since 2019');
assertClaim(net!.year === 2024 && net24[0].iso3 === 'BDI' && net24[1].iso3 === c.iso3 && net!.value < 10, 'second-lowest internet use in 2024, under one in ten');
assertClaim(isMax(s.remittances) && Number(remX) > 3 && ssaRem.findIndex((r) => r.iso3 === c.iso3) === 3 && ssaRem.slice(0, 3).map((r) => r.iso3).join() === 'NGA,KEN,COD', 'record remittances, >3x 2015, fourth in SSA');
assertClaim(iMax[0] === 2011 && i(2022) > 7 && infl.year === L && infl.value < 4, 'inflation peak 2011; 7% in 2022; under 4% now');

const title = `Uganda Economy ${L}: 6% Growth, Few Online | AtlasFigures`;
const description = `Uganda grew ${pct(growth)} in ${L}, its fastest pace since 2019, to a GDP of ${usd(gdp)}. Remittances tripled from 2015 to ${usd(rem!.value)}, but internet use is just ${pct(net!.value)}.`;

const faq = [
  { q: 'How fast is Uganda growing now?', a: `${pct(growth)} in ${L}. 2019 was the last year with faster growth, and growth has risen each year since the 2020 slowdown to ${pct(g(2020))}.` },
  { q: 'Is Uganda a low-income country?', a: `It is, on the World Bank\'s classification. Each Ugandan\'s share of ${L} output was ${usdWhole(perHead)}, or ${intDollars(ppp!)} with prices made comparable.` },
  { q: 'How many Ugandans use the internet?', a: `${pct(net!.value)} in ${net!.year}, fewer than one in ten. Only Burundi had a lower share among economies reporting that year.` },
  { q: 'What do Ugandans abroad send back?', a: `${usd(rem!.value)} in ${rem!.year}, about ${remX} times the 2015 sum and the fourth-largest inflow in Sub-Saharan Africa, after Nigeria, Kenya and DR Congo.` },
  { q: 'When did Uganda last have negative growth?', a: `In the mid-1980s: output fell in 1984 and 1985. The World Bank growth series for Uganda begins in 1983.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Uganda's economy ${L}: growth above 6%, record remittances and the second-lowest internet use`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Ugandan economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Uganda', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Uganda's economy: faster growth, a small online share</h1>
        <p class="answer">
          Growth of <strong>{pct(growth)}</strong> in {L}, Uganda's fastest since 2019, brought GDP to <strong>{usd(gdp)}</strong>. Remittances hit a high of {usd(rem!.value)}, yet just {pct(net!.value)} of people are online.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Uganda economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Uganda" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Uganda's growth record since 1983 shows only two years of decline, and remittances have roughly tripled in a decade.</p>

        <div class="story-block prose">
          <h2>How quickly is Uganda's economy expanding?</h2>
          <p>{pct(growth)} in {L}, a pace unmatched since 2019. After slowing to {pct(g(2020))} in 2020, growth has picked up every year, and the only contractions on record are 1984 and 1985.</p>
        </div>
        <LineChart
          title={`Uganda's yearly growth, 1983–${L}`}
          subtitle="Real GDP growth, %; World Bank figures begin in 1983."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why are so few Ugandans online?</h2>
          <p>The ITU figure shows the share, not the reasons: in {net!.year} just {pct(net!.value)} of Ugandans went online. Of all economies reporting for that year, Burundi alone was lower.</p>
        </div>
        <div class="story-block prose">
          <h2>How important is money sent from abroad?</h2>
          <p>Remittances reached {usd(rem!.value)} in {rem!.year}, roughly {remX} times the 2015 amount — worth {pct(remPct!.value)} of Uganda's GDP. Within Sub-Saharan Africa, only Nigeria, Kenya and DR Congo took in more.</p>
        </div>
        <LineChart
          title={`Remittance inflows to Uganda, 1999–${L}`}
          subtitle="Personal transfers and compensation of employees, current US dollars."
          points={s.remittances.map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What is Uganda's income level?</h2>
          <p>Low, by the World Bank's grouping. Output per Ugandan was {usdWhole(perHead)} in {L}, the highest yet, or {intDollars(ppp!)} with prices made comparable. Total GDP came to {usd(gdp)}, {ord(B.gdpRank!)} of the economies ranked; inflation was {pct(infl.value)}, down from {pct(i(2022))} in 2022.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Uganda in context: more pages</h2>
          <ul>
            <li><a href={path('/country/uganda/population/')}>Uganda's population</a></li>
            <li><a href={path('/country/kenya/economy/')}>Kenya's economy</a></li>
            <li><a href={path('/country/tanzania/economy/')}>Tanzania's economy</a></li>
            <li><a href={path('/country/dr-congo/economy/')}>DR Congo's economy</a></li>
            <li><a href={path('/rankings/remittances-by-country/')}>Remittances received, all countries</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Ugandan GDP, income and prices — a selection from 1960`}
          subtitle="With 1985 and every year from 2019; open the CSV for the full series."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/uganda-economy.csv')} csvName="uganda-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Ugandan economy: what readers ask</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">The World Bank notes Uganda's national accounts use a fiscal year ending 30 June. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Ugandan economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Uganda" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
