---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import blr from '../../../data/countries/belarus.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: a 1993 peak; lower totals every year 1994–2012
// and from 2017; deaths above births every year from 1993 to 2100; roughly half today's size by 2100; one of the lowest
// ratios of men to women anywhere; births in 2026 the fewest since 1950.
const PAGE = '/country/belarus/population/';
const un = countryData(blr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (blr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1993, 'peak 1993');
const ups = un.years.filter((r) => r.year > 1993 && r.population >= y[r.year - 1].population).map((r) => r.year);
assertClaim(ups.join() === '2013,2014,2015,2016', 'only rises after 1993: 2013–2016');
assertClaim(un.years.find((r) => r.naturalChange < 0)!.year === 1993 && un.years.filter((r) => r.year >= 1993).every((r) => r.naturalChange < 0), 'deaths over births every year from 1993');
const half = y[2100].population / c.population;
assertClaim(half > 0.48 && half < 0.5, 'about half by 2100');
const lost = peak.population - c.population;
assertClaim(lost > 1.25e6 && lost < 1.35e6, 'about 1.3 million below peak');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...m1].sort((a: any, b: any) => at(a).male / at(a).female - at(b).male / at(b).female).map((d: any) => d.iso3).indexOf('BLR') === 6, 'seventh-lowest sex ratio, 1M+');
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const bLow = est.reduce((a, b) => (b.births < a.births ? b : a));
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(bLow.year === CURRENT_YEAR && bTop.year === 1960, 'fewest births now; most in 1960');
const e1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
assertClaim([...e1].sort((a: any, b: any) => at(a).fertility - at(b).fertility).map((d: any) => d.iso3).indexOf('BLR') === 3, 'fourth-lowest fertility in Europe');
const repl = un.years.find((r) => r.year > 1959 && r.fertility < 2.1)!.year;
assertClaim(repl === 1976, 'under 2.1 from 1976');
assertClaim([...e1].sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy).slice(0, 3).map((d: any) => d.iso3).join() === 'MDA,RUS,BLR', 'third-lowest life expectancy in Europe');

const title = `Belarus Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Losing People Since 1993, Half as Large by 2100 | AtlasFigures`;
const description = `UN figures give Belarus ${millions(c.population)} for ${CURRENT_YEAR}, about 1.3 million under its 1993 high. Each year since 1993 has recorded more deaths than births, and the projection takes the total to roughly half of today by 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: blr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, blr.tableYears);

const faq = [
  { q: 'When did the population of Belarus peak?', a: `In 1993, with ${millions(peak.population)}. It declined each year to 2012, edged up from 2013 to 2016, and has declined again every year from 2017.` },
  { q: 'Why are there so few men compared with women in Belarus?', a: `The UN data show ${dec((c.male / c.female) * 100, 1)} males per 100 females, seventh-lowest among countries above a million, but not the reasons.` },
  { q: 'Are fewer Belarusian babies born now than ever before?', a: `Yes: about ${int(c.births)} in ${CURRENT_YEAR}, the fewest since 1950; 1960 saw ${int(bTop.births)}. Deaths this year: ${int(c.deaths)}.` },
  { q: 'Could Belarus halve in size?', a: `Nearly, in the projection: ${millions(y[2100].population)} in 2100, after ${millions(y[2050].population)} in 2050.` },
  { q: 'What is the Belarusian fertility rate?', a: `${dec(c.fertility, 2)}, fourth-lowest in Europe among nations of over one million. Since 1976 it has never reached 2.1.` },
];

const schema = countrySchema({
  page: PAGE, slug: blr.slug, name: blr.name, wikipedia: blr.wikipedia,
  headline: `Belarus's ${millions(c.population)}: a 1993 peak, deaths above births ever since, and a projected halving by 2100`,
  description,
  datasetName: 'Belarus population, births and deaths, 1950–2100',
  datasetDescription: `Mid-year population of Belarus for selected years from 1950 to ${CURRENT_YEAR}, including 1993–1994, 2012–2013, 2016–2017 and 2019–2020, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: blr.published, updated: blr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Belarus"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Belarus", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Belarus: a long decline from the 1993 high</h1>
        <LiveCounter
          label="Belarus: estimated population right at this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Mid-${CURRENT_YEAR} UN World Population Prospects 2024 figure, decreasing by around ${int(-c.change / 365)} a day`}
        />
        <p class="answer">
          The UN's {CURRENT_YEAR} count for Belarus, <strong>{millions(c.population)}</strong>, is down from {millions(peak.population)} at the 1993 peak. Deaths have exceeded births every year since, and the total keeps sliding.
        </p>
        <div class="dates"><span>Updated <time datetime={blr.updated}>{longDate(blr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Belarus" code="by" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much has Belarus shrunk since 1993?</h2>
          <p>By about {millions(lost)}. The UN figures top out in 1993; after that the count declines each year to 2012, inches up from 2013 to 2016, and resumes its fall in 2017. From 1993 onward, deaths have outrun births in every year, a pattern projected to last to 2100.</p>
        </div>
        <LineChart
          title="Belarus, mid-year population 1950–2100"
          subtitle="UN estimates peak in 1993; the dashed medium variant falls to about half of today by 2100."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How low have births in Belarus fallen?</h2>
          <p>To {int(c.births)} this year, the smallest number recorded from 1950 on, against {int(c.deaths)} deaths. The record, {int(bTop.births)}, dates from {bTop.year}. Fertility, below 2.1 since {repl}, is {dec(c.fertility, 2)}, fourth-lowest in Europe among nations of over one million.</p>
        </div>
        <div class="age-row" role="group" aria-label="Belarus, births in 1960 and now, deaths now (UN)">
          <div><span class="y">{bTop.year}</span><div class="v">{int(bTop.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.deaths)}</div><span class="d">Deaths</span></div>
        </div>

        <div class="story-block prose">
          <h2>Why does Belarus have far more women than men?</h2>
          <p>The source does not say, but the gap is wide: a sex ratio of {dec((c.male / c.female) * 100, 1)}, seventh-lowest among the world's nations above a million. On the same basis, Belarusian life expectancy, {dec(c.lifeExpectancy, 1)}, is Europe's third-lowest, after Moldova and Russia.</p>
        </div>

        <div class="story-block prose">
          <h2>What will the population of Belarus be in 2050 and 2100?</h2>
          <p>{millions(y[2050].population)}, then {millions(y[2100].population)}, which would be about half the present figure. Each km² holds {int(c.densityPerKm2)} people on average.</p>
        </div>
        <RelatedPages iso3={blr.iso3} name={blr.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Belarus by year, from the 1993 high to the 2010s"
          subtitle="Rows from 1994 show the decline; 2013–2016 are the only years with a small rise."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${blr.slug}-population.csv`)}
          csvName={`${blr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Belarus: answers on its population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{blr.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={blr.published}>{longDate(blr.published)}</time> · Updated <time datetime={blr.updated}>{longDate(blr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Belarus population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Belarus" code="by" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
