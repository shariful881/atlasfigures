---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/austria.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/austria/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const backToBack = s.gdpGrowthPct.filter(([y, x]) => x < 0 && (valueIn(s.gdpGrowthPct, y - 1) ?? 1) < 0).map(([y]) => y);
const gList = rankBy('gdpGrowthPct', L); const gLow = gList.length - gList.findIndex((r) => r.iso3 === c.iso3);
const uMax = s.unemploymentPct.reduce((a, b) => (b[1] > a[1] ? b : a));
const i22since = Math.max(...s.inflationPct.filter(([y, x]) => y < 2022 && x >= i(2022)).map(([y]) => y));
const pcRank = rankBy('gdpPerCapita', L).find((r) => r.iso3 === c.iso3)!.rank;
const forest = valueIn(s.forestPct, 2024)!;

assertClaim(backToBack.join() === '2024' && g(2023) < 0 && growth > 0 && gLow === 20, '2023-24 the only back-to-back contractions; 0.6% in 2025, 20th lowest');
assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && pcRank === 14, 'dollar records; 14th per head');
assertClaim(uMax[0] === 2021 && unemp! > 5.5 && u(2024) < unemp!, 'unemployment peak 2021 6.5%; 5.6% now');
assertClaim(i22since === 1974 && i(2024) < 3 && infl.value > 3.4, '8.5% in 2022 highest since 1974; 2.9% in 2024, 3.5% in 2025');
assertClaim(Math.round(forest) === 47, 'forest 47%');

const title = `Austria Economy ${L}: Back to Growth After Two Years of Decline | AtlasFigures`;
const description = `A ${pct(growth)} gain in ${L} ended Austria's first two-year contraction in data from 1961. Dollar output stood at ${usd(gdp)} while consumer-price inflation edged up to ${pct(infl.value)}.`;

const faq = [
  { q: 'Is Austria still in recession?', a: `No longer, on the annual data: after declines of ${pct(Math.abs(g(2023)))} (2023) and ${pct(Math.abs(g(2024)))} (2024), output rose ${pct(growth)} in ${L}.` },
  { q: 'Has Austria shrunk two years running before?', a: `Not in the World Bank's growth series, which starts in 1961; 2023–24 is the first pair of consecutive annual declines.` },
  { q: 'Did Austrian inflation rise again in 2025?', a: `Yes, to ${pct(infl.value)} from ${pct(i(2024))} in 2024. Back in 2022 it hit ${pct(i(2022))}, a high unseen since 1974.` },
  { q: 'Is Austrian unemployment rising?', a: `Slightly — ${pct(unemp!)} in ${L} against ${pct(u(2024))} in 2024 (ILO modelled estimate); the highest reading in the series was ${pct(uMax[1])}, in 2021.` },
  { q: 'How wealthy are Austrians on average?', a: `GDP per person was ${usdWhole(perHead)} for ${L}, ${ord(pcRank)} worldwide and the highest in Austria's own record, or ${intDollars(ppp!)} at PPP.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Austria's economy in ${L}: modest growth after an unprecedented two-year contraction`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Austrian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Austria', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Austria's economy: a return to growth after back-to-back declines</h1>
        <p class="answer">
          Two years of shrinking output ended in {L}: Austrian GDP expanded <strong>{pct(growth)}</strong> after inflation, reaching <strong>{usd(gdp)}</strong> in current dollars.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Austria economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Austria" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Two straight years of contraction — unheard of in Austrian data back to 1961 — have given way to a slight recovery.</p>

        <div class="story-block prose">
          <h2>Has Austria's economy stopped shrinking?</h2>
          <p>Yes, narrowly. Declines of {pct(Math.abs(g(2023)))} in 2023 and {pct(Math.abs(g(2024)))} in 2024 marked the only back-to-back contraction since 1961; the {L} rebound, {pct(growth)}, ranks {ord(gLow)}-weakest of 186. In dollars, output stands at a record {usd(gdp)}.</p>
        </div>
        <LineChart
          title={`Austria's annual real growth, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Real GDP growth rate for Austria, % per year."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What has happened to Austrian prices?</h2>
          <p>The 2022 rate of {pct(i(2022))} was the highest for Austria since 1974. Price growth then eased to {pct(i(2024))} (2024) before ticking up to {pct(infl.value)} in {L}.</p>
        </div>
        <div class="story-block prose">
          <h2>Is Austrian unemployment high?</h2>
          <p>Moderate by world standards and close to its own upper range: {pct(unemp!)} in {L}, not far off the 2021 record of {pct(uMax[1])}. GDP per resident is {usdWhole(perHead)} ({ord(pcRank)} worldwide), and FAO data for 2024 show woodland on {pct(forest)} of Austrian land.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Austria and its neighbours: related pages</h2>
          <ul>
            <li><a href={path('/country/austria/population/')}>Austria's population</a></li>
            <li><a href={path('/country/germany/economy/')}>Germany's economy</a></li>
            <li><a href={path('/country/switzerland/economy/')}>Switzerland's economy</a></li>
            <li><a href={path('/country/italy/economy/')}>Italy's economy</a></li>
            <li><a href={path('/country/slovakia/economy/')}>Slovakia's economy</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Austrian economy, selected years`}
          subtitle="1960, 1970, 1974, 1980, 1990, 2000, 2009–10 and 2015–2025; for the rest, open the CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/austria-economy.csv')} csvName="austria-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Austria: frequent economy questions</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Forest: AG.LND.FRST.ZS (FAO), via the World Bank. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Austrian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Austria" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
