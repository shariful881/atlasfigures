---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/france.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/france/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const G7 = ['USA', 'GBR', 'DEU', 'JPN', 'FRA', 'ITA', 'CAN'];
const other = (k: 'unemploymentPct' | 'inflationPct') => G7.filter((x) => x !== c.iso3).map((x) => valueIn(econData(x).series[k], L)).filter((x): x is number => x != null);
const g7Infl = other('inflationPct');
const remRank = rankBy('remittances', rem!.year).find((r) => r.iso3 === c.iso3)!.rank;
const uLow = s.unemploymentPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const uHigh = s.unemploymentPct.filter(([y]) => y >= 2010).reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(B.gdpRank === 7, 'seventh-largest economy');
assertClaim(s.gdpGrowthPct[0][0] === 1961 && s.gdpGrowthPct.every(([y, x]) => y === 2020 || x > g(2020)), '2020 the deepest fall on record since 1961');
assertClaim(s.gdpGrowthPct.filter(([y]) => y > 1969 && y !== 2021).every(([, x]) => x < g(2021)) && g(1969) > g(2021), '2021 growth strongest since 1969');
assertClaim(other('unemploymentPct').length === 6 && other('unemploymentPct').every((x) => x < unemp!), 'highest unemployment in the G7');
assertClaim(g7Infl.length === 5 && g7Infl.every((x) => x > infl.value) && infl.year === L, 'lowest inflation among G7 members with a figure');
assertClaim(uLow[0] === 2022 && uHigh[0] === 2015 && unemp! > uLow[1], 'unemployment low in 2022, high in 2015, edging up');
assertClaim(remRank === 3 && rem!.year === L, 'third-largest remittance receiver');
assertClaim(rem!.value > v('remittances', 2020)! * 1.4, 'remittances up by more than 40% since 2020');
assertClaim(u(2023) > u(2022) && u(2024) > u(2023) && unemp! > u(2024), 'unemployment up each year since 2022');
assertClaim(g(2022) < g(2021) && g(2023) < g(2022) && g(2024) < g(2023) && growth < g(2024), 'growth slower every year since 2021');
assertClaim(growth < 1 && growth > 0, 'growth below 1%');

const title = `French Economy ${L}: Output, Unemployment, Inflation | AtlasFigures`;
const description = `France ranks seventh by GDP (${usd(gdp)} in ${L}). Growth has cooled to ${pct(growth)}, its ${pct(unemp!)} jobless rate tops the G7 and inflation is down to ${pct(infl.value)}.`;

const faq = [
  { q: 'Is France one of the ten largest economies?', a: `Yes, it is seventh: ${usd(gdp)} in ${L}, a ${pct(share)} slice of the global total.` },
  { q: 'Why is French unemployment high compared with other G7 countries?', a: `The World Bank data do not give reasons. They show a rate of ${pct(unemp!)} in ${L}, above all six other G7 members, though well down from ${pct(uHigh[1])} in 2015.` },
  { q: 'How much did the French economy fall in 2020?', a: `By ${pct(Math.abs(g(2020)))}, its worst year in the series that starts in 1961. It bounced back by ${pct(g(2021))} in 2021.` },
  { q: 'Is inflation in France low now?', a: `Very low. The ${L} rate was ${pct(infl.value)}, against ${pct(v('inflationPct', 2022)!)} in 2022, and no G7 member that has reported ${L} prices did better.` },
  { q: 'Does France receive a lot of remittances?', a: `${usd(rem!.value)} in ${rem!.year}, the ${ord(remRank)} largest amount worldwide. The World Bank measure also counts wages that people living in France earn from employers in other countries.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `France's economy ${L}: seventh-largest, slow growth and the G7's highest jobless rate`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="France's economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'France', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>France: GDP, jobs and prices in {L}</h1>
        <p class="answer">
          France's output was worth <strong>{usd(gdp)}</strong> in {L}, {ord(B.gdpRank!)} in the world. Real growth slipped to <strong>{pct(growth)}</strong>, and {pct(unemp!)} of workers were unemployed, more than in any other G7 country.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`France economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="France" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Of the G7 members that have reported {L} prices, France has the lowest inflation, but growth has faded each year since the 2021 rebound and joblessness is creeping back up.</p>

        <div class="story-block prose">
          <h2>How big is the French economy?</h2>
          <p>At {usd(gdp)} in {L}, it is the world's {ord(B.gdpRank!)} largest and makes up {pct(share)} of global output. Per resident that is {usdWhole(perHead)}, or {intDollars(ppp!)} at purchasing power parity.</p>
        </div>

        <div class="story-block prose">
          <h2>Is France's growth slowing?</h2>
          <p>Every year since 2021. After the record {signedPct(g(2020))} slump of 2020, output jumped {pct(g(2021))} in 2021, the fastest rise since 1969. Growth then eased to {pct(g(2022))} in 2022, {pct(g(2023))} in 2023, {pct(g(2024))} in 2024 and {pct(growth)} in {L}.</p>
        </div>

        <div class="story-block prose">
          <h2>How many people in France are out of work?</h2>
          <p>Roughly {pct(unemp!)} of French workers in {L}, according to the ILO estimates the World Bank publishes, the top rate in the G7. It has come down a long way from {pct(uHigh[1])} in 2015, but it bottomed at {pct(uLow[1])} in 2022 and has risen a little in each year since.</p>
        </div>
        <LineChart
          title={`French jobless rate, 1991–${L}`}
          subtitle="Share of the labour force out of work, modelled ILO estimates."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Has inflation in France come down?</h2>
          <p>Yes. The French price level climbed {pct(v('inflationPct', 2022)!)} in 2022 and {pct(v('inflationPct', 2023)!)} in 2023, then {pct(v('inflationPct', 2024)!)} in 2024 and just {pct(infl.value)} in {L}. That beats every G7 peer that has published {L} data; the United States has not.</p>
        </div>

        <div class="story-block prose">
          <h2>Why are France's remittance receipts so large?</h2>
          <p>Partly because of how they are counted. The World Bank figure, {usd(rem!.value)} in {rem!.year} and the {ord(remRank)} largest anywhere, adds the wages people living in France earn from employers abroad to personal transfers sent from other countries. Receipts have grown by more than 40% since 2020.</p>
        </div>
        <LineChart
          title={`Money flowing in to French households from abroad, 2000–${L}`}
          subtitle="Personal transfers plus pay from employers abroad, current US dollars."
          points={s.remittances.filter(([y]) => y >= 2000).map(([x, y]) => ({ x, y }))}
          format="usdBillions" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />

        <nav class="related" aria-label="Related pages">
          <h2>More about France and its neighbours</h2>
          <ul>
            <li><a href={path('/country/france/population/')}>France's population</a></li>
            <li><a href={path('/country/germany/economy/')}>Germany's economy</a></li>
            <li><a href={path('/country/united-kingdom/economy/')}>The UK economy</a></li>
            <li><a href={path('/country/spain/population/')}>Spain's population</a></li>
            <li><a href={path('/rankings/unemployment-rate-by-country/')}>Unemployment in every country</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`France year by year, 1960–${L}`}
          subtitle="Selected years including 2009, 2015 and 2020; download the CSV for all of them."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/france-economy.csv')} csvName="france-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions about the French economy</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"G7" means Canada, France, Germany, Italy, Japan, the United Kingdom and the United States. Personal remittances are personal transfers plus compensation of employees, as defined by the World Bank. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("France's economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="France" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
