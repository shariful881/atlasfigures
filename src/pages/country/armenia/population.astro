---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import arm from '../../../data/countries/armenia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: life expectancy 52.7 in 1988 against 67.6 in
// 1987, deaths doubling (the Spitak earthquake of 7 December 1988, USGS cited for date and magnitude only); the largest
// net inflow in 1989; peak 1991; the largest outflow in 1992; falls every year 1992–2021, rises 2022–2024, falls from
// 2025; urban majority since 1959; 86.5 men per 100 women; still about twice its 1950 size.
const PAGE = '/country/armenia/population/';
const un = countryData(arm.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (arm.verification as any).checkedOn as string | undefined;
const USGS_URL = 'https://earthquake.usgs.gov/earthquakes/eventpage/usp0003pmm';
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(y[1988].lifeExpectancy < 53 && y[1987].lifeExpectancy > 67 && y[1989].lifeExpectancy > 67 && y[1988].deaths > 1.9 * y[1987].deaths, '1988 lifespan dip, deaths doubled');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(inTop.year === 1989 && outTop.year === 1992, 'inflow peak 1989, outflow peak 1992');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991, 'peak 1991');
const ups = un.years.filter((r) => r.year > 1991 && r.population > y[r.year - 1].population).map((r) => r.year);
assertClaim(ups.join() === '2022,2023,2024', 'only rises after 1991: 2022–2024');
assertClaim(y[2022].netMigrants > 0 && y[2023].netMigrants > 0 && y[2024].netMigrants < 0, 'net arrivals 2022–2023');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1959, 'urban majority 1959');
const a1 = wpp.filter((d: any) => at(d).population >= 1e6);
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...a1].sort((a: any, b: any) => sr(a) - sr(b)).findIndex((d: any) => d.iso3 === 'ARM') === 3, 'fourth-lowest sex ratio');
const since = c.population / y[1950].population;
assertClaim(since > 2.05 && since < 2.2, 'about twice 1950');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 1994 && un.years.filter((r) => r.year >= 1994).every((r) => r.fertility < 2.1), 'under 2.1 from 1994');

const title = `Armenia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Earthquake Year 1988, Peak 1991, Decline and a Brief Rebound | AtlasFigures`;
const description = `UN tables place Armenia at ${millions(c.population)} in ${CURRENT_YEAR}, under its 1991 summit (${millions(peak.population)}). UN life expectancy for 1988, the year of the Spitak earthquake, is ${dec(y[1988].lifeExpectancy, 1)}; 1992 brought the largest outflow.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: arm.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
];

const rows = displayRows(un.years, arm.tableYears);

const faq = [
  { q: "How does 1988 show up in Armenia's population figures?", a: `Life expectancy appears as ${dec(y[1988].lifeExpectancy, 1)} years, down from ${dec(y[1987].lifeExpectancy, 1)} in 1987, and deaths roughly double. The USGS lists a magnitude 6.8 earthquake near Spitak on 7 December 1988.` },
  { q: "When was Armenia's population at its highest?", a: `1991, with ${millions(peak.population)}; ${CURRENT_YEAR} has ${millions(c.population)}.` },
  { q: 'Armenian net emigration: which year was largest?', a: `1992: ${int(-outTop.netMigrants)} net. Counts only; no motives are given.` },
  { q: "Did Armenia's population rise recently?", a: `From 2022 to 2024 it did, with ${int(y[2022].netMigrants)} and ${int(y[2023].netMigrants)} net newcomers in the first two of those years; the projection turns down from 2025.` },
  { q: 'Do Armenian women outnumber Armenian men?', a: `Slightly: the ratio is ${dec((c.male / c.female) * 100, 1)} men to every hundred women, fourth-lowest among nations above a million.` },
];

const schema = countrySchema({
  page: PAGE, slug: arm.slug, name: arm.name, wikipedia: arm.wikipedia,
  headline: `Armenia's ${millions(c.population)}: a 1988 lifespan trough; a 1991 peak; net departures largest in 1992; growth again 2022–2024`,
  description,
  datasetName: 'Armenia population, life expectancy and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Armenia for selected years from 1950 to ${CURRENT_YEAR}, including each year 1987–1993 and 2020–2025, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: arm.published, updated: arm.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'M 6.8 - 10 km N of Gogaran, Armenia (1988-12-07)', url: USGS_URL, publisher: 'U.S. Geological Survey' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Armenia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Armenia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Armenia: from the 1988 earthquake to a 1991 high</h1>
        <LiveCounter
          label="Armenia: modelled population at this second"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Steps on from UN World Population Prospects 2024 at mid-${CURRENT_YEAR}, by about ${int(-c.change / 365)} fewer daily`}
        />
        <p class="answer">
          Armenia's {CURRENT_YEAR} total in UN estimates is <strong>{millions(c.population)}</strong>. After a 1991 summit of <strong>{millions(peak.population)}</strong> the count has mostly declined.
        </p>
        <div class="dates"><span>Updated <time datetime={arm.updated}>{longDate(arm.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Armenia" code="am" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>What happened to Armenia in 1988?</h2>
          <p>On 7 December 1988, the USGS notes, a quake of magnitude 6.8 hit near Spitak. The UN series for that year carries {int(y[1988].deaths)} deaths, against {int(y[1987].deaths)} a year earlier, and a lifespan figure of {dec(y[1988].lifeExpectancy, 1)}, flanked by {dec(y[1987].lifeExpectancy, 1)} in 1987 and {dec(y[1989].lifeExpectancy, 1)} in 1989.</p>
        </div>
        <LineChart
          title="Armenian lifespans, 1950–2050, with the 1988 trough"
          subtitle="Years at birth; one-year plunge in 1988; projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How did migration shape Armenia around 1991?</h2>
          <p>1989 holds the largest net inflow in the series, {int(inTop.netMigrants)}; the population peaked in 1991. Then 1992 shows the largest net outflow, {int(-outTop.netMigrants)}, and 1993 another {int(-y[1993].netMigrants)}. The total went down each year from 1992 to 2021. Why people moved is not in the UN tables.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Armenia's population rising now?</h2>
          <p>It rose briefly over 2022–2024, the 2022 and 2023 rows showing {int(y[2022].netMigrants)} and {int(y[2023].netMigrants)} net newcomers. From 2025 the projection heads down again: {millions(y[2050].population)} at 2050 and then {millions(y[2100].population)} at 2100. Even now the country is about twice its 1950 size ({millions(y[1950].population)}). Births per woman have stayed below 2.1 from 1994 onward and stand at {dec(c.fertility, 2)}; men number {dec((c.male / c.female) * 100, 1)} per 100 women; most people have lived in towns since 1959.</p>
        </div>
        <RelatedPages iso3={arm.iso3} name={arm.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Armenia, each year 1987–1993 and 2020–2025, with decades"
          subtitle="Find the lifespan trough at 1988 and the population high at 1991."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${arm.slug}-population.csv`)}
          csvName={`${arm.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Armenia by the numbers: questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{arm.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={USGS_URL}>U.S. Geological Survey, event page "M 6.8 - 10 km N of Gogaran, Armenia"</a>: magnitude 6.8, 7 December 1988 (the Spitak earthquake).</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={arm.published}>{longDate(arm.published)}</time> · Updated <time datetime={arm.updated}>{longDate(arm.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Armenia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Armenia" code="am" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
