---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import lbr from '../../../data/countries/liberia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story, counts only (no causes given): the 1990 net
// outflow of over 700,000 and falls in 1990, 1991 and 1994; the 1997 net inflow (largest); life-expectancy low in 1990;
// urban majority since 1991; growth through 2100; fertility under 2.1 only in 2084.
const PAGE = '/country/liberia/population/';
const un = countryData(lbr.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (lbr.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1990 && -outTop.netMigrants > 7e5, 'net outflow above 700,000 in 1990');
const falls = un.years.filter((r) => y[r.year - 1] && r.population < y[r.year - 1].population).map((r) => r.year);
assertClaim(falls.join() === '1990,1991,1994', 'falls 1990, 1991, 1994');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(inTop.year === 1997, 'largest inflow 1997');
const leLow = un.years.reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leLow.year === 1990, 'life expectancy low 1990');
const share = -outTop.netMigrants / y[1989].population;
assertClaim(share > 0.27 && share < 0.3, 'outflow about 28% of 1989 population');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1991, 'urban majority 1991');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2100, 'still growing in 2100');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2084, 'under 2.1 in 2084');
const since = c.population / y[1950].population;
assertClaim(since > 6.3 && since < 6.5, 'about 6.4 times 1950');

const title = `Liberia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Mass Departure in 1990, a Return in 1997 | AtlasFigures`;
const description = `About ${millions(c.population)} Liberians are counted for ${CURRENT_YEAR} in UN estimates. The series records net departures of ${int(-outTop.netMigrants)} in 1990, over a quarter of the 1989 total, then, in 1997, ${int(inTop.netMigrants)} net returns or arrivals.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: lbr.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, lbr.tableYears);

const faq = [
  { q: "What was the scale of Liberia's 1990 departures?", a: `${int(-outTop.netMigrants)} more departed than arrived, according to the UN, about 28% of the 1989 population. The files give the count but not the cause.` },
  { q: 'When did people return to Liberia?', a: `Mostly in 1997, when arrivals beat departures by ${int(inTop.netMigrants)}, the UN's highest figure for Liberia.` },
  { q: 'Which three years show Liberia shrinking?', a: `1990, 1991 and 1994; all remaining years, 1950–2100, show growth.` },
  { q: 'When did most Liberians become town dwellers?', a: `In ${urbanHalf}; ${pct(c.urbanPct!)} are now.` },
  { q: 'Is there a peak in sight for Liberia?', a: `Not this century: ${millions(y[2100].population)} by 2100 and rising; fertility stays above 2.1 until ${repl}.` },
];

const schema = countrySchema({
  page: PAGE, slug: lbr.slug, name: lbr.name, wikipedia: lbr.wikipedia,
  headline: `Liberia's ${millions(c.population)}: the 1990 exodus; the 1997 return flow; growth all the way to 2100`,
  description,
  datasetName: 'Liberia population, net migration and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Liberia for selected years from 1950 to ${CURRENT_YEAR}, including 1989–1991, 1994, 1997 and 2003, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: lbr.published, updated: lbr.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Liberia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Liberia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Liberia: a country that emptied and refilled in the 1990s</h1>
        <LiveCounter
          label="Liberia: live estimate of residents"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Begins at the UN World Population Prospects 2024 mid-${CURRENT_YEAR} count and adds near ${int(c.change / 365)} daily`}
        />
        <p class="answer">
          UN estimates show Liberia at <strong>{millions(c.population)}</strong> for {CURRENT_YEAR}, roughly 6.4 times its 1950 count. In 1990 alone, net departures reached <strong>{int(-outTop.netMigrants)}</strong>, over a quarter of the population.
        </p>
        <div class="dates"><span>Updated <time datetime={lbr.updated}>{longDate(lbr.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Liberia" code="lr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How much of Liberia left in 1990?</h2>
          <p>The UN records {int(-outTop.netMigrants)} net departures that year, equal to about 28% of the 1989 population ({millions(y[1989].population)}), and life expectancy at its lowest, {dec(y[1990].lifeExpectancy, 1)} years. Totals fell twice in a row, 1990 and 1991, reaching {millions(y[1991].population)}, and once more in 1994. The files show the movement but give no cause.</p>
        </div>
        <div class="age-row" role="group" aria-label="Liberia net migration in 1990, 1994 and 1997 (UN)">
          <div><span class="y">1990</span><div class="v">{int(-y[1990].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">1994</span><div class="v">{int(-y[1994].netMigrants)}</div><span class="d">Net departures</span></div>
          <div><span class="y">1997</span><div class="v">{int(y[1997].netMigrants)}</div><span class="d">Net arrivals</span></div>
        </div>

        <div class="story-block prose">
          <h2>Did Liberians come back?</h2>
          <p>Net arrivals show up from 1991, and 1997 brought the most of any year ({int(inTop.netMigrants)}), with {int(y[1998].netMigrants)} more in 1998. By 1997 the total was back to {millions(y[1997].population)}. In {CURRENT_YEAR} migration is close to balanced, with {int(-c.netMigrants)} net departures.</p>
        </div>
        <LineChart
          title="Liberian life expectancy since 1950, low point 1990"
          subtitle="UN estimates through 2023, then the medium-variant projection (dashed)."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>What lies ahead for Liberia's numbers?</h2>
          <p>Steady, rapid growth. Each woman averages {dec(c.fertility, 2)} births; Liberia's median age is {dec(c.medianAge, 1)}. The projections reach {millions(y[2050].population)} around mid-century, then {millions(y[2100].population)} at its close, with no peak in between, and the rate goes under 2.1 only in {repl}. Urban Liberia has held the majority since {urbanHalf} ({pct(c.urbanPct!)} today). The infant death rate: {dec(c.infantMortalityPer1000!, 1)} per 1,000 births.</p>
        </div>
        <RelatedPages iso3={lbr.iso3} name={lbr.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Liberia, 1989–1991, 1994, 1997 and the decades between"
          subtitle="Read the 1990 and 1997 rows for the two extremes of Liberian net migration."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${lbr.slug}-population.csv`)}
          csvName={`${lbr.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Liberia: questions with short answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{lbr.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={lbr.published}>{longDate(lbr.published)}</time> · Updated <time datetime={lbr.updated}>{longDate(lbr.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Liberia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Liberia" code="lr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
