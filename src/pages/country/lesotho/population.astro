---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import lso from '../../../data/countries/lesotho.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: life expectancy down every year 1996–2006 to
// 43.2, the lowest of any 1M+ country that year, and 58.6 now (fifth-lowest); population down every year 2001–2006;
// net departures every year from 1986 through 2100, the most in 2005; urban majority only in 2031 (projection); births
// highest in 1987; peak 2083.
const PAGE = '/country/lesotho/population/';
const un = countryData(lso.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (lso.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(un.years.filter((r) => r.year >= 1996 && r.year <= 2006).every((r) => r.lifeExpectancy < y[r.year - 1].lifeExpectancy), 'lifespan falls 1996–2006');
const l1y = (yr: number) => wpp.filter((d: any) => at(d, yr).population >= 1e6);
assertClaim([...l1y(2006)].sort((a: any, b: any) => at(a, 2006).lifeExpectancy - at(b, 2006).lifeExpectancy)[0].iso3 === 'LSO', 'lowest lifespan of 1M+ in 2006');
assertClaim([...l1y(CURRENT_YEAR)].sort((a: any, b: any) => at(a).lifeExpectancy - at(b).lifeExpectancy).findIndex((d: any) => d.iso3 === 'LSO') === 4, 'fifth-lowest now');
assertClaim(un.years.filter((r) => r.year >= 2001 && r.year <= 2006).every((r) => r.population < y[r.year - 1].population) && y[2007].population > y[2006].population, 'falls 2001–2006');
assertClaim(un.years.filter((r) => r.year >= 1986).every((r) => r.netMigrants < 0) && y[1985].netMigrants >= 0, 'net departures from 1986');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2005, 'largest outflow 2005');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 2031, 'urban majority 2031');
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(bTop.year === 1987 && peak.year === 2083, 'births 1987, peak 2083');

const title = `Lesotho Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Mountain Kingdom Where Life Expectancy Fell to 43 | AtlasFigures`;
const description = `Lesotho, ${CURRENT_YEAR}: ${millions(c.population)} (UN estimate). Lifespans shortened annually over 1996–2006, bottoming at ${dec(y[2006].lifeExpectancy, 1)}, below every other million-plus nation at the time; outflows have topped inflows annually since 1986.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: lso.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, lso.tableYears);

const faq = [
  { q: "What was Lesotho's lowest life expectancy?", a: `${dec(y[2006].lifeExpectancy, 1)} years, in 2006, after annual declines since 1996; that year it trailed every million-plus country. It is ${dec(c.lifeExpectancy, 1)} now. The UN data give no causes.` },
  { q: "Did Lesotho's population shrink?", a: `For six straight years, 2001 through 2006: ${millions(y[2000].population)} became ${millions(y[2006].population)}. Growth resumed in 2007.` },
  { q: 'Is migration draining Lesotho?', a: `Yes, in each year from 1986; 2005 saw the largest outflow (${int(-outTop.netMigrants)}), and the projection keeps the balance negative through 2100.` },
  { q: 'When will most Basotho live in towns?', a: `The UN projects an urban majority by 2031; ${pct(c.urbanPct!)} are urban now.` },
  { q: 'At what level does Lesotho peak?', a: `${millions(peak.population)}, in 2083.` },
];

const schema = countrySchema({
  page: PAGE, slug: lso.slug, name: lso.name, wikipedia: lso.wikipedia,
  headline: `Lesotho's ${millions(c.population)}: a 2006 lifespan low of 43.2; decline 2001–2006; net emigration every year since 1986`,
  description,
  datasetName: 'Lesotho population, life expectancy and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Lesotho for selected years from 1950 to ${CURRENT_YEAR}, including 1986–1987, 1995 and each year 2000–2007, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: lso.published, updated: lso.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Lesotho"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Lesotho", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Lesotho: a long fall in lifespans, and a slow climb back</h1>
        <LiveCounter
          label="Lesotho: up-to-the-minute estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Continues the UN World Population Prospects 2024 figure for mid-${CURRENT_YEAR}, increasing by some ${int(c.change / 365)} daily`}
        />
        <p class="answer">
          The UN reckons Lesotho's {CURRENT_YEAR} headcount at <strong>{millions(c.population)}</strong>. Life expectancy, <strong>{dec(c.lifeExpectancy, 1)}</strong> years, still ranks among the five lowest of any million-plus nation.
        </p>
        <div class="dates"><span>Updated <time datetime={lso.updated}>{longDate(lso.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Lesotho" code="ls" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why did Basotho lifespans shrink after 1995?</h2>
          <p>The UN estimates trace the fall without explaining it: eleven straight annual declines, beginning at {dec(y[1995].lifeExpectancy, 1)} (1995) and ending at {dec(y[2006].lifeExpectancy, 1)} (2006). No million-plus nation stood lower that year. The figure has since recovered to {dec(c.lifeExpectancy, 1)}, still the fifth-lowest.</p>
        </div>
        <LineChart
          title="Lesotho's life expectancy, 1950–2050"
          subtitle="Years at birth; note the 1996–2006 slide; projection dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: Math.round(y[r.year].lifeExpectancy * 10) / 10, projection: r.projection }))}
          unit="years"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Did Lesotho's population go down?</h2>
          <p>Six consecutive annual drops, 2001 through 2006, took the count from {millions(y[2000].population)} down to {millions(y[2006].population)}. Growth returned in 2007, and the projection climbs until 2083 ({millions(peak.population)}). The record year for births was 1987.</p>
        </div>

        <div class="story-block prose">
          <h2>Are Basotho leaving the country?</h2>
          <p>Each year since 1986 shows a net loss to migration, heaviest in 2005 at {int(-outTop.netMigrants)}; for {CURRENT_YEAR} the UN expects {int(-c.netMigrants)}. Lesotho remains mostly rural, {pct(c.urbanPct!)} urban, and tips to an urban majority only in 2031 on current projections.</p>
        </div>
        <RelatedPages iso3={lso.iso3} name={lso.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Lesotho: 1986–1987, 1995 and every year 2000–2007"
          subtitle="Each row 2001–2006 is smaller than the last; 2006 is also the lifespan floor."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${lso.slug}-population.csv`)}
          csvName={`${lso.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Lesotho: what the UN data tell us</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{lso.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={lso.published}>{longDate(lso.published)}</time> · Updated <time datetime={lso.updated}>{longDate(lso.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Lesotho population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Lesotho" code="ls" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
