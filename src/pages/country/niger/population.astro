---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ne from '../../../data/countries/niger.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the world's highest fertility in every UN year
// 1995–2018; the second-youngest median age of any country above ten million; a sex ratio that moved from far more women
// (1950) to more men (from 1989); one of the least urban large countries; past 50 million in 2048. No causes claimed.
const PAGE = '/country/niger/population/';
const un = countryData(ne.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (ne.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const topTfr = (n: number) => [...wpp].filter((d: any) => at(d, n)).sort((a: any, b: any) => at(b, n).fertility - at(a, n).fertility)[0].iso3;
const firstYears = un.years.filter((r) => r.year <= 2023 && topTfr(r.year) === 'NER').map((r) => r.year);
assertClaim(firstYears[0] === 1995 && firstYears[firstYears.length - 1] === 2018 && firstYears.length === 24, 'highest fertility in the world in every year 1995–2018');
const tfrNow = [...wpp].sort((a: any, b: any) => at(b).fertility - at(a).fertility).map((d: any) => d.iso3);
assertClaim(tfrNow.indexOf('NER') === 4, 'fifth-highest fertility now');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1985 && y[2010].fertility - c.fertility > 1.95, 'fertility high 1985; about two births fewer than in 2010');
const under = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(under === 2091, 'fertility under 2.1 from 2091');
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const young = [...big].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge).map((d: any) => d.iso3);
assertClaim(young[0] === 'SOM' && young[1] === 'NER', 'second-youngest median age among countries above ten million, after Somalia');
const fast = [...big].sort((a: any, b: any) => at(b).growthRatePct - at(a).growthRatePct).map((d: any) => d.iso3);
assertClaim(fast.indexOf('NER') <= 2, 'among the three fastest-growing countries above ten million');
const men1950 = (y[1950].male / y[1950].female) * 100;
const menNow = (c.male / c.female) * 100;
const menFrom = un.years.find((r) => r.male > r.female)!.year;
assertClaim(men1950 < 85 && menNow > 103 && menFrom === 1989 && un.years.filter((r) => r.year >= menFrom && r.year <= CURRENT_YEAR).every((r) => r.male > r.female) && [1950, 1960, 1970, 1980, 1990, 2000, 2010, 2015].every((n) => y[n].fertility > 7), 'about 85 men per 100 women in 1950; more men than women from 1989');
const lowUrb = [...big].filter((d: any) => at(d).urbanPct != null).sort((a: any, b: any) => at(a).urbanPct - at(b).urbanPct).map((d: any) => d.iso3);
assertClaim(lowUrb.indexOf('NER') === 2 && lowUrb[0] === 'PNG' && lowUrb[1] === 'MWI', 'third-lowest urban share among countries above ten million');
const waf = wpp.filter((d: any) => d.subregion === 'Western Africa');
assertClaim([...waf].sort((a: any, b: any) => b.landAreaKm2 - a.landAreaKm2)[0].iso3 === 'NER', 'largest land area in Western Africa');
const fifty = un.years.find((r) => r.population > 5e7)!.year;
const doubled = un.years.find((r) => r.population > 2 * c.population)!.year;
assertClaim(fifty === 2048 && doubled === 2055, 'past 50 million in 2048; double today by 2055');
const waf2100 = [...waf].sort((a: any, b: any) => at(b, 2100).population - at(a, 2100).population).map((d: any) => d.iso3);
assertClaim(waf2100.slice(0, 3).join() === 'NGA,CIV,NER', 'third in Western Africa by 2100');
const times = c.population / y[1950].population;
assertClaim(times > 11 && times < 11.2 && un.years.every((r, i, a) => i === 0 || r.population > a[i - 1].population), 'eleven times 1950; rises every year');

const title = `Niger Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M, Record Fertility and a Median Age of ${dec(c.medianAge, 1)} | AtlasFigures`;
const description = `From 1995 through 2018, no country had higher fertility than Niger. Half its ${millions(c.population)} people (UN, ${CURRENT_YEAR}) are under ${dec(c.medianAge, 1)}, and the total passes 50 million in ${fifty}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `+${pct(c.growthRatePct)}`, note: `+${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: ne.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, ne.tableYears);

const faq = [
  { q: 'How populous is Niger today?', a: `${millions(c.population)} by the UN's reckoning for 1 July ${CURRENT_YEAR}, which places Niger ${ord(c.worldRank!)} globally and fourth in Western Africa.` },
  { q: 'Is Niger\'s fertility rate the world\'s highest?', a: `Not any more. It led the world each year between 1995 and 2018; with ${dec(c.fertility, 2)} this year it now ranks fifth, after Chad, Somalia, DR Congo and the Central African Republic.` },
  { q: "What is Niger's median age?", a: `${dec(c.medianAge, 1)} years. Of all nations above ten million inhabitants, Somalia alone is younger.` },
  { q: 'Do men outnumber women in Niger?', a: `Yes: ${dec(menNow, 1)} men per 100 women now, a lead men have held since ${menFrom}. The 1950 figure was only ${dec(men1950, 1)}.` },
  { q: 'In which year does Niger pass 50 million?', a: `${fifty}, according to the UN's central projection. By ${doubled} the count is double today's, and in 2100 it is ${millions(y[2100].population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: ne.slug, name: ne.name, wikipedia: ne.wikipedia,
  headline: `Niger's ${millions(c.population)}: the world's highest fertility from 1995 to 2018 and a median age of ${dec(c.medianAge, 1)}`,
  description,
  datasetName: 'Niger population, fertility, sex ratio and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Niger for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: ne.published, updated: ne.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Niger"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Niger', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Niger: world leader in fertility from 1995 to 2018</h1>
        <LiveCounter
          label="Niger: population, estimated live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: from the mid-${CURRENT_YEAR} level at roughly ${int(c.change / 365)} more each day`}
        />
        <p class="answer">
          On UN figures for mid-{CURRENT_YEAR}, Niger has <strong>{millions(c.population)}</strong> people with a median age of only <strong>{dec(c.medianAge, 1)}</strong>. From 1995 to 2018 its women had more children on average than those of any other country, and growth of {pct(c.growthRatePct)} a year remains among the fastest of any large nation.
        </p>
        <div class="dates"><span>Updated <time datetime={ne.updated}>{longDate(ne.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Niger" code="ne" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Did Niger have the highest fertility rate in the world?</h2>
          <p>For {firstYears.length} consecutive UN years, 1995 to 2018, yes. Its all-time high, {dec(tfrTop.fertility, 2)}, belongs to {tfrTop.year}; the 2010 figure was still {dec(y[2010].fertility, 2)}. Since then it has fallen by about two children, to {dec(c.fertility, 2)}, which puts Niger fifth in the world today, after Chad, Somalia, DR Congo and the Central African Republic. The UN medium variant does not take it under 2.1 until {under}.</p>
        </div>
        <LineChart
          title="Nigerien women's average number of children, 1950–2050"
          subtitle="UN estimates through the near-flat plateau above seven, then the projected decline, dashed; 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 children' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Niger younger than almost every other country?</h2>
          <p>Yes. Every nation above ten million inhabitants except Somalia has a higher median age than Niger's {dec(c.medianAge, 1)}. The UN expects some {millions(c.births)} births this year and {int(Math.round(c.deaths / 1000))} thousand deaths. Life expectancy: {dec(y[1950].lifeExpectancy, 1)} years in 1950, {dec(c.lifeExpectancy, 1)} today.</p>
        </div>

        <div class="story-block prose">
          <h2>Did Niger once have far fewer men than women?</h2>
          <p>Yes. The UN's 1950 sex ratio is {dec(men1950, 1)} males per 100 females. It climbed steadily; men have been in the majority since {menFrom}, and today the ratio is {dec(menNow, 1)}. The UN series records this change without explaining it.</p>
        </div>
        <div class="age-row" role="group" aria-label="Men per 100 women in Niger, UN estimates">
          <div><span class="y">1950</span><div class="v">{dec(men1950, 1)}</div><span class="d">Men per 100 women</span></div>
          <div><span class="y">{menFrom}</span><div class="v">{dec((y[menFrom].male / y[menFrom].female) * 100, 1)}</div><span class="d">Men first in the majority</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(menNow, 1)}</div><span class="d">Men per 100 women</span></div>
        </div>

        <div class="story-block prose">
          <h2>How big will Niger be by 2050 and 2100?</h2>
          <p>The 50 million mark falls in {fifty}; by {doubled} the population is twice today's; 2100 brings {millions(y[2100].population)}. That would make Niger {ord(y[2100].worldRank!)} on the world list, with only Nigeria and Côte d'Ivoire larger in Western Africa. Today's total is already {dec(times, 1)} times that of 1950. Most people still live outside towns: just {pct(c.urbanPct!)} are urban on the national definition, the third-smallest share among nations above ten million, in what is Western Africa's largest country by land area.</p>
        </div>
        <LineChart
          title="Niger's population: 1950 estimates through 2100 projections"
          subtitle="UN mid-year totals; dashed after the estimate years, with no year of decline."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={ne.iso3} name={ne.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Niger: population and fertility table"
          subtitle="Every estimate row from 1950 to 2015 shows more than seven births per woman; the projection follows."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${ne.slug}-population.csv`)}
          csvName={`${ne.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Quick facts on Niger's people</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{ne.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, men and women, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={ne.published}>{longDate(ne.published)}</time> · Updated <time datetime={ne.updated}>{longDate(ne.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Niger population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Niger" code="ne" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
