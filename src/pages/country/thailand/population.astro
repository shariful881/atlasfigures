---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import th from '../../../data/countries/thailand.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peaked in 2022, births less than half the 1968 level, the oldest population in South-Eastern Asia, a deep fall by 2100.
const PAGE = '/country/thailand/population/';
const un = countryData(th.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (th.verification as any).checkedOn as string | undefined;

const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
const natLoss = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(peak.year === 2022 && natLoss === 2022, 'peak 2022, the first year deaths exceeded births');
assertClaim(un.years.filter((r) => r.year > peak.year).every((r) => r.change < 0 && r.naturalChange < 0), 'smaller every year after 2022, with deaths above births');
const est = un.years.filter((r) => !r.projection);
const birthTop = est.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1968 && c.births < birthTop.births / 2, 'births under half the 1968 peak');
const tfrMax = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const below = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrMax.year === 1953 && below === 1990 && un.years.every((r) => r.year < 1990 || r.fertility < 2.1), 'fertility peak 1953, under 2.1 since 1990');
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const sea = wpp.filter((d: any) => d.subregion === 'South-Eastern Asia');
const oldest = sea.slice().sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).map((d: any) => d.iso3);
assertClaim(oldest[0] === 'THA', 'highest median age in South-Eastern Asia');
const bigSea = sea.slice().sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(bigSea.slice(0, 4).join(',') === 'IDN,PHL,VNM,THA', 'fourth in South-Eastern Asia after Indonesia, the Philippines and Vietnam');
const falls = wpp.filter((d: any) => at(d).population > 50e6).sort((a: any, b: any) => at(a, 2100).population / at(a).population - at(b, 2100).population / at(b).population).map((d: any) => d.iso3);
assertClaim(falls.indexOf('THA') === 4 && falls.slice(0, 4).join(',') === 'KOR,CHN,ITA,JPN', 'fifth-steepest fall to 2100 among countries over 50 million, after South Korea, China, Italy and Japan');
const backTo = un.years.find((r) => r.population >= y[2100].population)!.year;
assertClaim(backTo === 1980, '2100 total about the 1980 level');
const drop = (1 - y[2100].population / c.population) * 100;
assertClaim(y[1950].urbanPct! < 11 && c.urbanPct! > 63, 'urban share from about a tenth to nearly two-thirds');

const title = `Thailand Population ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)} Million, Shrinking Since ${peak.year} | AtlasFigures`;
const description = `Thailand's population topped out in ${peak.year} and is ${millions(c.population)} in mid-${CURRENT_YEAR}. Births are less than half their 1968 level, while the UN medium variant points to ${millions(y[2100].population)} in 2100.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: pct(c.growthRatePct), note: `${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: th.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'World rank', value: ord(c.worldRank!) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, th.tableYears);

const faq = [
  { q: 'What is the latest figure for Thailand\'s population?', a: `${millions(c.population)} in mid-${CURRENT_YEAR}, per the UN, which ranks Thailand ${ord(c.worldRank!)} worldwide and fourth in South-Eastern Asia.` },
  { q: "Is Thailand's population already falling?", a: `Yes. The UN's estimates show the top in ${peak.year} (${millions(peak.population)}), and each later year is lower, by about ${int(Math.round(Math.abs(c.change) / 1000))} thousand in ${CURRENT_YEAR}.` },
  { q: 'Why is Thailand ageing so fast?', a: `The UN data point to the ingredients rather than the causes: fertility of ${dec(c.fertility, 2)}, under 2.1 since ${below}, and births down to about ${int(Math.round(c.births / 1000))} thousand from ${millions(birthTop.births)} in ${birthTop.year}. The median age is ${dec(c.medianAge, 1)}, the highest in the region.` },
  { q: 'How many Thai babies are born each year now?', a: `Around ${int(Math.round(c.births / 1000))} thousand in ${CURRENT_YEAR}, against roughly ${int(Math.round(c.deaths / 1000))} thousand deaths.` },
  { q: 'What could Thailand\'s population be in 2100?', a: `${millions(y[2100].population)} on the medium projection, ${pct(drop)} below today and about the size Thailand had in ${backTo}. It would rank ${ord(y[2100].worldRank!)} in the world.` },
];

const schema = countrySchema({
  page: PAGE, slug: th.slug, name: th.name, wikipedia: th.wikipedia,
  headline: `Thailand's population has been shrinking since ${peak.year}: ${millions(c.population)} in ${CURRENT_YEAR}`,
  description,
  datasetName: 'Thailand population, births, deaths, ageing and urban share, 1950–2100',
  datasetDescription: `Mid-year population of Thailand for selected years from 1950 to ${CURRENT_YEAR}, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: th.published, updated: th.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Thailand"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: 'Thailand', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Thailand's population has started to shrink</h1>
        <LiveCounter
          label="Thailand: estimated population, live"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} value, down by about ${int(Math.abs(c.change) / 365)} people daily`}
        />
        <p class="answer">
          Thailand's population of about <strong>{millions(c.population)}</strong> (mid-{CURRENT_YEAR}, {ord(c.worldRank!)} worldwide) reached its <strong>peak in {peak.year}</strong> and has been declining since, with deaths outnumbering births. Thais have the highest median age in South-Eastern Asia.
        </p>
        <div class="dates"><span>Updated <time datetime={th.updated}>{longDate(th.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Thailand" code="th" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Has Thailand's population already peaked?</h2>
          <p>Yes, in {peak.year}, at {millions(peak.population)}, by UN estimates. That was also the first year in which more Thais died than were born, and the total has slipped every year since. In {CURRENT_YEAR} the loss is about {int(Math.round(Math.abs(c.change) / 1000))} thousand: a natural decrease of {int(Math.round(Math.abs(c.naturalChange) / 1000))} thousand, partly offset by {int(Math.round(c.netMigrants / 1000))} thousand net arrivals.</p>
        </div>
        <LineChart
          title="Thailand's population, 1950–2100: up to 2022, down since"
          subtitle="Mid-year population from the UN; the dashed projection falls toward 46 million."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How far have Thai births fallen since the 1960s?</h2>
          <p>To well under half. Births peaked in {birthTop.year} at about {millions(birthTop.births)}; the {CURRENT_YEAR} estimate is roughly {int(Math.round(c.births / 1000))} thousand, against some {int(Math.round(c.deaths / 1000))} thousand deaths. Thai fertility was {dec(tfrMax.fertility, 2)} in {tfrMax.year}, dropped under 2.1 in {below} and is {dec(c.fertility, 2)} today.</p>
        </div>
        <LineChart
          title="Thai fertility rate, 1950 to 2050"
          subtitle="Thai births per woman, estimated and then projected (dashed), with 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 level' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Does Thailand have South-East Asia's oldest population?</h2>
          <p>Yes, by median age: {dec(c.medianAge, 1)} in {CURRENT_YEAR}, higher than any other country in the UN's South-Eastern Asia group, Singapore included. In 1950 it was {dec(y[1950].medianAge, 1)}; the UN projects {dec(y[2050].medianAge, 1)} for 2050. Thai life spans average {dec(c.lifeExpectancy, 1)} years at birth.</p>
        </div>
        <div class="age-row" role="group" aria-label="Median age in Thailand">
          <div><span class="y">1950</span><div class="v">{dec(y[1950].medianAge, 1)}</div><span class="d">Median age</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{dec(c.medianAge, 1)}</div><span class="d">Oldest in the region</span></div>
          <div><span class="y">2050, UN projection</span><div class="v">{dec(y[2050].medianAge, 1)}</div><span class="d">Approaching 50</span></div>
        </div>

        <div class="story-block prose">
          <h2>How small could Thailand's population get?</h2>
          <p>About {millions(y[2100].population)} by 2100 under the medium variant, {pct(drop)} below today and roughly the size of {backTo}. Only South Korea, China, Italy and Japan face steeper relative falls among the countries above 50 million. Thailand would drop to {ord(y[2050].worldRank!)} place by 2050 and {ord(y[2100].worldRank!)} by 2100.</p>
        </div>

        <div class="story-block prose">
          <h2>How many Thais live in towns and cities?</h2>
          <p>About {pct(c.urbanPct!)} of the population, counted by the national definition of urban areas, up from {pct(y[1950].urbanPct!)} in 1950, and World Urbanization Prospects expects {pct(y[2050].urbanPct!)} by 2050. Average density is {int(c.densityPerKm2)} people per km².</p>
        </div>
        <RelatedPages iso3={th.iso3} name={th.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Thai population across 1950–2100"
          subtitle="UN totals and indicators by decade; the shaded part from 2030 is projected."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${th.slug}-population.csv`)}
          csvName={`${th.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Thailand's population: what readers ask</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{th.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share and its projection to 2050.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={th.published}>{longDate(th.published)}</time> · Updated <time datetime={th.updated}>{longDate(th.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Thailand population', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Thailand" code="th" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
