---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/thailand.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';
import wpp from '../../../data/wpp/index.json';
// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/thailand/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const remRank = rankBy('remittances', rem!.year).find((r) => r.iso3 === c.iso3)!.rank;
const uAsc = rankBy('unemploymentPct', L).slice().reverse();
const uPos = uAsc.findIndex((r) => r.iso3 === c.iso3) + 1;
const negInfl = s.inflationPct.filter(([, x]) => x < 0).map(([y]) => y);
const sea = (wpp as any).countries.filter((x: any) => x.subregion === 'South-Eastern Asia').map((x: any) => x.iso3);
const seaR = rankBy('gdp', L).filter((r) => sea.includes(r.iso3));

assertClaim(infl.year === L && infl.value < 0 && negInfl.at(-2) === 2020, 'prices fell in the latest year, the first time since 2020');
assertClaim(uPos === 4 && unemp! < 1, 'fourth-lowest unemployment');
assertClaim([2021, 2022, 2023, 2024, L].every((y) => g(y) > 0 && g(y) < 3), 'growth between 0% and 3% every year since 2021');
assertClaim(g(1997) < 0 && g(1998) < -7 && s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a))[0] === 1998, '1997-98 crisis, 1998 the worst year');
assertClaim(seaR.findIndex((r) => r.iso3 === c.iso3) === 2 && B.gdpRank === 29, 'third in South-eastern Asia; 29th');
assertClaim(remRank === 21 && rem!.value > 2 * v('remittances', 2015)!, 'remittances 21st, more than double 2015');

assertClaim(['IDN', 'MYS', 'PHL', 'SGP', 'VNM'].every((x) => valueIn(econData(x).series.gdpGrowthPct, L)! > growth) && negInfl.slice(-4).join() === '2009,2015,2020,' + L, 'slower than five neighbours; deflation years');

const title = `Thailand Economy ${L}: Falling Prices, Slow Growth | AtlasFigures`;
const description = `Thai consumer prices fell ${pct(Math.abs(infl.value))} in ${L}, the first drop since 2020, while output rose ${pct(growth)} in real terms to ${usd(gdp)}. Joblessness of ${pct(unemp!)} ranks near the bottom worldwide.`;

const faq = [
  { q: 'Is Thailand in deflation?', a: `Thai consumer prices slipped ${pct(Math.abs(infl.value))} over ${L}, the first annual fall since 2020; before that, prices also dropped in 2015 and 2009.` },
  { q: 'How does Thai growth compare with Southeast Asia?', a: `It is slower. Thai growth has ranged from ${pct(Math.min(...[2021, 2022, 2023, 2024, L].map(g)))} to ${pct(Math.max(...[2021, 2022, 2023, 2024, L].map(g)))} each year since 2021; its ${L} figure of ${pct(growth)} was below Indonesia, Malaysia, the Philippines, Singapore and Vietnam.` },
  { q: 'Is Thai unemployment really under 1%?', a: `Yes. The ILO model puts it at ${pct(unemp!)} for ${L}; only three economies were lower.` },
  { q: 'What happened to Thailand in 1997 and 1998?', a: `Output fell two years running, by ${pct(Math.abs(g(1997)))} in 1997 and ${pct(Math.abs(g(1998)))} in 1998, the deepest drop on record.` },
  { q: 'How much money is sent home to Thailand?', a: `${usd(rem!.value)} in ${rem!.year}, more than double 2015's level; Thailand ranks ${ord(remRank)} among recipients.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Thailand's economy ${L}: falling prices, sub-3% growth and one of the lowest jobless rates anywhere`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Thai economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Thailand', href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Thailand's economy: prices dip, growth stays slow</h1>
        <p class="answer">
          Thailand's {L} output totalled <strong>{usd(gdp)}</strong>, after growth of <strong>{pct(growth)}</strong>. Consumer prices fell {pct(Math.abs(infl.value))}, the first decline since 2020, and unemployment was just {pct(unemp!)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Thailand economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Thailand" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Thailand pairs a jobless rate under 1% with growth below 3% and, in {L}, slightly falling prices.</p>

        <div class="story-block prose">
          <h2>Is Thailand experiencing deflation?</h2>
          <p>Yes, slightly. Thai consumer prices were {pct(Math.abs(infl.value))} lower in {L} than in {L - 1}, the first annual decline since 2020, with earlier ones in 2015 and 2009. In 2022 they had risen {pct(i(2022))}.</p>
        </div>
        <LineChart
          title={`Thai inflation, 1960–${L}`}
          subtitle="Thai inflation by year, in per cent; negative values are years when prices dropped."
          points={s.inflationPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Why does Thai growth lag its neighbours?</h2>
          <p>The data show the gap without explaining it. Thailand's {pct(growth)} in {L} trailed Indonesia, Malaysia, the Philippines, Singapore and Vietnam, and every year since 2021 it has grown by less than 3%. The 1997–98 crisis remains the deepest downturn on record, with output down {pct(Math.abs(g(1998)))} in 1998.</p>
        </div>
        <div class="story-block prose">
          <h2>How much does the Thai economy produce?</h2>
          <p>{usd(gdp)} in {L}, {ord(B.gdpRank!)} globally; in South-eastern Asia, Indonesia and Singapore are bigger. Per inhabitant: {usdWhole(perHead)}, or {intDollars(ppp!)} measured in purchasing power.</p>
        </div>
        <div class="story-block prose">
          <h2>Does Thailand have almost no unemployment?</h2>
          <p>Close to it: the ILO model gives {pct(unemp!)} for {L}, the {ord(uPos)} lowest of all economies with a figure. Remittances from abroad reached {usd(rem!.value)}, placing Thailand {ord(remRank)} among recipients.</p>
        </div>
        <LineChart
          title={`Unemployment in Thailand, 1991–${L}`}
          subtitle="Jobless share of the Thai workforce (ILO); the peak came in 1998."
          points={s.unemploymentPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <nav class="related" aria-label="Related pages">
          <h2>Thailand and Southeast Asia: related pages</h2>
          <ul>
            <li><a href={path('/country/thailand/population/')}>Thailand's population</a></li>
            <li><a href={path('/country/malaysia/economy/')}>Malaysia's economy</a></li>
            <li><a href={path('/country/vietnam/economy/')}>Vietnam's economy</a></li>
            <li><a href={path('/country/myanmar/population/')}>Myanmar's population</a></li>
            <li><a href={path('/rankings/unemployment-rate-by-country/')}>Lowest and highest unemployment</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Thailand's economy by year, selected 1960–${L}`}
          subtitle="Including 1997, 1998 and 2010 with recent years; the CSV lists all years."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/thailand-economy.csv')} csvName="thailand-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Thai economy: questions and answers</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">"South-eastern Asia" is the UN subregion used in World Population Prospects 2024. The World Bank notes Thailand's fiscal year ends on 30 September; national accounts are calendar-year. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Thai economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Thailand" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
