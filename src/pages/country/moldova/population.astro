---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import mda from '../../../data/countries/moldova.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the largest fall from its own peak of any 1M+
// country (now about two thirds of 1991); the fastest shrinking in 2026; net departures every year 1979–2021, the most
// in 2010; a 2022 inflow, the largest in the series, and rises in 2022–2023; 85.1 men per 100 women, second-lowest
// after Hong Kong; never majority-urban through 2050.
const PAGE = '/country/moldova/population/';
const un = countryData(mda.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (mda.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1991, 'peak 1991');
const m1 = wpp.filter((d: any) => at(d).population >= 1e6);
const fromTop = (d: any) => at(d).population / Math.max(...d.years.filter((r: any) => r.year <= CURRENT_YEAR).map((r: any) => r.population));
assertClaim([...m1].sort((a: any, b: any) => fromTop(a) - fromTop(b))[0].iso3 === 'MDA' && c.population / peak.population > 0.65 && c.population / peak.population < 0.67, 'largest drop, about two thirds');
assertClaim([...m1].sort((a: any, b: any) => at(a).change / at(a).population - at(b).change / at(b).population)[0].iso3 === 'MDA', 'fastest shrinking now');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...m1].sort((a: any, b: any) => sr(a) - sr(b)).slice(0, 2).map((d: any) => d.iso3).join() === 'HKG,MDA', 'second-lowest sex ratio');
assertClaim(un.years.filter((r) => r.year >= 1979 && r.year <= 2021).every((r) => r.netMigrants < 0) && y[2022].netMigrants > 0, 'net departures 1979–2021');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
assertClaim(outTop.year === 2010 && inTop.year === 2022, 'outflow peak 2010, inflow peak 2022');
const ups = un.years.filter((r) => r.year > 1991 && r.population > y[r.year - 1].population).map((r) => r.year);
assertClaim(ups.join() === '2022,2023', 'only rises after 1991: 2022–2023');
assertClaim(un.years.filter((r) => r.year <= 2050 && r.urbanPct != null).every((r) => r.urbanPct! < 50), 'never majority urban to 2050');
assertClaim(un.years.filter((r) => r.year >= 2018).every((r) => r.naturalChange < 0), 'deaths above births from 2018');

const title = `Moldova Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): One-Third Smaller Than in 1991, Europe's Fastest Decline | AtlasFigures`;
const description = `Moldova's ${CURRENT_YEAR} UN total, ${millions(c.population)}, is about two thirds of its 1991 level (${millions(peak.population)}): proportionally the deepest fall from its own peak of any nation above a million. Outflows exceeded inflows in each year 1979–2021.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: mda.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Change per year', value: pct(c.change / c.population * 100) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, mda.tableYears);

const faq = [
  { q: 'How much population has Moldova lost?', a: `About a third since 1991, when the UN count was ${millions(peak.population)}; ${CURRENT_YEAR} shows ${millions(c.population)}. No million-plus nation sits so far below its own high.` },
  { q: 'Is Moldova shrinking faster than any other country?', a: `In ${CURRENT_YEAR}, yes, among the million-plus group, at ${pct(c.change / c.population * 100)} a year.` },
  { q: 'For how long did outflows dominate migration in Moldova?', a: `Over 1979–2021, without a single exception; the deepest year was 2010 (${int(-outTop.netMigrants)}). Motives are not recorded.` },
  { q: 'Why did Moldova grow in 2022?', a: `The UN series shows ${int(inTop.netMigrants)} net arrivals that year, the largest inflow on record, but gives no reason. The total rose in 2022 and 2023, then resumed falling.` },
  { q: 'What share of Moldovans are urban?', a: `${pct(c.urbanPct!)}; the projection keeps it below one half through 2050.` },
];

const schema = countrySchema({
  page: PAGE, slug: mda.slug, name: mda.name, wikipedia: mda.wikipedia,
  headline: `Moldova's ${millions(c.population)}: the deepest fall from its peak of any 1M+ country; net departures 1979–2021; a 2022 inflow`,
  description,
  datasetName: 'Moldova population, net migration and sex ratio, 1950–2100',
  datasetDescription: `Mid-year population of Moldova (UN name: Republic of Moldova) for selected years from 1950 to ${CURRENT_YEAR}, including 1979, 1991–1992 and each year 2020–2024, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: mda.published, updated: mda.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Moldova"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Moldova", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Moldova: steepest fall from a peak among million-plus nations</h1>
        <LiveCounter
          label="Moldova: approximate population this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Projected from the UN World Population Prospects 2024 figure for mid-${CURRENT_YEAR}: some ${int(-c.change / 365)} fewer per day`}
        />
        <p class="answer">
          UN reckoning gives <strong>{millions(c.population)}</strong> Moldovans this year ({CURRENT_YEAR}), roughly <strong>two thirds</strong> of the 1991 high, the steepest relative loss for any nation above a million.
        </p>
        <div class="dates"><span>Updated <time datetime={mda.updated}>{longDate(mda.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Moldova" code="md" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How far has Moldova's population fallen?</h2>
          <p>By about a third, set against 1991, when the UN count stood at {millions(peak.population)}. Measured against each country's own maximum, no nation of a million-plus has lost a larger share; Latvia, Georgia and Bosnia and Herzegovina follow. In {CURRENT_YEAR} Moldova also has the fastest rate of decline among those nations, {pct(c.change / c.population * 100)}.</p>
        </div>
        <LineChart
          title="Moldova's headcount, 1950–2100, topping out in 1991"
          subtitle="Mid-year totals; UN projection shown dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Did Moldovans leave every year?</h2>
          <p>On balance, yes over 1979–2021: 43 consecutive years in which departures outnumbered arrivals, the most in 2010 at {int(-outTop.netMigrants)}. The 2022 row then carries {int(inTop.netMigrants)} net arrivals, the largest inflow in the series, and the total rose in 2022 and 2023 (to {millions(y[2023].population)}) before falling again. Neither movement comes with an explanation in the source.</p>
        </div>

        <div class="story-block prose">
          <h2>How large is Moldova's female majority?</h2>
          <p>The data give the ratio, not the reason: {dec((c.male / c.female) * 100, 1)} males per 100 females, lower than anywhere else above a million except Hong Kong. Since 2018 deaths have surpassed births, with {int(c.deaths)} deaths expected in {CURRENT_YEAR} beside {int(c.births)} births. Town residents make up a mere {pct(c.urbanPct!)}, still a minority in the 2050 projection. By 2100 the UN line reaches {millions(y[2100].population)}.</p>
        </div>
        <RelatedPages iso3={mda.iso3} name={mda.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Moldova rows for 1979, 1991–1992 and 2020–2024"
          subtitle="Peak in 1991; after it, only 2022 and 2023 show increases."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${mda.slug}-population.csv`)}
          csvName={`${mda.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Moldova: figures explained</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{mda.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={mda.published}>{longDate(mda.published)}</time> · Updated <time datetime={mda.updated}>{longDate(mda.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Moldova population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Moldova" code="md" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
