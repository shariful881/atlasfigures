---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import bel from '../../../data/countries/belgium.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the only European country of a million or more
// with net arrivals in every year 1950–2100; deaths above births in 1975, 2020 and every year from 2022; births peaked
// in 1964; fertility under 2.1 since 1972; second-densest in Europe (1 million+) after the Netherlands; peak in 2044.
const PAGE = '/country/belgium/population/';
const un = countryData(bel.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (bel.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const eu1 = wpp.filter((d: any) => d.region === 'Europe' && at(d).population >= 1e6);
const allIn = eu1.filter((d: any) => d.years.every((r: any) => r.netMigrants > 0)).map((d: any) => d.iso3);
assertClaim(allIn.join() === 'BEL', 'only European country (1M+) with net arrivals every year 1950–2100');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const inLow = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(inTop.year === 2022 && inLow.year === 1982, 'largest net arrivals 2022, smallest 1982');
const natNeg = un.years.filter((r) => r.naturalChange < 0).map((r) => r.year);
assertClaim(natNeg[0] === 1975 && natNeg[1] === 2020 && natNeg[2] === 2022 && un.years.filter((r) => r.year >= 2022).every((r) => r.naturalChange < 0), 'deaths over births 1975, 2020 and every year from 2022');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1964, 'births peak 1964');
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const repl = est.filter((r) => r.fertility < 2.1).map((r) => r.year);
assertClaim(y[1971].fertility >= 2.1, '2.1 or above in 1971');
assertClaim(repl[0] === 1972 && repl.length === CURRENT_YEAR - 1971, 'fertility below 2.1 every year since 1972');
const tfrLow = est.reduce((a, b) => (b.fertility < a.fertility ? b : a));
assertClaim(tfrLow.year === 2023, 'record low fertility 2023');
assertClaim([...eu1].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 2).map((d: any) => d.iso3).join() === 'NLD,BEL', 'second-densest in Europe after the Netherlands');
const weu = wpp.filter((d: any) => d.subregion === 'Western Europe').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(weu.slice(0, 4).join() === 'DEU,FRA,NLD,BEL', 'fourth in Western Europe after Germany, France, the Netherlands');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2044 && un.years.filter((r) => r.year > 2044).every((r) => r.population < peak.population), 'peak 2044');
assertClaim(un.years.filter((r) => r.year > 2044).every((r) => r.naturalChange + r.netMigrants < 0 && r.netMigrants > 0), 'after 2044 natural decrease outweighs net arrivals');
assertClaim(y[2020].lifeExpectancy < y[2019].lifeExpectancy - 0.9 && y[2021].lifeExpectancy > y[2020].lifeExpectancy, 'life-expectancy dip 2020');
assertClaim([...eu1].sort((a: any, b: any) => at(b).urbanPct - at(a).urbanPct).map((d: any) => d.iso3).indexOf('BEL') === 3, 'fourth-highest urban share in Europe');

const title = `Belgium Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): More Deaths Than Births, Growth From Arrivals | AtlasFigures`;
const description = `UN count for Belgium, ${CURRENT_YEAR}: ${millions(c.population)} residents. Every year since 2022 has brought more deaths than births, but net arrivals, positive in all years 1950–2100, should keep the total rising until ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: bel.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'People per km²', value: int(c.densityPerKm2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, bel.tableYears);

const faq = [
  { q: 'Why is Belgium still adding people?', a: `Thanks to migration. This year's projection has ${int(c.deaths)} deaths against ${int(c.births)} births, and about ${int(c.netMigrants)} more arrivals than departures, for growth of ${pct(c.growthRatePct)}.` },
  { q: 'Since when have more people died than been born in Belgium?', a: `Briefly in 1975 and 2020; continuously from 2022. The projections show no return to a natural increase before 2100.` },
  { q: 'Has Belgium ever had more emigrants than immigrants?', a: `No. The UN series has a positive migration balance in each of its years, 1950 to 2100, a record no other European state above one million inhabitants shares; the smallest surplus was in ${inLow.year}, the largest (${int(inTop.netMigrants)}) in ${inTop.year}.` },
  { q: "Is Belgium one of Europe's most crowded countries?", a: `Yes: its ${int(c.densityPerKm2)} people per km² trail only the Netherlands among European states above one million inhabitants.` },
  { q: "What will Belgium's highest population be?", a: `On the medium variant, ${millions(peak.population)} in ${peak.year}; by 2100 it is down to ${millions(y[2100].population)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: bel.slug, name: bel.name, wikipedia: bel.wikipedia,
  headline: `Belgium's ${millions(c.population)}: deaths above births since 2022; net arrivals in every year, and a peak in ${peak.year}`,
  description,
  datasetName: 'Belgium population, births, deaths and net migration, 1950–2100',
  datasetDescription: `Mid-year population of Belgium for selected years from 1950 to ${CURRENT_YEAR}, including 1964, 1972, 1975, 1982 and every year 2019–2023, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: bel.published, updated: bel.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Belgium"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Belgium", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Belgium: fewer births than deaths, and arrivals every year</h1>
        <LiveCounter
          label="Belgium: estimated population today"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`From UN World Population Prospects 2024 (mid-${CURRENT_YEAR}); growth of around ${int(c.change / 365)} people a day`}
        />
        <p class="answer">
          For {CURRENT_YEAR} the UN puts Belgium's population at <strong>{millions(c.population)}</strong>. Deaths now exceed births, so the small yearly gain comes entirely from more people moving in than out, a surplus the UN shows for every year between 1950 and 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={bel.updated}>{longDate(bel.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Belgium" code="be" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Belgium's population still growing when deaths outnumber births?</h2>
          <p>Because arrivals outnumber departures by more. This year's UN figures: {int(c.deaths)} deaths, {int(c.births)} births and a migration surplus of {int(c.netMigrants)}, which nets out at {int(c.change)} extra residents. No year from 1950 to 2100 shows a net outflow, which sets Belgium apart from every other European state above one million inhabitants. The surplus was smallest in {inLow.year} ({int(inLow.netMigrants)}) and largest in {inTop.year} ({int(inTop.netMigrants)}).</p>
        </div>
        <div class="age-row" role="group" aria-label="Belgium in the current year: births, deaths, net arrivals (UN)">
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.births)}</div><span class="d">Births</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.deaths)}</div><span class="d">Deaths</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{int(c.netMigrants)}</div><span class="d">Net arrivals</span></div>
        </div>

        <div class="story-block prose">
          <h2>When did deaths start to exceed births in Belgium?</h2>
          <p>First in 1975, for one year, then in 2020 and in every year from 2022. The {birthTop.year} birth count, {int(birthTop.births)}, remains the highest; this year's is projected at {int(c.births)}. Fertility has not been at 2.1 or above since 1971 and reached its lowest, {dec(tfrLow.fertility, 2)}, in {tfrLow.year}. Life expectancy, {dec(c.lifeExpectancy, 1)} today, fell from {dec(y[2019].lifeExpectancy, 1)} to {dec(y[2020].lifeExpectancy, 1)} in 2020 and recovered in 2021.</p>
        </div>
        <LineChart
          title="Belgian fertility, 1950 estimates to 2050 projections"
          subtitle="UN estimates, below 2.1 from 1972 with a low in 2023; medium variant dashed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 per woman' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How crowded is Belgium by European standards?</h2>
          <p>Second among European states above one million inhabitants, behind the Netherlands, with {int(c.densityPerKm2)} people on each km². Fourth in Western Europe by population, after Germany, France and the Netherlands, Belgium also has one of Europe's most urban populations, {pct(c.urbanPct!)} on its national definition.</p>
        </div>

        <div class="story-block prose">
          <h2>When does Belgium's population turn down?</h2>
          <p>After {peak.year}. That year's {millions(peak.population)} is the medium variant's high; the line then slides toward {millions(y[2100].population)} at century's end, the natural decrease growing larger than net arrivals. Back in 1950 Belgium counted {millions(y[1950].population)}.</p>
        </div>
        <LineChart
          title="Belgium's population, 1950 to 2100, peaking in 2044"
          subtitle="Estimated to 2023, projected after (dashed); the line's highest point is 2044."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={bel.iso3} name={bel.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Belgium in figures, with every year 2019–2023"
          subtitle="Rows include the years deaths first exceeded births and the record migration surplus."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${bel.slug}-population.csv`)}
          csvName={`${bel.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Belgium: common questions answered</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{bel.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={bel.published}>{longDate(bel.published)}</time> · Updated <time datetime={bel.updated}>{longDate(bel.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Belgium population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Belgium" code="be" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
