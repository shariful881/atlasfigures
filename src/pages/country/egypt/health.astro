---
// Egypt health (task 171). Figures from the World Bank WDI files (src/data/wdi/, checked against the original zips
// by check-wdi) and the country profile; none typed by hand.
import HealthTopic from '../../../components/HealthTopic.astro';
import LineChart from '../../../components/LineChart.astro';
import pg from '../../../data/country-pages/egypt.json';
import { econData, econMeta, econIndex, valueIn } from '../../../lib/econ';
import { profile, stat, ordinal, fromTop } from '../../../lib/profile';
import { assertClaim, pct } from '../../../lib/figures';
import { path } from '../../../site';

const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = (pg.pages.health as any).verification?.checkedOn;
const p = profile(pg.iso3);
const st = (id: string) => stat(p, 'health', id);
const s = econData(pg.iso3).series;
const v = (k: keyof typeof s, y: number) => valueIn(s[k], y)!;

const u5 = st('u5'), mat = st('maternal'), doc = st('doctors'), hGdp = st('healthGdp'), hPc = st('healthPc'), oop = st('oop');
const measles = st('measles'), stunt = st('stunting'), hunger = st('undernour'), tob = st('tobacco'), diab = st('diabetes');
const U = u5.year!;

assertClaim(fromTop(diab) === 9 && Number(diab.value) > 22, 'ninth-highest diabetes, over a fifth of adults');
// tobacco use: countries where the 2024 estimate is above the 2000 one (our count)
const both = (econIndex.economies as any[]).map((e) => new Map(econData(e.iso3).series.tobaccoPct)).filter((m) => m.has(2000) && m.has(2024));
const rose = both.filter((m) => m.get(2024)! > m.get(2000)!).length;
const tob00 = v('tobaccoPct', 2000);
const tobRising = s.tobaccoPct.every(([, x], i, a) => i === 0 || x > a[i - 1][1]);
assertClaim(tobRising && rose === 18 && both.length > 150 && tob.year === 2024, 'tobacco estimate higher at every step since 2000; one of 18 countries with a rise');
assertClaim(fromTop(oop) === 21 && Number(oop.value) > 55, 'households pay over 55%, 21st');
const m19 = v('maternalMortality', 2019), m21 = v('maternalMortality', 2021);
assertClaim(mat.year === 2023 && m21 > 2 * m19 && Number(mat.value) < m19, 'maternal ratio more than doubled by 2021, now below 2019');
const u5_90 = v('under5Mortality', 1990), st00 = v('stuntingPct', 2000);
assertClaim(U === 2024 && Number(u5.value) < u5_90 / 3.5 && Number(stunt.value) < st00 * 0.55, 'under-five below 1/3.5 of 1990; stunting roughly halved');
const h19 = v('undernourishedPct', 2019);
assertClaim(Number(hunger.value) > h19 + 1.5 && Number(measles.value) === 97, 'undernourishment up 1.5+ points since 2019; measles 97%');

const title = `Egypt Health Statistics ${U}: Diabetes, Rising Tobacco Use, Costs | AtlasFigures`;
const description = `Diabetes affects ${diab.text} of Egypt's adults (${diab.year}), the world's ninth-highest prevalence. Tobacco use rose to ${tob.text}, one of only ${rose} countries where it climbed since 2000; households pay ${oop.text} of health costs.`;

const faq = [
  { q: 'Is Egypt among the most diabetic countries?', a: `Yes: more than one adult in five (${diab.text}, ${diab.year}) on International Diabetes Federation estimates, ${ordinal(fromTop(diab))} of ${diab.of}.` },
  { q: 'Has child mortality in Egypt fallen?', a: `Sharply: the UN IGME series falls from ${u5_90} in 1990 to ${u5.text} in ${U} (deaths before age five, per thousand births).` },
  { q: 'What is Egypt\'s doctor density?', a: `The WHO workforce data give ${doc.text} physicians per 1,000 Egyptians for ${doc.year}, the latest year available.` },
  { q: 'Is Egypt\'s health budget large?', a: `Modest: ${hGdp.text} of GDP in ${hGdp.year}, roughly ${hPc.text} for each Egyptian.` },
];
const headline = `Egypt health ${U}: diabetes, tobacco, out-of-pocket costs and maternal deaths`;
---
<HealthTopic
  pg={pg}
  title={title}
  description={description}
  h1="Egypt's health: diabetes, tobacco and the bills patients pay"
  headline={headline}
  tableTitle={`Egypt's health statistics by year, 1990–${U}`}
  tableSubtitle="Selected years to scan; download the CSV for Egypt's complete annual data."
  faq={faq}
  faqTitle="Egypt health: in short"
  related={[
    { href: '/country/egypt/', label: 'Egypt in numbers' },
    { href: '/country/egypt/population/', label: 'Egypt population and life expectancy' },
    { href: '/country/turkey/health/', label: 'Turkey health' },
    { href: '/country/iran/health/', label: 'Iran health' },
    { href: '/rankings/child-mortality-by-country/', label: 'Child mortality, every country ranked' },
  ]}
>
  <Fragment slot="answer">Diabetes touched <strong>{diab.text} of Egypt's adults</strong> in {diab.year}; only {fromTop(diab) - 1} countries had a higher share. Tobacco use has risen to {tob.text} of adults, and households paid <strong>{oop.text}</strong> of Egypt's health spending themselves in {oop.year}.</Fragment>
  <div class="story-block prose">
    <h2>How many Egyptians have diabetes?</h2>
    <p>More than one adult in five, {diab.text} in {diab.year}. That puts Egypt {ordinal(fromTop(diab))} on the International Diabetes Federation's list of {diab.of} places.</p>
  </div>
  <div class="story-block prose">
    <h2>Is smoking increasing in Egypt?</h2>
    <p>Yes. Each WHO estimate since 2000 has been higher than the one before, from {pct(tob00)} of adults to {tob.text} in {tob.year}. Of the {both.length} countries with figures for both years, Egypt is one of just {rose} where tobacco use went up (our count).</p>
  </div>
  <LineChart
    title={`Tobacco use in Egypt, 2000–${tob.year}`}
    subtitle="Egyptian adults (15+) who smoke or use smokeless tobacco, WHO global estimates, percent."
    points={s.tobaccoPct.map(([x, y]) => ({ x, y }))}
    format="percent"
    highlight={tob.year!}
    estimateLabel="World Bank data"
    source={WDI}
    sourceUrl={WDI_URL}
    checkedOn={checkedOn}
  />
  <div class="story-block prose">
    <h2>How much of Egypt's health bill falls on patients?</h2>
    <p>More than half: {oop.text} in {oop.year} by WHO estimates, higher than in all but {fromTop(oop) - 1} countries. Total health spending was {hGdp.text} of GDP, or {hPc.text} a person.</p>
  </div>
  <div class="story-block prose">
    <h2>How have Egyptian children and mothers fared?</h2>
    <p>Mostly better. Egypt cut its under-five rate from {u5_90} (1990) to {u5.text} ({U}) and child stunting from {pct(st00)} (2000) to {stunt.text} ({stunt.year}). Maternal deaths more than doubled between 2019 ({m19} per 100,000 births) and 2021 ({m21}) before dropping to {mat.text} in {mat.year}. Undernourishment, though, has edged up to {hunger.text} ({hunger.year}) from {pct(h19)} in 2019. Measles vaccination stands at {measles.text}.</p>
  </div>
  <LineChart
    title={`Egypt: deaths before the fifth birthday, 1990–${U}`}
    subtitle="Child mortality before age five in Egypt, per 1,000 live births (UN IGME)."
    points={s.under5Mortality.filter(([y]) => y >= 1990).map(([x, y]) => ({ x, y: Number(y.toFixed(1)) }))}
    format="plain"
    unit="per 1,000 live births"
    highlight={U}
    estimateLabel="World Bank data"
    source={WDI}
    sourceUrl={WDI_URL}
    checkedOn={checkedOn}
  />
</HealthTopic>
