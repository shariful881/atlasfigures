---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import bj from '../../../data/countries/benin.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fertility above 2.1 in every UN year to 2100;
// a 1950 sex ratio of 88.3 men per 100 women turning into a male majority from 2017 to 2067; an urban majority since 2021
// and one of the fastest urban rises to 2050; a 22-place climb by 2100; the 1993–1994 swing in net migration.
// Capitals cited from Britannica. Counts only.
const PAGE = '/country/benin/population/';
const un = countryData(bj.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (bj.verification as any).checkedOn as string | undefined;
const BRIT_URL = 'https://www.britannica.com/place/Benin';
const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
assertClaim(un.years.every((r) => r.fertility > 2.1), 'fertility above 2.1 every year 1950–2100');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1981, 'fertility high 1981');
const menYears = un.years.filter((r) => r.male > r.female).map((r) => r.year);
assertClaim(menYears[0] === 2017 && menYears[menYears.length - 1] === 2067 && menYears.length === 51, 'more men than women 2017–2067 only');
assertClaim((y[1950].male / y[1950].female) * 100 < 88.5, '88.3 men per 100 women in 1950');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
const rise = (d: any) => (at(d, 2050).urbanPct ?? 0) - (at(d).urbanPct ?? 0);
assertClaim(urbanHalf === 2021 && [...big].sort((a: any, b: any) => rise(b) - rise(a)).map((d: any) => d.iso3).indexOf('BEN') === 2, 'urban majority 2021; third-largest urban rise to 2050 among countries of ten million or more');
const climb = c.worldRank! - y[2100].worldRank!;
assertClaim(climb === 22, '22-place climb by 2100');
const waf = (n: number) => wpp.filter((d: any) => d.subregion === 'Western Africa').sort((a: any, b: any) => at(b, n).population - at(a, n).population).map((d: any) => d.iso3).indexOf('BEN');
assertClaim(waf(CURRENT_YEAR) === 8 && waf(2100) === 7, 'ninth in Western Africa now, eighth by 2100');
const wafBig = big.filter((d: any) => d.subregion === 'Western Africa');
assertClaim([...wafBig].sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 3).map((d: any) => d.iso3).join() === 'NGA,GHA,BEN', 'third-densest large Western African country');
assertClaim(y[1993].netMigrants > 150000 && y[1994].netMigrants < -80000, '1993 inflow, 1994 outflow');
const inTop = un.years.reduce((a, b) => (b.netMigrants > a.netMigrants ? b : a));
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(inTop.year === 1993 && outTop.year === 1994, 'largest inflow 1993, largest outflow 1994');
assertClaim(un.years.every((r, i, a) => i === 0 || r.population > a[i - 1].population) && y[2100].population > y[2099].population, 'rises every year, still growing in 2100');
const times = c.population / y[1950].population;
assertClaim(times > 6.6 && times < 6.8, 'about 6.7 times 1950');
assertClaim(c.births > 3 * c.deaths, 'births more than three times deaths');

const title = `Benin ${CURRENT_YEAR}: ${(c.population / 1e6).toFixed(1)}M People, Fertility Above Replacement to 2100 | AtlasFigures`;
const description = `Beninese women average ${dec(c.fertility, 2)} births, a rate the UN keeps above 2.1 through 2100, in a nation of ${millions(c.population)} (${CURRENT_YEAR}). Men now outnumber women, and most Beninese have been urban since 2021.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Official capital', value: bj.capital },
    { label: 'Seat of government', value: 'Cotonou' },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Urban', value: pct(c.urbanPct!) },
  { label: 'In 2100', value: millionsShort(y[2100].population) },
];

const rows = displayRows(un.years, bj.tableYears);

const faq = [
  { q: 'Is Porto-Novo or Cotonou the capital of Benin?', a: 'Porto-Novo is the official capital; Encyclopaedia Britannica describes Cotonou, the largest city, as the de facto administrative capital.' },
  { q: 'Will fertility in Benin fall below 2.1?', a: `Not in the UN projection: the rate, ${dec(c.fertility, 2)} now, is still ${dec(y[2100].fertility, 2)} in 2100.` },
  { q: 'Are there more men or women in Benin?', a: `Slightly more men since 2017 (${dec((c.male / c.female) * 100, 1)} per 100 women in ${CURRENT_YEAR}); in 1950 the ratio was ${dec((y[1950].male / y[1950].female) * 100, 1)}. The UN projects a male majority until 2067.` },
  { q: 'Is Benin now a mainly urban country?', a: `Yes, since ${urbanHalf}: ${pct(c.urbanPct!)} by the national definition, with ${pct(y[2050].urbanPct!)} projected for 2050.` },
  { q: 'What is Benin\'s projected population for 2100?', a: `${millions(y[2100].population)}, and rising, under the UN's medium assumptions; Benin would move up from ${ord(c.worldRank!)} to ${ord(y[2100].worldRank!)} in the world.` },
];

const schema = countrySchema({
  page: PAGE, slug: bj.slug, name: bj.name, wikipedia: bj.wikipedia,
  headline: `Benin's ${millions(c.population)}: fertility above 2.1 to 2100, a male majority since 2017 and fast urban growth`,
  description,
  datasetName: 'Benin population, fertility and sex ratio, 1950–2100',
  datasetDescription: `Mid-year population of Benin for selected years from 1950 to ${CURRENT_YEAR} (1993, 1994, 2017 and 2021 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: bj.published, updated: bj.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  extraCitations: [{ name: 'Benin', url: BRIT_URL, publisher: 'Encyclopaedia Britannica' }],
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Benin"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Benin", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Benin: fertility that stays above replacement all century</h1>
        <LiveCounter
          label="Benin: estimated number of people now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: mid-${CURRENT_YEAR} total, with roughly ${int(c.change / 365)} added each day`}
        />
        <p class="answer">
          In the UN's projection Benin's fertility never falls below 2.1: it is <strong>{dec(c.fertility, 2)}</strong> births per woman today and {dec(y[2100].fertility, 2)} in 2100. Its <strong>{millions(c.population)}</strong> inhabitants ({CURRENT_YEAR}) keep increasing right up to 2100.
        </p>
        <div class="dates"><span>Updated <time datetime={bj.updated}>{longDate(bj.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Benin" code="bj" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Will Benin's birth rate ever drop below replacement?</h2>
          <p>Not before 2100 on the UN's central path. Fertility has eased to {dec(c.fertility, 2)} from {dec(tfrTop.fertility, 2)} in {tfrTop.year}, and the 2100 projection is {dec(y[2100].fertility, 2)}. Births this year should outnumber deaths by more than three to one, about {int(Math.round(c.births / 1000))} thousand to {int(Math.round(c.deaths / 1000))} thousand.</p>
        </div>
        <LineChart
          title="Benin's fertility rate, 1950–2050"
          subtitle="UN births per woman, with the medium variant dashed; the 2.1 line is never crossed."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'replacement 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why did Benin go from a female to a male majority?</h2>
          <p>The UN data show the shift but not its cause. The 1950 ratio was {dec((y[1950].male / y[1950].female) * 100, 1)} men to 100 women; males have outnumbered females since 2017, at {dec((c.male / c.female) * 100, 1)} per 100 this year, and the projection keeps them ahead until 2067. Migration swung sharply in the early 1990s: an inflow near {int(Math.round(inTop.netMigrants / 1000))} thousand in {inTop.year}, the most on record, and net departures near {int(Math.round(-outTop.netMigrants / 1000))} thousand in {outTop.year}.</p>
        </div>

        <div class="story-block prose">
          <h2>How quickly is Benin urbanising?</h2>
          <p>Fast. Just {pct(y[1950].urbanPct!)} of Beninese were urban in 1950; since {urbanHalf} they have been a majority, now {pct(c.urbanPct!)}. The 2050 figure in World Urbanization Prospects, {pct(y[2050].urbanPct!)}, implies the third-biggest rise among nations above ten million. Its density of {int(c.densityPerKm2)} per km² is higher than in any big Western African state except Nigeria and Ghana.</p>
        </div>

        <div class="story-block prose">
          <h2>Where does Benin rank, now and in 2100?</h2>
          <p>{ord(c.worldRank!)} in the world and ninth in Western Africa today, its population {dec(times, 1)}-fold that of 1950. As the projection rises past {millions(y[2050].population)} in 2050 toward {millions(y[2100].population)} in 2100, Benin climbs to {ord(y[2100].worldRank!)} globally and eighth in its subregion. Porto-Novo is the official capital; Britannica calls Cotonou, the largest city, the de facto administrative capital.</p>
        </div>
        <LineChart
          title="Benin's population, 1950 to 2100"
          subtitle="UN mid-year figures rising every year; the projected section is dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={bj.iso3} name={bj.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Benin in selected years: the 1990s swing, the 2017 shift, the 2021 urban majority"
          subtitle="Net migration flips sign from 1993 to 1994; 2017 is the first row with more men."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${bj.slug}-population.csv`)}
          csvName={`${bj.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Benin: questions on population</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{bj.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
            <li><a href={BRIT_URL}>Encyclopaedia Britannica, "Benin"</a>: Porto-Novo as official capital; Cotonou as largest city and de facto administrative capital.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={bj.published}>{longDate(bj.published)}</time> · Updated <time datetime={bj.updated}>{longDate(bj.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Benin population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Benin" code="bj" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
