---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import lva from '../../../data/countries/latvia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: peak 1989 (2.66 million), now about 69% of
// it, the second-largest fall from its own peak among 1M+ countries (after Moldova); the second-farthest below its
// 1950 level (after Bulgaria); a fall in every year 1990–2022, a rise in 2023; net departures every year 1989–2021,
// the most in 1992; natural decrease every year from 1992 to 2100; 86.8 men per 100 women (fifth-lowest).
const PAGE = '/country/latvia/population/';
const un = countryData(lva.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (lva.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 1989 && c.population / peak.population > 0.68 && c.population / peak.population < 0.7, 'peak 1989, about 69% left');
const v1 = wpp.filter((d: any) => at(d).population >= 1e6);
const fromTop = (d: any) => at(d).population / Math.max(...d.years.filter((r: any) => r.year <= CURRENT_YEAR).map((r: any) => r.population));
assertClaim([...v1].sort((a: any, b: any) => fromTop(a) - fromTop(b)).slice(0, 2).map((d: any) => d.iso3).join() === 'MDA,LVA', 'second-largest fall from peak');
assertClaim([...v1].sort((a: any, b: any) => at(a).population / at(a, 1950).population - at(b).population / at(b, 1950).population).slice(0, 2).map((d: any) => d.iso3).join() === 'BGR,LVA' && c.population < y[1950].population, 'second-farthest below 1950');
assertClaim(un.years.filter((r) => r.year >= 1990 && r.year <= 2022).every((r) => r.population < y[r.year - 1].population) && y[2023].population > y[2022].population, 'falls 1990–2022, rise 2023');
assertClaim(un.years.filter((r) => r.year >= 1989 && r.year <= 2021).every((r) => r.netMigrants < 0) && y[2022].netMigrants > 0, 'net departures 1989–2021');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1992, 'largest outflow 1992');
assertClaim(un.years.filter((r) => r.year >= 1992).every((r) => r.naturalChange < 0) && y[1991].naturalChange >= 0, 'natural decrease from 1992');
const sr = (d: any) => at(d).male / at(d).female;
assertClaim([...v1].sort((a: any, b: any) => sr(a) - sr(b)).findIndex((d: any) => d.iso3 === 'LVA') === 4, 'fifth-lowest sex ratio');

const title = `Latvia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Shrunk Below Its 1950 Total Since a 1989 Peak | AtlasFigures`;
const description = `Latvia's mid-${CURRENT_YEAR} population, as estimated by the UN: ${millions(c.population)}. That trails the 1950 total and is roughly 69% of the 1989 high. Annual totals slid from 1990 through 2022, and burials have outpaced births annually after 1991.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: lva.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Men per 100 women', value: dec((c.male / c.female) * 100, 1) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
];

const rows = displayRows(un.years, lva.tableYears);

const faq = [
  { q: 'Is Latvia smaller today than in 1950?', a: `It is: ${millions(c.population)} now, ${millions(y[1950].population)} then. Among nations past a million, only Bulgaria has dropped further below its 1950 level.` },
  { q: "How large was Latvia at its 1989 summit?", a: `${millions(peak.population)}, in 1989. Roughly 69% of that remains, the second-deepest proportional loss after Moldova among million-plus nations.` },
  { q: 'For how many years did Latvia shrink in a row?', a: `33, from 1990 through 2022. In 2023 the total ticked up, then the decline resumed.` },
  { q: 'Which year saw the heaviest net emigration from Latvia?', a: `1992: ${int(-outTop.netMigrants)}, inside a run of outflows lasting from 1989 to 2021. The UN data list no motives.` },
  { q: 'Does Latvia have a female majority?', a: `A clear one, with ${dec((c.male / c.female) * 100, 1)} males counted per 100 females by the UN, the fifth-smallest of any nation over one million.` },
];

const schema = countrySchema({
  page: PAGE, slug: lva.slug, name: lva.name, wikipedia: lva.wikipedia,
  headline: `Latvia's ${millions(c.population)}: below its 1950 size; about 69% of the 1989 peak; falls in every year 1990–2022`,
  description,
  datasetName: 'Latvia population, net migration and natural change, 1950–2100',
  datasetDescription: `Mid-year population of Latvia for selected years from 1950 to ${CURRENT_YEAR}, including 1959, 1987–1994 and 2020–2024, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: lva.published, updated: lva.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Latvia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Latvia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Latvia: fewer inhabitants today than in 1950</h1>
        <LiveCounter
          label="Latvia: latest modelled headcount"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Ticks on from the UN World Population Prospects 2024 mid-${CURRENT_YEAR} figure, about ${int(-c.change / 365)} lower with each day`}
        />
        <p class="answer">
          UN estimates have Latvia at <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, fewer than the <strong>{millions(y[1950].population)}</strong> of 1950 and well short of 1989's high.
        </p>
        <div class="dates"><span>Updated <time datetime={lva.updated}>{longDate(lva.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Latvia" code="lv" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Latvia's population smaller than in 1950?</h2>
          <p>The UN figures trace how, not why. Residents climbed to {millions(peak.population)} in 1989, then declined in every one of the 33 years from 1990 to 2022, ending below the 1950 level of {millions(y[1950].population)}. Only Bulgaria, among nations past a million, sits further under its 1950 mark; only Moldova has lost a larger share of its own peak.</p>
        </div>
        <LineChart
          title="Latvia, 1950–2100: a 1989 summit and a long slope"
          subtitle="People at mid-year; UN projection drawn dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How many Latvians left on balance?</h2>
          <p>Outflows exceeded inflows every year from 1989 to 2021; 1992 was the heaviest, at {int(-outTop.netMigrants)}. Small net arrivals in 2022 and 2023 coincide with the one rise, in 2023. The UN tables give the counts only.</p>
        </div>

        <div class="story-block prose">
          <h2>Have Latvian deaths exceeded births for long?</h2>
          <p>They have, in each year from 1992, a pattern expected to persist until 2100; for {CURRENT_YEAR} the UN estimates {int(c.deaths)} deaths set against {int(c.births)} births. Women clearly outnumber men (a ratio of {dec((c.male / c.female) * 100, 1)} to 100), fifth-lowest among million-plus nations. Projected totals: {millions(y[2050].population)} come 2050, {int(Math.round(y[2100].population / 1e3))} thousand by 2100.</p>
        </div>
        <RelatedPages iso3={lva.iso3} name={lva.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Latvia rows: 1959, 1987–1994, 2020–2024, every tenth year"
          subtitle="Each row from 1990 to 2022 is below the one before; 2023 edges up."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${lva.slug}-population.csv`)}
          csvName={`${lva.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Latvia: short UN-based answers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{lva.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={lva.published}>{longDate(lva.published)}</time> · Updated <time datetime={lva.updated}>{longDate(lva.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Latvia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Latvia" code="lv" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
