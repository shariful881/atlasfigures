---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import gt from '../../../data/countries/guatemala.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the youngest median age in Latin America and the
// Caribbean (countries of a million or more) and the biggest fertility fall there since 2000; net emigration in every UN
// year from 1964 to 2100; an urban share that slipped from 1973 to 1981 before an urban majority in 2008; a projected peak
// in 2077. Counts only; the UN files give no causes.
const PAGE = '/country/guatemala/population/';
const un = countryData(gt.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (gt.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const lat = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
assertClaim([...lat].sort((a: any, b: any) => at(a).medianAge - at(b).medianAge).slice(0, 4).map((d: any) => d.iso3).join() === 'GTM,HTI,HND,BOL', 'youngest median age across Latin America and the Caribbean (1 million+), then Haiti, Honduras, Bolivia');
const drop = (d: any) => at(d, 2000).fertility - at(d).fertility;
assertClaim([...lat].sort((a: any, b: any) => drop(b) - drop(a))[0].iso3 === 'GTM', 'largest fertility fall since 2000 in the region (1 million+)');
const under = un.years.find((r) => r.fertility < 2.1)!.year;
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(under === 2032 && tfrTop.year === 1957, 'fertility high 1957; under 2.1 from 2032');
assertClaim(un.years.filter((r) => r.year >= 1964).every((r) => r.netMigrants < 0) && y[1963].netMigrants >= 0, 'net emigration every year from 1964');
const outTop = un.years.filter((r) => !r.projection).reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 2000, 'largest net outflow 2000');
const cam = wpp.filter((d: any) => d.subregion === 'Central America');
assertClaim([...cam].sort((a: any, b: any) => at(b).population - at(a).population).slice(0, 2).map((d: any) => d.iso3).join() === 'MEX,GTM', 'second in Central America after Mexico');
assertClaim([...cam].filter((d: any) => at(d).population >= 1e6).sort((a: any, b: any) => at(b).densityPerKm2 - at(a).densityPerKm2).slice(0, 2).map((d: any) => d.iso3).join() === 'SLV,GTM', 'second-densest in Central America after El Salvador');
const urbTop = un.years.filter((r) => r.year < 1980 && r.urbanPct != null).reduce((a, b) => (b.urbanPct! > a.urbanPct! ? b : a));
const urbLow = un.years.filter((r) => r.year >= 1970 && r.year <= 2000 && r.urbanPct != null).reduce((a, b) => (b.urbanPct! < a.urbanPct! ? b : a));
const urbBack = un.years.find((r) => r.year > urbLow.year && r.urbanPct != null && r.urbanPct > urbTop.urbanPct!)!.year;
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbTop.year === 1973 && urbLow.year === 1981 && urbBack === 1996 && urbanHalf === 2008, 'urban share 1973 high, 1981 low, back in 1996, majority 2008');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2077, 'peak 2077');
assertClaim(y[2021].lifeExpectancy < y[2019].lifeExpectancy - 3 && un.years.find((r) => r.year > 2019 && r.lifeExpectancy > y[2019].lifeExpectancy)!.year === 2023, 'life expectancy dip 2020–2021, above 2019 again in 2023');
const times = c.population / y[1950].population;
assertClaim(times > 6 && times < 6.2, 'about six times 1950');

const title = `Latin America's Youngest Population: Guatemala in ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M) | AtlasFigures`;
const description = `Of Guatemala's ${millions(c.population)} inhabitants in ${CURRENT_YEAR}, half are under ${dec(c.medianAge, 1)}, the lowest median across Latin America and the Caribbean; fertility, ${dec(c.fertility, 2)}, has fallen fastest there since 2000.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: gt.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Peak year', value: String(peak.year) },
];

const rows = displayRows(un.years, gt.tableYears);

const faq = [
  { q: 'Is Guatemala the youngest country in Latin America?', a: `Among countries of a million or more people, yes: the median Guatemalan is ${dec(c.medianAge, 1)} in ${CURRENT_YEAR}, younger than in Haiti, Honduras or Bolivia.` },
  { q: 'How fast is fertility falling in Guatemala?', a: `The rate has gone from ${dec(y[2000].fertility, 2)} (2000) to ${dec(c.fertility, 2)}, the steepest drop in the region over that time; the UN projects it under 2.1 from ${under}.` },
  { q: 'Has Guatemala always had net emigration?', a: `Since 1964, yes; departures top arrivals in every UN year through 2100. The biggest estimated net loss came in ${outTop.year}, roughly ${int(Math.round(-outTop.netMigrants / 1000))} thousand on balance; for ${CURRENT_YEAR} it is near ${int(Math.round(-c.netMigrants / 1000))} thousand.` },
  { q: 'Will Guatemala ever shrink?', a: `Slightly, near the end of the century: growth stops in ${peak.year} at ${millions(peak.population)}, and 2100 finishes at ${millions(y[2100].population)}.` },
  { q: 'Is Guatemala more urban or rural?', a: `Urban, narrowly: ${pct(c.urbanPct!)} by the national definition, a majority since ${urbanHalf}.` },
];

const schema = countrySchema({
  page: PAGE, slug: gt.slug, name: gt.name, wikipedia: gt.wikipedia,
  headline: `Guatemala's ${millions(c.population)}: Latin America's youngest median age, the fastest fertility fall and emigration every year since 1964`,
  description,
  datasetName: 'Guatemala population, age and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Guatemala for selected years from 1950 to ${CURRENT_YEAR} (1973, 1981 and 2008 included), with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: gt.published, updated: gt.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Guatemala"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Guatemala", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Guatemala: Latin America's youngest population</h1>
        <LiveCounter
          label="Guatemala: modelled population now"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024: the mid-${CURRENT_YEAR} estimate, up about ${int(c.change / 365)} each day`}
        />
        <p class="answer">
          Among countries of a million or more across Latin America and the Caribbean, none has a lower median age than Guatemala: <strong>{dec(c.medianAge, 1)}</strong> years. At <strong>{millions(c.population)}</strong> people (UN estimate, {CURRENT_YEAR}), it trails only Mexico in Central America.
        </p>
        <div class="dates"><span>Updated <time datetime={gt.updated}>{longDate(gt.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Guatemala" code="gt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Why is Guatemala's population so young?</h2>
          <p>The UN figures pair it with fertility that stayed high for longer than elsewhere in the region: a rate of {dec(y[1990].fertility, 2)} in 1990 and {dec(y[2000].fertility, 2)} in 2000, compared with {dec(c.fertility, 2)} today. That fall since 2000 is the largest across Latin America and the Caribbean among countries above a million, and the UN projects the rate under 2.1 only from {under}. Half the population was under {dec(y[2000].medianAge, 1)} in 2000; the median is {dec(c.medianAge, 1)} now and {dec(y[2050].medianAge, 1)} in the 2050 projection.</p>
        </div>
        <LineChart
          title="Guatemalan fertility, 1950 to 2050"
          subtitle="Guatemala's UN fertility series, highest in the late 1950s; projection dashed; 2.1 marked."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'mark 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Is Guatemala losing population through emigration?</h2>
          <p>Yes, a little each year: the {CURRENT_YEAR} net loss is close to {int(Math.round(-c.netMigrants / 1000))} thousand. From 1964 to 2100 the UN shows departures ahead of arrivals in every single year, most of all in {outTop.year} (near {int(Math.round(-outTop.netMigrants / 1000))} thousand). Natural growth dwarfs it, with {int(Math.round(c.births / 1000))} thousand babies expected against {int(Math.round(c.deaths / 1000))} thousand deaths. The figures are balances and do not record destinations.</p>
        </div>

        <div class="story-block prose">
          <h2>Did Guatemala's urban share ever fall?</h2>
          <p>Yes, briefly. Under the national definition it was {pct(urbTop.urbanPct!)} in {urbTop.year}, then only {pct(urbLow.urbanPct!)} by {urbLow.year}, and was higher again only in {urbBack}. Townspeople have formed the majority since {urbanHalf} and make up {pct(c.urbanPct!)} today. Density, {int(c.densityPerKm2)} per km², is second in Central America after El Salvador among countries above a million.</p>
        </div>
        <div class="age-row" role="group" aria-label="Urban share in Guatemala, national definition">
          <div><span class="y">{urbTop.year}</span><div class="v">{pct(urbTop.urbanPct!)}</div><span class="d">Urban</span></div>
          <div><span class="y">{urbLow.year}</span><div class="v">{pct(urbLow.urbanPct!)}</div><span class="d">Urban</span></div>
          <div><span class="y">{CURRENT_YEAR}</span><div class="v">{pct(c.urbanPct!)}</div><span class="d">Urban</span></div>
        </div>

        <div class="story-block prose">
          <h2>How large will Guatemala grow?</h2>
          <p>The medium variant reaches its high in {peak.year} with {millions(peak.population)}; by 2100 it is a little lower, at {millions(y[2100].population)}. The present count is about {dec(times, 1)}-fold that of 1950. Life expectancy slipped from {dec(y[2019].lifeExpectancy, 1)} in 2019 to {dec(y[2021].lifeExpectancy, 1)} in 2021, recovered by 2023 and is {dec(c.lifeExpectancy, 1)} now.</p>
        </div>
        <LineChart
          title="Guatemala's population, 1950–2100, with a late-century peak"
          subtitle="UN figures for 1 July; the medium variant is dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={gt.iso3} name={gt.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Guatemala year by year, with the 1973, 1981 and 2008 rows"
          subtitle="Compare the urban column for 1973 and 1981; the peak row is 2077."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${gt.slug}-population.csv`)}
          csvName={`${gt.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Guatemala: answers in brief</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{gt.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={gt.published}>{longDate(gt.published)}</time> · Updated <time datetime={gt.updated}>{longDate(gt.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Guatemala population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Guatemala" code="gt" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
