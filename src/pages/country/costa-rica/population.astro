---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import cri from '../../../data/countries/costa-rica.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: the longest life expectancy in Central America;
// fertility from 6.73 (1959) to 1.31, lowest in Central America and third-lowest in Latin America and the Caribbean;
// under 2.1 since 2003; net migration never negative; births peak 1987; a 2044 peak and a 2100 total about 27% lower.
const PAGE = '/country/costa-rica/population/';
const un = countryData(cri.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (cri.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const cam1 = wpp.filter((d: any) => d.subregion === 'Central America' && at(d).population >= 1e6);
assertClaim([...cam1].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy)[0].iso3 === 'CRI', 'longest life expectancy in Central America');
assertClaim([...cam1].sort((a: any, b: any) => at(a).fertility - at(b).fertility)[0].iso3 === 'CRI' && [...cam1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge)[0].iso3 === 'CRI', 'lowest fertility and oldest in Central America');
const lac1 = wpp.filter((d: any) => d.region === 'Latin America and the Caribbean' && at(d).population >= 1e6);
assertClaim([...lac1].sort((a: any, b: any) => at(a).fertility - at(b).fertility).slice(0, 3).map((d: any) => d.iso3).join() === 'PRI,CHL,CRI', 'third-lowest fertility after Puerto Rico and Chile');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(tfrTop.year === 1959 && repl === 2003 && un.years.filter((r) => r.year >= 2003).every((r) => r.fertility < 2.1), 'fertility high 1959, under 2.1 from 2003');
assertClaim(un.years.every((r) => r.netMigrants >= 0), 'net migration never negative');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(birthTop.year === 1987 && peak.year === 2044, 'births peak 1987, population peak 2044');
const ratio = y[2100].population / c.population;
assertClaim(ratio > 0.72 && ratio < 0.74, 'about 73% of today by 2100');
const since = c.population / y[1950].population;
assertClaim(since > 5.5 && since < 5.7, 'about 5.6 times 1950');

const title = `Costa Rica Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Central America's Longest Lives, Lowest Fertility | AtlasFigures`;
const description = `The UN's ${CURRENT_YEAR} figure for Costa Rica: ${millions(c.population)}. Nobody in Central America lives longer (${dec(c.lifeExpectancy, 1)} years) or has fewer children (${dec(c.fertility, 2)} per woman); the count tops out in 2044.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: cri.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
];

const rows = displayRows(un.years, cri.tableYears);

const faq = [
  { q: 'Which Central American country has the longest life expectancy?', a: `Costa Rica, at ${dec(c.lifeExpectancy, 1)} years by UN estimate.` },
  { q: 'Is Costa Rican fertility among the lowest in the region?', a: `${dec(c.fertility, 2)}, from ${dec(tfrTop.fertility, 2)} back in ${tfrTop.year}; region-wide only Puerto Rico and Chile sit lower (nations above a million).` },
  { q: 'Does Costa Rica lose people through emigration?', a: `Never, on balance: the UN's net figure does not dip below zero at any point between 1950 and 2100 (${int(c.netMigrants)} this year).` },
  { q: 'When does growth end in Costa Rica?', a: `In ${peak.year}, at ${millions(peak.population)}; the century closes with ${millions(y[2100].population)}, roughly 27% under today's level.` },
  { q: 'When were the most Costa Ricans born?', a: `In ${birthTop.year}: ${int(birthTop.births)} babies. The ${CURRENT_YEAR} figure is put at ${int(c.births)}.` },
];

const schema = countrySchema({
  page: PAGE, slug: cri.slug, name: cri.name, wikipedia: cri.wikipedia,
  headline: `Costa Rica's ${millions(c.population)}: Central America's longest-lived and lowest-fertility population, peaking in 2044`,
  description,
  datasetName: 'Costa Rica population, fertility and life expectancy, 1950–2100',
  datasetDescription: `Mid-year population of Costa Rica for selected years from 1950 to ${CURRENT_YEAR}, including 1959, 1987, 1996, 2003, 2021 and 2044, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: cri.published, updated: cri.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Costa Rica"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Costa Rica", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Costa Rica: long lives and few births</h1>
        <LiveCounter
          label="Costa Rica: running population estimate"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Based on the UN World Population Prospects 2024 figure for mid-${CURRENT_YEAR}, up near ${int(c.change / 365)} per day`}
        />
        <p class="answer">
          Costa Ricans number <strong>{millions(c.population)}</strong> in {CURRENT_YEAR}, per the UN. They outlive every other Central American nation, at <strong>{dec(c.lifeExpectancy, 1)}</strong> years, and have the subregion's lowest fertility, {dec(c.fertility, 2)}.
        </p>
        <div class="dates"><span>Updated <time datetime={cri.updated}>{longDate(cri.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Costa Rica" code="cr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How did Costa Rican fertility fall so far?</h2>
          <p>The UN series records the fall, not its causes: {dec(tfrTop.fertility, 2)} as the {tfrTop.year} average, {dec(y[1980].fertility, 2)} by 1980, under 2.1 from {repl}, {dec(c.fertility, 2)} today. Region-wide, only Puerto Rico and Chile are lower. Annual births reached their maximum, {int(birthTop.births)}, in {birthTop.year}.</p>
        </div>
        <LineChart
          title="Costa Rica's births per woman, 1950–2050"
          subtitle="Below the 2.1 line from 2003; dashed after 2023."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: 'line 2.1' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why do Costa Ricans outlive their neighbours?</h2>
          <p>The data show the gap, not the reasons: {dec(c.lifeExpectancy, 1)} years of life expectancy, against {dec(y[1950].lifeExpectancy, 1)} in 1950 and below that in every other Central American country today. Costa Rica's median age, {dec(c.medianAge, 1)}, is likewise the subregion's highest.</p>
        </div>

        <div class="story-block prose">
          <h2>Does migration add to or subtract from Costa Rica?</h2>
          <p>It adds, mildly. The net balance is at or above zero across the whole 1950–2100 series, topping out at {int(y[1996].netMigrants)} in 1996; for {CURRENT_YEAR} it is {int(c.netMigrants)}.</p>
        </div>

        <div class="story-block prose">
          <h2>What comes after Costa Rica's 2044 peak?</h2>
          <p>A long decline. After a 5.6-fold rise since 1950 Costa Rica's count is highest in {peak.year} ({millions(peak.population)}), then shrinks to {millions(y[2100].population)} at the century's close, about 27% under today.</p>
        </div>
        <RelatedPages iso3={cri.iso3} name={cri.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Costa Rica, decades plus 1959, 1987, 2003 and 2044"
          subtitle="Fertility drops under 2.1 in the 2003 row; the total peaks in 2044."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${cri.slug}-population.csv`)}
          csvName={`${cri.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Costa Rica, by the numbers</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{cri.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={cri.published}>{longDate(cri.published)}</time> · Updated <time datetime={cri.updated}>{longDate(cri.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Costa Rica population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Costa Rica" code="cr" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
