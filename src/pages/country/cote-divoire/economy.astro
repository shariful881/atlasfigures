---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LineChart from '../../../components/LineChart.astro';
import EconTable from '../../../components/EconTable.astro';
import IndicatorCards from '../../../components/IndicatorCards.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import c from '../../../data/economy/cote-divoire.json';
import { econData, econMeta, valueIn, rankBy, usd, usdWhole, intDollars, signedPct } from '../../../lib/econ';
import { econBasics, econSchema } from '../../../lib/econPage';
import { assertClaim, pct, ord } from '../../../lib/figures';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/).
const PAGE = '/country/cote-divoire/economy/';
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = c.verification?.checkedOn;
const B = econBasics(c.iso3, c.tableYears);
const { s, L, v, gdp, perHead, growth, ppp, infl, unemp, rem, remPct, net, share } = B;
const g = (y: number) => v('gdpGrowthPct', y)!;
const i = (y: number) => v('inflationPct', y)!;
const u = (y: number) => v('unemploymentPct', y)!;
const ssa = rankBy('gdp', L).filter((r) => r.region === 'Sub-Saharan Africa');
const sPos = ssa.findIndex((r) => r.iso3 === c.iso3);
const isMax = (arr: [number, number][]) => arr.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L;
const lowInflSince = Math.max(...s.inflationPct.filter(([y, x]) => y < L && x < infl.value).map(([y]) => y));
const sixPlus = [2021, 2022, 2023, 2024, L].every((y) => g(y) >= 6);
const worst = s.gdpGrowthPct.reduce((a, b) => (b[1] < a[1] ? b : a));
const lastNeg = Math.max(...s.gdpGrowthPct.filter(([, x]) => x < 0).map(([y]) => y));
const gdpX = Math.round(gdp / v('gdp', 2000)!);
const remX = Math.round(rem!.value / v('remittances', 2020)!);

assertClaim(isMax(s.gdp) && isMax(s.gdpPerCapita) && sPos === 6 && ssa[sPos - 1].iso3 === 'GHA' && B.gdpRank === 76 && gdp < 1e11 && gdp > 99.5e9, 'record GDP just under $100bn; 7th in SSA after Ghana; 76th');
assertClaim(sixPlus && Math.abs(growth - 6.5) < 0.01, 'growth at least 6% every year since 2021');
assertClaim(lowInflSince === 1990 && infl.value < 0.2, 'inflation lowest since 1990');
assertClaim(worst[0] === 1980 && worst[1] < -10.9 && lastNeg === 2011, 'worst 1980; last contraction 2011');
assertClaim(gdpX === 6 && i(1990) < 0 && i(2022) > 5, 'GDP 6x 2000; prices fell in 1990');
assertClaim(rem!.year === L - 1 && s.remittances.at(-1)![0] === L - 1 && s.remittances.reduce((a, b) => (b[1] > a[1] ? b : a))[0] === L - 1 && remX === 5, 'remittances 2024 record, about 5x 2020');

const title = `Côte d\'Ivoire Economy ${L}: Nearly a Hundred Billion Dollars, Prices Flat | AtlasFigures`;
const description = `A fifth straight year of 6%-plus growth lifted Côte d\'Ivoire\'s output to ${usd(gdp)} in ${L}. Inflation was only ${pct(infl.value)}, the lowest since 1990.`;

const faq = [
  { q: 'Is Côte d\'Ivoire a hundred-billion-dollar economy yet?', a: `Not quite. Its ${L} output, ${usd(gdp)}, was the largest so far. It ranks ${ord(sPos + 1)} in sub-Saharan Africa, after Ghana, and ${ord(B.gdpRank!)} in the world.` },
  { q: 'Is Côte d\'Ivoire one of Africa\'s fastest-growing economies?', a: `It has grown by at least 6% a year since 2021: ${pct(g(2021))}, ${pct(g(2022))}, ${pct(g(2023))}, ${pct(g(2024))} and ${pct(growth)} in ${L}.` },
  { q: 'Are prices in Côte d\'Ivoire still rising?', a: `Hardly: ${pct(infl.value)} in ${L}, down from ${pct(i(L - 1))}. To find a smaller figure you have to go back to 1990, a year when prices actually fell.` },
  { q: 'When did the Ivorian economy last contract?', a: `In 2011, when GDP fell ${pct(Math.abs(g(2011)))}. The sharpest drop on record was ${pct(Math.abs(worst[1]))} in 1980.` },
  { q: 'Are remittances to Côte d\'Ivoire increasing?', a: `Yes, sharply. ${rem!.year} — the newest year in the data — brought ${usd(rem!.value)}, the most ever, roughly ${remX}-fold their 2020 level.` },
];
const schema = econSchema({
  page: PAGE, slug: c.slug, name: c.name, wikipedia: c.wikipedia, L, published: c.published, updated: c.updated, description, faq,
  headline: `Côte d'Ivoire's economy in ${L}: steady 6%-plus growth and near-zero inflation`,
});
---
<Base
  title={title} description={description} section="economy" appTitle="Ivorian economy" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: "Côte d'Ivoire", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Côte d'Ivoire's economy: steady growth, steady prices</h1>
        <p class="answer">
          Côte d'Ivoire grew <strong>{pct(growth)}</strong> in real terms during {L}; at <strong>{usd(gdp)}</strong> its GDP has never been higher, and inflation was almost nil at {pct(infl.value)}.
        </p>
        <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
        <IndicatorCards label={`Côte d'Ivoire economy, ${L}`} cards={B.cards} />
        <KeyFacts variant="mobile" country="Côte d'Ivoire" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <p class="answer lead">Five years of 6%-plus growth have brought Côte d'Ivoire to the edge of a hundred-billion-dollar economy.</p>

        <div class="story-block prose">
          <h2>How close is Côte d'Ivoire to a hundred-billion-dollar economy?</h2>
          <p>Very close. Ivorian GDP hit {usd(gdp)} for {L}, topping every earlier year — roughly {gdpX}-fold the current-dollar figure for 2000. That makes it the {ord(sPos + 1)}-largest economy in sub-Saharan Africa, one place behind Ghana, and {ord(B.gdpRank!)} worldwide.</p>
        </div>
        <div class="story-block prose">
          <h2>Has Ivorian growth stayed strong?</h2>
          <p>Remarkably steady: real GDP has grown by 6% or more in each of the five years since 2021, with {pct(growth)} recorded in {L}. The economy last contracted in 2011 ({signedPct(g(2011))}).</p>
        </div>
        <LineChart
          title={`Côte d'Ivoire's growth in real output, ${s.gdpGrowthPct[0][0]}–${L}`}
          subtitle="Real GDP growth on the previous year, %."
          points={s.gdpGrowthPct.map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>Are prices rising in Côte d'Ivoire?</h2>
          <p>Barely. The {L} rate of {pct(infl.value)} was the lowest Ivorian reading since 1990. It had reached {pct(i(2022))} in 2022.</p>
        </div>
        <LineChart
          title={`Côte d'Ivoire's annual inflation, 1995–${L}`}
          subtitle="Inflation, consumer prices, % per year."
          points={s.inflationPct.filter(([y]) => y >= 1995).map(([x, y]) => ({ x, y }))}
          format="percent" highlight={L} estimateLabel="World Bank data"
          source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        />
        <div class="story-block prose">
          <h2>What do Ivorians earn and send home?</h2>
          <p>Per person, GDP was {usdWhole(perHead)} in {L}, an Ivorian record ({intDollars(ppp!)} at PPP). Transfers from abroad hit {usd(rem!.value)} in {rem!.year}, and the ILO's modelled jobless rate was {pct(unemp!)}.</p>
        </div>
        <nav class="related" aria-label="Related pages">
          <h2>Côte d'Ivoire and West Africa: related pages</h2>
          <ul>
            <li><a href={path('/country/cote-divoire/population/')}>Côte d'Ivoire's population</a></li>
            <li><a href={path('/country/ghana/economy/')}>Ghana's economy</a></li>
            <li><a href={path('/country/nigeria/economy/')}>Nigeria's economy</a></li>
            <li><a href={path('/country/cameroon/economy/')}>Cameroon's economy</a></li>
            <li><a href={path('/rankings/inflation-rate-by-country/')}>Inflation league table</a></li>
          </ul>
        </nav>
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <EconTable
          id="data-h" title={`Côte d'Ivoire's key indicators over time`}
          subtitle="Ten-year steps from 1960, with 1980 and 2011 added, then annual rows from 2015; all years in the downloadable CSV."
          rows={B.rows} latest={L} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
          csv={path('/data/cote-divoire-economy.csv')} csvName="cote-divoire-economy.csv"
          licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Côte d'Ivoire's economy: common queries</h2>
        <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): GDP and GDP per person (current US$), GDP per person at PPP, GDP growth, inflation (IMF International Financial Statistics), unemployment (modelled ILO estimate), personal remittances received, internet users (ITU). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          </ul>
          <p class="note">Remittances are published to 2024. "Sub-Saharan Africa" is the World Bank region. Dollar figures are in current prices; growth is in constant prices. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Ivorian economy", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>
    <KeyFacts variant="box" country="Côte d'Ivoire" code={c.code} year={L} groups={B.factGroups} highlights={B.highlights} source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
<style>
  .related { margin: 28px 0 8px; padding: 18px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .related h2 { font-size: 1.05rem; margin: 0 0 10px; }
  .related ul { margin: 0; padding-left: 18px; }
  .related li { margin: 6px 0; }
  @media (max-width: 767px) { .related { border: 0; padding: 16px 18px; } }
</style>
