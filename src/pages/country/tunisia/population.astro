---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import tun from '../../../data/countries/tunisia.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: fertility fell below 2.1 in 1999, rose back
// above it in 2011–2019 (high 2014) and fell below again from 2020; one of the four largest fertility falls 1963–2000;
// Africa's highest life expectancy and second-oldest median age (1 million+); men outnumbered women 1970–2009; the
// population peaks in 2051 and deaths overtake births from 2055.
const PAGE = '/country/tunisia/population/';
const un = countryData(tun.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (tun.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const est = un.years.filter((r) => r.year <= CURRENT_YEAR);
const under = est.filter((r) => r.fertility < 2.1).map((r) => r.year);
const run = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
assertClaim(under.join() === [...run(1999, 2010), ...run(2020, CURRENT_YEAR)].join(), 'below 2.1 in 1999–2010 and from 2020');
const rebound = un.years.filter((r) => r.year >= 2011 && r.year <= 2019).reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(rebound.year === 2014 && rebound.fertility > 2.3, 'rebound high 2014 above 2.3');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
assertClaim(tfrTop.year === 1963, 'fertility high 1963');
const fall = (d: any) => at(d, 1963).fertility - at(d, 2000).fertility;
assertClaim([...wpp].sort((a: any, b: any) => fall(b) - fall(a)).map((d: any) => d.iso3).indexOf('TUN') === 3, 'fourth-largest fertility fall 1963–2000');
const af1 = wpp.filter((d: any) => d.region === 'Africa' && at(d).population >= 1e6);
assertClaim([...af1].sort((a: any, b: any) => at(b).lifeExpectancy - at(a).lifeExpectancy)[0].iso3 === 'TUN', 'highest life expectancy in Africa, 1M+');
assertClaim([...af1].sort((a: any, b: any) => at(b).medianAge - at(a).medianAge).slice(0, 2).map((d: any) => d.iso3).join() === 'MUS,TUN', 'second-oldest median age in Africa after Mauritius');
assertClaim([...af1].sort((a: any, b: any) => at(a).fertility - at(b).fertility).slice(0, 2).map((d: any) => d.iso3).join() === 'MUS,TUN', 'second-lowest fertility in Africa after Mauritius');
const menMore = un.years.filter((r) => r.male > r.female).map((r) => r.year);
assertClaim(menMore[0] === 1970 && menMore.filter((n) => n <= 2050).join() === run(1970, 2009).join() && menMore.filter((n) => n > 2050)[0] === 2087, 'men outnumber women 1970–2009, again from 2087');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2051, 'peak 2051');
const natNeg = un.years.find((r) => r.naturalChange < 0)!.year;
assertClaim(natNeg === 2055, 'deaths exceed births from 2055');
const leDip = un.years.filter((r) => r.year >= 2015 && r.year <= CURRENT_YEAR).reduce((a, b) => (b.lifeExpectancy < a.lifeExpectancy ? b : a));
assertClaim(leDip.year === 2021 && y[2022].lifeExpectancy > y[2019].lifeExpectancy, 'life-expectancy dip 2021, above 2019 level by 2022');
const birthTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
const birth2 = un.years.filter((r) => r.year >= 2000).reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(birthTop.year === 1986 && birth2.year === 2014, 'births peak 1986, second high 2014');
const urbanHalf = un.years.find((r) => r.urbanPct != null && r.urbanPct > 50)!.year;
assertClaim(urbanHalf === 1976, 'urban majority 1976');
const naf = wpp.filter((d: any) => d.subregion === 'Northern Africa').sort((a: any, b: any) => at(b).population - at(a).population).map((d: any) => d.iso3);
assertClaim(naf.indexOf('TUN') === 4, 'fifth in Northern Africa');

const title = `Tunisia Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Under 2.1, a 2010s Rebound, Under Again | AtlasFigures`;
const description = `Tunisia had ${millions(c.population)} residents in ${CURRENT_YEAR} on UN figures. Fertility went under 2.1 in 1999, rebounded to ${dec(rebound.fertility, 2)} by 2014 and now sits at ${dec(c.fertility, 2)}, while the medium variant puts the population high in ${peak.year}.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: tun.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Urban', value: pct(c.urbanPct!) },
];

const rows = displayRows(un.years, tun.tableYears);

const faq = [
  { q: "What is Tunisia's birth rate per woman?", a: `${dec(c.fertility, 2)} in ${CURRENT_YEAR}. Of African countries with a million-plus population, only Mauritius is lower, and the rate has stayed beneath 2.1 since 2020.` },
  { q: 'Did fertility in Tunisia go back up?', a: `Yes. After dropping under 2.1 in 1999 it stayed there until 2010, then rose above it from 2011 to 2019, reaching ${dec(rebound.fertility, 2)} in 2014, before falling again.` },
  { q: "In what year will Tunisia have the most people?", a: `${peak.year}: ${millions(peak.population)} is the medium-variant high. From ${natNeg} the projected deaths exceed births each year, leaving ${millions(y[2100].population)} by 2100.` },
  { q: "Is Tunisia's life expectancy the best in Africa?", a: `First among African countries with a million-plus population: ${dec(c.lifeExpectancy, 1)} years by UN estimates, just ahead of Algeria.` },
  { q: 'Does Tunisia have more women or more men?', a: `Women, narrowly: for every 100 Tunisian women this year the UN counts ${dec((c.male / c.female) * 100, 1)} men. Men were the majority every year from 1970 to 2009 and are projected to be again from 2087.` },
];

const schema = countrySchema({
  page: PAGE, slug: tun.slug, name: tun.name, wikipedia: tun.wikipedia,
  headline: `Tunisia's ${millions(c.population)}: fertility under 2.1, a rebound to ${dec(rebound.fertility, 2)} in 2014, and a peak in ${peak.year}`,
  description,
  datasetName: 'Tunisia population and fertility, 1950–2100',
  datasetDescription: `Mid-year population of Tunisia for selected years from 1950 to ${CURRENT_YEAR}, including 1999–2000, 2009–2011, 2014 and 2019–2021, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: tun.published, updated: tun.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Tunisia"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Tunisia", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Tunisia: fertility's round trip around 2.1</h1>
        <LiveCounter
          label="Tunisia: estimated population at this moment"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`UN World Population Prospects 2024 (mid-${CURRENT_YEAR}), with about ${int(c.change / 365)} people added per day`}
        />
        <p class="answer">
          The UN's {CURRENT_YEAR} estimate puts Tunisia at <strong>{millions(c.population)}</strong> people, with <strong>{dec(c.fertility, 2)}</strong> births per woman on average. That figure first slipped under 2.1 in 1999, rose back over it for most of the 2010s and has been beneath it again since 2020.
        </p>
        <div class="dates"><span>Updated <time datetime={tun.updated}>{longDate(tun.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Tunisia" code="tn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>Did Tunisia's fertility go back above 2.1?</h2>
          <p>The UN data record that it did, not why. Fertility slipped to {dec(y[1999].fertility, 2)} in 1999 and held below 2.1 through 2010; from 2011 to 2019 it was above that line again, peaking at {dec(rebound.fertility, 2)} in {rebound.year}. Births followed: {int(birth2.births)} in {birth2.year}, a 21st-century high, though short of the {int(birthTop.births)} recorded in {birthTop.year}. Since 2020 it has stayed under the line, reaching {dec(c.fertility, 2)} today.</p>
        </div>
        <LineChart
          title="Tunisian fertility since 1950, with projections to 2050"
          subtitle="Each crossing of the 2.1 line is visible; values after 2023 come from the medium variant (dashed)."
          points={rows.filter((r) => r.year <= 2050).map((r) => ({ x: r.year, y: r.fertility, projection: r.projection }))}
          unit="births per woman"
          highlight={CURRENT_YEAR}
          refLine={{ y: 2.1, label: '2.1 births' }}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>How steep was Tunisia's fertility decline after 1963?</h2>
          <p>Very steep: from {dec(tfrTop.fertility, 2)} per woman ({tfrTop.year}) to {dec(y[2000].fertility, 2)} in 2000, a fall that just three countries or areas exceeded over that span. Within Africa, counting nations of over a million, Mauritius alone now has lower fertility, and Mauritius alone an older median age than Tunisia's {dec(c.medianAge, 1)}.</p>
        </div>

        <div class="story-block prose">
          <h2>Do Tunisians outlive the rest of Africa?</h2>
          <p>{dec(c.lifeExpectancy, 1)} years at birth: no African country with a population over one million scores higher. The series shows one sharp dip, from {dec(y[2019].lifeExpectancy, 1)} in 2019 to {dec(leDip.lifeExpectancy, 1)} in {leDip.year}, and a return to {dec(y[2022].lifeExpectancy, 1)} the next year. Men outnumbered women from 1970 until 2009; now there are {dec((c.male / c.female) * 100, 1)} of them for every 100 women.</p>
        </div>

        <div class="story-block prose">
          <h2>How big will Tunisia get?</h2>
          <p>Not much bigger. The projection reaches its high, {millions(peak.population)}, in {peak.year}. Deaths then outpace births starting in {natNeg}, and 2100 ends at {millions(y[2100].population)}. Fifth in Northern Africa by population, Tunisia became majority-urban in {urbanHalf} under its national definition and is {pct(c.urbanPct!)} urban now.</p>
        </div>
        <LineChart
          title="Tunisia's population from 1950, with a 2051 peak"
          subtitle="Tunisia's mid-year count, estimated to 2023 and projected after, with the high point in 2051."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />
        <RelatedPages iso3={tun.iso3} name={tun.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Tunisia by year, with the 1999, 2014 and 2020 turning points"
          subtitle="Rows bracket each crossing of 2.1 births per woman and the projected 2051 peak."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${tun.slug}-population.csv`)}
          csvName={`${tun.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Tunisia, briefly: common questions</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{tun.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={tun.published}>{longDate(tun.published)}</time> · Updated <time datetime={tun.updated}>{longDate(tun.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Tunisia population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Tunisia" code="tn" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
