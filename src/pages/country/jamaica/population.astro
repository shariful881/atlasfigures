---
import Base from '../../../layouts/Base.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import LiveCounter from '../../../components/LiveCounter.astro';
import LineChart from '../../../components/LineChart.astro';
import DataTable from '../../../components/DataTable.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import PageTabs from '../../../components/PageTabs.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import jam from '../../../data/countries/jamaica.json';
import { countryData, byYear, displayRows, assertClaim, int, dec, millions, millionsShort, pct, ord, CURRENT_YEAR } from '../../../lib/figures';
import { countrySchema } from '../../../lib/countrySchema';
import { path, longDate, PUBLISHER, reportErrorUrl } from '../../../site';

// Every figure comes from the original UN files (src/data/wpp/). Story: net departures in every year from 1952 to
// 2026 except 2020 (zero), the most in 1967; a peak in 2023 and a decline in every projected year from 2024; 2100 at
// about 38% of today, the third-steepest projected fall of any 1M+ country or area after Hong Kong and Puerto Rico;
// fertility from 5.79 (1964, also the year of most births) to 1.33; fewest births of the series in 2026; deaths
// projected above births from 2034.
const PAGE = '/country/jamaica/population/';
const un = countryData(jam.iso3);
const y = byYear(un.years);
const c = y[CURRENT_YEAR];
const WPP = 'UN World Population Prospects 2024';
const WPP_URL = un.meta.sourceUrl;
const WUP_URL = un.meta.urban.sourceUrl;
const BOTH = `${WPP}; urban share: UN World Urbanization Prospects 2025`;
const checkedOn = (jam.verification as any).checkedOn as string | undefined;

const wpp = Object.values(import.meta.glob('../../../data/wpp/countries/*.json', { eager: true }) as Record<string, any>).map((m) => m.default ?? m);
const at = (d: any, n = CURRENT_YEAR) => d.years.find((r: any) => r.year === n);
const big = wpp.filter((d: any) => at(d).population >= 1e7);
const nm = un.years.filter((r) => r.year >= 1952 && r.year <= CURRENT_YEAR);
assertClaim(nm.filter((r) => r.netMigrants >= 0).map((r) => r.year).join() === '2020' && y[2020].netMigrants === 0, 'net departures 1952–2026 except 2020 (zero)');
const outTop = un.years.reduce((a, b) => (b.netMigrants < a.netMigrants ? b : a));
assertClaim(outTop.year === 1967, 'largest outflow 1967');
const peak = un.years.reduce((a, b) => (b.population > a.population ? b : a));
assertClaim(peak.year === 2023 && un.years.filter((r) => r.year >= 2024).every((r) => r.population < y[r.year - 1].population), 'peak 2023, falls from 2024');
const j1 = wpp.filter((d: any) => at(d).population >= 1e6);
assertClaim([...j1].sort((a: any, b: any) => at(a, 2100).population / at(a).population - at(b, 2100).population / at(b).population).slice(0, 3).map((d: any) => d.iso3).join() === 'HKG,PRI,JAM', 'third-steepest fall to 2100');
assertClaim(y[2100].population / c.population > 0.37 && y[2100].population / c.population < 0.38, 'about 38% of today');
const tfrTop = un.years.reduce((a, b) => (b.fertility > a.fertility ? b : a));
const bTop = un.years.reduce((a, b) => (b.births > a.births ? b : a));
assertClaim(tfrTop.year === 1964 && bTop.year === 1964, 'fertility and births peak 1964');
const bLow = un.years.filter((r) => r.year <= CURRENT_YEAR).reduce((a, b) => (b.births < a.births ? b : a));
assertClaim(bLow.year === CURRENT_YEAR, 'fewest births now');
assertClaim(un.years.find((r) => r.naturalChange < 0)!.year === 2034 && un.years.filter((r) => r.year >= 2034).every((r) => r.naturalChange < 0), 'deaths above births from 2034');
const repl = un.years.find((r) => r.fertility < 2.1)!.year;
assertClaim(repl === 2006 && un.years.filter((r) => r.year >= 2006).every((r) => r.fertility < 2.1), 'under 2.1 from 2006');

const title = `Jamaica Population ${CURRENT_YEAR} (${(c.population / 1e6).toFixed(1)}M): Emigration Since 1952, Past a 2023 Peak | AtlasFigures`;
const description = `Jamaica counts ${millions(c.population)} in ${CURRENT_YEAR}, UN figures show, just below its 2023 high. Departures have outnumbered arrivals in nearly all years from 1952 on. The UN line for 2100 drops to ${millions(y[2100].population)}: the third-sharpest relative fall among million-plus places.`;

const factGroups = [
  { title: 'People', facts: [
    { label: 'Population', value: int(c.population), note: `mid-${CURRENT_YEAR} estimate` },
    { label: 'World rank', value: ord(c.worldRank!) },
    { label: 'Share of world', value: pct(c.worldSharePct) },
    { label: 'Growth per year', value: `${c.growthRatePct >= 0 ? '+' : ''}${pct(c.growthRatePct)}`, note: `${c.change >= 0 ? '+' : ''}${int(c.change)} people` },
  ] },
  { title: 'Land', facts: [
    { label: 'Land area', value: `${int(un.landAreaKm2)} km²` },
    { label: 'People per km²', value: int(c.densityPerKm2) },
    { label: 'Capital', value: jam.capital },
  ] },
  { title: 'Society', facts: [
    { label: 'Median age', value: `${dec(c.medianAge, 1)} years` },
    { label: 'Births per woman', value: dec(c.fertility, 2) },
    { label: 'Life expectancy', value: `${dec(c.lifeExpectancy, 1)} years` },
    { label: 'Living in urban areas', value: pct(c.urbanPct!), note: 'national definition' },
  ] },
];
const highlights = [
  { label: 'Population', value: millionsShort(c.population) },
  { label: 'Births per woman', value: dec(c.fertility, 2) },
  { label: 'Median age', value: dec(c.medianAge, 1) },
  { label: 'Life expectancy', value: dec(c.lifeExpectancy, 1) },
];

const rows = displayRows(un.years, jam.tableYears);

const faq = [
  { q: "Which year was Jamaica's population highest?", a: `In 2023, at ${millions(peak.population)}; every projected year from 2024 is lower.` },
  { q: 'How long has Jamaica had net emigration?', a: `Since 1952, in every year to ${CURRENT_YEAR} apart from 2020, when the UN figure is exactly zero. The largest outflow was ${int(-outTop.netMigrants)} in 1967.` },
  { q: 'How far could Jamaica shrink by 2100?', a: `To ${millions(y[2100].population)}, about 38% of now; only Hong Kong and Puerto Rico face steeper relative falls among places above a million.` },
  { q: 'Jamaican births per woman: then and now?', a: `${dec(c.fertility, 2)} now; it was ${dec(tfrTop.fertility, 2)} in 1964 and slipped beneath 2.1 in 2006.` },
  { q: 'From what year are Jamaican deaths projected to exceed births?', a: `From 2034 in the UN projection; for ${CURRENT_YEAR} the expected births, ${int(c.births)}, mark a low for the whole series from 1950.` },
];

const schema = countrySchema({
  page: PAGE, slug: jam.slug, name: jam.name, wikipedia: jam.wikipedia,
  headline: `Jamaica's ${millions(c.population)}: a 2023 peak; net emigration nearly every year since 1952; a third-steepest projected fall to 2100`,
  description,
  datasetName: 'Jamaica population, net migration and births, 1950–2100',
  datasetDescription: `Mid-year population of Jamaica for selected years from 1950 to ${CURRENT_YEAR}, including 1951–1952, 1964, 1967, 2006 and each year 2019–2025, with UN medium-variant projections to 2100, plus density, total fertility rate, median age, urban share (national definition, to 2050), net migration and world rank.`,
  temporalCoverage: '1950/2100',
  published: jam.published, updated: jam.updated,
  wppUrl: WPP_URL, wupUrl: WUP_URL,
  faq,
});
---
<Base
  title={title}
  description={description}
  section="population"
  appTitle="Jamaica"
  back="/population/"
  miniCounter
  ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Population', href: '/population/' }, { name: "Jamaica", href: PAGE }]}
  schema={schema}
>
  <div class="country">
    <article class="country-main">
      <header class="country-head">
        <h1>Jamaica: a long outflow, a 2023 high, a long decline ahead</h1>
        <LiveCounter
          label="Jamaica: live estimate of residents"
          anchorValue={c.population}
          anchorDate={`${CURRENT_YEAR}-07-01`}
          perYear={c.change}
          note={`Runs from the UN World Population Prospects 2024 value for mid-${CURRENT_YEAR}, slipping by around ${int(-c.change / 365)} daily`}
        />
        <p class="answer">
          At <strong>{millions(c.population)}</strong> for {CURRENT_YEAR}, per UN data, Jamaica sits fractionally below its 2023 high. The projection to 2100 falls to <strong>{millions(y[2100].population)}</strong>.
        </p>
        <div class="dates"><span>Updated <time datetime={jam.updated}>{longDate(jam.updated)}</time></span><SourceBadge source={WPP} url={WPP_URL} checkedOn={checkedOn} /></div>
        <KeyFacts variant="mobile" country="Jamaica" code="jm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
      </header>

      <div class="segments" role="tablist" aria-label="Page sections">
        <button role="tab" aria-selected="true" data-panel="story">Story</button>
        <button role="tab" aria-selected="false" data-panel="data">Data</button>
        <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
      </div>

      <section class="panel" data-panel="story" aria-label="The story">
        <div class="story-block prose">
          <h2>How long have Jamaicans been leaving on balance?</h2>
          <p>Almost without pause since 1952: up to {CURRENT_YEAR}, every year but 2020 (recorded as zero) shows more departures than arrivals. The heaviest year was 1967, at {int(-outTop.netMigrants)} net; {CURRENT_YEAR} expects {int(-c.netMigrants)}. Only 1950 and 1951 lean the other way. Reasons do not appear in the UN data.</p>
        </div>

        <div class="story-block prose">
          <h2>Is Jamaica already shrinking?</h2>
          <p>Yes, just. The maximum, {millions(peak.population)}, was reached in 2023, and each projected year from 2024 is lower. Mid-century should bring {millions(y[2050].population)}, and the year 2100 just {millions(y[2100].population)}, near 38% of the present count. Among places above a million, only Hong Kong and Puerto Rico have steeper projected declines.</p>
        </div>
        <LineChart
          title="Jamaicans counted, 1950–2100: high point 2023"
          subtitle="Mid-year totals; projected years appear dashed."
          points={rows.map((r) => ({ x: r.year, y: r.population, projection: r.projection }))}
          format="millions"
          highlight={CURRENT_YEAR}
          source={WPP}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
        />

        <div class="story-block prose">
          <h2>Why are fewer Jamaican babies born?</h2>
          <p>The source measures it without explaining it. 1964 marks the top for both fertility ({dec(tfrTop.fertility, 2)}) and births ({int(bTop.births)}); the {CURRENT_YEAR} figures are {dec(c.fertility, 2)} and {int(c.births)}, the latter the lowest in the series. Since 2006 fertility has sat below 2.1, and the projection flips natural change to negative from 2034.</p>
        </div>
        <RelatedPages iso3={jam.iso3} name={jam.name} />
      </section>

      <section class="panel" data-panel="data" aria-label="Data">
        <DataTable
          id="data-h"
          title="Jamaica: 1951–1952, 1964, 1967, 2019–2025 and decades"
          subtitle="Outflows exceed inflows in each row from 1952, 2020 excepted."
          rows={rows as any}
          current={CURRENT_YEAR}
          source={BOTH}
          sourceUrl={WPP_URL}
          checkedOn={checkedOn}
          csv={path(`/data/${jam.slug}-population.csv`)}
          csvName={`${jam.slug}-population.csv`}
          licence={{ name: 'CC BY 3.0 IGO (UN data)', url: 'https://creativecommons.org/licenses/by/3.0/igo/' }}
        />
      </section>

      <section class="panel" data-panel="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Jamaica: figures in brief</h2>
        <div class="faq">
          {faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
        </div>
      </section>

      <details class="sources-details" id="sources">
        <summary><h2>Sources and methodology</h2></summary>
        <div class="sources-block">
          <ul class="sources">
            <li><a href={WPP_URL}>UN DESA Population Division, World Population Prospects 2024</a> (medium variant, original data files; listed as "{jam.unName}"): population, births, deaths, net migration, growth, density, fertility, median age, life expectancy, world rank, regional grouping, comparisons with other countries and areas, and projections. Land area is the UN's population divided by its density.</li>
            <li><a href={WUP_URL}>UN DESA Population Division, World Urbanization Prospects 2025</a> (percentage urban by national definition): urban share.</li>
          </ul>
          <p class="note">The live counter starts from the UN's mid-{CURRENT_YEAR} estimate and applies the UN's projected change for {CURRENT_YEAR} evenly through the year. It is an estimate, not a real-time count. See our <a href={path('/methodology/')}>methodology</a>.</p>
          <p class="note">Published <time datetime={jam.published}>{longDate(jam.published)}</time> · Updated <time datetime={jam.updated}>{longDate(jam.updated)}</time> · By {PUBLISHER}</p>
          <p class="note report-error">Spotted an error? <a href={reportErrorUrl("Jamaica population", PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
        </div>
      </details>
    </article>

    <KeyFacts variant="box" country="Jamaica" code="jm" year={CURRENT_YEAR} groups={factGroups} highlights={highlights} source={BOTH} sourceUrl={WPP_URL} checkedOn={checkedOn} />
  </div>
  <PageTabs />
</Base>
