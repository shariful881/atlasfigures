---
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import RankingTable from '../../components/RankingTable.astro';
import WorldMap from '../../components/WorldMap.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import meta from '../../data/rankings/mobile-subscriptions-by-country.json';
import { econData, econMeta, aggregate, valueIn, rankBy, notRanked, coverageYear } from '../../lib/econ';
import { assertClaim, pct, ord } from '../../lib/figures';
import { commonName, pagesOf } from '../../lib/names';
import { abs, path, longDate, ORG_ID, WEBSITE_ID, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/); the data are ITU's.
const PAGE = '/rankings/mobile-subscriptions-by-country/';
const PUBLISHED = meta.published, UPDATED = meta.updated;
const iso = (d: string) => `${d}T12:00:00+06:00`;
const WDI = 'World Bank, World Development Indicators (ITU data)';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = meta.verification?.checkedOn;
const name = commonName;
const M = econMeta.indicators.mobilePer100;

const L = coverageYear('mobilePer100');
const ranked = rankBy('mobilePer100', L);
const bySubs = rankBy('mobileSubs', L);
const byBb = rankBy('broadbandPer100', L);
const N = ranked.length;
const missing = notRanked('mobilePer100', L).filter((m) => m.latestYear != null);
const WS = aggregate('WLD').series;
const world = valueIn(WS.mobilePer100, L)!;
const worldSubs = valueIn(WS.mobileSubs, L)!;
const worldBb = valueIn(WS.broadbandPer100, L)!;
const byIso = (x: string) => ranked.find((r) => r.iso3 === x)!;
const subsOf = (x: string) => valueIn(econData(x).series.mobileSubs, L);
const bbOf = (x: string) => valueIn(econData(x).series.broadbandPer100, L);
const over100 = ranked.filter((r) => r.value > 100).length;
const first100 = WS.mobilePer100!.find(([, v]) => v > 100)![0];
const bn = (v: number) => `${(v / 1e9).toFixed(2)} billion`;
const mn = (v: number) => `${(v / 1e6).toFixed(1)} million`;
const wYears = WS.mobilePer100!.filter(([y]) => y >= 1990 && y <= L);

assertClaim(M.aggregation === 'Weighted average' && econMeta.indicators.mobileSubs.aggregation === 'Sum', 'world: weighted average and sum');
assertClaim(L === 2023 && N > 165, 'ranking year 2023');
assertClaim(['FJI', 'HKG', 'MNE'].every((x, i) => ranked[i].iso3 === x) && ranked[0].value > 300, 'Fiji, Hong Kong, Montenegro top; Fiji above 300');
assertClaim(ranked.at(-1)!.iso3 === 'PNG' && ranked.at(-1)!.value < 40, 'Papua New Guinea lowest, under 40');
assertClaim(first100 === 2017 && world > 100, 'world above one per person since 2017');
assertClaim(['CHN', 'IND', 'USA'].every((x, i) => bySubs[i].iso3 === x) && bySubs[8].iso3 === 'BGD' && bySubs[9].iso3 === 'PAK', 'China, India, US most subscriptions; Bangladesh 9th, Pakistan 10th');
assertClaim(['MCO', 'AND', 'LIE', 'FRA'].every((x, i) => byBb[i].iso3 === x), 'broadband: Monaco, Andorra, Liechtenstein, France');
assertClaim(byBb[3].value > 45 && byBb[0].value < 60, 'top four broadband close to one per two residents');
assertClaim(byIso('BGD').value > 100 && byIso('IND').value < 100 && byIso('PAK').value < 100, 'Bangladesh above one per person; India and Pakistan below');
assertClaim(bbOf('NGA')! < 0.1 && bbOf('BGD')! < 10, 'Nigeria fixed broadband under 0.1 per 100; Bangladesh under 10');

const title = `Mobile Subscriptions by Country ${L}: Phones per 100 People | AtlasFigures`;
const description = `The world had ${bn(worldSubs)} mobile subscriptions in ${L}, ${world.toFixed(1)} for every 100 people. ${N} economies ranked by subscriptions per 100 people, with fixed broadband alongside.`;

const cards = [
  { label: 'World subscriptions', value: `${(worldSubs / 1e9).toFixed(2)}B`, year: L, note: 'mobile' },
  { label: 'Per 100 people', value: world.toFixed(1), year: L, note: 'world' },
  { label: 'Over 100', value: String(over100), year: L, note: `of ${N} economies` },
  { label: 'Fixed broadband', value: worldBb.toFixed(1), year: L, note: 'per 100 people, world' },
];

const rows = ranked.map((r) => {
  const pg = pagesOf(r.iso3); const site = pg.economy ?? pg.population;
  const s = subsOf(r.iso3), b = bbOf(r.iso3);
  return {
    rank: r.rank, iso3: r.iso3, name: name(r.iso3), site, href: site ? path(site) : null, region: r.region,
    bar: Math.min(r.value / 200, 1), value: r.value.toFixed(1),
    cells: [s != null ? (s / 1e6).toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '–', b != null ? b.toFixed(1) : '–'],
  };
});
const mapFmt = (v: number) => `${Math.round(v)}`;
const mapRows = ranked.map((r) => ({ iso3: r.iso3, name: name(r.iso3), rank: r.rank, raw: r.value, value: `${r.value.toFixed(1)} per 100` }));
const regions = [...new Set(ranked.map((r) => r.region))].sort();

const faq = [
  { q: 'How many mobile phone subscriptions are there in the world?', a: `Adding up ITU figures gives ${bn(worldSubs)} for ${L} — ${world.toFixed(1)} per 100 people. The world has had more subscriptions than people since ${first100}.` },
  { q: 'Which country has the most mobile subscriptions per person?', a: `Fiji, with ${ranked[0].value.toFixed(1)} per 100 people in ${L}, followed by Hong Kong SAR (China) at ${ranked[1].value.toFixed(1)} and Montenegro at ${ranked[2].value.toFixed(1)}. Subscriptions count SIM accounts, so one person can hold several.` },
  { q: 'Which country has the most mobile subscriptions in total?', a: `China (${bn(subsOf('CHN')!)}), then India (${bn(subsOf('IND')!)}); the US is a distant third at ${mn(subsOf('USA')!)}.` },
  { q: 'How many mobile subscriptions does Bangladesh have?', a: `${mn(subsOf('BGD')!)} in ${L}, ${ord(bySubs.findIndex((r) => r.iso3 === 'BGD') + 1)} in the world, or ${byIso('BGD').value.toFixed(1)} per 100 people; fixed broadband stood at ${bbOf('BGD')!.toFixed(1)} per 100.` },
  { q: 'Which countries have the most fixed broadband?', a: `Monaco (${byBb[0].value.toFixed(1)} per 100 people), Andorra, Liechtenstein and France lead. The world figure was ${worldBb.toFixed(1)} per 100.` },
];

const schema = [
  {
    '@type': 'Article', '@id': abs(`${PAGE}#article`),
    headline: `Mobile subscriptions by country ${L}: ${N} economies ranked per 100 people`, description,
    datePublished: iso(PUBLISHED), dateModified: iso(UPDATED),
    author: { '@type': 'Organization', name: PUBLISHER, url: abs('/about/') }, publisher: { '@id': ORG_ID }, isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: abs(PAGE), image: abs('/icon-512.png'), inLanguage: 'en',
    citation: [{ '@type': 'CreativeWork', name: 'World Development Indicators', url: WDI_URL, publisher: { '@type': 'Organization', name: 'The World Bank' } }],
  },
  {
    '@type': 'ItemList', '@id': abs(`${PAGE}#ranking`), name: `Mobile cellular subscriptions per 100 people by country, ${L}`, itemListOrder: 'https://schema.org/ItemListOrderDescending', numberOfItems: N,
    itemListElement: rows.map((r) => ({ '@type': 'ListItem', position: r.rank, name: r.name, ...(r.site ? { url: abs(r.site) } : {}) })),
  },
  {
    '@type': 'Dataset', '@id': abs(`${PAGE}#dataset`),
    name: `Mobile cellular and fixed broadband subscriptions by country, ${L}`,
    description: `Mobile cellular subscriptions per 100 people for ${N} economies in ${L}, ranked, with total mobile subscriptions and fixed broadband subscriptions per 100 people, from the World Development Indicators (update of ${longDate(M.wdiLastUpdated)}). The original source is ITU's World Telecommunication/ICT Indicators Database.`,
    url: abs(PAGE), creator: { '@id': ORG_ID }, isBasedOn: [WDI_URL], temporalCoverage: String(L),
    spatialCoverage: { '@type': 'Place', name: 'World' }, variableMeasured: ['Mobile cellular subscriptions (per 100 people)', 'Mobile cellular subscriptions', 'Fixed broadband subscriptions (per 100 people)'],
    dateModified: iso(UPDATED), license: econMeta.licenceUrl,
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: abs('/data/mobile-subscriptions-by-country.csv') }],
  },
  { '@type': 'FAQPage', '@id': abs(`${PAGE}#faq`), mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title={title} description={description} section="rankings" appTitle="Mobile subscriptions" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Mobile subscriptions by country', href: PAGE }]}
  schema={schema}
>
  <article class="country-main rank-page">
    <h1>Mobile subscriptions by country, {L}</h1>
    <p class="answer">There were <strong>{bn(worldSubs)}</strong> mobile subscriptions worldwide in {L} — <strong>{world.toFixed(1)}</strong> for every 100 people. China and India hold the most, while Fiji, Hong Kong and Montenegro have the most per person.</p>
    <div class="dates"><span>Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
    <IndicatorCards label={`Mobile subscriptions ranking, ${L}`} cards={cards} />

    <div class="segments" role="tablist" aria-label="Page sections">
      <button role="tab" aria-selected="true" data-panel="data">Ranking</button>
      <button role="tab" aria-selected="false" data-panel="map">Map</button>
      <button role="tab" aria-selected="false" data-panel="story">Story</button>
      <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
    </div>

    <section class="panel" data-panel="map" aria-label="Map" hidden-mobile>
      <WorldMap
        id="map-h" title={`Mobile subscriptions for every 100 residents, ${L}`}
        subtitle="Active mobile cellular subscriptions per 100 people; values above 100 mean more SIM accounts than people. Five shades, one per fifth of the economies listed."
        rows={mapRows} fmt={mapFmt}
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
      />
    </section>
    <section class="panel" data-panel="data" aria-label="Ranking">
      <RankingTable
        id="rank-h"
        title={`Mobile subscriptions per 100 people, ${L}`}
        subtitle="Ranked by subscriptions per 100 people, with the total number of subscriptions in millions and fixed broadband per 100 people."
        valueLabel="Per 100 people"
        cols={[{ label: 'Subscriptions, million' }, { label: 'Fixed broadband per 100', cls: 'c-hide-m' }]}
        rows={rows}
        regions={regions}
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        csv={path('/data/mobile-subscriptions-by-country.csv')} csvName="mobile-subscriptions-by-country.csv"
        licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
      />
      <p class="note">Bars are scaled to 200 per 100 people; a few economies go beyond. Economies whose newest figure is older than {L}: {missing.length}, not listed.</p>
    </section>

    <section class="panel" data-panel="story" aria-label="The story">
      <div class="story-block prose">
        <h2>Are there more mobile subscriptions than people?</h2>
        <p>Yes — worldwide, and in {over100} individual economies out of {N}. The global count passed one subscription per person in {first100} and reached {world.toFixed(1)} per 100 people in {L}. ITU counts subscriptions, not owners: postpaid contracts plus prepaid SIMs used in the previous three months, so people with several SIMs push the figure up.</p>
      </div>

      <div class="story-block prose">
        <h2>Where are subscriptions per person highest?</h2>
        <p>Fiji leads with {ranked[0].value.toFixed(1)} per 100 people, followed by Hong Kong SAR (China) at {ranked[1].value.toFixed(1)} and Montenegro at {ranked[2].value.toFixed(1)}. At the other end, Papua New Guinea had {ranked.at(-1)!.value.toFixed(1)}. By total count China leads with {bn(subsOf('CHN')!)}, then India ({bn(subsOf('IND')!)}); the US follows on {mn(subsOf('USA')!)}.</p>
      </div>
      <LineChart
        title={`Mobile subscriptions per 100 people, world, 1990–${L}`}
        subtitle="World Bank weighted world average of ITU data."
        points={wYears.map(([x, y]) => ({ x, y: Number(y.toFixed(1)) }))}
        format="plain" unit="per 100 people" highlight={L} estimateLabel="World Bank data"
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
      />

      <div class="story-block prose">
        <h2>How does fixed broadband compare?</h2>
        <p>It is far less common: {worldBb.toFixed(1)} subscriptions per 100 people worldwide in {L}. Monaco, Andorra, Liechtenstein and France have the most, close to one line for every two residents, while Nigeria had fewer than one per 1,000 people.</p>
      </div>

      <div class="story-block prose">
        <h2>How connected is Bangladesh by mobile?</h2>
        <p><a href={path('/economy/bangladesh/')}>Bangladesh</a> counted {mn(subsOf('BGD')!)} mobile subscriptions in {L}, {ord(bySubs.findIndex((r) => r.iso3 === 'BGD') + 1)} in the world by number, just ahead of Pakistan. That is {byIso('BGD').value.toFixed(1)} per 100 people, more than India ({byIso('IND').value.toFixed(1)}) or Pakistan ({byIso('PAK').value.toFixed(1)}); fixed broadband reached {bbOf('BGD')!.toFixed(1)} per 100.</p>
      </div>
    </section>

    <section class="panel" data-panel="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Mobile subscriptions: what people ask</h2>
      <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
    </section>

    <details class="sources-details" id="sources">
      <summary><h2>Sources and methodology</h2></summary>
      <div class="sources-block">
        <ul class="sources">
          <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(M.wdiLastUpdated)}): mobile cellular subscriptions per 100 people (IT.CEL.SETS.P2) and in total (IT.CEL.SETS), fixed broadband subscriptions per 100 people (IT.NET.BBND.P2), from ITU's World Telecommunication/ICT Indicators Database. World totals: the World Bank's sum (subscriptions) and weighted averages (per 100). Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          <li>Related page: <a href={path('/rankings/internet-users-by-country/')}>internet users by country</a>.</li>
        </ul>
        <p class="note">Mobile subscriptions cover services that offer voice calls, postpaid and prepaid (prepaid only if used in the last three months); data-only cards and USB modems are excluded. Operators supply most figures and definitions differ slightly between countries. The ranking uses {L}, the newest year with figures for most economies; later country data are still incomplete. See our <a href={path('/methodology/')}>methodology</a>.</p>
        <p class="note">Published <time datetime={PUBLISHED}>{longDate(PUBLISHED)}</time> · Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time> · By {PUBLISHER}</p>
        <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Mobile subscriptions by country', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
      </div>
    </details>
  </article>
  <PageTabs />
</Base>
<style>
  .rank-page { max-width: 980px; }
  .rank-page .note { margin: 4px 2px 20px; }
</style>
