---
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import RankingTable from '../../components/RankingTable.astro';
import WorldMap from '../../components/WorldMap.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import meta from '../../data/rankings/immigrant-population-by-country.json';
import { econData, econMeta, aggregate, valueIn, rankBy, rankingYear } from '../../lib/econ';
import { assertClaim, ord, int, millions } from '../../lib/figures';
import { commonName, pagesOf } from '../../lib/names';
import { abs, path, longDate, ORG_ID, WEBSITE_ID, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/); the estimates are UN DESA's
// International Migrant Stock. "Immigrant" here = a person living in a country other than the one they were born in.
const PAGE = '/rankings/immigrant-population-by-country/';
const PUBLISHED = meta.published, UPDATED = meta.updated;
const iso = (d: string) => `${d}T12:00:00+06:00`;
const WDI = 'World Bank, World Development Indicators (UN DESA International Migrant Stock)';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = meta.verification?.checkedOn;
const name = commonName;
const M = econMeta.indicators.migrantStock;
const B0 = 1990, B1 = 2000;

const L = rankingYear('migrantStock');
const ranked = rankBy('migrantStock', L);
const N = ranked.length;
const WS = aggregate('WLD').series;
const w = valueIn(WS.migrantStock, L)!, w0 = valueIn(WS.migrantStock, B0)!, wP = valueIn(WS.migrantPct, L)!, wP0 = valueIn(WS.migrantPct, B0)!;
const byIso = (x: string) => ranked.find((r) => r.iso3 === x)!;
const st = (x: string, y: number) => valueIn(econData(x).series.migrantStock, y);
const sh = (x: string, y: number) => valueIn(econData(x).series.migrantPct, y);
const p1 = (v: number) => `${v.toFixed(1)}%`;
const top = ranked[0].value;
const top10 = ranked.slice(0, 10).reduce((t, r) => t + r.value, 0);
const gains = ranked.filter((r) => st(r.iso3, B1) != null).map((r) => ({ iso3: r.iso3, d: r.value - st(r.iso3, B1)! })).sort((a, b) => b.d - a.d);
const falls = [...gains].reverse();
const usa = byIso('USA'), bgd = byIso('BGD'), ind = byIso('IND'), col = byIso('COL'), esp = byIso('ESP'), rus = byIso('RUS');
const wYears = WS.migrantStock.filter(([y]) => y <= L);

assertClaim(M.aggregation === 'Sum' && L === 2024 && N === 215, 'world total is a sum; 2024; 215 places');
assertClaim(Math.round(w / 1e5) === 3034 && Math.round(w0 / 1e5) === 1536 && Math.round(wP * 10) === 37 && Math.round(wP0 * 10) === 29 && w / w0 > 1.95 && w / w0 < 2, 'world 303.4 million (3.7%), 153.6 million (2.9%) in 1990: almost doubled');
assertClaim(['USA', 'DEU', 'SAU', 'GBR', 'FRA'].every((x, i) => ranked[i].iso3 === x) && Math.round(usa.value / 1e5) === 524 && Math.round((usa.value / w) * 1000) === 173, 'US, Germany, Saudi Arabia, UK, France; US 52.4 million = 17.3% of world');
assertClaim(Math.round((top10 / w) * 1000) === 479, 'top ten hold 47.9%');
assertClaim(gains.slice(0, 3).map((g) => g.iso3).join() === 'USA,SAU,GBR' && falls[0].iso3 === 'RUS' && falls[1].iso3 === 'IND', 'largest rises since 2000 US, Saudi Arabia, UK; largest falls Russia, India');
assertClaim(st('RUS', B1)! > 11.8e6 && rus.value < 7.7e6 && rus.rank === 10, 'Russia 11.9 million in 2000, 7.6 million now, 10th');
assertClaim(st('ESP', B1)! < 2.1e6 && esp.value > 8.8e6 && st('COL', B1)! < 0.12e6 && col.value > 3e6, 'Spain 2.0 -> 8.9 million; Colombia 0.1 -> 3.1 million');
assertClaim(bgd.rank === 25 && Math.round(bgd.value / 1e5) === 29 && Math.round(st('BGD', B1)! / 1e5) === 10 && sh('BGD', L) === 1.7, 'Bangladesh 2.9 million, 25th, 1.0 million in 2000, 1.7% of population');
assertClaim(usa.value > ranked[1].value + ranked[2].value + ranked[3].value && Math.round(100 / wP) === 27 && st('COL', B1)! > 95e3 && st('COL', B1)! < 115e3, 'US more than next three combined; one in 27; Colombia about 100,000 in 2000');
assertClaim(esp.value / st('ESP', B1)! > 4 && rus.value / st('RUS', B1)! > 0.6 && rus.value / st('RUS', B1)! < 0.7, 'Spain more than quadrupled; Russia down about a third');
assertClaim(bgd.value - st('BGD', 2015)! > st('BGD', 2015)! - st('BGD', B1)!, 'Bangladesh: most of the rise after 2015');
assertClaim(ind.rank === 15 && sh('IND', L) === 0.3 && st('IND', B1)! > ind.value, 'India 15th, 0.3%, fewer than in 2000');

const title = `Immigrant Population by Country ${L}: Number of Migrants | AtlasFigures`;
const description = `${millions(w)} people lived outside their country of birth in ${L}, ${p1(wP)} of humanity. The United States hosts ${millions(usa.value)}; UN estimates for ${N} countries and areas.`;

const cards = [
  { label: 'International migrants', value: `${(w / 1e6).toFixed(1)}M`, year: L, note: 'world total' },
  { label: 'Share of world population', value: p1(wP), year: L, note: `${p1(wP0)} in ${B0}` },
  { label: 'United States', value: `${(usa.value / 1e6).toFixed(1)}M`, year: L, note: 'most of any country' },
  { label: 'Top 10 countries', value: p1((top10 / w) * 100), year: L, note: 'of all migrants' },
];

const rows = ranked.map((r) => {
  const pg = pagesOf(r.iso3); const site = pg.population ?? pg.economy;
  const y0 = st(r.iso3, B1);
  return {
    rank: r.rank, iso3: r.iso3, name: name(r.iso3), site, href: site ? path(site) : null, region: r.region,
    bar: r.value / top, value: int(r.value),
    cells: [sh(r.iso3, L) == null ? '–' : p1(sh(r.iso3, L)!), y0 == null ? '–' : int(y0)],
  };
});
const mapFmt = (v: number) => (v >= 1e6 ? `${(v / 1e6).toFixed(1)}M` : v >= 1e3 ? `${Math.round(v / 1e3)}k` : int(v));
const mapRows = ranked.map((r) => ({ iso3: r.iso3, name: name(r.iso3), rank: r.rank, raw: r.value, value: `${int(r.value)} migrants` }));
const regions = [...new Set(ranked.map((r) => r.region))].sort();

const faq = [
  { q: 'Which country has the most immigrants?', a: `The United States: ${millions(usa.value)} residents born abroad in ${L}, on UN estimates — ${p1((usa.value / w) * 100)} of all international migrants. Germany (${millions(ranked[1].value)}) and Saudi Arabia (${millions(ranked[2].value)}) follow.` },
  { q: 'How many international migrants are there in the world?', a: `${millions(w)} in ${L}, or ${p1(wP)} of the world's population. In ${B0} there were ${millions(w0)} (${p1(wP0)}).` },
  { q: 'How many immigrants live in Bangladesh?', a: `About ${millions(bgd.value)} in ${L} (${int(bgd.value)}), ${ord(bgd.rank)} of ${N} — ${p1(sh('BGD', L)!)} of the population. The UN figure counts refugees as well as other people born abroad; in ${B1} it was ${millions(st('BGD', B1)!)}.` },
  { q: 'Where has the number of immigrants fallen?', a: `Most of all in Russia: ${millions(st('RUS', B1)!)} foreign-born residents in ${B1}, ${millions(rus.value)} by ${L}. India comes next, with ${millions(st('IND', B1)!)} then and ${millions(ind.value)} now.` },
  { q: 'Does India have many immigrants?', a: `In number, yes — ${millions(ind.value)} in ${L}, ranking ${ord(ind.rank)} globally. As a share of India's population, though, they are only ${p1(sh('IND', L)!)}.` },
];

const schema = [
  {
    '@type': 'Article', '@id': abs(`${PAGE}#article`),
    headline: `Immigrant population by country ${L}: ${N} countries and areas ranked by international migrant stock`, description,
    datePublished: iso(PUBLISHED), dateModified: iso(UPDATED),
    author: { '@type': 'Organization', name: PUBLISHER, url: abs('/about/') }, publisher: { '@id': ORG_ID }, isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: abs(PAGE), image: abs('/icon-512.png'), inLanguage: 'en',
    citation: [{ '@type': 'CreativeWork', name: 'World Development Indicators', url: WDI_URL, publisher: { '@type': 'Organization', name: 'The World Bank' } }],
  },
  {
    '@type': 'ItemList', '@id': abs(`${PAGE}#ranking`), name: `Immigrant population by country, ${L}`, itemListOrder: 'https://schema.org/ItemListOrderDescending', numberOfItems: N,
    itemListElement: rows.map((r) => ({ '@type': 'ListItem', position: r.rank, name: r.name, ...(r.site ? { url: abs(r.site) } : {}) })),
  },
  {
    '@type': 'Dataset', '@id': abs(`${PAGE}#dataset`),
    name: `International migrant stock by country, ${L}`,
    description: `Number of people born in another country, as a total and as a share of the population, for ${N} countries and areas in ${L}, with the ${B1} total, from the World Development Indicators (update of ${longDate(M.wdiLastUpdated)}). The estimates come from the UN Population Division's International Migrant Stock.`,
    url: abs(PAGE), creator: { '@id': ORG_ID }, isBasedOn: [WDI_URL], temporalCoverage: `${B1}/${L}`,
    spatialCoverage: { '@type': 'Place', name: 'World' }, variableMeasured: ['International migrant stock, total', 'International migrant stock (% of population)'],
    dateModified: iso(UPDATED), license: econMeta.licenceUrl,
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: abs('/data/immigrant-population-by-country.csv') }],
  },
  { '@type': 'FAQPage', '@id': abs(`${PAGE}#faq`), mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title={title} description={description} section="rankings" appTitle="Immigrants" back="/rankings/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Rankings', href: '/rankings/' }, { name: 'Immigrant population by country', href: PAGE }]}
  schema={schema}
>
  <article class="country-main rank-page">
    <h1>Immigrant population by country, {L}</h1>
    <p class="answer">Some <strong>{millions(w)}</strong> people were living outside the country they were born in during {L} — {p1(wP)} of everyone alive. The United States is home to {millions(usa.value)} of them, more than Germany, Saudi Arabia and the United Kingdom put together.</p>
    <div class="dates"><span>Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
    <IndicatorCards label={`International migrants, ${L}`} cards={cards} />

    <div class="segments" role="tablist" aria-label="Page sections">
      <button role="tab" aria-selected="true" data-panel="data">Ranking</button>
      <button role="tab" aria-selected="false" data-panel="map">Map</button>
      <button role="tab" aria-selected="false" data-panel="story">Story</button>
      <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
    </div>

    <section class="panel" data-panel="map" aria-label="Map" hidden-mobile>
      <WorldMap
        id="map-h" title={`Number of international migrants, ${L}`}
        subtitle="People living in a country other than their country of birth, refugees included. Darker shades mark bigger foreign-born populations; each shade spans about as many countries as the next."
        rows={mapRows} fmt={mapFmt}
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
      />
    </section>
    <section class="panel" data-panel="data" aria-label="Ranking">
      <RankingTable
        id="rank-h"
        title={`International migrant stock by country, ${L}`}
        subtitle={`Residents born abroad, most first, with their share of the population and the number in ${B1}.`}
        valueLabel="Migrants"
        cols={[{ label: '% of pop.' }, { label: `In ${B1}`, cls: 'c-hide-m' }]}
        rows={rows}
        regions={regions}
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
        csv={path('/data/immigrant-population-by-country.csv')} csvName="immigrant-population-by-country.csv"
        licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
      />
      <p class="note">Bar length is relative to the United States, the largest figure. UN estimates exist for {N} countries and areas in {L}; "–" means no estimate for that year.</p>
    </section>

    <section class="panel" data-panel="story" aria-label="The story">
      <div class="story-block prose">
        <h2>How many people live outside their country of birth?</h2>
        <p>{millions(w)} in {L}, almost twice the {millions(w0)} of {B0}. Because the world's population also grew, the share rose more slowly, from {p1(wP0)} to {p1(wP)}: roughly one person in 27 is an international migrant. The UN counts anyone resident in a country other than their birthplace, including refugees; where a census records citizenship rather than birthplace, foreign citizens are counted instead.</p>
      </div>
      <LineChart
        title={`International migrants worldwide, ${wYears[0][0]}–${L}`}
        subtitle="UN estimates for selected years, people living outside their country of birth."
        points={wYears.map(([x, y]) => ({ x, y: Number((y / 1e6).toFixed(1)) }))}
        format="plain" highlight={L} estimateLabel="World Bank data"
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
      />
      <p class="note">Values in millions of people.</p>

      <div class="story-block prose">
        <h2>Which countries host the most immigrants?</h2>
        <p>The <a href={path('/country/united-states/economy/')}>United States</a> leads by a wide margin with {millions(usa.value)}, roughly {p1((usa.value / w) * 100)} of all migrants worldwide. <a href={path('/country/germany/economy/')}>Germany</a> ({millions(ranked[1].value)}), <a href={path('/country/saudi-arabia/economy/')}>Saudi Arabia</a> ({millions(ranked[2].value)}), the <a href={path('/country/united-kingdom/economy/')}>United Kingdom</a> ({millions(ranked[3].value)}) and <a href={path('/country/france/economy/')}>France</a> ({millions(ranked[4].value)}) complete the top five. Together the ten largest destinations account for {p1((top10 / w) * 100)} of all migrants.</p>
      </div>

      <div class="story-block prose">
        <h2>Where has the foreign-born population grown or shrunk since {B1}?</h2>
        <p>The largest additions were in the United States (+{millions(gains[0].d)}), Saudi Arabia and the United Kingdom. Spain's count more than quadrupled, reaching {millions(esp.value)} (it had been {millions(st('ESP', B1)!)} in {B1}), while <a href={path('/country/colombia/economy/')}>Colombia</a>'s grew from about a hundred thousand to {millions(col.value)}. The opposite happened in <a href={path('/country/russia/economy/')}>Russia</a>, whose total fell by about a third to {millions(rus.value)}, from {millions(st('RUS', B1)!)} in {B1}, and in <a href={path('/country/india/economy/')}>India</a>, which dropped to {millions(ind.value)} from {millions(st('IND', B1)!)}. Border changes matter in such series: the UN notes that when a country breaks up, people who once moved within it can become international migrants without moving again.</p>
      </div>

      <div class="story-block prose">
        <h2>How many immigrants does Bangladesh have?</h2>
        <p>{millions(bgd.value)} in {L} — {ord(bgd.rank)} of {N} — up from {millions(st('BGD', B1)!)} in {B1}, with most of the increase after 2015. They make up {p1(sh('BGD', L)!)} of <a href={path('/country/bangladesh/economy/')}>Bangladesh</a>'s population; for comparison India counts {millions(ind.value)} ({p1(sh('IND', L)!)}) and <a href={path('/country/pakistan/economy/')}>Pakistan</a> {millions(byIso('PAK').value)} ({p1(sh('PAK', L)!)}).</p>
      </div>
    </section>

    <section class="panel" data-panel="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Immigrant numbers: common questions</h2>
      <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
    </section>

    <details class="sources-details" id="sources">
      <summary><h2>Sources and methodology</h2></summary>
      <div class="sources-block">
        <ul class="sources">
          <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(M.wdiLastUpdated)}): international migrant stock, total (SM.POP.TOTL) and as % of population (SM.POP.TOTL.ZS), from the UN Population Division's International Migrant Stock. World total: World Bank sum over the economies in the WDI; world share: World Bank weighted average. Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          <li>Related pages: <a href={path('/rankings/immigrant-percentage-by-country/')}>immigrants as a percentage of the population</a>, <a href={path('/rankings/remittances-by-country/')}>remittances by country</a>, <a href={path('/rankings/population-by-country/')}>population by country</a>.</li>
        </ul>
        <p class="note">Estimates are for mid-year and exist for 1990, 1995, 2000, 2005, 2010, 2015, 2020 and {L}. They rest mostly on census counts of people born abroad, with registers and surveys elsewhere; where no data exist the UN imputes a figure. People who have since taken the citizenship of their new country are still counted if they were born abroad. Refugee figures from UNHCR were not used on this page: the refugee series in the current World Bank files did not pass our checks. See our <a href={path('/methodology/')}>methodology</a>.</p>
        <p class="note">Published <time datetime={PUBLISHED}>{longDate(PUBLISHED)}</time> · Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time> · By {PUBLISHER}</p>
        <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Immigrant population by country', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
      </div>
    </details>
  </article>
  <PageTabs />
</Base>
<style>
  .rank-page { max-width: 980px; }
  .rank-page .note { margin: 4px 2px 20px; }
</style>
