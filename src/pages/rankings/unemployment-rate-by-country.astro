---
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import RankingTable from '../../components/RankingTable.astro';
import IndicatorCards from '../../components/IndicatorCards.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import PageTabs from '../../components/PageTabs.astro';
import meta from '../../data/rankings/unemployment-rate-by-country.json';
import { econData, econMeta, aggregate, valueIn, rankBy, notRanked, rankingYear } from '../../lib/econ';
import { assertClaim, pct, ord, byYear, countryData } from '../../lib/figures';
import { commonName, pagesOf } from '../../lib/names';
import { abs, path, longDate, ORG_ID, WEBSITE_ID, PUBLISHER, reportErrorUrl } from '../../site';

// Every figure comes from the original World Bank files (via src/data/wdi/); populations from UN WPP 2024.
const PAGE = '/rankings/unemployment-rate-by-country/';
const PUBLISHED = meta.published, UPDATED = meta.updated;
const iso = (d: string) => `${d}T12:00:00+06:00`;
const WDI = 'World Bank, World Development Indicators';
const WDI_URL = econMeta.sourceUrl;
const checkedOn = meta.verification?.checkedOn;
const name = commonName;

const L = rankingYear('unemploymentPct');
const ranked = rankBy('unemploymentPct', L);
const missing = notRanked('unemploymentPct', L);
const N = ranked.length;
const W = aggregate('WLD').series.unemploymentPct;
const world = valueIn(W, L)!, world2020 = valueIn(W, 2020)!;
const byIso = (x: string) => ranked.find((r) => r.iso3 === x)!;
const people = (x: string) => { try { return byYear(countryData(x).years)[L]?.population ?? 0; } catch { return 0; } };
const giants = ranked.filter((r) => people(r.iso3) > 100e6);
const top10Africa = ranked.slice(0, 10).filter((r) => r.region === 'Sub-Saharan Africa').length;
const za = econData('ZAF').series.unemploymentPct;
const zaMin = za.reduce((a, b) => (b[1] < a[1] ? b : a));
const wYears = W.filter(([y]) => y <= L);
const wPeak = wYears.reduce((a, b) => (b[1] > a[1] ? b : a));

assertClaim(econMeta.indicators.unemploymentPct.aggregation === 'Weighted average', 'world figure is a weighted average');
assertClaim(ranked[0].iso3 === 'SWZ' && ranked[1].iso3 === 'ZAF' && ranked[2].iso3 === 'DJI', 'Eswatini, South Africa, Djibouti highest');
assertClaim(top10Africa === 7, 'seven of the top ten in Sub-Saharan Africa');
assertClaim([2021, 2022, 2023, 2024, L].every((y) => valueIn(za, y)! > 30) && valueIn(za, 2020)! < 30 && zaMin[1] > 22, 'South Africa above 30% since 2021, never below 22%');
assertClaim(['QAT', 'KHM', 'NER'].every((x, i) => ranked[N - 1 - i].iso3 === x), 'Qatar, Cambodia, Niger lowest');
assertClaim(wPeak[0] === 2020 && world < world2020, 'world rate peaked in 2020 and has fallen');
assertClaim(giants[0].iso3 === 'EGY' && giants.at(-1)!.iso3 === 'VNM', 'Egypt highest and Vietnam lowest among countries of 100 million+');
assertClaim(byIso('ESP').value / byIso('DEU').value > 2.5 && byIso('ESP').value / byIso('DEU').value < 3, 'Spain almost three times Germany');
assertClaim([2021, 2022, 2023, 2024, L].every((y, i, a) => valueIn(W, y)! < valueIn(W, i === 0 ? 2020 : a[i - 1])!), 'world rate eased every year since 2020');
assertClaim(za[0][0] === 1991 && W[0][0] === 1991, 'series begin in 1991');
assertClaim(byIso('BGD').value < byIso('IND').value && byIso('IND').value < byIso('PAK').value, 'Bangladesh below India below Pakistan');

const title = `Unemployment Rate by Country ${L}: Where Jobs Are Scarcest | AtlasFigures`;
const description = `Eswatini had the highest unemployment rate in ${L} at ${pct(ranked[0].value)}, then South Africa at ${pct(ranked[1].value)}; Qatar the lowest. ${N} economies ranked on ILO modelled estimates via the World Bank.`;

const cards = [
  { label: 'World rate', value: pct(world), year: L, note: 'weighted average' },
  { label: 'Highest', value: pct(ranked[0].value), year: L, note: name(ranked[0].iso3) },
  { label: 'Lowest', value: pct(ranked[N - 1].value), year: L, note: name(ranked[N - 1].iso3) },
  { label: 'World rate, 2020', value: pct(world2020), year: 2020, note: 'the recent peak' },
];

const top = ranked[0].value;
const rows = ranked.map((r) => {
  const then = valueIn(econData(r.iso3).series.unemploymentPct, 2020);
  const pg = pagesOf(r.iso3); const site = pg.economy ?? pg.population;
  return {
    rank: r.rank, iso3: r.iso3, name: name(r.iso3), site, href: site ? path(site) : null, region: r.region,
    bar: r.value / top, value: pct(r.value),
    cells: [then == null ? '–' : pct(then), r.incomeGroup ?? '–'],
  };
});
const regions = [...new Set(ranked.map((r) => r.region))].sort();

const faq = [
  { q: 'Which country has the highest unemployment rate?', a: `Eswatini: ${pct(ranked[0].value)} of its workforce was jobless in ${L}, by the ILO's modelled estimate. South Africa (${pct(ranked[1].value)}) and Djibouti (${pct(ranked[2].value)}) come next.` },
  { q: 'Which country has the lowest unemployment?', a: `Qatar, at ${pct(ranked[N - 1].value)}, followed by Cambodia (${pct(ranked[N - 2].value)}) and Niger (${pct(ranked[N - 3].value)}).` },
  { q: 'What is the global unemployment rate?', a: `${pct(world)} in ${L}, a weighted average across economies, down from ${pct(world2020)} in 2020.` },
  { q: 'Why is South Africa\'s unemployment so high?', a: `The ILO estimate has put it above 30% every year since 2021 (${pct(valueIn(za, L)!)} in ${L}), and its lowest point since records start in 1991 was ${pct(zaMin[1])}, in ${zaMin[0]}. The figures show how persistent it is; they do not by themselves explain it.` },
  { q: 'What is the unemployment rate in Bangladesh?', a: `${pct(byIso('BGD').value)} in ${L}, ${ord(byIso('BGD').rank)} of ${N}. India's rate was ${pct(byIso('IND').value)} and Pakistan's ${pct(byIso('PAK').value)}.` },
];

const schema = [
  {
    '@type': 'Article', '@id': abs(`${PAGE}#article`),
    headline: `Unemployment rate by country ${L}: ${N} economies ranked`, description,
    datePublished: iso(PUBLISHED), dateModified: iso(UPDATED),
    author: { '@type': 'Organization', name: PUBLISHER, url: abs('/about/') }, publisher: { '@id': ORG_ID }, isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: abs(PAGE), image: abs('/icon-512.png'), inLanguage: 'en',
    citation: [
      { '@type': 'CreativeWork', name: 'World Development Indicators', url: WDI_URL, publisher: { '@type': 'Organization', name: 'The World Bank' } },
      { '@type': 'CreativeWork', name: 'ILO Modelled Estimates (ILOEST)', url: 'https://ilostat.ilo.org/data/bulk/', publisher: { '@type': 'Organization', name: 'International Labour Organization' } },
    ],
  },
  {
    '@type': 'ItemList', '@id': abs(`${PAGE}#ranking`), name: `Unemployment rate by country, ${L}`, itemListOrder: 'https://schema.org/ItemListOrderDescending', numberOfItems: N,
    itemListElement: rows.map((r) => ({ '@type': 'ListItem', position: r.rank, name: r.name, ...(r.site ? { url: abs(r.site) } : {}) })),
  },
  {
    '@type': 'Dataset', '@id': abs(`${PAGE}#dataset`),
    name: `Unemployment rate by country, ${L} (% of labour force, modelled ILO estimate)`,
    description: `Unemployment as a share of the labour force for ${N} economies in ${L}, ranked, with the 2020 rate and the World Bank income group, from the World Development Indicators (update of ${longDate(econMeta.indicators.gdp.wdiLastUpdated)}; original source ILO modelled estimates).`,
    url: abs(PAGE), creator: { '@id': ORG_ID }, isBasedOn: [WDI_URL], temporalCoverage: `2020/${L}`,
    spatialCoverage: { '@type': 'Place', name: 'World' }, variableMeasured: ['Unemployment, total (% of labour force, modelled ILO estimate)', 'World Bank income group'],
    dateModified: iso(UPDATED), license: econMeta.licenceUrl,
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: abs('/data/unemployment-rate-by-country.csv') }],
  },
  { '@type': 'FAQPage', '@id': abs(`${PAGE}#faq`), mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title={title} description={description} section="rankings" appTitle="Unemployment by country" back="/economy/" ogType="article"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Economy', href: '/economy/' }, { name: 'Unemployment rate by country', href: PAGE }]}
  schema={schema}
>
  <article class="country-main rank-page">
    <h1>Unemployment rate by country, {L}</h1>
    <p class="answer"><strong>Eswatini</strong> and <strong>South Africa</strong> had the highest unemployment in {L}, at {pct(ranked[0].value)} and {pct(ranked[1].value)} of the labour force. Worldwide the rate was {pct(world)}, below the {pct(world2020)} of 2020.</p>
    <div class="dates"><span>Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time></span><SourceBadge source={WDI} url={WDI_URL} checkedOn={checkedOn} /></div>
    <IndicatorCards label={`Unemployment ranking, ${L}`} cards={cards} />

    <div class="segments" role="tablist" aria-label="Page sections">
      <button role="tab" aria-selected="true" data-panel="data">Ranking</button>
      <button role="tab" aria-selected="false" data-panel="story">Story</button>
      <button role="tab" aria-selected="false" data-panel="faq">FAQ</button>
    </div>

    <section class="panel" data-panel="data" aria-label="Ranking">
      <RankingTable
        id="rank-h"
        title={`Jobless rate by economy, ${L}`}
        subtitle="Share of the labour force without work but available for and seeking it. The 2020 column shows the pandemic year."
        valueLabel={`Unemployment ${L}`}
        cols={[{ label: '2020' }, { label: 'Income group', cls: 'c-hide-m' }]}
        rows={rows}
        regions={regions}
        source={`${WDI} (modelled ILO estimates)`} sourceUrl={WDI_URL} checkedOn={checkedOn}
        csv={path('/data/unemployment-rate-by-country.csv')} csvName="unemployment-rate-by-country.csv"
        licence={{ name: 'CC BY 4.0 (World Bank data)', url: econMeta.licenceUrl }}
      />
      <p class="note">{missing.length} economies lack a {L} estimate and are left out, including {missing.filter((m) => m.latestYear != null).slice(0, 3).map((m) => name(m.iso3)).join(', ')}.</p>
    </section>

    <section class="panel" data-panel="story" aria-label="The story">
      <div class="story-block prose">
        <h2>Which countries have the most unemployment?</h2>
        <p>Eswatini ({pct(ranked[0].value)}), South Africa ({pct(ranked[1].value)}) and Djibouti ({pct(ranked[2].value)}) lead the list, and seven of the ten highest rates are in Sub-Saharan Africa. South Africa stands out for size and persistence: the estimate has been above 30% every year since 2021 and its lowest reading since 1991 was {pct(zaMin[1])}, in {zaMin[0]}.</p>
      </div>

      <div class="story-block prose">
        <h2>Has unemployment come down since the pandemic?</h2>
        <p>Yes. The world rate rose to {pct(world2020)} in 2020, its highest in the series, and has eased every year since to {pct(world)} in {L}.</p>
      </div>
      <LineChart
        title={`World unemployment rate, 1991–${L}`}
        subtitle="Share of the world's labour force out of work and looking for it, modelled ILO estimates."
        points={wYears.map(([x, y]) => ({ x, y }))}
        format="percent" highlight={L} estimateLabel="World Bank data"
        source={WDI} sourceUrl={WDI_URL} checkedOn={checkedOn}
      />

      <div class="story-block prose">
        <h2>Why do some poor countries show very low unemployment?</h2>
        <p>Because the rate only counts people with no work at all who are actively looking for a job. The World Bank's own notes warn that it is not a measure of hardship or well-being and says nothing about how well people live. So Qatar ({pct(ranked[N - 1].value)}), Cambodia ({pct(ranked[N - 2].value)}) and Niger ({pct(ranked[N - 3].value)}) can sit together at the bottom of the list despite very different incomes.</p>
      </div>

      <div class="story-block prose">
        <h2>How do the biggest countries compare?</h2>
        <p>Of the {giants.length} nations with populations above 100 million, Egypt has the highest rate ({pct(byIso('EGY').value)}) and Vietnam the lowest ({pct(byIso('VNM').value)}). India stands at {pct(byIso('IND').value)}, Pakistan at {pct(byIso('PAK').value)} and <a href={path('/economy/bangladesh/')}>Bangladesh</a> at {pct(byIso('BGD').value)}. In Europe, Spain's {pct(byIso('ESP').value)} is almost three times Germany's {pct(byIso('DEU').value)}.</p>
      </div>
    </section>

    <section class="panel" data-panel="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Quick answers about unemployment by country</h2>
      <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
    </section>

    <details class="sources-details" id="sources">
      <summary><h2>Sources and methodology</h2></summary>
      <div class="sources-block">
        <ul class="sources">
          <li><a href={WDI_URL}>World Bank, World Development Indicators</a> (original bulk files, WDI update of {longDate(econMeta.indicators.gdp.wdiLastUpdated)}): unemployment, total (% of total labor force, modelled ILO estimate), SL.UEM.TOTL.ZS. The world figure is the World Bank's weighted average. Licence CC BY 4.0. The World Bank does not endorse this page.</li>
          <li><a href="https://ilostat.ilo.org/data/bulk/">International Labour Organization, ILO Modelled Estimates (ILOEST)</a>: the original source of the estimates.</li>
          <li><a href="https://population.un.org/wpp/">UN DESA Population Division, World Population Prospects 2024</a>: populations used to pick countries of more than 100 million people.</li>
        </ul>
        <p class="note">Modelled estimates make countries comparable but can differ from national statistics offices' own figures. Only economies with a {L} estimate are ranked. See our <a href={path('/methodology/')}>methodology</a>.</p>
        <p class="note">Published <time datetime={PUBLISHED}>{longDate(PUBLISHED)}</time> · Updated <time datetime={UPDATED}>{longDate(UPDATED)}</time> · By {PUBLISHER}</p>
        <p class="note report-error">Spotted an error? <a href={reportErrorUrl('Unemployment rate by country', PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
      </div>
    </details>
  </article>
  <PageTabs />
</Base>
<style>
  .rank-page { max-width: 980px; }
  .rank-page .note { margin: 4px 2px 20px; }
</style>
