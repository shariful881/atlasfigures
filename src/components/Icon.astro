---
// Line icons used in the mobile tab bar, app bar and section tiles.
interface Props { name: 'home' | 'population' | 'time' | 'economy' | 'rankings' | 'back' | 'share' | 'search' | 'chevron' | 'sheet' | 'more' }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'home' && (<><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/></>)}
  {name === 'population' && (<><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19.5c.6-3.3 2.9-5.3 5.5-5.3s4.9 2 5.5 5.3"/><circle cx="17" cy="9" r="2.4"/><path d="M15.6 14.4c2.3.1 4.2 1.8 4.8 4.6"/></>)}
  {name === 'time' && (<><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></>)}
  {name === 'economy' && (<><path d="M4 19.5h16"/><path d="M5.5 15.5l4-4.5 3.5 3 5.5-6.5"/><path d="M15 7.5h3.5V11"/></>)}
  {name === 'rankings' && (<><path d="M5 20V12M12 20V6M19 20v-5"/><path d="M3.5 20.5h17"/></>)}
  {name === 'back' && (<><path d="M15 5l-7 7 7 7"/></>)}
  {name === 'share' && (<><path d="M12 15V4M8 7.5 12 4l4 3.5"/><path d="M6 11.5H5v8.5h14v-8.5h-1"/></>)}
  {name === 'search' && (<><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></>)}
  {name === 'chevron' && (<><path d="m9 6 6 6-6 6"/></>)}
  {name === 'sheet' && (<><path d="M6 9l6 6 6-6"/></>)}
  {name === 'more' && (<><circle cx="5.5" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="18.5" cy="12" r="1.6" fill="currentColor"/></>)}
</svg>
