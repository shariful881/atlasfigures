---
// "Verified source" mark. Only use when the figures were actually checked against
// the named source; pass the date of that check (see `verification` in the data file).
import { longDate } from '../site';
interface Props { source: string; url?: string; checkedOn?: string; variant?: 'inline' | 'footer' | 'dark' }
const { source, url, checkedOn, variant = 'inline' } = Astro.props;
const verified = Boolean(checkedOn);
const tip = verified ? `Figures checked against ${source} on ${longDate(checkedOn!)}` : `Source: ${source}`;
---
<div class={`srcbadge srcbadge-${variant}`} title={tip}>
  {verified && (
    <span class="vchip" aria-label="Verified source">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.8 3.5 4.3v5.2c0 4 2.8 7.3 6.5 8.7 3.7-1.4 6.5-4.7 6.5-8.7V4.3z" fill="currentColor"/><path d="m6.8 10.1 2.2 2.2 4.3-4.6" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Verified
    </span>
  )}
  <span class="stext">
    <span class="slabel">Source:</span> {url ? <a href={url}>{source}</a> : source}
    {verified && <span class="sdate"> · checked <time datetime={checkedOn}>{longDate(checkedOn!)}</time></span>}
  </span>
</div>
