---
// Layout for one city's time page (task 26). Every figure — offsets, zone names, clock changes, sun times, time
// differences — is computed here from the IANA tz data in the runtime and the NOAA sun equations (src/lib/sun.ts).
// Each page passes its OWN words: H1, direct answer, story, table titles, FAQ (no shared wording between cities;
// checked by scripts/check-unique.mjs). The live clock and "today" sun card are filled in the browser.
import Base from '../layouts/Base.astro';
import Flag from './Flag.astro';
import Icon from './Icon.astro';
import SourceBadge from './SourceBadge.astro';
import { abs, path, longDate, ORG_ID, WEBSITE_ID, PUBLISHER, reportErrorUrl } from '../site';
import { offsetMin, utcLabel, zoneName, transitions, yearSpan, offsetsIn, sunRows, dayLen, local } from '../lib/tz';
import { sunTimes } from '../lib/sun';
import { pagesOf } from '../lib/names';

export interface Faq { q: string; a: string }
interface Props {
  city: any;                 // src/data/cities/<slug>.json
  title: string; description: string; h1: string;
  sunTitle: string; sunSub: string;
  diffTitle: string; diffSub: string;
  changesTitle?: string; changesSub?: string;  // only for cities with daylight saving
  faqTitle: string; faq: Faq[];
}
const { city: c, title, description, h1, sunTitle, sunSub, diffTitle, diffSub, changesTitle, changesSub, faqTitle, faq } = Astro.props;
const PAGE = `/time/${c.slug}/`;
const Y = 2026;
const iso = (d: string) => `${d}T12:00:00+06:00`;
const IANA = 'IANA time zone database 2026e';
const IANA_URL = 'https://www.iana.org/time-zones';

const offs = offsetsIn(c.tz, Y);
const std = Math.min(...offs), dst = offs.length > 1 ? Math.max(...offs) : null;
const jan = Date.UTC(Y, 0, 15, 12), jul = Date.UTC(Y, 6, 15, 12);
const stdAt = offsetMin(c.tz, jan) === std ? jan : jul, dstAt = dst === null ? null : (stdAt === jan ? jul : jan);
const stdName = zoneName(c.tz, stdAt, c.code === 'us' ? 'en-US' : 'en-GB');
const dstName = dstAt === null ? null : zoneName(c.tz, dstAt, c.code === 'us' ? 'en-US' : 'en-GB');
const wall = (ms: number) => new Date(ms).toISOString().slice(11, 16); // UTC formatting of a shifted instant
const changes = transitions(c.tz, yearSpan(Y)[0], yearSpan(Y + 1)[1]).map((t) => ({
  date: new Date(t.at).toLocaleDateString('en-GB', { timeZone: c.tz, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }),
  short: new Date(t.at).toLocaleDateString('en-GB', { timeZone: c.tz, day: 'numeric', month: 'long' }),
  year: local(c.tz, t.at).y,
  from: wall(t.at + t.before * 60000), to: wall(t.at + t.after * 60000),
  dir: t.after > t.before ? 'forward' : 'back', newOff: utcLabel(t.after),
}));
const changesY = changes.filter((x) => x.year === Y);

// sun: the 21st of every month, plus the year's longest and shortest day
const sun = sunRows(c.tz, c.lat, c.lon, Array.from({ length: 12 }, (_, i) => [Y, i + 1, 21] as [number, number, number]));
const allDays = Array.from({ length: 365 }, (_, i) => { const d = new Date(Date.UTC(Y, 0, 1 + i)); const s = sunTimes(Y, d.getUTCMonth() + 1, d.getUTCDate(), c.lat, c.lon); return { d, len: Math.round((s.set! - s.rise!) / 60000) }; });
const longest = allDays.reduce((a, b) => (b.len > a.len ? b : a)), shortest = allDays.reduce((a, b) => (b.len < a.len ? b : a));
const dm = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });

// differences to the other cities, January and July
const others = Object.values(import.meta.glob('../data/cities/*.json', { eager: true, import: 'default' }) as Record<string, any>).filter((o) => o.slug !== c.slug).sort((a, b) => offsetMin(a.tz, jan) - offsetMin(b.tz, jan));
const diff = (o: any, at: number) => { const m = offsetMin(o.tz, at) - offsetMin(c.tz, at); if (m === 0) return 'Same time'; const a = Math.abs(m); return `${m > 0 ? '+' : '−'}${Math.floor(a / 60)}${a % 60 ? `:${String(a % 60).padStart(2, '0')}` : ''} h`; };
const pg = pagesOf(c.iso3);
const allCities = Object.values(import.meta.glob('../data/cities/*.json', { eager: true, import: 'default' })) as any[];
const myPairs = (Object.values(import.meta.glob('../data/pairs/*.json', { eager: true, import: 'default' })) as any[]).filter((x) => x.a === c.slug || x.b === c.slug)
  .map((x) => ({ slug: x.slug, label: `${allCities.find((y) => y.slug === x.a).name} → ${allCities.find((y) => y.slug === x.b).name}` }));

const schema = [
  {
    '@type': 'WebPage', '@id': abs(`${PAGE}#page`), url: abs(PAGE), name: title.replace(' | AtlasFigures', ''), description,
    isPartOf: { '@id': WEBSITE_ID }, publisher: { '@id': ORG_ID }, inLanguage: 'en',
    datePublished: iso(c.published), dateModified: iso(c.updated),
    about: { '@type': 'City', name: c.name, geo: { '@type': 'GeoCoordinates', latitude: c.lat, longitude: c.lon }, containedInPlace: { '@type': 'Country', name: c.country } },
  },
  { '@type': 'FAQPage', '@id': abs(`${PAGE}#faq`), mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const checkedOn = c.verification?.checkedOn;
---
<Base title={title} description={description} section="time" appTitle={`Time in ${c.name}`} back="/time/" ogType="website"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Time', href: '/time/' }, { name: c.name, href: PAGE }]} schema={schema}>
  <article class="city-time">
    <header class="ct-head">
      <h1>{h1}</h1>
      <section class="clock" id="clock" data-tz={c.tz} data-lat={c.lat} data-lon={c.lon} aria-label={`Current time in ${c.name}`}>
        <div class="clock-top"><Flag code={c.code} class="flag" /><span class="clock-where">{c.name}, {c.country}</span><span class="clock-zone" data-k="zone">{stdName}</span></div>
        <div class="clock-time" data-k="time" aria-live="off">--:--<span class="sec">:--</span></div>
        <div class="clock-date" data-k="date">&nbsp;</div>
        <div class="clock-meta"><span class="pill" data-k="off">{utcLabel(std)}</span><span class="pill soft" data-k="you">&nbsp;</span></div>
        <div class="sun-today">
          <div><span class="k">Sunrise today</span><span class="v" data-k="rise">–</span></div>
          <div><span class="k">Sunset today</span><span class="v" data-k="set">–</span></div>
          <div><span class="k">Daylight</span><span class="v" data-k="len">–</span></div>
        </div>
      </section>
      <div class="answer"><slot name="answer" /></div>
      <div class="dates"><span>Updated <time datetime={c.updated}>{longDate(c.updated)}</time></span><SourceBadge source={IANA} url={IANA_URL} checkedOn={checkedOn} /></div>
    </header>

    <aside class="facts tfacts" aria-labelledby="tf-h">
      <h2 id="tf-h">{c.name} time at a glance</h2>
      <dl>
        <dt>Time zone</dt><dd>{c.tz}</dd>
        <dt>Standard time</dt><dd>{utcLabel(std)} · {stdName}</dd>
        <dt>Daylight saving</dt><dd>{dst === null ? 'Not used' : `${utcLabel(dst)} · ${dstName}`}</dd>
        {changesY.length > 0 && <><dt>Clocks change {Y}</dt><dd>{changesY.map((x) => x.short).join(' and ')}</dd></>}
        <dt>Country</dt><dd>{c.country}</dd>
        <dt>Coordinates</dt><dd>{c.dms}</dd>
        <dt>Longest day {Y}</dt><dd>{dm(longest.d)} · {dayLen(longest.len)}</dd>
        <dt>Shortest day {Y}</dt><dd>{dm(shortest.d)} · {dayLen(shortest.len)}</dd>
      </dl>
      <p class="src">Source: {IANA}; sun times calculated with the NOAA equations</p>
    </aside>

    <div class="ct-story prose">
      <slot name="story" />
    </div>

    {changesTitle && changes.length > 0 && (
      <section class="tcard" aria-labelledby="chg-h">
        <header class="tcard-head"><div><h2 id="chg-h">{changesTitle}</h2><p class="tcard-sub">{changesSub}</p></div></header>
        <div class="table-scroll">
          <table class="data">
            <caption class="visually-hidden">Clock changes in {c.name}, {Y}–{Y + 1}, local time</caption>
            <thead><tr><th scope="col">Date</th><th scope="col">Clocks go</th><th scope="col">Local time</th><th scope="col">New offset</th></tr></thead>
            <tbody>{changes.map((x) => <tr><th scope="row">{x.date}</th><td>{x.dir}</td><td>{x.from} → {x.to}</td><td>{x.newOff}</td></tr>)}</tbody>
          </table>
        </div>
        <footer class="tcard-foot"><SourceBadge source={IANA} url={IANA_URL} checkedOn={checkedOn} variant="footer" /></footer>
      </section>
    )}

    <section class="tcard" aria-labelledby="sun-h">
      <header class="tcard-head"><div><h2 id="sun-h">{sunTitle}</h2><p class="tcard-sub">{sunSub}</p></div></header>
      <div class="table-scroll">
        <table class="data">
          <caption class="visually-hidden">Sunrise, sunset, solar noon and day length in {c.name} on the 21st of each month, {Y}, local clock time</caption>
          <thead><tr><th scope="col">Date</th><th scope="col">Sunrise</th><th scope="col">Solar noon</th><th scope="col">Sunset</th><th scope="col">Daylight</th></tr></thead>
          <tbody>{sun.map((r) => <tr><th scope="row">{r.d} {new Date(Date.UTC(r.y, r.m - 1, 1)).toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })}</th><td>{r.rise}</td><td>{r.noon}</td><td>{r.set}</td><td>{dayLen(r.lenMin!)}</td></tr>)}</tbody>
        </table>
      </div>
      <footer class="tcard-foot"><SourceBadge source="NOAA solar equations, at the city's coordinates" url="https://gml.noaa.gov/grad/solcalc/" checkedOn={checkedOn} variant="footer" /></footer>
    </section>

    <section class="tcard" aria-labelledby="diff-h">
      <header class="tcard-head"><div><h2 id="diff-h">{diffTitle}</h2><p class="tcard-sub">{diffSub}</p></div></header>
      <div class="table-scroll">
        <table class="data diff" data-tz={c.tz}>
          <caption class="visually-hidden">Hours ahead (+) or behind (−) {c.name} in mid-January and mid-July {Y}, and right now</caption>
          <thead><tr><th scope="col">City</th><th scope="col">15 January</th><th scope="col">15 July</th><th scope="col">Right now</th></tr></thead>
          <tbody>{others.map((o) => (
            <tr><th scope="row"><a href={path(`/time/${o.slug}/`)}>{o.name}</a></th><td>{diff(o, jan)}</td><td>{diff(o, jul)}</td><td data-now={o.tz}>–</td></tr>
          ))}</tbody>
        </table>
      </div>
      <footer class="tcard-foot"><SourceBadge source={IANA} url={IANA_URL} checkedOn={checkedOn} variant="footer" /></footer>
    </section>

    <nav class="related-pages ct-related" aria-label={`More about ${c.country}`}>
      <h2 class="visually-hidden">Related pages</h2>
      <ul>
        {pg.population && <li><a href={path(pg.population)}><Icon name="population" /> Population of {c.country}</a></li>}
        {pg.economy && <li><a href={path(pg.economy)}><Icon name="economy" /> Economy of {c.country}</a></li>}
        {myPairs.map((x) => <li><a href={path(`/time/${x.slug}/`)}><Icon name="time" /> {x.label}</a></li>)}
        <li><a href={path('/time/converter/')}><Icon name="time" /> Time zone converter</a></li>
        <li><a href={path('/time/')}><Icon name="time" /> All city clocks</a></li>
      </ul>
    </nav>

    <section class="faq-wrap" aria-labelledby="faq-h">
      <h2 id="faq-h">{faqTitle}</h2>
      <div class="faq">{faq.map((f) => (<details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}</div>
    </section>

    <details class="sources-details" id="sources">
      <summary><h2>Sources and methodology</h2></summary>
      <div class="sources-block">
        <ul class="sources">
          <li><a href={IANA_URL}>IANA time zone database</a> (release 2026e), zone <code>{c.tz}</code>: UTC offsets, zone names, daylight-saving dates and every past offset mentioned on this page. The live clock uses the copy of the same database built into your browser.</li>
          <li><a href="https://gml.noaa.gov/grad/solcalc/">NOAA Global Monitoring Laboratory, Solar Calculator equations</a>: sunrise, sunset and solar noon, with the sun's centre 0.833° below the horizon at sea level. Times can differ by a minute or two from other tables because of rounding, height and the exact point used.</li>
          <li><a href={c.coordSource.url}>{c.coordSource.name}</a>: city coordinates {c.dms}.</li>
        </ul>
        <p class="note">Published <time datetime={c.published}>{longDate(c.published)}</time> · Updated <time datetime={c.updated}>{longDate(c.updated)}</time> · By {PUBLISHER}</p>
        <p class="note report-error">Spotted an error? <a href={reportErrorUrl(`Time in ${c.name}`, PAGE)}>Report an error</a> · <a href={path('/corrections/')}>How we correct errors</a></p>
      </div>
    </details>
  </article>
</Base>

<script>
  import { sunTimes } from '../lib/sun';
  const el = document.getElementById('clock');
  if (el) {
    const tz = el.dataset.tz!, lat = Number(el.dataset.lat), lon = Number(el.dataset.lon);
    const q = (k: string) => el.querySelector(`[data-k="${k}"]`) as HTMLElement;
    const fmtT = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
    const fmtD = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const fmtHM = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const off = (z: string, t: number) => { const s = new Intl.DateTimeFormat('en-US', { timeZone: z, timeZoneName: 'longOffset' }).formatToParts(new Date(t)).find((p) => p.type === 'timeZoneName')!.value; const m = s.match(/GMT([+-])(\d{2}):?(\d{2})?/); return m ? (m[1] === '-' ? -1 : 1) * (+m[2] * 60 + +(m[3] ?? 0)) : 0; };
    const lab = (m: number) => { const a = Math.abs(m); return `${m < 0 ? '−' : '+'}${Math.floor(a / 60)}${a % 60 ? ':' + String(a % 60).padStart(2, '0') : ''}`; };
    const zoneLong = (t: number) => new Intl.DateTimeFormat(el.dataset.tz!.startsWith('America/') ? 'en-US' : 'en-GB', { timeZone: tz, timeZoneName: 'long' }).formatToParts(new Date(t)).find((p) => p.type === 'timeZoneName')!.value;
    const me = Intl.DateTimeFormat().resolvedOptions().timeZone;
    let lastDay = '';
    const tick = () => {
      const now = Date.now();
      const [h, m, s] = fmtT.format(now).split(':');
      q('time').innerHTML = `${h}:${m}<span class="sec">:${s}</span>`;
      const day = fmtD.format(now);
      if (day !== lastDay) {
        lastDay = day; q('date').textContent = day;
        const o = off(tz, now); q('off').textContent = `UTC${lab(o)}`; q('zone').textContent = zoneLong(now);
        const d = off(tz, now) - off(me, now);
        q('you').textContent = d === 0 ? 'Same time as you' : `${lab(d).slice(1)} h ${d > 0 ? 'ahead of' : 'behind'} you`;
        const p = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(now).map((x) => [x.type, x.value]));
        const st = sunTimes(+p.year, +p.month, +p.day, lat, lon);
        q('rise').textContent = st.rise ? fmtHM.format(st.rise) : '—';
        q('set').textContent = st.set ? fmtHM.format(st.set) : '—';
        if (st.rise && st.set) { const L = Math.round((st.set - st.rise) / 60000); q('len').textContent = `${Math.floor(L / 60)} h ${String(L % 60).padStart(2, '0')} min`; }
        document.querySelectorAll<HTMLElement>('table.diff [data-now]').forEach((td) => {
          const dd = off(td.dataset.now!, now) - off(tz, now);
          td.textContent = dd === 0 ? 'Same time' : `${lab(dd)} h`;
        });
      }
    };
    tick(); setInterval(tick, 1000);
  }
</script>

<style>
  .city-time { display: grid; grid-template-columns: minmax(0, 1fr) 320px; column-gap: 44px; align-items: start; }
  .city-time > * { grid-column: 1; }
  .city-time > .tfacts { grid-column: 2; grid-row: 1 / span 3; position: sticky; top: 24px; }
  .ct-head h1 { margin-bottom: 18px; }
  .clock { position: relative; background: linear-gradient(150deg, var(--ocean) 0%, var(--ocean-2) 100%); color: #d6e4ec; border-radius: 24px; padding: 22px 26px; }
  .clock-top { display: flex; align-items: center; gap: 10px; font-size: .92rem; }
  .clock-top :global(.flag) { width: 30px; height: 20px; border-radius: 3px; }
  .clock-where { font-weight: 700; color: #fff; }
  .clock-zone { margin-left: auto; font-size: .82rem; color: #a9c1d0; text-align: right; }
  .clock-time { font-size: clamp(3.4rem, 8vw, 5.6rem); font-weight: 800; color: #fff; letter-spacing: -0.02em; line-height: 1.05; margin: 12px 0 4px; font-variant-numeric: tabular-nums; font-feature-settings: 'tnum'; }
  .clock-time :global(.sec) { font-size: .45em; color: #8fb4c9; margin-left: 4px; font-weight: 700; }
  .clock-date { font-size: 1.05rem; color: #d6e4ec; }
  .clock-meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 16px; }
  .pill { font-size: .8rem; font-weight: 700; padding: 4px 11px; border-radius: 999px; background: #fff; color: var(--ocean); }
  .pill.soft { background: rgba(255,255,255,.12); color: #d6e4ec; font-weight: 600; }
  .pill:empty, .pill.soft:empty { display: none; }
  .sun-today { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .sun-today div { background: rgba(255,255,255,.08); border-radius: var(--r-md); padding: 9px 12px; }
  .sun-today .k { display: block; font-size: .74rem; color: #a9c1d0; }
  .sun-today .v { display: block; font-weight: 700; color: #fff; font-size: 1.05rem; }
  .ct-head .answer { margin-top: 20px; }
  .tfacts { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 20px 22px 16px; }
  .tfacts h2 { font-size: 1rem; margin: 0 0 12px; }
  .tfacts dl { margin: 0; display: block; font-size: .92rem; }
  .tfacts dt { color: var(--text-3); font-size: .76rem; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
  .tfacts dd { margin: 1px 0 11px; text-align: left; font-weight: 700; color: var(--ocean); font-variant-numeric: normal; }
  .tfacts .src { font-size: .78rem; color: var(--text-3); margin: 14px 0 0; padding-top: 10px; border-top: 1px solid var(--line); }
  .ct-story { margin-top: 8px; }
  .tcard { margin-top: 28px; }
  table.diff a { font-weight: 700; text-decoration: none; }
  .ct-related ul { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .ct-related a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); text-decoration: none; font-weight: 600; font-size: .92rem; }
  .ct-related :global(svg) { width: 18px; height: 18px; }
  .faq-wrap h2 { margin-top: 36px; }
  @media (max-width: 1023px) { .city-time { grid-template-columns: minmax(0, 1fr) 260px; column-gap: 24px; } }
  @media (max-width: 767px) {
    .city-time { display: block; }
    .ct-head h1 { margin: 14px 2px 12px; font-size: 1.6rem; }
    .clock { border-radius: var(--r-lg); padding: 18px 18px; text-align: center; }
    .clock-top { justify-content: center; flex-wrap: wrap; }
    .clock-zone { margin: 0; width: 100%; text-align: center; }
    .clock-time { font-size: clamp(3.6rem, 19vw, 4.8rem); }
    .clock-meta { justify-content: center; }
    .sun-today .v { font-size: .95rem; }
    .city-time > .tfacts { display: block; position: static; margin: 12px 0; border: 0; padding: 16px 18px 12px; }
    .ct-story :global(h2) { margin-top: 1.2em; }
    .ct-story { background: var(--surface); border-radius: var(--r-lg); padding: 4px 18px 8px; margin-top: 12px; }
    .ct-related ul { margin-top: 16px; }
    .faq-wrap h2 { margin-top: 20px; }
  }
</style>
