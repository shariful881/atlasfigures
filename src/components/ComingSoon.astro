---
// Placeholder for sections not built yet. Always noindex: thin pages stay out of search.
import Base from '../layouts/Base.astro';
import { path } from '../site';
interface Props { section: 'time' | 'economy' | 'rankings'; title: string; lead: string; items: string[] }
const { section, title, lead, items } = Astro.props;
---
<Base title={`${title} | AtlasFigures`} description={lead} section={section} appTitle={title} noindex
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: title, href: `/${section}/` }]}>
  <h1>{title}</h1>
  <div class="soon-box">
    <p>{lead}</p>
    <p>What this section will include:</p>
    <ul>{items.map((i) => <li>{i}</li>)}</ul>
    <p><a href={path('/population/')}>Explore population by country while you wait</a></p>
  </div>
</Base>
