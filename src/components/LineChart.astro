---
// Server-rendered SVG line chart. Points marked `projection: true` are drawn
// dashed, so the reader sees at a glance where measurement ends and forecast begins.
interface Point { x: number; y: number; projection?: boolean }
interface Props {
  title: string;
  subtitle?: string;
  points: Point[];
  format?: 'millions' | 'number' | 'pct' | 'plain';
  source?: string;
  highlight?: number; // x value to mark
}
const { title, subtitle, points, format = 'plain', source, highlight } = Astro.props;

const W = 720, H = 300, L = 56, R = 20, T = 16, B = 34;
const xs = points.map((p) => p.x);
const ys = points.map((p) => p.y);
const x0 = Math.min(...xs), x1 = Math.max(...xs);
const yMaxRaw = Math.max(...ys);
const yMinRaw = Math.min(0, Math.min(...ys));

function niceStep(range: number) {
  const raw = range / 5;
  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const n = raw / mag;
  return (n < 1.5 ? 1 : n < 3 ? 2 : n < 7 ? 5 : 10) * mag;
}
const step = niceStep(yMaxRaw - yMinRaw);
const yMax = Math.ceil(yMaxRaw / step) * step;
const yMin = Math.floor(yMinRaw / step) * step;
const X = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
const Y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);

const fmt = (v: number) => {
  if (format === 'millions') return `${Math.round(v / 1e6)}M`;
  if (format === 'pct') return `${v}%`;
  if (format === 'number') return v.toLocaleString('en-US');
  return String(v);
};

const ticks: number[] = [];
for (let v = yMin; v <= yMax + 1e-9; v += step) ticks.push(Number(v.toFixed(6)));

const measured = points.filter((p) => !p.projection);
const lastMeasured = measured[measured.length - 1];
const projected = [lastMeasured, ...points.filter((p) => p.projection)];
const path = (ps: Point[]) => ps.map((p, i) => `${i ? 'L' : 'M'}${X(p.x).toFixed(1)} ${Y(p.y).toFixed(1)}`).join(' ');
const hasProjection = projected.length > 1;
---
<figure class="figure">
  <p class="fig-title">{title}</p>
  {subtitle && <p class="fig-sub">{subtitle}</p>}
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {ticks.map((t) => (
      <g>
        <line x1={L} x2={W - R} y1={Y(t)} y2={Y(t)} stroke="#ebe7df" />
        <text x={L - 8} y={Y(t) + 4} text-anchor="end" font-size="11" fill="#8a94a3" font-family="JetBrains Mono, monospace">{fmt(t)}</text>
      </g>
    ))}
    {xs.filter((x) => x === highlight || highlight === undefined || Math.abs(X(x) - X(highlight)) > 36).map((x) => (
      <text x={X(x)} y={H - 12} text-anchor="middle" font-size="11" fill="#8a94a3" font-family="JetBrains Mono, monospace">{x}</text>
    ))}
    {hasProjection && (
      <rect x={X(lastMeasured.x)} y={T} width={W - R - X(lastMeasured.x)} height={H - T - B} fill="#f4f1ea" />
    )}
    {hasProjection && (
      <text x={X(lastMeasured.x) + 8} y={T + 14} font-size="11" fill="#8a94a3">UN projection</text>
    )}
    <path d={path(measured)} fill="none" stroke="#0e7c6b" stroke-width="2.5" />
    {hasProjection && <path d={path(projected)} fill="none" stroke="#0e7c6b" stroke-width="2.5" stroke-dasharray="6 5" />}
    {points.map((p) => (
      <circle cx={X(p.x)} cy={Y(p.y)} r={p.x === highlight ? 5 : 3} fill={p.x === highlight ? '#c2622d' : '#0e7c6b'} />
    ))}
    {highlight !== undefined && points.filter((p) => p.x === highlight).map((p) => (
      <text x={X(p.x)} y={Y(p.y) - 12} text-anchor="middle" font-size="12" font-weight="600" fill="#16202e">{fmt(p.y)}</text>
    ))}
  </svg>
  {source && <div class="fig-src">Source: {source}</div>}
</figure>
