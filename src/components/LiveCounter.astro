---
// Live population estimate: a mid-year figure plus the yearly net change spread
// evenly through the year. "Added today", "Added this year" and "Next +1 in"
// move every second so the counter visibly feels live even for slow-growing places.
// If the page has a #mini-counter (mobile app bar), it mirrors the main number.
import Contours from './Contours.astro';
interface Props {
  label: string;
  anchorValue: number;
  anchorDate: string;
  perYear: number;
  note?: string;
}
const { label, anchorValue, anchorDate, perYear, note } = Astro.props;
const id = `c${Math.random().toString(36).slice(2, 8)}`;
---
<div class="counter" id={id} data-anchor={anchorValue} data-date={anchorDate} data-rate={perYear}>
  <Contours />
  <div class="label"><span class="pulse" aria-hidden="true"></span>{label}</div>
  <div class="value" data-k="total" aria-live="off">{anchorValue.toLocaleString('en-US')}</div>
  <div class="ticks">
    <div class="chip"><span class="k">Added today</span><span class="v" data-k="today">–</span></div>
    <div class="chip"><span class="k">This year</span><span class="v" data-k="year">–</span></div>
    <div class="chip"><span class="k">Next +1 in</span><span class="v" data-k="next">–</span></div>
  </div>
  {note && <div class="sub">{note}</div>}
</div>
<script is:inline define:vars={{ id }}>
  (function () {
    var root = document.getElementById(id);
    if (!root) return;
    var q = function (k) { return root.querySelector('[data-k="' + k + '"]'); };
    var total = q('total'), today = q('today'), year = q('year'), next = q('next');
    var mini = document.getElementById('mini-counter');
    var anchor = Number(root.dataset.anchor);
    var t0 = Date.parse(root.dataset.date);
    var perMs = Number(root.dataset.rate) / (365.25 * 24 * 3600 * 1000);
    var last = null;
    var fmt = function (n) { return Math.floor(n).toLocaleString('en-US'); };
    function tick() {
      var now = Date.now();
      var exact = anchor + (now - t0) * perMs;
      var v = Math.floor(exact);
      var d = new Date(now);
      var startDay = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
      var startYear = new Date(d.getFullYear(), 0, 1).getTime();
      total.textContent = fmt(v);
      if (mini) mini.textContent = fmt(v);
      if (last !== null && v !== last) { total.classList.remove('bump'); void total.offsetWidth; total.classList.add('bump'); }
      last = v;
      today.textContent = '+' + fmt((now - startDay) * perMs);
      year.textContent = '+' + fmt((now - startYear) * perMs);
      var secs = Math.max(1, Math.ceil((1 - (exact - v)) / perMs / 1000));
      next.textContent = secs < 60 ? secs + 's' : Math.ceil(secs / 60) + 'm';
    }
    tick();
    setInterval(tick, 250);
  })();
</script>
