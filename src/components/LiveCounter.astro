---
// Live population estimate styled like a live ticker:
// LIVE pill + ticking local clock, odometer digits that roll when they change,
// a progress bar filling until the next +1, and today / this-year counters.
// Estimate = UN mid-year figure + UN yearly net change spread evenly over the year.
// If the page has #mini-counter (mobile app bar), it mirrors the number.
// Every counter always shows the fixed label "Estimate based on UN projections" (data guide §6) — not a prop, so no page can drop it.
import Contours from './Contours.astro';
import { path } from '../site';
interface Props {
  label: string;
  anchorValue: number;
  anchorDate: string;   // ISO date of the anchor figure
  perYear: number;
  note?: string;
}
const { label, anchorValue, anchorDate, perYear, note } = Astro.props;
const id = `c${Math.random().toString(36).slice(2, 8)}`;
const perDay = Math.round(perYear / 365);
const falling = perYear < 0;
const sign = falling ? '−' : '+';
const fmtAbs = (n: number) => Math.abs(n).toLocaleString('en-US');
---
<section class={falling ? "live falling" : "live"} id={id} data-anchor={anchorValue} data-date={anchorDate} data-rate={perYear} aria-label={label}>
  <Contours />
  <div class="live-top">
    <span class="live-pill"><span class="pulse" aria-hidden="true"></span>LIVE</span>
    <span class="live-label">{label}</span>
    <span class="live-clock" aria-hidden="true">as of <span data-k="clock">--:--:--</span></span>
  </div>
  <div class="odo" data-k="total" aria-hidden="true">{anchorValue.toLocaleString('en-US')}</div>
  <p class="visually-hidden">Estimated {label.toLowerCase()}: about {anchorValue.toLocaleString('en-US')} at {anchorDate}, {falling ? 'falling' : 'rising'} by about {fmtAbs(perDay)} a day.</p>
  <div class="next" aria-hidden="true">
    <div class="next-bar"><span data-k="bar"></span></div>
    <span class="next-txt">Next {sign}1 in <b data-k="next">–</b></span>
  </div>
  <div class="live-stats">
    <div><span class="k">{falling ? 'Change today' : 'Added today'}</span><span class="v" data-k="today">–</span></div>
    <div><span class="k">{falling ? 'Change this year' : 'Added this year'}</span><span class="v" data-k="year">–</span></div>
    <div><span class="k">Per day</span><span class="v">{sign}{fmtAbs(perDay)}</span></div>
  </div>
  <p class="live-est">
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 9v5M10 6.2v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <span><strong>Estimate based on UN projections</strong>, not a real-time count. <a href={path('/methodology/#live-counters')}>How it works</a></span>
  </p>
  {note && <p class="live-note">{note}</p>}
</section>
<script is:inline define:vars={{ id }}>
  (function () {
    var root = document.getElementById(id); if (!root) return;
    var q = function (k) { return root.querySelector('[data-k="' + k + '"]'); };
    var odo = q('total'), today = q('today'), year = q('year'), next = q('next'), bar = q('bar'), clock = q('clock');
    var mini = document.getElementById('mini-counter');
    var anchor = Number(root.dataset.anchor), t0 = Date.parse(root.dataset.date);
    var perMs = Number(root.dataset.rate) / (365.25 * 24 * 3600 * 1000);
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var shown = '';
    var fmt = function (n) { return Math.floor(n).toLocaleString('en-US'); };
    function render(str) {
      if (str.length !== shown.length) {
        odo.innerHTML = '';
        for (var i = 0; i < str.length; i++) { var s = document.createElement('span'); s.className = str[i] === ',' ? 'sep' : 'dg'; s.textContent = str[i]; odo.appendChild(s); }
      } else {
        for (var j = 0; j < str.length; j++) {
          if (str[j] !== shown[j]) {
            var el = odo.children[j]; el.textContent = str[j];
            if (!reduce) { el.classList.remove('roll'); void el.offsetWidth; el.classList.add('roll'); }
          }
        }
      }
      shown = str;
    }
    function tick() {
      var now = Date.now(), exact = anchor + (now - t0) * perMs, v = Math.floor(exact), d = new Date(now);
      var str = fmt(v); render(str); if (mini) mini.textContent = str;
      var sg = perMs < 0 ? '−' : '+', ab = function (n) { return fmt(Math.abs(n)); };
      today.textContent = sg + ab((now - new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime()) * perMs);
      year.textContent = sg + ab((now - new Date(d.getFullYear(), 0, 1).getTime()) * perMs);
      var frac = exact - v, left = perMs < 0 ? frac : 1 - frac, done = 1 - left;
      var secs = Math.max(1, Math.ceil(left / Math.abs(perMs) / 1000));
      next.textContent = secs < 60 ? secs + 's' : Math.ceil(secs / 60) + 'm';
      bar.style.width = (done * 100).toFixed(1) + '%';
      clock.textContent = d.toLocaleTimeString('en-GB');
    }
    tick(); setInterval(tick, 200);
  })();
</script>
